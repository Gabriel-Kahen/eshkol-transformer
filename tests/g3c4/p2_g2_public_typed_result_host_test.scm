                (eq? (vector-ref native 2) 'live))) (error "wrong native RNG owner"))
  (vector-ref (vector-ref native 1) index))
(define (g3c4-native-rng-release native)
  (if (not (eq? (vector-ref native 2) 'live)) (error "duplicate RNG release"))
  (vector-set! native 2 'dead) 0)
(set! source-valid? #t)
(define rng (g3c4-public-g2-rng-result-publish source-shell snapshot 'result-rng 'test))
(define rng-entry (g3c4-registry-find rng 'test))
(define rng-native (vector-ref rng-entry 3))
