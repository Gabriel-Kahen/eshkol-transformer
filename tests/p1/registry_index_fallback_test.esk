;;; Test-only trusted-root overlay exposes diagnostic slots 73..74.
;;; Production module source and its public ABI have no such controls.
(require transformer.module)
(require p1_test.tensor_provider)

(define checks 0)
(define (check label condition)
  (if condition
      (set! checks (+ checks 1))
      (begin
        (display "P1 index fallback FAIL: ")
        (display label)
        (newline)
        (exit 1))))

(define module (module-create-fixture-internal))
(module-register-parameter-internal!
  module "weight"
  (fixture-tensor-internal '(2) 'f32 'cpu (vector 'index 'fallback)))
(define state (module-state-dict module))
(define path (car (state-dict-paths state)))

;; A stage failure occurs after the pending root has been installed, but
;; before native creation or authoritative registry publication.
(p1-index-test-control! 'fail-stage)
(check "stage allocation failure is explicit"
       (guard (raised (#t (eq? raised 'index-stage-failed)))
         (state-dict-entries-internal state)
         #f))
(check "failed stage clears pending root"
       (p1-index-test-control! 'pending-clear))
(define entry (car (state-dict-entries-internal state)))
(define tensor (state-dict-tensor state path))
(check "retry publishes exact entry"
       (eq? entry (car (state-dict-entries-internal state))))
(check "retry publishes exact tensor"
       (eq? tensor (state-dict-tensor state path)))

;; Model lost advisory index publication: both heads are absent and the
;; validity bit forbids trusting them. The append-only registry remains.
(p1-index-test-control! 'invalidate)
(check "invalid entry head falls back to exact registry record"
       (eq? entry (car (state-dict-entries-internal state))))
(check "invalid tensor head falls back to exact registry record"
       (eq? tensor (state-dict-tensor state path)))

(define later-state (module-state-dict module))
(define later-path (car (state-dict-paths later-state)))
(define later-entry (car (state-dict-entries-internal later-state)))
(define later-tensor (state-dict-tensor later-state later-path))
(check "publication with invalid index keeps registry authority for entry"
       (eq? later-entry (car (state-dict-entries-internal later-state))))
(check "publication with invalid index keeps registry authority for tensor"
       (eq? later-tensor (state-dict-tensor later-state later-path)))
(check "failed publication never revalidates incomplete index"
       (p1-index-test-control! 'invalid))
(check "first state releases" (state-dict-release! state))
(check "second state releases" (state-dict-release! later-state))

;; The overlay raises if a state tries the advisory index after authoritative
;; publication. State construction must still return the canonical shell to
;; its owner ledger; release must restore both native and provider counts.
(define source (module-create-fixture-internal))
(define source-handle
  (module-register-parameter-internal!
    source "weight"
    (fixture-tensor-internal '(2) 'f32 'cpu (vector 'state-index 'cut))))
(check "source starts unfinalized"
       (not (p1-index-test-observe 'finalized source)))
(check "source path starts unobserved"
       (not (p1-index-test-observe 'path-object source-handle)))
(define live-before (p1-index-test-observe 'live #f))
(define tombstones-before (p1-index-test-observe 'tombstones #f))
(define owners-before (fixture-owned-live-count-internal))
(define cut-state (module-state-dict source))
(define source-path-object
  (p1-index-test-observe 'path-object source-handle))
(check "post-publication index cut returns exact state"
       (equal? (state-dict-paths cut-state) '(("weight"))))
(check "ordinary module observation finalizes source"
       (p1-index-test-observe 'finalized source))
(check "ordinary module observation installs canonical path"
       (equal? (parameter-handle-path source-handle) '("weight")))
(check "one native state authority is live"
       (= (p1-index-test-observe 'live #f) (+ live-before 1)))
(check "one provider clone owner is live"
       (= (fixture-owned-live-count-internal) (+ owners-before 1)))
(check "cut state releases" (state-dict-release! cut-state))
(check "source canonical path object survives release"
       (eq? source-path-object
            (p1-index-test-observe 'path-object source-handle)))
(check "source finalized flag survives release"
       (p1-index-test-observe 'finalized source))
(check "no orphan native state remains"
       (= (p1-index-test-observe 'live #f) live-before))
(check "no orphan provider clone remains"
       (= (fixture-owned-live-count-internal) owners-before))
(check "exactly one native state tombstone records release"
       (= (p1-index-test-observe 'tombstones #f)
          (+ tombstones-before 1)))

(display "P1 INDEX FALLBACK PASS: ")
(display checks)
(display " checks")
(newline)
