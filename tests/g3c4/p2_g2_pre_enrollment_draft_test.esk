(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "g3c4_p2g2_terminal_carriers_extension.esk")

;;; Development fixture. The pending layout is useful before any call or
;;; output exists. Keep the draft, the bundle, and every carrier lexical.
(let ((operation 'p2-g2-pre-enrollment-draft-test))
  (define (try-draft defect)
    (let* ((bundle (g3c4-p2g2-terminal-carriers-create))
           (valid
             (guard (caught (#t
                             (g3c4-p2g2-terminal-carriers-retire! bundle)
                             (raise caught)))
               (g3c4-p2g2-terminal-carriers-check bundle operation)
               (let* ((order (vector 2 3 0 1 4 5 6 7))
                      (original-extents (vector-ref bundle 8))
                      (extents (make-vector 8 #f))
                      (draft (make-vector 17 #f)))
                 (define (valid? candidate)
                   (and (g3c4-p2g2-terminal-carriers-check bundle operation)
                        (eq? candidate draft)
                        (eq? (vector-ref candidate 15) extents)
                        (eq? (vector-ref candidate 16) 'unbound)
                        (let vacant ((i 0))
                          (if (= i 7) #t
                              (and (eq? (vector-ref candidate i) #f)
                                   (vacant (+ i 1)))))
                        (let authentic ((i 0))
                          (if (= i 8) #t
                              (let ((carrier (vector-ref order i)))
                                (and (eq? (vector-ref candidate (+ 7 i))
                                          (vector-ref bundle carrier))
                                     (m3t-exact-i64? (vector-ref extents i))
                                     (= (vector-ref extents i)
                                        (vector-ref original-extents carrier))
                                     (authentic (+ i 1))))))))
                 (let project ((i 0))
                   (if (< i 8)
                       (let ((carrier (vector-ref order i)))
                         (vector-set! draft (+ 7 i) (vector-ref bundle carrier))
                         (vector-set! extents i (vector-ref original-extents carrier))
                         (project (+ i 1)))))
                 (vector-set! draft 15 extents)
                 (vector-set! draft 16 'unbound)
                 (case defect
                   ((false-owner) (vector-set! draft 5 'native-owner))
                   ((equal-length-raw) (vector-set! draft 7 (make-bytevector 2 0)))
                   ((first-as-second) (vector-set! draft 11 (vector-ref draft 9))
                                      (vector-set! draft 12 (vector-ref draft 10)))
                   ((extent) (vector-set! extents 0 9))
                   ((published-state) (vector-set! draft 16 'pending))
                   (else #f))
                 (valid? draft)))))
      (g3c4-p2g2-terminal-carriers-retire! bundle)
      valid))
  (define (check condition)
    (if (not condition)
        (begin
          (display "P2/G2 pre-enrollment draft FAIL") (newline) (exit 1))))
  (check (try-draft 'authentic))
  (let each ((defects '(false-owner equal-length-raw first-as-second extent published-state)))
    (if (pair? defects)
        (begin
          (check (not (try-draft (car defects))))
          (each (cdr defects)))))
  (check (try-draft 'authentic))
  (display "P2/G2 pre-enrollment draft PASS") (newline))
