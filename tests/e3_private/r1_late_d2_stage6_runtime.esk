;;; One genuine second-batch D2 read or staging-copy failure and same-owner retry.
(extern void e3-fault-run ptr ptr ptr :real et_e3_fault_run_v1)
(extern void e3-retention-run ptr ptr ptr :real et_e3_retention_run_v1)

(define (check label condition)
  (if condition #t
      (begin (display "E3-R1-LATE-D2-FAIL: ") (display label)
             (newline) (exit 1))))

(define (count values)
  (let loop ((remaining values) (n 0))
    (if (null? remaining) n (loop (cdr remaining) (+ n 1)))))

(define args (command-line))
(check 'arguments (= (count args) 5))
(define path (car (cdr args)))
(define gradient (car (cdr (cdr args))))
(define site (string->number (car (cdr (cdr (cdr args))))))
(define ordinal (string->number (car (cdr (cdr (cdr (cdr args)))))))
(check 'gradient (or (string=? gradient "absent")
                     (string=? gradient "present")))
(check 'site (or (= site 6) (= site 7)))
(check 'ordinal (if (= site 6) (and (>= ordinal 0) (<= ordinal 2))
                    (= ordinal 0)))
(define present? (string=? gradient "present"))
(define scenario (vector 'fault 'prepare present? site ordinal 2))
(define input (vector path))
(define output (vector #f))

(e3-fault-run scenario input output)
(check 'prepared (eq? (vector-ref output 0) #t))
(vector-set! scenario 1 'execute)
(e3-fault-run scenario input output)
(check 'executed (eq? (vector-ref output 0) #t))
(vector-set! scenario 1 'report)
(e3-fault-run scenario input output)
(define report (vector-ref output 0))
(check 'report (and (vector? report) (= (vector-length report) 11)
                    (eq? (vector-ref report 0) 'e3-retention-result-v1)
                    (= (vector-ref report 1) 1024)
                    (eq? (vector-ref report 2) present?)
                    (= (vector-ref report 3) (vector-ref report 4))))

(define teardown (vector (vector 'retention 'teardown 1024 present?)))
(e3-retention-run teardown input output)
(define released (vector-ref output 0))
(check 'teardown (and (vector? released) (= (vector-length released) 3)
                      (eq? (vector-ref released 0) 'e3-retention-teardown-v1)))
(display "E3-R1-LATE-D2-PASS site=") (display site)
(display " ordinal=") (display ordinal)
(display " gradient=") (display gradient)
(newline)
