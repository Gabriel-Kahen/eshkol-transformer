;;; Source-private abort-only witness. Load after the protected scope and the
;;; terminal carrier constructor. The observation body belongs to the fixture.
(define g3c4-p2g2-first-enrollment-roots (vector '()))

(define (g3c4-p2g2-shell-count shell)
  (let scan ((entries (vector-ref g3c4-registry 0)) (count 0))
    (if (null? entries) count
        (scan (cdr entries)
              (if (eq? (vector-ref (car entries) 0) shell) (+ count 1) count)))))

(define-syntax g3c4-with-p2g2-first-enrollment-probe
  (syntax-rules ()
    ((_ operation generator (observed-call observed-bundle observed-entry
                            authenticate abort!) body ...)
     (m3-call operation
       (if (not (vector-ref g3c4-p2g2-ownership-gate 0))
           (g3c4-fail 'invalid-argument operation
                      "P2/G2 first enrollment is disabled"))
       (let* ((generator-entry
                (g3c4-generator-entry-call-ready generator operation))
              (model (vector-ref generator-entry 5))
              (tokenizer (vector-ref generator-entry 6))
              (core (car (cdr (g3c4-baseline-tokenizer-entry
                               tokenizer operation 'invalid-state 'invalid-state))))
              (native (vector-ref generator-entry 3))
              (model-native (vector-ref model 3))
              (policy (vector-ref generator-entry 7))
              (owned-bundle (vector #f)))
         (if (not (and (g3c4-call-tuple? 2 2) (= (vector-ref policy 5) 2)))
             (g3c4-fail 'invalid-argument operation
                        "P2/G2 first enrollment needs exact budget two"))
         (guard (construction-error
                  (#t (if (vector-ref owned-bundle 0)
                          (guard (retire-error (#t (exit 134)))
                            (g3c4-p2g2-terminal-carriers-retire!
                              (vector-ref owned-bundle 0))))
                      (raise construction-error)))
           (let* ((bundle (g3c4-p2g2-terminal-carriers-create))
                  (remember-bundle (vector-set! owned-bundle 0 bundle))
                  (first-raw (vector-ref bundle 0))
                  (first-staging (vector-ref bundle 1))
                  (pending-raw (vector-ref bundle 2))
                  (pending-staging (vector-ref bundle 3))
                  (extents (vector-ref bundle 8))
                  (protected-extents (vector 10 24 9 16))
                  (previous-registry (vector-ref g3c4-registry 0))
                  (previous-records (vector-ref g3c4-p2g2-protected-records 0))
                  (previous-anchors (vector-ref g3c4-p2g2-protected-anchors 0))
                  (previous-roots (vector-ref g3c4-p2g2-first-enrollment-roots 0))
                  (ledger (vector #f #f #f #f #f))
                  (call-shell (vector 'g3c4-call-private))
                  (call (vector call-shell 'call 'pending #f generator-entry
                                model tokenizer 2 #f #f ledger g3c4-model-profile))
                  (record (vector call generator-entry model tokenizer core native
                                  #f #f #f #f #f first-raw first-staging
                                  'before-prefix ledger policy protected-extents
                                  call-shell #f model-native))
                  (anchor (vector-copy record))
                  (shell (vector 'g3c4-output-private))
                  (auxiliary (vector pending-raw pending-staging))
                  (entry (vector shell 'output 'pending #f generator-entry model
                                 tokenizer #f auxiliary #f #f g3c4-model-profile))
                  (call-node (cons call previous-registry))
                  (output-node (cons entry call-node))
                  (record-node (cons record previous-records))
                  (anchor-node (cons anchor previous-anchors))
                  (terminal-anchor (vector call bundle extents entry auxiliary #f))
                  (root-node (cons terminal-anchor previous-roots))
                  (state (vector 'prepared #f)))
             (define (verify-roots)
               (if (not (and (eq? (vector-ref g3c4-registry 0) output-node)
                             (eq? (car output-node) entry)
                             (eq? (cdr output-node) call-node)
                             (eq? (car call-node) call)
                             (eq? (cdr call-node) previous-registry)
                             (eq? (vector-ref g3c4-p2g2-protected-records 0) record-node)
                             (eq? (car record-node) record)
                             (eq? (cdr record-node) previous-records)
                             (eq? (vector-ref g3c4-p2g2-protected-anchors 0) anchor-node)
                             (eq? (car anchor-node) anchor)
                             (eq? (cdr anchor-node) previous-anchors)
                             (eq? (vector-ref g3c4-p2g2-first-enrollment-roots 0) root-node)
                             (eq? (car root-node) terminal-anchor)
                             (eq? (cdr root-node) previous-roots)
                             (eq? (vector-ref terminal-anchor 0) call)
                             (eq? (vector-ref terminal-anchor 1) bundle)
                             (eq? (vector-ref terminal-anchor 2) extents)
                             (eq? (vector-ref terminal-anchor 3) entry)
                             (eq? (vector-ref terminal-anchor 4) auxiliary)
                             (eq? (vector-ref terminal-anchor 5) (vector-ref state 1))
                             (eq? (vector-ref call 0) call-shell)
                             (eq? (vector-ref call 10) ledger)
                             (eq? (vector-ref entry 0) shell)
                             (eq? (vector-ref entry 8) auxiliary)
                             (eq? (vector-ref auxiliary 0) pending-raw)
                             (eq? (vector-ref auxiliary 1) pending-staging)
                             (eq? (vector-ref record 1) generator-entry)
                             (eq? (vector-ref record 2) model)
                             (eq? (vector-ref record 3) tokenizer)
                             (eq? (vector-ref record 4) core)
                             (eq? (vector-ref record 5) native)
                             (eq? (vector-ref record 11) first-raw)
                             (eq? (vector-ref record 12) first-staging)
                             (eq? (vector-ref record 13) 'before-prefix)
                             (eq? (vector-ref record 14) ledger)
                             (eq? (vector-ref record 15) policy)
                             (eq? (vector-ref record 16) protected-extents)
                             (eq? (vector-ref record 19) model-native)
                             (= (g3c4-p2g2-shell-count call-shell) 1)
                             (= (g3c4-p2g2-shell-count shell) 1)))
                   (g3c4-fail 'invalid-state operation
                              "P2/G2 first-enrollment identities changed"))
               (g3c4-p2g2-terminal-carriers-check bundle operation)
               (if (not (eq? (g3c4-p2g2-protected-check call operation) record))
                   (g3c4-fail 'invalid-state operation "P2/G2 protected record changed"))
               #t)
             (define (verify candidate-call candidate-shell)
               (if (not (and (eq? (vector-ref state 0) 'reserved)
                             (eq? candidate-call call)
                             (eq? candidate-shell shell)
                             (eq? (vector-ref entry 3) (vector-ref state 1))
                             (eq? (vector-ref record 8) auxiliary)
                             (eq? (vector-ref record 9) pending-raw)
                             (eq? (vector-ref record 10) pending-staging)
                             (eq? (vector-ref ledger 4) entry)
                             (eq? (vector-ref record 6) entry)))
                   (g3c4-fail 'invalid-state operation "P2/G2 pending owner changed"))
               (verify-roots))
             (define (bind-output! current owner)
               (vector-set! current 6 entry)
               (vector-set! current 7 owner)
               (vector-set! current 8 auxiliary)
               (vector-set! current 9 pending-raw)
               (vector-set! current 10 pending-staging)
               (vector-set! current 18 shell))
             (define (abort-installed!)
               (if (eq? (vector-ref state 0) 'reserved)
                   (verify call shell)
                   (verify-roots))
               ;; A lease rejection occurs before any Eshkol mutation. The
               ;; fixture may release its genuine borrow and retry in-region.
               (g3c4-p2g2-protected-abort! call)
               (vector-set! state 0 'drained)
               (g3c4-entry-dead! entry)
               (vector-set! state 1 #f)
               (vector-set! terminal-anchor 5 #f)
               (vector-set! g3c4-registry 0 previous-registry)
               (vector-set! g3c4-p2g2-first-enrollment-roots 0 previous-roots)
               (g3c4-p2g2-terminal-carriers-retire! bundle)
               (vector-set! owned-bundle 0 #f)
               (vector-set! state 0 'closed)
               #t)
             (guard (caught
                      (#t
                        (case (vector-ref state 0)
                          ((acquired reserved)
                           (guard (cleanup-error (#t (exit 134)))
                             (abort-installed!)))
                          ((drained) (exit 134)))
                        (raise caught)))
               ;; All records and list nodes exist before native acquire. The
               ;; successful acquire is followed only by preflighted writes.
               (g3c4-p2g2-terminal-carriers-check bundle operation)
               (g3c4-native-check (g3c4-native-call-acquire native 2 2) operation)
               (vector-set! ledger 0 #t)
               (vector-set! model 10 call)
               (vector-set! ledger 1 #t)
               (vector-set! generator-entry 9 call)
               (vector-set! ledger 2 #t)
               (vector-set! call 2 'live)
               (vector-set! ledger 3 'p2g2-protected)
               (vector-set! m3-call-state 0 call)
               (vector-set! g3c4-p2g2-protected-records 0 record-node)
               (vector-set! g3c4-p2g2-protected-anchors 0 anchor-node)
               (vector-set! g3c4-p2g2-first-enrollment-roots 0 root-node)
               (vector-set! g3c4-registry 0 output-node)
               (vector-set! state 0 'acquired)
               (verify-roots)
               (let ((owner (g3c4-native-output-reserve native 2)))
                 (if (null? owner) (g3c4-native-fail operation))
                 (vector-set! entry 3 owner)
                 (vector-set! state 1 owner)
                 (vector-set! terminal-anchor 5 owner)
                 (vector-set! ledger 4 entry)
                 (bind-output! record owner)
                 (bind-output! anchor owner)
                 (vector-set! state 0 'reserved))
               (verify call shell)
               (let ((observed-call call) (observed-bundle bundle) (observed-entry entry)
                     (authenticate verify) (abort! abort-installed!))
                 body ...)
               (if (eq? (vector-ref state 0) 'reserved) (abort-installed!))
               #t))))))))
