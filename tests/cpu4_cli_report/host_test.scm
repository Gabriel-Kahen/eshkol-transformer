;;; Host orchestration ONLY. Native tensors/training/control/E3 are explicit doubles.
(use-modules (srfi srfi-34) (rnrs bytevectors) (ice-9 match))
(define checks 0)
(define bitwise-and logand)
(define (check label good) (if good (set! checks (+ checks 1)) (error label)))
(define (reject label thunk) (check label (guard (caught (#t #t)) (thunk) #f)))
(define (cpu4-control-vector? x n) (and (vector? x) (= (vector-length x) n)))
(define (cpu4-control-count? x) (and (integer? x) (exact? x) (>= x 0)))
(define (cpu4-binding-fail category operation message) (raise (vector category message)))
(define (et-e1b-private-raise category operation message details ignored)
  (raise (vector category message details)))
(define cpu4-trainer-tag (vector 'trainer))
(define cpu4-control-i64-max 9223372036854775807)
(define record (make-vector 22 #f))
(vector-set! record 0 cpu4-trainer-tag)
(vector-set! record 1 record)
(vector-set! record 2 (vector 'trainer-shell))
(vector-set! record 3 'idle)
(for-each (lambda (i) (vector-set! record i (vector i))) '(6 8 9 14 15 16))
(for-each (lambda (i) (vector-set! record i 0)) '(19 20 21))
(define trainer (vector-ref record 2))
(define trainer-row (vector record 'tokenizer (vector 'T2-entry)))
(define cpu4-trainers (vector (list trainer-row)))
(define (cpu4-trainer-idle-check-internal shell operation)
  (if (not (and (eq? shell trainer) (eq? (vector-ref record 3) 'idle))) (raise 'busy)) record)
(define (cpu4-trainer-row-internal shell operation) trainer-row)
(define accumulation 1)
(define (cpu4-binding-profile! resolved operation) #t)
(define (x1-private-config-ref resolved key) accumulation)
(define events '())
(define (event x) (set! events (append events (list x))))
(define fail-copy #f)
(define fail-end #f)
(define fail-step #f)
(define producer-count 0)
(define (deep x)
  (cond ((vector? x) (list->vector (map deep (vector->list x))))
        ((bytevector? x) (bytevector-copy x)) ((string? x) (string-copy x)) (else x)))
(define (controls)
  (vector (vector 'philox4x32-10 1 1729 0 0) (vector (string-copy "raw") 256)
          (vector (u8-list->bytevector '(1 2)) (u8-list->bytevector '(3 4)))
          (vector (u8-list->bytevector '(5 6)) (string-copy "config"))
          (vector (vector-ref record 19) (vector-ref record 20) (vector-ref record 21))))
(define (cpu4-trainer-control-begin-internal shell kind)
  (cpu4-trainer-idle-check-internal shell 'begin) (event 'begin-WRITE2)
  (vector-set! record 3 'snapshot) (vector 'parent))
(define (cpu4-trainer-controls-copy-internal token)
  (event 'copy) (if fail-copy (raise 'copy-fault)) (deep (controls)))
(define (cpu4-trainer-control-end-internal! token)
  (event 'end) (if fail-end (raise 'end-fault)) (vector-set! record 3 'idle) #t)
(define (observation)
  (let ((bytes (make-bytevector 12 0)))
    (bytevector-u32-set! bytes 0 1090519040 (endianness little))
    (bytevector-u32-set! bytes 4 1082130432 (endianness little))
    (bytevector-u32-set! bytes 8 1073741824 (endianness little)) bytes))
(define (cpu4-training-step-internal! shell)
  (event 'step) (set! producer-count (+ producer-count 1))
  (if fail-step (begin (vector-set! record 3 'step) (vector-set! record 4 (vector 'failed-frame))
                      (raise 'step-fault)))
  (vector-set! record 19 (+ 4 (vector-ref record 19)))
  (vector-set! record 20 (+ 1 (vector-ref record 20)))
  (vector-set! record 21 (- (vector-ref record 20) 1))
  (vector 4 (vector-ref record 20) (vector-ref record 21) (vector (observation))))
(define (cpu4-training-step-abort-internal! frame)
  (event 'abort) (vector-set! record 3 'idle) (vector-set! record 4 #f) #t)
(define (d2-core-bytes=? a b) (bytevector=? a b))
(define (d2-open-dataset-state dataset operation) (if (eq? dataset 'foreign) (raise 'foreign)) dataset)
(define (cpu4-d2-idle-core dataset operation) dataset)
(define tls (vector 0 0 0))
(define scalar-index 0)
(define create-fault #f)
(define scalar-fault #f)
(define (cpu4-cli-native-create)
  (if create-fault (raise 'scalar-create-fault))
  (set! scalar-index (+ scalar-index 1)) (vector scalar-index 'live #f))
(define (cpu4-cli-native-read native)
  (if scalar-fault (begin (set! tls (vector 1 4 8)) -1) (+ 1065353216 (vector-ref native 0))))
(define (cpu4-cli-native-claim native action) (vector-set! native 2 (= action 1)) 0)
(define release-fault #f)
(define (cpu4-cli-native-release native)
  (set! tls (vector 0 0 0))
  (if release-fault (begin (set! tls (vector 1 4 8)) -1)
      (begin (vector-set! native 1 'dead) 0)))
(define (cpu4-cli-native-error i) (vector-ref tls i))
(define e3-runs 0)
(define unbind-fault #f)
(define (cpu4-e3-frame-bind-internal binding destinations) (event 'e3-bind) (vector 0 1))
(define (e3-evaluate-into! model dataset frame)
  (event 'e3-run) (set! e3-runs (+ e3-runs 1)) #t)
(define (e3-counter-ref frame selector) (if (= selector 0) 4 1))
(define (e3-frame-entry-live frame operation) frame)
(define (e3-abort! frame) (event 'e3-abort) (vector-set! frame 1 1) #f)
(define (e3-frame-unbind! frame)
  (event 'e3-unbind) (if unbind-fault (raise 'unbind-fault)) #t)
;;; Fault the actual host guard-install boundary in sourced orchestration.
;;; Source guard forms are rewritten only in this test evaluator, never in prod.
(define guard-install-fault #f)
(define-syntax host-test-guard
  (syntax-rules ()
    ((_ clause body ...)
     (begin (if guard-install-fault (raise 'guard-install-fault))
            (guard clause body ...)))))
(define (instrument-guard form)
  (cond ((eq? form 'guard) 'host-test-guard)
        ((pair? form) (cons (instrument-guard (car form)) (instrument-guard (cdr form))))
        (else form)))
(call-with-input-file "native/cpu4_cli_report_extension.esk"
  (lambda (port) (let loop () (let ((form (read port)))
    (if (not (eof-object? form))
        (begin (if (not (eq? (car form) 'extern)) (eval (instrument-guard form) (current-module))) (loop)))))))
(check "nonnegative finite CE accepts either zero"
  (and (cpu4-cli-ce-bits? 0) (cpu4-cli-ce-bits? 2147483648)
       (not (cpu4-cli-ce-bits? 2139095040)) (not (cpu4-cli-ce-bits? 4290772993))))
(define recovery (vector #f))
(define context (cpu4-cli-report-bind-internal trainer recovery))
(check "registered exact recovery shell" (eq? context (vector-ref recovery 0)))
(reject "copied shell rejected" (lambda () (cpu4-cli-controls-report-copy-internal (vector-copy context))))
(reject "duplicate context rejected" (lambda () (cpu4-cli-report-bind-internal trainer (vector #f))))
(define c (cpu4-cli-controls-report-copy-internal context))
(bytevector-u8-set! (vector-ref (vector-ref c 2) 0) 0 255)
(check "controls bytes detached" (= 1 (bytevector-u8-ref (vector-ref (vector-ref (cpu4-cli-controls-report-copy-internal context) 2) 0) 0)))
(set! events '())
(check "step returns #t only" (eq? #t (cpu4-cli-report-step-internal! context)))
(check "preflight fully ended before producer" (equal? events '(begin-WRITE2 copy end step)))
(define result (cpu4-cli-final-step-report-copy-internal context))
(check "final8 active tokens/numerator/weight/mean offsets"
  (equal? result (vector 'cpu4-cli-final-step-report-v1 4 1 0 4 1090519040 1082130432 1073741824)))
(vector-set! result 7 0)
(check "returned report mutation detached" (= 1073741824 (vector-ref (cpu4-cli-final-step-report-copy-internal context) 7)))
(check "ordinary unreported committed result permits next step" (cpu4-cli-report-step-internal! context))
(define canonical (cpu4-cli-report-row context))
(define original-observation (vector-ref (vector-ref (vector-ref canonical 17) 3) 0))
(bytevector-u8-set! original-observation 11 255)
(define committed-error
  (guard (caught (#t caught)) (cpu4-cli-final-step-report-copy-internal context) #f))
(check "corrupt report exposes committed status/U from retained context"
  (and (vector? committed-error)
       (equal? (vector-ref committed-error 2)
               '((committed #t) (updates 2) (command-steps 2)))))
(check "advanced U/result retained" (and (= producer-count 2) (= (vector-ref record 20) 2) (vector-ref canonical 17)))
(reject "unresolved report blocks producer" (lambda () (cpu4-cli-report-step-internal! context)))
(check "never doubled failed report step" (= producer-count 2))
(bytevector-u8-set! original-observation 11 64)
(cpu4-cli-final-step-report-copy-internal context)
(set! fail-end #t)
(reject "preflight end failure rejects step" (lambda () (cpu4-cli-report-step-internal! context)))
(check "end failure retains exact token and no step" (and (vector-ref canonical 14) (= producer-count 2)))
(set! fail-end #f)
(cpu4-cli-controls-report-copy-internal context)
(vector-set! record 20 3)
(reject "stale U before producer" (lambda () (cpu4-cli-report-step-internal! context)))
(check "stale never invokes producer" (= producer-count 2))
(vector-set! record 20 2)
(set! accumulation 2)
(reject "accumulation2 rejected" (lambda () (cpu4-cli-report-step-internal! context)))
(set! accumulation 1)
(reject "train alias heldout rejected" (lambda () (cpu4-cli-evaluation-report-internal context (vector-ref record 15))))
(set! create-fault #t)
(reject "scalar create cut retains evaluation bind phase"
  (lambda () (cpu4-cli-evaluation-report-internal context 'heldout)))
(check "create failure never invokes E3" (= e3-runs 0))
(set! create-fault #f)
(for-each (lambda (dataset)
  (reject "changed heldout retry rejected before evaluator"
    (lambda () (cpu4-cli-evaluation-report-internal context dataset))))
  (list (vector-ref record 15) 'foreign 'other-heldout))
(check "changed heldout attempts never invoke E3" (= e3-runs 0))
(set! scalar-fault #t)
(reject "scalar read failure retains E3 destinations" (lambda () (cpu4-cli-evaluation-report-internal context 'heldout)))
(check "no repeated E3 after capture failure" (and (= e3-runs 1) (vector-ref canonical 20)))
(define scalar-row (cpu4-cli-scalar-row (vector-ref (vector-ref canonical 19) 0)))
(check "raw error captured before cleanup" (equal? (vector-ref scalar-row 6) (vector 1 4 8)))
(set! scalar-fault #f)
(set! unbind-fault #t)
(reject "unbind rejects success" (lambda () (cpu4-cli-evaluation-report-internal context 'heldout)))
(check "claimed scalar retained after unbind reject" (and (vector-ref scalar-row 4) (vector-ref scalar-row 5)))
(reject "cleanup pending blocks step" (lambda () (cpu4-cli-report-step-internal! context)))
(set! unbind-fault #f)
(define evaluation (cpu4-cli-evaluation-report-internal context 'heldout))
(check "phase retry never reruns actual evaluator" (= e3-runs 1))
(check "evaluation data7 counters" (and (= (vector-length evaluation) 7) (= (vector-ref evaluation 5) 4) (= (vector-ref evaluation 6) 1)))
(check "four scalars cleaned" (not (cpu4-cli-report-pending? canonical)))
(check "primary diagnostic survives resetting cleanup" (equal? (vector-ref scalar-row 6) (vector 1 4 8)))
(set! guard-install-fault #t)
(for-each (lambda (thunk) (reject "guard installation fault" thunk)
            (check "guard installation failure leaves no busy acquisition" (not (vector-ref canonical 21))))
  (list (lambda () (cpu4-cli-controls-report-copy-internal context))
        (lambda () (cpu4-cli-final-step-report-copy-internal context))
        (lambda () (cpu4-cli-report-step-internal! context))
        (lambda () (cpu4-cli-evaluation-report-internal context 'heldout))
        (lambda () (cpu4-cli-report-release-internal! context))))
(set! guard-install-fault #f)
(vector-set! canonical 21 #t)
(define saved-primary (vector-ref canonical 22))
(reject "reentrant entry rejects" (lambda () (cpu4-cli-controls-report-copy-internal context)))
(check "reentrant rejection preserves another invocation busy and error"
  (and (vector-ref canonical 21) (eq? saved-primary (vector-ref canonical 22))))
(vector-set! canonical 21 #f)
(define saved-initial (vector-ref canonical 15))
(vector-set! canonical 15 248)
(vector-set! record 20 250)
(reject "cumulative U250 rejects before producer" (lambda () (cpu4-cli-report-step-internal! context)))
(check "cumulative bound never invokes producer" (= producer-count 2))
(vector-set! canonical 15 saved-initial)
(vector-set! record 20 2)
(cpu4-cli-report-release-internal! context)
(check "exact DEAD release idempotent" (cpu4-cli-report-release-internal! context))
(reject "DEAD context read rejects" (lambda () (cpu4-cli-controls-report-copy-internal context)))
(check "copied inert reports survive context retirement" (and (= (vector-ref evaluation 5) 4) (= (vector-ref result 1) 4)))
(display "CPU4-CLI-REPORT-HOST-DOUBLES-PASS ") (display checks) (newline)
