;;; Called only after C2 compose returned successfully. The caller keeps the
;;; original G3/O2 holds, this ledger, its P1 clone, and the exact request
;;; rooted until this check finishes. After C2 has claimed O2, any uncertain
;;; observation is fatal: preclaim release no longer owns the native state.
(define (g3r-held-o2-adopter-c2-claim! ledger request p1)
  (if (or (not (vector? ledger)) (not (= (vector-length ledger) 9))
          (not (eq? (vector-ref ledger 0) g3r-held-o2-adopter-tag))
          (not (eq? (vector-ref ledger 8) 'enrolled))
          (not (vector? request)) (not (= (vector-length request) 6))
          (not (eq? (vector-ref request 0) c2-training-state-compose-tag))
          (not (eq? (vector-ref request 1) #f))
          (not (eq? (vector-ref request 2) #f))
          (not (vector? (vector-ref ledger 4)))
          (not (= (vector-length (vector-ref ledger 4)) 1))
          (not (vector? (vector-ref ledger 6)))
          (not (= (vector-length (vector-ref ledger 6)) 8))
          (not (pair? (vector-ref ledger 7)))
          (not (eq? (car (vector-ref ledger 7))
                    (vector-ref ledger 6))))
      (g3r-held-o2-fail-stop))
  (let* ((shell (vector-ref request 5))
         (owner (c2-training-state-find shell))
         (o2-shell (vector-ref ledger 5))
         (o2-state (vector-ref ledger 6))
         (issued (vector-ref (vector-ref ledger 4) 0))
         (optimizer (o2-find-identity (vector-ref ledger 2) o2-optimizers)))
    (if (or (not owner) (not (vector? owner))
            (not (= (vector-length owner) 9))
            (not (eq? (vector-ref owner 0) shell))
            (not (eq? (vector-ref owner 1) p1))
            (not (eq? (vector-ref owner 2) o2-shell))
            (not (eq? (vector-ref owner 7) 'live))
            (not (vector? (vector-ref owner 6)))
            (not (= (vector-length (vector-ref owner 6)) 3))
            (not (eq? (vector-ref (vector-ref owner 6) 0)
                      c2-training-state-owner-token-tag))
            (not (eq? (vector-ref (vector-ref owner 6) 1) shell))
            (not (eq? (vector-ref (vector-ref owner 6) 2) #f))
            (not optimizer)
            (not (vector? optimizer))
            (not (= (vector-length optimizer) 6))
            (not (eq? (vector-ref optimizer 1) (vector-ref ledger 3)))
            (not (eq? (vector-ref o2-state 0) o2-shell))
            (not (eq? o2-state (o2-find-identity o2-shell o2-states)))
            (not (eq? (vector-ref o2-state 1) issued))
            (not (eq? (vector-ref o2-state 6) (vector-ref owner 6)))
            (not (eq? (vector-ref o2-state 7) #f))
            (not issued)
            (not (= 0 (g3r-held-o2-issued-match
                        (vector-ref ledger 1) (vector-ref ledger 3)
                        issued (vector-ref o2-state 1)))))
        (g3r-held-o2-fail-stop))
    ;; Assignment-only transfer tail. The ledger remains rooted until the
    ;; coordinator has checked and released both original holds.
    (vector-set! ledger 8 'claimed)
    shell))
