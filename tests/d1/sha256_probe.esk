(load "eshkol_transformer/sha256.esk")

(define (d1-probe-bytevector=? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left))
             #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define empty-expected
  (bytevector 227 176 196 66 152 252 28 20 154 251 244 200 153 111 185 36
              39 174 65 228 100 155 147 76 164 149 153 27 120 82 184 85))
(define abc-expected
  (bytevector 186 120 22 191 143 1 207 234 65 65 64 222 93 174 34 35
              176 3 97 163 150 23 122 156 180 16 255 97 242 0 21 173))
(define boundary-input
  (bytevector 97 98 99 100 98 99 100 101 99 100 101 102 100 101
              102 103 101 102 103 104 102 103 104 105 103 104 105 106
              104 105 106 107 105 106 107 108 106 107 108 109 107 108
              109 110 108 109 110 111 109 110 111 112 110 111 112 113))
(define boundary-expected
  (bytevector 36 141 106 97 210 6 56 184 229 192 38 147 12 62 96 57
              163 60 228 89 100 255 33 103 246 236 237 212 25 219 6 193))
(define a55-expected
  (bytevector 159 67 144 248 211 12 45 217 46 201 240 149 182 94 43 154
              233 176 169 37 165 37 142 36 28 159 30 145 15 115 67 24))
(define a56-expected
  (bytevector 179 84 57 164 172 111 9 72 182 214 249 227 198 175 15 95
              89 12 226 15 27 222 112 144 239 121 112 104 110 198 115 138))
(define a63-expected
  (bytevector 125 62 116 160 93 125 177 91 206 74 217 236 6 88 234 152
              227 240 110 238 207 22 180 198 255 242 218 69 125 220 47 52))
(define a64-expected
  (bytevector 255 224 84 254 122 224 203 109 198 92 58 249 182 29 82 9
              244 57 133 29 180 61 11 165 153 115 55 223 21 70 104 235))
(define a65-expected
  (bytevector 99 83 97 196 139 185 234 177 65 152 231 110 168 171 127 26
              65 104 93 106 214 42 169 20 109 48 29 79 23 235 10 224))

(define empty-digest (d1-sha256 (bytevector)))
(define abc-digest (d1-sha256 (bytevector 97 98 99)))
(define non-bytevector-rejected
  (guard (condition (else #t))
    (d1-sha256 (vector 97 98 99))
    #f))

(display
 (if (and (= (bytevector-length empty-digest) 32)
          (d1-probe-bytevector=? empty-digest empty-expected)
          (d1-probe-bytevector=? abc-digest abc-expected)
          (d1-probe-bytevector=? (d1-sha256 boundary-input)
                                boundary-expected)
          (d1-probe-bytevector=? (d1-sha256 (make-bytevector 55 97)) a55-expected)
          (d1-probe-bytevector=? (d1-sha256 (make-bytevector 56 97)) a56-expected)
          (d1-probe-bytevector=? (d1-sha256 (make-bytevector 63 97)) a63-expected)
          (d1-probe-bytevector=? (d1-sha256 (make-bytevector 64 97)) a64-expected)
          (d1-probe-bytevector=? (d1-sha256 (make-bytevector 65 97)) a65-expected)
          (d1-probe-bytevector=? abc-digest
                                (d1-sha256 (bytevector 97 98 99)))
          non-bytevector-rejected)
     "D1_SHA256_PASS"
     "D1_SHA256_FAIL"))
(newline)
