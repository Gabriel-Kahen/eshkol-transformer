;;; Thin fresh-process caller; the private package owns C2 and T1 authority.
(extern void g3r-private-read ptr ptr
        :real et_g3r_private_test_trained_pair_read_v1)
(define args (command-line))
(define (argument at)
  (let loop ((remaining (cdr args)) (index at))
    (if (= index 0) (car remaining)
        (loop (cdr remaining) (- index 1)))))
(define (proper-length values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))
(if (not (= (proper-length args) 6)) (exit 2))
(define output (vector #f))
(g3r-private-read
  (vector (vector (argument 0) (argument 1)
                  (argument 2) (argument 3)))
  output)
(define record (vector-ref output 0))
(define expected-prompt (string->number (argument 4)))
(if (not (and (integer? expected-prompt) (exact? expected-prompt)
              (<= 0 expected-prompt) (<= expected-prompt 255)
              (vector? record) (= (vector-length record) 8)
              (bytevector? (vector-ref record 2))
              (= (bytevector-length (vector-ref record 2)) 1)
              (= (bytevector-u8-ref (vector-ref record 2) 0)
                 expected-prompt)
              (= (vector-ref record 3) 1)
              (= (vector-ref record 4) 0)
              (= (vector-ref record 5) 0)
              (= (vector-ref (vector-ref record 0) 4) 0)
              (= (bytevector-length (vector-ref record 6)) 96)
              (= (bytevector-length (vector-ref record 7)) 32)))
    (exit 1))
(display "G3-R TRAINED PAIR READER PASS") (newline)
