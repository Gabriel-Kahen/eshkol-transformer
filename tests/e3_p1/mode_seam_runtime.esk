;;; Noninstalled P1 test-variant tuple over a genuine fixed M3 constructor.
;;; E3 in-call placement and complete-call retention are separate downstream gates.
(load "m3_package_root.esk")
(load "e3_p1_modes_extension.esk")

(define checks 0)
(define (check label actual expected)
  (if (equal? actual expected) (set! checks (+ checks 1))
      (begin (display "E3-P1-SEAM-FAIL: ") (display label) (newline)
             (exit 1))))
(define (mode-frame model)
  (let ((box (vector (vector #f) #f)))
    (check 'bind (p1-e3-mode-bind! model box) 0)
    (vector-ref box 1)))
(define config
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define model (m3t-public-model-create config
                (m3t-public-initializer-state 1729)))
(define token (mode-frame model))
(check 'canonical-trusted-surface (vector-length p1-trusted-surface) 73)
(check 'unselected-mask (p1-e3-test-mode-mask token) -1)
(check 'forged-set (p1-e3-test-fixed-mixed! (vector #f)) 1)
(check 'wrong-kind-set (p1-e3-test-fixed-mixed! model) 1)
(check 'still-unselected (p1-e3-test-mode-mask token) -1)
(check 'fixed-mixed (p1-e3-test-fixed-mixed! token) 0)
(check 'mixed17-mask (p1-e3-test-mode-mask token) 43690)
(check 'root-still-train (module-mode-internal model) 'train)
(check 'copied-token-mask
  (p1-e3-test-mode-mask (vector (vector-ref token 0))) -1)
(check 'copied-token-set
  (p1-e3-test-fixed-mixed! (vector (vector-ref token 0))) 1)
(define foreign-model (m3t-public-model-create config
                        (m3t-public-initializer-state 1729)))
(define foreign-token (mode-frame foreign-model))
(check 'foreign-mask (p1-e3-test-mode-mask foreign-token) -1)
(check 'foreign-set (p1-e3-test-fixed-mixed! foreign-token) 1)
(check 'foreign-mode-untouched (module-mode-internal foreign-model) 'train)
(check 'prepare (p1-e3-mode-prepare! token) 0)
(check 'prepared-set-rejected (p1-e3-test-fixed-mixed! token) 2)
(check 'prepared-read-rejected (p1-e3-test-mode-mask token) -2)
(check 'prepared-modes-untouched (module-mode-internal model) 'train)
(check 'enter (p1-e3-mode-enter! token) 0)
(check 'entered-set-rejected (p1-e3-test-fixed-mixed! token) 2)
(check 'all17-eval-during-enter (p1-e3-test-mode-mask token) 131071)
(check 'root-eval (module-mode-internal model) 'eval)
(check 'restore (p1-e3-mode-restore! token) 0)
(check 'exact-mixed17-restore (p1-e3-test-mode-mask token) 43690)
(check 'retry-prepare (p1-e3-mode-prepare! token) 0)
(check 'retry-enter (p1-e3-mode-enter! token) 0)
(check 'retry-all17-eval (p1-e3-test-mode-mask token) 131071)
(check 'retry-restore (p1-e3-mode-restore! token) 0)
(check 'retry-mixed17-restore (p1-e3-test-mode-mask token) 43690)
(check 'foreign-unbind (p1-e3-mode-unbind! foreign-token) 0)
(check 'unbind (p1-e3-mode-unbind! token) 0)
(check 'stale-mask (p1-e3-test-mode-mask token) -2)
(check 'stale-set (p1-e3-test-fixed-mixed! token) 2)
(check 'post-unbind-root-mode (module-mode-internal model) 'train)
(display "E3-P1-SEAM-PASS ") (display checks) (newline)
