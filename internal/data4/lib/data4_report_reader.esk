;;; Private report reader. D1 validates the corpus separately; this checks the
;;; canonical report against the D1 summary and the complete manifest bytes.

(define data4-report-maximum-bytes 32768)

(define (data4-report-fail message)
  (t1-core-fail 'corrupt-data 'data4-report-validate message))

(define (data4-report-split text separator)
  (let loop ((index 0) (start 0) (out '()))
    (if (= index (string-length text))
        (data4-reverse (cons (substring text start index) out))
        (if (char=? (string-ref text index) separator)
            (loop (+ index 1) (+ index 1)
                  (cons (substring text start index) out))
            (loop (+ index 1) start out)))))

(define (data4-report-lines bytes)
  (let ((size (bytevector-length bytes)))
    (if (or (= size 0) (> size data4-report-maximum-bytes)
            (not (= (bytevector-u8-ref bytes (- size 1)) 10)))
        (data4-report-fail "invalid report size or final LF"))
    (let loop ((index 0))
      (if (< index size)
          (let ((code (bytevector-u8-ref bytes index)))
            (if (not (or (= code 9) (= code 10)
                         (and (>= code 32) (<= code 126))))
                (data4-report-fail "report is not canonical ASCII"))
            (loop (+ index 1)))))
    (let* ((text (utf8->string bytes))
           (pieces (data4-report-split text #\newline)))
      (if (not (string=? (car (data4-reverse pieces)) ""))
          (data4-report-fail "invalid report terminator"))
      (data4-reverse (cdr (data4-reverse pieces))))))

(define (data4-report-value line key)
  (let ((fields (data4-report-split line #\tab)))
    (if (or (not (pair? fields)) (not (pair? (cdr fields)))
            (not (null? (cdr (cdr fields))))
            (not (string=? (car fields) key)))
        (data4-report-fail "wrong report field"))
    (car (cdr fields))))

(define (data4-report-number text maximum)
  (if (or (= (string-length text) 0)
          (and (> (string-length text) 1)
               (char=? (string-ref text 0) #\0)))
      (data4-report-fail "noncanonical report integer"))
  (let loop ((index 0) (value 0))
    (if (= index (string-length text)) value
        (let ((digit (- (char->integer (string-ref text index)) 48)))
          (if (or (< digit 0) (> digit 9)
                  (> value (quotient (- maximum digit) 10)))
              (data4-report-fail "report integer out of range"))
          (loop (+ index 1) (+ (* value 10) digit))))))

(define (data4-report-hex? text)
  (and (= (string-length text) 64)
       (let loop ((index 0))
         (if (= index 64) #t
             (let ((code (char->integer (string-ref text index))))
               (and (or (and (>= code 48) (<= code 57))
                        (and (>= code 97) (<= code 102)))
                    (loop (+ index 1))))))))

(define (data4-report-expected line expected)
  (if (not (string=? line expected))
      (data4-report-fail "wrong report constant")))

(define (data4-report-field lines key)
  (if (null? lines) (data4-report-fail "truncated report"))
  (vector (data4-report-value (car lines) key) (cdr lines)))

(define (data4-report-decimal lines key maximum)
  (let ((field (data4-report-field lines key)))
    (vector (data4-report-number (vector-ref field 0) maximum)
            (vector-ref field 1))))

(define (data4-report-first-match length digest kept)
  (cond ((null? kept) #f)
        ((and (= length (vector-ref (car kept) 1))
              (string=? digest (vector-ref (car kept) 2)))
         (vector-ref (car kept) 0))
        (else (data4-report-first-match length digest (cdr kept)))))

(define (data4-report-document line ordinal minimum maximum seen kept)
  (let ((fields (data4-report-split line #\tab)))
    (if (not (equal? (data4-bounded-length fields 8) 7))
        (data4-report-fail "wrong document field count"))
    (let* ((label (car fields))
           (number (car (cdr fields)))
           (id (car (cdr (cdr fields))))
           (length (data4-report-number
                    (car (cdr (cdr (cdr fields)))) 65536))
           (digest (car (cdr (cdr (cdr (cdr fields))))))
           (status (car (cdr (cdr (cdr (cdr (cdr fields)))))))
           (duplicate (car (cdr (cdr (cdr (cdr (cdr (cdr fields))))))))
           (duplicate-id (data4-report-first-match length digest kept)))
      (if (or (not (string=? label "document"))
              (not (= (data4-report-number number 127) ordinal))
              (not (data4-source-id? id))
              (data4-report-id-present? id seen)
              (not (data4-report-hex? digest)))
          (data4-report-fail "invalid document identity"))
      (cond ((< length minimum)
             (if (or (not (string=? status "below-min"))
                     (not (string=? duplicate "")))
                 (data4-report-fail "invalid below-min row")))
            ((> length maximum)
             (if (or (not (string=? status "above-max"))
                     (not (string=? duplicate "")))
                 (data4-report-fail "invalid above-max row")))
            (duplicate-id
             (if (or (not (string=? status "duplicate"))
                     (not (string=? duplicate duplicate-id)))
                 (data4-report-fail "invalid duplicate row")))
            (else
             (if (or (not (string=? status "keep"))
                     (not (string=? duplicate "")))
                 (data4-report-fail "invalid keep row"))))
      (vector id length digest status))))

(define (data4-report-id-present? id seen)
  (and (not (null? seen))
       (or (string=? id (car seen))
           (data4-report-id-present? id (cdr seen)))))

(define (data4-report-check-version line)
  (let ((fields (data4-report-split line #\tab)))
    (if (or (not (equal? (data4-bounded-length fields 4) 3))
            (not (string=? (car fields) "version")))
        (data4-report-fail "wrong report version field"))
    (let ((major (data4-report-number (cadr fields) 9223372036854775807))
          (minor (data4-report-number (caddr fields) 9223372036854775807)))
      (if (or (not (= major 2)) (not (= minor 0)))
          (t1-core-fail 'version-mismatch 'data4-report-validate
                        "unsupported DATA4 report version; expected 2.0")))))

;;; Returns the supplied D1 summary after verifying its manifest binding.
(define (data4-report-validate bytes summary manifest-bytes)
  (let ((lines (data4-report-lines bytes)))
    (if (or (null? lines) (null? (cdr lines)))
        (data4-report-fail "truncated report"))
    (data4-report-expected (car lines) "format\teshkol-data4-corpus-report")
    (data4-report-check-version (cadr lines))
    (let ((count (data4-bounded-length lines 146)))
      (if (or (not count) (< count 19))
          (data4-report-fail "wrong report line count")))
    (data4-report-expected (car (cdr (cdr lines)))
                           "filter\traw-byte-length-inclusive")
    (data4-report-expected (car (cdr (cdr (cdr lines))))
                           "dedup\traw-exact-first-passing")
    (let* ((a (data4-report-decimal (cdddr (cdr lines))
                                    "minimum-bytes" 65536))
           (minimum (vector-ref a 0))
           (b (data4-report-decimal (vector-ref a 1)
                                    "maximum-bytes" 65536))
           (maximum (vector-ref b 0))
           (fingerprint (data4-report-field (vector-ref b 1)
                                            "tokenizer-fingerprint"))
           (vocab (data4-report-decimal (vector-ref fingerprint 1)
                                         "vocabulary-size" 9223372036854775807))
           (input-count (data4-report-decimal (vector-ref vocab 1)
                                               "input-count" 128))
           (input-bytes (data4-report-decimal (vector-ref input-count 1)
                                               "input-bytes" 65536))
           (kept-count (data4-report-decimal (vector-ref input-bytes 1)
                                              "kept-count" 128))
           (kept-bytes (data4-report-decimal (vector-ref kept-count 1)
                                              "kept-bytes" 65536))
           (limit (data4-report-decimal (vector-ref kept-bytes 1)
                                         "shard-token-limit" 65536))
           (shards (data4-report-decimal (vector-ref limit 1)
                                          "shard-count" 65536))
           (tokens (data4-report-decimal (vector-ref shards 1)
                                          "total-tokens" 65536))
           (manifest (data4-report-field (vector-ref tokens 1)
                                         "manifest-sha256"))
           (manifest-digest (vector-ref manifest 0)))
      (if (not (data4-report-hex? manifest-digest))
          (data4-report-fail "malformed manifest SHA-256"))
      (if (not (string=? manifest-digest
                         (t1-core-hex (t1-core-sha256 manifest-bytes))))
          (data4-report-fail "report manifest SHA-256 mismatch"))
      (if (or (> minimum maximum) (= (vector-ref input-count 0) 0)
              (= (vector-ref limit 0) 0)
              (> (vector-ref kept-count 0) (vector-ref input-count 0))
              (> (vector-ref kept-bytes 0) (vector-ref input-bytes 0))
              (not (string=? (vector-ref fingerprint 0)
                             (et-d1-private-token-corpus-summary-tokenizer-fingerprint
                              summary)))
              (not (= (vector-ref vocab 0)
                      (et-d1-private-token-corpus-summary-vocab-size summary)))
              (not (= (vector-ref limit 0)
                      (et-d1-private-token-corpus-summary-shard-token-limit
                       summary)))
              (not (= (vector-ref shards 0)
                      (et-d1-private-token-corpus-summary-shard-count summary)))
              (not (= (vector-ref tokens 0)
                      (et-d1-private-token-corpus-summary-total-tokens summary)))
              (not (= (vector-ref shards 0)
                      (if (= (vector-ref tokens 0) 0) 0
                          (+ (quotient (- (vector-ref tokens 0) 1)
                                       (vector-ref limit 0)) 1)))))
          (data4-report-fail "report and corpus totals disagree"))
      (let loop ((rest (vector-ref manifest 1)) (ordinal 0) (seen '())
                 (kept '()) (raw-total 0) (kept-total 0) (kept-n 0))
        (if (= ordinal (vector-ref input-count 0))
            (begin
              (if (or (null? rest) (null? (cdr rest))
                      (not (null? (cdr (cdr rest))))
                      (not (= raw-total (vector-ref input-bytes 0)))
                      (not (= kept-total (vector-ref kept-bytes 0)))
                      (not (= kept-n (vector-ref kept-count 0))))
                  (data4-report-fail "report row totals disagree"))
              (data4-report-expected (car rest) "checksum-algorithm\tsha256")
              (let* ((trailer (car (cdr rest)))
                     (digest (data4-report-value trailer "checksum"))
                     (prefix-length (- (bytevector-length bytes)
                                       (+ (string-length trailer) 1)))
                     (actual (t1-core-hex
                              (t1-core-sha256
                               (bytevector-copy bytes 0 prefix-length)))))
                (if (or (not (data4-report-hex? digest))
                        (not (string=? digest actual)))
                    (data4-report-fail "report checksum mismatch"))
                summary))
            (if (null? rest) (data4-report-fail "missing document row")
                (let* ((row (data4-report-document
                             (car rest) ordinal minimum maximum seen
                             (data4-reverse kept)))
                       (keep? (string=? (vector-ref row 3) "keep")))
                  (loop (cdr rest) (+ ordinal 1)
                        (cons (vector-ref row 0) seen)
                        (if keep? (cons row kept) kept)
                        (+ raw-total (vector-ref row 1))
                        (if keep? (+ kept-total (vector-ref row 1))
                            kept-total)
                        (if keep? (+ kept-n 1) kept-n)))))))))
