;;; Definitions only; append after ONE cpu4_v1 root and accepted heldout/body.esk.
;;; Actual training + FILE restore witness. No artificial state seeding.
(define cpu4-resume-session (vector 'new #f))
(define cpu4-resume-checks 0)
(define cpu4-resume-steps 0)
(define (cpu4-resume-check label good)
  (if good (set! cpu4-resume-checks (+ cpu4-resume-checks 1))
      (cpu4-binding-fail 'invalid-state 'cpu4-heldout-resume label)))
(define (cpu4-resume-config)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu '(none) '(constant)
    (list (list 'group (cpu4-checkpoint-vector->list g3c4-model-paths 14)
      "3dcccccd" "3f000000" "3f000000" "3a83126f" "00000000"))))

;;; Fixed-array capture uses the genuine C2/P1/O2 owner APIs, following the
;;; accepted positive FILE fixture. All leaves detach before borrow end.
;;; cleanup=[C2 borrow, active P1 tensor borrow #(p1,token,entry)].
(define (cpu4-resume-capture-cleanup! cleanup)
  (guard (caught (#t (cpu4-binding-fail-stop 70)))
    (if (vector-ref cleanup 1)
        (let ((active (vector-ref cleanup 1)))
          (state-dict-c2-owned-tensor-borrow-end-internal
            (vector-ref active 0) (vector-ref active 1) (vector-ref active 2)
            'cpu4-heldout-resume)
          (vector-set! cleanup 1 #f)))
    (if (vector-ref cleanup 0)
        (begin (c2-training-state-borrow-end-internal (vector-ref cleanup 0))
               (vector-set! cleanup 0 #f))) #t))
(define (cpu4-resume-capture image)
  (let ((cleanup (vector #f #f)))
    (guard (caught (#t (cpu4-resume-capture-cleanup! cleanup) (raise caught)))
      (vector-set! cleanup 0
        (c2-training-state-borrow-begin-internal image 'cpu4-heldout-resume))
      (let* ((borrow (vector-ref cleanup 0))
             (projection (c2-training-state-borrow-projection-internal borrow))
             (token (c2-training-state-borrow-owner-token-internal borrow 'cpu4-heldout-resume))
             (p1 (vector-ref projection 0)) (o2 (vector-ref projection 1))
             (p1-data (state-dict-c2-owned-projection-internal p1 token 'cpu4-heldout-resume))
             (entries (vector-ref p1-data 4))
             (planes (make-vector 14 #f)) (moments (make-vector 28 #f)))
        (let capture-values ((index 0) (remaining entries))
          (if (< index 14)
              (let* ((entry (car remaining))
                     (active (vector p1 token entry))
                     (carrier (state-dict-c2-owned-tensor-borrow-begin-internal
                                p1 token entry 'cpu4-heldout-resume)))
                (vector-set! cleanup 1 active)
                (vector-set! planes index
                  (c2-model-checkpoint-encode
                    (vector carrier 'parameter (vector-ref g3c4-model-shapes index)
                            'f32 'cpu 'dense-row-major-contiguous 'cpu4-heldout-resume)))
                (state-dict-c2-owned-tensor-borrow-end-internal
                  p1 token entry 'cpu4-heldout-resume)
                (vector-set! cleanup 1 #f)
                (capture-values (+ index 1) (cdr remaining)))))
        (let capture-moments ((index 0))
          (if (< index 28)
              (let* ((parameter (quotient index 2))
                     (elements (cpu4-checkpoint-product (vector-ref g3c4-model-shapes parameter)))
                     (bytes (make-bytevector (* elements 4) 0)))
                (o2-state-copy-moment-bits-c2-owned-internal
                  (vector o2 parameter (modulo index 2) bytes elements token 'cpu4-heldout-resume))
                (vector-set! moments index bytes)
                (capture-moments (+ index 1)))))
        (let* ((controls (cpu4-checkpoint-controls-copy (vector-ref projection 2)))
               (source-o2 (vector-ref projection 4)) (source-topology (vector-ref projection 3))
               (metadata (vector (o2-copy-config-data 'cpu4-heldout-resume (vector-ref source-o2 0))
                                 (o2-copy-paths (vector-ref source-o2 1))
                                 (o2-copy-aliases (vector-ref source-o2 2))
                                 (vector-ref source-o2 3)))
               (topology (vector (o2-copy-paths (vector-ref source-topology 0))
                                 (o2-copy-config-data 'cpu4-heldout-resume (vector-ref source-topology 1))
                                 (o2-copy-aliases (vector-ref source-topology 2))))
               (result (vector planes moments controls metadata topology)))
          (cpu4-resume-capture-cleanup! cleanup)
          result)))))
(define (cpu4-resume-snapshot-copy! trainer image-cell)
  (cpu4-trainer-snapshot-internal trainer image-cell)
  (let ((copy (cpu4-resume-capture (vector-ref image-cell 0))))
    (c2-training-state-release-internal! (vector-ref image-cell 0) 'trainer-state-release!)
    (vector-set! image-cell 0 #f) copy))
(define (cpu4-resume-plane-size planes count)
  (let sum-plane-bytes ((index 0) (bytes 0))
    (if (= index count) bytes
        (sum-plane-bytes (+ index 1) (+ bytes (bytevector-length (vector-ref planes index)))))))
(define (cpu4-resume-values=? expected actual)
  (let compare-values ((index 0))
    (or (= index 14)
        (and (d2-core-bytes=? (vector-ref expected index) (vector-ref actual index))
             (compare-values (+ index 1))))))
(define (cpu4-resume-copy=? expected actual)
  (and (cpu4-resume-values=? (vector-ref expected 0) (vector-ref actual 0))
       (let compare-moments ((index 0))
         (or (= index 28)
             (and (d2-core-bytes=? (vector-ref (vector-ref expected 1) index)
                                   (vector-ref (vector-ref actual 1) index))
                  (compare-moments (+ index 1)))))
       (heldout-controls=? (vector-ref expected 2) (vector-ref actual 2))
       (equal? (vector-ref expected 3) (vector-ref actual 3))
       (equal? (vector-ref expected 4) (vector-ref actual 4))))
(define (cpu4-resume-counts! trainer updates)
  (let* ((record (cpu4-trainer-idle-check-internal trainer 'cpu4-heldout-resume))
         (native-updates (o2-optimizer-completed-updates-internal (vector-ref record 13)))
         (cursor (d2-core-cursor-decode (cpu4-d2-cursor-capture-internal (vector-ref record 15))))
         (epoch (d2-core-cursor-decode (vector-ref record 17))))
    (cpu4-resume-check "actual trainer/native count and one-row cursor equation"
      (and (= (vector-ref record 19) (* updates 4)) (= (vector-ref record 20) updates)
           (= (vector-ref record 21) (if (= updates 0) 0 (- updates 1)))
           (= native-updates updates) (= (vector-ref cursor 14) 1)
           (= (vector-ref cursor 15) (if (= updates 0) 0 1))
           (= (vector-ref epoch 15) 0)))
    record))
;;; Guard is inside this NONRECURSIVE helper, never inside a named-let loop.
(define (cpu4-resume-step! trainer)
  (let ((result (guard (caught (#t (raise caught)))
                  (cpu4-training-step-internal! trainer))))
    (set! cpu4-resume-steps (+ cpu4-resume-steps 1)) result))
(define (cpu4-resume-run! trainer first last)
  (let resume-update-loop ((update first))
    (if (<= update last)
        (let* ((result (cpu4-resume-step! trainer))
               (observations (vector-ref result 3)) (observation (vector-ref observations 0)))
          (cpu4-resume-check "actual fullmask step observation and counts"
            (and (= (vector-ref result 0) 4) (= (vector-ref result 1) update)
                 (= (vector-ref result 2) (- update 1)) (= (vector-length observations) 1)
                 (= (bytevector-length observation) 12)
                 (= (cpu4-training-u32 observation 4) 1082130432)))
          (cpu4-resume-counts! trainer update)
          (resume-update-loop (+ update 1))) #t)))
(define (cpu4-resume-stream! dataset)
  (let ((cursor (d2-core-cursor-decode (cpu4-d2-cursor-capture-internal dataset))))
    (cpu4-resume-check "caller stream exact raw N1T4 one-row initial profile"
      (and (= (vector-ref cursor 3) 256) (= (vector-ref cursor 4) 1)
           (= (vector-ref cursor 5) 4) (= (vector-ref cursor 14) 1)
           (= (vector-ref cursor 15) 0) (eq? (vector-ref cursor 10) #f)
           (= (vector-ref cursor 11) 1) (eq? (vector-ref cursor 12) #f)))
    cursor))
(define (cpu4-resume-emit phase trainer copy)
  (let* ((record (cpu4-trainer-idle-check-internal trainer 'cpu4-heldout-resume))
         (shell (vector-ref record 13)))
    (display "CPU4-RESUME-STATE ") (display phase)
    (display " ") (display (vector-ref record 19))
    (display " ") (display (vector-ref record 20))
    (display " ") (display (vector-ref record 21))
    (display " ") (display (cpu4-resume-plane-size (vector-ref copy 0) 14))
    (display " ") (display (cpu4-resume-plane-size (vector-ref copy 1) 28))
    (display " ") (display (o2-optimizer-completed-updates-internal shell))
    (display " ") (display (o2-optimizer-schedule-factor-bits-internal shell)) (newline)))

;;; Fresh B frame on the genuine restored binding. No A one-shot ledger reset.
;;; Reuses accepted observer/control helpers and actual E3; no numerical evaluator.
(define (cpu4-resume-evaluate-b! trainer dataset)
  (let ((ledger (vector #f (vector #f #f #f #f) #f #f)))
    (guard (caught (#t (heldout-cleanup! ledger) (raise caught)))
      (let* ((record (cpu4-resume-counts! trainer 250))
             (binding (vector-ref record 9)) (model (vector-ref record 8))
             (lease (cpu4-model-binding-native-lease-internal binding))
             (optimizer (vector-ref (vector-ref record 14) 1)))
        (heldout-source! record dataset)
        (cpu4-resume-check "no prior E3 observation owner" (= (heldout-live-owned) 0))
        (let* ((before-controls (heldout-copy-controls! trainer ledger))
               (before-modes (heldout-modes record))
               (before-cursor (cpu4-d2-cursor-capture-internal dataset)))
          (vector-set! ledger 2 (heldout-pointer (heldout-image-create lease optimizer)))
          (let resume-create-outputs ((index 0))
            (if (< index 4)
                (begin (vector-set! (vector-ref ledger 1) index (heldout-pointer (heldout-output-create)))
                       (resume-create-outputs (+ index 1)))))
          (vector-set! ledger 0 (cpu4-e3-frame-bind-internal binding (vector-ref ledger 1)))
          (e3-evaluate-into! model dataset (vector-ref ledger 0))
          (let ((report (vector
                  (heldout-output-bits (vector-ref (vector-ref ledger 1) 0))
                  (heldout-output-bits (vector-ref (vector-ref ledger 1) 1))
                  (heldout-output-bits (vector-ref (vector-ref ledger 1) 2))
                  (heldout-output-bits (vector-ref (vector-ref ledger 1) 3))
                  (e3-counter-ref (vector-ref ledger 0) 0) (e3-counter-ref (vector-ref ledger 0) 1)
                  (vector-ref record 19) (vector-ref record 20) (vector-ref record 21))))
            (e3-frame-unbind! (vector-ref ledger 0))
            (vector-set! ledger 0 #f)
            (cpu4-resume-check "B E3 preserves complete controls and modes"
              (and (heldout-controls=? before-controls (heldout-copy-controls! trainer ledger))
                   (equal? before-modes (heldout-modes record))))
            (cpu4-resume-check "B E3 preserves heldout cursor and full values/moments/identities"
              (and (d2-core-bytes=? before-cursor (cpu4-d2-cursor-capture-internal dataset))
                   (= (heldout-image-equal lease optimizer (vector-ref ledger 2)) 1)))
            (heldout-source! record dataset)
            (cpu4-resume-counts! trainer 250)
            (heldout-cleanup! ledger)
            report))))))
;;; [A child ticket, B recovery cell, live caller snapshot cell]. No caller D2
;;; or T2 destruction; all C2 borrowers/images/outputs/frames precede O2 retire.
(define (cpu4-resume-cleanup! ledger)
  (guard (caught (#t (cpu4-binding-fail-stop 70)))
    (if (vector-ref (vector-ref ledger 2) 0)
        (begin
          (c2-training-state-release-internal! (vector-ref (vector-ref ledger 2) 0) 'trainer-state-release!)
          (vector-set! (vector-ref ledger 2) 0 #f)))
    (if (vector-ref (vector-ref ledger 1) 0)
        (cpu4-checkpoint-factory-retire-internal! (vector-ref (vector-ref ledger 1) 0)))
    (if (vector-ref ledger 0) (cpu4-owned-candidate-retire-internal! (vector-ref ledger 0)))
    (if (not (= (heldout-live-owned) 0)) (cpu4-binding-fail-stop 70)) #t))

(define (cpu4-heldout-resume-runtime! resolved tokenizer train-a train-b heldout path policy report)
  (if (not (eq? (vector-ref cpu4-resume-session 0) 'new))
      (cpu4-binding-fail 'invalid-state 'cpu4-heldout-resume "caller cannot repeat"))
  (let ((ledger (vector #f (vector #f) (vector #f))))
    (vector-set! cpu4-resume-session 0 'running)
    (vector-set! cpu4-resume-session 1 ledger)
    (guard (caught
      (#t (cpu4-resume-cleanup! ledger)
          (display "CPU4-RESUME-ERROR ")
          (if (transformer-error? caught)
              (begin (display (transformer-error-category caught)) (display " ")
                     (display (transformer-error-operation caught)) (display " ")
                     (display (transformer-error-message caught)))
              (display "foreign condition"))
          (newline) (cpu4-binding-fail-stop 70)))
      (cpu4-resume-check "nonregional caller and distinct D2 owning shells"
        (and (null? (cpu4-checkpoint-native-current-region))
             (not (eq? train-a train-b)) (not (eq? train-a heldout)) (not (eq? train-b heldout))))
      (cpu4-binding-profile! resolved 'cpu4-heldout-resume)
      (cpu4-resume-check "fixed seed and accumulation" (and
        (= (x1-private-config-ref resolved 'run.seed) 1729)
        (= (x1-private-config-ref resolved 'training.accumulation-steps) 1)))
      (let ((a-cursor (cpu4-resume-stream! train-a)) (b-cursor (cpu4-resume-stream! train-b)))
        (cpu4-resume-check "distinct D2 owners over same authenticated train resource"
          (and (d2-core-bytes=? (vector-ref a-cursor 1) (vector-ref b-cursor 1))
               (d2-core-bytes=? (cpu4-d2-cursor-capture-internal train-a)
                               (cpu4-d2-cursor-capture-internal train-b)))))
      (vector-set! ledger 0 (cpu4-owned-candidate-create-internal resolved))
      (let ((source (vector-ref ledger 0)))
        (module-train! (cpu4-owned-model-internal source))
        (cpu4-owned-optimizer-create-internal! source (cpu4-resume-config))
        (cpu4-owned-binding-create-internal! source)
        (let ((a (cpu4-owned-trainer-create-internal! source tokenizer train-a)))
          (cpu4-resume-counts! a 0)
          (cpu4-heldout-evaluate-internal! a heldout 'baseline)
          (let ((at0 (cpu4-resume-snapshot-copy! a (vector-ref ledger 2))))
          (cpu4-resume-run! a 1 125)
          (cpu4-trainer-snapshot-internal a (vector-ref ledger 2))
          (let ((at125 (cpu4-resume-capture (vector-ref (vector-ref ledger 2) 0))))
            (cpu4-resume-check "actual A125 values differ from SAME A0 initialization"
              (not (cpu4-resume-values=? (vector-ref at0 0) (vector-ref at125 0))))
            (cpu4-resume-check "full1192 values and2384 moment words captured"
              (and (= (cpu4-resume-plane-size (vector-ref at125 0) 14) 4768)
                   (= (cpu4-resume-plane-size (vector-ref at125 1) 28) 9536)
                   (= cpu4-resume-steps 125)))
            (c2-public-checkpoint-save! (vector-ref (vector-ref ledger 2) 0) path policy '(:overwrite? #t))
            (c2-training-state-release-internal! (vector-ref (vector-ref ledger 2) 0) 'trainer-state-release!)
            (vector-set! (vector-ref ledger 2) 0 #f)
            (cpu4-resume-emit 'saved125 a at125)
            (cpu4-resume-run! a 126 250)
            (let* ((post-a (cpu4-heldout-evaluate-internal! a heldout 'post))
                   (at250 (cpu4-resume-snapshot-copy! a (vector-ref ledger 2)))
                   (b (cpu4-checkpoint-factory-create-internal!
                        path policy report resolved tokenizer train-b (vector-ref ledger 1)))
                   (factory (cpu4-checkpoint-factory-row
                              (vector-ref (vector-ref ledger 1) 0) 'cpu4-heldout-resume))
                   (b-record (cpu4-resume-counts! b 125)))
              (cpu4-resume-check "factory released actual loaded image/stage before continuation"
                (and (not (vector-ref factory 10)) (not (vector-ref factory 11))
                     (= cpu4-resume-steps 250)))
              (cpu4-resume-check "distinct restored model/binding on exact caller B stream"
                (and (not (eq? (vector-ref b-record 8) (cpu4-owned-model-internal source)))
                     (not (eq? (vector-ref b-record 9) (vector-ref (cpu4-owned-row source 'cpu4-heldout-resume) 9)))
                     (eq? (vector-ref b-record 15) train-b)))
              (let ((restored (cpu4-resume-snapshot-copy! b (vector-ref ledger 2))))
                (cpu4-resume-check "complete trained A125 restored BEFORE first B continuation"
                  (cpu4-resume-copy=? at125 restored))
                (cpu4-resume-emit 'restored125 b restored))
              (cpu4-resume-run! b 126 250)
              (let* ((final-b (cpu4-resume-snapshot-copy! b (vector-ref ledger 2)))
                     (post-b (cpu4-resume-evaluate-b! b heldout)))
                (cpu4-resume-check "complete resumed B250 equals uninterrupted A250"
                  (cpu4-resume-copy=? at250 final-b))
                (cpu4-resume-check "fresh B E3 matches all four actual A metrics and counts"
                  (equal? post-a post-b))
                (cpu4-resume-emit 'equal250 b final-b)
                (display "CPU4-RESUME-HELDOUT")
                (let emit-resume-metrics ((index 0))
                  (if (< index 9)
                      (begin (display " ") (display (vector-ref post-b index))
                             (emit-resume-metrics (+ index 1)))))
                (newline)
                (cpu4-resume-cleanup! ledger)
                (cpu4-resume-check "375 actual steps and all caller-owned native factories drained"
                  (and (= cpu4-resume-steps 375) (not (vector-ref (vector-ref ledger 2) 0))
                       (eq? (vector-ref factory 3) 'dead) (not (vector-ref factory 14))
                       (eq? (vector-ref (cpu4-owned-row source 'cpu4-heldout-resume) 3) 'dead)
                       (= (heldout-live-owned) 0)))
                (vector-set! cpu4-resume-session 1 #f)
                (vector-set! cpu4-resume-session 0 'done)
                (display "CPU4-RESUME-PASS ") (display cpu4-resume-checks)
                (display " 250 125 ") (display cpu4-resume-steps)
                (display " 1192 2384 0") (newline)
                #t)))))))))
