(require transformer.data)
(require transformer.persistence)
(require transformer.tokenizer)

(define (config directory)
  (list ':directory directory
        ':batch-size 1
        ':sequence-length 1
        ':maximum-manifest-bytes 1048576
        ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 65536
        ':maximum-batch-bytes 17
        ':shuffle-seed 7
        ':shuffle-window-rows 64
        ':packing? #t))

;; Exact accepted payload bound:
;; 57567 + 8399 + 17*1*1023 + 8*min(1,1024) = 83365.
(define (arena-config directory)
  (list ':directory directory
        ':batch-size 1
        ':sequence-length 1023
        ':maximum-manifest-bytes 57567
        ':maximum-shard-bytes 8399
        ':maximum-total-tokens 1024
        ':maximum-batch-bytes 17391
        ':shuffle-seed #f
        ':shuffle-window-rows 1
        ':packing? #t))

(define args (command-line))
(define tokenizer-path (car (cdr args)))
(define directory (car (cdr (cdr args))))
(define mode (car (cdr (cdr (cdr args)))))
(define policy (persistence-policy 1048576 1048576 1048576 1 'cpu))
(define tokenizer (tokenizer-load tokenizer-path policy))

(cond
 ((string=? mode "arena-open")
  (let* ((before (__arena-used))
         (dataset (token-dataset-open (arena-config directory) tokenizer))
         (after (__arena-used)))
    (token-dataset-close! dataset)
    (display "D2 RESOURCE ARENA OPEN: ")
    (display (- after before)) (display " bytes") (newline)))
 ((string=? mode "arena-packed")
  (let* ((dataset (token-dataset-open (arena-config directory) tokenizer))
         (before (__arena-used))
         (batch (token-dataset-next-batch dataset)))
    (if (token-dataset-end? batch)
        (begin (display "unexpected D2 arena EOS") (newline) (exit 65))
        (begin
          (token-batch-validate batch)
          (token-batch-release! batch)))
    (let ((after (__arena-used)))
      (token-dataset-close! dataset)
      (display "D2 RESOURCE ARENA PACKED: ")
      (display (- after before)) (display " bytes") (newline))))
 ((or (string=? mode "consume") (string=? mode "consume-short"))
  (let ((dataset (token-dataset-open (config directory) tokenizer)))
    (let loop ((batches 0))
      ;; Public shells are caller-owned Eshkol values. Explicit native batch
      ;; release ends their borrow/storage lifetime; this explicit iteration
      ;; region ends their Eshkol allocation lifetime after the last use.
      (let ((finished?
             (if (and (string=? mode "consume-short") (= batches 1024))
                 #t
                 (with-region ('d2-batch-iteration 65536)
                   (let ((batch (token-dataset-next-batch dataset)))
                     (if (token-dataset-end? batch) #t
                         (begin
                           (let ((inputs (token-batch-inputs batch))
                                 (targets (token-batch-targets batch))
                                 (mask (token-batch-loss-mask batch)))
                             (if (not (and (eq? inputs (token-batch-inputs batch))
                                           (eq? targets (token-batch-targets batch))
                                           (eq? mask (token-batch-loss-mask batch))))
                                 (begin
                                   (display "D2 accessor identity drift") (newline)
                                   (exit 65))))
                           (token-batch-validate batch)
                           (token-batch-release! batch)
                           #f)))))))
        (if finished?
            (begin
              (token-dataset-close! dataset)
              (display "D2 RESOURCE CONSUME PASS: ")
              (display batches) (display " batches") (newline))
            (loop (+ batches 1)))))))
 ((string=? mode "reopen")
  (let loop ((iteration 0))
    (if (= iteration 256)
        (begin
          (display "D2 RESOURCE REOPEN PASS: 256 datasets") (newline))
        (let ((dataset (token-dataset-open (config directory) tokenizer)))
          (let ((batch (token-dataset-next-batch dataset)))
            (if (token-dataset-end? batch) #t
                (token-batch-release! batch)))
          (token-dataset-close! dataset)
          (loop (+ iteration 1))))))
 ((string=? mode "accessors")
  (let* ((dataset (token-dataset-open (config directory) tokenizer))
         (batch (token-dataset-next-batch dataset)))
    ;; Warm the three reusable bridge boxes before measuring the exact live
    ;; path. Every later accessor returns the already-published tensor shell.
    (token-batch-inputs batch)
    (token-batch-targets batch)
    (token-batch-loss-mask batch)
    (let ((before (__arena-used)))
      (let loop ((iteration 0))
        (if (< iteration 4096)
            (begin
              (token-batch-inputs batch)
              (token-batch-targets batch)
              (token-batch-loss-mask batch)
              (loop (+ iteration 1)))))
      (let ((live-delta (- (__arena-used) before)))
        (token-batch-release! batch)
        (let ((released-before (__arena-used)))
          (let loop ((iteration 0))
            (if (< iteration 4096)
                (begin (token-batch-release! batch)
                       (loop (+ iteration 1)))))
          (let ((released-delta (- (__arena-used) released-before)))
            (token-dataset-close! dataset)
            (display "D2 RESOURCE ACCESSORS PASS: live=")
            (display live-delta) (display " bytes released=")
            (display released-delta) (display " bytes") (newline)))))))
 (else
  (display "unknown D2 resource mode") (newline) (exit 64)))
