;;; Private data-only C4 companion. Load C1 SHA and the unchanged G3RCV1
;;; codec first for its checked integer, fingerprint, RNG and byte helpers.
;;; No live model, generator, owner, file, or replay operation is performed.

(define g3r-c4-record-size 288)
(define g3r-c4-phase-prompt 0)
(define g3r-c4-phase-proposed-one-token-history 1)
(define g3r-c4-phase-first-eos 2)
(define g3r-c4-phase-two-terminal 3)

(define (g3r-c4-policy? policy)
  (and (vector? policy) (= (vector-length policy) 6)
       (let loop ((index 0))
         (if (= index 6) #t
             (and (g3r-i64? (vector-ref policy index))
                  (loop (+ index 1)))))
       (let ((mode (vector-ref policy 0))
             (temperature (vector-ref policy 1))
             (top-k (vector-ref policy 2))
             (top-p (vector-ref policy 3))
             (budget (vector-ref policy 4))
             (eos (vector-ref policy 5)))
         (and (or (= mode 0) (= mode 1))
              (> temperature 0) (<= temperature 2139095039)
              (>= top-k 1) (<= top-k 256)
              (> top-p 0) (<= top-p 1065353216)
              (= budget 2)
              (>= eos -1) (<= eos 255)
              (or (= mode 1)
                  (and (= temperature 1065353216)
                       (= top-k 256) (= top-p 1065353216)))))))

(define (g3r-c4-history? history prompt generated manual phase policy)
  (and (bytevector? history) (g3r-i64? prompt) (g3r-i64? generated)
       (g3r-i64? manual) (g3r-i64? phase)
       (= prompt 2) (= manual 0)
       (let ((length (bytevector-length history))
             (eos (vector-ref policy 5)))
         (and (>= length 2) (<= length 4)
              (= length (+ prompt generated manual))
              (cond
                ((= phase g3r-c4-phase-prompt) (= generated 0))
                ((= phase g3r-c4-phase-proposed-one-token-history)
                 (and (= generated 1)
                      (not (= (bytevector-u8-ref history 2) eos))))
                ((= phase g3r-c4-phase-first-eos)
                 (and (= generated 1) (>= eos 0)
                      (= (bytevector-u8-ref history 2) eos)))
                ((= phase g3r-c4-phase-two-terminal)
                 (and (= generated 2)
                      (not (= (bytevector-u8-ref history 2) eos))))
                (else #f))))))

(define (g3r-c4-fields? policy rng history prompt generated manual phase
                        fingerprint c2-digest)
  (and (g3r-c4-policy? policy) (g3r-rng? rng)
       (g3r-c4-history? history prompt generated manual phase policy)
       (g3r-fingerprint? fingerprint)
       (bytevector? c2-digest) (= (bytevector-length c2-digest) 32)))

;;; Build, validate and hash privately; publish only with one fixed copy.
(define (g3r-c4-record-encode! destination policy rng history prompt
                               generated manual phase fingerprint c2-digest)
  (if (not (and (bytevector? destination)
                (= (bytevector-length destination) g3r-c4-record-size)
                (g3r-c4-fields? policy rng history prompt generated manual
                                phase fingerprint c2-digest)))
      (g3r-record-fail "G3-R C4 encode: invalid bounded fields"))
  (let* ((staged (make-bytevector g3r-c4-record-size 0))
         (magic (string->utf8 "G3RCV2")))
    (bytevector-copy! staged 0 magic 0 6)
    (g3r-u-write! staged 8 2 2)
    (g3r-u-write! staged 10 2 0)
    (g3r-u-write! staged 12 4 g3r-c4-record-size)
    (g3r-u-write! staged 16 4 2)
    (g3r-u-write! staged 20 4 1)
    (g3r-u-write! staged 24 4 (bytevector-length history))
    (g3r-u-write! staged 28 4 prompt)
    (g3r-u-write! staged 32 4 generated)
    (g3r-u-write! staged 36 4 manual)
    (let words ((index 0))
      (if (< index 6)
          (begin
            (g3r-i64-write! staged (+ 40 (* index 8))
                            (vector-ref policy index))
            (words (+ index 1)))))
    (let words ((index 0))
      (if (< index 4)
          (begin
            (g3r-i64-write! staged (+ 88 (* index 8))
                            (vector-ref rng index))
            (words (+ index 1)))))
    (bytevector-copy! staged 120 history 0 (bytevector-length history))
    (g3r-u-write! staged 124 4 phase)
    (bytevector-copy! staged 128 fingerprint 0 96)
    (bytevector-copy! staged 224 c2-digest 0 32)
    (bytevector-copy! staged 256
                      (c1-sha256 (bytevector-copy staged 0 256)) 0 32)
    (bytevector-copy! destination 0 staged 0 g3r-c4-record-size)
    destination))

;;; Decode into nine newly owned data-only slots. The expected C2 digest is
;;; already authenticated by a separate caller; equality does not load C2.
(define (g3r-c4-record-decode! source expected-c2-digest destination)
  (if (not (and (bytevector? source)
                (= (bytevector-length source) g3r-c4-record-size)
                (bytevector? expected-c2-digest)
                (= (bytevector-length expected-c2-digest) 32)
                (vector? destination) (= (vector-length destination) 9)))
      (g3r-record-fail "G3-R C4 decode: invalid extents"))
  (let ((magic (string->utf8 "G3RCV2")))
    (if (not (and (g3r-bytes=? source 0 magic 0 6)
                  (g3r-zero-range? source 6 8)
                  (= (g3r-u-read source 8 2) 2)
                  (= (g3r-u-read source 10 2) 0)
                  (= (g3r-u-read source 12 4) g3r-c4-record-size)
                  (= (g3r-u-read source 16 4) 2)
                  (= (g3r-u-read source 20 4) 1)
                  (g3r-bytes=? source 224 expected-c2-digest 0 32)
                  (g3r-bytes=? source 256
                                (c1-sha256 (bytevector-copy source 0 256))
                                0 32)))
        (g3r-record-fail "G3-R C4 decode: header, pair or checksum")))
  (let* ((length (g3r-u-read source 24 4))
         (prompt (g3r-u-read source 28 4))
         (generated (g3r-u-read source 32 4))
         (manual (g3r-u-read source 36 4))
         (phase (g3r-u-read source 124 4)))
    (if (not (and (>= length 2) (<= length 4)
                  (g3r-zero-range? source (+ 120 length) 124)))
        (g3r-record-fail "G3-R C4 decode: noncanonical history"))
    (let* ((policy (make-vector 6 0))
           (rng (make-vector 4 0))
           (history (bytevector-copy source 120 (+ 120 length)))
           (fingerprint (bytevector-copy source 128 224))
           (c2-digest (bytevector-copy source 224 256)))
      (let words ((index 0))
        (if (< index 6)
            (begin
              (vector-set! policy index
                           (g3r-i64-read source (+ 40 (* index 8))))
              (words (+ index 1)))))
      (let words ((index 0))
        (if (< index 4)
            (begin
              (vector-set! rng index
                           (g3r-i64-read source (+ 88 (* index 8))))
              (words (+ index 1)))))
      (if (not (g3r-c4-fields? policy rng history prompt generated manual
                               phase fingerprint c2-digest))
          (g3r-record-fail "G3-R C4 decode: invalid bounded fields"))
      ;; The pinned Eshkol runtime stages the whole tagged range first.
      (let ((staged (vector policy rng history prompt generated manual phase
                            fingerprint c2-digest)))
        (vector-copy! destination 0 staged 0 9))
      destination)))
