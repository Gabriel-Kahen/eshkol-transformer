(define (near a b tolerance) (< (abs (- a b)) tolerance))
(define epsilon 1e-5)
(define q (reshape #(0.0 0.0 0.0 0.0) 2 2))
(define k (reshape #(0.0 0.0 0.0 0.0) 2 2))
(define (f x)
  (tensor-get (scaled-dot-attention q k (reshape (vector x 2.0 3.0 4.0) 2 2)) 0 0))
(define actual (derivative f 1.0))
(define finite (/ (- (f (+ 1.0 epsilon)) (f (- 1.0 epsilon))) (* 2.0 epsilon)))
(display (if (near actual finite 1e-4) "PASS attention gradient" "FAIL attention gradient"))
(newline)
(display "R0_DONE autodiff_attention") (newline)
