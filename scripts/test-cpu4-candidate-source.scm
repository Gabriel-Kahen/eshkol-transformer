(use-modules (ice-9 popen) (ice-9 textual-ports) (ice-9 rdelim))
(define checks 0)
(define (check label value)
  (if value (set! checks (+ checks 1)) (error label)))
(define (forms port)
  (let loop ((items '()))
    (let ((item (read port)))
      (if (eof-object? item) (reverse items) (loop (cons item items))))))
(define (read-file path) (call-with-input-file path forms))
(define (git-forms path)
  (let* ((port (open-pipe* OPEN_READ "git" "show" (string-append "c71d39a98:" path)))
         (result (forms port)))
    (check "baseline git source" (= (close-pipe port) 0)) result))
(define (definition name items)
  (let find ((items items))
    (cond ((null? items) (error "missing definition" name))
          ((and (pair? (car items)) (eq? (caar items) 'define)
                (eq? (if (pair? (cadar items)) (caadar items) (cadar items)) name))
           (car items))
          (else (find (cdr items))))))
(define (trusted-body items)
  (cddr (caddr (definition 'p1-trusted-surface items))))
(define old-p1 (git-forms "internal/p1/lib/transformer/module.esk"))
(define new-p1 (read-file "internal/p1/lib/transformer/module.esk"))
(define old-body (trusted-body old-p1))
(define new-body (trusted-body new-p1))
(define old-slots (car (reverse old-body)))
(define new-slots (car (reverse new-body)))
(check "trusted vector preserved and appended once"
  (and (eq? (car old-slots) 'vector) (eq? (car new-slots) 'vector)
       (= (length old-slots) 74) (= (length new-slots) 75)
       (equal? (cdr old-slots) (list-head (cdr new-slots) 73))
       (eq? (list-ref new-slots 74) 'candidate-bridge-install)))
(for-each
  (lambda (name)
    (check "ordinary construction preserved"
      (equal? (definition name old-body) (definition name new-body))))
  '(construction-begin construction-seal! construction-seal-prepared! construction-abort!))
(check "ordinary C4 constructor file unchanged"
  (equal? (git-forms "native/g3c4_model_extension.esk")
          (read-file "native/g3c4_model_extension.esk")))
(check "ordinary P1 externs unchanged"
  (equal? (filter (lambda (x) (and (pair? x) (eq? (car x) 'extern))) old-p1)
          (filter (lambda (x) (and (pair? x) (eq? (car x) 'extern))) new-p1)))
(define feature (read-file "native/cpu4_candidate_extension.esk"))
(define (shape-check x)
  (if (pair? x)
      (begin
        (if (eq? (car x) 'if)
            (check "if arity" (or (= (length x) 3) (= (length x) 4))))
        (if (and (memq (car x) '(let let*)) (pair? (cdr x)))
            (let ((bindings (if (symbol? (cadr x)) (caddr x) (cadr x))))
              (check "let bindings"
                (every (lambda (binding) (and (list? binding) (= (length binding) 2))) bindings))))
        (for-each shape-check x))))
(use-modules (srfi srfi-1))
(for-each shape-check new-p1)
(for-each shape-check feature)
;; Execute the actual new P1 planner as a nonnumerical host unit. No native
;; model, Eshkol runtime, retirement admission or compiled behavior is claimed.
(define active-record-root (vector '() '() #t #f '() '()))
(define (fail category operation message details) (error message))
(eval (definition 'candidate-cell-member? new-body) (current-module))
(eval (definition 'candidate-active-plan new-body) (current-module))
(define (apply-plan plan)
  (for-each (lambda (row)
    (if (vector-ref row 0) (set-cdr! (vector-ref row 0) (vector-ref row 2))
        (vector-set! active-record-root 1 (vector-ref row 2)))) plan))
(define (splice-test retire-head?)
  (let* ((a2 (list (vector 'a2))) (a1 (cons (vector 'a1) a2))
         (b2 (cons (vector 'b2) a1)) (b1 (cons (vector 'b1) b2))
         (a (list (vector a1) (vector a2)))
         (b (list (vector b1) (vector b2)))
         (payloads (map car (list a1 a2 b1 b2))))
    (vector-set! active-record-root 1 b1)
    (apply-plan (candidate-active-plan (if retire-head? b a) 'test))
    (check "independent original cells retained"
      (eq? (vector-ref active-record-root 1) (if retire-head? a1 b1)))
    (check "independent payloads retained"
      (equal? payloads (map car (list a1 a2 b1 b2))))
    ;; The second planner must accept legitimate prior successor rewrites.
    (apply-plan (candidate-active-plan (if retire-head? a b) 'test))
    (check "out-of-order second retire" (null? (vector-ref active-record-root 1)))))
(splice-test #f)
(splice-test #t)
(let* ((cell (list 'independent)) (missing (list 'missing)))
  (vector-set! active-record-root 1 cell)
  (check "missing original rejected before mutation"
    (catch #t
      (lambda () (candidate-active-plan (list (vector missing)) 'test) #f)
      (lambda args (eq? cell (vector-ref active-record-root 1))))))
(display "CPU4 candidate source/planner PASS: checks=") (display checks) (newline)
;; Run the actual I2 retained-sidecar/preflight/tail definitions too.
(define i2-module-registry-root (vector '()))
(define i2-module-count 0)
(define i2-construction-registry-root (vector '() #f))
(define i2-parameter-admission-carrier #f)
(define (i2-modules-current) (vector-ref i2-module-registry-root 0))
(define (g3c4-fail category operation message) (error message))
(define feature-body (cddr (caddr (definition 'cpu4-candidate-surface feature))))
(for-each (lambda (name) (eval (definition name feature-body) (current-module)))
          '(member-cell? i2-retain i2-preflight i2-invalidate))
(define (make-i2-sidecar label)
  (let* ((members (map (lambda (i) (vector (vector label i))) (iota 17)))
         (carriers (map (lambda (i) (vector 'carrier 'parameter (vector label i) (vector 'handle i))) (iota 14)))
         (record (vector 'i2-construction 'scope (vector-ref (car members) 0)
                         'prepared members carriers (i2-modules-current)
                         i2-module-count (vector 'carrier 'parameter 'anchor 'handle)
                         'g3c4 'owner)))
    (for-each (lambda (member)
                (vector-set! i2-module-registry-root 0 (cons member (i2-modules-current)))
                (set! i2-module-count (+ i2-module-count 1))) members)
    (let ((sidecar (i2-retain record)))
      ;; Ordinary seal discards rollback fields after sidecar capture.
      (vector-set! record 3 'sealed)
      (for-each (lambda (slot) (vector-set! record slot '())) '(4 5 6))
      (vector-set! record 8 #f)
      sidecar)))
(define (i2-order-test retire-head?)
  (vector-set! i2-module-registry-root 0 '())
  (set! i2-module-count 0)
  (let* ((a (make-i2-sidecar 'a)) (b (make-i2-sidecar 'b))
         (first (if retire-head? b a)) (second (if retire-head? a b)))
    (i2-preflight first)
    (i2-invalidate first)
    (check "I2 count removes originals once" (= i2-module-count 17))
    (i2-preflight second)
    (for-each (lambda (row)
       (check "I2 independent membership payload unchanged"
         (eq? (vector-ref (vector-ref row 1) 0) (vector-ref row 2))))
       (vector-ref second 1))
    (for-each (lambda (row)
       (check "I2 independent native carrier unchanged"
         (and (eq? (vector-ref (vector-ref row 0) 2) (vector-ref row 1))
              (eq? (vector-ref (vector-ref row 0) 3) (vector-ref row 2)))))
       (vector-ref second 2))
    (i2-invalidate second)
    (check "I2 second retirement accepts prior splice" (= i2-module-count 0))
    (check "I2 original chains fully removed" (null? (i2-modules-current)))))
(i2-order-test #f)
(i2-order-test #t)
(display "CPU4 candidate I2 original-node order PASS: checks=") (display checks) (newline)
(define c4-i2 (read-file "native/g3c4_i2_construction_extension.esk"))
(define (contains-form? expected tree)
  (and (pair? tree) (or (equal? expected tree)
                       (any (lambda (child) (contains-form? expected child)) tree))))
(check "existing I2 bind passes exact raw P1 handle"
  (any (lambda (form)
         (contains-form? '(i2-native-g3c4-owner-bind owner index handle) form)) c4-i2))
(check "candidate owns no M3T cast or generic destructor"
  (not (any (lambda (form)
              (or (contains-form? '(m3t-native-owner-create owner) form)
                  (contains-form? '(model-destroy candidate) form))) feature)))
(for-each
  (lambda (path)
    (check "candidate source inventory exists" (file-exists? path)))
  (call-with-input-file "native/cpu4_candidate_source_closure.txt"
    (lambda (port)
      (let loop ((rows '()))
        (let ((line (read-line port)))
          (if (eof-object? line) rows (loop (cons line rows))))))))
(display "CPU4 candidate binding/source inventory PASS: checks=") (display checks) (newline)
(define (lines path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((rows '()))
        (let ((line (read-line port)))
          (if (eof-object? line) (reverse rows) (loop (cons line rows))))))))
(define predecessor (lines "native/g3c4_model_source_closure.txt"))
(check "candidate exact owning source closure"
  (equal? (lines "native/cpu4_candidate_source_closure.txt")
    (append (drop-right predecessor 1)
      '("native/cpu4_candidate_extension.esk" "tests/cpu4_candidate/producer_test.esk"
        "native/cpu4_candidate_native_sources.txt" "scripts/test-cpu4-candidate-producer.sh"
        "scripts/test-cpu4-candidate-source.scm" "scripts/test-cpu4-candidate-source.sh"
        "native/cpu4_candidate_source_closure.txt"))))
(check "actual owning root exact feature imports"
  (equal? (take (read-file "tests/cpu4_candidate/producer_test.esk") 4)
    '((load "m3_package_root.esk") (load "g3c4_i2_construction_extension.esk")
      (load "g3c4_model_extension.esk") (load "cpu4_candidate_extension.esk"))))
(display "CPU4 candidate exact closure PASS: checks=") (display checks) (newline)
