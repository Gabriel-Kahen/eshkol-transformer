;;; Genuine C4/P1/I2/O2/D2 constructor and controls-only transaction witness.
;;; No step, C2 image, parameter/moment restore, or full-checkpoint claim.
(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")
(load "o2_wave2_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_candidate_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_trainer_control_extension.esk")

(load "cpu4_trainer_detach_extension.esk")
(load "cpu4_candidate_children_extension.esk")

(extern void child-o2-fail i64 :real et_o2_test_fail_alloc_after_v1)
(extern void child-o2-reset :real et_o2_test_reset_failpoints_v1)
(extern void child-f32-fail i64 :real et_f32_tensor_test_fail_alloc_after_v1)
(extern void child-f32-reset :real et_f32_tensor_test_reset_allocator_v1)
(extern i64 child-o2-count i64 :real et_cpu4_child_test_o2_count)
(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4 child custody FAIL: ") (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label (guard (caught (#t (transformer-error? caught))) (thunk) #f)))
(define resolved (x1-private-config-resolve (x1-private-config-parse
  "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define (paths index)
  (if (= index 14) '() (cons (vector-ref g3c4-model-paths index) (paths (+ index 1)))))
(define optimizer-config
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu '(none) '(constant)
    (list (list 'group (paths 0) "3dcccccd" "3f000000" "3f000000" "3a83126f" "00000000"))))
(define (counts) (vector (child-o2-count 0) (child-o2-count 1) (child-o2-count 2) (child-o2-count 3) (child-o2-count 4) (child-o2-count 5)))
(define (allocation-cuts f32?)
  (let* ((ticket (cpu4-owned-candidate-create-internal resolved))
         (baseline (counts)) (registry o2-optimizers))
    (let attempt ((allowed 0))
      (if (= allowed 256) (begin (display "allocation fault sweep never succeeded\n") (exit 1)))
      (if f32? (child-f32-fail allowed) (child-o2-fail allowed))
      (let ((success
              (guard (caught (#t (if (transformer-error? caught) #f (exit 1))))
                ;; Exercise actual global-promotion behavior on the admitted path.
                (with-region ('cpu4-o2-owned-promotion 1048576)
                  (cpu4-owned-optimizer-create-internal! ticket optimizer-config))
                #t)))
        (child-o2-reset) (child-f32-reset)
        (if success
            (begin
              (check "sweep had failures" (> allowed 0))
              (check "exact native optimizer/moments" (and (= (child-o2-count 0) 0)
                (= (child-o2-count 1) (+ (vector-ref baseline 1) 1))
                (= (child-o2-count 3) (+ (vector-ref baseline 3) 28))))
              (check "retire successful sweep" (cpu4-owned-candidate-retire-internal! ticket))
              (check "native counts restored" (and
                (= (child-o2-count 0) (vector-ref baseline 0))
                (= (child-o2-count 1) (vector-ref baseline 1))
                (= (child-o2-count 2) (vector-ref baseline 2))
                (= (child-o2-count 3) (vector-ref baseline 3))
                (= (child-o2-count 4) (- (vector-ref baseline 4) 28))
                (= (child-o2-count 5) (- (vector-ref baseline 5) 14))))
              (check "exact registry restored" (eq? registry o2-optimizers)))
            (begin
              (check "fault retains no native allocation" (equal? baseline (counts)))
              (check "fault retains exact other registry" (eq? registry o2-optimizers))
              (check "builder authority cleared" (not (vector-ref (cpu4-owned-row ticket 'test) 14)))
              (attempt (+ allowed 1))))))))
(allocation-cuts #f)
(allocation-cuts #t)
(define arguments (command-line))
(define tokenizer (t2-wave2-tokenizer-byte resolved))
(define dataset (d2-token-dataset-open
  (list ':directory (car (cdr arguments)) ':batch-size 1 ':sequence-length 4
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer))
(define ticket (cpu4-owned-candidate-create-internal resolved))
(define model (cpu4-owned-model-internal ticket))
(define optimizer
  (with-region ('cpu4-child-return 1048576)
    (cpu4-owned-optimizer-create-internal! ticket optimizer-config)))
(check "rooted returned exact O2 shell" (eq? optimizer (vector-ref (cpu4-owned-row ticket 'test) 6)))
(define binding
  (with-region ('cpu4-binding-return 1048576)
    (cpu4-owned-binding-create-internal! ticket)))
(define trainer
  (with-region ('cpu4-trainer-return 1048576)
    (cpu4-owned-trainer-create-internal! ticket tokenizer dataset)))
(define original-record (cpu4-trainer-idle-check-internal trainer 'test))
(define state (o2-public-optimizer-state optimizer))
(reject "live O2 snapshot blocks before detach" (lambda () (cpu4-owned-candidate-retire-internal! ticket)))
(check "blocked retirement preserves trainer and binding" (and
  (eq? original-record (cpu4-trainer-idle-check-internal trainer 'test))
  (cpu4-model-binding-check-internal binding)
  (not (vector-ref (cpu4-owned-row ticket 'test) 11))))
(o2-public-optimizer-state-release! state)
(check "retire after state release" (cpu4-owned-candidate-retire-internal! ticket))
(check "native optimizer/moments reclaimed" (and (= (child-o2-count 1) 0) (= (child-o2-count 3) 0)))
(reject "retired trainer rejects" (lambda () (cpu4-trainer-record-internal trainer 'test)))
(reject "retired O2 shell rejects" (lambda () (o2-require-optimizer 'test optimizer)))
(reject "retired model rejects" (lambda () (module-parameters model)))
(check "caller D2 remains live" (cpu4-d2-cursor-capture-internal dataset))
(check "caller tokenizer remains live" (= (t2-wave2-tokenizer-vocab-size tokenizer) 256))
(check "retirement idempotent" (cpu4-owned-candidate-retire-internal! ticket))
(display "CPU4 genuine typed child custody PASS: checks=") (display checks) (newline)
