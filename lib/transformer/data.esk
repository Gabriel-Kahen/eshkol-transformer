(define e1b-safe-d2-token-dataset-open-call
  (let ()
    (extern void e1b-d2-token-dataset-open ptr ptr ptr
            :real et_e1b_public_d2_token_dataset_open_v1)
    (lambda (config tokenizer)
      (let ((output (vector #f)))
        (e1b-d2-token-dataset-open (vector config) (vector tokenizer) output)
        (vector-ref output 0)))))

