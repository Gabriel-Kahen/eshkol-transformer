;;; Genuine full-step and rollback witness; Python never enters this path.
(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")
(load "o2_wave2_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_trainer_control_extension.esk")
(load "cpu4_training_schedule_extension.esk")
(load "tr3_o2_step_clear_extension.esk")
(load "cpu4_training_step_extension.esk")
(extern void fail-o2-after i64 :real et_cpu4_step_test_fail_o2_after)
(extern void fail-plan-after i64 :real et_cpu4_step_test_fail_plan_after)
(extern i64 moments-equal ptr ptr :real et_cpu4_step_test_moments_equal)
(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4 step FAIL: ") (display label) (newline) (exit 1))))
(define (report label caught)
  (display "CPU4 step ERROR: ") (display label)
  (if (transformer-error? caught)
      (begin (display " ") (display (transformer-error-category caught))
             (display " ") (display (transformer-error-operation caught))
             (display " ") (display (transformer-error-message caught)))
      (display " foreign condition"))
  (newline))
(define-syntax must
  (syntax-rules () ((_ label expression)
    (guard (caught (#t (report label caught) (exit 1))) expression))))
(define (reject label category thunk)
  (check label (guard (caught (#t
    (if (and (transformer-error? caught) (eq? category (transformer-error-category caught)))
        #t (begin (report label caught) #f)))) (thunk) #f)))
(define directory (car (cdr (command-line))))
(define resolved (must "config"
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729,\"training.accumulation-steps\":2}") '())))
(define (paths handles)
  (let loop ((index 0))
    (if (= index 14) '()
        (cons (parameter-handle-path (vector-ref handles index)) (loop (+ index 1))))))
(define (setup)
  (let* ((model (g3c4-model-create-seeded-internal 1729))
         (trained (module-train! model))
         (binding (cpu4-model-binding-create-internal model resolved))
         (b (cpu4-model-binding-check-internal binding))
         (optimizer (o2-public-optimizer-create
           (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu '(none) '(constant)
             (list (list 'group (paths (vector-ref b 10)) "3dcccccd" "3f000000" "3f000000"
                         "3a83126f" "00000000"))) (module-parameters model)))
         (tokenizer (t2-wave2-tokenizer-byte resolved))
         (dataset (d2-token-dataset-open
           (list ':directory directory ':batch-size 1 ':sequence-length 4
                 ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
                 ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
                 ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer))
         (trainer (cpu4-trainer-create-internal binding tokenizer dataset optimizer))
         (record (cpu4-trainer-idle-check-internal trainer 'cpu4-step-test)))
    (check "exact canonical14 handle/shape roster" (= (vector-length (vector-ref b 10)) 14))
    (let verify-roster-loop ((index 0))
      (if (< index 14)
          (begin
            (check "actual C4/P1 shape and native owner identity"
              (and (equal? (parameter-handle-shape (vector-ref (vector-ref b 10) index))
                           (vector-ref g3c4-model-shapes index))
                   (eq? (cpu4-native-lease-identity (vector-ref b 5) index)
                        (vector-ref (vector-ref b 10) index))
                   (eq? (cpu4-native-lease-parameter (vector-ref b 5) index)
                        (vector-ref (vector-ref (vector-ref b 11) index) 2))))
            (verify-roster-loop (+ index 1)))))
    (vector trainer record model binding optimizer dataset (vector-ref b 10) (vector-ref b 5))))
(define target (must "target setup" (setup)))
(define reference (must "reference setup" (setup)))
(define trainer (vector-ref target 0))
(define record (vector-ref target 1))
(define lease (vector-ref target 7))
(define (parameter-bytes handles)
  (let ((bytes (make-vector 14 #f)))
    (let loop ((index 0))
      (if (= index 14) bytes
          (let ((handle (vector-ref handles index)))
            (vector-set! bytes index (i2-checkpoint-encode
              (vector (parameter-handle-tensor-internal handle) 'parameter
                      (parameter-handle-shape handle) 'f32 'cpu
                      'dense-row-major-contiguous 'CPU4-STEP-TEST)))
            (loop (+ index 1)))))))
(define (metadata? expected count)
  (let loop ((index 0))
    (if (= index 14) #t
        (and (equal? (i2-parameter-gradient-metadata-internal
                       (parameter-handle-tensor-internal (vector-ref (vector-ref target 6) index)))
                     (vector expected count)) (loop (+ index 1))))))
(define (native-optimizer tuple)
  (vector-ref (o2-require-optimizer 'cpu4-step-test (vector-ref tuple 4)) 1))
(define (byte-vectors=? left right)
  (and (= (vector-length left) (vector-length right))
       (let scan ((index 0))
         (if (= index (vector-length left)) #t
             (and (d2-core-bytes=? (vector-ref left index) (vector-ref right index))
                  (scan (+ index 1)))))))
(define (same-moments?) (= (moments-equal (native-optimizer target) (native-optimizer reference)) 1))
(define before (parameter-bytes (vector-ref target 6)))
(define initial (cpu4-d2-cursor-capture-internal (vector-ref target 5)))
(define (unchanged label)
  (check (string-append label " values1192/bytes4768")
         (byte-vectors=? before (parameter-bytes (vector-ref target 6))))
  (check (string-append label " momentwords2384") (same-moments?))
  (check (string-append label " counters")
         (and (= (vector-ref record 19) 0)
              (= (vector-ref record 20) 0) (= (vector-ref record 21) 0))))
(define (idle-native label)
  (check label (= (cpu4-control-native-enter lease 1) 0))
  (check "native READ leave after exclusion proof" (= (cpu4-control-native-leave lease) 0)))
(check "initial all1192 values identical" (byte-vectors=? before (parameter-bytes (vector-ref reference 6))))
(check "initial complete2384 moment words equal" (same-moments?))
(reject "foreign step frame" 'invalid-argument (lambda () (cpu4-training-step-abort-internal! (vector #f))))
(define first (must "start" (cpu4-training-step-start-internal trainer)))
(check "exact registered frame/parent" (and (eq? first (car (vector-ref cpu4-step-frames 0)))
  (eq? (vector-ref record 4) first) (eq? (vector-ref record 3) 'step)))
(reject "busy trainer rejects second step" 'invalid-state (lambda () (cpu4-training-step-start-internal trainer)))
(reject "busy trainer rejects controls" 'invalid-state (lambda () (cpu4-trainer-control-begin-internal trainer 'snapshot)))
(reject "unprepared commit" 'invalid-state (lambda () (cpu4-training-step-commit-internal! first)))
(reject "incomplete prepare" 'invalid-state (lambda () (cpu4-training-step-prepare-internal! first)))
(must "first gradient" (cpu4-training-step-microbatch-internal! first))
(check "real14 gradients one contribution" (metadata? 1 1))
(reject "public O2 snapshot rejects expected present gradients" 'invalid-state
  (lambda () (o2-public-optimizer-state (vector-ref target 4))))
(idle-native "microbatch drains native READ and children")
(unchanged "first microbatch preserves all values/moments/counters")
(define saved (cpu4-control-bytes (vector-ref first 6)))
(bytevector-u8-set! (vector-ref first 6) 0 0)
(reject "failed D2 seek retains frame" 'corrupt-data (lambda () (cpu4-training-step-abort-internal! first)))
(check "same busy frame after seek failure" (and (eq? first (vector-ref record 4))
  (eq? (cpu4-step-frame-internal first) first) (not (vector-ref first 16)) (metadata? 1 1)))
(idle-native "failed seek releases WRITE")
(vector-set! first 6 saved)
(fail-o2-after 0)
(reject "zero-grad allocation failure" 'internal (lambda () (cpu4-training-step-abort-internal! first)))
(fail-o2-after -1)
(check "same busy frame after zero-grad failure" (and (eq? first (vector-ref record 4))
  (not (vector-ref first 16)) (metadata? 1 1)))
(idle-native "failed zero-grad releases WRITE")
(unchanged "failed rollback preserves canonical values/moments/counters")
(must "same frame rollback retry" (cpu4-training-step-abort-internal! first))
(check "rollback restores complete cursor/gradients" (and (metadata? 0 0)
  (d2-core-bytes=? initial (cpu4-d2-cursor-capture-internal (vector-ref target 5)))))
(reject "closed frame repeat" 'invalid-state (lambda () (cpu4-training-step-abort-internal! first)))
(unchanged "rollback retry preserves initial full state")

(define second (cpu4-training-step-start-internal trainer))
(cpu4-training-step-microbatch-internal! second)
(cpu4-training-step-microbatch-internal! second)
(check "all14 complete two contributions" (metadata? 1 2))
(check "WRITE contention READ enter" (= (cpu4-control-native-enter lease 1) 0))
(reject "prepare refuses active native READ" 'invalid-state (lambda () (cpu4-training-step-prepare-internal! second)))
(check "WRITE contention READ leave" (= (cpu4-control-native-leave lease) 0))
(fail-plan-after 0)
(reject "real O2 prepare allocation failure" 'internal (lambda () (cpu4-training-step-prepare-internal! second)))
(fail-plan-after -1)
(check "failed prepare retains complete gradients and no plan" (and (metadata? 1 2)
  (not (vector-ref second 15)) (not (vector-ref second 16))))
(idle-native "failed O2 prepare releases WRITE")
(must "prepare retry" (cpu4-training-step-prepare-internal! second))
(check "prepared owns WRITE" (not (= (cpu4-control-native-enter lease 1) 0)))
(reject "second prepare refuses" 'invalid-state (lambda () (cpu4-training-step-prepare-internal! second)))
(define actual-plan (vector-ref second 15))
(vector-set! second 15 '())
(reject "rejected plan abort retains WRITE" 'invalid-argument (lambda () (cpu4-training-step-abort-internal! second)))
(check "failed plan abort keeps exact held phase and frame" (and (vector-ref second 16)
  (eq? second (vector-ref record 4)) (not (= (cpu4-control-native-enter lease 1) 0))))
(vector-set! second 15 actual-plan)
(must "prepared abort" (cpu4-training-step-abort-internal! second))
(unchanged "prepared plan abort preserves full initial state")
(check "prepared abort clears all14 gradients" (metadata? 0 0))
(fail-plan-after 0)
(reject "full-step prewrite failure rolls back" 'internal (lambda () (cpu4-training-step-internal! trainer)))
(fail-plan-after -1)
(check "full-step failure restores cursor and idle" (and (metadata? 0 0)
  (eq? record (cpu4-trainer-idle-check-internal trainer 'cpu4-step-test))
  (d2-core-bytes=? initial (cpu4-d2-cursor-capture-internal (vector-ref target 5)))))
(unchanged "full-step automatic rollback preserves complete initial state")

;;; Independent orchestration reference: actual microbatch followed by ordinary
;;; O2 update and explicit clear, without the step-clear plan or trainer leaf.
(define reference-start (cpu4-d2-cursor-capture-internal (vector-ref reference 5)))
(define (reference-step)
  (let ((observations (make-vector 2 #f)) (dataset (vector-ref reference 5)))
    (let loop ((ordinal 0))
      (if (< ordinal 2)
          (let* ((first-batch (d2-token-dataset-next-batch dataset))
                 (batch (if (d2-token-dataset-end? first-batch)
                    (begin (cpu4-d2-cursor-restore-internal! dataset reference-start)
                           (d2-token-dataset-next-batch dataset)) first-batch))
                 (observation (make-bytevector 12 0)))
            (cpu4-training-microbatch-internal! (vector-ref reference 3) batch ordinal observation)
            (d2-token-batch-release! batch)
            (vector-set! observations ordinal observation)
            (loop (+ ordinal 1)))))
    (check "reference WRITE enter" (= (cpu4-control-native-enter (vector-ref reference 7) 2) 0))
    (o2-public-optimizer-step! (vector-ref reference 4))
    (o2-public-optimizer-zero-grad! (vector-ref reference 4))
    (check "reference WRITE leave" (= (cpu4-control-native-leave (vector-ref reference 7)) 0))
    observations))
(define (compare-step update epoch)
  (let ((result (must "genuine full step" (cpu4-training-step-internal! trainer))))
    (check "real update changes canonical parameters"
      (not (byte-vectors=? before (parameter-bytes (vector-ref target 6)))))
    (check "target moments/updates differ before reference" (not (same-moments?)))
    (let ((observations (must "independent O2 reference" (reference-step))))
      (check "exact actual CE observations retained" (byte-vectors=? observations (vector-ref result 3)))
      (check "all1192 parameter bytes equal independent O2 path"
        (byte-vectors=? (parameter-bytes (vector-ref target 6)) (parameter-bytes (vector-ref reference 6))))
      (check "all2384 moment words and optimizer updates equal" (same-moments?)))
    (check "exact preallocated result counts" (and (= (vector-length result) 4)
      (= (vector-ref result 0) 7) (= (vector-ref result 1) update) (= (vector-ref result 2) epoch)))
    (check "real T4 weights4and3" (and
      (= (cpu4-training-u32 (vector-ref (vector-ref result 3) 0) 4) 1082130432)
      (= (cpu4-training-u32 (vector-ref (vector-ref result 3) 1) 4) 1077936128)))
    (check "committed controls/cursor equation authentic" (eq? record (cpu4-trainer-idle-check-internal trainer 'cpu4-step-test)))
    (check "committed gradients absent" (metadata? 0 0))
    (check "same D2 continuation bytes" (d2-core-bytes=?
      (cpu4-d2-cursor-capture-internal (vector-ref target 5))
      (cpu4-d2-cursor-capture-internal (vector-ref reference 5))))
    (check "cumulative trainer counts" (and (= (vector-ref record 19) (* 7 update))
      (= (vector-ref record 20) update) (= (vector-ref record 21) epoch)))
    (idle-native "committed native phase IDLE")
    result))
(define result1 (compare-step 1 0))
(define result1-copy (cpu4-control-bytes (vector-ref (vector-ref result1 3) 0)))
(define after1 (parameter-bytes (vector-ref target 6)))
(define cursor1 (cpu4-d2-cursor-capture-internal (vector-ref target 5)))
(fail-plan-after 0)
(reject "failure after EOS rewind rolls back" 'internal (lambda () (cpu4-training-step-internal! trainer)))
(fail-plan-after -1)
(check "rewind failure restores committed full state" (and
  (byte-vectors=? after1 (parameter-bytes (vector-ref target 6))) (same-moments?)
  (metadata? 0 0) (= (vector-ref record 19) 7) (= (vector-ref record 20) 1)
  (= (vector-ref record 21) 0)
  (d2-core-bytes=? cursor1 (cpu4-d2-cursor-capture-internal (vector-ref target 5)))))
(define result2 (compare-step 2 1))
(check "prior result survives next step" (d2-core-bytes=? result1-copy (vector-ref (vector-ref result1 3) 0)))
(check "slot7 remains reserved" (eq? (vector-ref (vector-ref (cpu4-model-binding-check-internal (vector-ref target 3)) 3) 7) #f))
(d2-token-dataset-close! (vector-ref target 5))
(d2-token-dataset-close! (vector-ref reference 5))
(check "target binding releases after full steps" (cpu4-model-binding-release-internal! (vector-ref target 3)))
(check "reference binding releases" (cpu4-model-binding-release-internal! (vector-ref reference 3)))
(display "CPU4 genuine full-step READ/WRITE/O2 PASS: checks=") (display checks) (newline)
