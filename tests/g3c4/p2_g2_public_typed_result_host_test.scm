(define snapshot (vector 0 0 1 3 1 41 42 43))
(define source (make-vector 12 #f))
(define source-shell (vector 'terminal))
(define (g3c4-public-g2-output-live shell operation)
  (if (not source-valid?) (error "source changed")) source)
(define (g3c4-public-g2-resnapshot . args)
  (if (not source-valid?) (error "source changed")) #t)
(define (g3c4-p2g2-terminal-ids-clone-private shell)
  (set! clone-created (+ clone-created 1))
  (let* ((clone (vector 'detached-clone))
         (entry (vector clone 'terminal-ids 'live (vector 'native-clone)
                        #f #f #f 1 (make-bytevector 8 0) #f #f g3c4-model-profile)))
    (vector-set! g3c4-registry 0 (cons entry (vector-ref g3c4-registry 0)))
    (list clone)))
(define (g3c4-p2g2-terminal-ids-release-private! clone)
  (g3c4-entry-dead! (g3c4-p2g2-terminal-ids-entry-live clone 'test))
  (set! clone-released (+ clone-released 1)) #t)
(define owners
  (map (lambda (kind)
         (let ((answer (g3c4-public-g2-typed-result-publish source-shell snapshot kind 'test)))
           (let ((shell (if (eq? kind 'ids) (car answer) answer)))
             (check (g3c4-public-g2-result-known? shell))
             (check (g3c4-public-g2-typed-result-live shell kind 'test))
             (check (= (g3c4-public-g2-word (g3c4-p2g2-typed-copy-private shell) 0)
                       (cond ((eq? kind 'ids) 0) ((eq? kind 'lengths) 1) (else 3))))
             (cons kind shell)))) '(ids lengths cache-lengths)))
(check (= clone-created clone-released))
(let* ((owner (cdar owners)) (before released)
       (saved (vector-ref g3c4-public-g2-result-bindings 0)))
  (vector-set! g3c4-public-g2-result-bindings 0 '())
  (check (reject (lambda () (g3c4-public-g2-result-release! owner 'ids 'test))))
  (check (= before released))
  (vector-set! g3c4-public-g2-result-bindings 0 saved)
  (check (reject (lambda () (g3c4-public-g2-result-release! owner 'lengths 'test)))))
(set! source-valid? #f)
(for-each (lambda (owner)
  (check (g3c4-public-g2-result-release! (cdr owner) (car owner) 'test))
  (check (g3c4-public-g2-result-release! (cdr owner) (car owner) 'test))) owners)
(check (= created released))
(check (null? (vector-ref g3c4-public-g2-results 0)))
(check (null? (vector-ref g3c4-public-g2-result-bindings 0)))
(for-each (lambda (mode)
  (set! fault mode)
  (set! source-valid? (not (eq? mode 'none)))
  (let ((old-results (vector-ref g3c4-public-g2-results 0))
        (old-bindings (vector-ref g3c4-public-g2-result-bindings 0)))
    (check (reject (lambda ()
      (g3c4-public-g2-typed-result-publish source-shell snapshot 'ids 'test))))
    (check (eq? (vector-ref g3c4-public-g2-results 0) old-results))
    (check (eq? (vector-ref g3c4-public-g2-result-bindings 0) old-bindings))
    (check (= created released)) (check (= clone-created clone-released))))
  '(create length copy none))
(display "G3-C4 public typed result host PASS: checks=") (display checks) (newline)

;;; Evaluate the actual selector and generator constructor, leaving the package
;;; initializer out of this host fixture. Native RNG/generator calls stay stubs.
(define (load-definition file name)
  (call-with-input-file (string-append (getenv "G3C4_TEST_ROOT") file)
    (lambda (port)
      (let find () (let ((form (read port)))
        (if (eof-object? form) (error "missing source definition" name)
            (if (and (pair? form) (eq? (car form) 'define)
                     (pair? (cadr form)) (eq? (caadr form) name))
                (eval form (current-module)) (find))))))))
(load-definition "/native/g3c4_public_generation_dispatch_extension.esk" 'g3c4-public-result-rng-entry)
(load-definition "/native/g3c4_call_entry_extension.esk" 'g3c4-generator-create-with-source)
