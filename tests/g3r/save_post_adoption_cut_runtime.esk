;;; A single authentic same-owner graph. This fixture has no public SAVE path.
(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "G3-R post-adoption FAIL: ")
             (display label) (newline) (exit 1))))
(define (error-at? category operation message thunk)
  (guard (caught
           (#t (and (transformer-error? caught)
                    (eq? category (transformer-error-category caught))
                    (eq? operation (transformer-error-operation caught))
                    (string=? message (transformer-error-message caught))
                    (equal? (transformer-error-details caught)
                      '((source-code 77)
                        (source-domain g3r-save-o2-adoption)))
                    (eq? (transformer-error-cause caught) #f))))
    (thunk) #f))

(define resolved
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define tokenizer (t2-wave2-tokenizer-byte resolved))
(define corpus-directory (car (cdr (command-line))))
(define dataset
  (g3r-d2-lineage-open
    (list ':directory corpus-directory ':batch-size 1 ':sequence-length 2
          ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
          ':maximum-total-tokens 4 ':maximum-batch-bytes 34
          ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #t)
    tokenizer))
(define model
  (g3r-x1-model-create resolved (m3t-public-initializer-state 1729)))
(define handles (vector-ref (m3t-entry model 'model 'trainer-create #t) 8))
(define (handle-paths index)
  (if (= index 14) '()
      (cons (parameter-handle-path (vector-ref handles index))
            (handle-paths (+ index 1)))))
(define optimizer
  (o2-public-optimizer-create
    (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
          '(none) '(constant)
          (list (list 'group (handle-paths 0)
                      "3dcccccd" "3f000000" "3f000000"
                      "3a83126f" "00000000")))
    (module-parameters model)))
(define model-native
  (vector-ref (m3t-entry model 'model 'g3r-save-bit-witness #t) 3))
(define model-handles
  (vector-ref (m3t-entry model 'model 'g3r-save-bit-witness #t) 8))
(define gradient-byte-lengths
  '#(64 64 64 64 128 128 16 16 16 16 4096 16 16 32))
(define (capture-value-images)
  (let ((images (make-vector 14 #f)))
    (let loop ((index 0))
      (if (= index 14) images
          (let ((handle (vector-ref model-handles index)))
            (vector-set! images index
              (i2-checkpoint-encode
                (vector (parameter-handle-tensor-internal handle)
                        'parameter (parameter-handle-shape handle)
                        'f32 'cpu 'dense-row-major-contiguous
                        'g3r-save-bit-witness)))
            (loop (+ index 1)))))))
(define (capture-gradient-images)
  (let ((images (make-vector 14 #f)))
    (let loop ((index 0))
      (if (= index 14) images
          (let* ((bytes (vector-ref gradient-byte-lengths index))
                 (image (make-bytevector bytes 0)))
            (check "exact-owner gradient copy"
              (= 0 (g3r-save-cut-gradient-copy
                     model-native index image bytes)))
            (vector-set! images index image)
            (loop (+ index 1)))))))
(define (same-images? before after)
  (and (= (vector-length before) 14)
       (= (vector-length after) 14)
       (let loop ((index 0))
         (if (= index 14) #t
             (and (d2-core-bytes=? (vector-ref before index)
                                    (vector-ref after index))
                  (loop (+ index 1)))))))
(define (original-tie?)
  (let ((tree (module-parameters model)))
    (and (equal? (parameter-tree-tie-groups tree)
                 '((("head" "weight")
                    ("token_embedding" "weight"))))
         (eq? (parameter-tree-handle tree '("head" "weight"))
              (parameter-tree-handle tree
                '("token_embedding" "weight")))
         (eq? (parameter-tree-handle tree '("head" "weight"))
              (vector-ref model-handles 10)))))
(check "model eval" (module-eval! model))
(define generator
  (g3r-generator-create-from-sources
    model resolved tokenizer
    (list ':profile 'diagnostic-c2 ':sampling 'greedy
          ':temperature-bits #x3f800000 ':top-k 256
          ':top-p-bits #x3f800000 ':max-new-tokens 1
          ':eos #f ':seed 1729)
    dataset optimizer))
(define input (g3t-generation-token-input-create 65))
(define logits (g3m-prefill-p1! generator input))
(check "manual logits release" (g3t-generation-tensor-release! logits))
(check "input release" (g3t-generation-tensor-release! input))

(define capsule
  (g3r-controls-trainer-create resolved tokenizer dataset model optimizer))
(g3r-controls-capture-release! capsule)
(check "original tied alias before cut" (original-tie?))
(check "seed fourteen distinct gradient images"
  (= 0 (g3r-save-cut-seed-gradients model-native)))
(define value-images-before (capture-value-images))
(define gradient-images-before (capture-gradient-images))
(define original-cursor (d2-token-dataset-cursor dataset))
(define original-controls (g3r-controls-captured-copy capsule))
(define c2-head c2-training-state-states)
(check "typed post-adoption failure"
  (error-at? 'invalid-state 'g3r-save-o2-adoption
             "test-only post-adoption failure"
    (lambda ()
      (g3r-save-c2-capture-internal
        generator model resolved tokenizer dataset optimizer capsule))))
(check "exact returned shell and one abandon"
  (and (vector-ref g3r-save-cut-state 0)
       (= (vector-ref g3r-save-cut-state 1) 1)))
(check "O2 then P1 release exactly once"
  (equal? (vector-ref g3r-save-cut-state 2) '(p1 o2)))
(check "no C2 owner publication"
  (eq? c2-head c2-training-state-states))
(check "original controls and D2 cursor unchanged"
  (and (equal? original-controls (g3r-controls-captured-copy capsule))
       (equal? original-cursor (d2-token-dataset-cursor dataset))))
(check "fourteen original value bit images unchanged"
  (same-images? value-images-before (capture-value-images)))
(check "fourteen original gradient bit images unchanged"
  (same-images? gradient-images-before (capture-gradient-images)))
(check "original tied alias after cut" (original-tie?))
(check "retired shell cannot take bundle again"
  (guard (caught (#t (and (transformer-error? caught)
                           (eq? 'invalid-state
                                (transformer-error-category caught)))))
    (g3r-save-o2-take-for-c2-internal
      (vector-ref g3r-save-cut-state 0))
    #f))
(display "G3-R post-adoption cut PASS: checks=")
(display checks)
(newline)
