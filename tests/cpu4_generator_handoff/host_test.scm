(define (g3c4-public-generator-create model tokenizer config)
  (event 'generator-create) (fail-at 'generator)
  (set! generated-config config) (set! generator-count (+ generator-count 1))
  (let* ((entry-model (g3c4-model-entry-live model 'test #f))
         (parsed (g3c4-public-profile-config config 'test))
         (policy (vector-ref (g3c4-normalize-config (vector-ref parsed 0) 'test) 0))
         (shell (vector 'public-G2 generator-count))
         (native (vector 'native-generator generator-count))
         (entry (vector shell 'generator 'live native #f entry-model tokenizer policy #f #f #f g3c4-model-profile))
         (row (vector shell entry native entry-model tokenizer policy 'diagnostic-c4-p2g2 'live))
         (anchor (vector shell entry native entry-model tokenizer policy 'diagnostic-c4-p2g2 'live))
         (binding (vector shell (lambda (r a e) (and (eq? r row) (eq? a anchor) (eq? e entry))))))
    (vector-set! g3c4-registry 0 (cons entry (vector-ref g3c4-registry 0)))
    (vector-set! g3c4-public-g2-generator-rows 0 (cons row (vector-ref g3c4-public-g2-generator-rows 0)))
    (vector-set! g3c4-public-g2-generator-anchors 0 (cons anchor (vector-ref g3c4-public-g2-generator-anchors 0)))
