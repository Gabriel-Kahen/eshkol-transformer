;;; Private original-T2/D2 identity seam. Load only after CLI3's T2 bridge and
;;; D2 in one source aggregate. It defines no public tokenizer or dataset API.

;;; Ordinary D2 close does not know this private companion. Its retained rows
;;; are bounded even if a caller never invokes the private retirement path.
(define g3r-d2-lineage-maximum-rows 64)

(define (g3r-d2-lineage-check-capacity rows operation)
  (let check ((remaining rows) (capacity g3r-d2-lineage-maximum-rows))
    (cond
      ((= capacity 0)
       (d2-fail 'unsupported operation "D2 lineage row limit reached"))
      ((null? remaining) #t)
      ((not (pair? remaining))
       (d2-fail 'internal operation "D2 lineage registry is malformed"))
      (else (check (cdr remaining) (- capacity 1))))))

(define (g3r-d2-lineage-byte-core tokenizer operation)
  (let ((entry (t2-private-entry tokenizer)))
    (if (not (and (pair? entry)
                  (eq? (car entry) tokenizer)
                  (pair? (cdr entry))
                  (null? (cdr (cdr entry)))
                  (t1-core-tokenizer? (car (cdr entry)))
                  (eq? (vector-ref (car (cdr entry)) 1) 'raw)
                  (null? (vector-ref (car (cdr entry)) 2))
                  (null? (vector-ref (car (cdr entry)) 3))
                  (null? (vector-ref (car (cdr entry)) 4))
                  (= (t1-tokenizer-core-vocab-size (car (cdr entry))) 256)))
        (d2-fail 'invalid-argument operation
                 "expected an exact raw V256 T2 tokenizer"))
    entry))

(define g3r-d2-lineage-route
  ;; The completed records and original identity snapshots never leave this
  ;; lexical scope. Public callers receive only shells or checked booleans.
  (let* ((registry (vector '() #f))
         (open
           (lambda (config tokenizer)
             (let ((operation 'g3r-d2-lineage-open))
               (if (vector-ref registry 1)
                   (d2-fail 'invalid-state operation
                            "D2 lineage construction is already active"))
               (g3r-d2-lineage-check-capacity (vector-ref registry 0) operation)
               (let* ((tokenizer-entry (g3r-d2-lineage-byte-core tokenizer operation))
                      (fingerprint (t2-private-tokenizer-fingerprint tokenizer))
                      (vocabulary (t2-private-tokenizer-vocab-size tokenizer))
                      (row (vector #f 'pending tokenizer tokenizer-entry
                                   #f fingerprint vocabulary #f))
                      (snapshot (vector #f tokenizer tokenizer-entry
                                        #f fingerprint vocabulary #f))
                      (record (cons row snapshot))
                      (next (cons record (vector-ref registry 0)))
                      (pending (vector row next #f)))
                 (vector-set! registry 1 pending)
                 (guard
                   (caught
                     (#t
                       (if (vector-ref pending 2)
                           (guard (cleanup-failure (#t (exit 134)))
                             (d2-token-dataset-close! (vector-ref pending 2))))
                       (vector-set! registry 1 #f)
                       (raise caught)))
                   ;; D2's native open invokes no user callback. The shell is
                   ;; still unpublished while the independent record is built.
                   (let ((shell (d2-token-dataset-open config tokenizer)))
                     (vector-set! pending 2 shell)
                     (let* ((state (d2-open-dataset-state shell operation))
                            (core (vector-ref state 6)))
                       (if (not (and (eq? (vector-ref state 1) shell)
                                     (eq? (t2-private-entry tokenizer)
                                          tokenizer-entry)
                                     (string=? (vector-ref core 2) fingerprint)
                                     (= (vector-ref core 3) vocabulary)))
                           (d2-fail 'invalid-state operation
                                    "new D2 state differs from original T2"))
                       ;; Every allocation and fallible check precedes this
                       ;; fixed publication tail.
                       (vector-set! row 0 shell)
                       (vector-set! row 4 state)
                       (vector-set! row 7 core)
                       (vector-set! snapshot 0 shell)
                       (vector-set! snapshot 3 state)
                       (vector-set! snapshot 6 core)
                       (vector-set! row 1 'live)
                       (vector-set! registry 0 next)
                       (vector-set! registry 1 #f)
                       shell)))))))
         (required
           (lambda (dataset tokenizer)
             (let ((operation 'g3r-d2-lineage-require))
               (let search ((records (vector-ref registry 0)))
                 (cond
                   ((null? records)
                    (d2-fail 'invalid-argument operation
                             "dataset has no creation-time tokenizer lineage"))
                   ((not (and (pair? records) (pair? (car records))
                              (vector? (car (car records)))
                              (= (vector-length (car (car records))) 8)
                              (vector? (cdr (car records)))
                              (= (vector-length (cdr (car records))) 7)))
                    (d2-fail 'internal operation
                             "D2 lineage record is malformed"))
                   ((eq? (vector-ref (cdr (car records)) 0) dataset)
                    (let* ((row (car (car records)))
                           (snapshot (cdr (car records)))
                           (state (d2-open-dataset-state dataset operation))
                           (original (vector-ref snapshot 1))
                           (tokenizer-entry
                             (g3r-d2-lineage-byte-core original operation))
                           (core (vector-ref state 6))
                           (fingerprint
                             (t2-private-tokenizer-fingerprint original))
                           (vocabulary
                             (t2-private-tokenizer-vocab-size original))
                           (cursor (d2-core-cursor-snapshot core))
                           (decoded (d2-core-cursor-decode cursor)))
                      (if (not
                            (and (eq? original tokenizer)
                                 (eq? (vector-ref snapshot 2) tokenizer-entry)
                                 (eq? (vector-ref snapshot 3) state)
                                 (eq? (vector-ref snapshot 6) core)
                                 (string=? (vector-ref snapshot 4) fingerprint)
                                 (= (vector-ref snapshot 5) vocabulary)
                                 (eq? (vector-ref row 0) dataset)
                                 (eq? (vector-ref row 1) 'live)
                                 (eq? (vector-ref row 2) original)
                                 (eq? (vector-ref row 3) tokenizer-entry)
                                 (eq? (vector-ref row 4) state)
                                 (eq? (vector-ref row 7) core)
                                 (string=? (vector-ref row 5)
                                           (vector-ref snapshot 4))
                                 (= (vector-ref row 6)
                                    (vector-ref snapshot 5))
                                 (string=? (vector-ref core 2) fingerprint)
                                 (= (vector-ref core 3) vocabulary)
                                 (d2-core-state-identity=? core decoded)
                                 (= (vector-ref decoded 15)
                                    (vector-ref core 15))
                                 (<= (vector-ref decoded 15)
                                     (vector-ref core 14))))
                          (d2-fail 'invalid-state operation
                                   "original D2/T2 lineage or cursor changed"))
                      #t))
                   (else (search (cdr records))))))))
         (retire
           (lambda (dataset tokenizer)
             (let ((operation 'g3r-d2-lineage-retire!))
               (if (vector-ref registry 1)
                   (d2-fail 'invalid-state operation
                            "D2 lineage construction is active"))
               ;; Build the successor before close, then authenticate through
               ;; the same lexical original snapshot used by require.
               (let search ((records (vector-ref registry 0)) (prefix '()))
                 (cond
                   ((null? records)
                    (d2-fail 'invalid-argument operation
                             "dataset has no creation-time tokenizer lineage"))
                   ((not (and (pair? records) (pair? (car records))
                              (vector? (car (car records)))
                              (= (vector-length (car (car records))) 8)
                              (vector? (cdr (car records)))
                              (= (vector-length (cdr (car records))) 7)))
                    (d2-fail 'internal operation
                             "D2 lineage record is malformed"))
                   ((eq? (vector-ref (cdr (car records)) 0) dataset)
                    (let* ((row (car (car records)))
                           (snapshot (cdr (car records)))
                           (state (d2-open-dataset-state dataset operation))
                           (next
                             (let build ((remaining prefix)
                                         (suffix (cdr records)))
                               (if (null? remaining) suffix
                                   (build (cdr remaining)
                                          (cons (car remaining) suffix))))))
                      (required dataset tokenizer)
                      (if (not (and (eq? (vector-ref snapshot 3) state)
                                    (eq? (vector-ref row 4) state)))
                          (d2-fail 'invalid-state operation
                                   "D2 state changed before retirement"))
                      ;; D2 marks closed before native close. If native close
                      ;; fails after that point, pruning is indeterminate.
                      (guard (caught
                               (#t (if (not (vector-ref state 2)) (exit 134))
                                   (raise caught)))
                        (d2-token-dataset-close! dataset))
                      (if (vector-ref state 2) (exit 134))
                      (vector-set! registry 0 next)
                      (vector-set! row 0 #f)
                      (vector-set! row 1 'retired)
                      (vector-set! row 2 #f)
                      (vector-set! row 3 #f)
                      (vector-set! row 4 #f)
                      (vector-set! row 5 #f)
                      (vector-set! row 6 #f)
                      (vector-set! row 7 #f)
                      (vector-set! snapshot 0 #f)
                      (vector-set! snapshot 1 #f)
                      (vector-set! snapshot 2 #f)
                      (vector-set! snapshot 3 #f)
                      (vector-set! snapshot 4 #f)
                      (vector-set! snapshot 5 #f)
                      (vector-set! snapshot 6 #f)
                      #t))
                   (else (search (cdr records)
                                 (cons (car records) prefix)))))))))
    (lambda (mode first second)
      (cond
        ((eq? mode 'open) (open first second))
        ((eq? mode 'require) (required first second))
        ((eq? mode 'retire) (retire first second))
        (else (d2-fail 'invalid-argument 'g3r-d2-lineage-route
                       "unknown fixed D2 lineage route"))))))

(define (g3r-d2-lineage-open config tokenizer)
  (g3r-d2-lineage-route 'open config tokenizer))
(define (g3r-d2-lineage-require dataset tokenizer)
  (g3r-d2-lineage-route 'require dataset tokenizer))
(define (g3r-d2-lineage-retire! dataset tokenizer)
  (g3r-d2-lineage-route 'retire dataset tokenizer))
