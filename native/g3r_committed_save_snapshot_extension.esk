;;; Source-private same-owner G3-R data copy. Load only in a feature-local
;;; G3-T aggregate with ET_G3R_COMMITTED_SAVE_SNAPSHOT_PRIVATE. No file I/O.
(extern i64 g3r-native-committed-save-copy ptr ptr ptr ptr
        :real et_g3t_private_committed_save_copy_v1)

(define g3r-save-size 136)
(define g3r-save-sign 9223372036854775808)
(define g3r-save-modulus 18446744073709551616)
(define g3r-save-tokenizer-fingerprint
  "sha256:eshkol-byte-tokenizer-v1:aabb31f49216963582383a00fd2e85d7c20b658d5bef0e7945344ed6bfe50704")

(define (g3r-save-word bytes index)
  (let loop ((part 7) (value 0))
    (if (< part 0)
        (if (>= value g3r-save-sign) (- value g3r-save-modulus) value)
        (loop (- part 1)
              (+ (* value 256)
                 (bytevector-u8-ref bytes (+ (* index 8) part)))))))

(define (g3r-save-words bytes start count)
  (let ((answer (make-vector count 0)))
    (let loop ((index 0))
      (if (< index count)
          (begin (vector-set! answer index
                   (g3r-save-word bytes (+ start index)))
                 (loop (+ index 1)))))
    answer))

(define (g3r-save-tokenizer? tokenizer)
  (let ((entry (t1-private-entry tokenizer)))
    (and (pair? entry) (eq? (car entry) tokenizer)
         (pair? (cdr entry)) (null? (cdr (cdr entry)))
         (let ((core (car (cdr entry))))
           (and (t1-core-tokenizer? core)
                (eq? (vector-ref core 1) 'raw)
                (null? (vector-ref core 2))
                (null? (vector-ref core 3))
                (null? (vector-ref core 4))
                (= (t1-tokenizer-core-vocab-size core) 256)
                (string? (vector-ref core 6))
                (string=? (vector-ref core 6)
                          g3r-save-tokenizer-fingerprint))))))

(define (g3r-save-data bytes entry)
  (let* ((policy (g3r-save-words bytes 0 6))
         (rng (g3r-save-words bytes 6 4))
         (length (g3r-save-word bytes 12))
         (prompt (g3r-save-word bytes 13))
         (generated (g3r-save-word bytes 14))
         (manual (g3r-save-word bytes 15))
         (terminal (g3r-save-word bytes 16)))
    (if (not (and (>= length 1) (<= length 2)
                  (>= prompt 1) (<= prompt 2)
                  (>= generated 0) (<= generated 1)
                  (>= manual 0) (<= manual 1)
                  (= (+ prompt generated manual) length)
                  (or (= (+ generated manual) 0)
                      (and (= prompt 1) (= (+ generated manual) 1)))
                  (or (= generated 0) (= (vector-ref policy 4) 1))
                  (= (vector-ref rng 0) 1) (>= (vector-ref rng 1) 0)
                  (let ((registered (vector-ref entry 7)))
                    (and (vector? registered) (= (vector-length registered) 7)
                         (eq? (vector-ref registered 0) 'diagnostic-c2)
                         (let compare ((index 0))
                           (if (= index 6) #t
                               (and (= (vector-ref policy index)
                                       (if (and (= index 5)
                                                (eq? (vector-ref registered 6) #f))
                                           -1
                                           (vector-ref registered (+ index 1))))
                                    (compare (+ index 1)))))))
                  (or (= terminal 0) (= terminal 1))
                  (= terminal
                     (if (and (= generated 1) (>= (vector-ref policy 5) 0)
                              (= (g3r-save-word bytes (+ 10 (- length 1)))
                                 (vector-ref policy 5))) 1 0))
                  (or (= length 2) (= (g3r-save-word bytes 11) 0))))
        (g3t-fail-raw 'invalid-state 'g3r-committed-save-snapshot! 2
                      "committed G3-R save data differs from its owner"))
    (let ((history (make-bytevector length 0)))
      (let copy ((index 0))
        (if (< index length)
            (let ((id (g3r-save-word bytes (+ 10 index))))
              (if (not (and (>= id 0) (<= id 255)))
                  (g3t-fail-raw 'invalid-state 'g3r-committed-save-snapshot! 2
                                "committed G3-R ID is not raw V256"))
              (bytevector-u8-set! history index id)
              (copy (+ index 1)))))
      ;; Detached data only: no generator, model, tokenizer or native pointer.
      (vector policy rng history prompt generated manual terminal))))

(define (g3r-committed-save-snapshot! generator destination)
  (let ((operation 'g3r-committed-save-snapshot!))
    (m3-call operation
      (if (not (and (bytevector? destination)
                    (>= (bytevector-length destination) g3r-save-size)))
          (g3t-fail-raw 'invalid-argument operation 3
                        "G3-R snapshot destination needs 136 bytes"))
      (let ((entry (g3t-generator-find generator operation)))
        (if (not (and (vector? entry) (= (vector-length entry) 12)
                      (eq? (vector-ref entry 0) generator)
                      (eq? (vector-ref entry 1) 'generator)
                      (eq? (vector-ref entry 2) 'live)
                      (not (null? (vector-ref entry 3)))
                      (eq? (vector-ref entry 4) #f)
                      (eq? (vector-ref entry 8) #f)
                      (eq? (vector-ref entry 9) #f)
                      (eq? (vector-ref entry 10) #f)
                      (eq? (vector-ref entry 11) 'diagnostic-c2)))
            (g3t-fail-raw 'invalid-state operation 2
                          "G3-R generator aggregate is not exact and idle"))
        (let ((model-entry (vector-ref entry 5)))
          (if (not (and (vector? model-entry)
                        (= (vector-length model-entry) 12)
                        (eq? (g3t-model-entry-live
                               (vector-ref model-entry 0) operation #f)
                             model-entry)
                        (g3r-save-tokenizer? (vector-ref entry 6))))
              (g3t-fail-raw 'invalid-state operation 2
                            "G3-R model or tokenizer root changed"))
        (let ((staging (make-bytevector g3r-save-size 0)))
          (if (eq? staging destination)
              (g3t-fail-raw 'internal operation 10
                            "G3-R staging aliases destination"))
          (if (not (= 0 (g3r-native-committed-save-copy
                         (vector-ref entry 3) (vector-ref model-entry 3)
                         destination staging)))
              (g3t-native-fail-raw operation))
          (let ((result (g3r-save-data staging entry)))
            (bytevector-copy! destination 0 staging 0 g3r-save-size)
            result)))))))
