;;; Execute actual byte/comparison helpers only; no native/runtime admission.
(use-modules (rnrs bytevectors))
(define (select-definitions path names)
  (call-with-input-file path
    (lambda (port)
      (let loop ()
        (let ((form (read port)))
          (if (not (eof-object? form))
              (begin
                (if (and (pair? form) (eq? (car form) 'define)
                         (pair? (cadr form)) (memq (caadr form) names))
                    (eval form (current-module)))
                (loop))))))))
(select-definitions "internal/d2/lib/d2_semantic_core.esk" '(d2-core-bytes=?))
(select-definitions "tests/cpu4_trainer_control/runtime_test.esk"
                    '(vector-size? controls-shape? controls=?))
(define checks 0)
(define (check value)
  (if (not value) (error "control bytes regression failed" checks))
  (set! checks (+ checks 1)))
(define (fixture)
  (vector (vector 'philox4x32-10 1 1729 0 0) (vector "raw-fingerprint" 256)
          (vector (u8-list->bytevector '(1 2 3)) (u8-list->bytevector '(4 5 6)))
          (vector (u8-list->bytevector '(7 8 9)) "config-fingerprint") (vector 0 0 0)))
(define left (fixture))
(define right (fixture))
(check (not (eq? (vector-ref (vector-ref left 3) 0) (vector-ref (vector-ref right 3) 0))))
(check (d2-core-bytes=? (vector-ref (vector-ref left 3) 0) (vector-ref (vector-ref right 3) 0)))
(check (controls=? left right))
(check (not (controls=? left (vector #f))))
(for-each
  (lambda (slot)
    (let* ((bad (fixture)) (bytes (vector-ref (vector-ref bad (car slot)) (cadr slot))))
      (bytevector-u8-set! bytes 1 99)
      (check (not (controls=? left bad)))))
  '((2 0) (2 1) (3 0)))
(let ((bad (fixture))) (vector-set! (vector-ref bad 3) 0 (make-bytevector 0))
  (check (not (controls=? left bad))))
(let ((bad (fixture))) (vector-set! (vector-ref bad 3) 0 'not-bytes)
  (check (not (controls=? left bad))))
(let ((bad (fixture))) (vector-set! (vector-ref bad 3) 1 "different")
  (check (not (controls=? left bad))))
(let ((bad (fixture))) (vector-set! (vector-ref bad 0) 2 1730)
  (check (not (controls=? left bad))))
(let ((bad (fixture))) (vector-set! (vector-ref bad 1) 1 259)
  (check (not (controls=? left bad))))
(let ((bad (fixture))) (vector-set! (vector-ref bad 4) 0 1)
  (check (not (controls=? left bad))))
(display "CPU4 control byte helpers host PASS: checks=") (display checks) (newline)
