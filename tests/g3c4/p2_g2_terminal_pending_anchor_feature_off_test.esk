(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "g3c4_call_entry_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3c4_output_envelope_extension.esk")
(load "g3c4_p2g2_protected_scope_extension.esk")
(load "g3c4_p2g2_terminal_pending_anchor_extension.esk")

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "G3-C4 P2/G2 terminal anchor off FAIL: ")
             (display label) (newline) (exit 1))))
(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-model-create-seeded-internal 1729))
(define generator
  (g3c4-generator-create-internal
    model tokenizer
    (list ':profile 'diagnostic-c4 ':sampling 'greedy
          ':temperature-bits 1065353216 ':top-k 256
          ':top-p-bits 1065353216 ':max-new-tokens 1
          ':eos #f ':seed 7)))
(check "private budget-two gate remains off"
       (not (vector-ref g3c4-p2g2-ownership-gate 0)))
(check "pending terminal wrapper rejects feature-off entry"
  (guard (caught
           (#t (and (transformer-error? caught)
                    (eq? (transformer-error-category caught)
                         'invalid-argument))))
    (g3c4-with-p2g2-terminal-pending-probe
      'terminal-anchor-feature-off generator (call pending) #t)
    #f))
(check "rejection enrolled no pending terminal anchor"
       (and (null? (vector-ref g3c4-p2g2-terminal-pending-records 0))
            (null? (vector-ref g3c4-p2g2-terminal-pending-anchors 0))))
(check "generator remains closable"
       (g3c4-generator-close-internal! generator))
(display "G3-C4 P2/G2 terminal anchor off PASS: checks=")
(display checks)
(newline)
