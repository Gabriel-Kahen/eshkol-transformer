;;; Actual Scheme clone owner with native fault stubs. Host control-flow proof
;;; only: this does not reproduce or discharge the compiled pointer-header bug.
(use-modules (rnrs bytevectors) ((rnrs exceptions) #:select (guard)))
(define-syntax extern (syntax-rules () ((_ args ...) #f)))
(define-syntax m3-call
  (syntax-rules () ((_ operation body ...) (begin body ...))))
(define checks 0)
(define (check truth)
  (if (not truth) (error "terminal ID cell control failed"))
  (set! checks (+ checks 1)))
(define (reject thunk)
  (guard (caught (#t #t)) (thunk) #f))
(define (g3c4-fail . args) (error "owner rejection" args))
(define (g3c4-native-fail operation) (error "native failure" operation))
(define (g3c4-native-check status operation)
  (if (not (= status 0)) (g3c4-native-fail operation)))
(define g3c4-model-profile 'diagnostic-c4)
(define g3c4-registry (vector '()))
(define logical-count 1)
(define source-shell (vector 'source))
(define source (make-vector 12 #f))
(vector-set! source 3 (vector 'source-native))
(define native-clones 0)
(define native-releases 0)
(define (g3c4-registry-find shell operation)
  (let find ((rows (vector-ref g3c4-registry 0)))
    (if (not (pair? rows)) (g3c4-fail operation))
    (if (eq? shell (vector-ref (car rows) 0)) (car rows)
        (find (cdr rows)))))
(define (g3c4-entry-dead! entry)
  (vector-set! entry 2 'dead)
  (do ((i 3 (+ i 1))) ((= i 12)) (vector-set! entry i #f)))
(define (g3c4-dead-entry? entry kind)
  (and (vector? entry) (= (vector-length entry) 12)
       (eq? (vector-ref entry 1) kind) (eq? (vector-ref entry 2) 'dead)))
(define (g3c4-p2g2-zero-bytes! bytes count)
  (do ((i 0 (+ i 1))) ((= i count)) (bytevector-u8-set! bytes i 0)))
(define (g3c4-p2g2-terminal-snapshot-private shell)
  (vector 3 (if (= logical-count 2) 41 0) logical-count))
(define (g3c4-p2g2-terminal-snapshot-small-word snapshot offset)
  (if (vector? snapshot) (vector-ref snapshot (quotient offset 8))
      (bytevector-u8-ref snapshot offset)))
(define (g3c4-p2g2-terminal-output-entry-live shell operation) source)
(define live-snapshot #f)
(define (g3c4-p2g2-terminal-snapshot-live-for shell entry operation)
  live-snapshot)
(define (g3c4-p2g2-native-terminal-ids-clone parent)
  (set! native-clones (+ native-clones 1))
  (vector logical-count #f #t))
(define (g3c4-p2g2-native-terminal-ids-clone-copy native count bytes extent)
  (if (not (and (vector-ref native 2) (= count (vector-ref native 0))
                (= extent (+ 8 (* count 8))))) (error "copy shape"))
  (bytevector-u8-set! bytes 0 3)
  (if (= count 2) (bytevector-u8-set! bytes 8 41))
  0)
(define (g3c4-p2g2-native-terminal-ids-clone-release native)
  (if (vector-ref native 1) 1
      (begin
        (check (vector-ref native 2))
        (vector-set! native 2 #f)
        (set! native-releases (+ native-releases 1))
        0)))
(load (string-append (getenv "G3C4_TEST_ROOT")
                    "/native/g3c4_p2g2_terminal_ids_owner_extension.esk"))
(for-each
  (lambda (count)
    (set! logical-count count)
    (set! live-snapshot (vector #f #f #f #f #f #f count #f 3
                                (if (= count 2) 41 0)))
    (let* ((ids (car (g3c4-p2g2-terminal-ids-clone-private source-shell)))
           (entry (g3c4-registry-find ids 'test))
           (native (vector-ref entry 3))
           (anchor (vector-ref entry 10))
           (bytes (vector-ref entry 8)))
      (check (anchor 'bound native))
      (check (= (bytevector-length (g3c4-p2g2-terminal-ids-copy-private ids))
                (* count 8)))
      (vector-set! entry 3 (vector 'substituted))
      (check (reject (lambda () (g3c4-p2g2-terminal-ids-release-private! ids))))
      (check (vector-ref native 2))
      (vector-set! entry 3 native)
      (vector-set! native 1 #t)
      (check (reject (lambda () (g3c4-p2g2-terminal-ids-release-private! ids))))
      (check (and (anchor 'bound native) (vector-ref native 2)))
      (vector-set! native 1 #f)
      (check (g3c4-p2g2-terminal-ids-release-private! ids))
      (check (not (anchor 'bound native)))
      (check (anchor 'dead entry))
      (check (g3c4-p2g2-terminal-ids-release-private! ids))
      (check (not (vector-ref native 2)))
      (check (reject (lambda () (g3c4-p2g2-terminal-ids-copy-private ids))))
      (do ((i 0 (+ i 1))) ((= i (* count 8)))
        (check (= (bytevector-u8-ref bytes i) 0)))))
  '(1 2))
(check (= native-clones 2))
(check (= native-releases 2))
(display "terminal ID managed cell host PASS: checks=")
(display checks) (newline)
