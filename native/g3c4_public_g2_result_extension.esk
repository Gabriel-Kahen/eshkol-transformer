;;; Installed-only public C4 P2/G2 result adapter. Load after dispatch.
(extern ptr g3c4-native-terminal-result-create i64 i64 i64 i64
        :real et_g3c4_private_terminal_result_tensor_create_v1)
;;; Public output roots are distinct from the private terminal origin. A
;;; private origin-D shell never acquires these records by its registry kind.
(define g3c4-public-g2-released-outputs (vector '()))

(define (g3c4-public-g2-output-unique root slot shell operation)
  (let loop ((tail (vector-ref root 0)) (found #f))
    (cond ((null? tail) found)
          ((not (and (pair? tail) (vector? (car tail))
                     (> (vector-length (car tail)) slot)))
           (g3c4-fail 'invalid-state operation
                      "C4 public G2 output root is malformed"))
          ((eq? (vector-ref (car tail) slot) shell)
           (if found
               (g3c4-fail 'invalid-state operation
                          "C4 public G2 output root is duplicated"))
           (loop (cdr tail) (car tail)))
          (else (loop (cdr tail) found)))))

(define (g3c4-public-g2-output-without root slot shell operation)
  (let loop ((tail (vector-ref root 0)))
    (cond ((null? tail) '())
          ((eq? (vector-ref (car tail) slot) shell) (cdr tail))
          (else (cons (car tail) (loop (cdr tail)))))))

(define (g3c4-public-g2-output-live shell operation)
  (let* ((origin (g3c4-p2g2-terminal-origin-live shell operation))
         (terminal (g3c4-p2g2-terminal-live shell operation))
         (terminal-anchor (g3c4-p2g2-terminal-anchor shell))
         (entry (g3c4-registry-find shell operation))
         (row (g3c4-public-g2-output-unique
                g3c4-public-g2-output-rows 0 shell operation))
         (anchor (g3c4-public-g2-output-unique
                   g3c4-public-g2-output-anchors 0 shell operation))
         (binding (g3c4-public-g2-output-unique
                    g3c4-public-g2-output-bindings 0 shell operation))
         (ticket (g3c4-public-g2-output-unique
                   g3c4-public-g2-tickets 5 shell operation)))
    (if (not (and row anchor binding ticket
                  (= (vector-length row) 12)
                  (= (vector-length anchor) 12)
                  (= (vector-length binding) 2)
                  (= (vector-length ticket) 21)
                  (procedure? (vector-ref binding 1))
                  (eq? (vector-ref ticket 16) (vector-ref binding 1))
                  (eq? (vector-ref ticket 10) row)
                  (eq? (vector-ref ticket 11) anchor)
                  (eq? (vector-ref ticket 12) 'live)
                  (eq? (vector-ref row 8) 'live)
                  (eq? (vector-ref anchor 8) 'live)
                  (eq? (vector-ref row 0) shell)
                  (eq? (vector-ref anchor 0) shell)
                  (eq? (vector-ref row 1) entry)
                  (eq? (vector-ref anchor 1) entry)
                  (eq? (vector-ref row 2) (vector-ref entry 3))
                  (eq? (vector-ref anchor 2) (vector-ref entry 3))
                  (eq? (vector-ref row 3) (vector-ref origin 3))
                  (eq? (vector-ref anchor 3) (vector-ref origin 3))
                  (eq? (vector-ref row 4) (vector-ref origin 5))
                  (eq? (vector-ref anchor 4) (vector-ref origin 5))
                  (eq? (vector-ref row 5) (vector-ref ticket 3))
                  (eq? (vector-ref anchor 5) (vector-ref ticket 3))
                  (eq? (vector-ref row 6) terminal)
                  (eq? (vector-ref anchor 6) terminal)
                  (eq? (vector-ref row 7) terminal-anchor)
                  (eq? (vector-ref anchor 7) terminal-anchor)
                  (eq? (vector-ref ticket 1) (vector-ref row 3))
                  (eq? (vector-ref ticket 2) (vector-ref row 4))
                  (eq? (vector-ref ticket 4) (vector-ref origin 6))
                  (eq? (vector-ref ticket 5) shell)
                  (eq? (vector-ref ticket 6) entry)
                  (eq? (vector-ref ticket 7) (vector-ref entry 3))
                  (eq? (vector-ref ticket 8) terminal)
                  (eq? (vector-ref ticket 9) terminal-anchor)
                  ((vector-ref binding 1) 'verify row anchor entry
                   terminal terminal-anchor)
                  (eq? (g3c4-public-g2-profile-original
                         (vector-ref row 3) operation)
                       (vector-ref row 5))
                  (= (vector-ref row 9) (vector-ref terminal 14))
                  (= (vector-ref anchor 9) (vector-ref terminal 14))
                  (= (vector-ref ticket 13) (vector-ref terminal 14))
                  (= (vector-ref row 10) (vector-ref terminal 15))
                  (= (vector-ref anchor 10) (vector-ref terminal 15))
                  (= (vector-ref ticket 14) (vector-ref terminal 15))
                  (= (vector-ref row 11) (vector-ref terminal 16))
                  (= (vector-ref anchor 11) (vector-ref terminal 16))
                  (= (vector-ref ticket 15) (vector-ref terminal 16))))
        (g3c4-fail 'invalid-state operation
                   "C4 public G2 output origin or creator changed"))
    row))

(define (g3c4-public-g2-output-release! shell operation)
  (let ((entry (g3c4-registry-find shell operation)))
    (if (g3c4-dead-entry? entry 'terminal-output)
        (if (and (memq shell (vector-ref g3c4-public-g2-released-outputs 0))
                 (eq? (vector-ref entry 0) shell)
                 (eq? (vector-ref entry 3) #f)
                 (eq? (vector-ref entry 4) #f)
                 (eq? (vector-ref entry 5) #f)
                 (eq? (vector-ref entry 6) #f)
                 (eq? (vector-ref entry 7) #f)
                 (eq? (vector-ref entry 8) #f)
                 (eq? (vector-ref entry 9) #f)
                 (eq? (vector-ref entry 10) #f)
                 (eq? (vector-ref entry 11) #f)
                 (not (g3c4-public-g2-output-unique
                        g3c4-public-g2-output-rows 0 shell operation))
                 (not (g3c4-public-g2-output-unique
                        g3c4-public-g2-output-anchors 0 shell operation))
                 (not (g3c4-public-g2-output-unique
                        g3c4-public-g2-output-bindings 0 shell operation))
                 (not (g3c4-public-g2-output-unique
                        g3c4-public-g2-tickets 5 shell operation)))
            #t
            (g3c4-fail 'invalid-state operation
                       "C4 released public G2 identity changed"))
        (let* ((row (g3c4-public-g2-output-live shell operation))
               (anchor (g3c4-public-g2-output-unique
                         g3c4-public-g2-output-anchors 0 shell operation))
               (ticket (g3c4-public-g2-output-unique
                         g3c4-public-g2-tickets 5 shell operation))
               (next-rows (g3c4-public-g2-output-without
                            g3c4-public-g2-output-rows 0 shell operation))
               (next-anchors (g3c4-public-g2-output-without
                               g3c4-public-g2-output-anchors 0 shell operation))
               (next-bindings (g3c4-public-g2-output-without
                                g3c4-public-g2-output-bindings 0 shell operation))
               (next-tickets (g3c4-public-g2-output-without
                               g3c4-public-g2-tickets 5 shell operation))
               (next-released
                 (cons shell (vector-ref g3c4-public-g2-released-outputs 0))))
          ;; This authentic private release rejects a held I1 lease before
          ;; mutation. Everything after genuine success is a fixed scrub.
          (g3c4-p2g2-terminal-release-private! shell)
          (vector-set! row 8 'dead)
          (vector-set! anchor 8 'dead)
          (vector-set! ticket 12 'dead)
          (vector-set! g3c4-public-g2-output-rows 0 next-rows)
          (vector-set! g3c4-public-g2-output-anchors 0 next-anchors)
          (vector-set! g3c4-public-g2-output-bindings 0 next-bindings)
          (vector-set! g3c4-public-g2-tickets 0 next-tickets)
          (vector-set! g3c4-public-g2-released-outputs 0 next-released)
          #t))))

;;; Detached G2 results have their own authority. The accepted scalar P2/G1
;;; result records and isolated adapter do not acquire a terminal dependency.
(define g3c4-public-g2-results (vector '()))
(define g3c4-public-g2-result-bindings (vector '()))
(define g3c4-public-g2-released-results (vector '()))

(define (g3c4-public-g2-result-known? shell)
  (or (g3c4-public-g2-output-unique
        g3c4-public-g2-results 0 shell 'generation-tensor-release!)
      (g3c4-public-g2-output-unique
        g3c4-public-g2-released-results 0 shell
        'generation-tensor-release!)))

(define (g3c4-public-g2-result-live shell expected operation)
  (let* ((entry (g3c4-registry-find shell operation))
         (row (g3c4-public-g2-output-unique
                g3c4-public-g2-results 0 shell operation))
         (binding (g3c4-public-g2-output-unique
                    g3c4-public-g2-result-bindings 0 shell operation)))
    (if (not (and row binding
                  (= (vector-length row) 10)
                  (= (vector-length binding) 2)
                  (procedure? (vector-ref binding 1))
                  ((vector-ref binding 1) row entry)
                  (eq? (vector-ref row 0) shell)
                  (eq? (vector-ref row 1) entry)
                  (eq? (vector-ref row 2) (vector-ref entry 3))
                  (eq? (vector-ref row 3) expected)
                  (eq? (vector-ref entry 1) expected)
                  (eq? (vector-ref row 8) 'diagnostic-c4-p2g2)
                  (eq? (vector-ref row 9) 'live)
                  (eq? (vector-ref entry 2) 'live)
                  (eq? (vector-ref entry 0) shell)
                  (eq? (vector-ref entry 4) #f)
                  (eq? (vector-ref entry 5) #f)
                  (eq? (vector-ref entry 6) #f)
                  (eq? (vector-ref entry 8) #f)
                  (eq? (vector-ref entry 9) #f)
                  (vector? (vector-ref entry 10))
                  (= (vector-length (vector-ref entry 10)) 1)
                  (eq? (vector-ref (vector-ref entry 10) 0)
                       (vector-ref row 2))
                  (eq? (vector-ref entry 11) g3c4-model-profile)
                  (if (eq? expected 'result-rng)
                      (and (g3c4-rng-snapshot? (vector-ref entry 7))
                           (eq? (vector-ref entry 7) (vector-ref row 7)))
                      (and (m3t-exact-i64? (vector-ref entry 7))
                           (= (vector-ref entry 7) (vector-ref row 5))))))
        (g3c4-fail 'invalid-state operation
                   "C4 public G2 result identity changed"))
    row))

(define (g3c4-public-g2-result-release! shell expected operation)
  (m3-call operation
    (let ((entry (g3c4-registry-find shell operation)))
      (if (not (eq? (vector-ref entry 1) expected))
          (g3c4-fail 'invalid-argument operation
                     "C4 public G2 result kind changed"))
      (if (g3c4-dead-entry? entry expected)
          (let ((tombstone (g3c4-public-g2-output-unique
                             g3c4-public-g2-released-results 0
                             shell operation)))
            (if (and tombstone (= (vector-length tombstone) 2)
                   (eq? (vector-ref tombstone 1) expected)
                   (eq? (vector-ref entry 0) shell)
                   (eq? (vector-ref entry 3) #f)
                   (eq? (vector-ref entry 4) #f)
                   (eq? (vector-ref entry 5) #f)
                   (eq? (vector-ref entry 6) #f)
                   (eq? (vector-ref entry 7) #f)
                   (eq? (vector-ref entry 8) #f)
                   (eq? (vector-ref entry 9) #f)
                   (eq? (vector-ref entry 10) #f)
                   (eq? (vector-ref entry 11) #f)
                   (not (g3c4-public-g2-output-unique
                          g3c4-public-g2-results 0 shell operation))
                   (not (g3c4-public-g2-output-unique
                          g3c4-public-g2-result-bindings 0 shell operation)))
                #t
                (g3c4-fail 'invalid-state operation
                           "C4 released G2 result roots changed")))
          (let* ((row (g3c4-public-g2-result-live
                        shell expected operation))
                 (next-rows (g3c4-public-g2-output-without
                              g3c4-public-g2-results 0 shell operation))
                 (next-bindings (g3c4-public-g2-output-without
                                  g3c4-public-g2-result-bindings 0
                                  shell operation))
                 (next-released
                   (cons (vector shell expected)
                         (vector-ref g3c4-public-g2-released-results 0))))
            (g3c4-native-check
              (if (eq? expected 'result-rng)
                  (g3c4-native-rng-release (vector-ref row 2))
                  (g3c4-native-result-tensor-release (vector-ref row 2)))
              operation)
            (g3c4-entry-dead! entry)
            (vector-set! row 2 #f)
            (vector-set! row 9 'dead)
            (vector-set! g3c4-public-g2-results 0 next-rows)
            (vector-set! g3c4-public-g2-result-bindings 0 next-bindings)
            (vector-set! g3c4-public-g2-released-results 0 next-released)
            #t)))))

(define (g3c4-public-g2-source-snapshot shell operation)
  (g3c4-public-g2-output-live shell operation)
  (g3c4-p2g2-terminal-snapshot-private shell))

(define (g3c4-public-g2-snapshot-equal? first second)
  (and (vector? first) (= (vector-length first) 8)
       (vector? second) (= (vector-length second) 8)
       (let loop ((index 0))
         (if (= index 8) #t
             (and (= (vector-ref first index) (vector-ref second index))
                  (loop (+ index 1)))))))

(define (g3c4-public-g2-resnapshot shell source native expected operation)
  (let* ((bytes (make-bytevector 64 0))
         (row (g3c4-public-g2-output-live shell operation)))
    (if (not (and (eq? row source) (eq? (vector-ref row 2) native)))
        (g3c4-fail 'invalid-state operation
                   "C4 public G2 source changed before publication"))
    (g3c4-native-check
      (g3c4-p2g2-native-snapshot native bytes 72) operation)
    (let ((current
            (vector (g3c4-p2g2-terminal-word bytes 0)
                    (g3c4-p2g2-terminal-word bytes 8)
                    (g3c4-p2g2-terminal-word bytes 16)
                    (g3c4-p2g2-terminal-word bytes 24)
                    (g3c4-p2g2-terminal-word bytes 32)
                    (g3c4-p2g2-terminal-word bytes 40)
                    (g3c4-p2g2-terminal-word bytes 48)
                    (g3c4-p2g2-terminal-word bytes 56))))
      (if (not (and (g3c4-public-g2-snapshot-equal? current expected)
                    (eq? source (g3c4-public-g2-output-live
                                  shell operation))))
          (g3c4-fail 'invalid-state operation
                     "C4 public G2 native snapshot changed"))
      #t)))

(define (g3c4-public-g2-detached-ids shell snapshot operation)
  ;; Each private clone operation owns a sibling m3-call scope.
  (let ((clone (g3c4-p2g2-terminal-ids-clone-private shell))
        (released #f))
    (guard (caught
             (#t
               (if (not released)
                   (guard (cleanup (#t (exit 134)))
                     (g3c4-p2g2-terminal-ids-clone-release-private! clone)))
               (raise caught)))
      (let ((bytes (g3c4-p2g2-terminal-ids-clone-copy-private clone)))
        (g3c4-p2g2-terminal-ids-clone-release-private! clone)
        (set! released #t)
        (if (not (and (= (bytevector-length bytes)
                         (* (vector-ref snapshot 2) 8))
                      (= (g3c4-p2g2-terminal-word bytes 0)
                         (vector-ref snapshot 0))
                      (or (= (vector-ref snapshot 2) 1)
                          (= (g3c4-p2g2-terminal-word bytes 8)
                             (vector-ref snapshot 1)))))
            (g3c4-fail 'invalid-state operation
                       "C4 public G2 detached I1 differs"))
        bytes))))

(define (g3c4-public-g2-result-publish shell snapshot kind operation)
  (let ((ids (if (eq? kind 'ids)
                 (g3c4-public-g2-detached-ids shell snapshot operation)
                 #f)))
    (m3-call operation
      (let* ((source (g3c4-public-g2-output-live shell operation))
             (source-native (vector-ref source 2))
             (count (if (eq? kind 'ids) (vector-ref snapshot 2) 1))
             (first (cond ((eq? kind 'ids) (vector-ref snapshot 0))
                          ((eq? kind 'lengths) (vector-ref snapshot 2))
                          ((eq? kind 'cache-lengths) (vector-ref snapshot 3))
                          (else 0)))
             (second (if (eq? kind 'ids) (vector-ref snapshot 1) 0))
             (rng (vector g3c4-rng-algorithm
                          (vector-ref snapshot 4) (vector-ref snapshot 5)
                          (vector-ref snapshot 6) (vector-ref snapshot 7)))
             (answer-shell (vector 'g3c4-g2-result-private))
             (ledger (vector #f))
             (entry (vector answer-shell kind 'pending #f #f #f #f #f
                            #f #f ledger g3c4-model-profile))
             (record (vector answer-shell entry #f kind count first second
                             rng 'diagnostic-c4-p2g2 'pending))
             (bound-native #f)
             (binding
               (vector answer-shell
                 (lambda (candidate candidate-entry)
                   (and bound-native
                        (eq? candidate record)
                        (eq? candidate-entry entry)
                        (eq? (vector-ref candidate 0) answer-shell)
                        (eq? (vector-ref candidate 1) entry)
                        (eq? (vector-ref candidate 2) bound-native)
                        (eq? (vector-ref candidate 3) kind)
                        (= (vector-ref candidate 4) count)
                        (= (vector-ref candidate 5) first)
                        (= (vector-ref candidate 6) second)
                        (eq? (vector-ref candidate 7) rng)
                        (eq? (vector-ref candidate 8)
                             'diagnostic-c4-p2g2)
                        (= (vector-ref rng 1) (vector-ref snapshot 4))
                        (= (vector-ref rng 2) (vector-ref snapshot 5))
                        (= (vector-ref rng 3) (vector-ref snapshot 6))
                        (= (vector-ref rng 4) (vector-ref snapshot 7))
                        (eq? (vector-ref candidate-entry 3) bound-native)
                        (eq? (vector-ref candidate-entry 10) ledger)
                        (eq? (vector-ref candidate-entry 7)
                             (if (eq? kind 'result-rng) rng first))))))
             (old-registry (vector-ref g3c4-registry 0))
             (old-results (vector-ref g3c4-public-g2-results 0))
             (old-bindings (vector-ref g3c4-public-g2-result-bindings 0))
             (next-registry (cons entry old-registry))
             (next-results (cons record old-results))
             (next-bindings
               (cons binding old-bindings))
             (answer (if (eq? kind 'ids) (list answer-shell) answer-shell))
             (native '()))
        (guard (caught
                 (#t
                   (if (not (null? native))
                       (if (not (= (if (eq? kind 'result-rng)
                                       (g3c4-native-rng-release native)
                                       (g3c4-native-result-tensor-release
                                         native)) 0))
                           (exit 134)))
                   (g3c4-entry-dead! entry)
                   (vector-set! record 2 #f)
                   (vector-set! record 9 'dead)
                   (vector-set! g3c4-registry 0 old-registry)
                   (vector-set! g3c4-public-g2-results 0 old-results)
                   (vector-set! g3c4-public-g2-result-bindings 0
                                old-bindings)
                   (raise caught)))
          (vector-set! g3c4-registry 0 next-registry)
          (vector-set! g3c4-public-g2-results 0 next-results)
          (vector-set! g3c4-public-g2-result-bindings 0 next-bindings)
          (set! native
            (if (eq? kind 'result-rng)
                (g3c4-native-result-rng-create
                  (vector-ref snapshot 4) (vector-ref snapshot 5)
                  (vector-ref snapshot 6) (vector-ref snapshot 7))
                (g3c4-native-terminal-result-create
                  (cond ((eq? kind 'ids) 5)
                        ((eq? kind 'lengths) 6) (else 7))
                  count first second)))
          (if (null? native) (g3c4-native-fail operation))
          (set! bound-native native)
          (vector-set! ledger 0 native)
          (vector-set! entry 3 native)
          (vector-set! entry 7 (if (eq? kind 'result-rng) rng first))
          (vector-set! record 2 native)
          (if (and ids
                   (not (and (= (g3c4-p2g2-terminal-word ids 0) first)
                             (or (= count 1)
                                 (= (g3c4-p2g2-terminal-word ids 8)
                                    second)))))
              (g3c4-fail 'invalid-state operation
                         "C4 public G2 copied IDs changed"))
          (g3c4-public-g2-resnapshot
            shell source source-native snapshot operation)
          (vector-set! entry 2 'live)
          (vector-set! record 9 'live)
          answer)))))

(define (g3c4-public-g2-output-access shell kind operation)
  (let ((snapshot (g3c4-public-g2-source-snapshot shell operation)))
    (if (not (and (= (vector-ref snapshot 4) 1)
                  (>= (vector-ref snapshot 5) 0)))
        (g3c4-fail 'invalid-state operation
                   "C4 public G2 RNG snapshot is malformed"))
    (if (eq? kind 'text)
        (m3-call operation
          (let* ((source (g3c4-public-g2-output-live shell operation))
                 (terminal (g3c4-p2g2-terminal-live shell operation))
                 (count (vector-ref snapshot 2))
                 (original (if (= count 1) (vector-ref terminal 7)
                               (vector-ref terminal 8)))
                 (bytes (make-bytevector count 0))
                 (native (vector-ref source 2)))
            (if (not (and (eq? terminal (vector-ref source 6))
                          (bytevector? original)
                          (= (bytevector-length original) count)))
                (g3c4-fail 'invalid-state operation
                           "C4 public G2 terminal text changed"))
            (let loop ((index 0))
              (if (< index count)
                  (begin
                    (bytevector-u8-set! bytes index
                      (bytevector-u8-ref original index))
                    (loop (+ index 1)))))
            (if (not (and (= (bytevector-u8-ref bytes 0)
                             (vector-ref snapshot 0))
                          (or (= count 1)
                              (= (bytevector-u8-ref bytes 1)
                                 (vector-ref snapshot 1)))))
                (g3c4-fail 'invalid-state operation
                           "C4 public G2 text differs"))
            (g3c4-public-g2-resnapshot
              shell source native snapshot operation)
            (list bytes)))
        (g3c4-public-g2-result-publish shell snapshot kind operation))))

;;; Complete P2/G1-G2 provenance is private to this installed aggregate.
;;; The two issuer lists are lexical; public rows and returned vectors are
;;; never used as an independent baseline.
(extern i64 g3c4-native-p2-original-snapshot ptr ptr i64
        :real et_g3c4_private_input_p2_original_snapshot_v1)

(define (g3c4-public-p2g2-native-input-ids native operation)
  (let ((bytes (make-bytevector 16 0)))
    (g3c4-native-check
      (g3c4-native-p2-original-snapshot native bytes 24) operation)
    (vector (g3c4-p2g2-terminal-word bytes 0)
            (g3c4-p2g2-terminal-word bytes 8))))

(define (g3c4-public-p2g2-history-final?
          source ticket generator-row input-entry model tokenizer
          generator input output eos snapshot)
  ;; This is the fixed, callback-free check after the last typed snapshot.
  ;; All provider, registry and issuer procedures have already completed.
  (and (vector? source) (= (vector-length source) 12)
       (vector? ticket) (= (vector-length ticket) 21)
       (memq source (vector-ref g3c4-public-g2-output-rows 0))
       (memq ticket (vector-ref g3c4-public-g2-tickets 0))
       (eq? (vector-ref source 0) output)
       (eq? (vector-ref source 3) generator)
       (eq? (vector-ref source 4) input)
       (eq? (vector-ref source 8) 'live)
       (eq? (vector-ref ticket 1) generator)
       (eq? (vector-ref ticket 2) input)
       (eq? (vector-ref ticket 5) output)
       (eq? (vector-ref ticket 6) (vector-ref source 1))
       (eq? (vector-ref ticket 10) source)
       (eq? (vector-ref ticket 12) 'live)
       (eq? (vector-ref input-entry 2) 'live)
       (vector-ref input-entry 3)
       (eq? (vector-ref generator-row 3) model)
       (eq? (vector-ref generator-row 4) tokenizer)
       (eq? (vector-ref generator-row 7) 'live)
       (= (vector-ref (vector-ref generator-row 5) 6) eos)
       (= (vector-ref source 9) (vector-ref snapshot 2))
       (= (vector-ref source 10) (vector-ref snapshot 0))
       (= (vector-ref source 11) (vector-ref snapshot 1))
       (= (vector-ref ticket 13) (vector-ref snapshot 2))
       (= (vector-ref ticket 14) (vector-ref snapshot 0))
       (= (vector-ref ticket 15) (vector-ref snapshot 1))))

(define g3c4-public-p2g2-history-route
  (let ((input-issuers '()) (history-issuers '())
        (issued-outputs '())
        (input-count 0) (history-count 0)
        (secret (vector 'g3c4-public-p2g2-input-creator)))
    (set! g3c4-public-p2g2-input-create-authority
      (lambda (encoded)
        (let ((created #f) (issued #f))
          (guard (caught
                   (#t (if (and created (not issued))
                           (guard (cleanup (#t (exit 134)))
                             (generation-tensor-release-internal! created)))
                       (raise caught)))
            (set! created
              (g3c4-input-create-with-native
                encoded 'generation-c4-input-create
                g3c4-native-input-from-t1-p2))
            (g3c4-public-p2g2-history-route
              'input-issue encoded created secret #f)
            (set! issued #t)
            created))))
    (lambda (action first second third fourth)
      (let ((operation 'g3c4-public-p2g2-history))
        (cond
          ((eq? action 'input-issue)
           (if (not (eq? third secret))
               (g3c4-fail 'invalid-argument operation
                          "P2 input issuance is not public-constructor bound"))
           (let* ((encoded first) (input second)
                  (entry (g3c4-input-entry-live input operation))
                  (native (vector-ref entry 3)))
             (if (or (>= input-count 64)
                     (not (t1-wave1-tensor-admitted? encoded))
                     (not (= (t1-shell-length encoded) 2))
                     (not (= (t1-shell-last-status) 0))
                     (let loop ((tail input-issuers))
                       (and (pair? tail)
                            (or (eq? (car (car tail)) input)
                                (loop (cdr tail))))))
                 (g3c4-fail 'invalid-state operation
                            "P2 input issuance or original T1 changed"))
             (let* ((id0 (t1-shell-read encoded 0))
                    (status0 (t1-shell-last-status))
                    (id1 (t1-shell-read encoded 1))
                    (status1 (t1-shell-last-status))
                    (ids (g3c4-public-p2g2-native-input-ids
                           native operation)))
               (if (not (and (= status0 0) (= status1 0)
                             (t1-wave1-tensor-admitted? encoded)
                             (= id0 (vector-ref ids 0))
                             (= id1 (vector-ref ids 1))))
                   (g3c4-fail 'invalid-state operation
                              "P2 creation IDs changed before issuance"))
             (let ((authority
                     (lambda (candidate candidate-entry candidate-native)
                       (and (eq? candidate input)
                            (eq? candidate-entry entry)
                            (eq? candidate-native native)
                            (eq? (g3c4-input-entry-live input operation)
                                 entry)
                            (let ((current
                                    (g3c4-public-p2g2-native-input-ids
                                      native operation)))
                              (and (= (vector-ref current 0) id0)
                                   (= (vector-ref current 1) id1)))))))
               ;; The pair retains the original T1 identity, without
               ;; requiring its post-creation liveness or rereading it.
               (set! input-issuers
                 (cons (cons input (cons encoded authority)) input-issuers))
               (set! input-count (+ input-count 1))
               #t))))
          ((eq? action 'capture)
           (let* ((generator first) (input second) (output third)
                  (input-issuer (assq input input-issuers))
                  (input-entry (g3c4-input-entry-live input operation))
                  (generator-row
                    (g3c4-public-g2-profile-live generator operation))
                  (source (g3c4-public-g2-output-live output operation))
                  (ticket (g3c4-public-g2-output-unique
                            g3c4-public-g2-tickets 5 output operation))
                  (snapshot
                    (g3c4-public-g2-source-snapshot output operation))
                  (policy (vector-ref generator-row 5))
                  (eos (vector-ref policy 6)))
             (if (not (and (< history-count 64) input-issuer
                           (not (memq output issued-outputs))
                           (g3c4-generator-entry-call-ready
                             generator operation)
                           (g3c4-model-entry-live
                             (vector-ref (vector-ref generator-row 3) 0)
                             operation #f)
                           (g3c4-baseline-tokenizer-entry
                             (vector-ref generator-row 4) operation
                             'invalid-state 'invalid-state)
                           (eq? (vector-ref source 3) generator)
                           (eq? (vector-ref source 4) input)
                           (eq? (vector-ref ticket 6)
                                (vector-ref source 1))
                           ((cdr (cdr input-issuer)) input input-entry
                            (vector-ref input-entry 3))
                           (= (vector-ref snapshot 3)
                              (+ 2 (vector-ref snapshot 2)))
                           (or (and (= (vector-ref snapshot 2) 1)
                                    (= (vector-ref snapshot 0) eos)
                                    (= (vector-ref snapshot 1) 0))
                               (and (= (vector-ref snapshot 2) 2)
                                    (not (= (vector-ref snapshot 0) eos))
                                    (<= 0 (vector-ref snapshot 1))
                                    (<= (vector-ref snapshot 1) 255)))))
                 (g3c4-fail 'invalid-state operation
                            "P2/G2 full history or public origin changed"))
             (let* ((shell (vector 'g3c4-p2g2-history-private))
                    (phase 'live)
                    (prompt
                      (g3c4-public-p2g2-native-input-ids
                        (vector-ref input-entry 3) operation))
                    ;; The final terminal read follows every input provider.
                    ;; Its native/I1 path has no user callback. Publication
                    ;; below performs only fixed cell checks and writes.
                    (final-snapshot
                      (g3c4-p2g2-terminal-snapshot-private output))
                    (p0 (vector-ref prompt 0))
                    (p1 (vector-ref prompt 1))
                    (g1 (vector-ref snapshot 0))
                    (g2 (vector-ref snapshot 1))
                    (count (vector-ref snapshot 2))
                    (cache (vector-ref snapshot 3))
                    (r0 (vector-ref snapshot 4))
                    (r1 (vector-ref snapshot 5))
                    (r2 (vector-ref snapshot 6))
                    (r3 (vector-ref snapshot 7))
                    (model (vector-ref generator-row 3))
                    (tokenizer (vector-ref generator-row 4))
                    (descriptor
                      (vector p0 p1 g1 g2 count cache r0 r1 r2 r3 eos
                              model tokenizer generator input output))
                    (authority
                      (lambda (verb candidate-generator candidate-input
                                    candidate-output)
                        (cond
                         ((eq? verb 'begin)
                            (if (and (eq? phase 'live)
                                     (eq? candidate-generator generator)
                                     (eq? candidate-input input)
                                     (eq? candidate-output output))
                                (begin (set! phase 'admitting) #t)
                                (g3c4-fail 'invalid-state operation
                                           "P2/G2 history is busy or spent")))
                         ((eq? verb 'abort)
                            (if (and (eq? phase 'admitting)
                                     (eq? candidate-generator generator)
                                     (eq? candidate-input input)
                                     (eq? candidate-output output))
                                (begin (set! phase 'live) #t)
                                (exit 134)))
                         (else
                        (if (not (and (eq? candidate-generator generator)
                                      (eq? candidate-input input)
                                      (eq? candidate-output output)
                                      (eq? phase 'admitting)))
                            (g3c4-fail 'invalid-state operation
                                       "P2/G2 history is spent or foreign"))
                        (if (not (and
                          (eq? (g3c4-public-g2-profile-live
                                 generator operation) generator-row)
                          (g3c4-generator-entry-call-ready
                            generator operation)
                          (g3c4-model-entry-live
                            (vector-ref model 0) operation #f)
                          (g3c4-baseline-tokenizer-entry
                            tokenizer operation
                            'invalid-state 'invalid-state)
                          (eq? (vector-ref generator-row 3) model)
                          (eq? (vector-ref generator-row 4) tokenizer)
                          (= (vector-ref (vector-ref generator-row 5) 6) eos)
                          (eq? (g3c4-public-g2-output-live output operation)
                               source)
                          (eq? (g3c4-public-g2-output-unique
                                 g3c4-public-g2-tickets 5 output operation)
                               ticket)
                          ((cdr (cdr input-issuer)) input input-entry
                           (vector-ref input-entry 3))))
                            (g3c4-fail 'invalid-state operation
                                       "P2/G2 issuer roots changed"))
                        (let ((current
                                (g3c4-p2g2-terminal-snapshot-private output)))
                          (if (not (and
                            (= (vector-ref current 0) g1)
                            (= (vector-ref current 1) g2)
                            (= (vector-ref current 2) count)
                            (= (vector-ref current 3) cache)
                            (= (vector-ref current 4) r0)
                            (= (vector-ref current 5) r1)
                            (= (vector-ref current 6) r2)
                            (= (vector-ref current 7) r3)
                            (g3c4-public-p2g2-history-final?
                              source ticket generator-row input-entry
                              model tokenizer generator input output eos
                              current)))
                              (g3c4-fail 'invalid-state operation
                                         "P2/G2 terminal bytes changed")))
                        (if (eq? verb 'admit)
                            (begin
                              (if (not (and (eq? candidate-generator generator)
                                            (eq? candidate-input input)
                                            (eq? candidate-output output)
                                            (eq? (vector-ref descriptor 13)
                                                 generator)
                                            (eq? (vector-ref descriptor 14)
                                                 input)
                                            (eq? (vector-ref descriptor 15)
                                                 output)))
                                  (g3c4-fail 'invalid-state operation
                                             "P2/G2 final origin changed"))
                              (set! phase 'spent)
                              descriptor)
                            (g3c4-fail 'invalid-argument operation
                                       "P2/G2 history verb is invalid"))))))
               (let ((next-history
                       (cons (cons shell authority) history-issuers))
                     (next-outputs (cons output issued-outputs)))
                 (if (not (and
                       (let loop ((index 0))
                         (if (= index 8) #t
                             (and (= (vector-ref snapshot index)
                                     (vector-ref final-snapshot index))
                                  (loop (+ index 1)))))
                       (g3c4-public-p2g2-history-final?
                         source ticket generator-row input-entry model
                         tokenizer generator input output eos final-snapshot)
                       (not (memq output issued-outputs))))
                     (g3c4-fail 'invalid-state operation
                                "P2/G2 final source changed before issuance"))
                 (set! history-issuers next-history)
                 (set! issued-outputs next-outputs)
                 (set! history-count (+ history-count 1))
                 shell))))
          ((eq? action 'admit)
           (let ((issuer (assq first history-issuers)))
             (if (not issuer)
                 (g3c4-fail 'invalid-argument operation
                            "P2/G2 history shell is not issued"))
             (let ((begun #f))
               (guard (caught
                        (#t (if begun
                                ((cdr issuer) 'abort second third fourth))
                            (raise caught)))
                 ((cdr issuer) 'begin second third fourth)
                 (set! begun #t)
                 ((cdr issuer) 'admit second third fourth))))))
          (else (g3c4-fail 'invalid-argument operation
                           "P2/G2 history action is invalid")))))))

(define (g3c4-public-p2g2-history-capture-internal!
          generator input output)
  (g3c4-public-p2g2-history-route 'capture generator input output #f))

(define (g3c4-public-p2g2-history-admit-once-internal!
          history generator input output)
  (g3c4-public-p2g2-history-route 'admit history generator input output))
