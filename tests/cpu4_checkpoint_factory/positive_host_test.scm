;;; Pure data helpers extracted from the actual prepared runtime fixture.
;;; No native/reader/ownership substitutes and no runtime admission.
(use-modules (srfi srfi-1) (rnrs bytevectors))
(define checks 0)
(define (check good) (if good (set! checks (+ checks 1)) (error "positive data helper check")))
(define (read-forms path)
  (call-with-input-file path
    (lambda (p) (let loop ((out '()))
      (let ((item (read p)))
        (if (eof-object? item) (reverse out) (loop (cons item out))))))))
(define (definition name path)
  (find (lambda (f) (and (pair? f) (eq? (car f) 'define)
                         (eq? (if (pair? (cadr f)) (caadr f) (cadr f)) name)))
        (read-forms path)))
(for-each (lambda (name) (eval (definition name "native/g3c4_model_extension.esk") (current-module)))
          '(g3c4-model-paths g3c4-model-shapes))
(for-each (lambda (name) (eval (definition name "native/cpu4_checkpoint_extension.esk") (current-module)))
          '(cpu4-checkpoint-product cpu4-checkpoint-vector->list))
(eval (definition 'd2-core-bytes=? "internal/d2/lib/d2_semantic_core.esk") (current-module))
(define cpu4-checkpoint-i64-max 9223372036854775807)
(define (cpu4-checkpoint-fail category message) (error message))
(for-each (lambda (name) (eval (definition name "tests/cpu4_checkpoint_factory/positive_runtime.esk") (current-module)))
          '(cpu4-fdt-bytes cpu4-fdt-primary-bytes cpu4-fdt-moment-bytes cpu4-fdt-planes=?
            cpu4-fdt-controls=? cpu4-fdt-paths cpu4-fdt-config))
(define values (cpu4-fdt-primary-bytes))
(define moments (cpu4-fdt-moment-bytes))
(define (u32 bytes at)
  (+ (bytevector-u8-ref bytes at) (* 256 (bytevector-u8-ref bytes (+ at 1)))
     (* 65536 (bytevector-u8-ref bytes (+ at 2)))
     (* 16777216 (bytevector-u8-ref bytes (+ at 3)))))
(define (check-plane bytes elements plane)
  (check (= (bytevector-length bytes) (* elements 4)))
  (let loop ((index 0))
    (if (= index elements) #t
        (let ((word (u32 bytes (* index 4))))
          (check (= word (+ 1056964608 (* plane 4096) (modulo index 4096))))
          (check (and (> word 0) (< word 2139095040)))
          (loop (+ index 1))))))
(let loop ((index 0))
  (if (= index 14) #t
      (begin (check-plane (vector-ref values index)
                         (cpu4-checkpoint-product (vector-ref g3c4-model-shapes index)) index)
             (loop (+ index 1)))))
(let loop ((index 0))
  (if (= index 28) #t
      (begin (check-plane (vector-ref moments index)
                         (cpu4-checkpoint-product (vector-ref g3c4-model-shapes (quotient index 2)))
                         (+ index 32))
             (loop (+ index 1)))))
(check (cpu4-fdt-planes=? values (cpu4-fdt-primary-bytes) 14))
(check (cpu4-fdt-planes=? moments (cpu4-fdt-moment-bytes) 28))
(check (not (cpu4-fdt-planes=? values moments 14)))
(define controls (vector (vector 'philox4x32-10 1 1729 0 0) (vector "raw" 256)
                         (vector #vu8(1 2) #vu8(3 4)) (vector #vu8(5 6) "config") (vector 4 1 0)))
(define copied (vector (vector 'philox4x32-10 1 1729 0 0) (vector "raw" 256)
                       (vector #vu8(1 2) #vu8(3 4)) (vector #vu8(5 6) "config") (vector 4 1 0)))
(check (cpu4-fdt-controls=? controls copied))
(bytevector-u8-set! (vector-ref (vector-ref copied 3) 0) 0 9)
(check (not (cpu4-fdt-controls=? controls copied)))
(check (not (equal? (cpu4-fdt-config #f) (cpu4-fdt-config #t))))
(display "CPU4 positive fixture pure payload helpers PASS: checks=") (display checks) (newline)
