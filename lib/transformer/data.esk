(define e1b-safe-d2-token-dataset-close-call
  (let ()
    (extern void e1b-d2-token-dataset-close ptr ptr
            :real et_e1b_public_d2_token_dataset_close_v1)
    (lambda (dataset)
      (let ((output (vector #f)))
