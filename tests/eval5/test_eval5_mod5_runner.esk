(extern i64 eval5-load-i64 ptr i64 i64 :real et_eval5_aot_load_i64)
(extern i32 eval5-bytes-equal ptr ptr i64 ptr :real et_eval5_aot_bytes_equal)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define tokens 8)
(define doc-tokens 9)
(define docs-per-split 2)
(define split-tokens (* docs-per-split doc-tokens))
(define width 16)
(define hidden 32)
(define query-heads 4)
(define head-width 4)
(define window tokens)
(define kv-heads 2)
(define vocab 16)
(define steps 12)
(define epsilon 0.125)
(define learning-rate 0.25)

(define eval5-err-contaminated -7)
(define eval5-ngram-tokens 2)
(define eval5-ngram-order 3)
(define eval5-forbid-exact 1)
(define eval5-min-overlap 0.25)
(define eval5-max-rate 0.0)

(define (expect-status operation expected actual)
  (unless (= actual expected)
    (display operation) (display " expected status ") (display expected)
    (display ", received ") (display actual) (newline) (exit 1)))

(define (require-check label ok)
  (unless ok (display label) (newline) (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "EVAL5 MOD5 workspace allocation failed" (not (= (ptr->usize p) 0)))
    p))

;; MOD5 K1 workspace
(define span-bytes (* 4 width hidden))
(define workspace (checked-allocate (* 7 span-bytes)))
(define input-a workspace)
(define input-b (ptr-add workspace span-bytes))
(define input-c (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define output-a (ptr-add workspace (* 4 span-bytes)))
(define output-b (ptr-add workspace (* 5 span-bytes)))
(define output-c (ptr-add workspace (* 6 span-bytes)))
(define query-positions (checked-allocate (* tokens 8)))
(define key-positions (checked-allocate (* tokens 8)))
(define keep-mask (checked-allocate (* tokens tokens)))
(define slopes (checked-allocate (* query-heads 4)))
(define epsilon-buffer (checked-allocate 4))
(define runtime-cell (checked-allocate 8))
(expect-status "K1 discovery" 0 (open-mod5 runtime-cell))
(define runtime (volatile-load ptr runtime-cell))
(release runtime-cell)

(do ((t 0 (+ t 1)))
    ((= t tokens))
  (volatile-store! i64 (ptr-add query-positions (* 8 t)) t)
  (volatile-store! i64 (ptr-add key-positions (* 8 t)) t))
(do ((i 0 (+ i 1)))
    ((= i (* tokens tokens)))
  (volatile-store! u8 (ptr-add keep-mask i) 1))
(do ((h 0 (+ h 1)))
    ((= h query-heads))
  (store-f32 slopes h 0.0))
(store-f32 epsilon-buffer 0 epsilon)

(define (pack tensor buffer)
  (let* ((count (tensor-length tensor))
         (flat (reshape tensor (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count))
      (store-f32 (ffi-pointer buffer) i (tensor-ref flat i)))))

(define (unpack buffer rows cols)
  (let* ((count (* rows cols))
         (flat (zeros (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count) (reshape flat (list rows cols)))
      (tensor-set! flat i (load-f32 (ffi-pointer buffer) i)))))

(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (store-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d)
                   (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (load-f32 (ffi-pointer buffer)
                                 (+ (* (+ (* h tokens) t) head-width) d))))))))

(define (rms x gamma)
  (pack x input-a)
  (pack gamma input-b)
  (expect-status "RMSNorm forward" 0
                 (rms-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (unpack output-a tokens width))

(define (rms-grad x gamma dy)
  (pack x input-a)
  (pack gamma input-b)
  (pack dy upstream)
  (expect-status "RMSNorm backward" 0
                 (rms-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                               (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens width) (unpack output-b 1 width)))

(define (glu gate up)
  (pack gate input-a)
  (pack up input-b)
  (expect-status "SwiGLU forward" 0
                 (glu-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer output-a)))
  (unpack output-a tokens hidden))

(define (glu-grad gate up dy)
  (pack gate input-a)
  (pack up input-b)
  (pack dy upstream)
  (expect-status "SwiGLU backward" 0
                 (glu-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens hidden) (unpack output-b tokens hidden)))

(define (pack-attention q k v)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c))

(define (attend q k v)
  (pack-attention q k v)
  (expect-status "attention forward" 0
                 (attention-forward (ffi-pointer runtime) kv-heads
                                    (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                    (ffi-pointer query-positions) (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    window (ffi-pointer output-a)))
  (unpack-heads output-a query-heads))

(define (attend-grad q k v dy)
  (pack-attention q k v)
  (pack-heads dy query-heads upstream)
  (expect-status "attention backward" 0
                 (attention-backward (ffi-pointer runtime) kv-heads
                                     (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                     (ffi-pointer query-positions) (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer slopes) window
                                     (ffi-pointer upstream) (ffi-pointer output-a)
                                     (ffi-pointer output-b) (ffi-pointer output-c)))
  (vector (unpack-heads output-a query-heads)
          (unpack-heads output-b kv-heads)
          (unpack-heads output-c kv-heads)))

;; Canonical eshkol-mod5-v1 C1 parameter roster
(define wk 0)
(define wo 1)
(define wq 2)
(define wv 3)
(define wdown 4)
(define wgate 5)
(define wup 6)
(define gamma1 7)
(define gamma2 8)
(define whead 9)
(define gamma-final 10)
(define wembedding 11)
(define parameters 12)
(define roster
  '((("blocks" "0" "attention" "key" "weight") (8 16))
    (("blocks" "0" "attention" "output" "weight") (16 16))
    (("blocks" "0" "attention" "query" "weight") (16 16))
    (("blocks" "0" "attention" "value" "weight") (8 16))
    (("blocks" "0" "ffn" "down" "weight") (16 32))
    (("blocks" "0" "ffn" "gate" "weight") (32 16))
    (("blocks" "0" "ffn" "up" "weight") (32 16))
    (("blocks" "0" "norm1" "weight") (16))
    (("blocks" "0" "norm2" "weight") (16))
    (("head" "weight") (16 16))
    (("norm_final" "weight") (16))
    (("token_embedding" "weight") (16 16))))
(define layout 'dense-row-major-contiguous)
(define policy (c1-persistence-policy-internal 65536 16384 32768 16 'cpu))

(define (check-data condition message)
  (unless condition
    (transformer-error-raise 'corrupt-data 'eval5-mod5 message '() #f)))

;; Trusted D1 corpus validator and reader
(define corpus-identity "eval5-mod5-token-v1")
(define corpus-limit 2048)

(define (corpus-read-exact path maximum operation)
  (let ((size (file-size path)))
    (check-data (and (integer? size) (<= 0 size) (<= size maximum))
                "D1 file exceeds fixture limits")
    (let ((bytes (make-bytevector size 0)))
      (check-data (= 0 (t1-native-read-exact path bytes size maximum))
                  "D1 checked read failed")
      bytes)))

(define (read-d1-tokens directory)
  (let* ((metadata ((vector-ref d1-compiled-public-operations 8)
                    corpus-read-exact directory corpus-limit corpus-limit split-tokens))
         (manifest (vector-ref metadata 6)))
    (check-data (and (= (vector-ref metadata 0) 1)
                     (= (vector-ref metadata 1) split-tokens)
                     (= (vector-ref metadata 2) vocab)
                     (string=? (vector-ref metadata 4) corpus-identity))
                "unexpected D1 corpus identity or shape")
    (let* ((record (c1-read-u32 manifest 12))
           (shard ((vector-ref d1-compiled-public-operations 9)
                   corpus-read-exact (string-append directory "/shard-0000000000000000.ets")
                   0 split-tokens (c1-read-u64 manifest (+ record 16))
                   (bytevector-copy manifest (+ record 24) (+ record 56))
                   corpus-identity vocab corpus-limit))
           (offset (c1-read-u32 shard 12))
           (all (make-vector split-tokens 0)))
      (do ((i 0 (+ i 1)))
          ((= i split-tokens) all)
        (vector-set! all i (c1-read-u64 shard (+ offset (* i 8))))))))

(define (doc-slice all doc-idx)
  (let ((doc (make-vector doc-tokens 0))
        (base (* doc-idx doc-tokens)))
    (do ((i 0 (+ i 1)))
        ((= i doc-tokens) doc)
      (vector-set! doc i (vector-ref all (+ base i))))))

(define (doc->one-hot doc)
  (let ((input (zeros (list tokens vocab)))
        (target (zeros (list tokens vocab))))
    (do ((t 0 (+ t 1)))
        ((= t tokens) (vector input target))
      (tensor-set! input t (vector-ref doc t) 1.0)
      (tensor-set! target t (vector-ref doc (+ t 1)) 1.0))))

(define (tokens->one-hot-input vec)
  (let ((input (zeros (list tokens vocab))))
    (do ((t 0 (+ t 1)))
        ((= t tokens) input)
      (tensor-set! input t (vector-ref vec t) 1.0))))

(define (project x weight) (matmul x (transpose weight)))
(define (project-dx weight dy) (matmul dy weight))
(define (project-dw x dy) (matmul (transpose dy) x))
(define inverse-tokens (/ 1.0 tokens))
(define vocabulary-row (ones (list 1 vocab)))

(define (cross-entropy logits target)
  (let* ((maxima (reshape (tensor-max logits 1) (list tokens 1)))
         (shifted (tensor-sub logits (matmul maxima vocabulary-row)))
         (exponentials (tensor-exp shifted))
         (sums (reshape (tensor-sum exponentials 1) (list tokens 1)))
         (loss (* inverse-tokens
                  (- (tensor-sum (tensor-log sums))
                     (tensor-sum (tensor-mul shifted target))))))
    (vector loss exponentials sums)))

(define (decoder-forward-logits weights input)
  (let* ((embedding (vector-ref weights wembedding))
         (head (vector-ref weights whead))
         (q-weight (vector-ref weights wq))
         (k-weight (vector-ref weights wk))
         (v-weight (vector-ref weights wv))
         (o-weight (vector-ref weights wo))
         (gate-weight (vector-ref weights wgate))
         (up-weight (vector-ref weights wup))
         (down-weight (vector-ref weights wdown))
         (gamma-a (vector-ref weights gamma1))
         (gamma-b (vector-ref weights gamma2))
         (gamma-c (vector-ref weights gamma-final))
         (x (matmul input embedding))
         (norm-a (rms x gamma-a))
         (q (project norm-a q-weight))
         (k (project norm-a k-weight))
         (v (project norm-a v-weight))
         (attention (attend q k v))
         (residual (tensor-add x (project attention o-weight)))
         (norm-b (rms residual gamma-b))
         (gate (project norm-b gate-weight))
         (up (project norm-b up-weight))
         (gated (glu gate up))
         (block (tensor-add residual (project gated down-weight)))
         (norm-c (rms block gamma-c)))
    (project norm-c head)))

(define (decoder weights input target gradients)
  (let* ((embedding (vector-ref weights wembedding))
         (head (vector-ref weights whead))
         (q-weight (vector-ref weights wq))
         (k-weight (vector-ref weights wk))
         (v-weight (vector-ref weights wv))
         (o-weight (vector-ref weights wo))
         (gate-weight (vector-ref weights wgate))
         (up-weight (vector-ref weights wup))
         (down-weight (vector-ref weights wdown))
         (gamma-a (vector-ref weights gamma1))
         (gamma-b (vector-ref weights gamma2))
         (gamma-c (vector-ref weights gamma-final))
         (x (matmul input embedding))
         (norm-a (rms x gamma-a))
         (q (project norm-a q-weight))
         (k (project norm-a k-weight))
         (v (project norm-a v-weight))
         (attention (attend q k v))
         (residual (tensor-add x (project attention o-weight)))
         (norm-b (rms residual gamma-b))
         (gate (project norm-b gate-weight))
         (up (project norm-b up-weight))
         (gated (glu gate up))
         (block (tensor-add residual (project gated down-weight)))
         (norm-c (rms block gamma-c))
         (logits (project norm-c head))
         (ce (cross-entropy logits target)))
    (when gradients
      (let* ((probabilities (tensor-div (vector-ref ce 1)
                               (matmul (vector-ref ce 2) vocabulary-row)))
             (dlogits (tensor-scale (tensor-sub probabilities target) inverse-tokens))
             (drms-c (rms-grad block gamma-c (project-dx head dlogits)))
             (dy (vector-ref drms-c 0))
             (dglu (glu-grad gate up (project-dx down-weight dy)))
             (dgate (vector-ref dglu 0))
             (dup (vector-ref dglu 1))
             (dnorm-b (tensor-add (project-dx gate-weight dgate) (project-dx up-weight dup)))
             (drms-b (rms-grad residual gamma-b dnorm-b))
             (dresidual (tensor-add dy (vector-ref drms-b 0)))
             (dqkv (attend-grad q k v (project-dx o-weight dresidual)))
             (dq (vector-ref dqkv 0))
             (dk (vector-ref dqkv 1))
             (dv (vector-ref dqkv 2))
             (dnorm-a (tensor-add (tensor-add (project-dx q-weight dq) (project-dx k-weight dk))
                                  (project-dx v-weight dv)))
             (drms-a (rms-grad x gamma-a dnorm-a))
             (dx (tensor-add dresidual (vector-ref drms-a 0)))
             (dembedding (matmul (transpose input) dx))
             (dhead (project-dw norm-c dlogits)))
        (vector-set! gradients wk (project-dw norm-a dk))
        (vector-set! gradients wo (project-dw attention dresidual))
        (vector-set! gradients wq (project-dw norm-a dq))
        (vector-set! gradients wv (project-dw norm-a dv))
        (vector-set! gradients wdown (project-dw gated dy))
        (vector-set! gradients wgate (project-dw norm-b dgate))
        (vector-set! gradients wup (project-dw norm-b dup))
        (vector-set! gradients gamma1 (vector-ref drms-a 1))
        (vector-set! gradients gamma2 (vector-ref drms-b 1))
        (vector-set! gradients gamma-final (vector-ref drms-c 1))
        (vector-set! gradients whead dhead)
        (vector-set! gradients wembedding dembedding)))
    (vector (vector-ref ce 0) logits)))

(define (tensor-dimensions shape)
  (if (null? (cdr shape)) (list 1 (car shape)) shape))

(define (initial-weights)
  (let ((weights (make-vector parameters #f)))
    (do ((rows roster (cdr rows)) (p 0 (+ p 1)))
        ((null? rows) weights)
      (let* ((shape (cadr (car rows)))
             (dims (tensor-dimensions shape))
             (base (if (null? (cdr shape)) 1.0 0.0))
             (cols (cadr dims))
             (weight (zeros dims)))
        (do ((r 0 (+ r 1)))
            ((= r (car dims)))
          (do ((c 0 (+ c 1)))
              ((= c cols))
            (let* ((i (+ (* r cols) c))
                   (seed (- (modulo (+ (* 29 p) (* 11 i) (quotient i 5)) 37) 18)))
              (tensor-set! weight r c (+ base (* 0.0078125 seed))))))
        (vector-set! weights p weight)))))

(define (model-loss weights input target)
  (vector-ref (decoder weights input target #f) 0))

(define (check-gradients weights input target gradients)
  (do ((p 0 (+ p 1)))
      ((= p parameters))
    (let* ((weight (vector-ref weights p))
           (dims (tensor-shape weight))
           (gradient (vector-ref gradients p))
           (row 0)
           (col 0)
           (peak 0.0))
      (do ((r 0 (+ r 1)))
          ((= r (car dims)))
        (do ((c 0 (+ c 1)))
            ((= c (cadr dims)))
          (let ((magnitude (abs (tensor-get gradient r c))))
            (when (> magnitude peak)
              (set! row r)
              (set! col c)
              (set! peak magnitude)))))
      (require-check "inactive MOD5 parameter gradient" (> peak 0.0000001))
      (let ((step 0.001953125)
            (original (tensor-get weight row col))
            (analytic (tensor-get gradient row col)))
        (tensor-set! weight row col (+ original step))
        (let ((plus (model-loss weights input target)))
          (tensor-set! weight row col (- original step))
          (let ((numerical (/ (- plus (model-loss weights input target)) (* 2.0 step))))
            (tensor-set! weight row col original)
            (require-check "MOD5 decoder central difference failed"
                           (<= (abs (- analytic numerical))
                               (+ 0.000015 (* 0.005 (abs numerical)))))))))))

(define (quantize-weight weight)
  (let ((shape (tensor-shape weight)))
    (pack weight input-a)
    (unpack input-a (car shape) (cadr shape))))

(define (print-real format value)
  (let ((length (format-f64 (ffi-pointer input-a) 64 format value)))
    (require-check "failed to format real" (and (>= length 0) (< length 64)))
    (do ((i 0 (+ i 1))) ((= i length))
      (display (integer->char (volatile-load u8 (ptr-add input-a i)))))))

(define hex-digits "0123456789abcdef")

(define (print-hex-byte byte)
  (display (string-ref hex-digits (quotient byte 16)))
  (display (string-ref hex-digits (modulo byte 16))))

(define (print-hex-buf buf count)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (print-hex-byte (volatile-load u8 (ptr-add buf i)))))

(define (train-split batch0 batch1)
  (let* ((weights (initial-weights))
         (g0 (make-vector parameters #f))
         (g1 (make-vector parameters #f))
         (in0 (vector-ref batch0 0))
         (tg0 (vector-ref batch0 1))
         (in1 (vector-ref batch1 0))
         (tg1 (vector-ref batch1 1))
         (l0 (vector-ref (decoder weights in0 tg0 g0) 0))
         (l1 (vector-ref (decoder weights in1 tg1 g1) 0))
         (initial (* 0.5 (+ l0 l1))))
    (check-gradients weights in0 tg0 g0)
    (display "TRAIN_GRADIENTS 12") (newline)
    (let loop ((step 0) (loss initial))
      (display "TRAIN_LOSS ") (display step) (display " ")
      (print-real "%.17g" loss) (newline)
      (if (= step steps)
          (vector weights initial loss)
          (begin
            (do ((p 0 (+ p 1)))
                ((= p parameters))
              (let ((delta (tensor-scale (tensor-add (vector-ref g0 p) (vector-ref g1 p)) 0.5)))
                (require-check "nonfinite MOD5 decoder gradient"
                               (< (tensor-sum (tensor-abs delta)) 1.0e300))
                (vector-set! weights p
                  (quantize-weight (tensor-sub (vector-ref weights p)
                                               (tensor-scale delta learning-rate))))))
            (let* ((c0 (vector-ref (decoder weights in0 tg0 g0) 0))
                   (c1 (vector-ref (decoder weights in1 tg1 g1) 0))
                   (current (* 0.5 (+ c0 c1))))
              (require-check "MOD5 decoder loss failed to decrease"
                             (and (>= current 0.0) (< current loss)))
              (loop (+ step 1) current)))))))

;; C1 eshkol-mod5-v1 checkpoint save / load
(define (buffer->bytes buffer count)
  (let ((bytes (make-bytevector count 0)))
    (do ((i 0 (+ i 1)))
        ((= i count) bytes)
      (bytevector-u8-set! bytes i (volatile-load u8 (ptr-add buffer i))))))

(define (tensor->f32-bytes tensor)
  (pack tensor input-a)
  (buffer->bytes input-a (* 4 (tensor-length tensor))))

(define (f32-bytes->tensor bytes shape)
  (do ((i 0 (+ i 1)))
      ((= i (bytevector-length bytes)))
    (volatile-store! u8 (ptr-add input-a i) (bytevector-u8-ref bytes i)))
  (let ((dims (tensor-dimensions shape)))
    (unpack input-a (car dims) (cadr dims))))

(define (adopt-weights weights)
  (let ((ownership (vector '())))
    (guard (caught
             (#t
               (let release-owners ((remaining (vector-ref ownership 0)))
                 (unless (null? remaining)
                   (tensor-provider-release-owned-internal!
                     i2-provider-name 2 0 (car remaining))
                   (release-owners (cdr remaining))))
               (raise caught)))
      (let build ((rows roster) (records '()) (p 0))
        (if (null? rows)
            (begin
              (vector-set! ownership 0 (i2-reverse (vector-ref ownership 0)))
              (state-dict-adopt-owned-internal!
                (i2-reverse records) '()
                i2-provider-name 2 0 ownership))
            (let* ((path (car (car rows)))
                   (shape (cadr (car rows)))
                   (request (vector (tensor->f32-bytes (vector-ref weights p))
                                    'parameter shape 'f32 'cpu layout 'eval5-mod5 #f))
                   (envelope (vector #f 'parameter 'eval5-mod5 #f))
                   (next-owned (cons envelope (vector-ref ownership 0))))
              (i2-checkpoint-decode request)
              (let ((carrier (vector-ref request 7)))
                (vector-set! envelope 0 carrier)
                (vector-set! ownership 0 next-owned)
                (build (cdr rows)
                  (cons (vector path 'parameter shape 'f32 'cpu layout carrier) records)
                  (+ p 1)))))))))

(define (save-weights weights path)
  (let ((state (adopt-weights weights)))
    (guard (caught (#t (state-dict-release! state) (raise caught)))
      (c1-checkpoint-save-state-internal! state path policy i2-checkpoint-codec-internal #f))
    (state-dict-release! state)))

(define (state-payload state path shape)
  (let* ((handle (state-dict-tensor state path))
         (carrier (state-dict-tensor-borrow-begin-internal state handle))
         (bytes (guard (caught (#t (state-dict-tensor-borrow-end-internal state handle)
                                  (raise caught)))
                  (i2-checkpoint-encode
                    (vector carrier 'parameter shape 'f32 'cpu layout 'eval5-mod5)))))
    (state-dict-tensor-borrow-end-internal state handle)
    bytes))

(define (decode-weights state)
  (let ((weights (make-vector parameters #f))
        (aliases (state-dict-alias-groups state)))
    (check-data (equal? (state-dict-paths state) (map car roster))
                "unexpected MOD5 parameter roster")
    (check-data (null? aliases)
                "unexpected MOD5 alias topology")
    (do ((rows roster (cdr rows))
         (entries (state-dict-entries-internal state) (cdr entries))
         (p 0 (+ p 1)))
        ((null? rows) weights)
      (let* ((path (car (car rows)))
             (shape (cadr (car rows)))
             (entry (car entries)))
        (check-data (and (equal? path (state-entry-path-internal entry))
                         (eq? 'parameter (state-entry-kind-internal entry))
                         (equal? shape (state-entry-shape-internal entry))
                         (eq? 'f32 (state-entry-dtype-internal entry))
                         (eq? 'cpu (state-entry-device-internal entry))
                         (eq? layout (state-entry-layout-internal entry)))
                    "unexpected MOD5 parameter metadata")
        (let ((weight (f32-bytes->tensor (state-payload state path shape) shape)))
          (check-data (< (tensor-sum (tensor-abs weight)) 1.0e300)
                      "nonfinite MOD5 parameter")
          (vector-set! weights p weight))))))

(define (load-weights path)
  (let* ((state (c1-checkpoint-load-state-internal
                  path policy i2-checkpoint-codec-internal i2-provider-name))
         (weights (guard (caught (#t (state-dict-release! state) (raise caught)))
                    (decode-weights state))))
    (state-dict-release! state)
    weights))

;; Populate EVAL5 corpus with 2 documents from a D1 token split.
;; Each 9-token document encodes 18 canonical ASCII hex bytes (2 bytes/token).
(define (populate-eval5-corpus corpus all-tokens)
  (let ((bytes-buf (checked-allocate (* doc-tokens 2)))
        (toks-buf (checked-allocate (* doc-tokens 4))))
    (do ((d 0 (+ d 1)))
        ((= d docs-per-split))
      (let ((base (* d doc-tokens)))
        (do ((i 0 (+ i 1)))
            ((= i doc-tokens))
          (let ((tok (vector-ref all-tokens (+ base i))))
            (expect-status "store doc u32" 0
                           (eval5-store-u32 (ffi-pointer toks-buf) doc-tokens i tok))
            (volatile-store! u8 (ptr-add bytes-buf (* 2 i))
                             (char->integer (string-ref hex-digits (quotient tok 16))))
            (volatile-store! u8 (ptr-add bytes-buf (+ (* 2 i) 1))
                             (char->integer (string-ref hex-digits (modulo tok 16))))))
        (expect-status "corpus add doc" 0
                       (eval5-corpus-add-doc (ffi-pointer corpus)
                                             (ffi-pointer bytes-buf) (* doc-tokens 2)
                                             (ffi-pointer toks-buf) doc-tokens))))
    (release toks-buf)
    (release bytes-buf)))

(define (compute-tokenizer-sha256 out-buf)
  (let* ((len (string-length corpus-identity))
         (tmp (checked-allocate len)))
    (do ((i 0 (+ i 1)))
        ((= i len))
      (volatile-store! u8 (ptr-add tmp i) (char->integer (string-ref corpus-identity i))))
    (expect-status "tokenizer sha256" 0
                   (eval5-sha256-bytes (ffi-pointer tmp) len (ffi-pointer out-buf)))
    (release tmp)))

(define (pack-logits-into tensor dst-buf row-offset)
  (do ((r 0 (+ r 1)))
      ((= r tokens))
    (do ((c 0 (+ c 1)))
        ((= c vocab))
      (expect-status "store lm logit" 0
                     (eval5-store-f32 (ffi-pointer dst-buf)
                                      (* docs-per-split tokens vocab)
                                      (+ (* (+ row-offset r) vocab) c)
                                      (tensor-get tensor r c))))))

(define (pack-suffix-choice-logits tensor dst-buf)
  ;; Copy last 2 rows (rows 6 and 7) of [8, 16] live MOD5 logits into [2, 16] f32 buf.
  (do ((r 0 (+ r 1)))
      ((= r 2))
    (do ((c 0 (+ c 1)))
        ((= c vocab))
      (expect-status "store mc logit" 0
                     (eval5-store-f32 (ffi-pointer dst-buf) (* 2 vocab)
                                      (+ (* r vocab) c)
                                      (tensor-get tensor (+ r 6) c))))))

(define (add-mc-choice-2tok mc logits-tensor t0 t1)
  (let ((lbuf (checked-allocate (* 4 2 vocab)))
        (tbuf (checked-allocate (* 4 2))))
    (pack-suffix-choice-logits logits-tensor lbuf)
    (expect-status "mc store t0" 0 (eval5-store-u32 (ffi-pointer tbuf) 2 0 t0))
    (expect-status "mc store t1" 0 (eval5-store-u32 (ffi-pointer tbuf) 2 1 t1))
    (expect-status "mc add choice" 0
                   (eval5-mc-add-choice (ffi-pointer mc) (ffi-pointer lbuf) (* 2 vocab)
                                        (ffi-pointer tbuf) 2 vocab))
    (release tbuf)
    (release lbuf)))

(define (print-metrics-tail total-nll mean-nll ppl bpb
                            mc-corr mc-tot mc-acc
                            eval-docs contam-docs matched-ngrams total-ngrams
                            manifest-sha)
  (display " total_nll=") (print-real "%.17g" total-nll)
  (display " mean_nll=") (print-real "%.17g" mean-nll)
  (display " ppl=") (print-real "%.17g" ppl)
  (display " bpb=") (print-real "%.17g" bpb)
  (display " mc_correct=") (display mc-corr)
  (display " mc_total=") (display mc-tot)
  (display " mc_acc=") (print-real "%.17g" mc-acc)
  (display " eval_docs=") (display eval-docs)
  (display " contaminated_docs=") (display contam-docs)
  (display " matched_ngrams=") (display matched-ngrams)
  (display " total_ngrams=") (display total-ngrams)
  (display " manifest_sha256=") (print-hex-buf manifest-sha 32)
  (newline))

(define (cmd-write-corpora root)
  (et-d1-private-token-corpus-write
    (string-append root "/train") corpus-identity vocab split-tokens
    '(1 4 1 5 9 2 6 5 3
      2 7 1 8 2 8 1 8 2))
  (et-d1-private-token-corpus-write
    (string-append root "/eval-clean") corpus-identity vocab split-tokens
    '(0 3 10 11 12 13 14 15 0
      15 14 13 12 11 10 3 0 15))
  (et-d1-private-token-corpus-write
    (string-append root "/eval-exact") corpus-identity vocab split-tokens
    '(1 4 1 5 9 2 6 5 3
      15 14 13 12 11 10 3 0 15))
  (et-d1-private-token-corpus-write
    (string-append root "/eval-ngram") corpus-identity vocab split-tokens
    '(0 3 10 1 5 9 2 6 14
      15 14 13 12 11 10 3 0 15))
  (et-d1-private-token-corpus-write
    (string-append root "/eval-both") corpus-identity vocab split-tokens
    '(1 4 1 5 9 2 6 5 3
      0 3 10 1 5 9 2 6 14))
  (display "CORPORA_WRITTEN 5") (newline)
  0)

(define (cmd-train-save train-dir ckpt-path)
  (let* ((train-tokens (read-d1-tokens train-dir))
         (batch0 (doc->one-hot (doc-slice train-tokens 0)))
         (batch1 (doc->one-hot (doc-slice train-tokens 1)))
         (trained (train-split batch0 batch1))
         (weights (vector-ref trained 0))
         (init-loss (vector-ref trained 1))
         (final-loss (vector-ref trained 2))
         (ckpt-sha (checked-allocate 32)))
    (save-weights weights ckpt-path)
    (expect-status "ckpt sha256" 0
                   (eval5-sha256-file ckpt-path (ffi-pointer ckpt-sha)))
    (display "TRAIN_DONE steps=") (display steps)
    (display " initial_loss=") (print-real "%.17g" init-loss)
    (display " final_loss=") (print-real "%.17g" final-loss)
    (display " ckpt_sha256=") (print-hex-buf ckpt-sha 32)
    (newline)
    (release ckpt-sha)
    0))

(define (cmd-eval train-dir eval-dir ckpt-path manifest-path)
  (let* ((weights (load-weights ckpt-path))
         (train-tokens (read-d1-tokens train-dir))
         (eval-tokens (read-d1-tokens eval-dir))
         (train-cell (checked-allocate 8))
         (eval-cell (checked-allocate 8))
         (manifest-cell (checked-allocate 8))
         (indices-buf (checked-allocate (* 8 docs-per-split)))
         (summary-buf (checked-allocate (* 8 6)))
         (rate-buf (checked-allocate 8))
         (train-sha (checked-allocate 32))
         (eval-sha (checked-allocate 32))
         (tok-sha (checked-allocate 32))
         (ckpt-sha (checked-allocate 32)))
    (expect-status "train corpus create" 0 (eval5-corpus-create (ffi-pointer train-cell)))
    (expect-status "eval corpus create" 0 (eval5-corpus-create (ffi-pointer eval-cell)))
    (expect-status "manifest create" 0 (eval5-manifest-create (ffi-pointer manifest-cell)))
    (let ((train-corpus (volatile-load ptr train-cell))
          (eval-corpus (volatile-load ptr eval-cell))
          (manifest (volatile-load ptr manifest-cell)))
      (release train-cell)
      (release eval-cell)
      (release manifest-cell)
      (populate-eval5-corpus train-corpus train-tokens)
      (populate-eval5-corpus eval-corpus eval-tokens)
      (expect-status "train shard sha256" 0
                     (eval5-sha256-file (string-append train-dir "/shard-0000000000000000.ets")
                                        (ffi-pointer train-sha)))
      (expect-status "eval shard sha256" 0
                     (eval5-sha256-file (string-append eval-dir "/shard-0000000000000000.ets")
                                        (ffi-pointer eval-sha)))
      (compute-tokenizer-sha256 tok-sha)
      (expect-status "ckpt sha256" 0
                     (eval5-sha256-file ckpt-path (ffi-pointer ckpt-sha)))
      (expect-status "manifest identity" 0
                     (eval5-manifest-set-identity (ffi-pointer manifest)
                                                  "eval5-mod5-live" "lm-mc-heldout"
                                                  "clean.v1" tokens 0))
      (expect-status "manifest digests" 0
                     (eval5-manifest-set-digests (ffi-pointer manifest)
                                                 (ffi-pointer train-sha)
                                                 (ffi-pointer eval-sha)
                                                 (ffi-pointer tok-sha)
                                                 (ffi-pointer ckpt-sha)))
      (let* ((audit-status (eval5-audit (ffi-pointer train-corpus)
                                        (ffi-pointer eval-corpus)
                                        eval5-ngram-tokens eval5-ngram-order
                                        eval5-forbid-exact eval5-min-overlap
                                        eval5-max-rate
                                        (ffi-pointer indices-buf) docs-per-split
                                        (ffi-pointer summary-buf) (ffi-pointer rate-buf)))
             (rate (eval5-load-f64 (ffi-pointer rate-buf) 1 0))
             (eval-docs (eval5-load-i64 (ffi-pointer summary-buf) 6 0))
             (contam-docs (eval5-load-i64 (ffi-pointer summary-buf) 6 1))
             (exact-matches (eval5-load-i64 (ffi-pointer summary-buf) 6 2))
             (ngram-docs (eval5-load-i64 (ffi-pointer summary-buf) 6 3))
             (total-ngrams (eval5-load-i64 (ffi-pointer summary-buf) 6 4))
             (matched-ngrams (eval5-load-i64 (ffi-pointer summary-buf) 6 5)))
        (expect-status "manifest set audit" 0
                       (eval5-manifest-set-audit (ffi-pointer manifest)
                                                 eval5-ngram-tokens eval5-ngram-order
                                                 eval5-forbid-exact eval5-min-overlap
                                                 eval5-max-rate
                                                 (ffi-pointer summary-buf) rate))
        (if (= audit-status eval5-err-contaminated)
            ;; Fail closed: verify manifest publication is also rejected and exit 7.
            (let ((dummy-lm (checked-allocate (* 8 4)))
                  (dummy-logits (checked-allocate (* 4 vocab)))
                  (dummy-target (checked-allocate 4)))
              (do ((c 0 (+ c 1))) ((= c vocab))
                (expect-status "dummy logit" 0
                               (eval5-store-f32 (ffi-pointer dummy-logits) vocab c 0.0)))
              (expect-status "dummy target" 0
                             (eval5-store-u32 (ffi-pointer dummy-target) 1 0 0))
              (expect-status "dummy score" 0
                             (eval5-score-lm (ffi-pointer dummy-logits) vocab
                                             (ffi-pointer dummy-target) 1 vocab 2
                                             (ffi-pointer dummy-lm)))
              (expect-status "manifest set dummy lm" 0
                             (eval5-manifest-set-lm (ffi-pointer manifest) 1 2
                                                    (ffi-pointer dummy-lm)))
              (let ((verify-status (eval5-manifest-verify-clean (ffi-pointer manifest)))
                    (write-status (eval5-manifest-write-atomic manifest-path (ffi-pointer manifest))))
                (expect-status "contaminated verify must reject" eval5-err-contaminated verify-status)
                (expect-status "contaminated write must reject" eval5-err-contaminated write-status)
                (display "CONTAMINATED_REJECTED eval_docs=") (display eval-docs)
                (display " contaminated_docs=") (display contam-docs)
                (display " exact_matches=") (display exact-matches)
                (display " ngram_docs=") (display ngram-docs)
                (display " total_ngrams=") (display total-ngrams)
                (display " matched_ngrams=") (display matched-ngrams)
                (display " rate=") (print-real "%.17g" rate)
                (display " write_status=") (display write-status)
                (newline)
                (release dummy-target)
                (release dummy-logits)
                (release dummy-lm)
                (eval5-manifest-destroy (ffi-pointer manifest))
                (eval5-corpus-destroy (ffi-pointer eval-corpus))
                (eval5-corpus-destroy (ffi-pointer train-corpus))
                (release ckpt-sha) (release tok-sha) (release eval-sha) (release train-sha)
                (release rate-buf) (release summary-buf) (release indices-buf)
                7))
            (begin
              (expect-status "clean audit status" 0 audit-status)
              ;; Live MOD5 forward passes on clean held-out D1 documents
              (let* ((doc0 (doc-slice eval-tokens 0))
                     (doc1 (doc-slice eval-tokens 1))
                     (b0 (doc->one-hot doc0))
                     (b1 (doc->one-hot doc1))
                     (logits0 (decoder-forward-logits weights (vector-ref b0 0)))
                     (logits1 (decoder-forward-logits weights (vector-ref b1 0)))
                     (lm-tokens (* docs-per-split tokens))
                     (lm-bytes (* lm-tokens 2))
                     (lm-logits (checked-allocate (* 4 lm-tokens vocab)))
                     (lm-targets (checked-allocate (* 4 lm-tokens)))
                     (lm-metrics (checked-allocate (* 8 4)))
                     (mc-cell (checked-allocate 8))
                     (mc-corr-buf (checked-allocate 8))
                     (mc-tot-buf (checked-allocate 8))
                     (mc-acc-buf (checked-allocate 8))
                     (reloaded-cell (checked-allocate 8))
                     (r-counts (checked-allocate (* 8 12)))
                     (r-metrics (checked-allocate (* 8 6)))
                     (r-sha (checked-allocate 32)))
                (pack-logits-into logits0 lm-logits 0)
                (pack-logits-into logits1 lm-logits tokens)
                (do ((t 0 (+ t 1))) ((= t tokens))
                  (expect-status "lm target 0" 0
                                 (eval5-store-u32 (ffi-pointer lm-targets) lm-tokens t
                                                  (vector-ref doc0 (+ t 1))))
                  (expect-status "lm target 1" 0
                                 (eval5-store-u32 (ffi-pointer lm-targets) lm-tokens (+ tokens t)
                                                  (vector-ref doc1 (+ t 1)))))
                (expect-status "score lm" 0
                               (eval5-score-lm (ffi-pointer lm-logits) (* lm-tokens vocab)
                                               (ffi-pointer lm-targets) lm-tokens vocab lm-bytes
                                               (ffi-pointer lm-metrics)))
                ;; Live MOD5 MC batch (4 items x 2 choices, length-normalized)
                (expect-status "mc create" 0 (eval5-mc-create (ffi-pointer mc-cell)))
                (let ((mc (volatile-load ptr mc-cell)))
                  (release mc-cell)
                  ;; Item 0: Eval doc 0 suffix (true: 15,0 vs distractor: 1,4)
                  (expect-status "mc item 0" 0 (eval5-mc-begin-item (ffi-pointer mc) 0))
                  (add-mc-choice-2tok mc logits0 (vector-ref doc0 7) (vector-ref doc0 8))
                  (add-mc-choice-2tok mc logits0 1 4)
                  ;; Item 1: Eval doc 1 suffix (distractor: 4,1 vs true: 0,15)
                  (expect-status "mc item 1" 0 (eval5-mc-begin-item (ffi-pointer mc) 1))
                  (add-mc-choice-2tok mc logits1 4 1)
                  (add-mc-choice-2tok mc logits1 (vector-ref doc1 7) (vector-ref doc1 8))
                  ;; Item 2: Live MOD5 forward on two distinct clean held-out contexts
                  (let* ((ctx2a (decoder-forward-logits weights
                                  (tokens->one-hot-input #(10 11 12 13 14 15 0 3))))
                         (ctx2b (decoder-forward-logits weights
                                  (tokens->one-hot-input #(3 0 15 14 13 12 11 10)))))
                    (expect-status "mc item 2" 0 (eval5-mc-begin-item (ffi-pointer mc) 0))
                    (add-mc-choice-2tok mc ctx2a 10 11)
                    (add-mc-choice-2tok mc ctx2b 12 13)
                    ;; Item 3: Live MOD5 forward on two distinct clean contexts
                    (expect-status "mc item 3" 0 (eval5-mc-begin-item (ffi-pointer mc) 1))
                    (add-mc-choice-2tok mc ctx2b 14 15)
                    (add-mc-choice-2tok mc ctx2a 3 0))
                  (expect-status "score mc" 0
                                 (eval5-score-mc (ffi-pointer mc) 1
                                                 (ffi-pointer mc-corr-buf)
                                                 (ffi-pointer mc-tot-buf)
                                                 (ffi-pointer mc-acc-buf)))
                  (eval5-mc-destroy (ffi-pointer mc)))
                (let ((mc-corr (eval5-load-i64 (ffi-pointer mc-corr-buf) 1 0))
                      (mc-tot (eval5-load-i64 (ffi-pointer mc-tot-buf) 1 0))
                      (mc-acc (eval5-load-f64 (ffi-pointer mc-acc-buf) 1 0)))
                  (expect-status "manifest set lm" 0
                                 (eval5-manifest-set-lm (ffi-pointer manifest)
                                                        lm-tokens lm-bytes
                                                        (ffi-pointer lm-metrics)))
                  (expect-status "manifest set mc" 0
                                 (eval5-manifest-set-mc (ffi-pointer manifest) 1
                                                        mc-corr mc-tot mc-acc))
                  (expect-status "manifest verify clean" 0
                                 (eval5-manifest-verify-clean (ffi-pointer manifest)))
                  (expect-status "manifest write atomic" 0
                                 (eval5-manifest-write-atomic manifest-path (ffi-pointer manifest)))
                  (expect-status "manifest reloaded create" 0
                                 (eval5-manifest-create (ffi-pointer reloaded-cell)))
                  (let ((reloaded (volatile-load ptr reloaded-cell)))
                    (release reloaded-cell)
                    (expect-status "manifest self-read" 0
                                   (eval5-manifest-read-file manifest-path (ffi-pointer reloaded)))
                    (expect-status "manifest get metrics" 0
                                   (eval5-manifest-get-metrics (ffi-pointer reloaded)
                                                               (ffi-pointer r-counts)
                                                               (ffi-pointer r-metrics)
                                                               (ffi-pointer r-sha)))
                    (display "EVAL_CLEAN")
                    (print-metrics-tail
                      (eval5-load-f64 (ffi-pointer r-metrics) 6 0)
                      (eval5-load-f64 (ffi-pointer r-metrics) 6 1)
                      (eval5-load-f64 (ffi-pointer r-metrics) 6 2)
                      (eval5-load-f64 (ffi-pointer r-metrics) 6 3)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 4)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 5)
                      (eval5-load-f64 (ffi-pointer r-metrics) 6 4)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 6)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 7)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 11)
                      (eval5-load-i64 (ffi-pointer r-counts) 12 10)
                      r-sha)
                    (eval5-manifest-destroy (ffi-pointer reloaded))))
                (release r-sha) (release r-metrics) (release r-counts)
                (release mc-acc-buf) (release mc-tot-buf) (release mc-corr-buf)
                (release lm-metrics) (release lm-targets) (release lm-logits)
                (eval5-manifest-destroy (ffi-pointer manifest))
                (eval5-corpus-destroy (ffi-pointer eval-corpus))
                (eval5-corpus-destroy (ffi-pointer train-corpus))
                (release ckpt-sha) (release tok-sha) (release eval-sha) (release train-sha)
                (release rate-buf) (release summary-buf) (release indices-buf)
                0)))))))

(define (check-digest-eq label actual expected eq-buf)
  (expect-status label 0
                 (eval5-bytes-equal (ffi-pointer actual) (ffi-pointer expected) 32
                                    (ffi-pointer eq-buf)))
  (require-check label (= 1 (volatile-load i32 eq-buf))))

(define (cmd-verify-manifest manifest-path train-dir eval-dir ckpt-path)
  (let* ((m-cell (checked-allocate 8))
         (r-counts (checked-allocate (* 8 12)))
         (r-metrics (checked-allocate (* 8 6)))
         (r-sha (checked-allocate 32))
         (m-tr (checked-allocate 32))
         (m-ev (checked-allocate 32))
         (m-tok (checked-allocate 32))
         (m-ck (checked-allocate 32))
         (e-tr (checked-allocate 32))
         (e-ev (checked-allocate 32))
         (e-tok (checked-allocate 32))
         (e-ck (checked-allocate 32))
         (eq-buf (checked-allocate 4)))
    (expect-status "verify manifest create" 0 (eval5-manifest-create (ffi-pointer m-cell)))
    (let* ((manifest (volatile-load ptr m-cell))
           (read-status (begin (release m-cell)
                               (eval5-manifest-read-file manifest-path (ffi-pointer manifest)))))
      (if (not (= read-status 0))
          (begin
            (display "MANIFEST_REJECTED status=") (display read-status) (newline)
            (eval5-manifest-destroy (ffi-pointer manifest))
            (release eq-buf)
            (release e-ck) (release e-tok) (release e-ev) (release e-tr)
            (release m-ck) (release m-tok) (release m-ev) (release m-tr)
            (release r-sha) (release r-metrics) (release r-counts)
            9)
          (begin
            (expect-status "reloaded manifest verify clean" 0
                           (eval5-manifest-verify-clean (ffi-pointer manifest)))
            (expect-status "reloaded manifest get metrics" 0
                           (eval5-manifest-get-metrics (ffi-pointer manifest)
                                                       (ffi-pointer r-counts)
                                                       (ffi-pointer r-metrics)
                                                       (ffi-pointer r-sha)))
            (expect-status "reloaded manifest get digests" 0
                           (eval5-manifest-get-digests (ffi-pointer manifest)
                                                       (ffi-pointer m-tr)
                                                       (ffi-pointer m-ev)
                                                       (ffi-pointer m-tok)
                                                       (ffi-pointer m-ck)))
            (expect-status "expected train sha256" 0
                           (eval5-sha256-file (string-append train-dir "/shard-0000000000000000.ets")
                                              (ffi-pointer e-tr)))
            (expect-status "expected eval sha256" 0
                           (eval5-sha256-file (string-append eval-dir "/shard-0000000000000000.ets")
                                              (ffi-pointer e-ev)))
            (compute-tokenizer-sha256 e-tok)
            (expect-status "expected ckpt sha256" 0
                           (eval5-sha256-file ckpt-path (ffi-pointer e-ck)))
            (check-digest-eq "train digest mismatch" m-tr e-tr eq-buf)
            (check-digest-eq "eval digest mismatch" m-ev e-ev eq-buf)
            (check-digest-eq "tokenizer digest mismatch" m-tok e-tok eq-buf)
            (check-digest-eq "checkpoint digest mismatch" m-ck e-ck eq-buf)
            (display "MANIFEST_VERIFIED")
            (print-metrics-tail
              (eval5-load-f64 (ffi-pointer r-metrics) 6 0)
              (eval5-load-f64 (ffi-pointer r-metrics) 6 1)
              (eval5-load-f64 (ffi-pointer r-metrics) 6 2)
              (eval5-load-f64 (ffi-pointer r-metrics) 6 3)
              (eval5-load-i64 (ffi-pointer r-counts) 12 4)
              (eval5-load-i64 (ffi-pointer r-counts) 12 5)
              (eval5-load-f64 (ffi-pointer r-metrics) 6 4)
              (eval5-load-i64 (ffi-pointer r-counts) 12 6)
              (eval5-load-i64 (ffi-pointer r-counts) 12 7)
              (eval5-load-i64 (ffi-pointer r-counts) 12 11)
              (eval5-load-i64 (ffi-pointer r-counts) 12 10)
              r-sha)
            (eval5-manifest-destroy (ffi-pointer manifest))
            (release eq-buf)
            (release e-ck) (release e-tok) (release e-ev) (release e-tr)
            (release m-ck) (release m-tok) (release m-ev) (release m-tr)
            (release r-sha) (release r-metrics) (release r-counts)
            0)))))

(define (close-workspace)
  (close-mod5 (ffi-pointer runtime))
  (release workspace)
  (release query-positions)
  (release key-positions)
  (release keep-mask)
  (release slopes)
  (release epsilon-buffer))

(define (arg-at args n)
  (if (= n 0) (car args) (arg-at (cdr args) (- n 1))))

(define (eval5-runner-main arguments)
  (let ((argc (c1-list-length-bounded arguments 8)))
    (guard (caught
             (#t
               (close-workspace)
               (display "EVAL5 MOD5 RUNNER ERROR ")
               (if (transformer-error? caught)
                   (begin (display (transformer-error-category caught))
                          (display " ")
                          (display (transformer-error-message caught)))
                   (write caught))
               (newline)
               2))
      (let ((rc
             (cond
               ((and argc (= argc 4)
                     (string=? (arg-at arguments 1) "--mode")
                     (string=? (arg-at arguments 2) "write-corpora"))
                (cmd-write-corpora (arg-at arguments 3)))
               ((and argc (= argc 5)
                     (string=? (arg-at arguments 1) "--mode")
                     (string=? (arg-at arguments 2) "train-save"))
                (cmd-train-save (arg-at arguments 3) (arg-at arguments 4)))
               ((and argc (= argc 7)
                     (string=? (arg-at arguments 1) "--mode")
                     (string=? (arg-at arguments 2) "eval"))
                (cmd-eval (arg-at arguments 3) (arg-at arguments 4)
                          (arg-at arguments 5) (arg-at arguments 6)))
               ((and argc (= argc 7)
                     (string=? (arg-at arguments 1) "--mode")
                     (string=? (arg-at arguments 2) "verify-manifest"))
                (cmd-verify-manifest (arg-at arguments 3) (arg-at arguments 4)
                                     (arg-at arguments 5) (arg-at arguments 6)))
               (else
                (display "Usage: eval5-mod5-runner --mode write-corpora <root> | train-save <train_dir> <out.etcp> | eval <train_dir> <eval_dir> <ckpt.etcp> <out.manifest> | verify-manifest <manifest> <train_dir> <eval_dir> <ckpt.etcp>")
                (newline)
                2))))
        (close-workspace)
        rc))))

(let ((rc (eval5-runner-main (command-line))))
  (cond
    ((= rc 0) (exit 0))
    ((= rc 7) (exit 7))
    ((= rc 9) (exit 9))
    (else (exit 2))))
