;;; Test-only, one-root aggregate fixture. Never install or load beside the
;;; installed public package: that would create a second issuer universe.
(load "g3g_manual_package_root.esk")

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "private P2/G2 history FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label
    (guard (caught (#t (transformer-error? caught)))
      (thunk) #f)))
(define (config eos)
  (list ':profile 'diagnostic-c4-p2g2 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256
        ':top-p-bits 1065353216 ':max-new-tokens 2
        ':eos eos ':seed 41))

(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-public-model-create-seeded 1729))
(define original-t1
  (t1-wave1-tokenizer-encode tokenizer (bytevector 0 255)))
(define input (g3c4-public-generation-input-create original-t1))
(define foreign-input
  (g3c4-public-generation-input-create
    (t1-wave1-tokenizer-encode tokenizer (bytevector 7 11))))
(define (first-id)
  (let ((probe (g3g-public-generator-create model tokenizer (config 0)))
        (selected -1))
    (g3c4-with-p2g2-prefix-call 'private-history-first-reference
      probe input (call)
      (g3c4-p2g2-protected-reserve call)
      (set! selected (g3c4-p2g2-prefix-commit! call input))
      (g3c4-p2g2-protected-abort! call))
    (check "genuine first ID is V256"
           (and (<= 0 selected) (<= selected 255)))
    (check "probe closes" (g3g-public-generator-close probe))
    selected))
(define selected-first (first-id))
(define non-eos (if (= selected-first 255) 0 255))
(define snapshot-provider g3c4-p2g2-terminal-snapshot-private)

(define (run-case eos expected-count fault-mode)
  (let* ((generator
           (g3g-public-generator-create model tokenizer (config eos)))
         (output (g3g-public-generator-generate generator input))
         (before (snapshot-provider output))
         (history #f)
         (source (g3c4-public-g2-output-live output 'history-test))
         (ticket (g3c4-public-g2-output-unique
                   g3c4-public-g2-tickets 5 output 'history-test))
         (foreign-generator
           (g3g-public-generator-create model tokenizer (config eos)))
         (foreign-output
           (g3g-public-generator-generate foreign-generator input))
         (descriptor #f))
    (check "exact generation count and cache"
           (and (= (vector-ref before 2) expected-count)
                (= (vector-ref before 3) (+ expected-count 2))
                (= (vector-ref before 0) selected-first)))
    (if (= expected-count 1)
        (check "G1 EOS has no G2" (= (vector-ref before 1) 0))
        (check "non-EOS has two valid IDs"
               (and (<= 0 (vector-ref before 1))
                    (<= (vector-ref before 1) 255))))
    (reject "wrong live input cannot capture genuine output"
      (lambda ()
        (g3c4-public-p2g2-history-capture-internal!
          generator foreign-input output)))
    (reject "wrong live output cannot capture genuine origin"
      (lambda ()
        (g3c4-public-p2g2-history-capture-internal!
          generator input foreign-output)))
    (if (eq? fault-mode 'late)
        (let ((snapshot-calls 0))
          (set! g3c4-p2g2-terminal-snapshot-private
            (lambda (shell)
              (set! snapshot-calls (+ snapshot-calls 1))
              (let ((current (snapshot-provider shell)))
                ;; Initial source snapshot stays authentic. Only the second,
                ;; final provider read changes the ticket before the fixed tail.
                (if (= snapshot-calls 2)
                    (vector-set! ticket 15
                      (if (= (vector-ref current 1) 255) 0
                          (+ (vector-ref current 1) 1)))
                    #t)
                current)))
          (reject "capture final snapshot mutation denies issuance"
            (lambda ()
              (g3c4-public-p2g2-history-capture-internal!
                generator input output)))
          (check "capture used initial and final snapshot exactly once"
                 (= snapshot-calls 2))
          (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
          (vector-set! ticket 15 (vector-ref before 1)))
        #t)
    (set! history
      (g3c4-public-p2g2-history-capture-internal!
        generator input output))
    (reject "copied history is not issued"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          (vector 'g3c4-p2g2-history-private) generator input output)))
    (reject "foreign generator cannot consume genuine history"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          history foreign-generator input output)))
    (reject "wrong live input cannot consume genuine history"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          history generator foreign-input output)))
    (reject "wrong live output cannot consume genuine history"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          history generator input foreign-output)))
    (check "foreign output releases"
           (g3g-public-generation-output-release foreign-output))
    (check "foreign generator closes"
           (g3g-public-generator-close foreign-generator))
    (if (eq? fault-mode 'false)
        (begin
          (set! g3c4-p2g2-terminal-snapshot-private
            (lambda (shell) (raise #f)))
          (let ((observed 'not-raised))
            (guard (caught (#t (set! observed caught)))
              (g3c4-public-p2g2-history-admit-once-internal!
                history generator input output))
            (check "private catch retains original raised #f"
                   (eq? observed #f)))
          (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider))
        #t)
    (if (eq? fault-mode 'late)
        (begin
          (set! g3c4-p2g2-terminal-snapshot-private
            (lambda (shell)
              (let ((current (snapshot-provider shell)))
                (vector-set! ticket 14
                  (if (= (vector-ref current 0) 255) 0
                      (+ (vector-ref current 0) 1)))
                current)))
          (reject "last provider mutation denies before spend"
            (lambda ()
              (g3c4-public-p2g2-history-admit-once-internal!
                history generator input output)))
          (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
          (vector-set! ticket 14 (vector-ref before 0)))
        #t)
    (if (eq? fault-mode 'late)
        (let ((nested-denied #f))
          (set! g3c4-p2g2-terminal-snapshot-private
            (lambda (shell)
              (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
              (set! nested-denied
                (guard (caught (#t (transformer-error? caught)))
                  (g3c4-public-p2g2-history-admit-once-internal!
                    history generator input output)
                  #f))
              (snapshot-provider shell)))
          (set! descriptor
            (g3c4-public-p2g2-history-admit-once-internal!
              history generator input output))
          (check "reentrant admit denied while outer owns phase"
                 nested-denied))
        (set! descriptor
          (g3c4-public-p2g2-history-admit-once-internal!
            history generator input output)))
    (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
    (check "descriptor preserves full P2/G1-G2 history"
      (and (= (vector-length descriptor) 16)
           (= (vector-ref descriptor 0) 0)
           (= (vector-ref descriptor 1) 255)
           (= (vector-ref descriptor 2) (vector-ref before 0))
           (= (vector-ref descriptor 3) (vector-ref before 1))
           (= (vector-ref descriptor 4) expected-count)
           (= (vector-ref descriptor 5) (+ expected-count 2))
           (= (vector-ref descriptor 6) (vector-ref before 4))
           (= (vector-ref descriptor 7) (vector-ref before 5))
           (= (vector-ref descriptor 8) (vector-ref before 6))
           (= (vector-ref descriptor 9) (vector-ref before 7))
           (= (vector-ref descriptor 10) eos)
           (eq? (vector-ref descriptor 11) model)
           (eq? (vector-ref descriptor 12) tokenizer)
           (eq? (vector-ref descriptor 13) generator)
           (eq? (vector-ref descriptor 14) input)
           (eq? (vector-ref descriptor 15) output)))
    (let ((after (snapshot-provider output)))
      (check "capture/admit did not change terminal RNG or IDs"
        (let loop ((index 0))
          (if (= index 8) #t
              (and (= (vector-ref before index) (vector-ref after index))
                   (loop (+ index 1)))))))
    (reject "one-use history cannot admit twice"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          history generator input output)))
    (check "output releases" (g3g-public-generation-output-release output))
    (check "generator closes" (g3g-public-generator-close generator))))

(define prompt-provider g3c4-public-p2g2-native-input-ids)

(define (run-nested-capture trigger different-output?)
  (let* ((generator
           (g3g-public-generator-create model tokenizer
                                        (config selected-first)))
         (output (g3g-public-generator-generate generator input))
         (other-generator
           (g3g-public-generator-create model tokenizer
                                        (config selected-first)))
         (other-output
           (g3g-public-generator-generate other-generator input))
         (before (snapshot-provider output))
         (nested-output (if different-output? other-output output))
         (nested-generator (if different-output? other-generator generator))
         (snapshot-calls 0)
         (prompt-calls 0)
         (attempted #f)
         (nested-denied #f)
         (history #f))
    ;; A nested invocation must stop before its own snapshot or prompt getter.
    (if (eq? trigger 'input)
        (set! g3c4-public-p2g2-native-input-ids
          (lambda (native operation)
            (set! prompt-calls (+ prompt-calls 1))
            (if (not attempted)
                (begin
                  (set! attempted #t)
                  (set! nested-denied
                    (guard (caught (#t (transformer-error? caught)))
                      (g3c4-public-p2g2-history-capture-internal!
                        nested-generator input nested-output)
                      #f))))
            (prompt-provider native operation)))
        (set! g3c4-p2g2-terminal-snapshot-private
          (lambda (shell)
            (set! snapshot-calls (+ snapshot-calls 1))
            (if (and (not attempted)
                     (= snapshot-calls (if (eq? trigger 'first) 1 2)))
                (begin
                  (set! attempted #t)
                  (set! nested-denied
                    (guard (caught (#t (transformer-error? caught)))
                      (g3c4-public-p2g2-history-capture-internal!
                        nested-generator input nested-output)
                      #f))))
            (snapshot-provider shell))))
    (set! history
      (g3c4-public-p2g2-history-capture-internal!
        generator input output))
    (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
    (set! g3c4-public-p2g2-native-input-ids prompt-provider)
    (check "strict nested capture was attempted and denied"
           (and attempted nested-denied))
    (if (eq? trigger 'input)
        (check "nested input getter never ran" (= prompt-calls 2))
        (check "nested terminal provider never ran" (= snapshot-calls 2)))
    (check "outer capture alone issued one history" (vector? history))
    (reject "nested output remains fresh after denial"
      (lambda ()
        (g3c4-public-p2g2-history-capture-internal!
          generator input output)))
    (let* ((descriptor
             (g3c4-public-p2g2-history-admit-once-internal!
               history generator input output))
           (after (snapshot-provider output)))
      (check "strict nested denial preserves output and prompt"
             (and (= (vector-ref descriptor 0) 0)
                  (= (vector-ref descriptor 1) 255)
                  (eq? (vector-ref descriptor 13) generator)
                  (eq? (vector-ref descriptor 14) input)
                  (eq? (vector-ref descriptor 15) output)))
      (check "strict nested denial does not change terminal state"
        (let loop ((index 0))
          (if (= index 8) #t
              (and (= (vector-ref before index) (vector-ref after index))
                   (loop (+ index 1)))))))
    (reject "strict nested outer history spends once"
      (lambda ()
        (g3c4-public-p2g2-history-admit-once-internal!
          history generator input output)))
    (check "strict nested output releases"
           (g3g-public-generation-output-release output))
    (check "strict nested generator closes"
           (g3g-public-generator-close generator))
    (check "strict nested other output releases"
           (g3g-public-generation-output-release other-output))
    (check "strict nested other generator closes"
           (g3g-public-generator-close other-generator))))

(define (run-capture-false-retry trigger)
  (let* ((generator
           (g3g-public-generator-create model tokenizer
                                        (config selected-first)))
         (output (g3g-public-generator-generate generator input))
         (snapshot-calls 0)
         (observed 'not-raised))
    (if (eq? trigger 'input)
        (set! g3c4-public-p2g2-native-input-ids
          (lambda (native operation) (raise #f)))
        (set! g3c4-p2g2-terminal-snapshot-private
          (lambda (shell)
            (set! snapshot-calls (+ snapshot-calls 1))
            (if (= snapshot-calls (if (eq? trigger 'first) 1 2))
                (raise #f))
            (snapshot-provider shell))))
    (guard (caught (#t (set! observed caught)))
      (g3c4-public-p2g2-history-capture-internal!
        generator input output))
    (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
    (set! g3c4-public-p2g2-native-input-ids prompt-provider)
    (check "capture rollback preserves original raised #f"
           (eq? observed #f))
    (let ((history
            (g3c4-public-p2g2-history-capture-internal!
              generator input output)))
      (check "capture retry after certain failure succeeds"
             (vector? history))
      (g3c4-public-p2g2-history-admit-once-internal!
        history generator input output))
    (check "capture retry output releases"
           (g3g-public-generation-output-release output))
    (check "capture retry generator closes"
           (g3g-public-generator-close generator))))

(define (run-propagated-nested-retry)
  (let* ((generator
           (g3g-public-generator-create model tokenizer
                                        (config selected-first)))
         (output (g3g-public-generator-generate generator input))
         (snapshot-calls 0))
    (set! g3c4-p2g2-terminal-snapshot-private
      (lambda (shell)
        (set! snapshot-calls (+ snapshot-calls 1))
        (g3c4-public-p2g2-history-capture-internal!
          generator input output)
        (snapshot-provider shell)))
    (reject "propagated nested denial rolls outer capture back"
      (lambda ()
        (g3c4-public-p2g2-history-capture-internal!
          generator input output)))
    (set! g3c4-p2g2-terminal-snapshot-private snapshot-provider)
    (check "propagated nested denial entered one provider only"
           (= snapshot-calls 1))
    (let ((history
            (g3c4-public-p2g2-history-capture-internal!
              generator input output)))
      (check "propagated nested denial allows authentic retry"
             (vector? history))
      (g3c4-public-p2g2-history-admit-once-internal!
        history generator input output))
    (check "propagated nested retry output releases"
           (g3g-public-generation-output-release output))
    (check "propagated nested retry generator closes"
           (g3g-public-generator-close generator))))

(run-case selected-first 1 'false)
(run-case non-eos 2 'late)
(run-nested-capture 'first #f)
(run-nested-capture 'first #t)
(run-nested-capture 'final #f)
(run-nested-capture 'final #t)
(run-nested-capture 'input #f)
(run-nested-capture 'input #t)
(run-capture-false-retry 'first)
(run-capture-false-retry 'final)
(run-capture-false-retry 'input)
(run-propagated-nested-retry)
(check "input releases" (g3g-public-generation-tensor-release input))
(check "foreign input releases"
       (g3g-public-generation-tensor-release foreign-input))
;;; The original sealed T1 shell has no supported release API. This fixture
;;; proves later history admission avoids T1 reads, not native T1 retirement.
(display "PRIVATE-P2G2-HISTORY-PASS checks=")
(display checks)
(newline)
