;;; Compiled Eshkol AOT end-to-end MOD5 training, C1 checkpoint save/reload,
;;; KV-cached autoregressive generation, and deterministic sampling test.
(load "i2_wave2_root.esk")
(require c1_sha256)

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 format-f64 ptr i64 char* f64 :real strfromd)

;; MOD5 K1 training bridge bindings
(extern i32 open-mod5 ptr :real et_mod5_aot_open)
(extern void close-mod5 ptr :real et_mod5_aot_close)
(extern void store-f32 ptr i64 f64 :real et_mod5_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_mod5_aot_load_f32)
(extern i32 rms-forward ptr ptr ptr ptr ptr :real et_mod5_aot_rms_forward)
(extern i32 rms-backward ptr ptr ptr ptr ptr ptr ptr :real et_mod5_aot_rms_backward)
(extern i32 glu-forward ptr ptr ptr ptr :real et_mod5_aot_swiglu_forward)
(extern i32 glu-backward ptr ptr ptr ptr ptr ptr :real et_mod5_aot_swiglu_backward)
(extern i32 attention-forward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr
        :real et_mod5_aot_attention_forward)
(extern i32 attention-backward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr ptr ptr ptr
        :real et_mod5_aot_attention_backward)

;; MOD5 KV-cache generation & deterministic sampling AOT bridge bindings
(extern i32 gen-engine-create i64 i64 i64 i64 i64 i64 i64 i64 i64 f64 ptr ptr
        :real et_mod5_gen_aot_engine_create)
(extern void gen-engine-destroy ptr :real et_mod5_gen_aot_engine_destroy)
(extern i32 gen-set-global-weights ptr ptr ptr ptr
        :real et_mod5_gen_aot_set_global_weights)
(extern i32 gen-set-layer-weights ptr i64 ptr ptr ptr ptr ptr ptr ptr ptr ptr
        :real et_mod5_gen_aot_set_layer_weights)
(extern i32 gen-kv-create ptr ptr :real et_mod5_gen_aot_kv_cache_create)
(extern void gen-kv-destroy ptr :real et_mod5_gen_aot_kv_cache_destroy)
(extern i32 gen-kv-reset ptr :real et_mod5_gen_aot_kv_cache_reset)
(extern i64 gen-kv-len ptr :real et_mod5_gen_aot_kv_cache_len)
(extern i32 gen-prefill ptr ptr ptr i64 ptr ptr :real et_mod5_gen_aot_prefill)
(extern i32 gen-decode-step ptr ptr i64 ptr :real et_mod5_gen_aot_decode_step)
(extern i32 gen-recompute ptr ptr i64 ptr
        :real et_mod5_gen_aot_recompute_forward)
(extern i32 gen-generate ptr ptr ptr i64 i64 f64 i64 f64 i64 i64 i64 ptr ptr ptr
        :real et_mod5_gen_aot_generate)
(extern i32 gen-verify-provider ptr :real et_mod5_gen_aot_verify_provider)
(extern i32 gen-max-abs-diff ptr ptr i64 ptr
        :real et_mod5_gen_aot_max_abs_diff_f32)
(extern f64 gen-load-f64 ptr i64 :real et_mod5_gen_aot_load_f64)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define tokens 8)
(define width 16)
(define hidden 32)
(define query-heads 4)
(define head-width 4)
(define window tokens)
(define kv-heads 2)
(define vocab 16)
(define steps 12)
(define epsilon 0.125)
(define learning-rate 0.25)
(define gen-max-seq 32)

(define (expect-status operation expected actual)
  (unless (= actual expected)
    (display operation) (display " expected status ") (display expected)
    (display ", received ") (display actual) (newline) (exit 1)))

(define (require-check label ok)
  (unless ok (display label) (newline) (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "MOD5 GEN workspace allocation failed" (not (= (ptr->usize p) 0)))
    p))

;; MOD5 K1 workspace
(define span-bytes (* 4 width hidden))
(define workspace (checked-allocate (* 7 span-bytes)))
(define input-a workspace)
(define input-b (ptr-add workspace span-bytes))
(define input-c (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define output-a (ptr-add workspace (* 4 span-bytes)))
(define output-b (ptr-add workspace (* 5 span-bytes)))
(define output-c (ptr-add workspace (* 6 span-bytes)))
(define query-positions (checked-allocate (* tokens 8)))
(define key-positions (checked-allocate (* tokens 8)))
(define keep-mask (checked-allocate (* tokens tokens)))
(define slopes (checked-allocate (* query-heads 4)))
(define epsilon-buffer (checked-allocate 4))
(define runtime-cell (checked-allocate 8))
(expect-status "K1 discovery" 0 (open-mod5 runtime-cell))
(define runtime (volatile-load ptr runtime-cell))
(release runtime-cell)

(do ((t 0 (+ t 1)))
    ((= t tokens))
  (volatile-store! i64 (ptr-add query-positions (* 8 t)) t)
  (volatile-store! i64 (ptr-add key-positions (* 8 t)) t))
(do ((i 0 (+ i 1)))
    ((= i (* tokens tokens)))
  (volatile-store! u8 (ptr-add keep-mask i) 1))
(do ((h 0 (+ h 1)))
    ((= h query-heads))
  (store-f32 slopes h 0.0))
(store-f32 epsilon-buffer 0 epsilon)

(define (pack tensor buffer)
  (let* ((count (tensor-length tensor))
         (flat (reshape tensor (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count))
      (store-f32 (ffi-pointer buffer) i (tensor-ref flat i)))))

(define (unpack buffer rows cols)
  (let* ((count (* rows cols))
         (flat (zeros (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count) (reshape flat (list rows cols)))
      (tensor-set! flat i (load-f32 (ffi-pointer buffer) i)))))

(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (store-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d)
                   (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (load-f32 (ffi-pointer buffer)
                                 (+ (* (+ (* h tokens) t) head-width) d))))))))

(define (rms x gamma)
  (pack x input-a)
  (pack gamma input-b)
  (expect-status "RMSNorm forward" 0
                 (rms-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (unpack output-a tokens width))

(define (rms-grad x gamma dy)
  (pack x input-a)
  (pack gamma input-b)
  (pack dy upstream)
  (expect-status "RMSNorm backward" 0
                 (rms-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                               (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens width) (unpack output-b 1 width)))

(define (glu gate up)
  (pack gate input-a)
  (pack up input-b)
  (expect-status "SwiGLU forward" 0
                 (glu-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer output-a)))
  (unpack output-a tokens hidden))

(define (glu-grad gate up dy)
  (pack gate input-a)
  (pack up input-b)
  (pack dy upstream)
  (expect-status "SwiGLU backward" 0
                 (glu-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens hidden) (unpack output-b tokens hidden)))

(define (pack-attention q k v)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c))

(define (attend q k v)
  (pack-attention q k v)
  (expect-status "attention forward" 0
                 (attention-forward (ffi-pointer runtime) kv-heads
                                    (ffi-pointer input-a) (ffi-pointer input-b)
                                    (ffi-pointer input-c)
                                    (ffi-pointer query-positions)
                                    (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    window (ffi-pointer output-a)))
  (unpack-heads output-a query-heads))

(define (attend-grad q k v dy)
  (pack-attention q k v)
  (pack-heads dy query-heads upstream)
  (expect-status "attention backward" 0
                 (attention-backward (ffi-pointer runtime) kv-heads
                                     (ffi-pointer input-a) (ffi-pointer input-b)
                                     (ffi-pointer input-c)
                                     (ffi-pointer query-positions)
                                     (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer slopes)
                                     window (ffi-pointer upstream)
                                     (ffi-pointer output-a) (ffi-pointer output-b)
                                     (ffi-pointer output-c)))
  (vector (unpack-heads output-a query-heads)
          (unpack-heads output-b kv-heads)
          (unpack-heads output-c kv-heads)))

;; Canonical eshkol-mod5-v1 C1 roster
(define wk 0)
(define wo 1)
(define wq 2)
(define wv 3)
(define wdown 4)
(define wgate 5)
(define wup 6)
(define gamma1 7)
(define gamma2 8)
(define whead 9)
(define gamma-final 10)
(define wembedding 11)
(define parameters 12)
(define roster
  '((("blocks" "0" "attention" "key" "weight") (8 16))
    (("blocks" "0" "attention" "output" "weight") (16 16))
    (("blocks" "0" "attention" "query" "weight") (16 16))
    (("blocks" "0" "attention" "value" "weight") (8 16))
    (("blocks" "0" "ffn" "down" "weight") (16 32))
    (("blocks" "0" "ffn" "gate" "weight") (32 16))
    (("blocks" "0" "ffn" "up" "weight") (32 16))
    (("blocks" "0" "norm1" "weight") (16))
    (("blocks" "0" "norm2" "weight") (16))
    (("head" "weight") (16 16))
    (("norm_final" "weight") (16))
    (("token_embedding" "weight") (16 16))))
(define tied-aliases '((("head" "weight") ("token_embedding" "weight"))))
(define layout 'dense-row-major-contiguous)
(define policy (c1-persistence-policy-internal 65536 16384 32768 16 'cpu))

(define (check-data condition message)
  (unless condition
    (transformer-error-raise 'corrupt-data 'mod5-gen message '() #f)))

(define corpus-identity "mod5-gen-token-v1")
(define corpus-limit 1024)

(define (corpus-read-exact path maximum operation)
  (let ((size (file-size path)))
    (check-data (and (integer? size) (<= 0 size) (<= size maximum))
                "D1 file exceeds fixture limits")
    (let ((bytes (make-bytevector size 0)))
      (check-data (= 0 (t1-native-read-exact path bytes size maximum))
                  "D1 checked read failed")
      bytes)))

(define (read-corpus directory)
  (let* ((count (+ tokens 1))
         (metadata ((vector-ref d1-compiled-public-operations 8)
                    corpus-read-exact directory corpus-limit corpus-limit count))
         (manifest (vector-ref metadata 6)))
    (check-data (and (= (vector-ref metadata 0) 1)
                     (= (vector-ref metadata 1) count)
                     (= (vector-ref metadata 2) vocab)
                     (string=? (vector-ref metadata 4) corpus-identity))
                "unexpected D1 corpus identity or shape")
    (let* ((record (c1-read-u32 manifest 12))
           (shard ((vector-ref d1-compiled-public-operations 9)
                   corpus-read-exact
                   (string-append directory "/shard-0000000000000000.ets")
                   0 count (c1-read-u64 manifest (+ record 16))
                   (bytevector-copy manifest (+ record 24) (+ record 56))
                   corpus-identity vocab corpus-limit))
           (offset (c1-read-u32 shard 12))
           (input (zeros (list tokens vocab)))
           (target (zeros (list tokens vocab))))
      (do ((t 0 (+ t 1)))
          ((= t tokens) (vector input target))
        (tensor-set! input t (c1-read-u64 shard (+ offset (* t 8))) 1.0)
        (tensor-set! target t (c1-read-u64 shard (+ offset (* (+ t 1) 8))) 1.0)))))

(define (project x weight) (matmul x (transpose weight)))
(define (project-dx weight dy) (matmul dy weight))
(define (project-dw x dy) (matmul (transpose dy) x))
(define inverse-tokens (/ 1.0 tokens))
(define vocabulary-row (ones (list 1 vocab)))

(define (cross-entropy logits target)
  (let* ((maxima (reshape (tensor-max logits 1) (list tokens 1)))
         (shifted (tensor-sub logits (matmul maxima vocabulary-row)))
         (exponentials (tensor-exp shifted))
         (sums (reshape (tensor-sum exponentials 1) (list tokens 1)))
         (loss (* inverse-tokens
                  (- (tensor-sum (tensor-log sums))
                     (tensor-sum (tensor-mul shifted target))))))
    (vector loss exponentials sums)))

(define (decoder weights input target gradients)
  (let* ((embedding (vector-ref weights wembedding))
         (head (vector-ref weights whead))
         (q-weight (vector-ref weights wq))
         (k-weight (vector-ref weights wk))
         (v-weight (vector-ref weights wv))
         (o-weight (vector-ref weights wo))
         (gate-weight (vector-ref weights wgate))
         (up-weight (vector-ref weights wup))
         (down-weight (vector-ref weights wdown))
         (gamma-a (vector-ref weights gamma1))
         (gamma-b (vector-ref weights gamma2))
         (gamma-c (vector-ref weights gamma-final))
         (x (matmul input embedding))
         (norm-a (rms x gamma-a))
         (q (project norm-a q-weight))
         (k (project norm-a k-weight))
         (v (project norm-a v-weight))
         (attention (attend q k v))
         (residual (tensor-add x (project attention o-weight)))
         (norm-b (rms residual gamma-b))
         (gate (project norm-b gate-weight))
         (up (project norm-b up-weight))
         (gated (glu gate up))
         (block (tensor-add residual (project gated down-weight)))
         (norm-c (rms block gamma-c))
         (logits (project norm-c head))
         (ce (cross-entropy logits target)))
    (when gradients
      (let* ((probabilities (tensor-div (vector-ref ce 1)
                                        (matmul (vector-ref ce 2) vocabulary-row)))
             (dlogits (tensor-scale (tensor-sub probabilities target) inverse-tokens))
             (drms-c (rms-grad block gamma-c (project-dx head dlogits)))
             (dy (vector-ref drms-c 0))
             (dglu (glu-grad gate up (project-dx down-weight dy)))
             (dgate (vector-ref dglu 0))
             (dup (vector-ref dglu 1))
             (dnorm-b (tensor-add (project-dx gate-weight dgate)
                                  (project-dx up-weight dup)))
             (drms-b (rms-grad residual gamma-b dnorm-b))
             (dresidual (tensor-add dy (vector-ref drms-b 0)))
             (dqkv (attend-grad q k v (project-dx o-weight dresidual)))
             (dq (vector-ref dqkv 0))
             (dk (vector-ref dqkv 1))
             (dv (vector-ref dqkv 2))
             (dnorm-a (tensor-add (tensor-add (project-dx q-weight dq)
                                              (project-dx k-weight dk))
                                  (project-dx v-weight dv)))
             (drms-a (rms-grad x gamma-a dnorm-a))
             (dx (tensor-add dresidual (vector-ref drms-a 0)))
             (dembedding (matmul (transpose input) dx))
             (dhead (project-dw norm-c dlogits)))
        (vector-set! gradients wk (project-dw norm-a dk))
        (vector-set! gradients wo (project-dw attention dresidual))
        (vector-set! gradients wq (project-dw norm-a dq))
        (vector-set! gradients wv (project-dw norm-a dv))
        (vector-set! gradients wdown (project-dw gated dy))
        (vector-set! gradients wgate (project-dw norm-b dgate))
        (vector-set! gradients wup (project-dw norm-b dup))
        (vector-set! gradients gamma1 (vector-ref drms-a 1))
        (vector-set! gradients gamma2 (vector-ref drms-b 1))
        (vector-set! gradients gamma-final (vector-ref drms-c 1))
        (vector-set! gradients whead dhead)
        (vector-set! gradients wembedding dembedding)))
    (vector (vector-ref ce 0) logits)))

(define (tensor-dimensions shape)
  (if (null? (cdr shape)) (list 1 (car shape)) shape))

(define (initial-weights)
  (let ((weights (make-vector parameters #f)))
    (do ((rows roster (cdr rows)) (p 0 (+ p 1)))
        ((null? rows) weights)
      (let* ((shape (cadr (car rows)))
             (dims (tensor-dimensions shape))
             (base (if (null? (cdr shape)) 1.0 0.0))
             (cols (cadr dims))
             (weight (zeros dims)))
        (do ((r 0 (+ r 1)))
            ((= r (car dims)))
          (do ((c 0 (+ c 1)))
              ((= c cols))
            (let* ((i (+ (* r cols) c))
                   (seed (- (modulo (+ (* 29 p) (* 11 i) (quotient i 5)) 37) 18)))
              (tensor-set! weight r c (+ base (* 0.0078125 seed))))))
        (vector-set! weights p weight)))))

(define (model-loss weights input target)
  (vector-ref (decoder weights input target #f) 0))

(define (check-gradients weights input target gradients)
  (do ((p 0 (+ p 1)))
      ((= p parameters))
    (let* ((weight (vector-ref weights p))
           (dims (tensor-shape weight))
           (gradient (vector-ref gradients p))
           (row 0)
           (col 0)
           (peak 0.0))
      (do ((r 0 (+ r 1)))
          ((= r (car dims)))
        (do ((c 0 (+ c 1)))
            ((= c (cadr dims)))
          (let ((magnitude (abs (tensor-get gradient r c))))
            (when (> magnitude peak)
              (set! row r)
              (set! col c)
              (set! peak magnitude)))))
      (require-check "inactive MOD5 parameter gradient" (> peak 0.0000001))
      (let ((step 0.001953125)
            (original (tensor-get weight row col))
            (analytic (tensor-get gradient row col)))
        (tensor-set! weight row col (+ original step))
        (let ((plus (model-loss weights input target)))
          (tensor-set! weight row col (- original step))
          (let ((numerical (/ (- plus (model-loss weights input target)) (* 2.0 step))))
            (tensor-set! weight row col original)
            (require-check "MOD5 decoder central difference failed"
                           (<= (abs (- analytic numerical))
                               (+ 0.000015 (* 0.005 (abs numerical)))))))))))

(define (quantize-weight weight)
  (let ((shape (tensor-shape weight)))
    (pack weight input-a)
    (unpack input-a (car shape) (cadr shape))))

(define (print-real format value)
  (let ((length (format-f64 (ffi-pointer input-a) 64 format value)))
    (require-check "failed to format real" (and (>= length 0) (< length 64)))
    (do ((i 0 (+ i 1))) ((= i length))
      (display (integer->char (volatile-load u8 (ptr-add input-a i)))))))

(define (train input target)
  (let* ((weights (initial-weights))
         (gradients (make-vector parameters #f))
         (initial (vector-ref (decoder weights input target gradients) 0)))
    (check-gradients weights input target gradients)
    (display "TRAIN_GRADIENTS 12") (newline)
    (let loop ((step 0) (loss initial))
      (display "LOSS ") (display step) (display " ")
      (print-real "%.17g" loss) (newline)
      (if (= step steps)
          weights
          (begin
            (do ((p 0 (+ p 1)))
                ((= p parameters))
              (let ((delta (vector-ref gradients p)))
                (require-check "nonfinite MOD5 decoder gradient"
                               (< (tensor-sum (tensor-abs delta)) 1.0e300))
                (vector-set! weights p
                  (quantize-weight (tensor-sub (vector-ref weights p)
                                               (tensor-scale delta learning-rate))))))
            (let ((current (vector-ref (decoder weights input target gradients) 0)))
              (require-check "MOD5 decoder loss failed to decrease"
                             (and (>= current 0.0) (< current loss)))
              (loop (+ step 1) current)))))))

(define (buffer->bytes buffer count)
  (let ((bytes (make-bytevector count 0)))
    (do ((i 0 (+ i 1)))
        ((= i count) bytes)
      (bytevector-u8-set! bytes i (volatile-load u8 (ptr-add buffer i))))))

(define (tensor->f32-bytes tensor)
  (pack tensor input-a)
  (buffer->bytes input-a (* 4 (tensor-length tensor))))

(define (f32-bytes->tensor bytes shape)
  (do ((i 0 (+ i 1)))
      ((= i (bytevector-length bytes)))
    (volatile-store! u8 (ptr-add input-a i) (bytevector-u8-ref bytes i)))
  (let ((dims (tensor-dimensions shape)))
    (unpack input-a (car dims) (cadr dims))))

(define (adopt-weights weights)
  (let ((ownership (vector '())))
    (guard (caught
             (#t
               (let release-owners ((remaining (vector-ref ownership 0)))
                 (unless (null? remaining)
                   (tensor-provider-release-owned-internal!
                     i2-provider-name 2 0 (car remaining))
                   (release-owners (cdr remaining))))
               (raise caught)))
      (let build ((rows roster) (records '()) (p 0))
        (if (null? rows)
            (begin
              (vector-set! ownership 0 (i2-reverse (vector-ref ownership 0)))
              (state-dict-adopt-owned-internal!
                (i2-reverse records) '()
                i2-provider-name 2 0 ownership))
            (let* ((path (car (car rows)))
                   (shape (cadr (car rows)))
                   (request (vector (tensor->f32-bytes (vector-ref weights p))
                                    'parameter shape 'f32 'cpu layout 'mod5-gen #f))
                   (envelope (vector #f 'parameter 'mod5-gen #f))
                   (next-owned (cons envelope (vector-ref ownership 0))))
              (i2-checkpoint-decode request)
              (let ((carrier (vector-ref request 7)))
                (vector-set! envelope 0 carrier)
                (vector-set! ownership 0 next-owned)
                (build (cdr rows)
                  (cons (vector path 'parameter shape 'f32 'cpu layout carrier) records)
                  (+ p 1)))))))))

(define (save-weights weights path)
  (let ((state (adopt-weights weights)))
    (guard (caught (#t (state-dict-release! state) (raise caught)))
      (c1-checkpoint-save-state-internal! state path policy i2-checkpoint-codec-internal #f))
    (state-dict-release! state)))

(define (state-payload state path shape)
  (let* ((handle (state-dict-tensor state path))
         (carrier (state-dict-tensor-borrow-begin-internal state handle))
         (bytes (guard (caught (#t (state-dict-tensor-borrow-end-internal state handle)
                                  (raise caught)))
                  (i2-checkpoint-encode
                    (vector carrier 'parameter shape 'f32 'cpu layout 'mod5-gen)))))
    (state-dict-tensor-borrow-end-internal state handle)
    bytes))

(define (decode-weights state)
  (let ((weights (make-vector parameters #f))
        (aliases (state-dict-alias-groups state)))
    (check-data (equal? (state-dict-paths state) (map car roster))
                "unexpected MOD5 parameter roster")
    (check-data (or (null? aliases) (equal? aliases tied-aliases))
                "unexpected MOD5 alias topology")
    (do ((rows roster (cdr rows))
         (entries (state-dict-entries-internal state) (cdr entries))
         (p 0 (+ p 1)))
        ((null? rows))
      (let* ((path (car (car rows)))
             (shape (cadr (car rows)))
             (entry (car entries)))
        (check-data (and (equal? path (state-entry-path-internal entry))
                         (eq? 'parameter (state-entry-kind-internal entry))
                         (equal? shape (state-entry-shape-internal entry))
                         (eq? 'f32 (state-entry-dtype-internal entry))
                         (eq? 'cpu (state-entry-device-internal entry))
                         (eq? layout (state-entry-layout-internal entry)))
                    "unexpected MOD5 parameter metadata")
        (let ((weight (f32-bytes->tensor (state-payload state path shape) shape)))
          (check-data (< (tensor-sum (tensor-abs weight)) 1.0e300)
                      "nonfinite MOD5 parameter")
          (vector-set! weights p weight))))
    weights))

(define (load-weights path)
  (let* ((state (c1-checkpoint-load-state-internal
                  path policy i2-checkpoint-codec-internal i2-provider-name))
         (weights (guard (caught (#t (state-dict-release! state) (raise caught)))
                    (decode-weights state))))
    (state-dict-release! state)
    weights))

(define hex-digits "0123456789abcdef")

(define (print-hex-byte byte)
  (display (string-ref hex-digits (quotient byte 16)))
  (display (string-ref hex-digits (modulo byte 16))))

(define (print-sha256-bytes bv)
  (let ((digest (c1-sha256 bv)))
    (do ((i 0 (+ i 1))) ((= i (bytevector-length digest)))
      (print-hex-byte (bytevector-u8-ref digest i)))))

(define (parse-nonneg-int str)
  (let ((len (string-length str)))
    (check-data (> len 0) "empty integer argument")
    (let loop ((i 0) (acc 0))
      (if (= i len)
          acc
          (let ((d (- (char->integer (string-ref str i)) 48)))
            (check-data (and (>= d 0) (<= d 9)) "invalid integer digit")
            (loop (+ i 1) (+ (* acc 10) d)))))))

(define (print-token-list buf count)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (when (> i 0) (display ","))
    (display (volatile-load i64 (ptr-add buf (* 8 i))))))

;; Load all 12 C1 tensors into a contiguous aligned f32 weight slab and bind
;; them into the MOD5 generation engine.
(define (run-generate ckpt-path seed)
  (let* ((weights (load-weights ckpt-path))
         (f64-cell (checked-allocate 8))
         (eng-cell (checked-allocate 8))
         (cache-cell (checked-allocate 8))
         ;; 12 aligned weight spans: each <= 512 floats = 2048 bytes
         (w-stride 2048)
         (w-slab (checked-allocate (* 12 w-stride)))
         (prompt-buf (checked-allocate (* gen-max-seq 8)))
         (gen-tokens (checked-allocate (* gen-max-seq 8)))
         (eos-tokens (checked-allocate (* gen-max-seq 8)))
         (summary-buf (checked-allocate (* 8 8)))
         (last-logits (checked-allocate (* vocab 4)))
         (cached-logits (checked-allocate (* gen-max-seq vocab 4)))
         (recomp-logits (checked-allocate (* gen-max-seq vocab 4)))
         (step-logits (checked-allocate (* gen-max-seq vocab 4))))
    (expect-status "verify MOD5 K1 provider parity" 0
                   (gen-verify-provider (ffi-pointer f64-cell)))
    (let ((prov-diff (gen-load-f64 (ffi-pointer f64-cell) 0)))
      (require-check "provider parity diff must be 0.0" (= prov-diff 0.0)))

    (expect-status "create gen engine" 0
                   (gen-engine-create vocab gen-max-seq 1 width hidden
                                      query-heads kv-heads 0 0 epsilon
                                      (ffi-pointer slopes)
                                      (ffi-pointer eng-cell)))
    (let ((engine (volatile-load ptr eng-cell)))
      (expect-status "create KV cache" 0
                     (gen-kv-create (ffi-pointer engine)
                                    (ffi-pointer cache-cell)))
      (let ((cache (volatile-load ptr cache-cell)))
        ;; Pack all 12 loaded C1 weights into disjoint aligned f32 spans.
        (do ((p 0 (+ p 1)))
            ((= p parameters))
          (pack (vector-ref weights p) (ptr-add w-slab (* p w-stride))))

        (expect-status "set global weights" 0
                       (gen-set-global-weights
                         (ffi-pointer engine)
                         (ffi-pointer (ptr-add w-slab (* wembedding w-stride)))
                         (ffi-pointer (ptr-add w-slab (* gamma-final w-stride)))
                         (ffi-pointer (ptr-add w-slab (* whead w-stride)))))
        (expect-status "set layer 0 weights" 0
                       (gen-set-layer-weights
                         (ffi-pointer engine) 0
                         (ffi-pointer (ptr-add w-slab (* gamma1 w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wq w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wk w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wv w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wo w-stride)))
                         (ffi-pointer (ptr-add w-slab (* gamma2 w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wgate w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wup w-stride)))
                         (ffi-pointer (ptr-add w-slab (* wdown w-stride)))))

        ;; Check 1: Parity on 8-token training sequence (prefill 4 + 4 decode vs K1 recompute 8)
        (let ((seq8 '(1 4 1 5 9 2 6 5)))
          (do ((lst seq8 (cdr lst)) (i 0 (+ i 1)))
              ((null? lst))
            (volatile-store! i64 (ptr-add prompt-buf (* 8 i)) (car lst)))
          (expect-status "recompute T=8" 0
                         (gen-recompute (ffi-pointer engine)
                                        (ffi-pointer prompt-buf) 8
                                        (ffi-pointer recomp-logits)))
          (expect-status "reset cache" 0 (gen-kv-reset (ffi-pointer cache)))
          (expect-status "prefill 4" 0
                         (gen-prefill (ffi-pointer engine) (ffi-pointer cache)
                                      (ffi-pointer prompt-buf) 4
                                      (ffi-pointer last-logits)
                                      (ffi-pointer cached-logits)))
          (require-check "cache len after prefill 4"
                         (= (gen-kv-len (ffi-pointer cache)) 4))
          (do ((i 4 (+ i 1)))
              ((= i 8))
            (expect-status "decode step" 0
                           (gen-decode-step
                             (ffi-pointer engine) (ffi-pointer cache)
                             (volatile-load i64 (ptr-add prompt-buf (* 8 i)))
                             (ffi-pointer (ptr-add cached-logits (* i vocab 4))))))
          (expect-status "diff T=8" 0
                         (gen-max-abs-diff (ffi-pointer cached-logits)
                                           (ffi-pointer recomp-logits)
                                           (* 8 vocab) (ffi-pointer f64-cell)))
          (let ((diff8 (gen-load-f64 (ffi-pointer f64-cell) 0)))
            (require-check "AOT T=8 cached vs recompute parity <= 1e-6"
                           (<= diff8 0.000001))
            (display "PARITY_T8 max_abs_diff=")
            (print-real "%.3e" diff8)
            (newline)))

        ;; Check 2: Greedy generation (prompt 4 tokens + 8 new tokens = 12 total)
        (volatile-store! i64 (ptr-add prompt-buf 0) 1)
        (volatile-store! i64 (ptr-add prompt-buf 8) 4)
        (volatile-store! i64 (ptr-add prompt-buf 16) 1)
        (volatile-store! i64 (ptr-add prompt-buf 24) 5)
        (expect-status "greedy generate" 0
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     0 1.0 0 1.0 -1 8 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (require-check "greedy generated_len=8"
                       (= (volatile-load i64 (ptr-add summary-buf 0)) 8))
        (require-check "greedy stopped_eos=0"
                       (= (volatile-load i64 (ptr-add summary-buf 8)) 0))
        (require-check "greedy rng_counter=0"
                       (= (volatile-load i64 (ptr-add summary-buf 24)) 0))

        ;; Verify generated 8 step logits match full 11-token recompute logits [3..10]
        (do ((i 0 (+ i 1)))
            ((= i 7))
          (volatile-store! i64 (ptr-add prompt-buf (* 8 (+ 4 i)))
                           (volatile-load i64 (ptr-add gen-tokens (* 8 i)))))
        (expect-status "recompute T=11" 0
                       (gen-recompute (ffi-pointer engine)
                                      (ffi-pointer prompt-buf) 11
                                      (ffi-pointer recomp-logits)))
        (expect-status "diff greedy 8 steps" 0
                       (gen-max-abs-diff (ffi-pointer step-logits)
                                         (ffi-pointer (ptr-add recomp-logits (* 3 vocab 4)))
                                         (* 8 vocab) (ffi-pointer f64-cell)))
        (let ((diff-gen (gen-load-f64 (ffi-pointer f64-cell) 0)))
          (require-check "AOT greedy step logits vs full recompute <= 1e-6"
                         (<= diff-gen 0.000001))
          (display "PARITY_GEN8 max_abs_diff=")
          (print-real "%.3e" diff-gen)
          (newline))

        (display "GREEDY tokens=")
        (print-token-list gen-tokens 8)
        (display " logits_sha256=")
        (print-sha256-bytes (buffer->bytes step-logits (* 8 vocab 4)))
        (newline)

        ;; Check 3: EOS early stop using greedy_tokens[2] and greedy_tokens[0]
        (let ((eos-target (volatile-load i64 (ptr-add gen-tokens 16)))
              (eos-first (volatile-load i64 (ptr-add gen-tokens 0))))
          (expect-status "EOS early stop" 0
                         (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                       (ffi-pointer prompt-buf) 4
                                       0 1.0 0 1.0 eos-target 8 seed
                                       (ffi-pointer eos-tokens)
                                       (ffi-pointer step-logits)
                                       (ffi-pointer summary-buf)))
          (let ((elen (volatile-load i64 (ptr-add summary-buf 0)))
                (estop (volatile-load i64 (ptr-add summary-buf 8))))
            (require-check "EOS stopped flag" (= estop 1))
            (require-check "EOS stopped early (<= 3)" (and (>= elen 1) (<= elen 3)))
            (require-check "EOS final token matches target"
                           (= (volatile-load i64 (ptr-add eos-tokens (* 8 (- elen 1))))
                              eos-target))
            (display "EOS_STOP target=") (display eos-target)
            (display " len=") (display elen)
            (display " stopped=") (display estop)
            (newline))
          (expect-status "EOS step-0 stop" 0
                         (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                       (ffi-pointer prompt-buf) 4
                                       0 1.0 0 1.0 eos-first 8 seed
                                       (ffi-pointer eos-tokens)
                                       (ffi-pointer step-logits)
                                       (ffi-pointer summary-buf)))
          (require-check "EOS step-0 len=1"
                         (and (= (volatile-load i64 (ptr-add summary-buf 0)) 1)
                              (= (volatile-load i64 (ptr-add summary-buf 8)) 1))))

        ;; Check 4: Seeded top-k / top-p categorical generation
        (expect-status "seeded categorical generate" 0
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     1 0.85 6 0.90 -1 8 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (let ((slen (volatile-load i64 (ptr-add summary-buf 0)))
              (rcnt (volatile-load i64 (ptr-add summary-buf 24))))
          (require-check "sampled len=8" (= slen 8))
          (require-check "sampled rng_counter=8" (= rcnt 8))
          (display "SAMPLED seed=") (display seed)
          (display " tokens=") (print-token-list gen-tokens 8)
          (display " rng_counter=") (display rcnt)
          (display " logits_sha256=")
          (print-sha256-bytes (buffer->bytes step-logits (* 8 vocab 4)))
          (newline))

        ;; Check 5: Malformed / negative checks from compiled AOT
        (volatile-store! i64 (ptr-add prompt-buf 0) 16)
        (expect-status "reject oob token" -3
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     0 1.0 0 1.0 -1 4 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (volatile-store! i64 (ptr-add prompt-buf 0) 1)
        (expect-status "reject cache overflow" -6
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     0 1.0 0 1.0 -1 40 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (expect-status "reject zero temperature" -2
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     1 0.0 4 0.9 -1 4 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (expect-status "reject top_p > 1" -2
                       (gen-generate (ffi-pointer engine) (ffi-pointer cache)
                                     (ffi-pointer prompt-buf) 4
                                     1 1.0 4 1.5 -1 4 seed
                                     (ffi-pointer gen-tokens)
                                     (ffi-pointer step-logits)
                                     (ffi-pointer summary-buf)))
        (display "AOT_NEGATIVE_CHECKS PASS") (newline)

        (gen-kv-destroy (ffi-pointer cache)))
      (gen-engine-destroy (ffi-pointer engine)))
    (release f64-cell)
    (release eng-cell)
    (release cache-cell)
    (release w-slab)
    (release prompt-buf)
    (release gen-tokens)
    (release eos-tokens)
    (release summary-buf)
    (release last-logits)
    (release cached-logits)
    (release recomp-logits)
    (release step-logits)))

(define (close-workspace)
  (close-mod5 (ffi-pointer runtime))
  (release workspace)
  (release query-positions)
  (release key-positions)
  (release keep-mask)
  (release slopes)
  (release epsilon-buffer))

(define (mod5-gen-main arguments)
  (let ((argc (c1-list-length-bounded arguments 7)))
    (if (and argc (>= argc 4) (string=? (cadr arguments) "--mode"))
        (let ((mode (caddr arguments)))
          (guard (caught
                   (#t
                     (close-workspace)
                     (display "MOD5 GEN ERROR ")
                     (if (transformer-error? caught)
                         (begin (display (transformer-error-category caught))
                                (display " ")
                                (display (transformer-error-message caught)))
                         (write caught))
                     (newline)
                     2))
            (cond
              ((and (string=? mode "write-corpus") (= argc 4))
               (et-d1-private-token-corpus-write
                 (cadddr arguments) corpus-identity vocab (+ tokens 1)
                 '(1 4 1 5 9 2 6 5 3))
               (display "CORPUS_WRITTEN") (newline)
               (close-workspace)
               0)
              ((and (string=? mode "train-save") (= argc 5))
               (let* ((batch (read-corpus (cadddr arguments)))
                      (weights (train (vector-ref batch 0) (vector-ref batch 1))))
                 (save-weights weights (cadr (cdddr arguments)))
                 (display "TRAIN_SAVED") (newline)
                 (close-workspace)
                 0))
              ((and (string=? mode "generate") (= argc 5))
               (run-generate (cadddr arguments)
                             (parse-nonneg-int (cadr (cdddr arguments))))
               (close-workspace)
               0)
              (else
               (close-workspace)
               (display "Usage: mod5-gen-aot --mode write-corpus <dir> | train-save <corpus-dir> <out.etcp> | generate <in.etcp> <seed>")
               (newline)
               2))))
        (begin
          (close-workspace)
          (display "Usage: mod5-gen-aot --mode write-corpus <dir> | train-save <corpus-dir> <out.etcp> | generate <in.etcp> <seed>")
          (newline)
          2))))

(if (= (mod5-gen-main (command-line)) 0) (exit 0) (exit 2))
