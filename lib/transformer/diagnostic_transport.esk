;;; Installed diagnostic sibling facade: fixed boxed calls only.
;;; Exactly one registry-owning aggregate may be linked per process.
(require transformer.error_consumer)

(provide diagnostic-initializer-state
         diagnostic-initializer-algorithm
         diagnostic-initializer-words
         diagnostic-model-create
         diagnostic-model-profile
         diagnostic-model-initializer
         diagnostic-input-create
         diagnostic-input-copy!
         diagnostic-input-copy-tokenizer!
         diagnostic-input-release!
         diagnostic-logits-create
         diagnostic-logits-copy-bits!
         diagnostic-logits-bits
         diagnostic-logits-release!
         diagnostic-workspace-create
         diagnostic-workspace-begin!
         diagnostic-workspace-vjp-begin!
         diagnostic-workspace-copy-logits!
         diagnostic-workspace-check-primals
         diagnostic-workspace-reset!
         diagnostic-workspace-release!
         diagnostic-embedding!
         diagnostic-linear!
         diagnostic-layer-norm!
         diagnostic-gelu!
         diagnostic-residual!
         diagnostic-heads-split!
         diagnostic-heads-merge!
         diagnostic-attention!
         diagnostic-embedding-vjp!
         diagnostic-linear-vjp!
         diagnostic-layer-norm-vjp!
         diagnostic-gelu-vjp!
         diagnostic-residual-vjp!
         diagnostic-heads-split-vjp!
         diagnostic-heads-merge-vjp!
         diagnostic-attention-vjp!
         diagnostic-sum!)

(define m3t-safe-initializer-state
  (let ()
    (extern void m3t-boxed-initializer-state ptr ptr
            :real et_e1b_public_m3t_initializer_state_v1)
    (lambda (first)
      (let ((output (vector #f)))
        (m3t-boxed-initializer-state (vector first) output)
        (vector-ref output 0)))))
(define (diagnostic-initializer-state first)
  (m3t-safe-initializer-state first))

