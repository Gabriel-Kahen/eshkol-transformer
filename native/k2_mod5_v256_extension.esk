;;; Source-private fixed K2 profile. Load after k2_wave2_extension.esk.
(extern i64 k2-v256-native-ensure ptr i64
        :real et_k2_private_mod5_v256_ensure_v1)
(extern i64 k2-v256-native-generation
        :real et_k2_private_mod5_v256_generation_v1)
(extern i64 k2-v256-native-require
        i64 i64 ptr i64 ptr i64 ptr i64 ptr i64 i64 i64 ptr i64
        :real et_k2_private_mod5_v256_require_v1)
(extern i64 k2-v256-native-register i64 ptr
        :real et_k2_private_mod5_v256_factory_register_v1)
(extern i64 k2-v256-native-authenticate i64 ptr
        :real et_k2_private_mod5_v256_factory_authenticate_v1)

(define k2-v256-query (vector 'k2-mod5-v256-query-v1))
(define k2-v256-profile (vector 'mod5-width16-v256))
(define k2-v256-tags (vector (vector 'report) (vector 'request) (vector 'entry)))
(define k2-v256-factories-ready (vector #f))

(define (k2-v256-report-shell state)
  (lambda (query)
    (if (eq? query (vector-ref state 2)) state
        (error "transformer.capability-report:mod5-v256"))))

(define (k2-v256-request-shell state)
  (lambda (query)
    (if (eq? query (vector-ref state 2)) state
        (error "transformer.capability-request:mod5-v256"))))

(define (k2-v256-entry-shell state)
  (lambda (query)
    (if (eq? query (vector-ref state 2)) state
        (error "transformer.capability-entry:mod5-v256"))))

(define (k2-v256-generation operation)
  (let ((generation (k2-v256-native-generation)))
    (cond ((> generation 0) generation)
          ((= generation -7)
           (k2-fail 'invalid-state operation "V256 K2 runtime is stale"))
          (else
           (k2-fail 'internal operation "V256 K2 runtime audit failed")))))

(define (k2-v256-check-factory! kind probe operation)
  (let ((status (k2-v256-native-register kind probe)))
    (cond ((= status 1)
           (if (not (= (k2-v256-native-authenticate kind probe) 1))
               (k2-fail 'internal operation
                        "V256 K2 factory authentication failed")))
          ((= status -1)
           (k2-fail 'invalid-argument operation "Malformed V256 K2 factory"))
          (else (k2-fail 'internal operation "V256 K2 factory registration failed")))))

(define (k2-v256-ensure! operation)
  (let* ((diagnostic (make-bytevector k2-diagnostic-bytes k2-diagnostic-sentinel))
         (status (k2-v256-native-ensure diagnostic k2-diagnostic-bytes))
         (failure (k2-diagnostic-result status diagnostic operation)))
    (if failure (k2-raise-diagnostic failure operation))
    (if (not (vector-ref k2-v256-factories-ready 0))
        (let ((probe-state (vector #f #f k2-v256-query)))
          (k2-v256-check-factory! 0 (k2-v256-report-shell probe-state) operation)
          (k2-v256-check-factory! 1 (k2-v256-request-shell probe-state) operation)
          (k2-v256-check-factory! 2 (k2-v256-entry-shell probe-state) operation)
          (vector-set! k2-v256-factories-ready 0 #t)))))

(define (k2-v256-make kind factory pid generation payload)
  (let* ((state (vector (vector-ref k2-v256-tags kind) #f k2-v256-query
                        pid generation 'live k2-v256-profile payload))
         (shell (factory state)))
    (vector-set! state 1 shell)
    shell))

(define (k2-v256-state value kind operation)
  (if (not (and (vector-ref k2-v256-factories-ready 0) (procedure? value)))
      (k2-fail 'invalid-argument operation "Expected an authentic V256 K2 carrier"))
  (k2-authentication-result (k2-v256-native-authenticate kind value)
                            operation "V256 capability carrier")
  (let ((state
         (guard (caught
                 (#t (k2-fail 'invalid-argument operation "Invalid V256 K2 carrier")))
           (value k2-v256-query))))
    (if (not (and (vector? state) (= (vector-length state) 8)
                  (eq? (vector-ref state 0) (vector-ref k2-v256-tags kind))
                  (eq? (vector-ref state 1) value)
                  (eq? (vector-ref state 2) k2-v256-query)
                  (integer? (vector-ref state 3)) (exact? (vector-ref state 3))
                  (real? (vector-ref state 3))
                  (integer? (vector-ref state 4)) (exact? (vector-ref state 4))
                  (real? (vector-ref state 4))))
        (k2-fail 'invalid-argument operation "Malformed V256 K2 carrier"))
    (if (not (= (vector-ref state 3) (k2-current-pid operation)))
        (k2-fail 'invalid-state operation "V256 K2 carrier belongs to a stale process"))
    (if (not (= (vector-ref state 4) (k2-v256-generation operation)))
        (k2-fail 'invalid-state operation "V256 K2 carrier has a stale generation"))
    (if (not (eq? (vector-ref state 5) 'live))
        (k2-fail 'invalid-state operation "V256 K2 carrier is invalidated"))
    (if (not (eq? (vector-ref state 6) k2-v256-profile))
        (k2-fail 'unsupported operation "V256 K2 carrier has a different profile"))
    state))

(define (k2-v256-report-state report operation)
  ;; Authentic ordinary reports fail before either K1 matcher is reached.
  (if (and (procedure? report) (vector-ref k2-factories-ready 0)
           (= (k2-native-report-factory-authenticate report) 1))
      (begin
        (k2-report-state report operation)
        (k2-fail 'unsupported operation "V256 K2 requires the explicit V256 report")))
  (k2-v256-state report 0 operation))

(define (k2-mod5-v256-discover)
  (let ((operation 'k2-mod5-v256-discover))
    (k2-v256-ensure! operation)
    (k2-v256-make 0 k2-v256-report-shell (k2-current-pid operation)
                  (k2-v256-generation operation) #f)))

(define (k2-mod5-v256-request name dtype device shape deterministic?)
  (let ((operation 'k2-mod5-v256-request))
    (if (not (and (symbol? name) (symbol? dtype) (symbol? device)
                  (boolean? deterministic?)))
        (k2-fail 'invalid-argument operation "Malformed V256 K2 request"))
    (let* ((dimensions (k2-shape-copy shape operation))
           (representable
             (and (k2-ascii-symbol-representable? name)
                  (k2-ascii-symbol-representable? dtype)
                  (k2-ascii-symbol-representable? device)
                  (k2-shape-representable? dimensions)))
           (payload (and representable
                         (vector (string->utf8 (symbol->string name))
                                 (string->utf8 (symbol->string dtype))
                                 (string->utf8 (symbol->string device))
                                 (k2-shape-u64le dimensions)
                                 (k2-list-length dimensions) deterministic?))))
      (k2-v256-ensure! operation)
      (k2-v256-make 1 k2-v256-request-shell (k2-current-pid operation)
                    (k2-v256-generation operation) payload))))

(define (k2-v256-match generation index payload operation)
  (let* ((name (vector-ref payload 0))
         (dtype (vector-ref payload 1))
         (device (vector-ref payload 2))
         (shape (vector-ref payload 3))
         (diagnostic (make-bytevector k2-diagnostic-bytes k2-diagnostic-sentinel))
         (status (k2-v256-native-require
                  generation index name (bytevector-length name)
                  dtype (bytevector-length dtype) device (bytevector-length device)
                  shape (bytevector-length shape) (vector-ref payload 4)
                  (if (vector-ref payload 5) 1 0) diagnostic k2-diagnostic-bytes))
         (failure (k2-diagnostic-result status diagnostic operation)))
    (cond ((not failure) #t)
          ((and (= status 6) (= (vector-ref failure 1) 15)
                (eq? (vector-ref failure 3) 'kernel-abi)) #f)
          (else (k2-raise-diagnostic failure operation)))))

(define (k2-mod5-v256-require report capability request)
  (let* ((operation 'k2-mod5-v256-require)
         (report-state (k2-v256-report-state report operation))
         (request-state (k2-v256-state request 1 operation)))
    (if (not (symbol? capability))
        (k2-fail 'invalid-argument operation "Capability selector must be a symbol"))
    (let ((index (k2-entry-index capability))
          (payload (vector-ref request-state 7))
          (generation (vector-ref report-state 4)))
      (if (and payload
               (not (and (vector? payload) (= (vector-length payload) 6)
                         (bytevector? (vector-ref payload 0))
                         (bytevector? (vector-ref payload 1))
                         (bytevector? (vector-ref payload 2))
                         (bytevector? (vector-ref payload 3))
                         (integer? (vector-ref payload 4))
                         (exact? (vector-ref payload 4))
                         (<= 0 (vector-ref payload 4) 64)
                         (boolean? (vector-ref payload 5)))))
          (k2-fail 'invalid-argument operation "Malformed V256 K2 request payload"))
      (if (and index payload (k2-v256-match generation index payload operation))
          (k2-v256-make 2 k2-v256-entry-shell
                        (vector-ref report-state 3) generation index)
          (k2-fail 'unsupported operation
                   "No V256 K2 capability matches the exact request")))))

(define (k2-mod5-v256-entry-description entry)
  (let* ((operation 'k2-mod5-v256-entry-description)
         (index (vector-ref (k2-v256-state entry 2 operation) 7)))
    (if (not (and (integer? index) (exact? index) (real? index)
                  (= index 9)))
        (k2-fail 'invalid-argument operation "Malformed verified V256 K2 entry"))
    (vector 'tensor.f32 'verified 'eshkol-transformer-f32
            (string-copy "1.3") (string-copy "I2:mod5-v256-exact-f32-storage.copy-v1")
            #t)))
