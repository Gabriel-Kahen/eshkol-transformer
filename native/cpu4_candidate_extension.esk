;;; CPU4 owning initializer only. Load after the sole C4/I2 model authority.
;;; No ordinary aggregate loads this feature or its native externs.
(extern ptr cpu4-native-candidate-begin i64
        :real et_cpu4_private_candidate_begin_v1)
(extern ptr cpu4-native-candidate-owner ptr
        :real et_cpu4_private_candidate_owner_v1)
(extern i64 cpu4-native-candidate-bind-graph ptr ptr ptr
        :real et_cpu4_private_candidate_bind_graph_v1)
(extern i64 cpu4-native-candidate-abort-open ptr
        :real et_cpu4_private_candidate_abort_open_v1)
(extern i64 cpu4-native-candidate-adopt ptr ptr
        :real et_cpu4_private_candidate_adopt_v1)
(extern i64 cpu4-native-candidate-retire-prepare ptr ptr ptr
        :real et_cpu4_private_candidate_retire_prepare_v1)
(extern i64 cpu4-native-candidate-retire-cancel ptr
        :real et_cpu4_private_candidate_retire_cancel_v1)
(extern i64 cpu4-native-candidate-retire-graph ptr
        :real et_cpu4_private_candidate_retire_graph_commit_v1)
(extern i64 cpu4-native-candidate-retire-payload ptr
        :real et_cpu4_private_candidate_retire_payload_commit_v1)
(extern i64 cpu4-native-p1-candidate-begin ptr
        :real et_p1_private_candidate_construction_begin_v1)

(define cpu4-candidate-surface
  (let* ((native-begin (lambda (seed) (cpu4-native-candidate-begin seed)))
         (native-owner (lambda (candidate) (cpu4-native-candidate-owner candidate)))
         (native-abort (lambda (candidate) (cpu4-native-candidate-abort-open candidate)))
         (native-adopt (lambda (candidate generator) (cpu4-native-candidate-adopt candidate generator)))
         (native-prepare (lambda (candidate optimizer generator) (cpu4-native-candidate-retire-prepare candidate optimizer generator)))
         (native-cancel (lambda (candidate) (cpu4-native-candidate-retire-cancel candidate)))
         (native-graph (lambda (candidate) (cpu4-native-candidate-retire-graph candidate)))
         (native-payload (lambda (candidate) (cpu4-native-candidate-retire-payload candidate)))
         ;; Bare extern Function* values are not closures in fe9. Every FFI
         ;; capture is a real fixed-arity Scheme lambda with a direct FFI call.
         ;; Read installer and all returned operations once, at feature init.
         (p1-native-begin-fixed (lambda (context) (cpu4-native-p1-candidate-begin context)))
         (bind-ffi (lambda (candidate context scope) (cpu4-native-candidate-bind-graph candidate context scope)))
         (bind-fixed
           (lambda (capability context scope)
             (let ((status (bind-ffi capability context scope)))
               (g3c4-native-check status 'cpu4-candidate-bind-graph)
               status)))
         (p1-bridge ((vector-ref p1-trusted-surface 73)
                       p1-native-begin-fixed bind-fixed))
         (p1-begin (vector-ref p1-bridge 0))
         (p1-retain (vector-ref p1-bridge 1))
         (p1-preflight (vector-ref p1-bridge 2))
         (p1-invalidate (vector-ref p1-bridge 3))
         (registry (vector '()))
         (owner-parameter (lambda (owner index) (i2-native-g3c4-owner-parameter owner index)))
         (i2-available (lambda () (i2-native-g3c4-construction-available)))
         (last-error-category (lambda () (g3c4-native-last-error-category)))
         (owner-initialize (lambda (owner index) (g3c4-native-owner-initialize owner index)))
         (owner-word (lambda (owner index) (g3c4-native-owner-word owner index)))
         (owner-prepare (lambda (owner) (g3c4-native-owner-prepare-seal owner)))
         (owner-seal (lambda (owner) (g3c4-native-owner-commit-seal owner))))
    ;; Row: self/state/native-cap/owner/C4-entry/I2-record/P1-ticket/I2-sidecar/
    ;; resolved/first-error/cleanup-fault/busy. No child adoption by inference.
    (define (find candidate operation)
      (let loop ((rows (vector-ref registry 0)))
        (cond ((null? rows)
               (g3c4-fail 'invalid-argument operation "foreign CPU4 candidate"))
              ((eq? candidate (vector-ref (car rows) 0))
               (let ((row (car rows)))
                 (if (not (and (vector? candidate) (= (vector-length candidate) 1)
                               (eq? (vector-ref candidate 0) candidate)))
                     (g3c4-fail 'invalid-argument operation "candidate self identity changed"))
                 row))
              (else (loop (cdr rows))))))
    (define (unpublished candidate operation)
      (let ((row (find candidate operation)))
        (if (not (and (eq? (vector-ref row 1) 'unpublished)
                      (not (vector-ref row 11))
                      (eq? (native-owner (vector-ref row 2)) (vector-ref row 3))
                      (eq? (vector-ref (vector-ref row 4) 3) (vector-ref row 3))
                      (eq? (vector-ref (vector-ref row 4) 7) #f)
                      (eq? (vector-ref (vector-ref row 4) 2) 'live)))
            (g3c4-fail 'invalid-state operation "candidate is not unpublished and idle"))
        row))
    (define (member-cell? cell rows)
      (cond ((null? rows) #f)
            ((eq? cell (vector-ref (car rows) 0)) #t)
            (else (member-cell? cell (cdr rows)))))
    (define (i2-begin owner capability)
      (let* ((operation 'cpu4-candidate-i2-begin)
             (membership (vector #f))
             (record (vector 'i2-construction #f #f 'aborted (list membership) '()
                             (i2-modules-current) i2-module-count
                             (i2-carrier 'parameter '() 'parameter) 'g3c4 owner))
             (next (cons record (vector-ref i2-construction-registry-root 0))))
        (if (or (vector-ref i2-construction-registry-root 1)
                i2-parameter-admission-carrier (>= i2-module-count 4096)
                (not (= (i2-available) 0)))
            (g3c4-fail 'invalid-state operation "I2 candidate construction is unavailable"))
        (vector-set! i2-construction-registry-root 0 next)
        (let* ((canonical (car (vector-ref i2-construction-registry-root 0)))
               (member (car (vector-ref canonical 4))))
          (guard (caught
                   (#t
                     (if (vector-ref canonical 1)
                         (module-construction-abort-internal! (vector-ref canonical 1)))
                     (i2-construction-rollback-tail! canonical)
                     (vector-set! canonical 1 #f)
                     (vector-set! canonical 7 0)
                     (raise caught)))
            (vector-set! i2-module-registry-root 0
                         (cons member (vector-ref canonical 6)))
            (set! i2-module-count (+ (vector-ref canonical 7) 1))
            (vector-set! i2-construction-registry-root 1 canonical)
            (let* ((scope (p1-begin i2-provider-name capability))
                   (root (module-construction-root-internal scope)))
              (vector-set! canonical 1 scope)
              (vector-set! canonical 2 root)
              (vector-set! member 0 root)
              (vector-set! canonical 3 'open)
              canonical)))))
    (define (i2-retain record)
      ;; Preserve originals before ordinary I2 seal clears its rollback fields.
      (let* ((members (vector-ref record 4))
             (cells
               (let scan ((chain (i2-modules-current)) (rows '()))
                 (if (null? chain) rows
                     (scan (cdr chain)
                       (if (let member-match-loop ((items members))
                             (and (pair? items)
                                  (or (eq? (car chain) (car items))
                                      (member-match-loop (cdr items)))))
                           (cons (vector chain (car chain)
                                         (vector-ref (car chain) 0)) rows) rows)))))
             (carriers
               (let capture ((items (vector-ref record 5)) (rows '()))
                 (if (null? items) rows
                     (let ((carrier (car items)))
                       (capture (cdr items)
                         (cons (vector carrier (vector-ref carrier 2)
                                       (vector-ref carrier 3)) rows)))))))
        (if (not (and (equal? (i2-bounded-list-length cells 17) 17)
                      (equal? (i2-bounded-list-length members 17) 17)
                      (equal? (i2-bounded-list-length carriers 14) 14)))
            (g3c4-fail 'invalid-state 'cpu4-candidate-retain "I2 candidate roster differs"))
        (vector record cells carriers (vector-ref record 8) #f 'live)))
    (define (i2-preflight sidecar)
      (let ((operation 'cpu4-candidate-i2-preflight))
        (if (or (not (eq? (vector-ref sidecar 5) 'live))
                (not (eq? (vector-ref (vector-ref sidecar 0) 3) 'sealed))
                (vector-ref i2-construction-registry-root 1)
                i2-parameter-admission-carrier)
            (g3c4-fail 'invalid-state operation "I2 graph is busy or changed"))
        (let check ((rows (vector-ref sidecar 1)))
          (if (null? rows) #t
              (let ((row (car rows)))
                (if (not (and (eq? (car (vector-ref row 0)) (vector-ref row 1))
                              (eq? (vector-ref (vector-ref row 1) 0) (vector-ref row 2))))
                    (g3c4-fail 'invalid-state operation "I2 original membership changed"))
                (check (cdr rows)))))
        (let check ((rows (vector-ref sidecar 2)))
          (if (null? rows) #t
              (let ((row (car rows)))
                (if (not (and (eq? (vector-ref (vector-ref row 0) 2) (vector-ref row 1))
                              (eq? (vector-ref (vector-ref row 0) 3) (vector-ref row 2))))
                    (g3c4-fail 'invalid-state operation "I2 original carrier changed"))
                (check (cdr rows)))))
        (let scan ((cells (i2-modules-current)) (previous #f)
                   (first #f) (seen 0) (total 0) (plan '()))
          (cond ((null? cells)
                 (if (not (and (= seen 17) (= total i2-module-count)))
                     (g3c4-fail 'invalid-state operation "I2 candidate membership is missing"))
                 (vector-set! sidecar 4
                   (if first (cons (vector previous first '()) plan) plan)))
                ((member-cell? cells (vector-ref sidecar 1))
                 (scan (cdr cells) previous (if first first cells) (+ seen 1) (+ total 1) plan))
                (else
                 (scan (cdr cells) cells #f seen (+ total 1)
                   (if first (cons (vector previous first cells) plan) plan)))))
        #t))
    (define (i2-invalidate sidecar)
      (let splices ((rows (vector-ref sidecar 4)))
        (if (null? rows) #t
            (let ((row (car rows)))
              (if (vector-ref row 0)
                  (set-cdr! (vector-ref row 0) (vector-ref row 2))
                  (vector-set! i2-module-registry-root 0 (vector-ref row 2)))
              (splices (cdr rows)))))
      (set! i2-module-count (- i2-module-count 17))
      (let members ((rows (vector-ref sidecar 1)))
        (if (null? rows) #t
            (begin (vector-set! (vector-ref (car rows) 1) 0 #f)
                   (members (cdr rows)))))
      (let carriers ((rows (vector-ref sidecar 2)))
        (if (null? rows) #t
            (begin (vector-set! (vector-ref (car rows) 0) 2 '())
                   (vector-set! (vector-ref (car rows) 0) 3 '())
                   (carriers (cdr rows)))))
      (vector-set! (vector-ref sidecar 3) 2 '())
      (vector-set! (vector-ref sidecar 3) 3 '())
      (vector-set! (vector-ref sidecar 0) 2 #f)
      (vector-set! (vector-ref sidecar 0) 3 'retired)
      (vector-set! sidecar 1 '())
      (vector-set! sidecar 2 '())
      (vector-set! sidecar 3 #f)
      (vector-set! sidecar 4 #f)
      (vector-set! sidecar 5 'retired)
      #t)
    (define (resolved-seed resolved)
      (x1-private-config-validate resolved)
      (if (not (and (= (x1-private-config-ref resolved 'model.context-length) 4)
                    (= (x1-private-config-ref resolved 'model.hidden-size) 4)
                    (= (x1-private-config-ref resolved 'model.layer-count) 1)
                    (= (x1-private-config-ref resolved 'model.query-head-count) 2)
                    (= (x1-private-config-ref resolved 'model.kv-head-count) 2)
                    (= (x1-private-config-ref resolved 'model.head-size) 2)
                    (= (x1-private-config-ref resolved 'model.vocabulary-size) 256)
                    (eq? (x1-private-config-ref resolved 'model.dtype) 'f32)
                    (eq? (x1-private-config-ref resolved 'model.device) 'cpu)
                    (x1-private-config-ref resolved 'run.deterministic)))
          (g3c4-fail 'unsupported 'cpu4-candidate-model-create-internal!
                      "only the fixed context-four CPU f32 profile is supported"))
      (x1-private-config-ref resolved 'run.seed))
    (define (word-checked owner index operation)
      (let ((word (owner-word owner index)))
        (if (not (= (last-error-category) 0))
            (g3c4-native-fail operation))
        word))
    (define (entry-dead entry)
      (vector-set! entry 2 'dead)
      (let clear ((index 3))
        (if (= index 12) #t
            (begin (vector-set! entry index #f) (clear (+ index 1))))))
    (define (abort-open row)
      ;; Native phase2 proof is mandatory after the exact P1/I2 abort.
      (if (vector-ref row 5)
          (i2-g3c4-construction-abort-internal! (vector-ref row 5)))
      (if (vector-ref row 6) (p1-invalidate (vector-ref row 6)))
      (if (vector-ref row 7)
          (begin
            (vector-set! (vector-ref row 7) 1 '())
            (vector-set! (vector-ref row 7) 2 '())
            (vector-set! (vector-ref row 7) 3 #f)
            (vector-set! (vector-ref row 7) 4 #f)
            (vector-set! (vector-ref row 7) 5 'retired)))
      (if (vector-ref row 2)
          (g3c4-native-check (native-abort (vector-ref row 2))
                              'cpu4-candidate-retire-internal!))
      (entry-dead (vector-ref row 4))
      (vector-set! row 1 'dead)
      (vector-set! row 10 #f)
      #t)
    (define (create resolved)
      (let ((operation 'cpu4-candidate-model-create-internal!)
            (seed (resolved-seed resolved)))
        (m3-call operation
          ;; A failed factory never returns a partial model. Its exact rooted
          ;; candidate remains available for cleanup retry on the next create,
          ;; after the caller releases the faulting external borrow/consumer.
          (let retry ((rows (vector-ref registry 0)))
            (if (null? rows) #t
                (let ((pending (car rows)))
                  (if (eq? (vector-ref pending 1) 'cleanup-blocked)
                      (guard (fault
                               (#t (vector-set! pending 10 fault)
                                   (raise (vector-ref pending 9))))
                        (abort-open pending)))
                  (retry (cdr rows)))))
          (if (or (not (and (m3t-exact-i64? seed) (>= seed 0)))
                  (vector-ref g3c4-model-cleanup-root 0))
              (g3c4-fail 'invalid-state operation "invalid seed or active C4 construction"))
          (let* ((self (vector #f))
                 (original (vector 0 0 0 0)) (successor (vector 0 0 0 0))
                 (handles (make-vector 14 #f)) (prefix-index (vector '()))
                 (entry (vector #f 'c4-model 'pending #f 'seeded
                                original successor #f handles #f #f g3c4-model-profile))
                 (cleanup (vector #f #f 'rollback prefix-index))
                 (row (vector self 'constructing #f #f entry #f #f #f
                              resolved #f #f #f)))
            (vector-set! self 0 self)
            (guard (caught
                     (#t
                       (if (eq? (vector-ref row 1) 'tail) (exit 134))
                       (vector-set! row 9 caught)
                       (guard (fault
                                (#t (vector-set! row 10 fault)
                                    (vector-set! row 1 'cleanup-blocked)
                                    (vector-set! g3c4-model-cleanup-root 0 #f)
                                    (raise caught)))
                         (abort-open row))
                       (vector-set! g3c4-model-cleanup-root 0 #f)
                       (raise caught)))
              ;; Both ledgers and every cleanup cell are rooted before begin.
              (vector-set! registry 0 (cons row (vector-ref registry 0)))
              (set! row (car (vector-ref registry 0)))
              (vector-set! g3c4-model-registry 0
                           (cons (vector-ref row 4) (vector-ref g3c4-model-registry 0)))
              (vector-set! g3c4-model-cleanup-root 0 cleanup)
              (let* ((canonical-entry (vector-ref row 4))
                     (canonical-cleanup (vector-ref g3c4-model-cleanup-root 0))
                     (canonical-handles (vector-ref canonical-entry 8))
                     (canonical-prefix-index (vector-ref canonical-cleanup 3))
                     (capability (native-begin seed)))
                (if (null? capability) (g3c4-native-fail operation))
                (vector-set! row 2 capability)
                (let ((owner (native-owner capability)))
                  (if (null? owner) (g3c4-native-fail operation))
                  (vector-set! row 3 owner)
                  (vector-set! canonical-entry 3 owner)
                  (vector-set! canonical-cleanup 0 owner)
                  (let ((construction (i2-begin owner capability)))
                    (vector-set! row 5 construction)
                    (vector-set! canonical-cleanup 1 construction)
                    (vector-set! canonical-entry 9 construction)
                    (vector-set! canonical-entry 0 (vector-ref construction 2))
                    (vector-set! (vector-ref construction 8) 2
                                 (owner-parameter owner 0))
              (let register ((index 0))
                (if (= index 14) #t
                    (let* ((path (vector-ref g3c4-model-paths index))
                           (parent
                             (g3c4-model-child-parent
                               (vector-ref canonical-entry 0)
                               path canonical-prefix-index))
                           (parameter
                             (owner-parameter owner index)))
                      (if (null? parameter) (g3c4-native-fail operation))
                      (let ((handle
                              (i2-module-register-parameter-internal!
                                parent (g3c4-model-path-leaf path)
                                (i2-carrier
                                  'parameter parameter 'parameter))))
                        (vector-set! canonical-handles index handle)
                        (register (+ index 1))))))
              (let ((parent
                      (g3c4-model-child-parent
                        (vector-ref canonical-entry 0)
                        '("token_embedding" "weight")
                        canonical-prefix-index)))
                (i2-module-register-tied-parameter-internal!
                  parent "weight" (vector-ref canonical-handles 10)))
              (let ((schedule
                      (module-construction-parameters-internal
                        (vector-ref construction 1))))
                (g3c4-model-validate-schedule
                  schedule canonical-handles operation))
              (let initialize ((index 0))
                (if (= index 14) #t
                    (begin
                      (g3c4-native-check
                        (owner-initialize owner index)
                        operation)
                      (initialize (+ index 1)))))
              (let capture ((index 0))
                (if (= index 4) #t
                    (begin
                      (vector-set! (vector-ref canonical-entry 5) index
                        (word-checked owner index operation))
                      (vector-set! (vector-ref canonical-entry 6) index
                        (word-checked owner (+ index 4) operation))
                      (capture (+ index 1)))))
                    (i2-g3c4-construction-prepare-eval-internal! construction)
                    (g3c4-native-check (owner-prepare owner) operation)
                    (g3c4-model-tail-preflight canonical-entry canonical-cleanup operation)
                    ;; Retain original P1 shells and I2 cells BEFORE seal drops
                    ;; rollback fields. No wrapping around a returned model.
                    (vector-set! row 6 (p1-retain (vector-ref construction 1)))
                    (vector-set! row 7 (i2-retain construction))
                    (vector-set! row 1 'tail)
                    (vector-set! canonical-cleanup 2 'tail)
                    (i2-g3c4-construction-seal-prepared-internal! construction)
                    (if (not (= (owner-seal owner) 0)) (exit 134))
                    (vector-set! canonical-entry 9 #f)
                    (vector-set! canonical-entry 2 'live)
                    (vector-set! row 1 'unpublished)
                    (vector-set! g3c4-model-cleanup-root 0 #f)
                    (vector-ref row 0)))))))))
    (define (model candidate)
      (let ((row (unpublished candidate 'cpu4-candidate-model-internal)))
        (vector-ref (vector-ref row 4) 0)))
    (define (adopt candidate generator)
      (let* ((operation 'cpu4-candidate-adopt-internal!)
             (row (unpublished candidate operation))
             (result (vector-ref (vector-ref row 4) 0)))
        (if generator
            (g3c4-fail 'unsupported operation "candidate generator enrollment is not installed"))
        (p1-preflight (vector-ref row 6))
        (i2-preflight (vector-ref row 7))
        (g3c4-native-check (native-adopt (vector-ref row 2) '()) operation)
        ;; Publication boundary. Only fixed writes and preallocated return.
        (vector-set! row 1 'adopted)
        result))
    (define (retire candidate)
      (let* ((operation 'cpu4-candidate-retire-internal!)
             (row (find candidate operation)))
        (cond ((eq? (vector-ref row 1) 'dead) #t)
              ((eq? (vector-ref row 1) 'cleanup-blocked) (abort-open row))
              (else
                (unpublished candidate operation)
                (vector-set! row 11 #t)
                (guard (caught
                         (#t
                           (if (eq? (vector-ref row 1) 'graph-revoked) (exit 134))
                           (vector-set! row 11 #f)
                           (raise caught)))
                  (p1-preflight (vector-ref row 6))
                  (i2-preflight (vector-ref row 7))
                  ;; Initial producer owns no optimizer/generator/transport.
                  ;; Native null/null proof rejects live contexts/consumers.
                  (g3c4-native-check
                    (native-prepare (vector-ref row 2) '() '()) operation)
                  (let ((status (native-graph (vector-ref row 2))))
                    (if (not (= status 0))
                        (guard (first-error
                                 (#t
                                   (if (not (= (native-cancel (vector-ref row 2)) 0))
                                       (exit 134))
                                   (raise first-error)))
                          ;; Construct the exact C4 triple before cancel resets it.
                          (g3c4-native-fail operation))))
                  (vector-set! row 1 'graph-revoked)
                  (p1-invalidate (vector-ref row 6))
                  (i2-invalidate (vector-ref row 7))
                  (if (not (= (native-payload (vector-ref row 2)) 0)) (exit 134))
                  ;; No destructor/callback/allocator after payload destruction.
                  (vector-set! (vector-ref row 4) 2 'dead)
                  (let clear ((index 3))
                    (if (= index 12) #t
                        (begin (vector-set! (vector-ref row 4) index #f)
                               (clear (+ index 1)))))
                  (vector-set! row 1 'dead)
                  (vector-set! row 11 #f)
                  #t)))))
    (vector create model adopt retire)))

(define (cpu4-candidate-model-create-internal! resolved)
  ((vector-ref cpu4-candidate-surface 0) resolved))
(define (cpu4-candidate-model-internal candidate)
  ((vector-ref cpu4-candidate-surface 1) candidate))
(define (cpu4-candidate-adopt-internal! candidate generator-or-false)
  ((vector-ref cpu4-candidate-surface 2) candidate generator-or-false))
(define (cpu4-candidate-retire-internal! candidate)
  ((vector-ref cpu4-candidate-surface 3) candidate))
