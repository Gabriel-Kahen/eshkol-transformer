;;; Read-only post-prefix admission for a future private P2/G2 terminal
;;; coordinator. Load after the prefix coordinator and pending anchor leaf.
;;; This never converts a bytevector to a native pointer or commits output.
;;; It establishes original input/phase identity, not sampled-ID integrity;
;;; paired mutable raw/staging edits still need native terminal validation.

(define (g3c4-p2g2-terminal-prefix-committed-check call input operation)
  (let* ((pending (g3c4-p2g2-terminal-pending-check call operation))
         (record (vector-ref pending 1))
         (stack (vector-ref g3c4-p2g2-prefix-input-anchors 0))
         (prefix (if (pair? stack) (car stack) #f)))
    (if (not (and prefix (vector? prefix) (= (vector-length prefix) 5)
                  (pair? stack) (eq? (car stack) prefix)
                  (eq? (vector-ref prefix 0) call)
                  (eq? (vector-ref prefix 1) input)
                  (eq? (vector-ref prefix 4) (vector-ref record 1))
                  (eq? (g3c4-input-entry-live input operation)
                       (vector-ref prefix 2))
                  (eq? (vector-ref (vector-ref prefix 2) 0) input)
                  (eq? (vector-ref (vector-ref prefix 2) 3)
                       (vector-ref prefix 3))
                  (eq? (vector-ref record 13) 'prefix-committed)
                  (eq? (vector-ref (g3c4-p2g2-anchor-for call) 13)
                       'prefix-committed)
                  (eq? (vector-ref (vector-ref record 14) 3)
                       'p2g2-prefix-committed)
                  (eq? (vector-ref pending 16) 'pending)))
        (g3c4-fail 'invalid-state operation
                   "P2/G2 terminal committed prefix or input changed"))
    #t))
