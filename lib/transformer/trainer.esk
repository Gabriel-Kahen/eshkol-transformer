;;; Installed trainer lease and C2 detached-state lifetime facade.

(require transformer.error_consumer)

(provide trainer-create trainer-release! trainer-step! trainer-evaluate!
         trainer-stop-policy trainer-train! trainer-state trainer-load-state!
         trainer-state-release! metrics-ref)

(define tr3-safe-trainer-create
  (let ()
    (extern void tr3-public-trainer-create ptr ptr ptr ptr ptr ptr
            :real et_e1b_public_tr3_trainer_create_v1)
    (lambda (resolved tokenizer dataset model optimizer)
      (let ((output (vector #f)))
        (tr3-public-trainer-create
          (vector resolved) (vector tokenizer) (vector dataset)
          (vector model) (vector optimizer) output)
        (vector-ref output 0)))))

(define (trainer-create resolved tokenizer dataset model optimizer)
  (tr3-safe-trainer-create resolved tokenizer dataset model optimizer))

(define tr3-safe-trainer-release
  (let ()
    (extern void tr3-public-trainer-release ptr ptr
            :real et_e1b_public_tr3_trainer_release_v1)
    (lambda (trainer)
      (let ((output (vector #f)))
        (tr3-public-trainer-release (vector trainer) output)
        (vector-ref output 0)))))

(define (trainer-release! trainer)
  (tr3-safe-trainer-release trainer))

(define tr3-safe-trainer-step
  (let ()
    (extern void tr3-public-trainer-step ptr ptr
            :real et_e1b_public_tr3_trainer_step_v1)
    (lambda (trainer)
      (let ((output (vector #f)))
        (tr3-public-trainer-step (vector trainer) output)
        (vector-ref output 0)))))

(define (trainer-step! trainer)
  (tr3-safe-trainer-step trainer))

(define tr3-safe-trainer-evaluate
  (let ()
    (extern void tr3-public-trainer-evaluate ptr ptr ptr
            :real et_e1b_public_tr3_trainer_evaluate_v1)
    (lambda (trainer dataset)
      (let ((output (vector #f)))
        (tr3-public-trainer-evaluate (vector trainer) (vector dataset) output)
        (vector-ref output 0)))))

(define (trainer-evaluate! trainer dataset)
  (tr3-safe-trainer-evaluate trainer dataset))

(define tr3-safe-trainer-stop-policy
  (let ()
    (extern void tr3-public-trainer-stop-policy ptr ptr ptr ptr
            :real et_e1b_public_tr3_trainer_stop_policy_v1)
    (lambda (max-tokens max-updates max-epochs)
      (let ((output (vector #f)))
        (tr3-public-trainer-stop-policy
          (vector max-tokens) (vector max-updates) (vector max-epochs)
          output)
        (vector-ref output 0)))))

(define (trainer-stop-policy max-tokens max-updates max-epochs)
  (tr3-safe-trainer-stop-policy max-tokens max-updates max-epochs))

(define tr3-safe-trainer-state
  (let ()
    (extern void tr3-public-trainer-state ptr ptr
            :real et_e1b_public_tr3_trainer_state_v1)
    (lambda (trainer)
      (let ((output (vector #f)))
        (tr3-public-trainer-state (vector trainer) output)
        (vector-ref output 0)))))

(define (trainer-state trainer)
  (tr3-safe-trainer-state trainer))

(define tr3-safe-trainer-load-state
  (let ()
    (extern void tr3-public-trainer-load-state ptr ptr ptr
            :real et_e1b_public_tr3_trainer_load_state_v1)
    (lambda (trainer state)
      (let ((output (vector #f)))
        (tr3-public-trainer-load-state (vector trainer) (vector state) output)
        (vector-ref output 0)))))

(define (trainer-load-state! trainer state)
  (tr3-safe-trainer-load-state trainer state))

(define tr3-safe-trainer-train
  (let ()
    (extern void tr3-public-trainer-train ptr ptr ptr
            :real et_e1b_public_tr3_trainer_train_v1)
    (lambda (trainer stop-policy)
      (let ((output (vector #f)))
        (tr3-public-trainer-train
          (vector trainer) (vector stop-policy) output)
        (vector-ref output 0)))))

(define tr3-safe-trainer-train-interruptible
  (let ()
    (extern void tr3-public-trainer-train-interruptible ptr ptr ptr ptr
            :real et_e1b_public_tr3_trainer_train_interruptible_v1)
    (lambda (trainer stop-policy interrupt-options)
      (let ((output (vector #f))
            (root (vector interrupt-options)))
        (tr3-public-trainer-train-interruptible
          (vector trainer) (vector stop-policy) root output)
        (vector-ref output 0)))))

(define (trainer-train! trainer stop-policy . interrupt)
  (if (null? interrupt)
      (tr3-safe-trainer-train trainer stop-policy)
      (tr3-safe-trainer-train-interruptible
        trainer stop-policy interrupt)))

(define c2-safe-trainer-state-release
  (let ()
    (extern void c2-public-trainer-state-release ptr ptr
            :real et_e1b_public_c2_trainer_state_release_v1)
    (lambda (state)
      (let ((output (vector #f)))
        (c2-public-trainer-state-release (vector state) output)
        (vector-ref output 0)))))

(define (trainer-state-release! state)
  (c2-safe-trainer-state-release state))

(define tr3-safe-metrics-ref
  (let ()
    (extern void tr3-public-metrics-ref ptr ptr ptr
            :real et_e1b_public_tr3_metrics_ref_v1)
    (lambda (metrics key)
      (let ((output (vector #f)))
        (tr3-public-metrics-ref (vector metrics) (vector key) output)
        (vector-ref output 0)))))

(define (metrics-ref metrics key)
  (tr3-safe-metrics-ref metrics key))
