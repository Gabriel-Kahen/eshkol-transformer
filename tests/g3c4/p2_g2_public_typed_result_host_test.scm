(check (eq? rng-entry (g3c4-public-result-rng-entry rng 'test)))
(vector-set! (vector-ref rng-native 1) 3 99)
(check (reject (lambda () (g3c4-public-result-rng-entry rng 'test))))
(vector-set! (vector-ref rng-native 1) 3 43)
(vector-set! rng-native 0 'native-typed)
(check (reject (lambda () (g3c4-public-result-rng-entry rng 'test))))
(vector-set! rng-native 0 'native-rng)
(vector-set! rng-entry 3 (g3c4-native-result-rng-create 1 41 42 43))
(check (reject (lambda () (g3c4-public-result-rng-entry rng 'test))))
(vector-set! rng-entry 3 rng-native)
(let ((saved (vector-ref g3c4-public-g2-result-bindings 0)))
  (vector-set! g3c4-public-g2-result-bindings 0 '())
  (check (reject (lambda () (g3c4-public-result-rng-entry rng 'test))))
  (vector-set! g3c4-public-g2-result-bindings 0 saved))
