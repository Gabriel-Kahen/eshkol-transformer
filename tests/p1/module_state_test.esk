                 '(("z") ("é")))))

(let* ((module (module-create-fixture-internal))
       (child (module-create-fixture-internal))
       (parameter-name (string-copy "parameter"))
       (tie-name (string-copy "tie"))
       (buffer-name (string-copy "buffer"))
       (child-name (string-copy "child"))
       (handle
         (module-register-parameter-internal! module parameter-name
                                              (payload 'owned-name))))
  (module-register-child-internal! module child-name child)
  (module-register-buffer-internal! child buffer-name (buffer-payload 'owned-name))
  (module-register-tied-parameter-internal! child tie-name handle)
  (string-set! parameter-name 0 #\x)
  (string-set! tie-name 0 #\x)
  (string-set! buffer-name 0 #\x)
  (string-set! child-name 0 #\x)
  (check "parameter name is copied"
         (equal? (parameter-tree-paths (module-parameters module))
                 '(("child" "tie") ("parameter"))))
  (check "tied name is copied"
         (equal? (parameter-tree-tie-groups (module-parameters module))
                 '((("child" "tie") ("parameter")))))
  (check "buffer name is copied"
         (equal? (state-dict-paths (module-buffers module))
                 '(("child" "buffer"))))
  (check "child name is copied"
         (equal? (car (car (parameter-tree-paths (module-parameters module))))
                 "child")))

