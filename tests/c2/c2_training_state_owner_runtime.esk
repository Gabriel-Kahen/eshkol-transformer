  (lambda () (c2-o2-encode-c2-owned-staging-internal stale-o2-request)))
(check "stale-token failure publishes nothing"
       (eq? (vector-ref stale-o2-request 4) #f))
(define renewed-borrow
  (c2-training-state-borrow-begin-internal owned 'checkpoint-save!))
(define renewed-token
  (c2-training-state-borrow-owner-token-internal
    renewed-borrow 'checkpoint-save!))
(check "serial borrow receives a distinct exact access identity"
