;;; One test-only same-authority success, later D2 fault, and retry trajectory.
(extern i64 e3-mg-model-count ptr i64 i64
        :real et_e3_test_model_word_count_v1)
(extern i64 e3-mg-model-word ptr i64 i64 i64
        :real et_e3_test_model_word_v1)
(extern i64 e3-mg-gradient-metadata ptr i64 i64
        :real et_e3_test_gradient_metadata_v1)
(extern i64 e3-mg-seed-gradient ptr
        :real et_e3_test_seed_gradient_v1)
(extern void e3-mg-read-fail-stage i64
        :real et_d2_exact_read_test_fail_stage_v1)
(extern i64 e3-mg-retention-probe i64
        :real et_e3_test_retention_probe_v1)

(define (e3-mg-check label condition)
  (if condition #t
      (begin (display "E3-MODE-GRAPH-FAIL: ") (display label) (newline)
             (e3-native-invariant-fail))))

(define (e3-mg-model-image model)
  (let* ((owner (vector-ref (m3t-entry model 'model 'e3-mg-model-image #t) 3))
         (image (make-vector 14 #f)))
    (let parameter ((index 0))
      (if (= index 14) image
          (let ((fields (make-vector 5 #f)))
            (let grad-kind ((kind 0))
              (if (= kind 2) #t
                  (let ((count (e3-mg-model-count owner index kind)))
                    (e3-mg-check 'model-count (and (> count 0) (<= count 1024)))
                    (let ((words (make-vector count 0)))
                      (let word ((offset 0))
                        (if (= offset count) #t
                            (begin
                              (vector-set! words offset
                                (e3-mg-model-word owner index kind offset))
                              (word (+ offset 1)))))
                      (vector-set! fields kind words)
                      (grad-kind (+ kind 1))))))
            (let metadata ((field 0))
              (if (= field 3) #t
                  (begin
                    (vector-set! fields (+ field 2)
                      (e3-mg-gradient-metadata owner index field))
                    (metadata (+ field 1)))))
            (vector-set! image index fields)
            (parameter (+ index 1)))))))

(define (e3-mg-model=? model expected)
  (let ((owner (vector-ref (m3t-entry model 'model 'e3-mg-model=? #t) 3)))
    (let parameter ((index 0))
      (if (= index 14) #t
          (let ((fields (vector-ref expected index)))
            (and
              (let grad-kind ((kind 0))
                (if (= kind 2) #t
                    (let ((words (vector-ref fields kind)))
                      (and (= (e3-mg-model-count owner index kind)
                              (vector-length words))
                           (let word ((offset 0))
                             (if (= offset (vector-length words)) #t
                                 (and (= (e3-mg-model-word owner index kind offset)
                                         (vector-ref words offset))
                                      (word (+ offset 1)))))
                           (grad-kind (+ kind 1))))))
              (let metadata ((field 0))
                (if (= field 3) #t
                    (and (= (e3-mg-gradient-metadata owner index field)
                            (vector-ref fields (+ field 2)))
                         (metadata (+ field 1)))))
              (parameter (+ index 1))))))))

(define (e3-mg-publication frame destinations)
  (vector (e3-test-u32-ref (vector-ref destinations 0))
          (e3-test-u32-ref (vector-ref destinations 1))
          (e3-test-u32-ref (vector-ref destinations 2))
          (e3-test-u32-ref (vector-ref destinations 3))
          (e3-counter-ref frame 0) (e3-counter-ref frame 1)))

(define (e3-mg-events)
  (vector (e3-test-graph-event 0) (e3-test-graph-event 1)
          (e3-test-graph-event 2) (e3-test-graph-event 3)))

(define (e3-mg-probes)
  (let ((values (make-vector 29 0)))
    (let fill ((index 0))
      (if (= index 29) values
          (begin
            (vector-set! values index (e3-mg-retention-probe index))
            (fill (+ index 1)))))))

(define (e3-mg-owner-controls-restored? before)
  (let ((after (e3-mg-probes)))
    (and
      (let check ((index 0))
        (if (= index 29) #t
            (and (if (or (<= index 6) (and (>= index 17) (<= index 26)))
                     (= (vector-ref before index) (vector-ref after index))
                     #t)
                 (check (+ index 1)))))
      (= (- (vector-ref after 14) (vector-ref before 14))
         (- (vector-ref after 16) (vector-ref before 16))))))

(define (e3-mg-report label baseline)
  (let ((count (vector-ref e3-mode-graph-cell 3))
        (events (e3-mg-events)))
    (let notes ((index 0))
      (if (= index count) #t
          (begin
            (display "E3MG-NOTE ") (display label)
            (display " ") (display index) (display " ")
            (display (vector-ref (vector-ref e3-mode-graph-cell 4) index))
            (let event ((field 0))
              (if (= field 4) #t
                  (begin
                    (display " ")
                    (display (- (vector-ref
                                  (vector-ref e3-mode-graph-cell (+ field 5))
                                  index)
                                (vector-ref baseline field)))
                    (event (+ field 1)))))
            (newline)
            (notes (+ index 1)))))
    (display "E3MG-END ") (display label) (display " ") (display count)
    (let event ((index 0))
      (if (= index 4) #t
          (begin
            (display " ")
            (display (- (vector-ref events index)
                        (vector-ref baseline index)))
            (event (+ index 1)))))
    (newline)
    (e3-mg-check 'event-note-count (= (vector-ref e3-mode-graph-cell 3) count))
    #t))

(define (e3-mg-one-call! label model dataset frame destinations
                         cursor image rng publication token probes fault?)
  (e3-mode-graph-clear-observations!)
  (let ((before (e3-mg-events)))
    (if fault? (e3-mg-read-fail-stage 1))
    (let ((failed?
           (with-region ('e3-mode-graph-call 262144)
             (guard
              (caught
               (#t (and fault? (transformer-error? caught)
                        (eq? (transformer-error-category caught) 'io)
                        (eq? (transformer-error-operation caught)
                             'e3-evaluate-into!))))
              (e3-evaluate-into! model dataset frame)
              #f))))
      (if fault? (e3-mg-read-fail-stage 0))
      (e3-mg-check 'fault-category (eq? failed? fault?))
      (e3-mg-check 'cursor (d2-core-bytes=? cursor
                                       (d2-token-dataset-cursor dataset)))
      (e3-mg-check 'model-image (e3-mg-model=? model image))
      (e3-mg-check 'rng
        (equal? rng (m3t-public-initializer-words
                     (m3t-public-model-initializer model))))
      (e3-mg-check 'mixed17-restored
        (= (p1-e3-test-mode-mask token) 43690))
      (e3-mg-check 'output
        (equal? publication (e3-mg-publication frame destinations)))
      (e3-mg-check 'no-live-graphs (= (e3-test-graph-event 3) 0))
      (e3-mg-check 'owner-controls-restored
        (e3-mg-owner-controls-restored? probes))
      (e3-mg-report label before)
      #t)))

(define (e3-mg-original-dispatch scenario corpus-path)
  (e3-mg-check 'scenario
    (and (vector? scenario) (= (vector-length scenario) 1)
         (boolean? (vector-ref scenario 0))))
  (let* ((fixture (e3-test-fixture))
         (model (vector-ref fixture 0))
         (tokenizer (vector-ref fixture 1))
         (destinations (vector-ref fixture 2))
         (frame (vector-ref fixture 3))
         (entry (e3-frame-entry-internal frame))
         (token (vector-ref entry 6))
         (input (g3t-checked-m3t-input-create))
         (dataset (d2-token-dataset-open
                   (e3-test-dataset-config corpus-path #t) tokenizer)))
    (guard
     (caught
      (#t
       (e3-mg-read-fail-stage 0)
       (d2-token-dataset-close! dataset)
       (g3t-checked-m3t-input-release! input)
       (raise caught)))
     (e3-mg-check 'input-copy
       (g3t-checked-m3t-input-copy! input '(3 197)))
     (e3-mg-check 'fixed-mixed (= (p1-e3-test-fixed-mixed! token) 0))
     (if (vector-ref scenario 0)
         (e3-mg-check 'seed-gradient
           (= (e3-mg-seed-gradient (vector-ref
                (m3t-entry model 'model 'e3-mode-graph-dispatch #t) 3)) 0)))
     (e3-mode-graph-arm! model frame input)
     (let* ((cursor (d2-token-dataset-cursor dataset))
            (image (e3-mg-model-image model))
            (rng (m3t-public-initializer-words
                   (m3t-public-model-initializer model)))
            (probes (e3-mg-probes)))
       (e3-mode-graph-clear-observations!)
       (let ((initial (e3-mg-events)))
         (with-region ('e3-mode-graph-success 262144)
           (e3-evaluate-into! model dataset frame))
         (e3-mg-check 'success-cursor
           (d2-core-bytes=? cursor (d2-token-dataset-cursor dataset)))
         (e3-mg-check 'success-image (e3-mg-model=? model image))
         (e3-mg-check 'success-modes
           (= (p1-e3-test-mode-mask token) 43690))
         (e3-mg-check 'success-rng
           (equal? rng (m3t-public-initializer-words
                         (m3t-public-model-initializer model))))
         (e3-mg-check 'success-graph-live (= (e3-test-graph-event 3) 0))
         (e3-mg-check 'success-owner-controls
           (e3-mg-owner-controls-restored? probes))
         (e3-mg-report 'success initial))
       (let ((publication (e3-mg-publication frame destinations)))
         (e3-mg-check 'three-batch-counters
           (and (= (vector-ref publication 4) 5)
                (= (vector-ref publication 5) 3)))
         (e3-mg-one-call! 'later-failure model dataset frame destinations
                          cursor image rng publication token probes #t)
         (e3-mg-one-call! 'retry model dataset frame destinations
                          cursor image rng publication token probes #f)))
     (d2-token-dataset-close! dataset)
     (g3t-checked-m3t-input-release! input)
     #t)))

;;; The N5 scenario is a separate one-over preflight case in this noninstalled
;;; tuple. It reuses the authentic M3/frame fixture and the test-only mode and
;;; native entry probes; the normal mode/graph trajectory above is unchanged.
(define (e3-n5-native-entries)
  (vector (e3-mg-retention-probe 29) (e3-mg-retention-probe 30)
          (e3-mg-retention-probe 31) (e3-mg-retention-probe 32)))

(define (e3-n5-error-detail details key)
  (cond ((null? details) #f)
        ((eq? (car (car details)) key) (cadr (car details)))
        (else (e3-n5-error-detail (cdr details) key))))

(define (e3-n5-last-row)
  (vector (e3-mg-retention-probe 33) (e3-mg-retention-probe 34)
          (e3-mg-retention-probe 35) (e3-mg-retention-probe 36)))

(define (e3-n5-exact-limit path model frame destinations tokenizer token)
  (let* ((dataset (d2-token-dataset-open
                   (e3-test-dataset-config path #t) tokenizer))
         (cursor (d2-token-dataset-cursor dataset))
         (publication (e3-mg-publication frame destinations))
         (image (e3-mg-model-image model))
         (rng (m3t-public-initializer-words
               (m3t-public-model-initializer model)))
         (modes (p1-e3-test-mode-mask token))
         (probes (e3-mg-probes))
         (events (e3-mg-events))
         (native (e3-n5-native-entries))
         (last-row (e3-n5-last-row)))
    (guard
     (caught
      (#t (e3-mg-read-fail-stage 0)
          (vector-set! e3-mode-graph-cell 9 #f)
          (d2-token-dataset-close! dataset)
          (raise caught)))
     ;; Only this long N5 call may exceed the ordinary four-note witness.
     (vector-set! e3-mode-graph-cell 9 #t)
     (e3-mode-graph-clear-observations!)
     (e3-mg-read-fail-stage 1)
     (let ((failed
            (with-region ('e3-n5-exact-first-failure 262144)
              (guard (caught (#t caught))
                (e3-evaluate-into! model dataset frame)
                #f))))
       (e3-mg-read-fail-stage 0)
       (e3-mg-check 'n5-exact-first-read-failure
         (and (transformer-error? failed)
              (eq? (transformer-error-category failed) 'io)
              (eq? (transformer-error-operation failed) 'e3-evaluate-into!)))
       (e3-mg-check 'n5-exact-first-no-partial-output
         (equal? publication (e3-mg-publication frame destinations)))
       (e3-mg-check 'n5-exact-first-cursor
         (d2-core-bytes=? cursor (d2-token-dataset-cursor dataset)))
       (let ((after (e3-n5-native-entries)))
         (e3-mg-check 'n5-exact-first-no-staged-batch
           (and (= (- (vector-ref after 0) (vector-ref native 0)) 1)
                (= (vector-ref after 1) (vector-ref native 1))
                (= (vector-ref after 2) (vector-ref native 2))
                (= (vector-ref after 3) (vector-ref native 3)))))
       (e3-mg-check 'n5-exact-first-no-last-row
         (equal? last-row (e3-n5-last-row)))
       (e3-mg-check 'n5-exact-first-note
         (= (vector-ref e3-mode-graph-cell 3) 1))
       (e3-mg-check 'n5-exact-first-owner
         (e3-mg-owner-controls-restored? probes))
       (e3-mg-check 'n5-exact-first-model (e3-mg-model=? model image))
       (e3-mg-check 'n5-exact-first-modes
         (= modes (p1-e3-test-mode-mask token)))
       (e3-mg-check 'n5-exact-first-graph (equal? events (e3-mg-events))))
     (e3-mode-graph-clear-observations!)
     (let ((before (e3-n5-native-entries)))
       (with-region ('e3-n5-exact-success 262144)
         (e3-evaluate-into! model dataset frame))
       (let ((result (e3-mg-publication frame destinations))
             (after (e3-n5-native-entries)))
         (e3-mg-check 'n5-exact-counts
           (and (= (vector-ref result 1) 1182792704)
                (= (vector-ref result 4) 16383)
                (= (vector-ref result 5) 8192)))
         (e3-mg-check 'n5-exact-last-row
           (equal? (e3-n5-last-row) (vector 255 0 1 0)))
         (e3-mg-check 'n5-exact-native-entries
           (and (= (- (vector-ref after 0) (vector-ref before 0)) 1)
                (= (- (vector-ref after 1) (vector-ref before 1)) 8192)
                (= (- (vector-ref after 2) (vector-ref before 2)) 172032)
                (= (- (vector-ref after 3) (vector-ref before 3)) 8192)))
         (e3-mg-check 'n5-exact-notes
           (= (vector-ref e3-mode-graph-cell 3) 8193))
         (e3-mg-check 'n5-exact-cursor
           (d2-core-bytes=? cursor (d2-token-dataset-cursor dataset)))
         (e3-mg-check 'n5-exact-owner
           (e3-mg-owner-controls-restored? probes))
         (e3-mg-check 'n5-exact-model (e3-mg-model=? model image))
         (e3-mg-check 'n5-exact-rng
           (equal? rng (m3t-public-initializer-words
                         (m3t-public-model-initializer model))))
         (e3-mg-check 'n5-exact-modes
           (= modes (p1-e3-test-mode-mask token)))
         (e3-mg-check 'n5-exact-graph (equal? events (e3-mg-events)))
         (e3-mg-check 'n5-exact-idle-frame
           (= (e3-mg-retention-probe 20) 0))
         (e3-mg-check 'n5-exact-no-live-batch
           (and (= (e3-mg-retention-probe 23) 0)
                (= (e3-mg-retention-probe 24) 0)))))
     (vector-set! e3-mode-graph-cell 9 #f)
     (d2-token-dataset-close! dataset)
     #t)))

(define (e3-n5-run paths)
  (e3-mg-check 'n5-paths
    (and (vector? paths) (= (vector-length paths) 3)
         (string? (vector-ref paths 0)) (string? (vector-ref paths 1))
         (string? (vector-ref paths 2))))
  (let* ((fixture (e3-test-fixture))
         (model (vector-ref fixture 0))
         (tokenizer (vector-ref fixture 1))
         (destinations (vector-ref fixture 2))
         (frame (vector-ref fixture 3))
         (entry (e3-frame-entry-internal frame))
         (token (vector-ref entry 6))
         (input (g3t-checked-m3t-input-create))
         (large (d2-token-dataset-open
                 (e3-test-dataset-config (vector-ref paths 0) #t) tokenizer)))
    (guard
     (caught (#t (d2-token-dataset-close! large)
                  (g3t-checked-m3t-input-release! input) (raise caught)))
     (e3-mg-check 'n5-fixed-mixed (= (p1-e3-test-fixed-mixed! token) 0))
     (e3-mg-check 'n5-input-copy
       (g3t-checked-m3t-input-copy! input '(3 197)))
     (e3-mode-graph-arm! model frame input)
     (e3-mode-graph-clear-observations!)
     (let* ((cursor (d2-token-dataset-cursor large))
            (model-image (e3-mg-model-image model))
            (rng (m3t-public-initializer-words
                  (m3t-public-model-initializer model)))
            (modes (p1-e3-test-mode-mask token))
            (publication (e3-mg-publication frame destinations))
            (events (e3-mg-events))
            (native (e3-n5-native-entries))
            (probes (e3-mg-probes))
            (failed
             (with-region ('e3-n5-one-over 262144)
               (guard (caught (#t caught))
                 (e3-evaluate-into! model large frame)
                 #f))))
       (e3-mg-check 'n5-typed-stage-two
         (and (transformer-error? failed)
              (eq? (transformer-error-category failed) 'unsupported)
              (eq? (transformer-error-operation failed) 'e3-evaluate-into!)
              (string=? (transformer-error-message failed)
                        "evaluation dataset preparation failed")
              (let ((details (transformer-error-details failed)))
                (and (eq? (e3-n5-error-detail details 'source-domain)
                          'e3-evaluation)
                     (= (e3-n5-error-detail details 'source-code) 2)))
              (= (vector-ref (vector-ref entry 12) 0) 2)))
       (e3-mg-check 'n5-cursor
         (d2-core-bytes=? cursor (d2-token-dataset-cursor large)))
       (e3-mg-check 'n5-modes (= modes (p1-e3-test-mode-mask token)))
       (e3-mg-check 'n5-six-output
         (equal? publication (e3-mg-publication frame destinations)))
       (e3-mg-check 'n5-no-native-entry
         (equal? native (e3-n5-native-entries)))
       (e3-mg-check 'n5-no-graph-entry (equal? events (e3-mg-events)))
       (e3-mg-check 'n5-model (e3-mg-model=? model model-image))
       (e3-mg-check 'n5-rng
         (equal? rng (m3t-public-initializer-words
                       (m3t-public-model-initializer model))))
       (e3-mg-check 'n5-owners (e3-mg-owner-controls-restored? probes))
       (e3-mg-check 'n5-idle-frame (= (e3-mg-retention-probe 20) 0))
       (e3-mg-check 'n5-no-live-batch
         (and (= (e3-mg-retention-probe 23) 0)
              (= (e3-mg-retention-probe 24) 0)))
       (d2-token-dataset-close! large)
       (let* ((small (d2-token-dataset-open
                      (e3-test-dataset-config (vector-ref paths 1) #t)
                      tokenizer))
              (small-cursor (d2-token-dataset-cursor small)))
         (guard (caught (#t (d2-token-dataset-close! small) (raise caught)))
           (with-region ('e3-n5-small-retry 262144)
             (e3-evaluate-into! model small frame))
           (e3-mg-check 'n5-retry-cursor
             (d2-core-bytes=? small-cursor (d2-token-dataset-cursor small)))
           (e3-mg-check 'n5-retry-output
             (equal? (e3-mg-publication frame destinations)
                     (vector 1085366897 1084227584 1132430055 0 5 3)))
           (e3-mg-check 'n5-retry-same-model
             (and (e3-mg-model=? model model-image)
                  (equal? rng (m3t-public-initializer-words
                                (m3t-public-model-initializer model)))))
           (e3-mg-check 'n5-retry-modes
             (= modes (p1-e3-test-mode-mask token)))
           (let ((after (e3-n5-native-entries)))
             (e3-mg-check 'n5-observer-positive-control
               (and (= (- (vector-ref after 0) (vector-ref native 0)) 1)
                    (= (- (vector-ref after 1) (vector-ref native 1)) 3)
                    (= (- (vector-ref after 2) (vector-ref native 2)) 63)
                    (= (- (vector-ref after 3) (vector-ref native 3)) 3))))
           (d2-token-dataset-close! small)))
       (e3-n5-exact-limit (vector-ref paths 2) model frame destinations
                          tokenizer token)
       (g3t-checked-m3t-input-release! input)
       #t))))

(define (e3-mode-graph-dispatch scenario corpus-path)
  (if (and (vector? scenario) (= (vector-length scenario) 1)
           (eq? (vector-ref scenario 0) 'n5-8193))
      (e3-n5-run corpus-path)
      (e3-mg-original-dispatch scenario corpus-path)))
