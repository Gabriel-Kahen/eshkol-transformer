;;; One ordinary installed-facade caller, invoked in separate OS processes.
;;; The only test extension reads the physical bits of public f32 metrics.
(require transformer.config)
(require transformer.capabilities)
(require transformer.data)
(require transformer.diagnostic_transport)
(require transformer.module)
(require transformer.optim)
(require transformer.persistence)
(require transformer.tokenizer)
(require transformer.trainer)
(require transformer.error_consumer)

(extern i64 f32-bits ptr :real et_tr3_public_resume_f32_bits_v1)
(extern i64 poll-delay :real et_tr3_public_resume_poll_delay_v1)

(define (check label okay)
  (if (not okay)
      (begin (display "TR3-PUBLIC-RESUME-FAIL ") (display label)
             (newline) (exit 1))))
(define (expect-error label category operation thunk)
  (check label
    (guard (raised
             (#t (and (transformer-error? raised)
                      (eq? (transformer-error-category raised) category)
                      (eq? (transformer-error-operation raised) operation))))
      (thunk) #f)))
(define (seen? value values)
  (if (null? values) #f
      (or (eq? value (car values)) (seen? value (cdr values)))))
(define (reverse-list values)
  (let loop ((source values) (result '()))
    (if (null? source) result
        (loop (cdr source) (cons (car source) result)))))
(define (unique-paths tree)
  (let loop ((source (parameter-tree-paths tree)) (seen '()) (result '()))
    (if (null? source) (reverse-list result)
        (let ((handle (parameter-tree-handle tree (car source))))
          (if (seen? handle seen)
              (loop (cdr source) seen result)
              (loop (cdr source) (cons handle seen)
                    (cons (car source) result)))))))
(define (bytes=? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))
(define (read-bytes path)
  (let* ((port (open-binary-input-file path))
         (bytes (read-bytevector (file-size path) port)))
    (close-port port) bytes))
(define (write-bytes path bytes)
  (let ((port (open-binary-output-file path)))
    (write-bytevector bytes port)
    (close-port port)))
(define (dataset-options directory)
  (list ':directory directory ':batch-size 1 ':sequence-length 2
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 4 ':maximum-batch-bytes 34
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #t))
(define args (cdr (command-line)))
(define directory (car args))
(define mode (car (cdr args)))
(define accumulation (string->number (car (cdr (cdr args)))))
(check 'accumulation (or (= accumulation 1) (= accumulation 2)
                         (= accumulation 3)))
(check 'mode (or (string=? mode "baseline") (string=? mode "train-baseline")
                 (string=? mode "producer") (string=? mode "receiver")))
(define checkpoint-policy
  (persistence-policy 16777216 524288 8388608 64 'cpu))
(define report (capability-discover))
(define (path prefix ordinal)
  (string-append directory "/resume-" prefix "-"
                 (number->string ordinal) ".c2"))
(define (tuple seed)
  (let* ((resolved
           (config-resolve
             (config-parse
               (string-append
                 "{\"config-schema-major\":1,\"config-schema-minor\":0,"
                 "\"model.context-length\":2,\"model.hidden-size\":4,"
                 "\"model.layer-count\":1,\"model.query-head-count\":2,"
                 "\"model.vocabulary-size\":256,\"run.seed\":"
                 (number->string seed) ",\"training.accumulation-steps\":"
                 (number->string accumulation) "}"))
             '()))
         (tokenizer (tokenizer-byte resolved))
         (dataset (token-dataset-open (dataset-options directory) tokenizer))
         (model (with-region ('tr3-public-resume-model 65536)
                  (diagnostic-model-create
                    resolved (diagnostic-initializer-state seed))))
         (tree (module-parameters model))
         (optimizer
           (optimizer-create
             (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
                   '(none) '(linear 2 6 "3dcccccd")
                   (list (list 'group (unique-paths tree)
                               "3dcccccd" "3f000000" "3f000000"
                               "3a83126f" "00000000")))
             tree)))
    (vector (trainer-create resolved tokenizer dataset model optimizer)
            dataset)))
(define (save trainer prefix ordinal)
  (let ((state (trainer-state trainer)))
    (check 'save (checkpoint-save! state (path prefix ordinal)
                                   checkpoint-policy '()))
    (check 'state-release (trainer-state-release! state))))
(define (step trainer ordinal prefix)
  (let ((metrics (trainer-step! trainer)))
    (check 'step-schema
      (and (= (metrics-ref metrics 'update) ordinal)
           (= (metrics-ref metrics 'microbatches) accumulation)
           (> (metrics-ref metrics 'tokens) 0)
           (>= (f32-bits (vector (metrics-ref metrics 'loss))) 0)
           (>= (f32-bits (vector (metrics-ref metrics 'mask-weight))) 0)))
    (display "METRIC ") (display ordinal) (display " ")
    (display (f32-bits (vector (metrics-ref metrics 'loss)))) (display " ")
    (display (f32-bits (vector (metrics-ref metrics 'mask-weight))))
    (display " ") (display (metrics-ref metrics 'tokens))
    (display " ") (display (metrics-ref metrics 'microbatches))
    (display " ") (display (metrics-ref metrics 'update)) (newline)
    (save trainer prefix ordinal)))
(define (train-one trainer ordinal prefix interrupt?)
  (let ((summary
          (if interrupt?
              (trainer-train! trainer (trainer-stop-policy #f 4 #f)
                              interrupt?)
              (trainer-train! trainer (trainer-stop-policy #f 1 #f)))))
    (check 'train-one-schema
      (and (= (metrics-ref summary 'updates) 1)
           (> (metrics-ref summary 'tokens) 0)
           (>= (metrics-ref summary 'epochs) 0)
           (>= (f32-bits (vector (metrics-ref summary 'loss))) 0)
           (>= (f32-bits (vector (metrics-ref summary 'mask-weight))) 0)))
    (display "TRAIN ") (display ordinal) (display " ")
    (display (f32-bits (vector (metrics-ref summary 'loss)))) (display " ")
    (display (f32-bits (vector (metrics-ref summary 'mask-weight))))
    (display " ") (display (metrics-ref summary 'tokens))
    (display " ") (display (metrics-ref summary 'updates))
    (display " ") (display (metrics-ref summary 'epochs)) (newline)
    (save trainer prefix ordinal)))

(define main (tuple 1729))
(define trainer (vector-ref main 0))
(define dataset (vector-ref main 1))
(cond
  ((string=? mode "baseline")
   (let loop ((ordinal 1))
     (if (> ordinal 4) #t
         (begin (step trainer ordinal "baseline")
                (loop (+ ordinal 1))))))
  ((string=? mode "train-baseline")
   (let ((summary (trainer-train! trainer (trainer-stop-policy #f 4 #f))))
     (check 'uninterrupted-train
       (and (= (metrics-ref summary 'updates) 4)
            (> (metrics-ref summary 'tokens) 0)
            (> (f32-bits (vector (metrics-ref summary 'loss))) 0)
            (> (f32-bits (vector (metrics-ref summary 'mask-weight))) 0)))
     (display "FULL ")
     (display (f32-bits (vector (metrics-ref summary 'loss))))
     (display " ")
     (display (f32-bits (vector (metrics-ref summary 'mask-weight))))
     (display " ") (display (metrics-ref summary 'tokens))
     (display " ") (display (metrics-ref summary 'updates))
     (display " ") (display (metrics-ref summary 'epochs)) (newline)
     (save trainer "train-baseline" 4)))
  ((string=? mode "producer")
   (let ((ack (vector #f))
         (idle-state (trainer-state trainer)))
     (train-one trainer 1 "k"
       (lambda ()
         (let ((ready (string-append directory "/interrupt-ready"))
               (request (string-append directory "/interrupt-request"))
               (receipt (string-append directory "/interrupt-ack"))
               (cursor-before (token-dataset-cursor dataset)))
           (check 'request-not-early (not (file-exists? request)))
           (write-bytes ready (bytevector 1))
           (let loop ((attempt 0))
             (if (file-exists? request) #t
                 (if (= attempt 30000)
                     (begin (check 'request-timeout #f) #f)
                     (begin
                       (check 'poll-delay (= (poll-delay) 1))
                       (loop (+ attempt 1))))))
           (check 'external-request (= (file-size request) 1))
           (expect-error 'poll-state 'invalid-state 'trainer-state
             (lambda () (trainer-state trainer)))
           (expect-error 'poll-load 'invalid-state 'trainer-load-state!
             (lambda () (trainer-load-state! trainer idle-state)))
           (expect-error 'poll-evaluate 'invalid-state 'trainer-evaluate!
             (lambda () (trainer-evaluate! trainer dataset)))
           (check 'poll-cursor-preserved
             (bytes=? cursor-before (token-dataset-cursor dataset)))
           (write-bytes receipt (bytevector 1)))
         (vector-set! ack 0 #t)
         #t))
     (check 'interrupt-ack (vector-ref ack 0))
     (check 'idle-state-release (trainer-state-release! idle-state))
     (display "INTERRUPT-ACK 1") (newline)))
  (else
   (let* ((before-cursor (token-dataset-cursor dataset))
          (original (read-bytes (path "k" 1)))
          (corrupt (bytevector-copy original 0 (bytevector-length original)))
          (last (- (bytevector-length corrupt) 1)))
     (save trainer "fresh-before" 0)
     (bytevector-u8-set! corrupt last
       (if (= (bytevector-u8-ref corrupt last) 0) 1 0))
     (write-bytes (path "corrupt" 0) corrupt)
     (expect-error 'corrupt-load 'corrupt-data 'checkpoint-load
       (lambda () (checkpoint-load (path "corrupt" 0)
                                   checkpoint-policy report)))
     (check 'corrupt-cursor-preserved
            (bytes=? before-cursor (token-dataset-cursor dataset)))
     (save trainer "fresh-after" 0)
     (let ((loaded (checkpoint-load (path "k" 1)
                                    checkpoint-policy report))
           (mismatch (tuple 9876)))
       (let ((wrong-trainer (vector-ref mismatch 0))
             (wrong-dataset (vector-ref mismatch 1)))
         (save wrong-trainer "mismatch-before" 0)
         (expect-error 'config-mismatch 'invalid-state 'trainer-load-state!
           (lambda () (trainer-load-state! wrong-trainer loaded)))
         (save wrong-trainer "mismatch-after" 0)
         (check 'mismatch-release (trainer-release! wrong-trainer))
         (check 'mismatch-close (token-dataset-close! wrong-dataset)))
       (check 'public-load (trainer-load-state! trainer loaded))
       (check 'loaded-state-release (trainer-state-release! loaded)))
     (save trainer "restored" 1)
     (let loop ((ordinal 2))
       (if (> ordinal 4) #t
           (begin (train-one trainer ordinal "resumed" #f)
                  (loop (+ ordinal 1))))))))
(check 'release (trainer-release! trainer))
(check 'close (token-dataset-close! dataset))
(display "TR3-PUBLIC-FRESH-RESUME-PASS ")
(display mode) (display " A=") (display accumulation) (newline)
