;; Injected only into the private P1 lexical closure. The aggregate roots the
;; enrollment cell before entry; the same canonical record registry owns this
;; construction. No second token or construction registry is created.
(define (candidate-construction-begin provider-name enrollment-cell)
  (let* ((operation 'module-candidate-construction-begin-internal)
         (row (g3r-candidate-cell-entry enrollment-cell operation)))
    (reject-protected-storage-comparison-reentry operation)
    (if (not (and (eq? provider-name 'i2-dense-cpu-f32-v1)
                  (eq? (vector-ref row 0)
                       (vector-ref g3r-candidate-ledgers 1))
                  (eq? (vector-ref row 7) 'armed)
                  (eq? (vector-ref (vector-ref row 0) 1) 'building)
                  (eq? (vector-ref row 3)
                       (vector-ref (vector-ref row 0) 4))
                  (eq? (vector-ref row 4)
                       (vector-ref (vector-ref row 0) 5))
                  (eq? (vector-ref row 5)
                       (vector-ref (vector-ref row 0) 6))
                  (eq? (vector-ref (vector-ref row 5) 6)
                       (vector-ref row 4))
                  (eq? (vector-ref (vector-ref row 3) 0)
                       (vector-ref row 8))
                  (not (eq? (vector-ref row 8) #f))
                  (eq? (vector-ref (vector-ref row 5) 1) 'admitting)
                  (eq? (vector-ref row 6)
                       (vector-ref enrollment-cell 1))
                  (vector? enrollment-cell)
                  (= (vector-length enrollment-cell) 2)
                  (eq? (vector-ref enrollment-cell 0) #f)
                  (vector? (vector-ref enrollment-cell 1))
                  (= (vector-length (vector-ref enrollment-cell 1)) 5)
                  (eq? (vector-ref (vector-ref enrollment-cell 1) 0)
                       'g3r-candidate-p1)
                  (eq? (vector-ref (vector-ref enrollment-cell 1) 1) 'inert)
                  (eq? (vector-ref (vector-ref enrollment-cell 1) 2) #f)
                  (null? (vector-ref (vector-ref enrollment-cell 1) 3))
                  (eq? (vector-ref (vector-ref enrollment-cell 1) 4) #f)))
        (fail 'invalid-argument operation "invalid candidate enrollment" '()))
    (require-provider-name operation provider-name)
    (if (or (active-construction) construction-busy?)
        (fail 'invalid-state operation "nested construction" '()))
    ;; Consume authority before the first native candidate token.
    (vector-set! row 7 'consumed)
    (let* ((sidecar (vector-ref enrollment-cell 1))
           (record (vector #f 'aborted provider-name #f #f sidecar))
           (next (cons record (vector-ref construction-registry-root 0)))
           (identity #f))
      (vector-set! construction-registry-root 0 next)
      (let ((canonical (car (vector-ref construction-registry-root 0))))
        (guard (caught
                 (#t
                   (guard (cleanup (#t (exit 134)))
                     (if identity
                         (if (eq? (vector-ref canonical 1) 'open)
                             (construction-abort! identity)
                             (native-check operation
                               (p1-native-construction-abort
                                 native-context identity))))
                     (vector-set! enrollment-cell 0 #f)
                     (vector-set! sidecar 1 'aborted)
                     (vector-set! sidecar 2 #f)
                     (vector-set! sidecar 3 '())
                     (vector-set! sidecar 4 #f)
                     (vector-set! row 7 'aborted))
                   (raise caught)))
          (native-check operation
            (p1-native-candidate-construction-begin native-context))
          ;; This lexical slot owns the native return before any rooted write.
          (set! identity (p1-native-result-ptr native-context))
          (if (null? identity)
              (fail 'internal operation "candidate begin omitted identity" '()))
          (vector-set! canonical 0 identity)
          (vector-set! sidecar 4 identity)
          (vector-set! enrollment-cell 0 identity)
          (vector-set! canonical 1 'open)
          (vector-set! construction-registry-root 1 identity)
          (let ((root (shell-for-raw 'module
                        (module-create-with-provider-internal provider-name))))
            (vector-set! (construction-record operation identity) 3 root)
            (vector-set! sidecar 2 root)
            (vector-set! sidecar 1 'open)
            identity))))))

(define (candidate-construction-shells identity)
  (let loop ((remaining (shell-registry-current)) (found '()))
    (if (null? remaining) found
        (let ((entry (car remaining)))
          (loop (cdr remaining)
            (if (and (= (vector-length entry) 4)
                     (or (eq? (vector-ref entry 1) 'module)
                         (eq? (vector-ref entry 1) 'handle))
                     (eq? (vector-ref entry 3) identity))
                (cons entry found) found))))))
