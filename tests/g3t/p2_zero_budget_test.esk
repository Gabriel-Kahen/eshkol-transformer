              g1-regression-native g1-regression-output)))
(define g1-staging (make-bytevector 8 0))
(define g1-raw (make-bytevector 1 0))
(check "G1 regression ID stage"
       (= 0 (g3t-native-output-copy-decode-ids
              g1-regression-native g1-regression-output g1-staging)))
