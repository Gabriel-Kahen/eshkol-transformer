;;; Closed serial/nonregional CPU4 -> actual public G2 ownership handoff.
;;; Load AFTER the accepted CPU4 checkpoint/children and genuine public-G2
;;; dispatch in ONE identity aggregate. No callback, raw getter or facade.
(extern i32 cpu4-handoff-native-o2-commit ptr ptr
        :real et_o2_private_candidate_retire_commit_v1)
(define cpu4-handoff-tag (vector 'cpu4-public-g2-handoff-v1))
(define cpu4-handoffs (vector '()))
;;; [tag,self,ticket,phase,child-token,child-row,model,model-entry,generation-T1,
;;; copied-config,policy-words,RNG-shell,RNG-entry-or-seed,RNG-words,generator,
;;; result-pair,first-error,last-error,busy,training-T2,caller-D2,trainer,binding,plan].
(define (cpu4-handoff-row ticket operation)
  (let find ((rows (vector-ref cpu4-handoffs 0)))
    (cond ((null? rows) (cpu4-binding-fail 'invalid-argument operation "foreign handoff ticket"))
          ((eq? ticket (vector-ref (car rows) 2))
           (let ((row (car rows)))
             (if (not (and (vector? row) (= (vector-length row) 24)
                           (eq? (vector-ref row 0) cpu4-handoff-tag)
                           (eq? (vector-ref row 1) row)))
                 (cpu4-binding-fail 'invalid-state operation "handoff identity changed"))
             row))
          (else (find (cdr rows))))))
(define (cpu4-handoff-config config operation)
  ;; Use the REAL public parser/normalizer; do not create another policy parser.
  (let* ((parsed (g3c4-public-profile-config config operation))
         (normalized (g3c4-normalize-config (vector-ref parsed 0) operation))
         (policy (vector-ref normalized 0))
         (rng-shell (if (vector-ref parsed 1) (vector-ref parsed 2) #f))
         (source (if rng-shell (g3c4-public-result-rng-entry rng-shell operation)
                     (vector-ref normalized 2)))
         (words (if rng-shell (g3c4-rng-capture (vector-ref source 3) operation) #f)))
    (if (not (and (eq? (vector-ref parsed 3) 'diagnostic-c4-p2g2)
                  (= (vector-ref policy 5) 2)
                  (m3t-exact-i64? (vector-ref policy 6))
                  (<= 0 (vector-ref policy 6)) (<= (vector-ref policy 6) 255)))
        (cpu4-binding-fail 'invalid-argument operation "handoff requires the actual public G2 profile"))
    ;; Parser proved16 scalar/opaque-identity fields. Copy cons cells so callers
    ;; cannot silently substitute profile/policy/seed/RNG source on a retry.
    (let copy ((tail config) (left 16) (result '()))
      (if (= left 0)
          (vector (o2-reverse result)
                  (vector (vector-ref policy 0) (vector-ref policy 1) (vector-ref policy 2)
                          (vector-ref policy 3) (vector-ref policy 4) (vector-ref policy 5)
                          (vector-ref policy 6))
                  rng-shell source words)
          (copy (cdr tail) (- left 1) (cons (car tail) result))))))
(define (cpu4-handoff-config-recheck! row operation)
  (let ((current (cpu4-handoff-config (vector-ref row 9) operation)))
    (if (not (and (equal? (vector-ref current 1) (vector-ref row 10))
                  (eq? (vector-ref current 2) (vector-ref row 11))
                  (if (vector-ref row 11)
                      (and (eq? (vector-ref current 3) (vector-ref row 12))
                           (equal? (vector-ref current 4) (vector-ref row 13)))
                      (equal? (vector-ref current 3) (vector-ref row 12)))))
        (cpu4-binding-fail 'invalid-state operation "accepted generation policy or RNG source changed"))
    #t))
(define (cpu4-handoff-child-check! row operation)
  (let ((child (cpu4-owned-row (vector-ref row 4) operation)))
    (if (not (and (eq? child (vector-ref row 5))
                  (eq? (vector-ref child 3) 'open) (vector-ref child 12)
                  (eq? (cpu4-candidate-model-internal (vector-ref child 5)) (vector-ref row 6))
                  (eq? (g3c4-model-entry-live (vector-ref row 6) operation #f) (vector-ref row 7))))
        (cpu4-binding-fail 'invalid-state operation "handoff lost exact owned candidate"))
    child))
(define (cpu4-handoff-o2-status status operation)
  ;; Direct NULL-diagnostic ABI returns an O2 status, not the bridge error cell.
  (cpu4-binding-fail
    (cond ((= status 1) 'invalid-argument) ((= status 2) 'shape-mismatch)
          ((= status 3) 'dtype-mismatch) ((= status 4) 'device-mismatch)
          ((= status 5) 'noncontiguous) ((= status 6) 'unsupported)
          ((= status 7) 'invalid-state) ((= status 8) 'version-mismatch)
          ((= status 10) 'corrupt-data) ((= status 11) 'determinism-unavailable)
          (else 'internal)) operation "owned optimizer retirement preflight rejected"))
(define (cpu4-handoff-resume! row)
  (let* ((operation 'cpu4-generator-handoff)
         (child (cpu4-handoff-child-check! row operation)))
    (cpu4-handoff-config-recheck! row operation)
    (g3c4-baseline-tokenizer-entry (vector-ref row 8) operation 'invalid-state 'invalid-state)
    (if (eq? (vector-ref row 3) 'training)
        (begin
          ;; Allocate/authenticate the exact registry unlink plan BEFORE TRAIN
          ;; detach. A live E3 frame/borrow/O2 state leaves the trainer intact.
          (vector-set! row 23 (cpu4-owned-o2-unlink-plan child operation))
          (if (not (and (vector-ref row 23)
                        (eq? (vector-ref child 9) (vector-ref row 22))
                        (eq? (vector-ref child 10) (vector-ref row 21))
                        (not (vector-ref child 11))))
              (cpu4-binding-fail 'invalid-state operation "handoff trainer or optimizer custody changed"))
          (cpu4-trainer-detach-internal! (vector-ref row 21))
          (vector-set! child 11 #t)
          (vector-set! row 3 'detached)))
    (if (eq? (vector-ref row 3) 'detached)
        (let ((plan (cpu4-owned-o2-unlink-plan child operation)))
          ;; Recompute after prior independent registry edits/retry. Everything
          ;; needed for unlink and invalidation exists before native destruction.
          (if (not (and plan (vector-ref child 11)))
              (cpu4-binding-fail 'invalid-state operation "detached optimizer custody changed"))
          (vector-set! row 23 plan)
          (let ((status (cpu4-handoff-native-o2-commit (vector-ref child 8) '())))
            (if (not (= status 0)) (cpu4-handoff-o2-status status operation)))
          ;; Native0 destroyed ONLY O2 moments/optimizer. Preserve all model
          ;; values, native parameters, P1 handles and original graph memberships.
          (if (vector-ref plan 0) (set-cdr! (vector-ref plan 0) (vector-ref plan 2))
              (set! o2-optimizers (vector-ref plan 2)))
          (vector-set! (vector-ref child 7) 0 #f)
          (vector-set! (vector-ref child 7) 1 #f)
          (vector-set! (vector-ref child 7) 2 #f)
          (vector-set! (vector-ref child 7) 3 #f)
          (vector-set! (vector-ref child 7) 4 #f)
          (vector-set! (vector-ref child 7) 5 #f)
          (vector-set! child 6 #f)
          (vector-set! child 7 #f)
          (vector-set! child 8 #f)
          (vector-set! row 23 #f)
          (vector-set! row 3 'optimizer-retired)))
    (if (eq? (vector-ref row 3) 'optimizer-retired)
        (begin (module-eval! (vector-ref row 6))
               (vector-set! row 3 'eval)))
    (if (eq? (vector-ref row 3) 'eval)
        (let ((generator (g3c4-public-generator-create
                           (vector-ref row 6) (vector-ref row 8) (vector-ref row 9))))
          ;; Enroll the EXACT returned shell before another fallible operation.
          (vector-set! row 14 generator)
          (vector-set! (vector-ref row 15) 1 generator)
          (vector-set! row 3 'generator-owned)))
    (if (not (eq? (vector-ref row 3) 'generator-owned))
        (cpu4-binding-fail 'invalid-state operation "handoff phase cannot adopt"))
    (cpu4-handoff-config-recheck! row operation)
    ;; These ACTUAL public/registry authenticators are immediately before the
    ;; separate typed base seam. No caller-shaped entry can enter this route.
    (let* ((profile (g3c4-public-g2-profile-live (vector-ref row 14) operation))
           (entry (g3c4-generator-entry-call-ready (vector-ref row 14) operation)))
      (if (not (and (eq? (vector-ref profile 1) entry)
                    (eq? (vector-ref entry 0) (vector-ref row 14))
                    (eq? (vector-ref entry 5) (vector-ref row 7))
                    (eq? (vector-ref entry 6) (vector-ref row 8))
                    (eq? (vector-ref (vector-ref row 15) 0) (vector-ref row 6))
                    (eq? (vector-ref (vector-ref row 15) 1) (vector-ref row 14))))
          (cpu4-binding-fail 'invalid-state operation "public G2 creator/model/tokenizer changed"))
      (cpu4-candidate-adopt-public-g2-entry-internal! (vector-ref child 5) entry)
      ;; Native adoption succeeded. ONLY fixed stores and preallocated return.
      ;; 'dead' here tombstones CHILD OWNERSHIP; the model is alive and adopted.
      (vector-set! child 3 'dead)
      (vector-set! child 9 #f)
      (vector-set! child 10 #f)
      (vector-set! child 12 #f)
      (vector-set! row 18 #f)
      (vector-set! row 3 'adopted)
      (vector-ref row 15))))

(define (cpu4-generator-handoff-retry-internal! ticket)
  (cpu4-checkpoint-require-nonregional! 'cpu4-generator-handoff-retry)
  (let* ((operation 'cpu4-generator-handoff-retry)
         (row (cpu4-handoff-row ticket operation)))
    (if (vector-ref row 18)
        (cpu4-binding-fail 'invalid-state operation "handoff is busy"))
    (if (eq? (vector-ref row 3) 'adopted) (vector-ref row 15)
        (guard (caught
                 (#t (if (not (vector-ref (vector-ref row 16) 0))
                         (begin (vector-set! (vector-ref row 16) 1 caught)
                                (vector-set! (vector-ref row 16) 0 #t)))
                     (vector-set! row 17 caught)
                     (vector-set! row 18 #f)
                     ;; Keep child busy/custody claimed across every preadopt
                     ;; error, including detached/O2-retired/live-generator phases.
                     (raise caught)))
          (vector-set! row 18 #t)
          (cpu4-handoff-resume! row)))))
(define (cpu4-owned-generator-handoff-internal! child-token generation-tokenizer config recovery-cell)
  (cpu4-checkpoint-require-nonregional! 'cpu4-generator-handoff)
  (let* ((operation 'cpu4-generator-handoff)
         (child (cpu4-owned-open child-token operation)))
    (if (not (and (vector? recovery-cell) (= (vector-length recovery-cell) 1)
                  (not (vector-ref recovery-cell 0)) (vector-ref child 6)
                  (vector-ref child 9) (vector-ref child 10)))
        (cpu4-binding-fail 'invalid-argument operation "handoff requires complete owned trainer and empty recovery cell"))
    (let* ((trainer-row (cpu4-trainer-row-internal (vector-ref child 10) operation))
           (record (cpu4-trainer-idle-check-internal (vector-ref child 10) operation))
           (model (cpu4-candidate-model-internal (vector-ref child 5)))
           (entry (g3c4-model-entry-live model operation #f))
           (accepted (cpu4-handoff-config config operation))
           (tokenizer-check (g3c4-baseline-tokenizer-entry generation-tokenizer operation 'invalid-argument 'unsupported))
           (result (vector model #f))
           (row (vector cpu4-handoff-tag #f (vector 'cpu4-g2-handoff) 'training child-token child model entry
                        generation-tokenizer (vector-ref accepted 0) (vector-ref accepted 1)
                        (vector-ref accepted 2) (vector-ref accepted 3) (vector-ref accepted 4)
                        #f result (vector #f #f) #f #f (vector-ref trainer-row 1) (vector-ref record 15)
                        (vector-ref child 10) (vector-ref child 9) #f))
           (next (cons row (vector-ref cpu4-handoffs 0))))
      ;; Recovery/phase/result/publication graph exists BEFORE any destructive
      ;; action. Reacquire canonical row before claiming exact child authority.
      (guard (caught
               (#t (if (vector-ref recovery-cell 0)
                       (let ((canonical (cpu4-handoff-row (vector-ref recovery-cell 0) operation)))
                         (if (not (vector-ref (vector-ref canonical 16) 0))
                             (begin (vector-set! (vector-ref canonical 16) 1 caught)
                                    (vector-set! (vector-ref canonical 16) 0 #t)))
                         (vector-set! canonical 17 caught)
                         (vector-set! canonical 18 #f)))
                   (raise caught)))
        (vector-set! cpu4-handoffs 0 next)
        (let ((canonical (car (vector-ref cpu4-handoffs 0))))
          (vector-set! canonical 1 canonical)
          (vector-set! recovery-cell 0 (vector-ref canonical 2))
          (vector-set! child 12 #t)
          (cpu4-generator-handoff-retry-internal! (vector-ref canonical 2)))))))
(define (cpu4-checkpoint-factory-generator-handoff-internal! factory-ticket generation-tokenizer config recovery-cell)
  (cpu4-checkpoint-require-nonregional! 'cpu4-factory-generator-handoff)
  (let ((row (cpu4-checkpoint-factory-row factory-ticket 'cpu4-factory-generator-handoff)))
    (if (not (and (eq? (vector-ref row 3) 'ready) (not (vector-ref row 18))
                  (not (vector-ref row 10)) (not (vector-ref row 11))
                  (vector-ref row 14)
                  (eq? (vector-ref row 15) (vector-ref (cpu4-owned-row (vector-ref row 14) 'cpu4-factory-generator-handoff) 10))))
        (cpu4-binding-fail 'invalid-state 'cpu4-factory-generator-handoff "factory is not ready with its exact owned trainer"))
    (cpu4-owned-generator-handoff-internal!
      (vector-ref row 14) generation-tokenizer config recovery-cell)))
