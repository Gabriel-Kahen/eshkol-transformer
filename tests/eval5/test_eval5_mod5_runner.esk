;;; Live Eshkol AOT EVAL5 benchmark + contamination runner wired to D1 shards,
;;; MOD5 K1 native kernels, C1 eshkol-mod5-v1 checkpoints, and EVAL5 bridge.
(load "i2_wave2_root.esk")
(require c1_sha256)

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 format-f64 ptr i64 char* f64 :real strfromd)

;; MOD5 K1 bridge bindings
(extern i32 open-mod5 ptr :real et_mod5_aot_open)
(extern void close-mod5 ptr :real et_mod5_aot_close)
(extern void store-f32 ptr i64 f64 :real et_mod5_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_mod5_aot_load_f32)
(extern i32 rms-forward ptr ptr ptr ptr ptr :real et_mod5_aot_rms_forward)
(extern i32 rms-backward ptr ptr ptr ptr ptr ptr ptr :real et_mod5_aot_rms_backward)
(extern i32 glu-forward ptr ptr ptr ptr :real et_mod5_aot_swiglu_forward)
(extern i32 glu-backward ptr ptr ptr ptr ptr ptr :real et_mod5_aot_swiglu_backward)
(extern i32 attention-forward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr
        :real et_mod5_aot_attention_forward)
(extern i32 attention-backward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr ptr ptr ptr
        :real et_mod5_aot_attention_backward)

;; EVAL5 AOT bridge bindings
(extern i32 eval5-corpus-create ptr :real et_eval5_aot_corpus_create)
(extern void eval5-corpus-destroy ptr :real et_eval5_aot_corpus_destroy)
(extern i32 eval5-corpus-add-doc ptr ptr i64 ptr i64 :real et_eval5_aot_corpus_add_doc)
(extern i32 eval5-audit ptr ptr i32 i32 i32 f64 f64 ptr i64 ptr ptr
        :real et_eval5_aot_audit_contamination)
(extern i32 eval5-score-lm ptr i64 ptr i64 i64 i64 ptr :real et_eval5_aot_score_lm)
(extern i32 eval5-mc-create ptr :real et_eval5_aot_mc_create)
(extern void eval5-mc-destroy ptr :real et_eval5_aot_mc_destroy)
(extern i32 eval5-mc-begin-item ptr i64 :real et_eval5_aot_mc_begin_item)
(extern i32 eval5-mc-add-choice ptr ptr i64 ptr i64 i64 :real et_eval5_aot_mc_add_choice)
(extern i32 eval5-score-mc ptr i32 ptr ptr ptr :real et_eval5_aot_score_mc)
(extern i32 eval5-manifest-create ptr :real et_eval5_aot_manifest_create)
