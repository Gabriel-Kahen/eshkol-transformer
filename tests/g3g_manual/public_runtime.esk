(require transformer.config)
(require transformer.module)
(require transformer.tokenizer)
(require transformer.diagnostic_transport)
(require transformer.model)
(require transformer.generation)
(require transformer.error_public)

(define (check label value)
  (if value #t (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define (expect-error label category operation thunk)
  (check label
    (guard (caught
             (#t (and (transformer-error? caught)
                      (eq? (transformer-error-category caught) category)
                      (eq? (transformer-error-operation caught) operation)
                      (eq? (transformer-error-cause caught) #f))))
      (thunk) #f)))
(define (same-row? actual reference offset)
  (and (bytevector? actual) (= 1024 (bytevector-length actual))
       (= 2048 (bytevector-length reference))
       (let loop ((at 0))
         (if (= at 1024) #t
             (and (= (bytevector-u8-ref actual at)
                     (bytevector-u8-ref reference (+ offset at)))
                  (loop (+ at 1)))))))
(define (same-bytes? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((at 0))
         (if (= at (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left at)
                     (bytevector-u8-ref right at))
                  (loop (+ at 1)))))))

(define config
  (config-resolve
    (config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define model (diagnostic-model-create config (diagnostic-initializer-state 1729)))
(check "eval mode" (module-eval! model))
(define tokenizer (tokenizer-byte config))
(define reference-input (diagnostic-input-create))
(check "reference input" (diagnostic-input-copy! reference-input '(65 66)))
(define reference-output (model-forward model reference-input))
(define reference-logits (model-output-logits reference-output))
(define reference-bytes (diagnostic-model-logits-bits reference-logits))
(check "reference has two rows" (= 2048 (bytevector-length reference-bytes)))
(check "reference release"
  (and (diagnostic-model-logits-release! reference-logits)
       (model-output-release! reference-output)
       (diagnostic-input-release! reference-input)))
(define policy-g0
  (list ':profile 'diagnostic-c2 ':sampling 'greedy
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 0
        ':eos #f ':seed 1729))
(define policy-g1
  (list ':profile 'diagnostic-c2 ':sampling 'greedy
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos #f ':seed 1729))
(expect-error "foreign generator admitted first" 'invalid-argument 'generator-prefill!
  (lambda () (generator-prefill! (vector 'foreign) (vector 'foreign))))
(check "manual error keeps public operation and data-only details"
  (guard (caught
           (#t (and (transformer-error? caught)
                    (eq? (transformer-error-category caught)
                         'invalid-argument)
                    (eq? (transformer-error-operation caught)
                         'generator-prefill!)
                    (equal? (transformer-error-details caught)
                      '((native-category 1)
                        (source-code 1)
                        (source-domain g3t-transport)
                        (source-message "expected an exact G3-T generator")))
                    (eq? (transformer-error-cause caught) #f))))
    (generator-prefill! (vector 'foreign) (vector 'foreign)) #f))
(define generator (generator-create model tokenizer policy-g0))
(define scalar-input (generation-token-input-create 65))
(expect-error "wrong input kind" 'invalid-argument 'generator-prefill!
  (lambda () (generator-prefill! generator model)))
(expect-error "missing prefix" 'invalid-state 'generator-decode-step!
  (lambda () (generator-decode-step! generator scalar-input)))
(define first (generator-prefill! generator scalar-input))
(define first-bits (diagnostic-generation-logits-bits first))
(check "P1 all 256 exact words" (same-row? first-bits reference-bytes 0))
(expect-error "copied shell read" 'invalid-argument
  'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits
               (vector 'g3t-logits-private))))
(expect-error "M3T shell read" 'invalid-argument
  'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits reference-logits)))
(expect-error "copied shell release" 'invalid-argument
  'generation-tensor-release!
  (lambda () (generation-tensor-release! (vector 'g3t-logits-private))))
(check "P1 repeat read" (same-bytes? first-bits
  (diagnostic-generation-logits-bits first)))
(expect-error "output-only accessor" 'invalid-argument 'generation-output-text
  (lambda () (generation-output-text first)))
(expect-error "prefill blocks generate" 'invalid-state 'generator-generate!
  (lambda () (generator-generate! generator scalar-input)))
(define t1-two (tokenizer-encode tokenizer (bytevector 65 66)))
(define pair-input (generation-input-create t1-two))
(define second (generator-prefill! generator pair-input))
(check "P2 last row exact words" (same-row?
  (diagnostic-generation-logits-bits second) reference-bytes 1024))
(check "P1 survives P2 replacement" (same-bytes? first-bits
  (diagnostic-generation-logits-bits first)))
(check "release P2 source" (generation-tensor-release! pair-input))
(check "close with detached tensors" (generator-close! generator))
(check "P2 survives close" (same-row?
  (diagnostic-generation-logits-bits second) reference-bytes 1024))
(check "independent release" (generation-tensor-release! first))
(expect-error "released P1 read" 'invalid-state 'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits first)))
(check "P2 survives sibling release" (same-row?
  (diagnostic-generation-logits-bits second) reference-bytes 1024))
(check "release P2 and inputs"
  (and (generation-tensor-release! second)
       (generation-tensor-release! second)
       (generation-tensor-release! first)
       (generation-tensor-release! scalar-input)))
(expect-error "dead P2 read" 'invalid-state 'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits second)))
(expect-error "wrong kind diagnostic" 'invalid-argument
  'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits scalar-input)))
(expect-error "foreign diagnostic" 'invalid-argument
  'diagnostic-generation-logits-bits
  (lambda () (diagnostic-generation-logits-bits (vector 'foreign))))

(define decode-generator (generator-create model tokenizer policy-g1))
(define decode-prefix (generation-token-input-create 65))
(define decode-first (generator-prefill! decode-generator decode-prefix))
(check "G1 P1 exact words" (same-row?
  (diagnostic-generation-logits-bits decode-first) reference-bytes 0))
(define decode-token (generation-token-input-create 66))
(define decode-second (generator-decode-step! decode-generator decode-token))
(check "decode last row exact words" (same-row?
  (diagnostic-generation-logits-bits decode-second) reference-bytes 1024))
(expect-error "repeated decode" 'invalid-state 'generator-decode-step!
  (lambda () (generator-decode-step! decode-generator decode-token)))
(check "decode predecessor survives" (same-row?
  (diagnostic-generation-logits-bits decode-first) reference-bytes 0))
(check "decode owners"
  (and (generator-close! decode-generator)
       (generation-tensor-release! decode-first)
       (generation-tensor-release! decode-second)
       (generation-tensor-release! decode-prefix)
       (generation-tensor-release! decode-token)))

(define zero-generator (generator-create model tokenizer policy-g0))
(define zero-prefix (generation-token-input-create 65))
(define zero-output (generator-generate! zero-generator zero-prefix))
(define zero-token (generation-token-input-create 66))
(define zero-decode (generator-decode-step! zero-generator zero-token))
(check "decode after P1/G0 exact words" (same-row?
  (diagnostic-generation-logits-bits zero-decode) reference-bytes 1024))
(check "old output release leaves logits" (generation-output-release! zero-output))
(check "logits survive output release" (same-row?
  (diagnostic-generation-logits-bits zero-decode) reference-bytes 1024))
(check "zero-budget owners"
  (and (generator-close! zero-generator)
       (generation-tensor-release! zero-decode)
       (generation-tensor-release! zero-prefix)
       (generation-tensor-release! zero-token)))
;;; Additive C4 authority remains separate from C2 generation.
(expect-error "C4 seed negative" 'invalid-argument
  'diagnostic-c4-model-create-seeded
  (lambda () (diagnostic-c4-model-create-seeded -1)))
(expect-error "C4 seed noninteger" 'invalid-argument
  'diagnostic-c4-model-create-seeded
  (lambda () (diagnostic-c4-model-create-seeded "1729")))
(define c4-model-a (diagnostic-c4-model-create-seeded 1729))
(define c4-model-b (diagnostic-c4-model-create-seeded 1730))
(check "distinct rooted C4 model shells" (not (eq? c4-model-a c4-model-b)))
(define c4-tree (module-parameters c4-model-a))
(define (proper-length values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count (loop (cdr remaining) (+ count 1)))))
(check "C4 has 14 unique handles and one tied path"
  (= (proper-length (parameter-tree-paths c4-tree)) 15))
(check "C4 head weight shares the embedding handle"
  (eq? (parameter-tree-handle c4-tree '("head" "weight"))
       (parameter-tree-handle c4-tree '("token_embedding" "weight"))))
(define (c4-only-tie? left right)
  (or (and (equal? left '("head" "weight"))
           (equal? right '("token_embedding" "weight")))
      (and (equal? right '("head" "weight"))
           (equal? left '("token_embedding" "weight")))))
(define (c4-unique-handles? tree paths)
  (let outer ((rest paths))
    (if (null? rest) #t
        (and (let inner ((later (cdr rest)))
               (if (null? later) #t
                   (and (or (not (eq?
                                   (parameter-tree-handle tree (car rest))
                                   (parameter-tree-handle tree (car later))))
                            (c4-only-tie? (car rest) (car later)))
                        (inner (cdr later)))))
             (outer (cdr rest))))))
(check "C4 no other handle aliases"
  (c4-unique-handles? c4-tree (parameter-tree-paths c4-tree)))
(check "C4 vocabulary handle shape"
  (equal? (parameter-handle-shape
            (parameter-tree-handle c4-tree '("head" "weight")))
          '(256 4)))
(check "C4 model remains in eval mode" (module-eval! c4-model-a))
(expect-error "C4 model is wrong release kind" 'invalid-argument
  'generation-tensor-release!
  (lambda () (generation-tensor-release! c4-model-a)))
(define c4-t1-two (tokenizer-encode tokenizer (bytevector 0 255)))
(define c4-input-a (generation-c4-input-create c4-t1-two))
(define c4-input-b (generation-c4-input-create c4-t1-two))
(check "distinct copied C4 input shells" (not (eq? c4-input-a c4-input-b)))
(check "T1 source remains readable" (same-bytes?
  (tokenizer-decode tokenizer c4-t1-two) (bytevector 0 255)))
(expect-error "C4 input copied shell rejects" 'invalid-argument
  'generation-tensor-release!
  (lambda () (generation-tensor-release! (vector 'g3c4-input-private))))
(expect-error "C4 input wrong T1 kind" 'invalid-argument
  'generation-c4-input-create
  (lambda () (generation-c4-input-create pair-input)))
(expect-error "C4 input foreign T1" 'invalid-argument
  'generation-c4-input-create
  (lambda () (generation-c4-input-create (vector 'foreign))))
(expect-error "C4 input P1 rejects" 'shape-mismatch
  'generation-c4-input-create
  (lambda () (generation-c4-input-create
               (tokenizer-encode tokenizer (bytevector 0)))))
(expect-error "C4 input P3 rejects" 'shape-mismatch
  'generation-c4-input-create
  (lambda () (generation-c4-input-create
               (tokenizer-encode tokenizer (bytevector 0 1 255)))))
(expect-error "C4 input empty rejects" 'shape-mismatch
  'generation-c4-input-create
  (lambda () (generation-c4-input-create
               (tokenizer-encode tokenizer (bytevector)))))
(check "C4 input exact release and repeated release"
  (and (generation-tensor-release! c4-input-a)
       (generation-tensor-release! c4-input-a)))
(check "C4 sibling survives release" (generation-tensor-release! c4-input-b))
(expect-error "C4 model remains wrong kind after input releases"
  'invalid-argument 'generation-tensor-release!
  (lambda () (generation-tensor-release! c4-model-b)))

;;; The separately admitted C4 profile uses the same installed operation
;;; names, with a fixed P2/G1 result and no EOS stop policy.
(define (c4-seed-policy sampling seed)
  (list ':profile 'diagnostic-c4-p2g1 ':sampling sampling
        ':temperature-bits (if (eq? sampling 'greedy)
                               #x3f800000 #x3f400000)
        ':top-k (if (eq? sampling 'greedy) 256 32)
        ':top-p-bits (if (eq? sampling 'greedy)
                        #x3f800000 #x3f000000)
        ':max-new-tokens 1 ':eos #f ':seed seed))
(define (c4-successor-policy rng)
  (list ':profile 'diagnostic-c4-p2g1 ':sampling 'categorical
        ':temperature-bits #x3f400000 ':top-k 32
        ':top-p-bits #x3f000000 ':max-new-tokens 1
        ':eos #f ':rng rng))
(expect-error "C4 rejects C2 profile" 'invalid-argument 'generator-create
  (lambda () (generator-create c4-model-a tokenizer policy-g1)))
(expect-error "C2 rejects C4 profile" 'invalid-argument 'generator-create
  (lambda () (generator-create model tokenizer
               (c4-seed-policy 'greedy 41))))
(expect-error "C4 rejects zero budget" 'invalid-argument 'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (list ':profile 'diagnostic-c4-p2g1 ':sampling 'greedy
                     ':temperature-bits #x3f800000 ':top-k 256
                     ':top-p-bits #x3f800000 ':max-new-tokens 0
                     ':eos #f ':seed 41))))
(expect-error "C4 EOS requires later policy" 'invalid-argument 'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (list ':profile 'diagnostic-c4-p2g1 ':sampling 'greedy
                     ':temperature-bits #x3f800000 ':top-k 256
                     ':top-p-bits #x3f800000 ':max-new-tokens 1
                     ':eos 0 ':seed 41))))
(define c2-cap-generator (generator-create model tokenizer policy-g1))
(define c2-cap-input (generation-input-create c4-t1-two))
(expect-error "C2 P2/G1 remains over capacity before C4 call"
  'shape-mismatch 'generator-generate!
  (lambda () (generator-generate! c2-cap-generator c2-cap-input)))
(define c4-prompt (generation-c4-input-create c4-t1-two))
(define c4-dead-before-call
  (generator-create c4-model-a tokenizer (c4-seed-policy 'greedy 40)))
(check "C4 generator closes before pending gate admission"
  (generator-close! c4-dead-before-call))
(expect-error "dead C4 generator rejects before pending gate admission"
  'invalid-state 'generator-generate!
  (lambda () (generator-generate! c4-dead-before-call c4-prompt)))
(define c4-greedy (generator-create c4-model-a tokenizer
                     (c4-seed-policy 'greedy 41)))
(expect-error "C4 rejects C2 input" 'invalid-argument 'generator-generate!
  (lambda () (generator-generate! c4-greedy scalar-input)))
(define c4-greedy-out (generator-generate! c4-greedy c4-prompt))
(expect-error "C2 P2/G1 remains over capacity after C4 call"
  'shape-mismatch 'generator-generate!
  (lambda () (generator-generate! c2-cap-generator c2-cap-input)))
(check "C2 capacity witnesses release"
  (and (generator-close! c2-cap-generator)
       (generation-tensor-release! c2-cap-input)))
(define c4-greedy-text (car (generation-output-text c4-greedy-out)))
(check "C4 emitted one raw byte"
  (and (bytevector? c4-greedy-text)
       (= (bytevector-length c4-greedy-text) 1)))
(define c4-greedy-id (car (generation-output-ids c4-greedy-out)))
(define c4-greedy-id-next (car (generation-output-ids c4-greedy-out)))
(define c4-greedy-len (generation-output-lengths c4-greedy-out))
(define c4-greedy-cache (generation-output-cache-lengths c4-greedy-out))
(define c4-greedy-rng (generation-output-rng c4-greedy-out))
(expect-error "C4 IDs owner is not RNG constructor source"
  'invalid-argument 'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (c4-successor-policy c4-greedy-id))))
(check "C4 clones have distinct owners"
  (and (not (eq? c4-greedy-id c4-greedy-id-next))
       (not (eq? c4-greedy-text
                 (car (generation-output-text c4-greedy-out))))))
(define c4-greedy-out-again (generator-generate! c4-greedy c4-prompt))
(define c4-greedy-id-again
  (car (generation-output-ids c4-greedy-out-again)))
(define c4-greedy-text-again
  (car (generation-output-text c4-greedy-out-again)))
(check "same C4 generator publishes independent P2/G1 calls"
  (and (not (eq? c4-greedy-out c4-greedy-out-again))
       (not (eq? c4-greedy-id c4-greedy-id-again))
       (not (eq? c4-greedy-text c4-greedy-text-again))
       (= (bytevector-length c4-greedy-text-again) 1)
       (= (bytevector-u8-ref c4-greedy-text 0)
          (bytevector-u8-ref c4-greedy-text-again 0))))
(expect-error "C4 model is not output" 'invalid-argument
  'generation-output-text
  (lambda () (generation-output-text c4-model-a)))
(expect-error "C4 output is not tensor" 'invalid-argument
  'generation-tensor-release!
  (lambda () (generation-tensor-release! c4-greedy-out)))
(check "C4 output survives generator close" (generator-close! c4-greedy))
(check "C4 output byte after close"
  (= (bytevector-u8-ref c4-greedy-text 0)
     (bytevector-u8-ref (car (generation-output-text c4-greedy-out)) 0)))
(check "second C4 output survives close and releases independently"
  (and (= (bytevector-u8-ref c4-greedy-text-again 0)
          (bytevector-u8-ref
            (car (generation-output-text c4-greedy-out-again)) 0))
       (generation-output-release! c4-greedy-out-again)
       (generation-tensor-release! c4-greedy-id-again)
       (= (bytevector-u8-ref c4-greedy-text 0)
          (bytevector-u8-ref (car (generation-output-text c4-greedy-out)) 0))))
(check "C4 independent clones release"
  (and (generation-tensor-release! c4-greedy-id)
       (generation-tensor-release! c4-greedy-len)
       (generation-tensor-release! c4-greedy-cache)))
(check "C4 output release is idempotent"
  (and (generation-output-release! c4-greedy-out)
       (generation-output-release! c4-greedy-out)))
(check "C4 detached ID and RNG survive output release"
  (and (generation-tensor-release! c4-greedy-id-next)
       (generation-rng-release! c4-greedy-rng)))
(expect-error "C4 dead output rejects read" 'invalid-state
  'generation-output-text
  (lambda () (generation-output-text c4-greedy-out)))

(define c4-other-prompt (generation-c4-input-create t1-two))
(define c4-other-generator (generator-create c4-model-a tokenizer
                             (c4-seed-policy 'greedy 41)))
(define c4-other-output
  (generator-generate! c4-other-generator c4-other-prompt))
(check "distinct authentic P2 prompt publishes one byte"
  (= (bytevector-length
       (car (generation-output-text c4-other-output))) 1))
(check "second P2 owners release"
  (and (generation-output-release! c4-other-output)
       (generator-close! c4-other-generator)
       (generation-tensor-release! c4-other-prompt)))

(define c4-categorical (generator-create c4-model-a tokenizer
                         (c4-seed-policy 'categorical 97)))
(define c4-cat-out (generator-generate! c4-categorical c4-prompt))
(define c4-successor (generation-output-rng c4-cat-out))
(expect-error "forged C4 result RNG rejects constructor"
  'invalid-argument 'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (c4-successor-policy (vector 'g3c4-rng-private)))))
(define c4-follow-a (generator-create c4-model-a tokenizer
                      (c4-successor-policy c4-successor)))
(define c4-follow-b (generator-create c4-model-a tokenizer
                      (c4-successor-policy c4-successor)))
(check "source result RNG releases after two copied constructors"
  (generation-rng-release! c4-successor))
(expect-error "released result RNG rejects constructor" 'invalid-state
  'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (c4-successor-policy c4-successor))))
(define c2-cross-input (generation-token-input-create 65))
(define c2-cross-generator (generator-create model tokenizer policy-g1))
(define c2-cross-output (generator-generate! c2-cross-generator c2-cross-input))
(define c2-cross-rng (generation-output-rng c2-cross-output))
(expect-error "C2 RNG is not C4 result RNG" 'invalid-argument
  'generator-create
  (lambda () (generator-create c4-model-a tokenizer
               (c4-successor-policy c2-cross-rng))))
(check "C2 cross-profile owners release"
  (and (generation-rng-release! c2-cross-rng)
       (generation-output-release! c2-cross-output)
       (generator-close! c2-cross-generator)
       (generation-tensor-release! c2-cross-input)))
(check "source output and generator close independently"
  (and (generation-output-release! c4-cat-out)
       (generator-close! c4-categorical)))
(define c4-follow-out-a (generator-generate! c4-follow-a c4-prompt))
(define c4-follow-out-b (generator-generate! c4-follow-b c4-prompt))
(check "same successor snapshot gives same next selected byte"
  (= (bytevector-u8-ref
       (car (generation-output-text c4-follow-out-a)) 0)
     (bytevector-u8-ref
       (car (generation-output-text c4-follow-out-b)) 0)))
(check "C4 continuation owners release independently"
  (and (generation-output-release! c4-follow-out-a)
       (generator-close! c4-follow-a)
       (generation-output-release! c4-follow-out-b)
       (generator-close! c4-follow-b)
       (generation-tensor-release! c4-prompt)))
(display "G3G-MANUAL-PUBLIC-PASS") (newline)
