;;; Exact noninstalled zero-model E3 entry; one fresh process per corpus/state.
(extern void e3-zero-run ptr ptr ptr :real et_e3_zero_control_run_v1)

(define (check label condition)
  (if condition #t
      (begin (display "E3-ZERO-CONTROL-FAIL: ") (display label)
             (newline) (exit 1))))

(define (bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define args (command-line))
(check 'arguments
  (and (pair? args) (pair? (cdr args)) (pair? (cdr (cdr args)))
       (pair? (cdr (cdr (cdr args))))
       (null? (cdr (cdr (cdr (cdr args)))))))
(define corpus (car (cdr args)))
(define case-name (car (cdr (cdr args))))
(define gradient-name (car (cdr (cdr (cdr args)))))
(check 'case (or (string=? case-name "all-correct")
                 (string=? case-name "all-wrong")
                 (string=? case-name "mixed")))
(check 'gradient (or (string=? gradient-name "absent")
                     (string=? gradient-name "present")))
(define output (vector #f))
(e3-zero-run (vector (vector (string=? gradient-name "present")))
             (vector corpus) output)
(define result (vector-ref output 0))
(check 'result
  (and (vector? result) (= (vector-length result) 9)
       (eq? (vector-ref result 0) 'e3-private-result-v1)
       (= (vector-ref result 5) 5) (= (vector-ref result 6) 3)
       (bytes=? (vector-ref result 7) (vector-ref result 8))
       (= (vector-ref result 4)
          (cond ((string=? case-name "all-correct") 1065353216)
                ((string=? case-name "mixed") 1058642330)
                (else 0)))))
(display "E3-ZERO-CONTROL-RUNTIME-PASS") (newline)
