(define validation-destination (build-module 101))
(define validation-tree (module-parameters validation-destination))
(define validation-weight-handle
  (parameter-tree-handle validation-tree '("weight")))
(define validation-alias-handle
  (parameter-tree-handle validation-tree '("alias")))
(define validation-weight-identity
  (parameter-handle-tensor-identity-internal validation-weight-handle))
(define validation-alias-identity
  (parameter-handle-tensor-identity-internal validation-alias-handle))
(define validation-before-state (module-state-dict validation-destination))
(define validation-before-payloads
  (list (payload validation-before-state '("alias"))
        (payload validation-before-state '("counter"))
        (payload validation-before-state '("flags"))
        (payload validation-before-state '("weight"))))
(state-dict-release! validation-before-state)
(expect-error "released state serialization rejects before codec" 'invalid-state
              (lambda ()
                (c1-checkpoint-encode-state-internal
                  validation-before-state policy c1-fixture-codec-internal)))
(define validation-invalid-path "checksum-valid-invalid.etcp")
(check "write checksum-valid invalid receiver fixture"
       (= 0 (c1-test-native-atomic-write
             validation-invalid-path checksum-valid-alias-corruption
             (bytevector-length checksum-valid-alias-corruption) 1)))
(define receiver-live-before (c1-p1-test-live-count))
(define receiver-tombstones-before (c1-p1-test-tombstone-count))
(expect-error "checksum-valid invalid file rejects before receiver" 'corrupt-data
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 validation-destination validation-invalid-path policy
                 validation-sentinel-codec 'fixture-v1)))
(check "invalid file-to-module makes zero decoder calls"
       (= validation-decode-calls 0))
(check "invalid file-to-module creates zero P1 shells"
       (= receiver-live-before (c1-p1-test-live-count)))
(check "invalid file-to-module creates zero P1 tombstones"
       (= receiver-tombstones-before (c1-p1-test-tombstone-count)))
(define validation-after-state (module-state-dict validation-destination))
(check "invalid file-to-module preserves every receiver payload"
       (equal? validation-before-payloads
               (list (payload validation-after-state '("alias"))
                     (payload validation-after-state '("counter"))
                     (payload validation-after-state '("flags"))
                     (payload validation-after-state '("weight")))))
(check "invalid file-to-module preserves weight identity"
       (eq? validation-weight-identity
            (parameter-handle-tensor-identity-internal validation-weight-handle)))
(check "invalid file-to-module preserves alias identity"
       (eq? validation-alias-identity
            (parameter-handle-tensor-identity-internal validation-alias-handle)))
(check "invalid file-to-module preserves tie identity"
       (eq? validation-weight-handle validation-alias-handle))
(state-dict-release! validation-after-state)

