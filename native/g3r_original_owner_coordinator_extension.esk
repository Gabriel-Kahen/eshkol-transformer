;;; Feature-private original G3/O2 holds under one enrolled TR3 snapshot lease.
;;; This owns no C2 child, receipt, file, public SAVE, or replay authority.
(extern ptr g3r-original-o2-native-begin ptr ptr
        :real et_g3r_private_trainer_o2_save_begin_v1)
(extern i64 g3r-original-o2-native-end ptr
        :real et_g3r_private_trainer_o2_save_end_v1)
(extern i64 g3r-original-o2-native-error-source
        :real et_g3r_private_trainer_o2_save_last_source_v1)

(define g3r-original-owner-tag (vector 'g3r-original-owner-v1))

(define (g3r-original-owner-o2-native-fail operation)
  (let ((source (g3r-original-o2-native-error-source)))
    (cond ((= source 1) (m3t-native-fail-raw operation))
          ((= source 2) (o2-native-fail operation))
          (else (m3t-fail 'internal operation
                          "O2 held-save bridge lost native authority")))))

;;; The original G3 registry entry and T2 tokenizer remain attached to the
;;; same enrolled trainer while both native holds are live. The native G3
;;; check separately authenticates committed history and original M3T pins.
(define (g3r-original-owner-g3-recheck! trainer generator g3-ledger)
  (let* ((operation 'g3r-original-owner-check!)
         (record (vector-ref g3-ledger 1))
         (entry (vector-ref g3-ledger 3))
         (model-entry (vector-ref g3-ledger 4))
         (tokenizer (vector-ref entry 6))
         (tokenizer-entry (t1-private-entry tokenizer))
         (identity (vector-ref record 7)))
    (if (or (not (eq? (vector-ref record 2) trainer))
            (not (eq? (vector-ref record 9) model-entry))
            (not (eq? (m3t-find (vector-ref record 8)) model-entry))
            (not (eq? (module-mode-internal (vector-ref record 8)) 'train))
            (not (eq? (g3t-generator-find generator operation) entry))
            (not (eq? (vector-ref entry 0) generator))
            (not (eq? (vector-ref entry 1) 'generator))
            (not (eq? (vector-ref entry 2) 'live))
            (null? (vector-ref entry 3))
            (vector-ref entry 4)
            (not (eq? (vector-ref entry 5) model-entry))
            (vector-ref entry 8) (vector-ref entry 9)
            (vector-ref entry 10)
            (not (eq? (vector-ref entry 11) 'diagnostic-c2))
            (not (and (pair? tokenizer-entry)
                      (eq? (car tokenizer-entry) tokenizer)
                      (pair? (cdr tokenizer-entry))
                      (null? (cdr (cdr tokenizer-entry)))
                      (let ((core (car (cdr tokenizer-entry))))
                        (and (t1-core-tokenizer? core)
                             (eq? (vector-ref core 1) 'raw)
                             (null? (vector-ref core 2))
                             (null? (vector-ref core 3))
                             (null? (vector-ref core 4))
                             (= (t1-tokenizer-core-vocab-size core) 256)
                             (string=? (vector-ref core 6)
                                       g3r-trainer-g3-fingerprint)))))
            (not (and (vector? identity) (= (vector-length identity) 3)
                      (string=? (vector-ref identity 0)
                                g3r-trainer-g3-fingerprint)
                      (= (vector-ref identity 1) 256)
                      (eq? (vector-ref identity 2) #t))))
        (m3t-fail 'invalid-state operation
                  "G3 owner or tokenizer changed under original holds"))
    #t))

;;; Ledger: tag, trainer, generator, exact G3-ledger cell, exact O2-hold cell,
;;; phase. All cells and this ledger are allocated before either hold begins.
(define (g3r-original-owner-begin! trainer generator)
  (let* ((operation 'g3r-original-owner-begin!)
         (g3-cell (vector #f))
         (o2-cell (vector #f))
         (ledger (vector g3r-original-owner-tag trainer generator
                         g3-cell o2-cell 'prepared)))
    (guard (caught
             (#t
               (guard (cleanup-failure (#t (tr3-lease-fail-stop 134)))
                 (if (vector-ref o2-cell 0)
                     (let ((status
                             (g3r-original-o2-native-end
                               (vector-ref o2-cell 0))))
                       (if (not (= status 0)) (tr3-lease-fail-stop 134))
                       (vector-set! o2-cell 0 #f)))
                 (if (vector-ref g3-cell 0)
                     (g3r-trainer-g3-save-end! (vector-ref g3-cell 0))))
               (raise caught)))
      (let ((g3-ledger (g3r-trainer-g3-save-begin! trainer generator)))
        (vector-set! g3-cell 0 g3-ledger))
      (let* ((g3-ledger (vector-ref g3-cell 0))
             (record (vector-ref g3-ledger 1))
             (parent (vector-ref g3-ledger 2))
             (optimizer-record (vector-ref record 14))
             (model-entry (vector-ref record 9)))
        ;; O2 begin authenticates a fresh roster from this sealed original
        ;; M3T owner and compares all fourteen identities with its optimizer.
        (let ((hold
                (g3r-original-o2-native-begin
                  (vector-ref optimizer-record 1)
                  (vector-ref model-entry 3))))
          (if (null? hold) (g3r-original-owner-o2-native-fail operation))
          (vector-set! o2-cell 0 hold))
        (tr3-lease-snapshot-recheck-held-o2-internal
          record parent (vector-ref o2-cell 0))
        (g3r-original-owner-g3-recheck! trainer generator g3-ledger)
        (if (not (= (g3r-trainer-g3-native-check
                      (vector-ref (vector-ref g3-ledger 5) 0)) 0))
            (g3r-trainer-g3-save-native-fail operation))
        (tr3-lease-snapshot-recheck-held-o2-internal
          record parent (vector-ref o2-cell 0))
        (vector-set! ledger 5 'held)
        ledger))))

(define (g3r-original-owner-end! ledger)
  (if (or (not (vector? ledger)) (not (= (vector-length ledger) 6))
          (not (eq? (vector-ref ledger 0) g3r-original-owner-tag))
          (not (eq? (vector-ref ledger 5) 'held))
          (not (vector? (vector-ref ledger 3)))
          (not (= (vector-length (vector-ref ledger 3)) 1))
          (not (vector? (vector-ref ledger 4)))
          (not (= (vector-length (vector-ref ledger 4)) 1))
          (not (vector-ref (vector-ref ledger 3) 0))
          (not (vector-ref (vector-ref ledger 4) 0)))
      (tr3-lease-fail-stop 134))
  ;; The G3 tail then drains its own native hold and aborts the exact TR3
  ;; lease. Any uncertain drain is terminal while both ledgers remain rooted.
  (if (not (= (g3r-original-o2-native-end
                (vector-ref (vector-ref ledger 4) 0)) 0))
      (tr3-lease-fail-stop 134))
  (vector-set! (vector-ref ledger 4) 0 #f)
  (guard (caught (#t (tr3-lease-fail-stop 134)))
    (g3r-trainer-g3-save-end! (vector-ref (vector-ref ledger 3) 0)))
  (vector-set! (vector-ref ledger 3) 0 #f)
  (vector-set! ledger 5 'dead)
  #t)
