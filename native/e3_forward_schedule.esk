;;; The literal E3 forward transcript.  The native frame dispatches one role;
;;; source owns the fixed ordering and short-circuit behavior.

(define (e3-forward-schedule-internal frame)
  (and (e3-forward-role! frame 0)
       (e3-forward-role! frame 1)
       (e3-forward-role! frame 2)
       (e3-forward-role! frame 3)
       (e3-forward-role! frame 4)
       (e3-forward-role! frame 5)
       (e3-forward-role! frame 6)
       (e3-forward-role! frame 7)
       (e3-forward-role! frame 8)
       (e3-forward-role! frame 9)
       (e3-forward-role! frame 10)
       (e3-forward-role! frame 11)
       (e3-forward-role! frame 12)
       (e3-forward-role! frame 13)
       (e3-forward-role! frame 14)
       (e3-forward-role! frame 15)
       (e3-forward-role! frame 16)
       (e3-forward-role! frame 17)
       (e3-forward-role! frame 18)
       (e3-forward-role! frame 19)
       (let ((result (e3-forward-role! frame 20))) result)))
