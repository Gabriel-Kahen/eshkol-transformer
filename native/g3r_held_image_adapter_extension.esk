;;; The caller retains the claimed C2 child and original coordinator until
;;; this bounded data projection returns. No caller destination is mutated.
(extern i64 g3r-held-image-native-copy ptr ptr
        :real et_g3r_private_held_image_copy_v1)
(define g3r-held-image-copy-internal g3r-held-image-native-copy)

(define (g3r-held-image-owner-recheck! original operation)
  (if (or (not (vector? original)) (not (= (vector-length original) 6))
          (not (eq? (vector-ref original 0) g3r-original-owner-tag))
          (not (eq? (vector-ref original 5) 'held))
          (not (vector? (vector-ref original 3)))
          (not (= (vector-length (vector-ref original 3)) 1))
          (not (vector? (vector-ref original 4)))
          (not (= (vector-length (vector-ref original 4)) 1)))
      (m3t-fail 'invalid-argument operation "expected exact held coordinator"))
  (let* ((g3 (vector-ref (vector-ref original 3) 0))
         (o2 (vector-ref (vector-ref original 4) 0)))
    (if (or (not (vector? g3)) (not (= (vector-length g3) 7))
            (not (eq? (vector-ref g3 0) g3r-trainer-g3-save-tag))
            (not (eq? (vector-ref g3 6) 'held))
            (not (vector? (vector-ref g3 5)))
            (not (= (vector-length (vector-ref g3 5)) 1))
            (not (vector-ref (vector-ref g3 5) 0))
            (not o2)
            (not (eq? (vector-ref g3 3)
                      (g3t-generator-find (vector-ref original 2) operation)))
            (not (eq? (vector-ref g3 1)
                      (tr3-lease-record-for-shell-internal
                        (vector-ref original 1) operation))))
        (m3t-fail 'invalid-state operation "original hold is stale or foreign"))
    (tr3-lease-snapshot-recheck-held-o2-internal
      (vector-ref g3 1) (vector-ref g3 2) o2)
    (g3r-original-owner-g3-recheck!
      (vector-ref original 1) (vector-ref original 2) g3)
    (if (not (= (g3r-trainer-g3-native-check
                  (vector-ref (vector-ref g3 5) 0)) 0))
        (g3r-trainer-g3-save-native-fail operation))
    (tr3-lease-snapshot-recheck-held-o2-internal
      (vector-ref g3 1) (vector-ref g3 2) o2)
    g3))

(define (g3r-held-image-controls-check! controls record entry operation)
  (let* ((identity (vector-ref record 7))
         (tokenizer (vector-ref entry 6))
         (fingerprint (vector-ref identity 0))
         (resolved (vector-ref record 6)))
    (if (or (not (g3r-save-tokenizer? tokenizer))
            (not (vector? controls)) (not (= (vector-length controls) 5))
            (not (vector? (vector-ref controls 1)))
            (not (= (vector-length (vector-ref controls 1)) 2))
            (not (string=? fingerprint g3r-save-tokenizer-fingerprint))
            (not (equal? (vector-ref controls 1)
                         (vector fingerprint 256)))
            (not (equal? (vector-ref controls 0) (vector-ref record 18)))
            (not (equal? (vector-ref controls 2)
                         (vector (d2-token-dataset-cursor
                                   (vector-ref record 15))
                                 (vector-ref record 17))))
            (not (vector? (vector-ref controls 3)))
            (not (= (vector-length (vector-ref controls 3)) 3))
            (not (equal? (vector-ref (vector-ref controls 3) 0)
                         (string->utf8
                           (x1-private-config-canonical resolved))))
            (not (equal? (vector-ref (vector-ref controls 3) 1)
                         (x1-private-config-fingerprint resolved)))
            (not (equal? (vector-ref controls 4)
                         (vector (vector-ref record 19)
                                 (vector-ref record 20)
                                 (vector-ref record 21)))))
        (m3t-fail 'invalid-state operation
                  "detached C2 controls differ from original trainer"))
    (let* ((config (vector-ref controls 3))
           (request (vector (vector-ref config 0)
                            (vector-ref config 1) operation #f)))
      (x1-canonical-inspect-internal request)
      (if (not (equal? (vector-ref config 2) (vector-ref request 3)))
          (m3t-fail 'invalid-state operation
                    "C2 resolved projection changed after composition")))
    #t))

(define (g3r-held-image-project! original adopter request p1 shell)
  (let* ((operation 'g3r-held-image-project!)
         (g3 (g3r-held-image-owner-recheck! original operation))
         (record (vector-ref g3 1))
         (entry (vector-ref g3 3))
         (hold (vector-ref (vector-ref g3 5) 0))
         (owner (c2-training-state-find shell)))
    (if (or (not (vector? adopter)) (not (= (vector-length adopter) 9))
            (not (eq? (vector-ref adopter 0) g3r-held-o2-adopter-tag))
            (not (eq? (vector-ref adopter 8) 'claimed))
            (not (eq? (vector-ref adopter 1)
                      (vector-ref (vector-ref original 4) 0)))
            (not (eq? (vector-ref adopter 2) (vector-ref record 13)))
            (not (vector? request)) (not (= (vector-length request) 6))
            (not (eq? (vector-ref request 0) c2-training-state-compose-tag))
            (not (eq? (vector-ref request 1) #f))
            (not (eq? (vector-ref request 2) #f))
            (not (eq? (vector-ref request 5) shell))
            (not owner) (not (eq? (vector-ref owner 7) 'live))
            (not (eq? (vector-ref owner 1) p1))
            (not (eq? (vector-ref owner 2) (vector-ref adopter 5))))
        (m3t-fail 'invalid-state operation "C2 is not this held transfer"))
    ;; Fresh 136-byte staging is never returned. Its only authority is the
    ;; checked native hold, not caller-supplied words or detached C2 data.
    (let* ((staging (make-bytevector g3r-save-size 0))
           (borrow-cell (vector #f))
           (result-cell (vector #f)))
      (guard (caught
               (#t
                 (if (vector-ref borrow-cell 0)
                     (guard (cleanup-failure (#t (tr3-lease-fail-stop 134)))
                       (if (not (eq? #t
                                 (c2-training-state-borrow-end-internal
                                   (vector-ref borrow-cell 0))))
                           (tr3-lease-fail-stop 134))))
                 (raise caught)))
        (vector-set! borrow-cell 0
          (c2-training-state-borrow-begin-internal shell operation))
        (let* ((projection
                 (c2-training-state-borrow-projection-internal
                   (vector-ref borrow-cell 0)))
               (controls (vector-ref projection 2)))
          (if (or (not (eq? (vector-ref projection 0) p1))
                  (not (eq? (vector-ref projection 1)
                            (vector-ref adopter 5))))
              (m3t-fail 'invalid-state operation "C2 child identity changed"))
          (g3r-held-image-controls-check! controls record entry operation)
          (g3r-held-image-owner-recheck! original operation)
          (if (not (= (g3r-held-image-copy-internal hold staging) 0))
              (g3t-native-fail-raw operation))
          (g3r-held-image-owner-recheck! original operation)
          (g3r-held-image-controls-check! controls record entry operation)
          (vector-set! result-cell 0 (g3r-save-data staging entry)))
        (guard (cleanup-failure (#t (tr3-lease-fail-stop 134)))
          (if (not (eq? #t
                    (c2-training-state-borrow-end-internal
                      (vector-ref borrow-cell 0))))
              (tr3-lease-fail-stop 134)))
        (vector-set! borrow-cell 0 #f))
      (g3r-held-image-owner-recheck! original operation)
      (vector-ref result-cell 0))))
