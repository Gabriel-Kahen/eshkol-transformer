;;; G3-C4-only P1 prepared construction wrappers. Never install this source.

(define (module-construction-prepare-eval-internal! identity)
  ((vector-ref p1-trusted-surface 71) identity))

(define (module-construction-prepare-train-internal! identity)
  ((vector-ref p1-trusted-surface 73) identity))

(define (module-construction-seal-prepared-internal! identity)
  ((vector-ref p1-trusted-surface 72) identity))

;;; Exact P1 module topology only; no tree, handle, carrier or native pointer
;;; is returned. A separate native owner association gate remains required.
(define (module-c4-train-topology-status-internal root handles)
  ((vector-ref p1-trusted-surface 74) root handles))

;;; Read-only lifetime identity for an already live C4 workspace. Unlike
;;; slot 74 this accepts a uniform eval tree, but never admits computation.
(define (module-c4-lifetime-topology-status-internal root handles)
  ((vector-ref p1-trusted-surface 75) root handles))
