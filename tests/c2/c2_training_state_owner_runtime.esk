  (lambda () (c2-training-state-borrow-end-internal borrow)))
(expect-error "stale borrow rejects" 'invalid-state
              'c2-training-state-borrow-projection-internal
  (lambda () (c2-training-state-borrow-projection-internal borrow)))
(expect-error "stale access token cannot prepare claimed entries"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-entry-shells-internal
      owned-p1 owner-token 'checkpoint-save!)))
(expect-error "stale exact owner token cannot encode claimed P1"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (c2-model-encode-c2-owned-state-internal
      owned-p1 owner-token owned-model-policy 'checkpoint-save!)))
(define stale-o2-request
  (vector owned-o2 owned-p1 owner-token 'checkpoint-save! #f))
(expect-error "stale exact owner token cannot stage claimed O2"
