(load "tr3_step_private_root.esk")

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "TR3-STEP-LEAF-FAIL ") (display label)
             (newline) (exit 1))))
(define (error-at? category operation thunk)
  (guard (caught
           (#t (and (transformer-error? caught)
                    (eq? category (transformer-error-category caught))
                    (eq? operation (transformer-error-operation caught)))))
    (thunk) #f))
(define (diagnose label thunk)
  (guard (caught
           (#t (begin
                 (display "TR3-STEP-LEAF-ERROR ") (display label)
                 (if (transformer-error? caught)
                     (begin (display " ")
                            (display (transformer-error-category caught))
                            (display " ")
                            (display (transformer-error-operation caught))
                            (display " ")
                            (display (transformer-error-message caught)))
                     (display " foreign"))
                 (newline) (exit 2))))
    (thunk)))
(define (same-bytes? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((i 0))
         (if (= i (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left i) (bytevector-u8-ref right i))
                  (loop (+ i 1)))))))
(define (u32-le bytes offset)
  (+ (bytevector-u8-ref bytes offset)
     (* 256 (bytevector-u8-ref bytes (+ offset 1)))
     (* 65536 (bytevector-u8-ref bytes (+ offset 2)))
     (* 16777216 (bytevector-u8-ref bytes (+ offset 3)))))
(define (emit-bytes label bytes)
  (display label)
  (let loop ((i 0))
    (if (= i (bytevector-length bytes)) (newline)
        (begin (display " ") (display (bytevector-u8-ref bytes i))
               (loop (+ i 1))))))
(define (dataset-config directory)
  (list ':directory directory ':batch-size 1 ':sequence-length 2
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 4 ':maximum-batch-bytes 34
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #t))
(define (handle-paths handles)
  (let loop ((i 0))
    (if (= i (vector-length handles)) '()
        (cons (parameter-handle-path (vector-ref handles i))
              (loop (+ i 1))))))
(define (optimizer-config handles)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        '(none) '(constant)
        (list (list 'group (handle-paths handles)
                    "3dcccccd" "3f000000" "3f000000"
                    "3a83126f" "00000000"))))
(define (parameter-bits handle)
  (i2-checkpoint-encode
    (vector (parameter-handle-tensor-internal handle) 'parameter
            (parameter-handle-shape handle) 'f32 'cpu
            'dense-row-major-contiguous 'TR3-STEP-LEAF)))
(define (gradient-metadata handle)
  (i2-parameter-gradient-metadata-internal
    (parameter-handle-tensor-internal handle)))
(define (all-gradient-metadata? handles state count)
  (let loop ((i 0))
    (if (= i (vector-length handles)) #t
        (let ((meta (gradient-metadata (vector-ref handles i))))
          (and (= (vector-ref meta 0) state)
               (= (vector-ref meta 1) count)
               (loop (+ i 1)))))))

(define directory (diagnose 'argv (lambda () (car (cdr (command-line))))))
(define resolved
  (diagnose 'config (lambda ()
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729,\"training.accumulation-steps\":2}")
    '()))))
(define tokenizer (diagnose 'tokenizer (lambda () (t2-wave2-tokenizer-byte resolved))))
(define dataset (diagnose 'dataset (lambda () (d2-token-dataset-open (dataset-config directory) tokenizer))))
(define model
  (diagnose 'model (lambda ()
    (m3t-public-model-create resolved (m3t-public-initializer-state 1729)))))
(define handles (vector-ref (m3t-entry model 'model 'trainer-create #t) 8))
(define optimizer
  (diagnose 'optimizer (lambda ()
    (o2-public-optimizer-create (optimizer-config handles)
                                (module-parameters model)))))
(define trainer
  (diagnose 'trainer (lambda ()
    (tr3-lease-create-internal resolved tokenizer dataset model optimizer))))
(define record (car (vector-ref tr3-trainers 0)))
(define token (vector-ref record 5))
(check "enrolled exact shell" (eq? (vector-ref record 2) trainer))
(check "fixed accumulation two"
       (= (x1-private-config-ref resolved 'training.accumulation-steps) 2))
(define before (diagnose 'parameter-bits (lambda () (parameter-bits (vector-ref handles 0)))))
(check "key weight shape [4,4]" (= (bytevector-length before) 64))
(emit-bytes "TR3-STEP-KEY-BEFORE" before)
(define input (m3t-public-input-create))
(define seed (m3t-public-logits-create))

;;; This witness enters the source-private step phase explicitly. It exercises
;;; genuine component semantics but is not a trainer-step! transaction.
(check "idle admission" (tr3-lease-authenticate record token 'trainer-step!))
(vector-set! record 3 'step)
(define (microbatch ordinal expected-weight)
  (let* ((leased-dataset (tr3-lease-step-dataset-internal record token))
         (batch (diagnose 'next-batch
                  (lambda ()
                    (if (not (eq? leased-dataset (vector-ref record 16)))
                        (exit 3))
                    (d2-token-dataset-next-batch dataset)))))
    (check "live batch" (not (d2-token-dataset-end? batch)))
    (check "stage exact i64[1,2]" (tr3-stage-d2-input! batch input))
    (let* ((leased-model (vector-ref (tr3-lease-step-model-internal record token) 0))
           (output (diagnose 'forward
                     (lambda () (m3-public-model-forward leased-model input '()))))
           (logits (diagnose 'logits
                     (lambda () (m3-public-model-output-logits output))))
           (observation (make-bytevector 12 85)))
      (if (= ordinal 0)
          (begin
            (check "malformed observation rejects before gradient"
                   (error-at? 'shape-mismatch 'tr3-objective-vjp!
                     (lambda ()
                       (tr3-objective-vjp! output logits batch seed ordinal
                                          (make-bytevector 11 0)))))
            (check "malformed observation preserves absent gradients"
                   (all-gradient-metadata? handles 0 0))))
      (check "genuine numerator VJP"
             (tr3-objective-vjp! output logits batch seed ordinal observation))
      (check "exact positive mask weight"
             (= (u32-le observation 4) expected-weight))
      (display "TR3-STEP-OBS ") (display ordinal) (display " ")
      (display (u32-le observation 0)) (display " ")
      (display (u32-le observation 4)) (display " ")
      (display (u32-le observation 8)) (newline)
      (check "logits release"
             (m3-public-diagnostic-model-logits-release! logits))
      (check "output release" (m3-public-model-output-release! output))
      (check "batch release" (d2-token-batch-release! batch)))))

(microbatch 0 1073741824) ; 2.0f
(microbatch 1 1065353216) ; 1.0f
(check "two weighted contributions"
       (diagnose 'metadata
         (lambda () (all-gradient-metadata? handles 1 2)))) ; O2 validates 3.0f below.
(define accumulated-cursor (d2-token-dataset-cursor dataset))
(check "lease optimizer authority"
       (tr3-lease-step-optimizer-internal record token))
(check "wrong weight fails before update"
       (error-at? 'invalid-state 'o2-trainer-step-clear-prepare-internal
         (lambda ()
         (o2-trainer-step-clear-prepare-internal optimizer 0 2 1065353216))))
(check "wrong weight leaves parameter bytes"
       (same-bytes? before
         (diagnose 'parameter-after-rejection
           (lambda () (parameter-bits (vector-ref handles 0))))))
(check "wrong weight leaves update counter"
       (= (o2-optimizer-completed-updates-internal optimizer) 0))
(check "wrong weight leaves gradients"
       (all-gradient-metadata? handles 1 2))
(check "wrong weight leaves cursor"
       (same-bytes? accumulated-cursor (d2-token-dataset-cursor dataset)))
(define abort-plan
  (diagnose 'prepare-abort
    (lambda ()
      (o2-trainer-step-clear-prepare-internal optimizer 0 2 1077936128))))
(check "abort prepared plan"
       (diagnose 'abort
         (lambda () (o2-trainer-step-clear-abort-internal! abort-plan))))
(check "abort leaves parameter bytes"
       (same-bytes? before (parameter-bits (vector-ref handles 0))))
(check "abort leaves gradients"
       (all-gradient-metadata? handles 1 2))
(check "abort leaves cursor"
       (same-bytes? accumulated-cursor (d2-token-dataset-cursor dataset)))
(define plan
  (diagnose 'prepare-commit
    (lambda ()
      (o2-trainer-step-clear-prepare-internal optimizer 0 2 1077936128))))
(vector-set! record 3 'commit)
(vector-set! record 4 plan)
(check "exact commit authority"
       (tr3-lease-commit-optimizer-internal record token plan))
(check "single update and gradient clear"
       (diagnose 'commit
         (lambda () (o2-trainer-step-clear-commit-internal! plan))))
(check "one completed update"
       (= (o2-optimizer-completed-updates-internal optimizer) 1))
(check "parameter changed"
       (not (same-bytes? before (parameter-bits (vector-ref handles 0)))))
(emit-bytes "TR3-STEP-KEY-AFTER" (parameter-bits (vector-ref handles 0)))
(check "fourteen gradients absent"
       (all-gradient-metadata? handles 0 0))
(check "repeat commit rejects"
       (error-at? 'invalid-state 'o2-trainer-step-clear-commit-internal!
         (lambda () (o2-trainer-step-clear-commit-internal! plan))))
;;; Only the test witness updates durable counters; a future trainer tail must
;;; prove this publication with its own no-fail commit contract.
(vector-set! record 19 3)
(vector-set! record 20 1)
(vector-set! record 4 #f)
(vector-set! record 3 'idle)
(check "input release" (m3t-public-input-release! input))
(check "seed release" (m3t-public-logits-release! seed))
(check "lease unlink"
       (diagnose 'unenroll
         (lambda () (tr3-lease-unenroll-internal! trainer))))
(check "dataset close" (d2-token-dataset-close! dataset))
(display "TR3-STEP-LEAF-PASS checks=") (display checks) (newline)
