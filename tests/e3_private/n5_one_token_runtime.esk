;;; Noninstalled numerical tuple: one authentic 10-mask final row.
(extern void e3-private-test-run ptr ptr ptr :real et_e3_test_run_v1)

(define (check label value)
  (if value #t
      (begin (display "E3-N5-ONE-TOKEN-FAIL: ") (display label)
             (newline) (exit 1))))

(define (bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define (print-cursor bytes)
  (let ((digits "0123456789abcdef"))
    (let loop ((index 0))
      (if (= index (bytevector-length bytes)) #t
          (let ((byte (bytevector-u8-ref bytes index)))
            (display (string-ref digits (quotient byte 16)))
            (display (string-ref digits (remainder byte 16)))
            (loop (+ index 1)))))))

(define args (command-line))
(check 'arguments
  (and (pair? args) (pair? (cdr args))
       (null? (cdr (cdr args)))))
(define output (vector #f))
(e3-private-test-run (vector (vector #t 0)) (vector (car (cdr args))) output)
(define result (vector-ref output 0))
(check 'result
  (and (vector? result) (= (vector-length result) 9)
       (eq? (vector-ref result 0) 'e3-private-result-v1)
       (= (vector-ref result 5) 1)
       (= (vector-ref result 6) 1)
       (bytes=? (vector-ref result 7) (vector-ref result 8))))
(display "E3RESULT\t")
(let loop ((index 1))
  (if (= index 7) #t
      (begin
        (if (> index 1) (display ",") #t)
        (display (vector-ref result index))
        (loop (+ index 1)))))
(newline)
(display "E3CURSOR\t")
(print-cursor (vector-ref result 7))
(display "\t")
(print-cursor (vector-ref result 8))
(newline)
(display "E3-NUMERICAL-RUNTIME-PASS") (newline)
