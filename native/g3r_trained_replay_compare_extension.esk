;;; Test-only same-registry reconstruction from a checked budget-one record.
(extern i64 g3r-test-cache-length ptr :real et_g3t_test_cache_length_v1)
(extern i64 g3r-test-cache-kv ptr i64 i64
        :real et_g3t_test_manual_cache_kv_word_v1)
(extern i64 g3r-test-logit ptr i64 :real et_g3t_test_logit_bits_v1)
(extern i64 g3r-test-rng ptr i64 :real et_g3t_test_rng_word_v1)
(extern i64 g3r-test-output ptr i64 :real et_g3t_test_output_word_v1)

(define (g3r-trained-replay-check value detail)
  (if (not value)
      (c2-load-fail 'invalid-state 'g3r-trained-replay-compare! detail '()))
  #t)

(define (g3r-trained-replay-vector=? left right count)
  (let loop ((i 0))
    (if (= i count) #t
        (and (= (vector-ref left i) (vector-ref right i))
             (loop (+ i 1))))))

(define (g3r-trained-replay-logits=? left right)
  (let loop ((i 0))
    (if (= i 256) #t
        (and (>= (g3r-test-logit left i) 0)
             (>= (g3r-test-logit right i) 0)
             (= (g3r-test-logit left i) (g3r-test-logit right i))
             (loop (+ i 1))))))

(define (g3r-trained-replay-kv=? left right count)
  (let loop ((which 0) (i 0))
    (if (= which 2) #t
        (if (= i count) (loop (+ which 1) 0)
            (and (>= (g3r-test-cache-kv left which i) 0)
                 (>= (g3r-test-cache-kv right which i) 0)
                 (= (g3r-test-cache-kv left which i)
                    (g3r-test-cache-kv right which i))
                 (loop which (+ i 1)))))))

(define (g3r-trained-replay-rng=? left right)
  (let loop ((i 0))
    (if (= i 4) #t
        (and (= (g3r-test-rng left i) (g3r-test-rng right i))
             (loop (+ i 1))))))

(define (g3r-trained-replay-wrong-digest-rejects? readback digest)
  (let ((wrong (bytevector-copy digest))
        (destination (make-vector 8 'untouched)))
    (bytevector-u8-set! wrong 0
                        (bitwise-xor (bytevector-u8-ref wrong 0) 1))
    (and (guard (caught
                  (#t (and (string? caught)
                           (string=? caught
                             "G3-R record decode: header, pair or checksum"))))
           (g3r-record-decode! readback wrong destination) #f)
         (let loop ((i 0))
           (if (= i 8) #t
               (and (eq? (vector-ref destination i) 'untouched)
                    (loop (+ i 1))))))))

(define (g3r-trained-replay-compare! model tokenizer captured input
                                     snapshot record digest companion-path
                                     observer)
  (let ((imported #f) (replayed #f) (replay-input #f) (replay-logits #f)
        (reference #f) (reference-output #f) (replay-output #f))
    (define (cleanup)
      (if reference-output (g3t-output-release! reference-output))
      (if replay-output (g3t-output-release! replay-output))
      (if replay-logits (g3t-generation-tensor-release! replay-logits))
      (if replay-input (g3t-generation-tensor-release! replay-input))
      (if reference (g3t-generator-close! reference))
      (if replayed (g3t-generator-close! replayed))
      (if imported (g3t-generation-rng-release! imported))
      #t)
    (guard (caught
             (#t (guard (cleanup-defect (#t (exit 134))) (cleanup))
                 (raise caught)))
      (let* ((readback (g3r-trained-pair-file-image companion-path 288))
             (decoded (make-vector 8 #f))
             (capture-native
               (vector-ref (g3t-generator-find captured 'g3r-trained-replay) 3)))
        (g3r-trained-replay-check
          (and (= (bytevector-length readback) 288)
               (g3r-bytes=? readback 0 record 0 288))
          "published budget-one companion changed")
        (g3r-trained-replay-check
          (and (g3r-trained-replay-wrong-digest-rejects? readback digest)
               (let unchanged ((i 0))
                 (if (= i 4) #t
                     (and (= (g3r-test-rng capture-native i)
                             (vector-ref (vector-ref snapshot 1) i))
                          (unchanged (+ i 1))))))
          "wrong digest changed capture owner or destination")
        (g3r-record-decode! readback digest decoded)
        (g3r-trained-replay-check
          (and (= (vector-ref (vector-ref decoded 0) 4) 1)
               (= (vector-ref decoded 3) 1)
               (= (vector-ref decoded 4) 0)
               (= (vector-ref decoded 5) 0)
               (= (bytevector-length (vector-ref decoded 2)) 1)
               (g3r-trained-replay-vector=?
                 (vector-ref decoded 0) (vector-ref snapshot 0) 6)
               (g3r-trained-replay-vector=?
                 (vector-ref decoded 1) (vector-ref snapshot 1) 4)
               (g3r-bytes=? (vector-ref decoded 2) 0
                             (vector-ref snapshot 2) 0 1)
               (g3r-bytes=? (vector-ref decoded 6) 0
                             (string->utf8
                               (t2-wave2-tokenizer-fingerprint tokenizer))
                             0 96)
               (g3r-bytes=? (vector-ref decoded 7) 0 digest 0 32))
          "budget-one companion differs from trained owner snapshot")
        (let ((words (vector-ref decoded 1))
              (policy (vector-ref decoded 0))
              (history (vector-ref decoded 2)))
          (set! imported (g3r-rng-owner-from-checked-words
                           (vector-ref words 0) (vector-ref words 1)
                           (vector-ref words 2) (vector-ref words 3)))
          (set! replayed
            (g3t-generator-create model tokenizer
              (list ':profile 'diagnostic-c2 ':sampling 'categorical
                    ':temperature-bits (vector-ref policy 1)
                    ':top-k (vector-ref policy 2)
                    ':top-p-bits (vector-ref policy 3)
                    ':max-new-tokens (vector-ref policy 4)
                    ':eos #f ':rng imported)))
          (g3t-generation-rng-release! imported)
          (set! imported #f)
          (set! replay-input
            (g3t-generation-token-input-create
              (bytevector-u8-ref history 0)))
          (set! replay-logits (g3m-prefill-p1! replayed replay-input)))
        (let ((capture-native
                (vector-ref (g3t-generator-find captured 'g3r-trained-replay) 3))
              (replay-native
                (vector-ref (g3t-generator-find replayed 'g3r-trained-replay) 3)))
          (g3r-trained-replay-check
            (and (= (g3r-test-cache-length capture-native) 1)
                 (= (g3r-test-cache-length replay-native) 1)
                 (g3r-trained-replay-logits=? capture-native replay-native)
                 (g3r-trained-replay-kv=? capture-native replay-native 4)
                 (g3r-trained-replay-rng=? capture-native replay-native))
            "decoded no-draw P1 replay differs from captured trained owner")
          (if observer
              (observer 'p1 replay-native #f (vector-ref decoded 1)))
          (set! reference
            (g3t-generator-create model tokenizer
              (list ':profile 'diagnostic-c2 ':sampling 'categorical
                    ':temperature-bits #x3f800000 ':top-k 256
                    ':top-p-bits #x3f800000 ':max-new-tokens 1
                    ':eos #f ':seed 1729)))
          (set! reference-output (g3m-generate-p1-g1! reference input))
          (set! replay-output (g3r-private-replayed-p1-g1! replayed))
          (let ((reference-native
                  (vector-ref (g3t-generator-find reference 'g3r-trained-replay) 3))
                (reference-output-native
                  (vector-ref (g3t-prefill-entry reference-output 'output
                                                'g3r-trained-replay) 3))
                (replay-output-native
                  (vector-ref (g3t-prefill-entry replay-output 'output
                                                'g3r-trained-replay) 3)))
            (g3r-trained-replay-check
              (and (= (g3r-test-cache-length reference-native) 2)
                   (= (g3r-test-cache-length replay-native) 2)
                   (= (g3r-test-output reference-output-native 1) 1)
                   (= (g3r-test-output replay-output-native 1) 1)
                   (= (g3r-test-output reference-output-native 2) 2)
                   (= (g3r-test-output replay-output-native 2) 2)
                   (>= (g3r-test-output reference-output-native 6) 0)
                   (<= (g3r-test-output reference-output-native 6) 255)
                   (= (g3r-test-output reference-output-native 6)
                      (g3r-test-output replay-output-native 6))
                   (g3r-trained-replay-rng=? reference-native replay-native)
                   (g3r-trained-replay-kv=? reference-native replay-native 8))
              "trained same-registry generated G1 mismatch")
            (if observer
                (observer 'g1 replay-native replay-output-native #f)))))
      (cleanup)
      (set! imported #f)
      (set! replayed #f)
      (set! replay-input #f)
      (set! replay-logits #f)
      (set! reference #f)
      (set! reference-output #f)
      (set! replay-output #f)
      #t)))
