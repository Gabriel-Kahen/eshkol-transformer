;;; Source-private kind-8 RNG owner mapping. Load after final publication.
;;; No generator creation, public facade, or package export is defined here.
(extern ptr g3t-native-output-rng-clone ptr
        :real et_g3t_private_output_rng_clone_v1)
(extern i64 g3t-native-rng-release ptr
        :real et_g3t_private_rng_release_v1)

(define (g3t-generation-output-rng output)
  (let ((operation 'g3t-generation-output-rng))
    (m3-call operation
      (let ((source (g3t-prefill-entry output 'output operation)))
        (if (not (and (eq? (vector-ref source 2) 'live)
                      (not (null? (vector-ref source 3)))
                      (eq? (vector-ref source 4) #f)
                      (eq? (vector-ref source 5) #f)
                      (bytevector? (vector-ref source 6))))
            (g3t-fail-raw 'invalid-state operation 2
                          "G3-T output is not independently live"))
        (let* ((shell (vector 'g3t-rng-private))
               (ledger (vector #f))
               (entry (vector shell 'rng 'pending #f #f #f #f #f #f #f
                              ledger 'diagnostic-c2))
               (next (cons entry (vector-ref g3t-registry 0)))
               (created '()))
          (guard (caught
                   (#t
                     (if (not (null? created))
                         (if (not (= 0 (g3t-native-rng-release created)))
                             (exit 134)))
                     (g3t-prefill-dead! entry)
                     (raise caught)))
            (vector-set! g3t-registry 0 next)
            (let* ((canonical (car (vector-ref g3t-registry 0)))
                   (canonical-ledger (vector-ref canonical 10))
                   (native (g3t-native-output-rng-clone
                             (vector-ref source 3))))
              (set! created native)
              (if (null? native) (g3t-native-fail-raw operation))
              (vector-set! canonical-ledger 0 native)
              (vector-set! canonical 3 native)
              (vector-set! canonical 2 'live)
              (vector-set! canonical 10 #f)
              (vector-ref canonical 0))))))))

(define (g3t-generation-rng-release! rng)
  (let ((operation 'g3t-generation-rng-release!))
    (m3-call operation
      (let ((entry (g3t-prefill-entry rng 'rng operation)))
        (if (eq? (vector-ref entry 2) 'dead)
            (let check-dead ((index 3))
              (if (= index 12) #t
                  (if (eq? (vector-ref entry index) #f)
                      (check-dead (+ index 1))
                      (g3t-fail-raw 'invalid-state operation 2
                                    "dead G3-T RNG retained payload"))))
            (begin
              (if (not (and (eq? (vector-ref entry 2) 'live)
                            (not (null? (vector-ref entry 3)))
                            (eq? (vector-ref entry 4) #f)
                            (eq? (vector-ref entry 5) #f)
                            (eq? (vector-ref entry 6) #f)
                            (eq? (vector-ref entry 7) #f)
                            (eq? (vector-ref entry 8) #f)
                            (eq? (vector-ref entry 9) #f)
                            (eq? (vector-ref entry 10) #f)
                            (eq? (vector-ref entry 11) 'diagnostic-c2)))
                  (g3t-fail-raw 'invalid-state operation 2
                                "G3-T RNG is not independently live"))
              (if (not (= 0 (g3t-native-rng-release
                              (vector-ref entry 3))))
                  (g3t-native-fail-raw operation))
              (g3t-prefill-dead! entry)))))))
