;;; Private single-microbatch CPU4 schedule. Load after real D2 and binding roots.
;;; Caller owns the live batch; this call contributes gradients but does not
;;; advance trainer counters, seek/release D2, or update optimizer parameters.
(extern i64 cpu4-train-native-enter ptr i64 :real et_g3c4_private_training_lease_enter_v1)
(extern i64 cpu4-train-native-leave ptr :real et_g3c4_private_training_lease_leave_v1)
(extern ptr cpu4-train-native-input ptr i64 i64 i64 i64 :real et_cpu4_private_input_create_v1)
(extern ptr cpu4-train-native-logits ptr :real et_cpu4_private_logits_create_v1)
(extern ptr cpu4-train-native-workspace ptr ptr i64 :real et_cpu4_private_workspace_create_v1)
(extern i64 cpu4-train-native-role ptr i64 i64 i64 :real et_cpu4_private_workspace_role_v1)
(extern i64 cpu4-train-native-copy-logits ptr ptr :real et_cpu4_private_workspace_copy_logits_v1)
(extern i64 cpu4-train-native-vjp-begin ptr ptr :real et_cpu4_private_workspace_vjp_begin_v1)
(extern i64 cpu4-train-native-contribute ptr i64 i64 i64 :real et_cpu4_private_workspace_contribute_v1)
(extern i64 cpu4-train-native-release-input ptr :real et_cpu4_private_input_release_v1)
(extern i64 cpu4-train-native-release-logits ptr :real et_cpu4_private_logits_release_v1)
(extern i64 cpu4-train-native-release-workspace ptr :real et_cpu4_private_workspace_release_v1)
(extern i64 cpu4-train-native-batch-copy ptr ptr ptr i64 :real et_cpu4_private_batch_copy_v1)
(extern i64 cpu4-train-native-objective ptr ptr ptr ptr ptr :real et_cpu4_private_objective_prepare_v1)
(extern i64 cpu4-train-native-domain :real et_cpu4_private_last_error_domain_v1)
(extern i64 cpu4-train-native-category :real et_cpu4_private_last_error_category_v1)
(extern i64 cpu4-train-native-code :real et_cpu4_private_last_error_code_v1)

(define cpu4-training-forward-roles
  '#(#(0 0) #(0 1) #(4 0) #(2 0) #(1 0) #(1 1) #(1 2)
     #(5 0) #(5 1) #(5 2) #(7 0) #(6 0) #(1 3) #(4 1)
     #(2 1) #(1 4) #(3 0) #(1 5) #(4 2) #(2 2) #(1 6)))
(define cpu4-training-reverse-roles
  '#(#(1 6) #(2 2) #(4 2) #(1 5) #(3 0) #(1 4) #(2 1) #(8 2)
     #(4 1) #(1 3) #(6 0) #(7 0) #(5 0) #(5 1) #(5 2)
     #(1 0) #(1 1) #(1 2) #(8 0) #(2 0) #(8 1) #(4 0)
     #(0 0) #(0 1) #(8 3)))
(define (cpu4-training-error-category)
  ;; Transport4 wraps the G3 native domain0; transport3 is genuine f32.
  (let ((domain (cpu4-train-native-domain)))
    (g3c4-native-category (if (= domain 4) 0 domain) (cpu4-train-native-category))))
(define (cpu4-training-check status operation)
  (if (not (= status 0))
      (cpu4-binding-fail
        (cpu4-training-error-category)
        operation "CPU4 numerical transport rejected the request"))
  #t)
(define (cpu4-training-pointer pointer operation)
  (if (null? pointer)
      (cpu4-binding-fail
        (cpu4-training-error-category)
        operation "CPU4 numerical transport did not create an owner"))
  pointer)
(define (cpu4-training-schedule workspace roles reverse operation)
  (let loop ((index 0))
    (if (< index (vector-length roles))
        (let ((role (vector-ref roles index)))
          (cpu4-training-check
            (cpu4-train-native-role workspace (vector-ref role 0) (vector-ref role 1) reverse)
            operation)
          (loop (+ index 1))))))
(define (cpu4-training-u32 bytes offset)
  (+ (bytevector-u8-ref bytes offset) (* 256 (bytevector-u8-ref bytes (+ offset 1)))
     (* 65536 (bytevector-u8-ref bytes (+ offset 2)))
     (* 16777216 (bytevector-u8-ref bytes (+ offset 3)))))
(define (cpu4-training-cleanup! ledger lease)
  ;; No dependency can retain a raw view after its native call returns.
  ;; Cleanup failure is an impossible ownership defect, never hidden success.
  (if (vector-ref ledger 1)
      (if (not (= (cpu4-train-native-release-workspace (vector-ref ledger 1)) 0))
          (cpu4-binding-fail-stop 70)))
  (if (vector-ref ledger 0)
      (if (not (= (cpu4-train-native-release-input (vector-ref ledger 0)) 0))
          (cpu4-binding-fail-stop 70)))
  (if (vector-ref ledger 2)
      (if (not (= (cpu4-train-native-release-logits (vector-ref ledger 2)) 0))
          (cpu4-binding-fail-stop 70)))
  (if (vector-ref ledger 3)
      (if (not (= (cpu4-train-native-release-logits (vector-ref ledger 3)) 0))
          (cpu4-binding-fail-stop 70)))
  (if (vector-ref ledger 4)
      (if (not (= (cpu4-train-native-leave lease) 0)) (cpu4-binding-fail-stop 70)))
  #t)
(define (cpu4-training-batch-profile! batch operation)
  (let* ((capability (d2-current-capability batch 'batch operation))
         (state (d2-dataset-state (vector-ref capability 1) operation))
         (core (vector-ref state 6)))
    (if (not (and (d2-core-state-valid? core 'd2-dataset-state)
                  (= (vector-ref core 3) 256) (= (vector-ref core 4) 1)
                  (= (vector-ref core 5) 4)
                  (string=? (vector-ref core 2)
                    "sha256:eshkol-byte-tokenizer-v1:aabb31f49216963582383a00fd2e85d7c20b658d5bef0e7945344ed6bfe50704")))
        (cpu4-binding-fail 'unsupported operation "batch must belong to an N1/T4 raw-byte V256 dataset"))
    #t))
(define (cpu4-training-microbatch-internal! binding batch ordinal observation)
  (let* ((operation 'cpu4-training-microbatch!)
         (record (cpu4-model-binding-check-internal binding))
         (lease (vector-ref record 5))
         (ids (make-bytevector 32 0)) (targets (make-bytevector 32 0))
         (mask (make-bytevector 4 0)) (staged-observation (make-bytevector 12 0))
         (ledger (vector #f #f #f #f #f)))
    (if (not (and (m3t-exact-i64? ordinal) (>= ordinal 0)
                  (bytevector? observation) (= (bytevector-length observation) 12)))
        (cpu4-binding-fail 'invalid-argument operation "ordinal or observation differs"))
    (d2-token-batch-validate batch)
    (cpu4-training-batch-profile! batch operation)
    (d2-token-tensor-with-view-internal (d2-token-batch-inputs batch)
      (lambda (view) (cpu4-training-check (cpu4-train-native-batch-copy lease view ids 0) operation)))
    (d2-token-tensor-with-view-internal (d2-token-batch-targets batch)
      (lambda (view) (cpu4-training-check (cpu4-train-native-batch-copy lease view targets 1) operation)))
    (d2-token-tensor-with-view-internal (d2-token-batch-loss-mask batch)
      (lambda (view) (cpu4-training-check (cpu4-train-native-batch-copy lease view mask 2) operation)))
    (g3c4-native-check (cpu4-train-native-enter lease 1) operation)
    (vector-set! ledger 4 #t)
    (guard (caught (#t (cpu4-training-cleanup! ledger lease) (raise caught)))
      (vector-set! ledger 0 (cpu4-training-pointer
        (cpu4-train-native-input lease (bytevector-u8-ref ids 0) (bytevector-u8-ref ids 8)
          (bytevector-u8-ref ids 16) (bytevector-u8-ref ids 24)) operation))
      (vector-set! ledger 1 (cpu4-training-pointer
        (cpu4-train-native-workspace lease (vector-ref ledger 0) 1) operation))
      (vector-set! ledger 2 (cpu4-training-pointer (cpu4-train-native-logits lease) operation))
      (vector-set! ledger 3 (cpu4-training-pointer (cpu4-train-native-logits lease) operation))
      (cpu4-training-schedule (vector-ref ledger 1) cpu4-training-forward-roles 0 operation)
      (cpu4-training-check (cpu4-train-native-copy-logits (vector-ref ledger 1) (vector-ref ledger 2)) operation)
      (cpu4-training-check (cpu4-train-native-objective (vector-ref ledger 2) (vector-ref ledger 3)
          targets mask staged-observation) operation)
      (cpu4-training-check (cpu4-train-native-vjp-begin (vector-ref ledger 1) (vector-ref ledger 3)) operation)
      (cpu4-training-schedule (vector-ref ledger 1) cpu4-training-reverse-roles 1 operation)
      ;; Last fallible P1/config check precedes the sole atomic14-gradient write.
      (cpu4-model-binding-check-internal binding)
      (cpu4-training-check (cpu4-train-native-contribute (vector-ref ledger 1) 1
          (cpu4-training-u32 staged-observation 4) ordinal) operation))
    (cpu4-training-cleanup! ledger lease)
    ;; Cleanup has an allocation-free fail-stop boundary; publication is twelve
    ;; fixed byte stores with no callback, provider dispatch or allocation.
    (bytevector-u8-set! observation 0 (bytevector-u8-ref staged-observation 0))
    (bytevector-u8-set! observation 1 (bytevector-u8-ref staged-observation 1))
    (bytevector-u8-set! observation 2 (bytevector-u8-ref staged-observation 2))
    (bytevector-u8-set! observation 3 (bytevector-u8-ref staged-observation 3))
    (bytevector-u8-set! observation 4 (bytevector-u8-ref staged-observation 4))
    (bytevector-u8-set! observation 5 (bytevector-u8-ref staged-observation 5))
    (bytevector-u8-set! observation 6 (bytevector-u8-ref staged-observation 6))
    (bytevector-u8-set! observation 7 (bytevector-u8-ref staged-observation 7))
    (bytevector-u8-set! observation 8 (bytevector-u8-ref staged-observation 8))
    (bytevector-u8-set! observation 9 (bytevector-u8-ref staged-observation 9))
    (bytevector-u8-set! observation 10 (bytevector-u8-ref staged-observation 10))
    (bytevector-u8-set! observation 11 (bytevector-u8-ref staged-observation 11))

    #t))
