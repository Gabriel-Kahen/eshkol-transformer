;;; Public D1 corpus and D2 dataset/batch surface.

(require transformer.error_consumer)

(provide token-corpus-write!
         token-corpus-validate
         token-corpus-summary-shard-count
         token-corpus-summary-total-tokens
         token-corpus-summary-vocab-size
         token-corpus-summary-shard-token-limit
         token-corpus-summary-tokenizer-fingerprint
         token-corpus-summary-total-shard-bytes
         token-dataset-open
         token-dataset-next-batch
         token-dataset-cursor
         token-dataset-end?
         token-dataset-seek!
         token-dataset-close!
         token-batch-inputs
         token-batch-targets
         token-batch-loss-mask
         token-batch-validate
         token-batch-release!)

(define e1b-safe-d1-token-corpus-write-call
  (let ()
    (extern void e1b-d1-token-corpus-write ptr ptr ptr ptr ptr ptr
            :real et_e1b_public_d1_token_corpus_write_v1)
    (lambda (directory fingerprint vocab-size shard-token-limit tokens)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-write
         (vector directory) (vector fingerprint) (vector vocab-size)
         (vector shard-token-limit) (vector tokens) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-validate-call
  (let ()
    (extern void e1b-d1-token-corpus-validate ptr ptr ptr ptr ptr
            :real et_e1b_public_d1_token_corpus_validate_v1)
    (lambda (directory maximum-manifest-bytes maximum-shard-bytes
                       maximum-total-tokens)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-validate
         (vector directory) (vector maximum-manifest-bytes)
         (vector maximum-shard-bytes) (vector maximum-total-tokens) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-shard-count-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-shard-count ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_shard_count_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-shard-count (vector summary) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-total-tokens-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-total-tokens ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_total_tokens_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-total-tokens (vector summary) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-vocab-size-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-vocab-size ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_vocab_size_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-vocab-size (vector summary) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-shard-token-limit-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-shard-token-limit ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_shard_token_limit_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-shard-token-limit
         (vector summary) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-tokenizer-fingerprint-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-tokenizer-fingerprint ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_tokenizer_fingerprint_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-tokenizer-fingerprint
         (vector summary) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-summary-total-shard-bytes-call
  (let ()
    (extern void e1b-d1-token-corpus-summary-total-shard-bytes ptr ptr
            :real et_e1b_public_d1_token_corpus_summary_total_shard_bytes_v1)
    (lambda (summary)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-summary-total-shard-bytes
         (vector summary) output)
        (vector-ref output 0)))))

(define (token-corpus-write! directory fingerprint vocab-size shard-token-limit
                             tokens)
  (e1b-safe-d1-token-corpus-write-call
   directory fingerprint vocab-size shard-token-limit tokens))

(define (token-corpus-validate directory maximum-manifest-bytes
                               maximum-shard-bytes maximum-total-tokens)
  (e1b-safe-d1-token-corpus-validate-call
   directory maximum-manifest-bytes maximum-shard-bytes maximum-total-tokens))

(define (token-corpus-summary-shard-count summary)
  (e1b-safe-d1-token-corpus-summary-shard-count-call summary))

(define (token-corpus-summary-total-tokens summary)
  (e1b-safe-d1-token-corpus-summary-total-tokens-call summary))

(define (token-corpus-summary-vocab-size summary)
  (e1b-safe-d1-token-corpus-summary-vocab-size-call summary))

(define (token-corpus-summary-shard-token-limit summary)
  (e1b-safe-d1-token-corpus-summary-shard-token-limit-call summary))

(define (token-corpus-summary-tokenizer-fingerprint summary)
  (e1b-safe-d1-token-corpus-summary-tokenizer-fingerprint-call summary))

(define (token-corpus-summary-total-shard-bytes summary)
  (e1b-safe-d1-token-corpus-summary-total-shard-bytes-call summary))

(define-syntax d2-safe-unary-call
  (syntax-rules ()
    ((_ binding native-name)
     (define binding
       (let ()
         (extern void native-call ptr ptr :real native-name)
         (lambda (value)
           (let ((output (vector #f)))
             (native-call (vector value) output)
             (vector-ref output 0))))))))

(define-syntax d2-safe-binary-call
  (syntax-rules ()
    ((_ binding native-name)
     (define binding
       (let ()
         (extern void native-call ptr ptr ptr :real native-name)
         (lambda (left right)
           (let ((output (vector #f)))
             (native-call (vector left) (vector right) output)
             (vector-ref output 0))))))))

(d2-safe-binary-call e1b-safe-d2-token-dataset-open-call
                     et_e1b_public_d2_token_dataset_open_v1)
(d2-safe-unary-call e1b-safe-d2-token-dataset-next-batch-call
                    et_e1b_public_d2_token_dataset_next_batch_v1)
(d2-safe-unary-call e1b-safe-d2-token-dataset-cursor-call
                    et_e1b_public_d2_token_dataset_cursor_v1)
(d2-safe-unary-call e1b-safe-d2-token-dataset-end-call
                    et_e1b_public_d2_token_dataset_end_v1)
(d2-safe-binary-call e1b-safe-d2-token-dataset-seek-call
                     et_e1b_public_d2_token_dataset_seek_v1)
(d2-safe-unary-call e1b-safe-d2-token-dataset-close-call
                    et_e1b_public_d2_token_dataset_close_v1)
(d2-safe-unary-call e1b-safe-d2-token-batch-inputs-call
                    et_e1b_public_d2_token_batch_inputs_v1)
(d2-safe-unary-call e1b-safe-d2-token-batch-targets-call
                    et_e1b_public_d2_token_batch_targets_v1)
(d2-safe-unary-call e1b-safe-d2-token-batch-loss-mask-call
                    et_e1b_public_d2_token_batch_loss_mask_v1)
(d2-safe-unary-call e1b-safe-d2-token-batch-validate-call
                    et_e1b_public_d2_token_batch_validate_v1)
(d2-safe-unary-call e1b-safe-d2-token-batch-release-call
                    et_e1b_public_d2_token_batch_release_v1)

(define (token-dataset-open config tokenizer)
  (e1b-safe-d2-token-dataset-open-call config tokenizer))

(define (token-dataset-next-batch dataset)
  (e1b-safe-d2-token-dataset-next-batch-call dataset))

(define (token-dataset-cursor dataset)
  (e1b-safe-d2-token-dataset-cursor-call dataset))

(define (token-dataset-end? value)
  (e1b-safe-d2-token-dataset-end-call value))

(define (token-dataset-seek! dataset cursor)
  (e1b-safe-d2-token-dataset-seek-call dataset cursor))

(define (token-dataset-close! dataset)
  (e1b-safe-d2-token-dataset-close-call dataset))

(define (token-batch-inputs batch)
  (e1b-safe-d2-token-batch-inputs-call batch))

(define (token-batch-targets batch)
  (e1b-safe-d2-token-batch-targets-call batch))

(define (token-batch-loss-mask batch)
  (e1b-safe-d2-token-batch-loss-mask-call batch))

(define (token-batch-validate batch)
  (e1b-safe-d2-token-batch-validate-call batch))

(define (token-batch-release! batch)
  (e1b-safe-d2-token-batch-release-call batch))
