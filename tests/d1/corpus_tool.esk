(require transformer.data)

(define (d1-tool-category error)
  (if (transformer-error? error) (transformer-error-category error) 'internal))

(define (d1-tool-details-ref details key)
  (cond
    ((null? details) #f)
    ((eq? (car (car details)) key) (car (cdr (car details))))
    (else (d1-tool-details-ref (cdr details) key))))

(define (d1-tool-zeros count)
  (let loop ((remaining count) (result '()))
    (if (= remaining 0) result (loop (- remaining 1) (cons 0 result)))))

(define (d1-tool-print-summary summary)
  (display "shards=") (display (token-corpus-summary-shard-count summary))
  (display " tokens=") (display (token-corpus-summary-total-tokens summary))
  (display " vocab=") (display (token-corpus-summary-vocab-size summary))
  (display " limit=") (display (token-corpus-summary-shard-token-limit summary))
  (display " bytes=") (display (token-corpus-summary-total-shard-bytes summary))
  (display " fingerprint=")
  (display (token-corpus-summary-tokenizer-fingerprint summary))
  (newline))

(define (d1-tool-write scenario directory)
  (cond
    ((string=? scenario "standard")
     (token-corpus-write! directory "opaque-tokenizer-identity" 257 3
                          '(0 1 256 42 7 8 9)))
    ((string=? scenario "empty")
     (token-corpus-write! directory "empty-corpus-identity" 1 3 '()))
    ((string=? scenario "exact")
     (token-corpus-write! directory "exact-boundary-identity" 8 3 '(0 7 3)))
    ((string=? scenario "limit-minus-one")
     (token-corpus-write! directory "boundary-identity" 8 3 '(0 7)))
    ((string=? scenario "limit-plus-one")
     (token-corpus-write! directory "boundary-identity" 8 3 '(0 1 2 3)))
    ((string=? scenario "two-limit")
     (token-corpus-write! directory "boundary-identity" 8 3 '(0 1 2 3 4 5)))
    ((string=? scenario "two-limit-plus-one")
     (token-corpus-write! directory "boundary-identity" 8 3 '(0 1 2 3 4 5 6)))
    ((string=? scenario "vocab-one")
     (token-corpus-write! directory "vocab-one-identity" 1 1 '(0)))
    ((string=? scenario "max-token")
     (token-corpus-write! directory "max-token-identity"
                          9223372036854775807 1 '(9223372036854775806)))
    ((string=? scenario "fingerprint-max")
     (token-corpus-write! directory (make-string 192 #\a) 1 1 '(0)))
    ((string=? scenario "fingerprint-utf8")
     (token-corpus-write! directory "opaque-λ-identity" 8 2 '(0 7 3)))
    ((string=? scenario "publication-limit")
     (token-corpus-write! directory "publication-failure-identity" 8 1
                          (d1-tool-zeros 128)))
    ((string=? scenario "invalid-negative")
     (token-corpus-write! directory "invalid-token" 8 3 '(0 -1)))
    ((string=? scenario "invalid-vocab")
     (token-corpus-write! directory "invalid-token" 8 3 '(0 8)))
    ((string=? scenario "invalid-large")
     (token-corpus-write! directory "invalid-token" 8 3
                          '(0 9223372036854775808)))
    ((string=? scenario "invalid-noninteger")
     (token-corpus-write! directory "invalid-token" 8 3 '(0 "one")))
    ((string=? scenario "invalid-improper")
     (token-corpus-write! directory "invalid-token" 8 3 (cons 0 1)))
    ((string=? scenario "invalid-cycle")
     (let ((tokens (list 0 1)))
       (set-cdr! (cdr tokens) tokens)
       (token-corpus-write! directory "invalid-token" 8 3 tokens)))
    ((string=? scenario "invalid-inexact-token")
     (token-corpus-write! directory "invalid-token" 8 3 '(0 7.0)))
    ((string=? scenario "invalid-vocab-size")
     (token-corpus-write! directory "invalid-config" 0 3 '(0)))
    ((string=? scenario "invalid-limit")
     (token-corpus-write! directory "invalid-config" 8 0 '(0)))
    ((string=? scenario "invalid-inexact-vocab")
     (token-corpus-write! directory "invalid-config" 8.0 3 '(0)))
    ((string=? scenario "invalid-inexact-limit")
     (token-corpus-write! directory "invalid-config" 8 3.0 '(0)))
    ((string=? scenario "invalid-fingerprint")
     (token-corpus-write! directory "" 8 3 '(0)))
    ((string=? scenario "invalid-fingerprint-long")
     (token-corpus-write! directory (make-string 193 #\a) 8 3 '(0)))
    (else (raise (list 'invalid-argument 'd1-tool-write "unknown scenario")))))

(define arguments (command-line))
(if (< (d1-token-list-length arguments) 3)
    (begin (display "usage: corpus-tool COMMAND DIRECTORY [SCENARIO]") (newline) (exit 64)))

(define command (d1-token-list-ref arguments 1))
(define directory (d1-token-list-ref arguments 2))
(guard (error (#t
               (begin
                 (display "ERROR category=") (display (d1-tool-category error))
                 (if (transformer-error? error)
                     (begin
                       (display " operation=")
                       (display (transformer-error-operation error))
                       (display " message=")
                       (display (transformer-error-message error))
                       (let* ((details (transformer-error-details error))
                              (domain (d1-tool-details-ref details 'source-domain))
                              (code (d1-tool-details-ref details 'source-code))
                              (source-message
                               (d1-tool-details-ref details 'source-message)))
                         (if domain
                             (begin
                               (display " source-domain=") (display domain)
                               (display " source-code=") (display code)
                               (display " source-message=") (display source-message)
                               (display " cause=")
                               (display (transformer-error-cause error)))
                             #t)))
                     #t)
                 (newline)
                 (exit 2))))
  (cond
    ((string=? command "write")
     (if (< (d1-token-list-length arguments) 4)
         (raise (list 'invalid-argument 'd1-tool "missing scenario"))
         (d1-tool-print-summary
          (d1-tool-write (d1-token-list-ref arguments 3) directory))))
    ((string=? command "validate")
     (d1-tool-print-summary
      (token-corpus-validate directory 1048576 1048576 1048576)))
    ((string=? command "validate-small-manifest")
     (d1-tool-print-summary (token-corpus-validate directory 16 1048576 1048576)))
    ((string=? command "validate-small-shard")
     (d1-tool-print-summary (token-corpus-validate directory 1048576 16 1048576)))
    ((string=? command "validate-small-total")
     (d1-tool-print-summary (token-corpus-validate directory 1048576 1048576 1)))
    ((string=? command "validate-zero-total")
     (d1-tool-print-summary (token-corpus-validate directory 1048576 1048576 0)))
    ((string=? command "validate-invalid-manifest-limit")
     (d1-tool-print-summary (token-corpus-validate directory 0 1048576 1048576)))
    ((string=? command "validate-invalid-shard-limit")
     (d1-tool-print-summary (token-corpus-validate directory 1048576 2.0 1048576)))
    ((string=? command "validate-invalid-total-limit")
     (d1-tool-print-summary (token-corpus-validate directory 1048576 1048576 -1)))
    ((string=? command "invalid-summary")
     (display (token-corpus-summary-total-shard-bytes 1)))
    ((string=? command "invalid-summary-procedure")
     (display
      (token-corpus-summary-shard-count (lambda (secret index) -5))))
    (else (raise (list 'invalid-argument 'd1-tool "unknown command")))))
