;;; Interpose the accepted last recoverable check before joint source load.
;;; The real native/O2 check runs on all successful cycles.
(define tr3-cycle-original-o2-check tr3-c-restore-o2-check-internal)
(define tr3-cycle-fail-o2-check? #f)
(define (tr3-c-restore-o2-check-internal ledger)
  (if tr3-cycle-fail-o2-check?
      (begin
        (set! tr3-cycle-fail-o2-check? #f)
        (m3t-fail 'internal 'trainer-load-state!
                  "injected pre-seal O2 check failure"))
      (tr3-cycle-original-o2-check ledger)))

