(require transformer.module)
(require transformer.error_internal)
(require p1_test.tensor_provider)

(extern i64 p1-module-test-live-count
        :real et_p1_test_live_entry_count_v1)

(define checks 0)

(define (repeat-value count value)
  (let loop ((remaining count) (result '()))
    (if (= remaining 0)
        result
        (loop (- remaining 1) (cons value result)))))

(define (nest-vector count value)
  (if (= count 0)
      value
      (nest-vector (- count 1) (vector value))))

(define (check label condition)
  (if condition
      (begin
        (set! checks (+ checks 1)))
      (begin
        (display "P1 FAIL: ")
        (display label)
        (newline)
        (exit 1))))

(define (expect-error label category thunk)
  (let ((caught
          (guard (error
                   (#t
                     (and (transformer-error? error)
                          (eq? category (transformer-error-category error)))))
            (thunk)
            #f)))
    (check label caught)))

(define (expect-raised-false label thunk)
  (let ((caught? #f))
    (guard (caught
             (#t
               (set! caught? (eq? caught #f))
               #f))
      (thunk))
    (check label caught?)))

(define (expect-transformer-error label thunk)
  (let ((caught
          (guard (error (#t (transformer-error? error)))
            (thunk)
            #f)))
    (check label caught)))

(define (expect-error-contract label category operation message thunk)
  (let ((caught
          (guard (error (#t error))
            (thunk)
            #f)))
    (check (string-append label " structured") (transformer-error? caught))
    (check (string-append label " category")
           (eq? category (transformer-error-category caught)))
    (check (string-append label " operation")
           (eq? operation (transformer-error-operation caught)))
    (check (string-append label " message")
           (string=? message (transformer-error-message caught)))
    (check (string-append label " details/cause")
           (and (null? (transformer-error-details caught))
                (not (transformer-error-cause caught))))))

(define (expect-storage-probe-error label category thunk)
  (let ((owned-before (fixture-owned-live-count-internal))
        (release-before (fixture-release-call-count-internal))
        (native-before (p1-module-test-live-count)))
    (let ((caught (guard (raised (#t raised)) (thunk) #f)))
      (check (string-append label " structured/category")
             (and (transformer-error? caught)
                  (eq? category (transformer-error-category caught))))
      (check (string-append label " no publication/allocation drift")
             (and (= owned-before (fixture-owned-live-count-internal))
                  (= release-before (fixture-release-call-count-internal))
                  (= native-before (p1-module-test-live-count)))))))

(define (expect-storage-probe-raised-false label thunk)
  (let ((owned-before (fixture-owned-live-count-internal))
        (release-before (fixture-release-call-count-internal))
        (native-before (p1-module-test-live-count))
        (caught-false? #f))
    (guard (raised
             (#t
               (set! caught-false? (eq? raised #f))
               #f))
      (thunk))
    (check (string-append label " exact raised false") caught-false?)
    (check (string-append label " no publication/allocation drift")
           (and (= owned-before (fixture-owned-live-count-internal))
                (= release-before (fixture-release-call-count-internal))
                (= native-before (p1-module-test-live-count))))))

(define (payload name)
  (fixture-tensor-internal '(2 2) 'f32 'cpu (vector name 'bits-v1)))

(define (buffer-payload name)
  (fixture-tensor-internal '(2) 'i64 'cpu (vector name 'bits-v1)))

(define (build-module parameter-name buffer-name)
  (let* ((root (module-create-fixture-internal))
         (child (module-create-fixture-internal))
         (grandchild (module-create-fixture-internal)))
    ;; Registration order is intentionally not lexical.
    (module-register-child-internal! child "inner" grandchild)
    (module-register-child-internal! root "block" child)
    (module-register-buffer-internal! child "stats" (buffer-payload buffer-name))
    (module-register-buffer-internal! root "zz" (buffer-payload 'late-buffer))
    (module-register-buffer-internal! root "aa" (buffer-payload 'early-buffer))
    (let ((weight
            (module-register-parameter-internal! root "z" (payload parameter-name))))
      ;; Equal values do not tie beta; alpha explicitly shares weight identity.
      (module-register-parameter-internal! child "beta" (payload parameter-name))
      (module-register-tied-parameter-internal! child "alpha" weight))
    root))

(define (build-module-permuted parameter-name buffer-name)
  (let* ((root (module-create-fixture-internal))
         (child (module-create-fixture-internal))
         (grandchild (module-create-fixture-internal)))
    (module-register-child-internal! root "block" child)
    (module-register-buffer-internal! root "aa" (buffer-payload 'early-buffer))
    (let ((weight
            (module-register-parameter-internal! root "z" (payload parameter-name))))
      (module-register-parameter-internal! child "beta" (payload parameter-name))
      (module-register-tied-parameter-internal! child "alpha" weight))
    (module-register-buffer-internal! root "zz" (buffer-payload 'late-buffer))
    (module-register-buffer-internal! child "stats" (buffer-payload buffer-name))
    (module-register-child-internal! child "inner" grandchild)
    root))

(define (state-payload state path)
  (let* ((handle (state-dict-tensor state path))
         (carrier
           (state-dict-tensor-borrow-begin-internal state handle)))
    (guard (caught
             (#t
               (state-dict-tensor-borrow-end-internal state handle)
               (raise caught)))
      (let ((payload (fixture-tensor-payload-internal carrier)))
        (state-dict-tensor-borrow-end-internal state handle)
        payload))))

(define (state-values state)
  (let loop ((paths (state-dict-paths state)) (result '()))
    (if (null? paths)
        result
        (loop (cdr paths)
              (cons (list (car paths) (state-payload state (car paths))) result)))))

(define (module-state-values module)
  (let ((state (module-state-dict module)))
    (guard (caught (#t (state-dict-release! state) (raise caught)))
      (let ((result (state-values state)))
        (state-dict-release! state)
        result))))

(define (module-state-paths module)
  (let ((state (module-state-dict module)))
    (guard (caught (#t (state-dict-release! state) (raise caught)))
      (let ((result (state-dict-paths state)))
        (state-dict-release! state)
        result))))

(define (module-state-aliases module)
  (let ((state (module-state-dict module)))
    (guard (caught (#t (state-dict-release! state) (raise caught)))
      (let ((result (state-dict-alias-groups state)))
        (state-dict-release! state)
        result))))

(define (replace-entry entries path replacement)
  (if (null? entries)
      '()
      (cons (if (equal? path (state-entry-path-internal (car entries)))
                replacement
                (car entries))
            (replace-entry (cdr entries) path replacement))))

(define (remove-entry entries path)
  (cond
    ((null? entries) '())
    ((equal? path (state-entry-path-internal (car entries))) (cdr entries))
    (else (cons (car entries) (remove-entry (cdr entries) path)))))

(define (find-entry entries path)
  (cond
    ((null? entries) #f)
    ((equal? path (state-entry-path-internal (car entries))) (car entries))
    (else (find-entry (cdr entries) path))))

(define (restate state entries aliases)
  (state-dict-create-unsafe-internal
    (state-dict-format-internal state) 1 0 '()
    (state-dict-adapter-internal state) entries aliases))

(define (load-state! module state)
  (state-dict-bind-provider-internal! state 'fixture-v1)
  (module-load-state-dict! module state))

(define (expect-load-error-and-release label category module state)
  (expect-error label category (lambda () (load-state! module state)))
  (state-dict-release! state))

(define (expect-module-load-error-and-release label category module state)
  (expect-error label category
                (lambda () (module-load-state-dict! module state)))
  (state-dict-release! state))

(define source (build-module 'source-parameter 'source-buffer))
(define permuted (build-module-permuted 'source-parameter 'source-buffer))
(define tree-a (module-parameters source))
(define tree-b (module-parameters source))

(check "parameter paths lexical"
       (equal? (parameter-tree-paths tree-a)
               '(("block" "alpha") ("block" "beta") ("z"))))
(check "parameter order ignores registration order"
       (equal? (parameter-tree-paths (module-parameters source))
               (parameter-tree-paths (module-parameters permuted))))
(check "fresh tree container" (not (eq? tree-a tree-b)))
(check "stable live handle"
       (eq? (parameter-tree-handle tree-a '("z"))
            (parameter-tree-handle tree-b '("z"))))
(check "tied paths share handle"
       (eq? (parameter-tree-handle tree-a '("block" "alpha"))
            (parameter-tree-handle tree-a '("z"))))
(check "equal-valued untied parameter stays distinct"
       (not (eq? (parameter-tree-handle tree-a '("block" "beta"))
                 (parameter-tree-handle tree-a '("z")))))
(check "tie group path values"
       (equal? (parameter-tree-tie-groups tree-a)
               '((("block" "alpha") ("z")))))
(check "canonical handle path"
       (equal? (parameter-handle-path (parameter-tree-handle tree-a '("z")))
               '("block" "alpha")))
(check "handle shape"
       (equal? (parameter-handle-shape (parameter-tree-handle tree-a '("z"))) '(2 2)))
(check "handle dtype"
       (eq? (parameter-handle-dtype (parameter-tree-handle tree-a '("z"))) 'f32))
(check "handle device"
       (eq? (parameter-handle-device (parameter-tree-handle tree-a '("z"))) 'cpu))

(define buffers (module-buffers source))
(check "buffer paths lexical"
       (equal? (state-dict-paths buffers)
               '(("aa") ("block" "stats") ("zz"))))
(check "buffers never alias" (null? (state-dict-alias-groups buffers)))

(define source-state (module-state-dict source))
(define valid-provider-identity (state-dict-adapter-internal source-state))
(let ((reconstructed
        (state-dict-create-unsafe-internal
          (state-dict-format-internal source-state) 1 0 '()
          valid-provider-identity (state-dict-entries-internal source-state)
          (state-dict-alias-groups source-state))))
  (expect-error "serialized state omits provider binding" 'unsupported
                (lambda () (state-dict-paths reconstructed)))
  (state-dict-bind-provider-internal! reconstructed 'fixture-v1)
  (check "provider bind returns same state identity"
         (eq? reconstructed
              (state-dict-bind-provider-internal! reconstructed 'fixture-v1)))
  (check "explicit provider bind restores state inspection"
         (equal? (state-dict-paths reconstructed)
                 (state-dict-paths source-state)))
  (check "explicit provider bind preserves snapshot values"
         (equal? (state-values reconstructed) (state-values source-state)))
  (expect-error "conflicting admitted provider bind" 'unsupported
                (lambda ()
                  (state-dict-bind-provider-internal! reconstructed
                                                      'alternate-v1)))
  (expect-error "unknown unverified provider bind" 'unsupported
                (lambda ()
                  (state-dict-bind-provider-internal! reconstructed
                                                      'unverified-v1)))
  (check "failed rebind preserves original binding"
         (equal? (state-dict-paths reconstructed)
                 (state-dict-paths source-state)))
  (check "reconstructed owned clone state releases"
         (state-dict-release! reconstructed)))

(let* ((baseline (fixture-owned-live-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "value"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'independent)))
  (let* ((owner (module-state-dict module))
         (owner-entry (car (state-dict-entries-internal owner)))
         (copy
           (state-dict-create-unsafe-internal
             (state-dict-format-internal owner) 1 0 '()
             (state-dict-adapter-internal owner)
             (state-dict-entries-internal owner) '()))
         (pre-bind-copy-entry
           (car (state-dict-entries-internal copy))))
    (check "unsafe first bind clones borrowed entries"
           (eq? copy
                (state-dict-bind-provider-internal! copy 'fixture-v1)))
    (expect-error "unsafe bind tombstones pre-bind target entry shell"
                  'invalid-state
                  (lambda ()
                    (state-entry-path-internal pre-bind-copy-entry)))
    (check "unsafe bind preserves source-state entry identity"
           (equal? (state-entry-path-internal owner-entry) '("value")))
    (check "unsafe clone owner source releases"
           (state-dict-release! owner))
    (check "unsafe bound clone remains readable after source release"
           (equal? (state-values copy)
                   (list (list '("value") (vector 'independent)))))
    (expect-error "source entry shell is stale after owner release"
                  'invalid-state
                  (lambda () (state-entry-path-internal owner-entry)))
    (check "unsafe bound clone releases" (state-dict-release! copy))
    (check "unsafe independent bind returns owned count to baseline"
           (= baseline (fixture-owned-live-count-internal)))))

(let* ((baseline (fixture-owned-live-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "value"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'released-before-bind)))
  (let* ((owner (module-state-dict module))
         (owner-entry (car (state-dict-entries-internal owner)))
         (copy
           (state-dict-create-unsafe-internal
             (state-dict-format-internal owner) 1 0 '()
             (state-dict-adapter-internal owner)
             (state-dict-entries-internal owner) '())))
    (check "unsafe provenance owner releases before bind"
           (state-dict-release! owner))
    (let ((describe-before (fixture-describe-call-count-internal)))
      (expect-error "unsafe bind rejects released provenance before callback"
                    'invalid-state
                    (lambda ()
                      (state-dict-bind-provider-internal! copy 'fixture-v1)))
      (check "released provenance rejection invokes no tensor callback"
             (= describe-before (fixture-describe-call-count-internal))))
    (expect-error "released provenance entry shell is invalid-state"
                  'invalid-state
                  (lambda () (state-entry-path-internal owner-entry)))
    (check "unbound released-provenance state releases"
           (state-dict-release! copy))
    (check "released-before-bind path returns owned count to baseline"
           (= baseline (fixture-owned-live-count-internal)))))

(let* ((direct-entry
         (state-entry-internal
           '("direct") 'buffer '(1) 'i64 'cpu
           'dense-row-major-contiguous
           (fixture-tensor-internal '(1) 'i64 'cpu (vector 'direct))))
       (direct-state
         (state-dict-create-unsafe-internal
           'transformer-state-dict 1 0 '() valid-provider-identity
           (list direct-entry) '()))
       (describe-before (fixture-describe-call-count-internal)))
  (expect-error "unproven nonempty unsafe state rejects bind" 'unsupported
                (lambda ()
                  (state-dict-bind-provider-internal!
                    direct-state 'fixture-v1)))
  (check "unproven unsafe rejection invokes no tensor callback"
         (= describe-before (fixture-describe-call-count-internal)))
  (check "unproven unsafe state releases"
         (state-dict-release! direct-state)))

(let* ((baseline (fixture-owned-live-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "a"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'first)))
  (module-register-buffer-internal!
    module "b"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'second)))
  (let* ((owner (module-state-dict module))
         (copy
           (state-dict-create-unsafe-internal
             (state-dict-format-internal owner) 1 0 '()
             (state-dict-adapter-internal owner)
             (state-dict-entries-internal owner) '()))
         (before-bind (fixture-owned-live-count-internal)))
    (fixture-arm-clone-defect-internal! 1 'publish-then-raise)
    (expect-error "unsafe bind partial clone publication defect" 'internal
                  (lambda ()
                    (state-dict-bind-provider-internal! copy 'fixture-v1)))
    (check "unsafe bind partial clone cleanup returns to prefix baseline"
           (= before-bind (fixture-owned-live-count-internal)))
    (expect-error "failed unsafe bind remains unbound" 'unsupported
                  (lambda () (state-dict-paths copy)))
    (check "unsafe bind retries after clone rollback"
           (eq? copy
                (state-dict-bind-provider-internal! copy 'fixture-v1)))
    (check "partial-bind source owner releases"
           (state-dict-release! owner))
    (check "retried unsafe bind remains readable"
           (equal? (state-dict-paths copy) '(("a") ("b"))))
    (check "retried unsafe clone state releases"
           (state-dict-release! copy))
    (check "unsafe partial failure and retry return to baseline"
           (= baseline (fixture-owned-live-count-internal)))))

(let* ((baseline (fixture-owned-live-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "a" (fixture-tensor-internal '(1) 'i64 'cpu (vector 'false-a)))
  (module-register-buffer-internal!
    module "b" (fixture-tensor-internal '(1) 'i64 'cpu (vector 'false-b)))
  (let* ((owner (module-state-dict module))
         (copy
           (state-dict-create-unsafe-internal
             (state-dict-format-internal owner) 1 0 '()
             (state-dict-adapter-internal owner)
             (state-dict-entries-internal owner) '()))
         (before-bind (fixture-owned-live-count-internal)))
    (fixture-arm-clone-defect-internal! 1 'publish-then-raise-false)
    (expect-raised-false "unsafe bind preserves clone callback raised false"
                         (lambda ()
                           (state-dict-bind-provider-internal!
                             copy 'fixture-v1)))
    (check "raised-false clone rollback drains published prefix"
           (= before-bind (fixture-owned-live-count-internal)))
    (expect-error "raised-false clone rollback ends target access"
                  'unsupported
                  (lambda () (state-dict-paths copy)))
    (check "raised-false unbound target releases"
           (state-dict-release! copy))
    (check "raised-false clone source releases"
           (state-dict-release! owner))
    (check "raised-false clone rollback returns to baseline"
           (= baseline (fixture-owned-live-count-internal)))))
(check "state version internal 1.0"
       (equal? (state-dict-version-internal source-state) '(1 0)))
(check "state entries globally lexical"
       (equal? (state-dict-paths source-state)
               '(("aa") ("block" "alpha") ("block" "beta")
                 ("block" "stats") ("z") ("zz"))))
(check "state aliases canonical"
       (equal? (state-dict-alias-groups source-state)
               '((("block" "alpha") ("z")))))
(check "state order ignores registration order"
       (equal? (state-dict-paths source-state)
               (module-state-paths permuted)))
(check "tied snapshots value equal"
       (equal? (state-payload source-state '("block" "alpha"))
               (state-payload source-state '("z"))))
(check "tied snapshots are independent"
       (not (eq? (state-dict-tensor source-state '("block" "alpha"))
                 (state-dict-tensor source-state '("z")))))
(let ((first (state-dict-tensor source-state '("z")))
      (second (state-dict-tensor source-state '("z"))))
  (check "state tensor handle is cached" (eq? first second))
  (check "borrow preserves snapshot value"
         (equal? (state-payload source-state '("z"))
                 (vector 'source-parameter 'bits-v1))))

(let* ((before (fixture-owned-live-count-internal))
       (state (module-state-dict source))
       (handle (state-dict-tensor state '("z"))))
  (fixture-arm-reentrant-borrow-end-internal! state handle)
  (expect-error "opening borrow rejects reentrant end and release"
                'invalid-state
                (lambda ()
                  (state-dict-tensor-borrow-begin-internal state handle)))
  (check "failed opening borrow leaves state live"
         (equal? (state-dict-paths state)
                 '(("aa") ("block" "alpha") ("block" "beta")
                   ("block" "stats") ("z") ("zz"))))
  (state-dict-release! state)
  (check "failed opening borrow releases to allocation baseline"
         (= before (fixture-owned-live-count-internal))))

(let ((baseline (fixture-owned-live-count-internal)))
  (check "repeated state access and release cycles return to baseline"
         (let loop ((remaining 12))
           (if (= remaining 0)
               #t
               (let* ((state (module-state-dict source))
                      (first (state-dict-tensor state '("z")))
                      (second (state-dict-tensor state '("z")))
                      (carrier
                        (state-dict-tensor-borrow-begin-internal state first))
                      (payload-ok
                        (equal? (fixture-tensor-payload-internal carrier)
                                (vector 'source-parameter 'bits-v1)))
                      (ended
                        (state-dict-tensor-borrow-end-internal state first))
                      (released (state-dict-release! state))
                      (repeated (state-dict-release! state)))
                 (and (eq? first second) payload-ok ended released repeated
                      (= baseline (fixture-owned-live-count-internal))
                      (loop (- remaining 1))))))))

(define (decoded-owned-record path carrier)
  (vector path 'buffer '(1) 'i64 'cpu
          'dense-row-major-contiguous carrier))

(define (expect-adoption-metadata-mismatch
          label category shape dtype device layout)
  (let* ((before (fixture-owned-live-count-internal))
         (releases-before (fixture-release-call-count-internal))
         (carrier
           (fixture-owned-tensor-internal '(1) 'i64 'cpu (vector 9)))
         (envelope
           (vector carrier 'buffer 'state-dict-adopt-owned-internal! #f))
         (ownership (vector (list envelope))))
    (expect-error label category
                  (lambda ()
                    (state-dict-adopt-owned-internal!
                      (list (vector '("mismatch") 'buffer shape dtype device
                                    layout carrier))
                      '() 'fixture-v1 2 0 ownership)))
    (check (string-append label " clears transferred envelope")
           (not (vector-ref envelope 0)))
    (check (string-append label " releases exactly once")
           (= (+ releases-before 1)
              (fixture-release-call-count-internal)))
    (check (string-append label " restores owned baseline")
           (= before (fixture-owned-live-count-internal)))))

(expect-adoption-metadata-mismatch
  "adoption rejects record/carrier shape mismatch" 'shape-mismatch
  '(2) 'i64 'cpu 'dense-row-major-contiguous)
(expect-adoption-metadata-mismatch
  "adoption rejects record/carrier dtype mismatch" 'dtype-mismatch
  '(1) 'f32 'cpu 'dense-row-major-contiguous)
(expect-adoption-metadata-mismatch
  "adoption rejects record/carrier device mismatch" 'device-mismatch
  '(1) 'i64 'accelerator 'dense-row-major-contiguous)
(expect-adoption-metadata-mismatch
  "adoption rejects record/carrier layout mismatch" 'noncontiguous
  '(1) 'i64 'cpu 'column-major)

(let* ((before (fixture-owned-live-count-internal))
       (carrier
         (fixture-owned-tensor-internal '(1) 'i64 'cpu (vector 1)))
       (envelope
         (vector carrier 'buffer 'state-dict-adopt-owned-internal! #f))
       (items (list envelope envelope))
       (ownership (vector items)))
  (expect-error "adoption rejects repeated exact envelope" 'invalid-argument
                (lambda ()
                  (state-dict-adopt-owned-internal!
                    (list (decoded-owned-record '("a") carrier)
                          (decoded-owned-record '("b") carrier))
                    '() 'fixture-v1 2 0 ownership)))
  (check "repeated-envelope rejection does not consume caller ledger"
         (eq? items (vector-ref ownership 0)))
  (vector-set! ownership 0 '())
  (tensor-provider-release-owned-internal! 'fixture-v1 2 0 envelope)
  (check "repeated-envelope rejection cleans unique owner once"
         (= before (fixture-owned-live-count-internal))))

(let* ((before (fixture-owned-live-count-internal))
       (carrier
         (fixture-owned-tensor-internal '(1) 'i64 'cpu (vector 2)))
       (first (vector carrier 'buffer 'state-dict-adopt-owned-internal! #f))
       (second (vector carrier 'buffer 'state-dict-adopt-owned-internal! #f))
       (items (list first second))
       (ownership (vector items)))
  (expect-error "adoption rejects distinct envelopes for one carrier"
                'invalid-argument
                (lambda ()
                  (state-dict-adopt-owned-internal!
                    (list (decoded-owned-record '("a") carrier)
                          (decoded-owned-record '("b") carrier))
                    '() 'fixture-v1 2 0 ownership)))
  (check "duplicate-carrier rejection does not consume caller ledger"
         (eq? items (vector-ref ownership 0)))
  (vector-set! ownership 0 '())
  ;; The ledger is newest-first, so the older tail envelope retains the sole
  ;; owner and the later duplicate head is neutralized.
  (tensor-provider-release-owned-internal! 'fixture-v1 2 0 second)
  (check "duplicate-carrier rejection cleans physical owner once"
         (= before (fixture-owned-live-count-internal))))

(let* ((before (fixture-owned-live-count-internal))
       (carrier
         (fixture-owned-tensor-internal '(1) 'i64 'cpu (vector 3)))
       (first (vector carrier 'buffer 'state-dict-adopt-owned-internal! #f))
       (copied
         (vector (vector-ref first 0) (vector-ref first 1)
                 (vector-ref first 2) (vector-ref first 3)))
       (items (list first copied))
       (ownership (vector items)))
  (expect-error "adoption rejects copied envelope with repeated carrier"
                'invalid-argument
                (lambda ()
                  (state-dict-adopt-owned-internal!
                    (list (decoded-owned-record '("a") carrier)
                          (decoded-owned-record '("b") carrier))
                    '() 'fixture-v1 2 0 ownership)))
  (check "copied-envelope rejection does not consume caller ledger"
         (eq? items (vector-ref ownership 0)))
  (vector-set! ownership 0 '())
  (tensor-provider-release-owned-internal! 'fixture-v1 2 0 copied)
  (check "copied-envelope rejection cleans physical owner once"
         (= before (fixture-owned-live-count-internal))))

(let* ((owned-before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (native-before (p1-module-test-live-count))
       (storage-before (fixture-storage-identical-call-count-internal))
       (owner
         (fixture-owned-tensor-internal
           '(1) 'i64 'cpu (vector 'adoption-physical-owner)))
       (alias (fixture-storage-alias-wrapper-internal owner))
       (owner-envelope
         (vector owner 'buffer 'state-dict-adopt-owned-internal! #f))
       (alias-envelope
         (vector alias 'buffer 'state-dict-adopt-owned-internal! #f))
       ;; Ownership ledgers are newest-first: the malicious alias was
       ;; published later and must be sacrificed in favor of the older owner.
       (items (list alias-envelope owner-envelope))
       (ownership (vector items)))
  (expect-error
    "adoption rejects later wrapper over prior owner storage"
    'invalid-argument
    (lambda ()
      (state-dict-adopt-owned-internal!
        (list (decoded-owned-record '("alias") alias)
              (decoded-owned-record '("owner") owner))
        '() 'fixture-v1 2 0 ownership)))
  (check "physical-alias rejection leaves caller ledger unconsumed"
         (eq? items (vector-ref ownership 0)))
  (check "physical-alias rejection preserves only prior genuine owner"
         (and (eq? (vector-ref owner-envelope 0) owner)
              (not (vector-ref alias-envelope 0))))
  (check "physical-alias rejection executes authoritative comparison"
         (> (fixture-storage-identical-call-count-internal) storage-before))
  ;; C1-style caller rollback drains only the still-actionable prior owner.
  (vector-set! ownership 0 '())
  (check "caller cleanup releases prior genuine owner exactly once"
         (tensor-provider-release-owned-internal!
           'fixture-v1 2 0 owner-envelope))
  (check "caller cleanup never invokes poisonous alias release"
         (= (fixture-release-call-count-internal) (+ release-before 1)))
  (check "poisonous alias cannot corrupt released owner payload"
         (equal? (fixture-tensor-payload-internal alias)
                 (vector 'adoption-physical-owner)))
  (check "physical-alias caller cleanup restores owner/native baselines"
         (and (= owned-before (fixture-owned-live-count-internal))
              (= native-before (p1-module-test-live-count)))))

(let* ((before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (first-module (module-create-fixture-internal))
       (second-module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    first-module "a"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'first-live)))
  (module-register-buffer-internal!
    second-module "b"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'second-live)))
  (let* ((first-state (module-state-dict first-module))
         (second-state (module-state-dict second-module))
         (first-handle (state-dict-tensor first-state '("a")))
         (second-handle (state-dict-tensor second-state '("b")))
         (first-carrier
           (state-dict-tensor-borrow-begin-internal
             first-state first-handle)))
    (state-dict-tensor-borrow-end-internal first-state first-handle)
    (let ((second-carrier
            (state-dict-tensor-borrow-begin-internal
              second-state second-handle)))
      (state-dict-tensor-borrow-end-internal second-state second-handle)
      (let* ((first-envelope
               (vector first-carrier 'buffer
                       'state-dict-adopt-owned-internal! #f))
             (duplicate-envelope
               (vector first-carrier 'buffer
                       'state-dict-adopt-owned-internal! #f))
             (second-envelope
               (vector second-carrier 'buffer
                       'state-dict-adopt-owned-internal! #f))
             (malformed (vector 'malformed))
             (items
               (list first-envelope malformed duplicate-envelope
                     second-envelope))
             (ownership (vector items)))
        (expect-error
          "adoption sanitizes all live-state carriers before validation"
          'invalid-argument
          (lambda ()
            (state-dict-adopt-owned-internal!
              (list (decoded-owned-record '("a") first-carrier))
              '() 'missing-provider 99 99 ownership)))
        (check "adoption neutralizes duplicate first-state envelopes"
               (and (not (vector-ref first-envelope 0))
                    (not (vector-ref duplicate-envelope 0))))
        (check "adoption neutralizes every live-state envelope"
               (not (vector-ref second-envelope 0)))
        (check "adoption sanitizer leaves caller ledger unconsumed"
               (eq? items (vector-ref ownership 0)))
        (check "adoption sanitizer invokes no release callback"
               (= release-before (fixture-release-call-count-internal)))
        (let ((carrier
                (state-dict-tensor-borrow-begin-internal
                  first-state first-handle)))
          (check "adoption sanitizer preserves first live state"
                 (equal? (fixture-tensor-payload-internal carrier)
                         (vector 'first-live)))
          (state-dict-tensor-borrow-end-internal first-state first-handle))
        (let ((carrier
                (state-dict-tensor-borrow-begin-internal
                  second-state second-handle)))
          (check "adoption sanitizer preserves second live state"
                 (equal? (fixture-tensor-payload-internal carrier)
                         (vector 'second-live)))
          (state-dict-tensor-borrow-end-internal second-state second-handle))
        (check "first sanitized live state releases once"
               (state-dict-release! first-state))
        (check "second sanitized live state releases once"
               (state-dict-release! second-state))
        (check "sanitized adoption states return to baseline"
               (= before (fixture-owned-live-count-internal)))))))

(let* ((before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "state"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'release-seam-live)))
  (let* ((state (module-state-dict module))
         (handle (state-dict-tensor state '("state")))
         (carrier
           (state-dict-tensor-borrow-begin-internal state handle)))
    (state-dict-tensor-borrow-end-internal state handle)
    (let ((envelope
            (vector carrier 'wrong-kind 'release-confusion #f)))
      (expect-error
        "private release seam rejects wrong-kind envelope structurally"
        'invalid-argument
        (lambda ()
          (tensor-provider-release-owned-internal!
            'missing-provider 99 99 envelope)))
      (check "wrong-kind private release rejects before mutation"
             (eq? (vector-ref envelope 0) carrier))
      (check "private release seam invokes no provider callback"
             (= release-before (fixture-release-call-count-internal))))
    (let ((preserved
            (state-dict-tensor-borrow-begin-internal state handle)))
      (check "private release seam preserves live state storage"
             (equal? (fixture-tensor-payload-internal preserved)
                     (vector 'release-seam-live)))
      (state-dict-tensor-borrow-end-internal state handle))
    (check "private release seam protected state releases once"
           (state-dict-release! state))
    (check "private release seam protected state returns to baseline"
           (= before (fixture-owned-live-count-internal)))))

(let* ((release-before (fixture-release-call-count-internal))
       (module (module-create-fixture-internal))
       (carrier
         (fixture-tensor-internal '(1) 'i64 'cpu (vector 'module-release-live))))
  (module-register-buffer-internal! module "state" carrier)
  (let ((envelope (vector carrier 'buffer 'release-confusion #f)))
    (check "private release seam rejects live module carrier with false"
           (not (tensor-provider-release-owned-internal!
                  'missing-provider 99 99 envelope)))
    (check "private release seam neutralizes live module envelope"
           (not (vector-ref envelope 0)))
    (check "private release seam does not callback for module carrier"
           (= release-before (fixture-release-call-count-internal)))
    (check "private release seam preserves module carrier"
           (equal? (fixture-tensor-payload-internal carrier)
                   (vector 'module-release-live)))))

(let* ((owned-before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (native-before #f)
       (protected-module (module-create-fixture-internal))
       (protected
         (fixture-tensor-internal
           '(1) 'i64 'cpu (vector 'comparator-protected)))
       (ambiguous
         (fixture-owned-tensor-internal
           '(1) 'i64 'cpu (vector 'ambiguous-owner)))
       (sibling
         (fixture-owned-tensor-internal
           '(1) 'i64 'cpu (vector 'genuine-sibling)))
       (ambiguous-envelope
         (vector ambiguous 'buffer 'comparator-defect-release #f))
       (sibling-envelope
         (vector sibling 'buffer 'comparator-defect-release #f)))
  (module-register-buffer-internal!
    protected-module "protected" protected)
  (set! native-before (p1-module-test-live-count))
  (fixture-arm-storage-comparison-defect-internal! 'raise)
  (expect-error "release comparator defect fails closed" 'internal
                (lambda ()
                  (tensor-provider-release-owned-internal!
                    'fixture-v1 2 0 ambiguous-envelope)))
  (check "release comparator defect disarms ambiguous envelope"
         (not (vector-ref ambiguous-envelope 0)))
  (check "release comparator defect invokes no destructive callback"
         (= release-before (fixture-release-call-count-internal)))
  (check "release comparator defect makes no ambiguous cleanup claim"
         (= (fixture-owned-live-count-internal) (+ owned-before 2)))
  (check "later genuine sibling still releases exactly once"
         (tensor-provider-release-owned-internal!
           'fixture-v1 2 0 sibling-envelope))
  (check "sibling cleanup leaves only the explicitly ambiguous owner"
         (and (= (fixture-release-call-count-internal) (+ release-before 1))
              (= (fixture-owned-live-count-internal) (+ owned-before 1))))
  ;; The test retains the carrier identity outside the disarmed envelope. Once
  ;; the injected comparator defect is consumed, a new owner-ledger envelope
  ;; can explicitly resolve this fixture owner; production may not infer that.
  (check "test owner explicitly resolves the retained ambiguous carrier"
         (tensor-provider-release-owned-internal!
           'fixture-v1 2 0
           (vector ambiguous 'buffer 'comparator-defect-test-resolution #f)))
  (check "resolved comparator defect restores all live baselines"
         (and (= release-before (- (fixture-release-call-count-internal) 2))
              (= owned-before (fixture-owned-live-count-internal))
              (= native-before (p1-module-test-live-count))
              (equal? (fixture-tensor-payload-internal protected)
                      (vector 'comparator-protected)))))

(let* ((owned-before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (native-before #f)
       (protected-module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    protected-module "protected"
    (fixture-tensor-internal
      '(1) 'i64 'cpu (vector 'reentrant-comparator-protected)))
  (set! native-before (p1-module-test-live-count))
  (let* ((protected-state (module-state-dict protected-module))
         (candidate
           (fixture-owned-tensor-internal
             '(1) 'i64 'cpu (vector 'reentrant-comparator-candidate)))
         (candidate-envelope
           (vector candidate 'buffer 'reentrant-comparator-release #f))
         (native-live (p1-module-test-live-count)))
    (fixture-arm-storage-comparison-reentrant-state-release-internal!
      protected-state)
    (expect-error
      "storage comparator cannot reentrantly release protected state"
      'invalid-state
      (lambda ()
        (tensor-provider-release-owned-internal!
          'fixture-v1 2 0 candidate-envelope)))
    (check "reentrant comparator failure disarms ambiguous candidate"
           (not (vector-ref candidate-envelope 0)))
    (check "reentrant comparator fails before native/provider mutation"
           (and (= release-before (fixture-release-call-count-internal))
                (= (fixture-owned-live-count-internal) (+ owned-before 2))
                (= native-live (p1-module-test-live-count))))
    (check "reentrant comparator preserves protected state owner and payload"
           (and (equal? (state-dict-paths protected-state) '(("protected")))
                (equal? (state-payload protected-state '("protected"))
                        (vector 'reentrant-comparator-protected))))
    (check "reentrant comparator preserves retained candidate payload"
           (equal? (fixture-tensor-payload-internal candidate)
                   (vector 'reentrant-comparator-candidate)))
    (check "retained candidate later releases exactly once"
           (tensor-provider-release-owned-internal!
             'fixture-v1 2 0
             (vector candidate 'buffer
                     'reentrant-comparator-test-resolution #f)))
    (check "protected state later releases exactly once"
           (state-dict-release! protected-state))
    (check "reentrant comparator cleanup restores exact live baselines"
           (and (= (fixture-release-call-count-internal) (+ release-before 2))
                (= owned-before (fixture-owned-live-count-internal))
                (= native-before (p1-module-test-live-count))))))

(define (check-reentrant-comparator-registration mode)
  (let* ((kind-label (if (eq? mode 'parameter) "parameter" "buffer"))
         (owned-before (fixture-owned-live-count-internal))
         (release-before (fixture-release-call-count-internal))
         (protected-module (module-create-fixture-internal))
         (target-module (module-create-fixture-internal)))
    (module-register-buffer-internal!
      protected-module "protected"
      (fixture-tensor-internal
        '(1) 'i64 'cpu (vector 'reentrant-registration-protected)))
    (let* ((protected-state (module-state-dict protected-module))
           (candidate
             (fixture-owned-tensor-internal
               '(1) 'f32 'cpu (vector 'reentrant-registration-candidate)))
           (candidate-envelope
             (vector candidate 'buffer 'reentrant-comparator-registration #f))
           (native-live (p1-module-test-live-count)))
      (fixture-arm-storage-comparison-reentrant-registration-internal!
        mode target-module candidate)
      (expect-error
        (string-append "storage comparator cannot reentrantly register "
                       kind-label)
        'invalid-state
        (lambda ()
          (tensor-provider-release-owned-internal!
            'fixture-v1 2 0 candidate-envelope)))
      (check
        (string-append "reentrant " kind-label
                       " registration disarms ambiguous candidate")
        (not (vector-ref candidate-envelope 0)))
      (check
        (string-append "reentrant " kind-label
                       " registration fails before provider/native mutation")
        (and (= release-before (fixture-release-call-count-internal))
             (= (fixture-owned-live-count-internal) (+ owned-before 2))
             (= native-live (p1-module-test-live-count))))
      (check
        (string-append "reentrant " kind-label
                       " registration preserves protected owner and payload")
        (and (equal? (state-dict-paths protected-state) '(("protected")))
             (equal? (state-payload protected-state '("protected"))
                     (vector 'reentrant-registration-protected))))
      (check
        (string-append "reentrant " kind-label
                       " registration preserves retained candidate payload")
        (equal? (fixture-tensor-payload-internal candidate)
                (vector 'reentrant-registration-candidate)))
      ;; The same name must still be available.  Success is executable proof
      ;; that the malicious callback did not mutate the target module ledger.
      (let ((benign
              (fixture-tensor-internal
                '(1) 'f32 'cpu (vector 'post-rejection-registration))))
        (check
          (string-append "reentrant " kind-label
                         " registration leaves target module unchanged")
          (if (eq? mode 'parameter)
              (module-register-parameter-internal!
                target-module "comparator-attack" benign)
              (module-register-buffer-internal!
                target-module "comparator-attack" benign))))
      (check
        (string-append "retained " kind-label
                       " attack candidate later releases exactly once")
        (tensor-provider-release-owned-internal!
          'fixture-v1 2 0
          (vector candidate 'buffer
                  'reentrant-registration-test-resolution #f)))
      (check
        (string-append "protected state after " kind-label
                       " attack later releases exactly once")
        (state-dict-release! protected-state))
      (check
        (string-append "reentrant " kind-label
                       " registration cleanup restores owned baselines")
        (and (= (fixture-release-call-count-internal) (+ release-before 2))
             (= owned-before (fixture-owned-live-count-internal)))))))

(check-reentrant-comparator-registration 'parameter)
(check-reentrant-comparator-registration 'buffer)

(let* ((owned-before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (native-before #f)
       (protected-module (module-create-fixture-internal))
       (snapshot-module (module-create-fixture-internal))
       (source
         (fixture-tensor-internal
           '(1) 'f32 'cpu (vector 'ordinary-release-source))))
  (module-register-buffer-internal!
    protected-module "protected"
    (fixture-tensor-internal
      '(1) 'i64 'cpu (vector 'ordinary-release-protected)))
  (module-register-parameter-internal! snapshot-module "source" source)
  (set! native-before (p1-module-test-live-count))
  (let* ((protected-state (module-state-dict protected-module))
         (native-live (p1-module-test-live-count)))
    (fixture-arm-ordinary-comparison-reentrant-state-release-internal!
      source protected-state)
    (expect-error
      "ordinary clone comparator cannot reentrantly release state"
      'invalid-state
      (lambda () (module-state-dict snapshot-module)))
    (check "ordinary release attack cleans published clone exactly once"
           (and (= (fixture-release-call-count-internal) (+ release-before 1))
                (= (fixture-owned-live-count-internal) (+ owned-before 1))
                (= native-live (p1-module-test-live-count))))
    (check "ordinary release attack preserves borrowed source payload"
           (equal? (fixture-tensor-payload-internal source)
                   (vector 'ordinary-release-source)))
    (check "ordinary release attack leaves protected state live and unchanged"
           (and (equal? (state-dict-paths protected-state) '(("protected")))
                (equal? (state-payload protected-state '("protected"))
                        (vector 'ordinary-release-protected))))
    (check "ordinary release attack protected state later releases once"
           (state-dict-release! protected-state))
    (check "ordinary release attack restores exact live baselines"
           (and (= (fixture-release-call-count-internal) (+ release-before 2))
                (= owned-before (fixture-owned-live-count-internal))
                (= native-before (p1-module-test-live-count))))))

(define (check-ordinary-comparator-registration mode)
  (let* ((kind-label (if (eq? mode 'parameter) "parameter" "buffer"))
         (owned-before (fixture-owned-live-count-internal))
         (release-before (fixture-release-call-count-internal))
         (protected-module (module-create-fixture-internal))
         (snapshot-module (module-create-fixture-internal))
         (target-module (module-create-fixture-internal))
         (source
           (fixture-tensor-internal
             '(1) 'f32 'cpu (vector 'ordinary-registration-source))))
    (module-register-buffer-internal!
      protected-module "protected"
      (fixture-tensor-internal
        '(1) 'i64 'cpu (vector 'ordinary-registration-protected)))
    (module-register-parameter-internal! snapshot-module "source" source)
    (let* ((protected-state (module-state-dict protected-module))
           (native-live (p1-module-test-live-count)))
      (fixture-arm-ordinary-comparison-reentrant-registration-internal!
        source mode target-module)
      (expect-error
        (string-append "ordinary clone comparator cannot reentrantly register "
                       kind-label)
        'invalid-state
        (lambda () (module-state-dict snapshot-module)))
      (check
        (string-append "ordinary " kind-label
                       " attack cleans published clone exactly once")
        (and (= (fixture-release-call-count-internal) (+ release-before 1))
             (= (fixture-owned-live-count-internal) (+ owned-before 1))
             (= native-live (p1-module-test-live-count))))
      (check
        (string-append "ordinary " kind-label
                       " attack preserves borrowed source payload")
        (equal? (fixture-tensor-payload-internal source)
                (vector 'ordinary-registration-source)))
      (check
        (string-append "ordinary " kind-label
                       " attack preserves protected state payload")
        (and (equal? (state-dict-paths protected-state) '(("protected")))
             (equal? (state-payload protected-state '("protected"))
                     (vector 'ordinary-registration-protected))))
      ;; If the callback had retained the published clone, this exact name
      ;; would already be occupied and the ordinary registration would fail.
      (let ((benign
              (fixture-tensor-internal
                '(1) 'f32 'cpu (vector 'ordinary-post-rejection))))
        (check
          (string-append "ordinary " kind-label
                         " attack leaves target module unchanged")
          (if (eq? mode 'parameter)
              (module-register-parameter-internal!
                target-module "ordinary-comparator-attack" benign)
              (module-register-buffer-internal!
                target-module "ordinary-comparator-attack" benign))))
      (check
        (string-append "ordinary " kind-label
                       " attack protected state later releases once")
        (state-dict-release! protected-state))
      (check
        (string-append "ordinary " kind-label
                       " attack cleanup restores owned baselines")
        (and (= (fixture-release-call-count-internal) (+ release-before 2))
             (= owned-before (fixture-owned-live-count-internal)))))))

(check-ordinary-comparator-registration 'parameter)
(check-ordinary-comparator-registration 'buffer)

(let* ((released-state (module-state-dict source))
       (detached-paths (state-dict-paths released-state))
       (detached-aliases (state-dict-alias-groups released-state))
       (borrowed (state-dict-tensor released-state '("z")))
       (other-handle (state-dict-tensor released-state '("aa")))
       (stale-entry (car (state-dict-entries-internal released-state))))
  (let ((carrier
          (state-dict-tensor-borrow-begin-internal
            released-state borrowed)))
    (expect-error "different handle cannot end active scoped borrow"
                  'invalid-argument
                  (lambda ()
                    (state-dict-tensor-borrow-end-internal
                      released-state other-handle)))
    (expect-error "release rejects an active scoped borrow" 'invalid-state
                  (lambda () (state-dict-release! released-state)))
    (check "rejected release leaves borrowed carrier live"
           (equal? (fixture-tensor-payload-internal carrier)
                   (vector 'source-parameter 'bits-v1)))
    (check "scoped borrow end succeeds"
           (state-dict-tensor-borrow-end-internal
             released-state borrowed)))
  (check "state release succeeds" (state-dict-release! released-state))
  (check "state release is idempotent" (state-dict-release! released-state))
  (check "detached paths outlive state release"
         (equal? detached-paths
                 '(("aa") ("block" "alpha") ("block" "beta")
                   ("block" "stats") ("z") ("zz"))))
  (check "detached aliases outlive state release"
         (equal? detached-aliases '((("block" "alpha") ("z")))))
  (expect-error "released state paths reject use" 'invalid-state
                (lambda () (state-dict-paths released-state)))
  (expect-error "released state aliases reject use" 'invalid-state
                (lambda () (state-dict-alias-groups released-state)))
  (expect-error "released state tensor lookup rejects use" 'invalid-state
                (lambda () (state-dict-tensor released-state '("z"))))
  (expect-error "released state strict load rejects use" 'invalid-state
                (lambda ()
                  (module-load-state-dict! source released-state)))
  (expect-error "released borrowed handle rejects use" 'invalid-state
                (lambda ()
                  (state-dict-tensor-borrow-begin-internal
                    released-state borrowed)))
  (expect-error "released entry shell rejects use" 'invalid-state
                (lambda () (state-entry-path-internal stale-entry))))

(let* ((before (fixture-owned-live-count-internal))
       (state (module-state-dict source))
       (stale (state-dict-tensor state '("z")))
       (stale-entry (car (state-dict-entries-internal state))))
  (fixture-malform-next-release-internal!)
  (expect-error "malformed post-release acknowledgement is reported" 'internal
                (lambda () (state-dict-release! state)))
  (check "malformed acknowledgement cleanup returns to baseline"
         (= before (fixture-owned-live-count-internal)))
  (check "malformed acknowledgement state release is not retried"
         (state-dict-release! state))
  (expect-error "malformed acknowledgement leaves stale handle invalid"
                'invalid-state
                (lambda ()
                  (state-dict-tensor-borrow-begin-internal state stale)))
  (expect-error "malformed acknowledgement compacts stale entry shell"
                'invalid-state
                (lambda () (state-entry-path-internal stale-entry))))

(let* ((before (fixture-owned-live-count-internal))
       (module (module-create-fixture-internal)))
  (module-register-buffer-internal!
    module "a"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'release-false-a)))
  (module-register-buffer-internal!
    module "b"
    (fixture-tensor-internal '(1) 'i64 'cpu (vector 'release-false-b)))
  (let* ((state (module-state-dict module))
         (release-before (fixture-release-call-count-internal)))
    (fixture-raise-false-next-release-internal!)
    (expect-raised-false "state release preserves callback raised false"
                         (lambda () (state-dict-release! state)))
    (check "raised-false release drains owned siblings"
           (= (+ release-before 2)
              (fixture-release-call-count-internal)))
    (check "raised-false release returns owned count to baseline"
           (= before (fixture-owned-live-count-internal)))
    (check "raised-false state release is idempotent"
           (state-dict-release! state))
    (check "raised-false repeated release invokes no callbacks"
           (= (+ release-before 2)
              (fixture-release-call-count-internal)))
    (expect-error "raised-false released state remains invalid"
                  'invalid-state
                  (lambda () (state-dict-paths state)))))

(define destination (build-module 'destination-parameter 'destination-buffer))
(define destination-tree (module-parameters destination))
(define destination-handle (parameter-tree-handle destination-tree '("z")))
(define destination-storage
  (parameter-handle-tensor-identity-internal destination-handle))
(let* ((unbound
         (state-dict-create-unsafe-internal
           (state-dict-format-internal source-state) 1 0 '()
           valid-provider-identity (state-dict-entries-internal source-state)
           (state-dict-alias-groups source-state)))
       (before (module-state-values destination)))
  (expect-error "unbound state cannot load" 'unsupported
                (lambda () (module-load-state-dict! destination unbound)))
  (check "unbound load preserves destination"
         (equal? before (module-state-values destination)))
  (state-dict-release! unbound))
(fixture-arm-reentrant-state-release-internal! source-state)
(expect-error "provider callback cannot reentrantly release load state"
              'invalid-state
              (lambda ()
                (module-load-state-dict! destination source-state)))
(check "reentrant release rejection leaves load state live"
       (equal? (state-dict-paths source-state)
               '(("aa") ("block" "alpha") ("block" "beta")
                 ("block" "stats") ("z") ("zz"))))
(check "strict load succeeds" (load-state! destination source-state))
(check "load preserves handle identity"
       (eq? destination-handle
            (parameter-tree-handle (module-parameters destination) '("z"))))
(check "load preserves tensor storage identity"
       (eq? destination-storage
            (parameter-handle-tensor-identity-internal destination-handle)))
(check "load preserves tie identity"
       (eq? (parameter-tree-handle (module-parameters destination) '("z"))
            (parameter-tree-handle (module-parameters destination)
                                   '("block" "alpha"))))
(define destination-state (module-state-dict destination))
(check "round trip paths"
       (equal? (state-dict-paths destination-state)
               (state-dict-paths source-state)))
(check "round trip values"
       (equal? (module-state-values destination)
               (state-values source-state)))
(check "round trip aliases"
       (equal? (module-state-aliases destination)
               (state-dict-alias-groups source-state)))

(define child-for-mode (module-create-internal))
(define mode-root (module-create-internal))
(module-register-child-internal! mode-root "child" child-for-mode)
(module-eval! mode-root)
(check "eval recursive root" (eq? (module-mode-internal mode-root) 'eval))
(check "eval recursive child" (eq? (module-mode-internal child-for-mode) 'eval))
(module-train! mode-root)
(check "train recursive root" (eq? (module-mode-internal mode-root) 'train))
(check "train recursive child" (eq? (module-mode-internal child-for-mode) 'train))

(define empty (module-create-fixture-internal))
(check "empty parameters" (null? (parameter-tree-paths (module-parameters empty))))
(check "empty buffers" (null? (state-dict-paths (module-buffers empty))))
(check "empty state" (null? (module-state-paths empty)))

