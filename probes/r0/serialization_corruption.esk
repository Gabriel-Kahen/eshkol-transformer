(define tensor-path "r0-corrupt-tensor.bin")
(define model-path "r0-corrupt-model.bin")
(if (file-exists? tensor-path) (file-delete tensor-path) #f)
(if (file-exists? model-path) (file-delete model-path) #f)
(define tensor-out (open-binary-output-file tensor-path))
(write-u8 0 tensor-out)
(write-u8 1 tensor-out)
(write-u8 2 tensor-out)
(close-port tensor-out)
(define model-out (open-binary-output-file model-path))
(write-u8 3 model-out)
(write-u8 4 model-out)
(write-u8 5 model-out)
(close-port model-out)
(define tensor-result (tensor-load tensor-path))
(define model-result (model-load model-path))
(if (file-exists? tensor-path) (file-delete tensor-path) #f)
(if (file-exists? model-path) (file-delete model-path) #f)
(display (if (not tensor-result) "PASS corrupt tensor rejected"
                                 "FAIL corrupt tensor rejected"))
(newline)
(display (if (not model-result) "PASS corrupt model rejected"
                                "FAIL corrupt model rejected"))
(newline)
(display "R0_DONE serialization_corruption") (newline)
