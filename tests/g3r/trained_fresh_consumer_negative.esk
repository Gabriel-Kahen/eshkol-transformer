;;; A new process per mutated V1 image. Verify the exact typed consumer error.
(require transformer.error_consumer)
(extern void g3rf-private-test ptr ptr
        :real et_g3r_private_test_fresh_consume_v1)
(define args (command-line))
(define (proper-length values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))
(if (not (= (proper-length args) 8)) (exit 2))
(define (argument at)
  (let loop ((remaining (cdr args)) (index at))
    (if (= index 0) (car remaining)
        (loop (cdr remaining) (- index 1)))))
(define mode (argument 0))
(if (not (or (string=? mode "checksum") (string=? mode "pair")
             (string=? mode "parameter") (string=? mode "logit")
             (string=? mode "p1-kv") (string=? mode "g1-id")
             (string=? mode "g1-kv") (string=? mode "rng")))
    (exit 2))
(define output (vector 'untouched))
(define caught #f)
(guard (raised (#t (set! caught raised)))
  (g3rf-private-test
    (vector (vector (argument 1) (argument 2) (argument 3)
                    (argument 4) (argument 5) (argument 6)))
    output))
(if (not (and caught (eq? (vector-ref output 0) 'untouched)
              (transformer-error? caught)
              (eq? (transformer-error-category caught) 'invalid-state)
              (eq? (transformer-error-operation caught)
                   'g3r-trained-fresh-consume!)))
    (exit 1))
(display "G3-R FRESH TRAINED C2 NEGATIVE PASS: ")
(display mode)
(newline)
