;;; Source-private, feature-local detached C2 SAVE image/SHA receipt.
;;; Compose after c2_checkpoint_save_extension.esk; no public installation.
(extern i64 c2-image-adopt ptr i64 ptr
        :real et_c2_private_save_image_adopt_v1)
(extern i64 c2-image-digest i64 ptr
        :real et_c2_private_save_image_digest_v1)
(extern i64 c2-image-publish i64 ptr i64
        :real et_c2_private_save_image_publish_v1)
(extern i64 c2-image-release i64
        :real et_c2_private_save_image_release_v1)
(extern void c2-image-fail-stop i64 :real _Exit)

(define c2-image-receipts '())
(define c2-image-brand (vector 'transformer.c2-save-image-receipt-v1))
(define c2-image-allocate-internal (lambda (length) (make-bytevector length 0)))
(define c2-image-after-adopt-internal (lambda () #t))

(define (c2-image-fail category message)
  (c2-save-fail category message '() #f))
(define (c2-image-native-fail status)
  (cond ((= status -1) (c2-image-fail 'invalid-argument
                                      "C2 image receipt argument is invalid"))
        ((= status -2) (c2-image-fail 'invalid-state
                                      "C2 image receipt is stale or busy"))
        ((= status -3) (c2-image-fail 'internal
                                      "C2 image receipt native invariant failed"))
        ((= status -4) (c2-image-fail 'unsupported
                                      "C2 image receipt tokens are exhausted"))
        (else (c2-image-fail 'internal
                              "C2 image receipt returned unknown status"))))
(define (c2-image-exact? value length)
  (and (bytevector? value) (= (bytevector-length value) length)))
(define (c2-image-shell)
  (vector c2-image-brand 'live))
(define (c2-image-find shell)
  (let loop ((remaining c2-image-receipts))
    (cond ((null? remaining) #f)
          ((eq? shell (vector-ref (car remaining) 0)) (car remaining))
          (else (loop (cdr remaining))))))
(define (c2-image-unlink! record)
  (let loop ((previous #f) (remaining c2-image-receipts))
    (cond ((null? remaining) #f)
          ((eq? record (car remaining))
           (if previous (set-cdr! previous (cdr remaining))
               (set! c2-image-receipts (cdr remaining)))
           #t)
          (else (loop (car remaining) (cdr remaining))))))
(define (c2-image-token cell)
  (c2-save-u64 cell 0))
(define (c2-image-record shell)
  (let ((record (c2-image-find shell)))
    (if record record
        (if (and (vector? shell) (= (vector-length shell) 2)
                 (eq? (vector-ref shell 0) c2-image-brand)
                 (eq? (vector-ref shell 1) 'dead))
            (c2-image-fail 'invalid-state "C2 image receipt is consumed")
            (c2-image-fail 'invalid-argument "unknown C2 image receipt")))))

(define (c2-save-image-receipt-create-internal state policy)
  (let* ((limits (c2-policy-limits-internal 'checkpoint-save! policy))
         (subpolicy (c2-policy-c1-subpolicy-internal 'checkpoint-save! policy)))
    ;; The measured size is rejected inside C2's measure pass before its
    ;; destination allocation. Wire-mode 1-TiB admission cannot reach adopt.
    (if (not (eq? (vector-ref limits 5) 'operational-target))
        (c2-image-fail 'unsupported
                       "C2 image receipt requires operational policy"))
    (let* ((cell (c2-image-allocate-internal 8))
           (shell (c2-image-shell))
           (record (vector shell 'pending cell))
           (next (cons record c2-image-receipts)))
      (if (not (c2-image-exact? cell 8))
          (c2-image-fail 'internal "C2 token backing extent is invalid"))
      (guard (caught
               (#t
                 (let ((token (c2-image-token cell)))
                   (if (> token 0)
                       (if (not (= (c2-image-release token) 0))
                           (c2-image-fail-stop 134))))
                 (raise caught)))
        (c2-save-with-owner-borrow
          state limits (c2-save-effective-model-policy limits subpolicy)
          c2-save-stage-components-internal
          (lambda (bytes measured-bytes)
            (if (or (not (bytevector? bytes))
                    (not (= (bytevector-length bytes) measured-bytes))
                    (> (bytevector-length bytes) 16777216)
                    (<= (bytevector-length bytes) 0)
                    (eq? bytes cell))
                (c2-image-fail 'internal
                               "C2 image backing extent is invalid"))
            (let ((status
                    (c2-image-adopt bytes (bytevector-length bytes) cell)))
              (if (not (= status 0)) (c2-image-native-fail status))
              (c2-image-after-adopt-internal)
              #t))
          16777216)
        ;; Enrollment has no allocation: the cons cell was reserved above.
        (vector-set! record 1 'ready)
        (set! c2-image-receipts next)
        shell))))

(define (c2-save-image-receipt-digest-copy-internal shell)
  (let* ((record (c2-image-record shell))
         (state (vector-ref record 1))
         (cell (vector-ref record 2))
         (digest (c2-image-allocate-internal 32)))
    (if (or (not (eq? state 'ready))
            (not (c2-image-exact? cell 8)))
        (if (and (eq? state 'published) (c2-image-exact? cell 8)) #t
            (c2-image-fail 'invalid-state "C2 image receipt is not readable")))
    (if (or (not (c2-image-exact? digest 32)) (eq? cell digest))
        (c2-image-fail 'internal "C2 digest backing extent is invalid"))
    (let ((status (c2-image-digest (c2-image-token cell) digest)))
      (if (not (= status 0)) (c2-image-native-fail status)))
    digest))

(define (c2-save-image-receipt-publish-internal! shell path)
  (let* ((record (c2-image-record shell))
         (cell (vector-ref record 2)))
    (if (not (c1-valid-file-path? path))
        (c2-image-fail 'invalid-argument "invalid C2 image path"))
    (if (or (not (eq? (vector-ref record 1) 'ready))
            (not (c2-image-exact? cell 8)))
        (c2-image-fail 'invalid-state "C2 image receipt is not ready"))
    (let ((status (c2-image-publish (c2-image-token cell) path 0)))
      (cond ((= status 0)
             (vector-set! record 1 'published)
             #t)
            ((> status 0)
             (vector-set! record 1 'dead)
             (if (not (c2-image-unlink! record)) (c2-image-fail-stop 134))
             (vector-set! shell 1 'dead)
             (c1-native-fail-raw
               'checkpoint-save! "atomic C2 image publication failed" status))
            (else (c2-image-native-fail status))))))

(define (c2-save-image-receipt-release-internal! shell)
  (let* ((record (c2-image-record shell))
         (cell (vector-ref record 2)))
    (if (not (c2-image-exact? cell 8)) (c2-image-fail-stop 134))
    (if (not (= (c2-image-release (c2-image-token cell)) 0))
        (c2-image-fail-stop 134))
    (vector-set! record 1 'dead)
    (if (not (c2-image-unlink! record)) (c2-image-fail-stop 134))
    (vector-set! shell 1 'dead)
    #t))
