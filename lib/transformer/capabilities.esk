;;; Installed K2 capability facade. The completed source-composed aggregate owns
;;; K1 discovery, snapshot identity, and E1 construction. This source exposes
;;; only fixed-arity boxed calls and the six inherited error accessors.

(require transformer.error_consumer)

(provide transformer-error? transformer-error-category
         transformer-error-operation transformer-error-message
         transformer-error-details transformer-error-cause
         capability-discover capability-request capability-verified?
         capability-require capability-report-entries capability-entry-name
         capability-entry-status capability-entry-implementation
         capability-entry-version capability-entry-constraints
         capability-entry-deterministic? capability-entry-evidence)

(define k2-safe-capability-discover
  (let ()
    (extern void k2-public-capability-discover ptr
            :real et_e1b_public_k2_capability_discover_v1)
    (lambda ()
      (let ((output (vector #f)))
        (k2-public-capability-discover output)
        (vector-ref output 0)))))
(define (capability-discover) (k2-safe-capability-discover))

(define k2-safe-capability-request
  (let ()
    (extern void k2-public-capability-request ptr ptr ptr ptr ptr ptr
            :real et_e1b_public_k2_capability_request_v1)
    (lambda (operation dtype device shape deterministic?)
      (let ((output (vector #f)))
        (k2-public-capability-request
         (vector operation) (vector dtype) (vector device) (vector shape)
         (vector deterministic?) output)
        (vector-ref output 0)))))
(define (capability-request operation dtype device shape deterministic?)
  (k2-safe-capability-request operation dtype device shape deterministic?))

(define k2-safe-capability-verified
  (let ()
    (extern void k2-public-capability-verified ptr ptr ptr ptr
            :real et_e1b_public_k2_capability_verified_v1)
    (lambda (report capability request)
      (let ((output (vector #f)))
        (k2-public-capability-verified
         (vector report) (vector capability) (vector request) output)
        (vector-ref output 0)))))
(define (capability-verified? report capability request)
  (k2-safe-capability-verified report capability request))

