(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "g3c4_call_entry_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3c4_output_envelope_extension.esk")
(load "g3c4_p2g1_pending_extension.esk")
(load "g3c4_p2g1_shell_publication_extension.esk")

(extern i64 shell-test-prepare ptr ptr
        :real et_g3c4_shell_test_prepare_v1)
(extern i64 shell-test-field ptr i64
        :real et_g3c4_output_envelope_test_field_v1)
(extern i64 shell-test-ids-borrow ptr i64
        :real et_g3c4_shell_test_ids_borrow_v1)
(extern i64 shell-test-a2-view ptr i64
        :real et_g3c4_shell_test_a2_view_v1)
(extern i64 shell-test-mutation i64
        :real et_g3c4_shell_test_mutation_v1)
(extern i64 shell-test-published ptr ptr
        :real et_g3c4_shell_test_published_v1)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "G3-C4 P2/G1 shell FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label category thunk)
  (check label
    (guard (caught
             (#t (and (transformer-error? caught)
                      (eq? (transformer-error-category caught) category))))
      (thunk) #f)))
(define (latest kind)
  (let loop ((remaining (vector-ref g3c4-registry 0)))
    (cond ((null? remaining) #f)
          ((eq? (vector-ref (car remaining) 1) kind) (car remaining))
          (else (loop (cdr remaining))))))
(define (dead? entry)
  (and (eq? (vector-ref entry 2) 'dead)
       (not (vector-ref entry 3))
       (not (vector-ref entry 8))))
(define (config mode seed)
  (list ':profile 'diagnostic-c4 ':sampling mode
        ':temperature-bits 1065353216 ':top-k 256
        ':top-p-bits 1065353216 ':max-new-tokens 1
        ':eos #f ':seed seed))
(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-model-create-seeded-internal 1729))
(define model-entry (car (vector-ref g3c4-model-registry 0)))

(define (prepare call)
  (let* ((generator-entry (vector-ref call 4))
         (output (g3c4-p2g1-output-reserve call)))
    (check "genuine P2 prefill and position-two token forward"
           (= (shell-test-prepare (vector-ref generator-entry 3)
                                  (vector-ref output 3)) 0))
    output))
(define (run-success mode seed)
  (let* ((generator
           (g3c4-generator-create-internal model tokenizer
                                           (config mode seed)))
         (generator-entry (latest 'generator))
         (shell
           (g3c4-with-p2g1-output-call-internal
             'g3c4-p2g1-shell-success generator (call)
             (let ((output (prepare call)))
               (reject "unprepared joint commit" 'invalid-state
                 (lambda ()
                   (g3c4-native-check
                     (g3c4-native-generation-frame-commit
                       (vector-ref generator-entry 3)
                       (vector-ref output 3))
                     'g3c4-p2g1-unprepared)))
               (reject "pending shell cannot be released as live"
                       'invalid-state
                 (lambda ()
                   (g3c4-p2g1-output-release-internal!
                     (vector-ref output 0))))
               (g3c4-p2g1-output-publish! call output))))
         (entry (g3c4-p2g1-output-entry-live shell 'test)))
    (check "published Eshkol shell owns one raw byte"
           (and (eq? (vector-ref entry 2) 'live)
                (= (bytevector-length (vector-ref entry 8)) 1)
                (= (shell-test-field (vector-ref entry 3) 0) 3)
                (= (shell-test-field (vector-ref entry 3) 4) 1)
                (= (shell-test-published (vector-ref entry 3)
                                         (vector-ref entry 8)) 1)
                (not (vector-ref entry 4))
                (not (vector-ref entry 5))
                (not (vector-ref entry 6))))
    (check "call links and shared guard cleared"
           (and (not (vector-ref generator-entry 9))
                (not (vector-ref model-entry 10))
                (not (vector-ref m3-call-state 0))
                (dead? (latest 'call))))
    (reject "coordinator cannot publish a second time" 'invalid-state
      (lambda ()
        (g3c4-p2g1-output-publish! (latest 'call) (latest 'output))))
    (check "output survives generator close"
           (g3c4-generator-close-internal! generator))
    (reject "wrong-kind registered shell cannot release output"
            'invalid-state
      (lambda () (g3c4-p2g1-output-release-internal! generator)))
    (check "published native output I1 borrow starts"
           (= (shell-test-ids-borrow (vector-ref entry 3) 1) 0))
    (reject "borrowed output release preserves live shell" 'invalid-state
      (lambda () (g3c4-p2g1-output-release-internal! shell)))
    (check "borrowed output shell remains live"
           (eq? (vector-ref entry 2) 'live))
    (check "published native output I1 borrow ends"
           (= (shell-test-ids-borrow (vector-ref entry 3) 0) 0))
    (check "release after generator close"
           (g3c4-p2g1-output-release-internal! shell))
    (check "release tombstones shell"
           (dead? entry))
    (check "authenticated repeat release"
           (g3c4-p2g1-output-release-internal! shell))
    (reject "forged output shell rejected" 'invalid-argument
      (lambda () (g3c4-p2g1-output-release-internal!
                   (vector 'forged-output))))))

(run-success 'greedy 7)
(run-success 'categorical 13)

(define mutation-generator
  (g3c4-generator-create-internal model tokenizer (config 'greedy 17)))
(define mutation-generator-entry (latest 'generator))
(define mutation-captures (vector #f #f #f))
(define (run-mutation mode)
  (check "arm post-accept mutation"
         (= (shell-test-mutation mode) 0))
  (reject "altered raw/staging bytes cannot publish" 'invalid-state
    (lambda ()
      (g3c4-with-p2g1-output-call-internal
        'g3c4-p2g1-shell-mutated mutation-generator (call)
        (let* ((output (prepare call))
               (auxiliary (vector-ref output 8)))
          (vector-set! mutation-captures 0 output)
          (vector-set! mutation-captures 1 (vector-ref auxiliary 0))
          (vector-set! mutation-captures 2 (vector-ref auxiliary 1))
          (g3c4-p2g1-output-publish! call output)))))
  (check "mutation rollback scrubs both carriers"
         (and (dead? (vector-ref mutation-captures 0))
              (= (bytevector-u8-ref (vector-ref mutation-captures 1) 0) 0)
              (let upper ((i 0))
                (if (= i 8) #t
                    (and (= (bytevector-u8-ref
                              (vector-ref mutation-captures 2) i) 0)
                         (upper (+ i 1))))))))
(run-mutation 1)
(run-mutation 2)
(run-mutation 3)
(check "mutation leaves generator reusable"
       (and (not (vector-ref mutation-generator-entry 9))
            (not (vector-ref m3-call-state 0))))
(define retry-shell
  (g3c4-with-p2g1-output-call-internal
    'g3c4-p2g1-shell-retry mutation-generator (call)
    (g3c4-p2g1-output-publish! call (prepare call))))
(check "fresh retry after abort publishes"
       (g3c4-p2g1-output-entry-live retry-shell 'test))
(check "release fresh retry"
       (g3c4-p2g1-output-release-internal! retry-shell))
(check "close retried generator"
       (g3c4-generator-close-internal! mutation-generator))

(define (run-held-lease kind seed)
  (let* ((generator
           (g3c4-generator-create-internal model tokenizer
                                           (config 'greedy seed)))
         (generator-entry (latest 'generator))
         (observed (vector #f)))
    (g3c4-with-p2g1-output-call-internal
      'g3c4-p2g1-shell-held generator (call)
      (let ((output (prepare call)))
        (vector-set! observed 0 output)
        (check "open scoped external lease"
               (= (if (eq? kind 'ids)
                      (shell-test-ids-borrow (vector-ref output 3) 1)
                      (shell-test-a2-view (vector-ref generator-entry 3) 1))
                  0))
        (reject "held lease rejects publication in active region"
                'invalid-state
          (lambda () (g3c4-p2g1-output-publish! call output)))
        (check "end external lease before abort"
               (= (if (eq? kind 'ids)
                      (shell-test-ids-borrow (vector-ref output 3) 0)
                      (shell-test-a2-view (vector-ref generator-entry 3) 0))
                  0))
        (g3c4-p2g1-call-rollback! call generator-entry model-entry)))
    (check "held lease explicit abort tombstones"
           (and (dead? (vector-ref observed 0))
                (not (vector-ref generator-entry 9))
                (not (vector-ref m3-call-state 0))))
    (check "held lease generator closes"
           (g3c4-generator-close-internal! generator))))
(run-held-lease 'ids 23)
(run-held-lease 'a2 29)

(define ledger-generator
  (g3c4-generator-create-internal model tokenizer (config 'greedy 31)))
(define ledger-shell
  (g3c4-with-p2g1-output-call-internal
    'g3c4-p2g1-shell-ledger ledger-generator (call)
    (let* ((output (prepare call))
           (ledger (vector-ref call 10)))
      (vector-set! ledger 4 #f)
      (reject "altered child ledger rejects before rollback" 'invalid-state
        (lambda () (g3c4-p2g1-output-publish! call output)))
      (vector-set! ledger 4 output)
      (g3c4-p2g1-output-publish! call output))))
(check "repaired child ledger permits publication"
       (g3c4-p2g1-output-entry-live ledger-shell 'test))
(check "ledger output release"
       (g3c4-p2g1-output-release-internal! ledger-shell))
(check "ledger generator close"
       (g3c4-generator-close-internal! ledger-generator))

(define old-scope-generator
  (g3c4-generator-create-internal model tokenizer (config 'greedy 37)))
(reject "old auto scope still rejects a pending P2/G1 output" 'invalid-state
  (lambda ()
    (g3c4-with-call-internal
      'g3c4-p2g1-old-scope old-scope-generator 2 1
      (let* ((call (vector-ref m3-call-state 0))
             (output (g3t-output-reserve call 2)))
        (reject "joint shell coordinator rejects old call scope"
                'invalid-state
          (lambda () (g3c4-p2g1-output-publish! call output)))
        #t))))
(check "old auto scope rolls back"
       (and (dead? (latest 'output))
            (not (vector-ref m3-call-state 0))
            (g3c4-generator-close-internal! old-scope-generator)))

(define swap-generator-a
  (g3c4-generator-create-internal model tokenizer (config 'greedy 41)))
(define swap-shell-a
  (g3c4-with-p2g1-output-call-internal
    'g3c4-p2g1-swap-a swap-generator-a (call)
    (g3c4-p2g1-output-publish! call (prepare call))))
(define swap-generator-b
  (g3c4-generator-create-internal model tokenizer (config 'greedy 43)))
(define swap-shell-b
  (g3c4-with-p2g1-output-call-internal
    'g3c4-p2g1-swap-b swap-generator-b (call)
    (g3c4-p2g1-output-publish! call (prepare call))))
(define swap-entry-a (g3c4-registry-find swap-shell-a 'test))
(define swap-entry-b (g3c4-registry-find swap-shell-b 'test))
(define swap-native-a (vector-ref swap-entry-a 3))
(define swap-native-b (vector-ref swap-entry-b 3))
(vector-set! swap-entry-a 3 swap-native-b)
(reject "swapped native owner cannot release another output"
        'invalid-state
  (lambda () (g3c4-p2g1-output-release-internal! swap-shell-a)))
(check "owner swap preserves both native outputs"
       (and (eq? (vector-ref swap-entry-a 2) 'live)
            (eq? (vector-ref swap-entry-b 2) 'live)
            (= (shell-test-field swap-native-a 0) 3)
            (= (shell-test-field swap-native-b 0) 3)))
(vector-set! swap-entry-a 3 swap-native-a)
(check "restored owner A releases"
       (g3c4-p2g1-output-release-internal! swap-shell-a))
(check "owner B releases independently"
       (g3c4-p2g1-output-release-internal! swap-shell-b))
(check "swap generators close"
       (and (g3c4-generator-close-internal! swap-generator-a)
            (g3c4-generator-close-internal! swap-generator-b)))

(display "G3-C4 P2/G1 shell PASS: checks=")
(display checks)
(display " success=2 mutation=3 retry=1 leases=2 ledger=1 old-scope=1 swap=1")
(newline)
