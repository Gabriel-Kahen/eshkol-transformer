;;; Executes actual Scheme orchestration with explicit nonnative doubles.
(use-modules (srfi srfi-1) (srfi srfi-34))
(define checks 0)
(define (check label value) (if value (set! checks (+ checks 1)) (error label)))
(define (read-forms path)
  (call-with-input-file path
    (lambda (port) (let loop ((out '()))
      (let ((item (read port)))
        (if (eof-object? item) (reverse out) (loop (cons item out))))))))
(define source (read-forms "native/cpu4_checkpoint_extension.esk"))
(define (load-function name)
  (eval (find (lambda (f) (and (pair? f) (eq? (car f) 'define)
                              (pair? (cadr f)) (eq? (caadr f) name))) source)
        (current-module)))
(define events '())
(define (event x) (set! events (append events (list x))))
(define cpu4-checkpoint-operation 'test)
(define cpu4-checkpoint-i64-max 9223372036854775807)
(define cpu4-checkpoint-parents (vector '()))
(define (cpu4-checkpoint-fail category message) (throw category message))
(define (cpu4-binding-fail-stop code) (throw 'fail-stop code))
(for-each load-function '(cpu4-checkpoint-parent cpu4-checkpoint-prepare!
                         cpu4-checkpoint-commit! cpu4-checkpoint-validate-source!
                         cpu4-checkpoint-length cpu4-checkpoint-list-ref
                         cpu4-checkpoint-list-prefix cpu4-checkpoint-vector->list
                         cpu4-checkpoint-fixed-source!))
