;;; Closed CLI leaf: load after actual CPU4 controls/full-step/E3 producers.
;;; No dispatcher, installed export, caller callback, or numerical implementation.
;;; Command-exclusive: private restore/train/detach/mode operations are forbidden
;;; while live. Equal-U private restore is outside this staleness threat model.
(extern ptr cpu4-cli-native-create :real et_cpu4_private_cli_scalar_create_v1)
(extern i64 cpu4-cli-native-read ptr :real et_cpu4_private_cli_scalar_read_bits_v1)
(extern i64 cpu4-cli-native-claim ptr i64 :real et_cpu4_private_cli_scalar_claim_v1)
(extern i64 cpu4-cli-native-release ptr :real et_cpu4_private_cli_scalar_release_v1)
(extern i64 cpu4-cli-native-error i64 :real et_cpu4_private_cli_scalar_last_error_ref_v1)
(define cpu4-cli-producer-step cpu4-training-step-internal!)
(define cpu4-cli-producer-begin cpu4-trainer-control-begin-internal)
(define cpu4-cli-producer-copy cpu4-trainer-controls-copy-internal)
(define cpu4-cli-producer-end cpu4-trainer-control-end-internal!)
(define cpu4-cli-scalar-tag (vector 'cpu4-cli-scalar-v1))
(define cpu4-cli-report-tag (vector 'cpu4-cli-report-context-v1))
(define cpu4-cli-scalars (vector '()))
(define cpu4-cli-reports (vector '()))
(define (cpu4-cli-fail category message)
  (cpu4-binding-fail category 'cpu4-cli-report message))
(define (cpu4-cli-find shell registry tag size)
  (let scan ((rows (vector-ref registry 0)))
    (cond ((null? rows) (cpu4-cli-fail 'invalid-argument "unregistered CLI shell"))
          ((eq? shell (vector-ref (car rows) 2))
           (let ((row (car rows)))
             (if (not (and (cpu4-control-vector? row size)
                           (eq? (vector-ref row 0) tag)
                           (eq? (vector-ref row 1) row)))
                 (cpu4-cli-fail 'invalid-state "CLI canonical identity changed"))
             row))
          (else (scan (cdr rows))))))
;;; Scalar row [issuer,self,shell,phase,original-native,claimed?,diagnostic3].
(define (cpu4-cli-scalar-row shell)
  (cpu4-cli-find shell cpu4-cli-scalars cpu4-cli-scalar-tag 7))
(define (cpu4-cli-scalar-live shell)
  (let ((row (cpu4-cli-scalar-row shell)))
    (if (not (eq? (vector-ref row 3) 'live))
        (cpu4-cli-fail 'invalid-state "CLI scalar is not live")) row))
(define (cpu4-cli-scalar-capture! row)
  ;; Fixed stores, immediately after failure, before cleanup resets TLS.
  (vector-set! (vector-ref row 6) 0 (cpu4-cli-native-error 0))
  (vector-set! (vector-ref row 6) 1 (cpu4-cli-native-error 1))
  (vector-set! (vector-ref row 6) 2 (cpu4-cli-native-error 2)))
(define (cpu4-cli-scalar-raise row)
  (let* ((diagnostic (vector-ref row 6))
         (domain (vector-ref diagnostic 0)) (category (vector-ref diagnostic 1))
         (code (vector-ref diagnostic 2))
         (mapped (if (= domain 1)
                     (cond ((= category 1) 'invalid-argument)
                           ((= category 2) 'shape-mismatch)
                           ((= category 3) 'noncontiguous)
                           ((= category 4) 'invalid-state)
                           ((= category 5) 'version-mismatch)
                           (else 'internal))
                     (cond ((or (= category 1) (= category 4)) 'invalid-argument)
                           ((= category 2) 'invalid-state)
                           ((= category 3) 'shape-mismatch) (else 'internal)))))
    (et-e1b-private-raise mapped 'cpu4-cli-scalar "native scalar rejected operation"
      (list (list 'source-domain domain) (list 'source-category category)
            (list 'source-code code)) #f)))
(define (cpu4-cli-scalar-owner-create-internal)
  (let* ((row (vector cpu4-cli-scalar-tag #f (vector 'cpu4-cli-scalar)
                      'pending #f #f (vector 0 0 0)))
         (next (cons row (vector-ref cpu4-cli-scalars 0))))
    ;; Root pending custody before native acquisition; use canonical graph.
    (vector-set! cpu4-cli-scalars 0 next)
    (let* ((canonical (car (vector-ref cpu4-cli-scalars 0)))
           (native (cpu4-cli-native-create)))
      (vector-set! canonical 1 canonical)
      (if (null? native)
          (begin (cpu4-cli-scalar-capture! canonical)
                 (vector-set! canonical 3 'dead)
                 (cpu4-cli-scalar-raise canonical)))
      (vector-set! canonical 4 native)
      (vector-set! canonical 3 'live)
      (vector-ref canonical 2))))
(define (cpu4-cli-scalar-readbits-internal scalar)
  (let* ((row (cpu4-cli-scalar-live scalar))
         (bits (cpu4-cli-native-read (vector-ref row 4))))
    (if (< bits 0)
        (begin (cpu4-cli-scalar-capture! row) (cpu4-cli-scalar-raise row))) bits))
(define (cpu4-cli-scalar-claim! scalar action)
  (let ((row (cpu4-cli-scalar-live scalar)))
    (if (not (= (cpu4-cli-native-claim (vector-ref row 4) action) 0))
        (begin (cpu4-cli-scalar-capture! row) (cpu4-cli-scalar-raise row)))
    (vector-set! row 5 (= action 1)) #t))
(define (cpu4-cli-scalar-owner-release-internal! scalar)
  (let ((row (cpu4-cli-scalar-row scalar)))
    (if (eq? (vector-ref row 3) 'dead) #t
        (begin
          (if (not (eq? (vector-ref row 3) 'live))
              (cpu4-cli-fail 'invalid-state "scalar acquisition pending"))
          (if (not (= (cpu4-cli-native-release (vector-ref row 4)) 0))
              (begin (cpu4-cli-scalar-capture! row) (cpu4-cli-scalar-raise row)))
          (vector-set! row 4 #f) (vector-set! row 3 'dead) #t))))

;;; Report row28: issuer,self,shell,phase,trainer,original-row,record,binding,
;;; model,resolved,T2-entry,D2-state,O2-record,recovery-cell,control-token,
;;; initial-U,committed-steps,original-result,failed-report-kind,scalars4,
;;; E3-frame,busy?,primary-error,cleanup-error,before-controls,staged-data,
;;; failed-producer-frame,command-limit. Closed parents/scalar sidecars remain
;;; retained tombstones and are included in the pending resource census.
(define (cpu4-cli-report-row context)
  (let ((row (cpu4-cli-find context cpu4-cli-reports cpu4-cli-report-tag 28)))
    (if (eq? (vector-ref row 3) 'dead)
        (cpu4-cli-fail 'invalid-state "CLI report context is dead"))
    (let ((record (vector-ref row 6)))
      (let scan ((rows (vector-ref cpu4-trainers 0)))
        (cond ((null? rows) (cpu4-cli-fail 'invalid-state "original trainer row missing"))
              ((eq? (car rows) (vector-ref row 5)) #t)
              (else (scan (cdr rows)))))
      (if (not (and (eq? record (vector-ref (vector-ref row 5) 0))
                    (eq? (vector-ref record 0) cpu4-trainer-tag)
                    (eq? (vector-ref record 1) record)
                    (eq? (vector-ref record 2) (vector-ref row 4))
                    (eq? (vector-ref record 9) (vector-ref row 7))
                    (eq? (vector-ref record 8) (vector-ref row 8))
                    (eq? (vector-ref record 6) (vector-ref row 9))
                    (eq? (vector-ref (vector-ref row 5) 2) (vector-ref row 10))
                    (eq? (vector-ref record 16) (vector-ref row 11))
                    (eq? (vector-ref record 14) (vector-ref row 12))
                    (eq? (vector-ref (vector-ref row 13) 0) context)))
          (cpu4-cli-fail 'invalid-state "CLI original component identity changed")))
    row))
(define (cpu4-cli-report-enter! row)
  (if (vector-ref row 21) (cpu4-cli-fail 'invalid-state "CLI report operation busy"))
  (vector-set! row 21 #t))
;;; Install the handler before acquiring busy state. An invocation that never
;;; entered cannot clear another operation's busy bit or diagnostic custody.
(define-syntax cpu4-cli-report-operation
  (syntax-rules ()
    ((_ row (caught recovery ...) body ...)
     (let ((entered #f))
       (guard (caught (#t (if entered
                             (begin recovery ... (vector-set! row 21 #f)))
                          (raise caught)))
         (cpu4-cli-report-enter! row)
         (set! entered #t)
         body ...)))))
(define (cpu4-cli-report-pending? row)
  (or (vector-ref row 14) (vector-ref row 20) (vector-ref row 26)
      (let scan ((i 0)) (and (< i 4)
        (or (vector-ref (vector-ref row 19) i) (scan (+ i 1)))))))
(define (cpu4-cli-controls-snapshot! row)
  ;; A rejected end retains the exact native WRITE=2 parent for retry.
  (if (not (vector-ref row 14))
      (vector-set! row 14 (cpu4-cli-producer-begin (vector-ref row 4) 'snapshot)))
  (let ((copy (cpu4-cli-producer-copy (vector-ref row 14))))
    (cpu4-cli-producer-end (vector-ref row 14))
    (vector-set! row 14 #f)
    copy))
(define (cpu4-cli-report-policy! record)
  (cpu4-binding-profile! (vector-ref record 6) 'cpu4-cli-report)
  (if (not (= (x1-private-config-ref (vector-ref record 6)
                                    'training.accumulation-steps) 1))
      (cpu4-cli-fail 'unsupported "CLI reports require accumulation1")))
(define (cpu4-cli-report-bind-internal trainer recovery-cell)
  (if (not (and (cpu4-control-vector? recovery-cell 1) (not (vector-ref recovery-cell 0))))
      (cpu4-cli-fail 'invalid-argument "report recovery cell must be exact and empty"))
  (let* ((record (cpu4-trainer-idle-check-internal trainer 'cpu4-cli-report))
         (original (cpu4-trainer-row-internal trainer 'cpu4-cli-report)))
    (cpu4-cli-report-policy! record)
    (let scan ((rows (vector-ref cpu4-cli-reports 0)))
      (if (pair? rows)
          (begin (if (and (not (eq? (vector-ref (car rows) 3) 'dead))
                          (eq? trainer (vector-ref (car rows) 4)))
                     (cpu4-cli-fail 'invalid-state "trainer already has CLI report context"))
                 (scan (cdr rows)))))
    (let* ((row (vector cpu4-cli-report-tag #f (vector 'cpu4-cli-report) 'binding
                        trainer original record (vector-ref record 9) (vector-ref record 8)
                        (vector-ref record 6) (vector-ref original 2) (vector-ref record 16)
                        (vector-ref record 14) recovery-cell #f 0 0 #f #f
                        (make-vector 4 #f) #f #f #f #f #f #f #f 250))
           (next (cons row (vector-ref cpu4-cli-reports 0))))
      (vector-set! cpu4-cli-reports 0 next)
      (let ((canonical (car (vector-ref cpu4-cli-reports 0))))
        (vector-set! canonical 1 canonical)
        (vector-set! (vector-ref canonical 13) 0 (vector-ref canonical 2))
        (guard (caught (#t (vector-set! canonical 22 caught) (raise caught)))
          (let ((controls (cpu4-cli-controls-snapshot! canonical)))
            (vector-set! canonical 15 (vector-ref (vector-ref controls 4) 1))
            (vector-set! canonical 3 'ready)
            (vector-ref canonical 2)))))))
(define (cpu4-cli-controls-report-copy-internal context)
  (let ((row (cpu4-cli-report-row context)))
    (cpu4-cli-report-operation row
      (caught (vector-set! row 18 'controls) (vector-set! row 22 caught))
      (if (or (not (or (eq? (vector-ref row 3) 'ready)
                           (eq? (vector-ref row 3) 'binding)))
              (vector-ref row 20) (vector-ref row 26))
          (cpu4-cli-fail 'invalid-state "pending producer cleanup"))
      (let ((copy (cpu4-cli-controls-snapshot! row)))
        (if (eq? (vector-ref row 18) 'controls) (vector-set! row 18 #f))
        (if (eq? (vector-ref row 3) 'binding)
            (begin (vector-set! row 15 (vector-ref (vector-ref copy 4) 1))
                   (vector-set! row 3 'ready)))
        (vector-set! row 21 #f) copy))))
(define (cpu4-cli-report-step-internal! context)
  (let ((row (cpu4-cli-report-row context)))
    (cpu4-cli-report-operation row
      (caught
        ;; The unchanged producer may retain its exact failed busy frame.
        (if (eq? (vector-ref (vector-ref row 6) 3) 'step)
            (vector-set! row 26 (vector-ref (vector-ref row 6) 4)))
        (vector-set! row 22 caught))
      (if (or (not (eq? (vector-ref row 3) 'ready))
              (vector-ref row 18) (cpu4-cli-report-pending? row))
          (cpu4-cli-fail 'invalid-state "report or cleanup must resolve before step"))
      (cpu4-cli-report-policy! (vector-ref row 6))
      (if (or (>= (vector-ref row 16) (vector-ref row 27))
              (>= (+ (vector-ref row 15) (vector-ref row 16)) 250))
          (cpu4-cli-fail 'invalid-state "CLI command or update bound reached"))
      (let ((controls (cpu4-cli-controls-snapshot! row)))
        (if (not (= (vector-ref (vector-ref controls 4) 1)
                    (+ (vector-ref row 15) (vector-ref row 16))))
            (cpu4-cli-fail 'invalid-state "CLI context stale before step")))
      ;; Guard is installed BEFORE producer. Postcommit capture is fixed stores
      ;; only: no validation, allocation, abort, retry, or borrowed return.
      (let ((result (cpu4-cli-producer-step (vector-ref row 4))))
        (vector-set! row 17 result)
        (vector-set! row 3 'ready)
        (vector-set! row 16 (+ (vector-ref row 16) 1))
        (vector-set! row 21 #f)
        #t))))
(define (cpu4-cli-u32-le bytes offset)
  (+ (bytevector-u8-ref bytes offset)
     (* 256 (bytevector-u8-ref bytes (+ offset 1)))
     (* 65536 (bytevector-u8-ref bytes (+ offset 2)))
     (* 16777216 (bytevector-u8-ref bytes (+ offset 3)))))
(define (cpu4-cli-ce-bits? bits)
  ;; Finite nonnegative CE, including either zero; no conversion/reduction.
  (or (= bits 2147483648)
      (and (< bits 2147483648) (not (= (bitwise-and bits 2139095040) 2139095040)))))
(define (cpu4-cli-final-step-report-copy-internal context)
  (let ((row (cpu4-cli-report-row context)))
    (cpu4-cli-report-operation row
      (caught (vector-set! row 18 'final) (vector-set! row 22 caught)
        (if (> (vector-ref row 16) 0)
            (begin
              (vector-set! row 21 #f)
              (et-e1b-private-raise 'internal 'cpu4-cli-final-step-report
                "committed optimizer step retained; report copy failed"
                (list (list 'committed #t)
                      (list 'updates (+ (vector-ref row 15) (vector-ref row 16)))
                      (list 'command-steps (vector-ref row 16))) #f))))
      (if (or (not (eq? (vector-ref row 3) 'ready))
              (= (vector-ref row 16) 0) (vector-ref row 20) (vector-ref row 26))
          (cpu4-cli-fail 'invalid-state "no committed idle step to report"))
      (cpu4-cli-report-policy! (vector-ref row 6))
      (let* ((controls (cpu4-cli-controls-snapshot! row)) (counts (vector-ref controls 4))
             (result (vector-ref row 17)))
        (if (not (and (cpu4-control-vector? result 4)
                      (cpu4-control-count? (vector-ref result 0))
                      (<= 1 (vector-ref result 0)) (<= (vector-ref result 0) 4)
                      (equal? (vector-ref result 1) (vector-ref counts 1))
                      (equal? (vector-ref result 2) (vector-ref counts 2))
                      (= (vector-ref counts 1) (+ (vector-ref row 15) (vector-ref row 16)))
                      (cpu4-control-vector? (vector-ref result 3) 1)
                      (bytevector? (vector-ref (vector-ref result 3) 0))
                      (= (bytevector-length (vector-ref (vector-ref result 3) 0)) 12)))
            (cpu4-cli-fail 'internal "committed result structure or counters invariant failed"))
        (let* ((observation (vector-ref (vector-ref result 3) 0))
               (numerator (cpu4-cli-u32-le observation 0))
               (weight (cpu4-cli-u32-le observation 4))
               (mean (cpu4-cli-u32-le observation 8))
               (expected (vector-ref (vector 1065353216 1073741824 1077936128 1082130432)
                                     (- (vector-ref result 0) 1))))
          (if (not (and (= weight expected) (cpu4-cli-ce-bits? numerator)
                        (cpu4-cli-ce-bits? mean)))
              (cpu4-cli-fail 'internal "committed CE observation invariant failed"))
          (let ((copy (vector 'cpu4-cli-final-step-report-v1 (vector-ref counts 0)
                              (vector-ref counts 1) (vector-ref counts 2)
                              (vector-ref result 0) numerator weight mean)))
            (if (eq? (vector-ref row 18) 'final) (vector-set! row 18 #f))
            (vector-set! row 21 #f) copy))))))
(define (cpu4-cli-controls=? left right)
  (and (equal? (vector-ref left 0) (vector-ref right 0))
       (equal? (vector-ref left 1) (vector-ref right 1))
       (d2-core-bytes=? (vector-ref (vector-ref left 2) 0) (vector-ref (vector-ref right 2) 0))
       (d2-core-bytes=? (vector-ref (vector-ref left 2) 1) (vector-ref (vector-ref right 2) 1))
       (d2-core-bytes=? (vector-ref (vector-ref left 3) 0) (vector-ref (vector-ref right 3) 0))
       (string=? (vector-ref (vector-ref left 3) 1) (vector-ref (vector-ref right 3) 1))
       (equal? (vector-ref left 4) (vector-ref right 4))))
(define (cpu4-cli-report-cleanup! row)
  (if (vector-ref row 14)
      (begin (cpu4-cli-producer-end (vector-ref row 14)) (vector-set! row 14 #f)))
  (if (vector-ref row 26)
      (begin (cpu4-training-step-abort-internal! (vector-ref row 26))
             (vector-set! row 26 #f)))
  (if (vector-ref row 20)
      (let ((frame (vector-ref row 20)))
        (if (not (= (vector-ref (e3-frame-entry-live frame 'cpu4-cli-report) 1) 1))
            (e3-abort! frame))
        (e3-frame-unbind! frame)
        (vector-set! row 20 #f)))
  (let scan ((i 0))
    (if (< i 4)
        (let ((scalar (vector-ref (vector-ref row 19) i)))
          (if scalar
              (begin
                (if (vector-ref (cpu4-cli-scalar-row scalar) 5)
                    (cpu4-cli-scalar-claim! scalar 2))
                (cpu4-cli-scalar-owner-release-internal! scalar)
                (vector-set! (vector-ref row 19) i #f)))
          (scan (+ i 1))))) #t)
(define (cpu4-cli-evaluation-report-internal context heldout-dataset)
  (let ((row (cpu4-cli-report-row context)))
    (cpu4-cli-report-operation row
      (caught (vector-set! row 18 'evaluation) (vector-set! row 22 caught))
      ;; Retain exact frame/scalars/staged data for phase-only retry.
      ;; Release is the explicit abort/drain/unbind cleanup path.
      (if (or (vector-ref row 26) (eq? (vector-ref row 3) 'binding)
              (eq? (vector-ref row 3) 'evaluation-failed))
          (cpu4-cli-fail 'invalid-state "evaluation requires cleanup/release"))
      (if (eq? (vector-ref row 3) 'ready)
          (begin
            (if (cpu4-cli-report-pending? row)
                (cpu4-cli-fail 'invalid-state "pending cleanup before evaluation"))
            (if (eq? heldout-dataset (vector-ref (vector-ref row 6) 15))
                (cpu4-cli-fail 'invalid-argument "heldout dataset aliases training dataset"))
            (d2-open-dataset-state heldout-dataset 'cpu4-cli-report)
            (cpu4-d2-idle-core heldout-dataset 'cpu4-cli-report)
            ;; Allocate detached staging before acquiring E3/scalar custody.
            (vector-set! row 25 (vector 'cpu4-cli-evaluation-report-v1 0 0 0 0 0 0))
            (vector-set! row 24 (vector (cpu4-cli-controls-snapshot! row) heldout-dataset
                                      (d2-open-dataset-state heldout-dataset 'cpu4-cli-report)))
            (vector-set! row 3 'evaluation-bind)))
      (if (not (and (eq? heldout-dataset (vector-ref (vector-ref row 24) 1))
                    (eq? (d2-open-dataset-state heldout-dataset 'cpu4-cli-report)
                         (vector-ref (vector-ref row 24) 2))))
          (cpu4-cli-fail 'invalid-state "evaluation retry changed heldout identity"))
      (if (eq? (vector-ref row 3) 'evaluation-bind)
          (begin
            (let create ((i 0))
              (if (< i 4)
                  (begin
                    (if (not (vector-ref (vector-ref row 19) i))
                        (vector-set! (vector-ref row 19) i (cpu4-cli-scalar-owner-create-internal)))
                    (if (not (vector-ref (cpu4-cli-scalar-row (vector-ref (vector-ref row 19) i)) 5))
                        (cpu4-cli-scalar-claim! (vector-ref (vector-ref row 19) i) 1))
                    (create (+ i 1)))))
            (let ((destinations (make-vector 4 #f)))
              (let fill ((i 0))
                (if (< i 4)
                    (begin (vector-set! destinations i
                             (vector-ref (cpu4-cli-scalar-live (vector-ref (vector-ref row 19) i)) 4))
                           (fill (+ i 1)))))
              (vector-set! row 20 (cpu4-e3-frame-bind-internal (vector-ref row 7) destinations)))
            ;; Mark before invocation. A failed actual evaluator cannot retry it.
            (vector-set! row 3 'evaluation-failed)
            (if (not (e3-evaluate-into! (vector-ref row 8) heldout-dataset (vector-ref row 20)))
                (cpu4-cli-fail 'internal "actual E3 evaluation failed"))
            (vector-set! row 3 'evaluation-capture)))
      (if (eq? (vector-ref row 3) 'evaluation-capture)
          (begin
            (let capture ((i 0))
              (if (< i 4)
                  (begin (vector-set! (vector-ref row 25) (+ i 1)
                           (cpu4-cli-scalar-readbits-internal (vector-ref (vector-ref row 19) i)))
                         (capture (+ i 1)))))
            (vector-set! (vector-ref row 25) 5 (e3-counter-ref (vector-ref row 20) 0))
            (vector-set! (vector-ref row 25) 6 (e3-counter-ref (vector-ref row 20) 1))
            (vector-set! row 3 'evaluation-cleanup)))
      (if (eq? (vector-ref row 3) 'evaluation-cleanup)
          (begin (cpu4-cli-report-cleanup! row) (vector-set! row 3 'evaluation-after)))
      (if (not (eq? (vector-ref row 3) 'evaluation-after))
          (cpu4-cli-fail 'invalid-state "evaluation phase cannot publish"))
      (let ((after (cpu4-cli-controls-snapshot! row)))
        (if (not (cpu4-cli-controls=? (vector-ref (vector-ref row 24) 0) after))
            (cpu4-cli-fail 'internal "E3 controls changed")))
      ;; Controls equality is not proof of model/O2/gradient byte preservation.
      (let ((copy (vector-ref row 25)))
        (if (eq? (vector-ref row 18) 'evaluation) (vector-set! row 18 #f))
        (vector-set! row 24 #f) (vector-set! row 25 #f)
        (vector-set! row 3 'ready) (vector-set! row 21 #f) copy))))
(define (cpu4-cli-report-release-internal! context)
  (let ((row (cpu4-cli-find context cpu4-cli-reports cpu4-cli-report-tag 28)))
    (if (eq? (vector-ref row 3) 'dead) #t
        (begin
          (cpu4-cli-report-row context)
          (cpu4-cli-report-operation row
            (caught (vector-set! row 23 caught))
            (cpu4-cli-report-cleanup! row)
            (vector-set! row 3 'dead) (vector-set! row 21 #f) #t)))))
