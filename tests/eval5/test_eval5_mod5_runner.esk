        :real et_eval5_aot_manifest_set_identity)
(extern i32 eval5-manifest-set-digests ptr ptr ptr ptr ptr
        :real et_eval5_aot_manifest_set_digests)
(extern i32 eval5-manifest-set-audit ptr i32 i32 i32 f64 f64 ptr f64
        :real et_eval5_aot_manifest_set_audit)
(extern i32 eval5-manifest-set-lm ptr i64 i64 ptr :real et_eval5_aot_manifest_set_lm)
(extern i32 eval5-manifest-set-mc ptr i32 i64 i64 f64 :real et_eval5_aot_manifest_set_mc)
(extern i32 eval5-manifest-verify-clean ptr :real et_eval5_aot_manifest_verify_clean)
(extern i32 eval5-manifest-write-atomic char* ptr :real et_eval5_aot_manifest_write_atomic)
(extern i32 eval5-manifest-read-file char* ptr :real et_eval5_aot_manifest_read_file)
(extern i32 eval5-manifest-get-metrics ptr ptr ptr ptr :real et_eval5_aot_manifest_get_metrics)
