;;; Compiled private acceptance fixture, deliberately not run by host checks.
;;; It must later run under the pinned normal/repeat/sanitizer gate.
(load "m3_package_root.esk")
(load "m3_call_adapters.esk")
(load "g3t_model_admission_extension.esk")
(load "g3t_generator_constructor_extension.esk")
(load "g3t_prefill_sample_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3t_output_text_extension.esk")
(load "g3t_final_publication_extension.esk")
(load "g3t_manual_p1_extension.esk")
(load "g3t_manual_logits_materialize_extension.esk")
(load "g3m_prefill_p1_extension.esk")
(load "g3m_prefill_p2_extension.esk")
(load "g3m_manual_decode_extension.esk")
(load "g3m_seeded_p1_g1_extension.esk")
(load "g3r_replayed_p1_g1_extension.esk")

(extern i64 g3r-test-cache-length ptr :real et_g3t_test_cache_length_v1)
(extern i64 g3r-test-cache-kv ptr i64 i64
        :real et_g3t_test_manual_cache_kv_word_v1)
(extern i64 g3r-test-logit ptr i64 :real et_g3t_test_logit_bits_v1)
(extern i64 g3r-test-rng ptr i64 :real et_g3t_test_rng_word_v1)
(extern i64 g3r-test-output ptr i64 :real et_g3t_test_output_word_v1)

(define checks 0)
(define (check label value)
  (if value (set! checks (+ checks 1))
      (begin (display "G3-R replayed P1/G1 FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject thunk)
  (guard (caught (#t (transformer-error? caught))) (thunk) #f))
(define policy
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos 65 ':seed 1729))
(define config
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define initial (g3t-checked-m3t-initializer-state 1729))
(define model
  (with-region ('g3r-replay-model 65536)
    (g3t-checked-m3t-model-create config initial)))
(define tokenizer (t1-private-tokenizer-byte config))
(check "model eval" (module-eval! model))
(define fresh (g3t-generator-create model tokenizer policy))
(define replayed (g3t-generator-create model tokenizer policy))
(define input (g3t-generation-token-input-create 65))
(check "unprefilled replay rejects"
       (reject (lambda () (g3r-private-replayed-p1-g1! replayed))))
(check "wrong-kind receiver rejects"
       (reject (lambda () (g3r-private-replayed-p1-g1! input))))
(define fresh-output (g3m-generate-p1-g1! fresh input))
(define logits (g3m-prefill-p1! replayed input))
(define fresh-native (vector-ref (g3t-generator-find fresh 'g3r-test) 3))
(define replay-native (vector-ref (g3t-generator-find replayed 'g3r-test) 3))
(check "manual P1 consumes no draw and retains length one"
       (and (= 1 (g3r-test-cache-length replay-native))
            (= 0 (g3r-test-rng replay-native 2))
            (= 0 (g3r-test-rng replay-native 3))))
(check "all P1 logits match the genuine uninterrupted call"
       (let loop ((i 0))
         (if (= i 256) #t
             (and (= (g3r-test-logit fresh-native i)
                     (g3r-test-logit replay-native i))
                  (loop (+ i 1))))))
(check "first A2 K/V row matches"
       (let row ((which 0) (i 0))
         (if (= which 2) #t
             (if (= i 4) (row (+ which 1) 0)
                 (and (= (g3r-test-cache-kv fresh-native which i)
                         (g3r-test-cache-kv replay-native which i))
                      (row which (+ i 1)))))))
(define replay-output (g3r-private-replayed-p1-g1! replayed))
(define fresh-native-output
  (vector-ref (g3t-prefill-entry fresh-output 'output 'g3r-test) 3))
(define replay-native-output
  (vector-ref (g3t-prefill-entry replay-output 'output 'g3r-test) 3))
(check "one genuine sampled ID, logical and cache lengths match"
       (and (= (g3r-test-output fresh-native-output 6)
               (g3r-test-output replay-native-output 6))
            (= 1 (g3r-test-output replay-native-output 1))
            (= 2 (g3r-test-output replay-native-output 2))
            (= 2 (g3r-test-cache-length replay-native))))
(check "successor RNG words and both K/V rows match"
       (and (let words ((i 0))
              (if (= i 4) #t
                  (and (= (g3r-test-rng fresh-native i)
                          (g3r-test-rng replay-native i))
                       (= (g3r-test-output fresh-native-output (+ 7 i))
                          (g3r-test-output replay-native-output (+ 7 i)))
                       (words (+ i 1)))))
            (let kv ((which 0) (i 0))
              (if (= which 2) #t
                  (if (= i 8) (kv (+ which 1) 0)
                      (and (= (g3r-test-cache-kv fresh-native which i)
                              (g3r-test-cache-kv replay-native which i))
                           (kv which (+ i 1))))))))
(check "full context rejects a second replay without draw"
       (let ((low (g3r-test-rng replay-native 2))
             (high (g3r-test-rng replay-native 3)))
         (and (reject (lambda () (g3r-private-replayed-p1-g1! replayed)))
              (= low (g3r-test-rng replay-native 2))
              (= high (g3r-test-rng replay-native 3)))))
(check "detached owners release"
       (and (g3t-output-release! fresh-output)
            (g3t-output-release! replay-output)
            (g3t-generation-tensor-release! logits)
            (g3t-generation-tensor-release! input)
            (g3t-generator-close! fresh)
            (g3t-generator-close! replayed)))
(display "G3-R replayed P1/G1 private PASS: checks=")
(display checks)
(newline)
