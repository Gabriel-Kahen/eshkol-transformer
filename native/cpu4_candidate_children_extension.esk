;;; Closed CPU4 factory custody. Load after candidate, O2, binding, trainer,
;;; and the immutable cpu4_trainer_detach extension. Caller owns T2 and D2.
;;; No callbacks, foreign optimizer enrollment, or public destructor.
(extern i32 cpu4-owned-native-o2-preflight ptr ptr
        :real et_o2_private_candidate_retire_preflight_v1)
(define cpu4-owned-candidates (vector '()))
(define cpu4-owned-tag (vector 'cpu4-owned-candidate-v1))
;;; [tag,self,token,state,resolved,candidate,optimizer-shell,optimizer-record,
;;; native-optimizer,binding,trainer,detached?,busy?,original-handles14,builder-or-finished]. All rows stay rooted.
(define (cpu4-owned-row token operation)
  (let find ((rows (vector-ref cpu4-owned-candidates 0)))
    (cond ((null? rows) (cpu4-binding-fail 'invalid-argument operation "foreign CPU4 factory ticket"))
          ((eq? token (vector-ref (car rows) 2))
           (let ((row (car rows)))
             (if (not (and (vector? row) (= (vector-length row) 15)
                           (eq? (vector-ref row 0) cpu4-owned-tag)
                           (eq? (vector-ref row 1) row)
                           (or (eq? (vector-ref row 3) 'open)
                               (eq? (vector-ref row 3) 'dead))))
                 (cpu4-binding-fail 'invalid-state operation "CPU4 factory ticket is stale"))
             row))
          (else (find (cdr rows))))))
(define (cpu4-owned-open token operation)
  (let ((row (cpu4-owned-row token operation)))
    (if (or (not (eq? (vector-ref row 3) 'open)) (vector-ref row 12)
            (vector-ref row 11))
        (cpu4-binding-fail 'invalid-state operation "CPU4 factory is not open and idle"))
    row))
(define (cpu4-owned-candidate-create-internal resolved)
  (let* ((row (vector cpu4-owned-tag #f (vector 'cpu4-factory) 'open resolved
                      #f #f #f #f #f #f #f #f (make-vector 14 #f) #f))
         (next (cons row (vector-ref cpu4-owned-candidates 0))))
    ;; Promotion/allocation of the entire envelope precedes native ownership.
    (vector-set! cpu4-owned-candidates 0 next)
    (let ((canonical (car (vector-ref cpu4-owned-candidates 0))))
      (vector-set! canonical 1 canonical)
      (guard (caught (#t (vector-set! canonical 3 'dead) (raise caught)))
        (let ((candidate (cpu4-candidate-model-create-internal! (vector-ref canonical 4))))
          ;; The base producer has its own rooted native-publication cleanup.
          (vector-set! canonical 5 candidate)
          (vector-ref canonical 2))))))
(define (cpu4-owned-model-internal token)
  (let ((row (cpu4-owned-open token 'cpu4-owned-model)))
    (cpu4-candidate-model-internal (vector-ref row 5))))

(define (cpu4-owned-o2-registry-check operation)
  (let ((count (i2-bounded-list-length o2-optimizers 4097)))
    (if (or (not count) (> count 4096))
        (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer registry is malformed or exceeds bound")))
  (let rows ((remaining o2-optimizers))
    (if (null? remaining) #t
        (let ((record (car remaining)))
          (if (not (and (vector? record) (= (vector-length record) 6)))
              (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer registry record is malformed"))
          (rows (cdr remaining))))))

;;; Do not call public optimizer-create here. Its set! of the registry AFTER
;;; native builder-finish may promote/allocate inside an active Eshkol region.
;;; Root the exact six-slot O2 envelope BEFORE any native builder allocation.
(define (cpu4-owned-o2-create! row config tree)
  (let* ((operation 'cpu4-owned-optimizer-create)
         (registry-check (cpu4-owned-o2-registry-check operation))
         (parsed (o2-parse-config operation config))
         (tree-paths (o2-tree-paths operation tree))
         (unique (o2-unique-handles operation tree tree-paths))
         (handles (vector-ref unique 0)) (paths (vector-ref unique 1))
         (count (i2-bounded-list-length handles (+ o2-max-parameters 1)))
         (aliases (parameter-tree-tie-groups tree))
         (assignments (o2-group-assignments operation parsed tree tree-paths)))
    (if (or (not count) (not (= count 14))
            (not (= count (vector-ref parsed 4)))
            (not (= count (i2-bounded-list-length assignments (+ o2-max-parameters 1)))))
        (o2-fail 'shape-mismatch operation "CPU4 optimizer must cover fourteen unique parameters"))
    (if (= (o2-tr3-create-overlap-check-internal handles) 1)
        (o2-fail 'invalid-state operation "CPU4 parameters overlap an enrolled trainer"))
    (o2-state-projection-budget! operation (vector-ref parsed 0) paths aliases handles)
    (tensor-provider-preflight-internal o2-provider-name 2 0)
    (let* ((shell (o2-make-identity "cpu4-owned-optimizer:v1"))
           (record (vector shell #f (vector-ref parsed 0) paths aliases handles)))
      ;; Handler installation can allocate. Install BEFORE rooting/publishing
      ;; a pending optimizer row, not merely before the native builder.
      (guard (caught
               (#t
                 (if (or (eq? (vector-ref row 14) 'finished) (vector-ref row 8))
                     (cpu4-binding-fail-stop 134))
                 (if (vector-ref row 14)
                     (if (not (= (o2-native-builder-abort (vector-ref row 14)) 0))
                         (cpu4-binding-fail-stop 134)))
                 (vector-set! row 14 #f)
                 (if (vector-ref row 7)
                     (cond ((and (pair? o2-optimizers) (eq? (car o2-optimizers) (vector-ref row 7)))
                            (set! o2-optimizers (cdr o2-optimizers)))
                           ((o2-member-identity? (vector-ref row 7) o2-optimizers)
                            (cpu4-binding-fail-stop 134))))
                 (vector-set! row 6 #f) (vector-set! row 7 #f)
                 (raise caught)))
        ;; Root the exact envelope first; global cons publication may promote
        ;; the list node, but its already-rooted record identity stays fixed.
        (vector-set! row 7 record)
        (let* ((canonical (vector-ref row 7))
               (next (cons canonical o2-optimizers))
               (clip (vector-ref parsed 1)) (schedule (vector-ref parsed 2)))
          (vector-set! row 6 (vector-ref canonical 0))
          (set! o2-optimizers next)
          (let capture ((remaining (vector-ref canonical 5)) (index 0))
            (if (null? remaining) #t
                (begin (vector-set! (vector-ref row 13) index (car remaining))
                       (capture (cdr remaining) (+ index 1)))))
          (let ((builder (o2-native-builder-create count (vector-ref clip 0) (vector-ref clip 1)
                            (vector-ref schedule 0) (vector-ref schedule 1)
                            (vector-ref schedule 2) (vector-ref schedule 3))))
            (if (null? builder) (o2-native-fail operation))
            (vector-set! row 14 builder)
            (let fill ((remaining (vector-ref canonical 5)) (index 0))
              (if (null? remaining)
                  (let ((native (o2-native-builder-finish builder)))
                    (if (null? native) (o2-native-fail operation))
                    ;; Native success: only pointer stores into rooted envelopes
                    ;; and a preexisting shell return. No set!, callback or alloc.
                    (vector-set! row 14 'finished)
                    (vector-set! row 8 native)
                    (vector-set! canonical 1 native)
                    (vector-set! row 14 #f)
                    (vector-ref canonical 0))
                  (let* ((handle (car remaining))
                         (assignment (o2-assignment-for-handle handle assignments)))
                    (if (not assignment)
                        (o2-fail 'shape-mismatch operation "CPU4 optimizer group omits a parameter"))
                    (let* ((group (vector-ref assignment 1))
                           (carrier (parameter-handle-tensor-internal handle))
                           (validated (i2-carrier-preflight carrier 'parameter operation)))
                      (if (not (= (o2-native-builder-set builder index (vector-ref validated 2) handle
                                    (vector-ref group 1) (vector-ref group 2) (vector-ref group 3)
                                    (vector-ref group 4) (vector-ref group 5)) 0))
                          (o2-native-fail operation))
                      (fill (cdr remaining) (+ index 1))))))))))))
(define (cpu4-owned-optimizer-create-internal! token config)
  (let* ((operation 'cpu4-owned-optimizer-create)
         (row (cpu4-owned-open token operation)))
    (if (vector-ref row 6) (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer already exists"))
    (let ((tree (module-parameters (cpu4-candidate-model-internal (vector-ref row 5)))))
      (guard (caught (#t (vector-set! row 12 #f) (raise caught)))
        (vector-set! row 12 #t)
        (let ((optimizer (cpu4-owned-o2-create! row config tree)))
          (vector-set! row 12 #f)
          optimizer)))))
(define (cpu4-owned-binding-create-internal! token)
  (let* ((operation 'cpu4-owned-binding-create)
         (row (cpu4-owned-open token operation)))
    (if (or (vector-ref row 9) (not (vector-ref row 6)))
        (cpu4-binding-fail 'invalid-state operation "CPU4 binding requires its own optimizer and no prior binding"))
    (guard (caught (#t (vector-set! row 12 #f) (raise caught)))
      (vector-set! row 12 #t)
      (let ((binding (cpu4-model-binding-create-internal
                       (cpu4-candidate-model-internal (vector-ref row 5)) (vector-ref row 4))))
        (vector-set! row 9 binding)
        (vector-set! row 12 #f)
        binding))))
(define (cpu4-owned-trainer-create-internal! token tokenizer dataset)
  (let* ((operation 'cpu4-owned-trainer-create)
         (row (cpu4-owned-open token operation)))
    (if (or (vector-ref row 10) (not (vector-ref row 9)) (not (vector-ref row 6)))
        (cpu4-binding-fail 'invalid-state operation "CPU4 trainer requires its own binding and optimizer"))
    (guard (caught (#t (vector-set! row 12 #f) (raise caught)))
      (vector-set! row 12 #t)
      (let ((trainer (cpu4-trainer-create-internal (vector-ref row 9) tokenizer dataset (vector-ref row 6))))
        (vector-set! row 10 trainer)
        (vector-set! row 12 #f)
        trainer))))

;;; Preallocate the exact cons-cell splice. Other optimizer rows retain identity.
(define (cpu4-owned-o2-unlink-plan row operation)
  (if (not (vector-ref row 6)) #f
      (let* ((registry-check (cpu4-owned-o2-registry-check operation))
             (record (o2-require-optimizer operation (vector-ref row 6))))
        (if (not (and (eq? record (vector-ref row 7))
                      (vector? record) (= (vector-length record) 6)
                      (eq? (vector-ref record 1) (vector-ref row 8))))
            (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer custody changed"))
        (let handles ((remaining (vector-ref record 5)) (index 0))
          (if (= index 14)
              (if (not (null? remaining)) (cpu4-binding-fail 'invalid-state operation "CPU4 handle count changed"))
              (if (not (and (pair? remaining)
                            (eq? (car remaining) (vector-ref (vector-ref row 13) index))))
                  (cpu4-binding-fail 'invalid-state operation "CPU4 ordered handle identity changed")
                  (handles (cdr remaining) (+ index 1)))))
        (let find ((remaining o2-optimizers) (previous #f) (plan #f))
          (cond ((null? remaining)
                 (if (not plan) (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer registry changed"))
                 ;; NULL diagnostic reaches the actual lifecycle check even
                 ;; when unrelated builders/states exist; no guard relaxation.
                 (let ((status (cpu4-owned-native-o2-preflight (vector-ref row 8) '())))
                   ;; This direct NULL-diagnostic call does not update O2's
                   ;; bridge error cell. Classify its returned status itself.
                   (if (not (= status 0))
                       (cpu4-binding-fail
                         (cond ((= status 1) 'invalid-argument)
                               ((= status 2) 'shape-mismatch)
                               ((= status 3) 'dtype-mismatch)
                               ((= status 4) 'device-mismatch)
                               ((= status 5) 'noncontiguous)
                               ((= status 6) 'unsupported)
                               ((= status 7) 'invalid-state)
                               ((= status 8) 'version-mismatch)
                               ((= status 10) 'corrupt-data)
                               ((= status 11) 'determinism-unavailable)
                               (else 'internal)) operation
                         "CPU4 native optimizer retirement preflight rejected ownership")))
                 plan)
                ((eq? (car remaining) record)
                 (if plan (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer registry repeats ownership"))
                 (find (cdr remaining) remaining (vector previous remaining (cdr remaining))))
                (else
                  (if (or (eq? (vector-ref (car remaining) 0) (vector-ref row 6))
                          (eq? (vector-ref (car remaining) 1) (vector-ref row 8)))
                      (cpu4-binding-fail 'invalid-state operation "CPU4 optimizer shell or native pointer is aliased"))
                  (find (cdr remaining) remaining plan)))))))

(define (cpu4-owned-candidate-retire-internal! token)
  (let* ((operation 'cpu4-owned-candidate-retire)
         (row (cpu4-owned-row token operation)))
    (if (eq? (vector-ref row 3) 'dead) #t
        (begin
          (if (vector-ref row 12) (cpu4-binding-fail 'invalid-state operation "CPU4 factory is busy"))
          (let ((plan (cpu4-owned-o2-unlink-plan row operation)))
            (guard (caught
                     (#t
                       (if (eq? (vector-ref row 3) 'payload-retired) (cpu4-binding-fail-stop 134))
                       (vector-set! row 12 #f) (raise caught)))
              (vector-set! row 12 #t)
              ;; This draining phase is retained on retry. Canonical payloads
              ;; remain untouched until base retirement's complete preflights.
              (if (not (vector-ref row 11))
                  (begin
                    (cond ((vector-ref row 10) (cpu4-trainer-detach-internal! (vector-ref row 10)))
                          ((vector-ref row 9) (cpu4-model-binding-release-internal! (vector-ref row 9))))
                    (vector-set! row 11 #t)))
              (cpu4-candidate-retire-owned-optimizer-internal!
                (vector-ref row 5) (if plan (vector-ref row 8) '()))
              (vector-set! row 3 'payload-retired)
              ;; Base return proves O2, P1 and C4 destruction. No dependency,
              ;; allocation, callback or failure is allowed after this frontier.
              (if plan
                  (begin
                    (if (vector-ref plan 0) (set-cdr! (vector-ref plan 0) (vector-ref plan 2))
                        (set! o2-optimizers (vector-ref plan 2)))
                    (vector-set! (vector-ref row 7) 0 #f)
                    (vector-set! (vector-ref row 7) 1 #f)
                    (vector-set! (vector-ref row 7) 2 #f)
                    (vector-set! (vector-ref row 7) 3 #f)
                    (vector-set! (vector-ref row 7) 4 #f)
                    (vector-set! (vector-ref row 7) 5 #f)
                    (vector-set! row 8 #f)))
              (vector-set! row 3 'dead)
              (vector-set! row 12 #f)
              #t))))))
