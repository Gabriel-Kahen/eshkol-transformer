;;; Issue #116 private source aggregate. Never install this trusted source.
;;; T2 supplies the accepted T1 identity universe needed by D2. I2, M3 and D2
;;; are extended exactly once in this aggregate; no registry-owning sibling is linked.
(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")

