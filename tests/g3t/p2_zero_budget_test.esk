(check "G1 regression final commit"
       (= 0 (g3t-native-frame-commit g1-regression-native)))
(check "G1 regression cache and output"
       (and (= 2 (g3t-test-cache-length g1-regression-native))
            (= 1 (g3t-test-output-state g1-regression-output))
            (= 1 (g3t-test-output-word g1-regression-output 1))
            (= 2 (g3t-test-output-word g1-regression-output 2))))
(check "G1 regression finish"
