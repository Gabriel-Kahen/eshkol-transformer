       (and (= 1 (g3t-test-input-length g1-rooted-native-input))
            (= 65 (g3t-test-input-word g1-rooted-native-input 0))
            (= (+ g1-rooted-i1-before 1) (g3t-test-i1-count 0))))
(define g1-rooted-output
  (g3t-with-final-call 'g3t-rng-g1-rooted g1-rooted-generator (call)
    (define out (g3t-output-reserve call 1))
    (g3t-frame-begin call g1-rooted-input 1)
    (rooted-roles call)
    (g3t-frame-prepare call #f)
    (g3t-frame-commit call)
    (g3t-sample call)
    (g3t-frame-begin call #f 2)
    (rooted-roles call)
    (g3t-output-prepare call out)
    (g3t-t1-decode-output! call out)
    (g3t-final-commit! call out)))
(define g1-text-entry
  (g3t-prefill-entry g1-rooted-output 'output 'g3t-g1-text))
(define g1-text-registry-head (vector-ref g3t-registry 0))
(define g1-text-first (g3t-generation-output-text g1-rooted-output))
(define g1-text-second (g3t-generation-output-text g1-rooted-output))
(define g1-text-first-bytes (car g1-text-first))
(define g1-text-second-bytes (car g1-text-second))
(check "P1/G1 text results are exact detached emitted bytes"
       (and (pair? g1-text-first) (null? (cdr g1-text-first))
            (pair? g1-text-second) (null? (cdr g1-text-second))
            (not (eq? g1-text-first g1-text-second))
            (not (eq? g1-text-first-bytes g1-text-second-bytes))
            (not (eq? g1-text-first-bytes (vector-ref g1-text-entry 6)))
            (= 1 (bytevector-length g1-text-first-bytes))
            (= 1 (bytevector-length g1-text-second-bytes))
            (= g1-id (bytevector-u8-ref g1-text-first-bytes 0))
            (= g1-id (bytevector-u8-ref g1-text-second-bytes 0))
            (eq? g1-text-registry-head (vector-ref g3t-registry 0))))
(bytevector-u8-set! g1-text-first-bytes 0 (modulo (+ g1-id 1) 256))
(set-car! g1-text-first #f)
(check "P1/G1 text mutations leave source and next result unchanged"
       (and (= g1-id (bytevector-u8-ref (vector-ref g1-text-entry 6) 0))
            (= g1-id (bytevector-u8-ref g1-text-second-bytes 0))
            (= g1-id (bytevector-u8-ref
                       (car (g3t-generation-output-text g1-rooted-output)) 0))
            (eq? g1-text-registry-head (vector-ref g3t-registry 0))))
