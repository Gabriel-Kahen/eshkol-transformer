;;; Test-only inert tensor carrier for P1 structural control-flow evidence.
;;; This module is available only through the explicit tests/p1/providers root.

(require transformer.module)
(require transformer.error_internal)

(provide module-create-fixture-internal
         fixture-tensor-internal fixture-tensor-unsafe-internal
         fixture-owned-tensor-internal
         fixture-owned-shared-tensor-internal
         fixture-storage-alias-wrapper-internal
         fixture-foreign-provider-tensor-internal
         fixture-tensor-shared-clone-internal
         fixture-reset-shared-clone-internal!
         fixture-owned-live-count-internal
         fixture-describe-call-count-internal
         fixture-storage-identical-call-count-internal
         fixture-release-call-count-internal
         fixture-storage-comparison-call-count-internal
         fixture-shared-clone-payload-internal
         fixture-storage-identical-request-internal
         fixture-publication-overwrite-attempt-count-internal
         fixture-arm-cross-publication-internal!
         fixture-arm-clone-defect-internal!
         fixture-arm-storage-comparison-defect-internal!
         fixture-arm-storage-comparison-reentrant-state-release-internal!
         fixture-arm-storage-comparison-reentrant-registration-internal!
         fixture-arm-ordinary-comparison-reentrant-state-release-internal!
         fixture-arm-ordinary-comparison-reentrant-registration-internal!
         fixture-fail-next-release-internal!
         fixture-raise-false-next-release-internal!
         fixture-malform-next-release-internal!
         fixture-arm-reentrant-state-release-internal!
         fixture-arm-reentrant-borrow-end-internal!
         fixture-tensor-payload-internal
         fixture-register-substituting-provider-internal!
         fixture-register-raising-provider-internal!
         fixture-register-reentrant-provider-internal!
         fixture-register-self-reentrant-provider-internal!
         fixture-register-malformed-status-provider-internal!
         fixture-register-reentrant-target-provider-internal!
         fixture-register-collision-provider-internal!
         fixture-register-cyclic-evidence-provider-internal!
         fixture-register-overlimit-evidence-provider-internal!
         fixture-register-improper-evidence-provider-internal!
         fixture-register-repeat-mutating-provider-internal!
         fixture-register-storage-raise-provider-internal!
         fixture-register-storage-raise-false-provider-internal!
         fixture-register-storage-mutation-provider-internal!
         fixture-register-storage-asymmetric-provider-internal!
         fixture-register-storage-unstable-provider-internal!
         fixture-register-storage-nonreflexive-provider-internal!)

(define fixture-tensor-tag (vector 'p1-test-fixture-tensor))
(define fixture-plan-tag (vector 'p1-test-fixture-load-plan))
(define fixture-provider-name 'fixture-v1)
(define row-major-layout 'dense-row-major-contiguous)
(define fixture-shared-clone-payload #f)
(define fixture-exact-clone #f)
(define fixture-owned-live-count 0)
(define fixture-describe-call-count 0)
(define fixture-storage-identical-call-count 0)
(define fixture-release-call-count 0)
(define fixture-storage-comparison-call-count 0)
(define fixture-publication-overwrite-attempt-count 0)
(define fixture-cross-publication-carrier #f)
(define fixture-clone-defect #f)
(define fixture-storage-comparison-defect #f)
(define fixture-storage-comparison-release-state #f)
(define fixture-storage-comparison-registration #f)
(define fixture-ordinary-comparison-release #f)
(define fixture-ordinary-comparison-registration #f)
(define fixture-release-defect #f)
(define fixture-reentrant-release-state #f)
(define fixture-reentrant-borrow #f)
(define fixture-max-shape-rank 64)
(define fixture-max-data-depth 16)
(define fixture-max-data-nodes 4096)

(define (fixture-fail category operation message)
  (transformer-error-raise category operation message '() #f))

(define (fixture-identity-member? value values)
  (cond
    ((null? values) #f)
    ((eq? value (car values)) #t)
    (else (fixture-identity-member? value (cdr values)))))

(define (fixture-bounded-list-length values limit)
  (let loop ((remaining values) (seen '()) (count 0))
    (cond
      ((null? remaining) count)
      ((not (pair? remaining)) #f)
      ((>= count limit) #f)
      ((fixture-identity-member? remaining seen) #f)
      (else (loop (cdr remaining) (cons remaining seen) (+ count 1))))))

(define (copy-data value)
  (let ((seen '()) (nodes 0))
    (define (walk item depth)
      (set! nodes (+ nodes 1))
      (let ((composite (if (or (pair? item) (vector? item)) item #f)))
        (if (or (> depth fixture-max-data-depth)
                (> nodes fixture-max-data-nodes)
                (and composite
                     (fixture-identity-member? composite seen)))
            (fixture-fail
              'invalid-argument 'p1-test-fixture-copy
              "fixture data contains a cycle, shared composite, or exceeds bounds")
            (if composite (set! seen (cons composite seen)) #t)))
      (cond
        ((pair? item) (cons (walk (car item) (+ depth 1))
                            (walk (cdr item) depth)))
        ((vector? item)
         (let* ((size (vector-length item))
                (result (make-vector size #f)))
           (let loop ((index 0))
             (if (= index size)
                 result
                 (begin
                   (vector-set! result index
                                (walk (vector-ref item index) (+ depth 1)))
                   (loop (+ index 1)))))))
        ((string? item) (string-copy item))
        (else item)))
    (walk value 0)))

(define (valid-shape? shape)
  (and (fixture-bounded-list-length shape fixture-max-shape-rank)
       (let loop ((dimensions shape))
         (if (null? dimensions)
             #t
             (and (integer? (car dimensions)) (exact? (car dimensions))
                  (>= (car dimensions) 0) (loop (cdr dimensions)))))))

(define (valid-payload? payload)
  (and (vector? payload)
       (let loop ((index 0))
         (if (= index (vector-length payload))
             #t
             (let ((value (vector-ref payload index)))
               (and (or (symbol? value) (boolean? value)
                        (and (integer? value) (exact? value)))
                    (loop (+ index 1))))))))

(define (fixture-tensor? value)
  (and (vector? value) (= (vector-length value) 8)
       (eq? (vector-ref value 0) fixture-tensor-tag)))

(define (fixture-owned-live-count-internal) fixture-owned-live-count)
(define (fixture-describe-call-count-internal) fixture-describe-call-count)
(define (fixture-storage-identical-call-count-internal)
  fixture-storage-identical-call-count)
(define (fixture-release-call-count-internal) fixture-release-call-count)
(define (fixture-storage-comparison-call-count-internal)
  fixture-storage-comparison-call-count)
(define (fixture-publication-overwrite-attempt-count-internal)
  fixture-publication-overwrite-attempt-count)

(define (fixture-arm-clone-defect-internal! skip mode)
  (set! fixture-clone-defect (vector skip mode))
  #t)

(define (fixture-arm-storage-comparison-defect-internal! mode)
  (set! fixture-storage-comparison-defect mode)
  #t)

(define (fixture-arm-storage-comparison-reentrant-state-release-internal! state)
  (set! fixture-storage-comparison-release-state state)
  #t)

(define (fixture-arm-storage-comparison-reentrant-registration-internal!
          mode module tensor)
  (set! fixture-storage-comparison-registration (vector mode module tensor))
  #t)

(define (fixture-arm-ordinary-comparison-reentrant-state-release-internal!
          source state)
  ;; The source identity distinguishes the normal clone/source comparison
  ;; from earlier protected scans, whose left side is the published clone.
  (set! fixture-ordinary-comparison-release (vector source state))
  #t)

(define (fixture-arm-ordinary-comparison-reentrant-registration-internal!
          source mode module)
  (set! fixture-ordinary-comparison-registration
        (vector source mode module))
  #t)

(define (fixture-arm-cross-publication-internal! carrier)
  (set! fixture-cross-publication-carrier carrier)
  #t)

(define (fixture-fail-next-release-internal!)
  (set! fixture-release-defect 'raise)
  #t)

(define (fixture-raise-false-next-release-internal!)
  (set! fixture-release-defect 'raise-false)
  #t)

(define (fixture-malform-next-release-internal!)
  (set! fixture-release-defect 'malformed-ack)
  #t)

(define (fixture-arm-reentrant-state-release-internal! state)
  (set! fixture-reentrant-release-state state)
  #t)

(define (fixture-arm-reentrant-borrow-end-internal! state handle)
  (set! fixture-reentrant-borrow (vector state handle))
  #t)

(define (fixture-tensor-unsafe-internal shape dtype device contiguous? payload
                                        fail-copy?)
  (vector fixture-tensor-tag (copy-data shape) dtype (copy-data device) contiguous?
          (copy-data payload) fail-copy? 'test-only))

(define (fixture-describe (request : vector)) : vector
  (set! fixture-describe-call-count (+ fixture-describe-call-count 1))
  (let ((tensor (vector-ref request 0))
        (kind (vector-ref request 1))
        (operation (vector-ref request 2)))
    (if fixture-reentrant-borrow
        (let ((attempt fixture-reentrant-borrow))
          (set! fixture-reentrant-borrow #f)
          (guard (caught (#t caught))
            (state-dict-tensor-borrow-end-internal
              (vector-ref attempt 0) (vector-ref attempt 1)))
          ;; Release must still observe the opening-phase access token.
          (state-dict-release! (vector-ref attempt 0)))
        #t)
    (if fixture-reentrant-release-state
        (let ((state fixture-reentrant-release-state))
          (set! fixture-reentrant-release-state #f)
          (state-dict-release! state))
        #t)
    (if (not (fixture-tensor? tensor))
        (fixture-fail 'unsupported operation "test carrier does not own tensor")
        (if (not (valid-shape? (vector-ref tensor 1)))
            (fixture-fail 'corrupt-data operation "malformed test tensor shape")
            (if (not (symbol? (vector-ref tensor 2)))
                (fixture-fail 'corrupt-data operation "malformed test tensor dtype")
                (if (not (or (symbol? (vector-ref tensor 3))
                             (vector? (vector-ref tensor 3))))
                    (fixture-fail 'corrupt-data operation
                                  "malformed test tensor device")
                    (if (not (boolean? (vector-ref tensor 4)))
                        (fixture-fail 'corrupt-data operation
                                      "malformed test tensor layout")
                        (if (not (vector-ref tensor 4))
                            (fixture-fail 'noncontiguous operation
                                          "test tensor is noncontiguous")
                            (if (not (valid-payload? (vector-ref tensor 5)))
                                (fixture-fail 'corrupt-data operation
                                              "malformed test tensor payload")
                                (if (not (or (boolean? (vector-ref tensor 6))
                                             (eq? (vector-ref tensor 6)
                                                  'share-clone)
                                             (eq? (vector-ref tensor 6)
                                                  'publish-then-raise)
                                             (eq? (vector-ref tensor 6)
                                                  'exact-republish)
                                             (eq? (vector-ref tensor 6)
                                                  'return-source)
                                             (eq? (vector-ref tensor 6)
                                                  'cross-publication)
                                             (eq? (vector-ref tensor 6)
                                                  'return-request)
                                             (eq? (vector-ref tensor 6)
                                                  'storage-alias-republish)
                                             (eq? (vector-ref tensor 6)
                                                  'publish-forged)))
                                    (fixture-fail 'corrupt-data operation
                                                  "malformed test failure flag")
                                    (if (not (or
                                               (eq? (vector-ref tensor 7)
                                                    'test-only)
                                               (eq? (vector-ref tensor 7)
                                                    'owned-test-only)
                                               (eq? (vector-ref tensor 7)
                                                    'protected-alias-test-only)))
                                        (fixture-fail 'corrupt-data operation
                                                      "malformed test tensor marker")
                                        (vector
                                          (copy-data (vector-ref tensor 1))
                                          (vector-ref tensor 2)
                                          (vector-ref tensor 3)
                                          row-major-layout))))))))))))

(define (fixture-tensor-internal shape dtype device payload)
  (let ((tensor
          (fixture-tensor-unsafe-internal shape dtype device #t payload #f)))
    (fixture-describe (vector tensor 'buffer 'fixture-tensor-internal))
    tensor))

(define (fixture-owned-tensor-internal shape dtype device payload)
  (let ((tensor
          (fixture-tensor-unsafe-internal shape dtype device #t payload #f)))
    (fixture-describe (vector tensor 'buffer 'fixture-owned-tensor-internal))
    (vector-set! tensor 7 'owned-test-only)
    (set! fixture-owned-live-count (+ fixture-owned-live-count 1))
    tensor))

(define (fixture-tensor-shared-clone-internal shape dtype device payload)
  (if fixture-shared-clone-payload
      #t
      (set! fixture-shared-clone-payload (copy-data payload)))
  (vector fixture-tensor-tag (copy-data shape) dtype (copy-data device) #t
          fixture-shared-clone-payload 'share-clone 'test-only))

(define (fixture-owned-shared-tensor-internal shape dtype device payload)
  (if fixture-shared-clone-payload
      #t
      (set! fixture-shared-clone-payload (copy-data payload)))
  (let ((tensor
          (vector fixture-tensor-tag (copy-data shape) dtype (copy-data device)
                  #t fixture-shared-clone-payload 'share-clone
                  'owned-test-only)))
    (set! fixture-owned-live-count (+ fixture-owned-live-count 1))
    tensor))

(define (fixture-storage-alias-wrapper-internal tensor)
  ;; Malicious trusted-boundary fixture: a fresh carrier wrapper over the
  ;; exact payload allocation retained by another owner. It is deliberately
  ;; not counted as an owner. If rollback ever calls release-owned! on it, the
  ;; callback below visibly poisons the protected allocation before raising.
  (fixture-describe
    (vector tensor 'buffer 'fixture-storage-alias-wrapper-internal))
  (vector fixture-tensor-tag
          (copy-data (vector-ref tensor 1))
          (vector-ref tensor 2)
          (copy-data (vector-ref tensor 3))
          (vector-ref tensor 4)
          (vector-ref tensor 5)
          #f 'protected-alias-test-only))

(define (fixture-foreign-provider-tensor-internal shape dtype device payload)
  ;; A detached carrier from a different hypothetical provider domain. The
  ;; fixture-v1 metadata callback must reject it before storage comparison or
  ;; release authority is possible.
  (vector (vector 'p1-test-foreign-provider-tensor)
          (copy-data shape) dtype (copy-data device) #t
          (copy-data payload) #f 'foreign-provider-test-only))

(define (fixture-reset-shared-clone-internal!)
  (set! fixture-shared-clone-payload #f)
  (set! fixture-exact-clone #f))

(define (fixture-shared-clone-payload-internal)
  (if fixture-shared-clone-payload
      (copy-data fixture-shared-clone-payload)
      #f))

(define (fixture-tensor-payload-internal tensor)
  (fixture-describe (vector tensor 'buffer 'fixture-tensor-payload-internal))
  (copy-data (vector-ref tensor 5)))

(define (fixture-publish-clone-once! request published operation)
  ;; The publication cell is the ownership-transfer boundary. The fixture uses
  ;; this helper for every owned clone so its integrating evidence can prove an
  ;; attempted second write raises before the first owner becomes unreachable.
  (if (vector-ref request 3)
      (begin
        (set! fixture-publication-overwrite-attempt-count
              (+ fixture-publication-overwrite-attempt-count 1))
        (fixture-fail 'internal operation
                      "fixture clone publication overwrite rejected"))
      (begin
        (vector-set! request 3 published)
        request)))

(define (fixture-clone (request : vector)) : vector
  (fixture-describe request)
  (let ((tensor (vector-ref request 0))
        (operation (vector-ref request 2)))
    (if (and fixture-clone-defect
             (= (vector-ref fixture-clone-defect 0) 0))
        (let ((mode (vector-ref fixture-clone-defect 1)))
          (set! fixture-clone-defect #f)
          (if (or (eq? mode 'publish-then-raise)
                  (eq? mode 'publish-then-raise-false)
                  (eq? mode 'publish-then-substitute)
                  (eq? mode 'publish-then-overwrite-attempt))
              (let ((published
                      (fixture-owned-tensor-internal
                        (vector-ref tensor 1) (vector-ref tensor 2)
                        (vector-ref tensor 3) (vector-ref tensor 5))))
                (fixture-publish-clone-once! request published operation)
                (cond
                  ((eq? mode 'publish-then-raise-false) (raise #f))
                  ((eq? mode 'publish-then-substitute) (vector))
                  ((eq? mode 'publish-then-overwrite-attempt)
                   (fixture-publish-clone-once! request published operation))
                  (else
                   (fixture-fail
                     'internal operation
                     "injected armed post-publication clone defect"))))
              (fixture-fail 'internal operation
                            "injected armed clone defect")))
        (begin
          (if fixture-clone-defect
              (vector-set! fixture-clone-defect 0
                           (- (vector-ref fixture-clone-defect 0) 1))
              #t)
    (if (eq? (vector-ref tensor 6) #t)
        (fixture-fail 'unsupported operation "injected test clone failure")
        (begin
          (cond
            ((eq? (vector-ref tensor 6) 'return-source)
             (vector-set! request 3 tensor))
            ((eq? (vector-ref tensor 6) 'return-request)
             (vector-set! request 3 request))
            ((eq? (vector-ref tensor 6) 'cross-publication)
             (let ((published fixture-cross-publication-carrier))
               (set! fixture-cross-publication-carrier #f)
               (vector-set! request 3 published)))
            ((eq? (vector-ref tensor 6) 'publish-forged)
             (vector-set! request 3 (vector 'forged-provider-carrier)))
            ((and (eq? (vector-ref tensor 6) 'exact-republish)
                  fixture-exact-clone)
             (vector-set! request 3 fixture-exact-clone))
            (else
              (let ((copy
                      (if (and
                            (eq? (vector-ref tensor 6)
                                 'storage-alias-republish)
                            fixture-exact-clone)
                          (fixture-storage-alias-wrapper-internal
                            fixture-exact-clone)
                          (if (or
                                (eq? (vector-ref tensor 6) 'share-clone)
                                (eq? (vector-ref tensor 6)
                                     'storage-alias-republish))
                          (begin
                            (if fixture-shared-clone-payload
                                #t
                                (set! fixture-shared-clone-payload
                                      (copy-data (vector-ref tensor 5))))
                            (vector fixture-tensor-tag
                                    (copy-data (vector-ref tensor 1))
                                    (vector-ref tensor 2)
                                    (copy-data (vector-ref tensor 3)) #t
                                    fixture-shared-clone-payload 'share-clone
                                    'owned-test-only))
                          (let ((fresh
                                  (fixture-tensor-unsafe-internal
                                    (vector-ref tensor 1) (vector-ref tensor 2)
                                    (vector-ref tensor 3) (vector-ref tensor 4)
                                    (vector-ref tensor 5) #f)))
                            (vector-set! fresh 7 'owned-test-only)
                            fresh)))))
                (if (or (eq? (vector-ref tensor 6) 'exact-republish)
                        (and
                          (eq? (vector-ref tensor 6)
                               'storage-alias-republish)
                          (not fixture-exact-clone)))
                    (set! fixture-exact-clone copy)
                    #t)
                (fixture-publish-clone-once! request copy operation)
                ;; The alias wrapper is not a second owner. The first clone
                ;; remains the sole destructive owner of its shared payload.
                (if (eq? (vector-ref copy 7) 'owned-test-only)
                    (set! fixture-owned-live-count
                          (+ fixture-owned-live-count 1))
                    #t))))
          (if (eq? (vector-ref tensor 6) 'publish-then-raise)
              (fixture-fail 'internal operation
                            "injected post-publication clone defect")
              request)))))))

(define (fixture-release-owned! (request : vector)) : vector
  (set! fixture-release-call-count (+ fixture-release-call-count 1))
  (let ((tensor (vector-ref request 0)))
    ;; The successful release path performs only bounded reads/writes. In
    ;; particular it does not construct a describe request during cleanup.
    (if (or (not (fixture-tensor? tensor))
            (not (or (eq? (vector-ref request 1) 'parameter)
                     (eq? (vector-ref request 1) 'buffer)))
            (not (symbol? (vector-ref request 2))))
        (fixture-fail 'internal (vector-ref request 2)
                      "malformed test owned tensor release request")
        (if (eq? (vector-ref tensor 7) 'protected-alias-test-only)
            (begin
              (if (> (vector-length (vector-ref tensor 5)) 0)
                  (vector-set! (vector-ref tensor 5) 0
                               'destroyed-protected-storage)
                  #t)
              (fixture-fail
                'internal (vector-ref request 2)
                "protected alias reached destructive release callback"))
        (if (not (eq? (vector-ref tensor 7) 'owned-test-only))
        (fixture-fail 'internal (vector-ref request 2)
                      "test owned tensor was released more than once")
        (begin
          (vector-set! tensor 7 'released-test-only)
          (set! fixture-owned-live-count (- fixture-owned-live-count 1))
          (if fixture-release-defect
              (begin
                (let ((defect fixture-release-defect))
                  (set! fixture-release-defect #f)
                  (cond
                    ((eq? defect 'raise)
                     (fixture-fail 'internal (vector-ref request 2)
                                   "injected post-release callback defect"))
                    ((eq? defect 'raise-false) (raise #f))
                    (else
                      (vector-set! request 3 'malformed-ack)
                      request))))
              (begin
                (vector-set! request 3 #t)
                request))))))))

(define (fixture-storage-identical? (request : vector)) : boolean
  (set! fixture-storage-comparison-call-count
        (+ fixture-storage-comparison-call-count 1))
  ;; The valid path performs only bounded reads. It allocates no request or
  ;; result object, mutates/retains no carrier or request field, invokes no
  ;; nested callback/native seam, and cannot raise after these shape checks.
  (set! fixture-storage-identical-call-count
        (+ fixture-storage-identical-call-count 1))
  (if (not (= (vector-length request) 5))
      (fixture-fail 'invalid-argument 'fixture-storage-identical?
                    "malformed fixture storage comparison request")
      (let ((left (vector-ref request 0))
            (right (vector-ref request 1))
            (left-kind (vector-ref request 2))
            (right-kind (vector-ref request 3))
            (operation (vector-ref request 4)))
        (if (not (and (fixture-tensor? left) (fixture-tensor? right)
                      (or (eq? left-kind 'parameter)
                          (eq? left-kind 'buffer))
                      (or (eq? right-kind 'parameter)
                          (eq? right-kind 'buffer))
                      (symbol? operation)))
            (fixture-fail 'invalid-argument 'fixture-storage-identical?
                          "invalid fixture storage comparison input")
            (begin
              (if fixture-storage-comparison-release-state
                  (let ((state fixture-storage-comparison-release-state))
                    ;; Clear the one-shot arm before the malicious nested call.
                    ;; A correct P1 boundary rejects release while this
                    ;; protected comparison is active.
                    (set! fixture-storage-comparison-release-state #f)
                    (state-dict-release! state))
                  #t)
              (if fixture-storage-comparison-registration
                  (let ((attack fixture-storage-comparison-registration))
                    (set! fixture-storage-comparison-registration #f)
                    (if (eq? (vector-ref attack 0) 'parameter)
                        (module-register-parameter-internal!
                          (vector-ref attack 1) "comparator-attack"
                          (vector-ref attack 2))
                        (module-register-buffer-internal!
                          (vector-ref attack 1) "comparator-attack"
                          (vector-ref attack 2))))
                  #t)
              (if (and fixture-ordinary-comparison-release
                       (eq? left
                            (vector-ref fixture-ordinary-comparison-release 0)))
                  (let ((state
                          (vector-ref fixture-ordinary-comparison-release 1)))
                    (set! fixture-ordinary-comparison-release #f)
                    (state-dict-release! state))
                  #t)
              (if (and fixture-ordinary-comparison-registration
                       (eq? left
                            (vector-ref
                              fixture-ordinary-comparison-registration 0)))
                  (let ((attack fixture-ordinary-comparison-registration))
                    (set! fixture-ordinary-comparison-registration #f)
                    ;; `right` is the newly published, independently owned
                    ;; clone on the normal clone/source comparison path.
                    (if (eq? (vector-ref attack 1) 'parameter)
                        (module-register-parameter-internal!
                          (vector-ref attack 2) "ordinary-comparator-attack"
                          right)
                        (module-register-buffer-internal!
                          (vector-ref attack 2) "ordinary-comparator-attack"
                          right)))
                  #t)
              (if fixture-storage-comparison-defect
                  (let ((defect fixture-storage-comparison-defect))
                    (set! fixture-storage-comparison-defect #f)
                    (if (eq? defect 'raise-false)
                        (raise #f)
                        (fixture-fail
                          'internal operation
                          "injected storage comparison defect")))
                  (eq? (vector-ref left 5) (vector-ref right 5))))))))

(define (fixture-storage-identical-request-internal
          (request : vector)) : boolean
  ;; Test-only direct access to the provider callback. Callers can preallocate
  ;; and reuse the request to prove the callback itself has no allocation or
  ;; retention role.
  (fixture-storage-identical? request))

(define (fixture-storage-raise (request : vector)) : boolean
  (fixture-fail 'internal 'fixture-storage-raise
                "injected storage comparator defect")
  #f)

(define (fixture-storage-raise-false (request : vector)) : boolean
  (raise #f)
  #f)

(define (fixture-storage-mutate-request (request : vector)) : boolean
  (let ((result (fixture-storage-identical? request)))
    (vector-set! request 4 'mutated-storage-comparison-operation)
    result))

(define (fixture-storage-asymmetric (request : vector)) : boolean
  (let ((left (vector-ref request 0))
        (right (vector-ref request 1)))
    (if (eq? left right)
        #t
        (let ((payload (vector-ref left 5)))
          (and (> (vector-length payload) 0)
               (eq? (vector-ref payload 0)
                    'admission-destination-a))))))

(define fixture-storage-unstable-value #f)

(define (fixture-storage-unstable (request : vector)) : boolean
  (set! fixture-storage-unstable-value
        (not fixture-storage-unstable-value))
  fixture-storage-unstable-value)

(define (fixture-storage-nonreflexive (request : vector)) : boolean #f)

(define (fixture-value-equal? (request : vector)) : boolean
  (let ((left (vector-ref request 0))
        (right (vector-ref request 1))
        (kind (vector-ref request 2))
        (operation (vector-ref request 3)))
    (fixture-describe (vector left kind operation))
    (fixture-describe (vector right kind operation))
    (and (equal? (vector-ref left 1) (vector-ref right 1))
         (eq? (vector-ref left 2) (vector-ref right 2))
         (equal? (vector-ref left 3) (vector-ref right 3))
         (eq? (vector-ref left 4) (vector-ref right 4))
         (equal? (vector-ref left 5) (vector-ref right 5)))))

(define (metadata-compatible! operation destination source kind)
  (let ((left (fixture-describe (vector destination kind operation)))
        (right (fixture-describe (vector source kind operation))))
    (if (not (equal? (vector-ref left 0) (vector-ref right 0)))
        (fixture-fail 'shape-mismatch operation "test load shape mismatch")
        (if (not (eq? (vector-ref left 1) (vector-ref right 1)))
            (fixture-fail 'dtype-mismatch operation "test load dtype mismatch")
            (if (not (equal? (vector-ref left 2) (vector-ref right 2)))
                (fixture-fail 'device-mismatch operation "test load device mismatch")
                #t)))))

(define (fixture-device-equal? (request : vector)) : boolean
  (equal? (vector-ref request 0) (vector-ref request 1)))

(define (fixture-prepare-load-abort plan caught)
  (fixture-release-plan! plan)
  (raise caught)
  :no-return)

(define (fixture-prepare-load-guarded request)
  (let ((assignments (vector-ref request 0))
        (operation (vector-ref request 1))
        (plan (vector fixture-plan-tag #f '())))
    (guard (caught
             (#t
               (fixture-prepare-load-abort plan caught)))
      (let loop ((remaining assignments))
        (if (null? remaining)
            (vector plan)
            (let* ((assignment (car remaining))
                   (destination (vector-ref assignment 0))
                   (source (vector-ref assignment 1))
                   (kind (vector-ref assignment 2)))
              (metadata-compatible! operation destination source kind)
              (if (not (= (vector-length (vector-ref destination 5))
                          (vector-length (vector-ref source 5))))
                  (fixture-fail 'unsupported operation
                                "test copy requires equal payload storage")
                  (let* ((clone-request (vector source kind operation #f))
                         (release-envelope (vector #f kind operation #f))
                         (update (vector destination #f release-envelope))
                         (ledger-cell (cons update (vector-ref plan 2))))
                    ;; Every cleanup object exists before fixture-clone can
                    ;; publish an owned scratch carrier.
                    (vector-set! plan 2 ledger-cell)
                    (guard (caught
                             (#t
                               (let ((published (vector-ref clone-request 3)))
                                 (if published
                                     (begin
                                       (vector-set! update 1 published)
                                       (vector-set! release-envelope 0 published))
                                     #t))
                               (raise caught)))
                      (fixture-clone clone-request)
                      (let ((published (vector-ref clone-request 3)))
                        (vector-set! update 1 published)
                        (vector-set! release-envelope 0 published)
                        (loop (cdr remaining))))))))))))

(define (fixture-prepare-load (request : vector)) : vector
  (let ((result (fixture-prepare-load-guarded request)))
    (if (vector? result)
        result
        (fixture-fail 'internal 'fixture-prepare-load
                      "test prepare-load returned a non-vector"))))

(define (copy-payload-into! destination source)
  (let ((target (vector-ref destination 5))
        (prepared (vector-ref source 5)))
    (let loop ((index 0))
      (if (= index (vector-length target))
          #t
          (begin
            (vector-set! target index (vector-ref prepared index))
            (loop (+ index 1)))))))

(define (fixture-release-plan! plan)
  (let ((updates (vector-ref plan 2)))
    (vector-set! plan 2 '())
    (let loop ((remaining updates) (first-error #f))
      (if (null? remaining)
          (if first-error (raise first-error) #t)
          (let* ((update (car remaining))
                 (release-envelope (vector-ref update 2)))
            (vector-set! update 1 #f)
            (if (vector-ref release-envelope 0)
                (guard (caught
                         (#t
                           (vector-set! release-envelope 0 #f)
                           (loop (cdr remaining)
                                 (if first-error first-error caught))))
                  (fixture-release-owned! release-envelope)
                  (vector-set! release-envelope 0 #f)
                  (loop (cdr remaining) first-error))
                (loop (cdr remaining) first-error)))))))

(define (fixture-commit-load! (plan : vector)) : vector
  (if (or (not (= (vector-length plan) 3))
          (not (eq? (vector-ref plan 0) fixture-plan-tag))
          (vector-ref plan 1))
      (fixture-fail 'internal 'module-load-state-dict!
                    "invalid or consumed test load plan")
      (begin
        (vector-set! plan 1 #t)
        (let loop ((updates (vector-ref plan 2)))
          (if (null? updates)
              (fixture-release-plan! plan)
              (begin
                (copy-payload-into! (vector-ref (car updates) 0)
                                    (vector-ref (car updates) 1))
                (loop (cdr updates)))))
        plan)))

(define fixture-provider
  (tensor-provider-create-internal
    fixture-provider-name fixture-describe fixture-clone
    fixture-storage-identical? fixture-value-equal?
    fixture-device-equal? fixture-prepare-load fixture-commit-load!
    fixture-release-owned!))

(define (poison-vector (request : vector)) : vector
  (fixture-fail 'internal 'poison-provider "poison provider callback selected")
  (vector))

(define (poison-boolean (request : vector)) : boolean
  (fixture-fail 'internal 'poison-provider "poison provider callback selected")
  #f)

(define poison-access-provider
  (tensor-provider-create-internal
    'poison-access-v1 poison-vector poison-vector poison-boolean poison-boolean
    poison-boolean fixture-prepare-load fixture-commit-load! poison-vector))

(define alternate-provider
  (tensor-provider-create-internal
    'alternate-v1 fixture-describe fixture-clone
    fixture-storage-identical? fixture-value-equal?
    fixture-device-equal? fixture-prepare-load fixture-commit-load!
    fixture-release-owned!))

(define collision-provider
  (tensor-provider-create-internal
