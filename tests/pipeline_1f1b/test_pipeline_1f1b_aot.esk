;;; Compiled Eshkol AOT driver for the 1F1B Pipeline Parallelism Engine:
;;;   - Real multi-process P=2 and P=4 (M=8) 1F1B & GPipe execution over AF_UNIX
;;;   - Exact forward loss + parameter gradient parity (<= 1e-6) vs P=1 reference
;;;   - Measured runtime 1F1B peak live activation slots (<= P) vs GPipe (M)
;;;   - 10-step SGD training strictly decreasing loss identically across P=1,2,4
;;;   - Central finite-difference gradient checks on RMSNorm + SwiGLU layer
;;;   - Negative rejections: M < P, invalid P, non-finite weights/activations,
;;;     mismatched microbatch ID, peer disconnect, monotonic timeout, wire NaN

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)

(extern i64 pp-param-count i64 i64 i64 i64 :real et_pp_aot_param_count)
(extern i32 pp-build-schedule i64 i64 i64 i64 ptr ptr :real et_pp_aot_build_schedule)
(extern i32 pp-layer-forward i64 i64 i64 f64 ptr ptr ptr :real et_pp_aot_layer_forward)
(extern i32 pp-layer-backward i64 i64 i64 f64 ptr ptr ptr ptr ptr :real et_pp_aot_layer_backward)
(extern i32 pp-run-reference
        i64 i64 i64 i64 i64 i64 i64 f64 ptr ptr ptr ptr ptr
        :real et_pp_aot_run_reference_step)
(extern i32 pp-run-multiprocess
        i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 f64 ptr ptr ptr ptr ptr ptr
        :real et_pp_aot_run_multiprocess_step)
(extern i32 pp-train-reference-sgd
        i64 i64 i64 i64 i64 i64 i64 i64 f64 f64 ptr ptr ptr ptr ptr
        :real et_pp_aot_train_reference_sgd)
(extern i32 pp-train-multiprocess-sgd
        i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 f64 f64 ptr ptr ptr ptr ptr ptr
        :real et_pp_aot_train_multiprocess_sgd)
(extern i32 pp-probe-transport i64 i64 :real et_pp_aot_probe_transport_error)

(extern void store-f64 ptr i64 f64 :real et_pp_aot_store_f64)
(extern f64 load-f64 ptr i64 :real et_pp_aot_load_f64)
(extern void store-i32 ptr i64 i64 :real et_pp_aot_store_i32)
(extern i64 load-i64 ptr i64 :real et_pp_aot_load_i64)
(extern f64 make-nonfinite i64 :real et_pp_aot_make_nonfinite)

(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

;; Status codes from pipeline_1f1b_abi.h
(define status-ok 0)
(define err-invalid-stages -2)
(define err-invalid-mb -3)
(define err-nonfinite -5)
(define err-protocol -6)
(define err-timeout -7)
(define err-peer-disconnected -8)

;; Schedules & loss types
(define sched-1f1b 0)
(define sched-gpipe 1)
(define loss-ce 0)
(define loss-mse 1)

;; Shared model dimensions (4 total layers: P=1x4, P=2x2, P=4x1)
(define total-layers 4)
(define num-mb 8)
(define tok-per-mb 3)
(define d-model 8)
(define d-ff 16)
(define out-dim 6)
(define rms-eps 1.0e-5)
(define timeout-ms 5000)

(define (require-check label ok)
  (unless ok
    (display "PP1F1B AOT FAIL: ") (display label) (newline) (exit 1)))

(define (expect-status label expected actual)
  (unless (= actual expected)
    (display "PP1F1B AOT FAIL: ") (display label)
    (display " expected=") (display expected)
    (display " actual=") (display actual) (newline) (exit 1)))

(define (checked-allocate bytes)
  (let ((p (allocate bytes)))
    (require-check "allocation failed" (not (= (ptr->usize p) 0)))
    p))

(define (det-val idx salt scale)
  (let ((bucket (- (modulo (+ (* 37 salt) (* 19 idx) (quotient idx 5)) 41) 20)))
    (* (* 0.05 bucket) scale)))

(define (fill-inputs buf count salt)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (store-f64 (ffi-pointer buf) i (det-val i salt 0.8))))

(define (fill-targets-ce buf count salt)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (store-i32 (ffi-pointer buf) i (modulo (+ (* 7 i) (* 3 salt) 1) out-dim))))

(define (fill-targets-mse buf count salt)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (store-f64 (ffi-pointer buf) i (det-val i salt 0.5))))

(define (fill-params buf layers dm df od salt)
  (let ((per-layer (+ dm (* 3 df dm)))
        (head-w (* od dm)))
    (do ((l 0 (+ l 1)))
        ((= l layers))
      (let ((base (* l per-layer)))
        (do ((j 0 (+ j 1)))
            ((= j dm))
          (store-f64 (ffi-pointer buf) (+ base j)
                     (+ 1.0 (det-val (+ (* l 23) j) (+ salt 1) 0.15))))
        (do ((k dm (+ k 1)))
            ((= k per-layer))
          (store-f64 (ffi-pointer buf) (+ base k)
                     (det-val (+ (* l 131) k) (+ salt 2) 0.25)))))
    (let ((hbar (* layers per-layer)))
      (do ((k 0 (+ k 1)))
          ((= k head-w))
        (store-f64 (ffi-pointer buf) (+ hbar k) (det-val k (+ salt 3) 0.25)))
      (do ((v 0 (+ v 1)))
          ((= v od))
        (store-f64 (ffi-pointer buf) (+ hbar head-w v)
                   (det-val v (+ salt 4) 0.10))))))

(define (max-abs-diff a b count)
  (let ((best 0.0))
    (do ((i 0 (+ i 1)))
        ((= i count) best)
      (let ((d (abs (- (load-f64 (ffi-pointer a) i)
                       (load-f64 (ffi-pointer b) i)))))
        (when (> d best) (set! best d))))))

(define (dot-f64 a b count)
  (let ((acc 0.0))
    (do ((i 0 (+ i 1)))
        ((= i count) acc)
      (set! acc (+ acc (* (load-f64 (ffi-pointer a) i)
                          (load-f64 (ffi-pointer b) i)))))))

;; Allocate workspaces
(define pcount (pp-param-count total-layers d-model d-ff out-dim))
(define in-elems (* num-mb tok-per-mb d-model))
(define tok-elems (* num-mb tok-per-mb))
(define mse-elems (* num-mb tok-per-mb out-dim))

(define buf-in (checked-allocate (* in-elems 8)))
(define buf-tce (checked-allocate (* tok-elems 4)))
(define buf-tmse (checked-allocate (* mse-elems 8)))
(define buf-params (checked-allocate (* pcount 8)))
(define buf-g-p1 (checked-allocate (* pcount 8)))
(define buf-g-p2 (checked-allocate (* pcount 8)))
(define buf-g-p4 (checked-allocate (* pcount 8)))
(define buf-g-gp (checked-allocate (* pcount 8)))
(define buf-w-p1 (checked-allocate (* pcount 8)))
(define buf-w-p2 (checked-allocate (* pcount 8)))
(define buf-w-p4 (checked-allocate (* pcount 8)))
(define buf-losses-p1 (checked-allocate (* 10 8)))
(define buf-losses-p2 (checked-allocate (* 10 8)))
(define buf-losses-p4 (checked-allocate (* 10 8)))
(define buf-loss-scalar (checked-allocate 8))
(define buf-metrics-f64 (checked-allocate (* 2 8)))
(define buf-stage-i64 (checked-allocate (* 17 8)))
(define buf-peaks-i64 (checked-allocate (* 5 8)))
(define buf-sched-i64 (checked-allocate (* 5 8)))
(define buf-bubble-f64 (checked-allocate 8))

;; Buffers for single-layer FD check (T=2, D=4, F=6)
(define fd-t 2)
(define fd-d 4)
(define fd-f 6)
(define fd-xe (* fd-t fd-d))
(define fd-pe (+ fd-d (* 3 fd-f fd-d)))
(define buf-fd-x (checked-allocate (* fd-xe 8)))
(define buf-fd-dy (checked-allocate (* fd-xe 8)))
(define buf-fd-dx (checked-allocate (* fd-xe 8)))
(define buf-fd-yp (checked-allocate (* fd-xe 8)))
(define buf-fd-ym (checked-allocate (* fd-xe 8)))
(define buf-fd-p (checked-allocate (* fd-pe 8)))
(define buf-fd-dp (checked-allocate (* fd-pe 8)))

;; 1. Schedule verification (1F1B vs GPipe for P=4, M=8)
(define (check-schedules)
  (do ((s 0 (+ s 1)))
      ((= s 4))
    (expect-status "sched 1f1b" status-ok
                   (pp-build-schedule 4 s 8 sched-1f1b
                                      (ffi-pointer buf-sched-i64)
                                      (ffi-pointer buf-bubble-f64)))
    (let ((warm (load-i64 (ffi-pointer buf-sched-i64) 0))
          (steady (load-i64 (ffi-pointer buf-sched-i64) 1))
          (cool (load-i64 (ffi-pointer buf-sched-i64) 2))
          (steps (load-i64 (ffi-pointer buf-sched-i64) 3))
          (peak (load-i64 (ffi-pointer buf-sched-i64) 4))
          (bub (load-f64 (ffi-pointer buf-bubble-f64) 0)))
      (require-check "1f1b warmup mismatch" (= warm (- 3 s)))
      (require-check "1f1b steady mismatch" (= steady (- 8 (- 3 s))))
      (require-check "1f1b cooldown mismatch" (= cool (- 3 s)))
      (require-check "1f1b steps mismatch" (= steps 16))
      (require-check "1f1b peak mismatch" (= peak (- 4 s)))
      (require-check "1f1b bubble mismatch" (< (abs (- bub (/ 3.0 11.0))) 1.0e-14)))
    (expect-status "sched gpipe" status-ok
                   (pp-build-schedule 4 s 8 sched-gpipe
                                      (ffi-pointer buf-sched-i64)
                                      (ffi-pointer buf-bubble-f64)))
    (require-check "gpipe peak mismatch" (= (load-i64 (ffi-pointer buf-sched-i64) 4) 8)))
  (display "PP1F1B AOT SCHEDULE P=4 M=8 1f1b_peaks=4,3,2,1 gpipe_peaks=8,8,8,8 bubble=3/11 PASS")
  (newline))

;; 2. Central finite-difference gradient check on RMSNorm + SwiGLU layer
(define (check-layer-fd)
  (let ((eps 1.0e-6)
        (max-x-err 0.0)
        (max-p-err 0.0))
    (do ((i 0 (+ i 1)))
        ((= i fd-xe))
      (store-f64 (ffi-pointer buf-fd-x) i (det-val i 11 0.8))
      (store-f64 (ffi-pointer buf-fd-dy) i (det-val i 12 0.6)))
    (do ((j 0 (+ j 1)))
        ((= j fd-d))
      (store-f64 (ffi-pointer buf-fd-p) j (+ 1.0 (det-val j 13 0.2))))
    (do ((k fd-d (+ k 1)))
        ((= k fd-pe))
      (store-f64 (ffi-pointer buf-fd-p) k (det-val k 14 0.3)))

    (expect-status "layer backward" status-ok
                   (pp-layer-backward fd-t fd-d fd-f rms-eps
                                      (ffi-pointer buf-fd-x)
                                      (ffi-pointer buf-fd-p)
                                      (ffi-pointer buf-fd-dy)
                                      (ffi-pointer buf-fd-dx)
                                      (ffi-pointer buf-fd-dp)))

    (do ((i 0 (+ i 1)))
        ((= i fd-xe))
      (let ((orig (load-f64 (ffi-pointer buf-fd-x) i)))
        (store-f64 (ffi-pointer buf-fd-x) i (+ orig eps))
        (expect-status "fd x+" status-ok
                       (pp-layer-forward fd-t fd-d fd-f rms-eps
                                         (ffi-pointer buf-fd-x)
                                         (ffi-pointer buf-fd-p)
                                         (ffi-pointer buf-fd-yp)))
        (store-f64 (ffi-pointer buf-fd-x) i (- orig eps))
        (expect-status "fd x-" status-ok
                       (pp-layer-forward fd-t fd-d fd-f rms-eps
                                         (ffi-pointer buf-fd-x)
                                         (ffi-pointer buf-fd-p)
                                         (ffi-pointer buf-fd-ym)))
        (store-f64 (ffi-pointer buf-fd-x) i orig)
        (let* ((num (/ (- (dot-f64 buf-fd-yp buf-fd-dy fd-xe)
                          (dot-f64 buf-fd-ym buf-fd-dy fd-xe))
                       (* 2.0 eps)))
               (err (abs (- num (load-f64 (ffi-pointer buf-fd-dx) i)))))
          (when (> err max-x-err) (set! max-x-err err)))))

    (do ((i 0 (+ i 1)))
        ((= i fd-pe))
      (let ((orig (load-f64 (ffi-pointer buf-fd-p) i)))
        (store-f64 (ffi-pointer buf-fd-p) i (+ orig eps))
        (expect-status "fd p+" status-ok
                       (pp-layer-forward fd-t fd-d fd-f rms-eps
                                         (ffi-pointer buf-fd-x)
                                         (ffi-pointer buf-fd-p)
                                         (ffi-pointer buf-fd-yp)))
        (store-f64 (ffi-pointer buf-fd-p) i (- orig eps))
        (expect-status "fd p-" status-ok
                       (pp-layer-forward fd-t fd-d fd-f rms-eps
                                         (ffi-pointer buf-fd-x)
                                         (ffi-pointer buf-fd-p)
                                         (ffi-pointer buf-fd-ym)))
        (store-f64 (ffi-pointer buf-fd-p) i orig)
        (let* ((num (/ (- (dot-f64 buf-fd-yp buf-fd-dy fd-xe)
                          (dot-f64 buf-fd-ym buf-fd-dy fd-xe))
                       (* 2.0 eps)))
               (err (abs (- num (load-f64 (ffi-pointer buf-fd-dp) i)))))
          (when (> err max-p-err) (set! max-p-err err)))))

    (require-check "layer FD dx err > 1e-8" (<= max-x-err 1.0e-8))
    (require-check "layer FD dp err > 1e-8" (<= max-p-err 1.0e-8))
    (display "PP1F1B AOT FD_GRADIENTS checked=") (display (+ fd-xe fd-pe))
    (display " max_dx_err=") (display (number->string max-x-err))
    (display " max_dp_err=") (display (number->string max-p-err))
    (display " PASS") (newline)))

;; 3. Multi-process P=2 and P=4 (M=8) parity vs P=1 reference + 1F1B vs GPipe peaks
(define (check-multiprocess-parity)
  (fill-inputs buf-in in-elems 21)
  (fill-targets-ce buf-tce tok-elems 22)
  (fill-targets-mse buf-tmse mse-elems 23)
  (fill-params buf-params total-layers d-model d-ff out-dim 24)

  ;; Cross-Entropy: P=1 ref, P=2 1F1B, P=4 1F1B, P=4 GPipe
  (expect-status "p1 ref ce" status-ok
                 (pp-run-reference total-layers num-mb tok-per-mb d-model d-ff out-dim
                                   loss-ce rms-eps (ffi-pointer buf-in)
                                   (ffi-pointer buf-tce) (ffi-pointer buf-params)
                                   (ffi-pointer buf-g-p1) (ffi-pointer buf-loss-scalar)))
  (let ((loss-p1 (load-f64 (ffi-pointer buf-loss-scalar) 0)))
    ;; P=2 (2x2 layers) 1F1B
    (expect-status "p2 1f1b ce" status-ok
                   (pp-run-multiprocess 2 2 num-mb tok-per-mb d-model d-ff out-dim
                                        sched-1f1b loss-ce timeout-ms rms-eps
                                        (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                        (ffi-pointer buf-params) (ffi-pointer buf-g-p2)
                                        (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
    (let ((loss-p2 (load-f64 (ffi-pointer buf-metrics-f64) 0))
          (gerr-p2 (max-abs-diff buf-g-p2 buf-g-p1 pcount))
          (p2-pk0 (load-i64 (ffi-pointer buf-stage-i64) 0))
          (p2-pk1 (load-i64 (ffi-pointer buf-stage-i64) 1))
          (p2-pids (load-i64 (ffi-pointer buf-stage-i64) 16)))
      (require-check "p2 pids != 2" (= p2-pids 2))
      (require-check "p2 peaks != 2,1" (and (= p2-pk0 2) (= p2-pk1 1)))
      (require-check "p2 loss err > 1e-6" (<= (abs (- loss-p2 loss-p1)) 1.0e-6))
      (require-check "p2 grad err > 1e-6" (<= gerr-p2 1.0e-6))

      ;; P=4 (4x1 layers) 1F1B
      (expect-status "p4 1f1b ce" status-ok
                     (pp-run-multiprocess 4 1 num-mb tok-per-mb d-model d-ff out-dim
                                          sched-1f1b loss-ce timeout-ms rms-eps
                                          (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                          (ffi-pointer buf-params) (ffi-pointer buf-g-p4)
                                          (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
      (let ((loss-p4 (load-f64 (ffi-pointer buf-metrics-f64) 0))
            (gerr-p4 (max-abs-diff buf-g-p4 buf-g-p1 pcount))
            (p4-pk0 (load-i64 (ffi-pointer buf-stage-i64) 0))
            (p4-pk1 (load-i64 (ffi-pointer buf-stage-i64) 1))
            (p4-pk2 (load-i64 (ffi-pointer buf-stage-i64) 2))
            (p4-pk3 (load-i64 (ffi-pointer buf-stage-i64) 3))
            (p4-pids (load-i64 (ffi-pointer buf-stage-i64) 16))
            (p4-sent0 (load-i64 (ffi-pointer buf-stage-i64) 8)))
        (require-check "p4 pids != 4" (= p4-pids 4))
        (require-check "p4 1f1b peaks != 4,3,2,1"
                       (and (= p4-pk0 4) (= p4-pk1 3) (= p4-pk2 2) (= p4-pk3 1)))
        (require-check "p4 sent0 == 0" (> p4-sent0 0))
        (require-check "p4 loss err > 1e-6" (<= (abs (- loss-p4 loss-p1)) 1.0e-6))
        (require-check "p4 grad err > 1e-6" (<= gerr-p4 1.0e-6))

        ;; P=4 GPipe to confirm measured peak=8 on all 4 stages vs 1F1B <= 4
        (expect-status "p4 gpipe ce" status-ok
                       (pp-run-multiprocess 4 1 num-mb tok-per-mb d-model d-ff out-dim
                                            sched-gpipe loss-ce timeout-ms rms-eps
                                            (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                            (ffi-pointer buf-params) (ffi-pointer buf-g-gp)
                                            (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
        (let ((gp-pk0 (load-i64 (ffi-pointer buf-stage-i64) 0))
              (gp-pk3 (load-i64 (ffi-pointer buf-stage-i64) 3)))
          (require-check "gpipe runtime peak != 8" (and (= gp-pk0 8) (= gp-pk3 8)))
          (require-check "1f1b peak0 not < gpipe" (< p4-pk0 gp-pk0))
          (require-check "1f1b peak3 not < gpipe" (< p4-pk3 gp-pk3))

          ;; Also verify P=4 MSE parity vs P=1 MSE reference
          (expect-status "p1 ref mse" status-ok
                         (pp-run-reference total-layers num-mb tok-per-mb d-model d-ff out-dim
                                           loss-mse rms-eps (ffi-pointer buf-in)
                                           (ffi-pointer buf-tmse) (ffi-pointer buf-params)
                                           (ffi-pointer buf-g-p1) (ffi-pointer buf-loss-scalar)))
          (let ((mse-p1 (load-f64 (ffi-pointer buf-loss-scalar) 0)))
            (expect-status "p4 1f1b mse" status-ok
                           (pp-run-multiprocess 4 1 num-mb tok-per-mb d-model d-ff out-dim
                                                sched-1f1b loss-mse timeout-ms rms-eps
                                                (ffi-pointer buf-in) (ffi-pointer buf-tmse)
                                                (ffi-pointer buf-params) (ffi-pointer buf-g-p4)
                                                (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
            (let ((mse-p4 (load-f64 (ffi-pointer buf-metrics-f64) 0))
                  (mse-gerr (max-abs-diff buf-g-p4 buf-g-p1 pcount)))
              (require-check "p4 mse loss err > 1e-6" (<= (abs (- mse-p4 mse-p1)) 1.0e-6))
              (require-check "p4 mse grad err > 1e-6" (<= mse-gerr 1.0e-6))
              (display "PP1F1B AOT PARITY M=8 p2_gerr=") (display (number->string gerr-p2))
              (display " p4_gerr=") (display (number->string gerr-p4))
              (display " p4_mse_gerr=") (display (number->string mse-gerr))
              (display " pids_p2=") (display p2-pids)
              (display " pids_p4=") (display p4-pids)
              (display " peak_1f1b_s0=") (display p4-pk0)
              (display " peak_1f1b_s3=") (display p4-pk3)
              (display " peak_gpipe_s0=") (display gp-pk0)
              (display " PASS") (newline))))))))

;; 4. 10-step SGD training strictly decreasing loss identically across P=1, 2, 4
(define (check-sgd-10-steps)
  (let ((lr 0.08))
    (expect-status "sgd p1" status-ok
                   (pp-train-reference-sgd total-layers num-mb tok-per-mb d-model d-ff out-dim
                                           loss-ce 10 lr rms-eps
                                           (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                           (ffi-pointer buf-params) (ffi-pointer buf-w-p1)
                                           (ffi-pointer buf-losses-p1)))
    (expect-status "sgd p2" status-ok
                   (pp-train-multiprocess-sgd 2 2 num-mb tok-per-mb d-model d-ff out-dim
                                              sched-1f1b loss-ce 10 timeout-ms lr rms-eps
                                              (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                              (ffi-pointer buf-params) (ffi-pointer buf-w-p2)
                                              (ffi-pointer buf-losses-p2) (ffi-pointer buf-peaks-i64)))
    (require-check "sgd p2 pids != 2" (= (load-i64 (ffi-pointer buf-peaks-i64) 4) 2))

    (expect-status "sgd p4" status-ok
                   (pp-train-multiprocess-sgd 4 1 num-mb tok-per-mb d-model d-ff out-dim
                                              sched-1f1b loss-ce 10 timeout-ms lr rms-eps
                                              (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                              (ffi-pointer buf-params) (ffi-pointer buf-w-p4)
                                              (ffi-pointer buf-losses-p4) (ffi-pointer buf-peaks-i64)))
    (require-check "sgd p4 pids != 4" (= (load-i64 (ffi-pointer buf-peaks-i64) 4) 4))

    (let ((max-lerr 0.0))
      (do ((step 0 (+ step 1)))
          ((= step 10))
        (let ((l1 (load-f64 (ffi-pointer buf-losses-p1) step))
              (l2 (load-f64 (ffi-pointer buf-losses-p2) step))
              (l4 (load-f64 (ffi-pointer buf-losses-p4) step)))
          (when (> step 0)
            (require-check "sgd loss did not strictly decrease"
                           (< l4 (load-f64 (ffi-pointer buf-losses-p4) (- step 1)))))
          (let ((e2 (abs (- l2 l1)))
                (e4 (abs (- l4 l1))))
            (when (> e2 max-lerr) (set! max-lerr e2))
            (when (> e4 max-lerr) (set! max-lerr e4)))))
      (let ((w2-err (max-abs-diff buf-w-p2 buf-w-p1 pcount))
            (w4-err (max-abs-diff buf-w-p4 buf-w-p1 pcount)))
        (require-check "sgd loss parity > 1e-6" (<= max-lerr 1.0e-6))
        (require-check "sgd w2 parity > 1e-6" (<= w2-err 1.0e-6))
        (require-check "sgd w4 parity > 1e-6" (<= w4-err 1.0e-6))
        (display "PP1F1B AOT SGD10 loss0=")
        (display (number->string (load-f64 (ffi-pointer buf-losses-p4) 0)))
        (display " loss9=")
        (display (number->string (load-f64 (ffi-pointer buf-losses-p4) 9)))
        (display " max_lerr=") (display (number->string max-lerr))
        (display " w2_err=") (display (number->string w2-err))
        (display " w4_err=") (display (number->string w4-err))
        (display " PASS") (newline)))))

;; 5. Negative rejections (M < P, invalid P, non-finite inputs/weights, transport probes)
(define (check-negatives)
  ;; M < P
  (expect-status "neg M<P" err-invalid-mb
                 (pp-build-schedule 4 0 3 sched-1f1b
                                    (ffi-pointer buf-sched-i64)
                                    (ffi-pointer buf-bubble-f64)))
  ;; Invalid P = 3 and P = 1
  (expect-status "neg P=3" err-invalid-stages
                 (pp-build-schedule 3 0 6 sched-1f1b
                                    (ffi-pointer buf-sched-i64)
                                    (ffi-pointer buf-bubble-f64)))
  (expect-status "neg P=1" err-invalid-stages
                 (pp-run-multiprocess 1 4 num-mb tok-per-mb d-model d-ff out-dim
                                      sched-1f1b loss-ce timeout-ms rms-eps
                                      (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                      (ffi-pointer buf-params) (ffi-pointer buf-g-p1)
                                      (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
  ;; Non-finite input activation
  (let ((saved-in (load-f64 (ffi-pointer buf-in) 0)))
    (store-f64 (ffi-pointer buf-in) 0 (make-nonfinite 0))
    (expect-status "neg nan input" err-nonfinite
                   (pp-run-multiprocess 2 2 num-mb tok-per-mb d-model d-ff out-dim
                                        sched-1f1b loss-ce timeout-ms rms-eps
                                        (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                        (ffi-pointer buf-params) (ffi-pointer buf-g-p2)
                                        (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
    (store-f64 (ffi-pointer buf-in) 0 saved-in))
  ;; Non-finite weight
  (let ((saved-w (load-f64 (ffi-pointer buf-params) 0)))
    (store-f64 (ffi-pointer buf-params) 0 (make-nonfinite 1))
    (expect-status "neg inf weight" err-nonfinite
                   (pp-run-multiprocess 2 2 num-mb tok-per-mb d-model d-ff out-dim
                                        sched-1f1b loss-ce timeout-ms rms-eps
                                        (ffi-pointer buf-in) (ffi-pointer buf-tce)
                                        (ffi-pointer buf-params) (ffi-pointer buf-g-p2)
                                        (ffi-pointer buf-metrics-f64) (ffi-pointer buf-stage-i64)))
    (store-f64 (ffi-pointer buf-params) 0 saved-w))
  ;; Real AF_UNIX transport negative probes
  (expect-status "neg mb mismatch" err-protocol (pp-probe-transport 0 500))
  (expect-status "neg disconnect" err-peer-disconnected (pp-probe-transport 1 500))
  (expect-status "neg timeout" err-timeout (pp-probe-transport 2 50))
  (expect-status "neg wire nan" err-nonfinite (pp-probe-transport 3 500))

  (display "PP1F1B AOT NEGATIVE checks=9 PASS") (newline))

(check-schedules)
(check-layer-fd)
(check-multiprocess-parity)
(check-sgd-10-steps)
(check-negatives)
(display "PP1F1B AOT SUMMARY stages=2,4 microbatches=8 sgd_steps=10 PASS") (newline)

(release (ffi-pointer buf-in))
(release (ffi-pointer buf-tce))
(release (ffi-pointer buf-tmse))
(release (ffi-pointer buf-params))
(release (ffi-pointer buf-g-p1))
(release (ffi-pointer buf-g-p2))
(release (ffi-pointer buf-g-p4))
(release (ffi-pointer buf-g-gp))
(release (ffi-pointer buf-w-p1))
(release (ffi-pointer buf-w-p2))
(release (ffi-pointer buf-w-p4))
(release (ffi-pointer buf-losses-p1))
(release (ffi-pointer buf-losses-p2))
(release (ffi-pointer buf-losses-p4))
(release (ffi-pointer buf-loss-scalar))
(release (ffi-pointer buf-metrics-f64))
(release (ffi-pointer buf-stage-i64))
(release (ffi-pointer buf-peaks-i64))
(release (ffi-pointer buf-sched-i64))
(release (ffi-pointer buf-bubble-f64))
(release (ffi-pointer buf-fd-x))
(release (ffi-pointer buf-fd-dy))
(release (ffi-pointer buf-fd-dx))
(release (ffi-pointer buf-fd-yp))
(release (ffi-pointer buf-fd-ym))
(release (ffi-pointer buf-fd-p))
(release (ffi-pointer buf-fd-dp))
