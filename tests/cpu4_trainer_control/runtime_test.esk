;;; Genuine C4/P1/I2/O2/D2 constructor and controls-only transaction witness.
;;; No step, C2 image, parameter/moment restore, or full-checkpoint claim.
(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")
(load "o2_wave2_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_trainer_control_extension.esk")

(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4 controls FAIL: ") (display label) (newline) (exit 1))))
(define (report-error label caught)
  (display "CPU4 controls ERROR: ") (display label)
  (if (transformer-error? caught)
      (begin (display " category=") (display (transformer-error-category caught))
             (display " operation=") (display (transformer-error-operation caught))
             (display " message=") (display (transformer-error-message caught)))
      (display " non-transformer error"))
  (newline))
(define (must label thunk)
  (guard (caught (#t (report-error label caught) (exit 1))) (thunk)))
(define (reject label category thunk)
  (check label
    (guard (caught (#t (if (and (transformer-error? caught)
                                (eq? category (transformer-error-category caught)))
                            #t (begin (report-error label caught) #f))))
      (thunk) #f)))
(define (handle-paths handles)
  (let loop ((index 0))
    (if (= index 14) '()
        (cons (parameter-handle-path (vector-ref handles index)) (loop (+ index 1))))))
(define (copy-bytes bytes)
  (bytevector-copy bytes 0 (bytevector-length bytes)))
;;; Test-side data copier; never calls production control validation.
(define (clone-controls controls)
  (let ((rng (vector-ref controls 0)) (identity (vector-ref controls 1))
        (cursors (vector-ref controls 2)) (config (vector-ref controls 3))
        (counts (vector-ref controls 4)))
    (vector
      (vector (vector-ref rng 0) (vector-ref rng 1) (vector-ref rng 2)
              (vector-ref rng 3) (vector-ref rng 4))
      (vector (utf8->string (string->utf8 (vector-ref identity 0))) (vector-ref identity 1))
      (vector (copy-bytes (vector-ref cursors 0)) (copy-bytes (vector-ref cursors 1)))
      (vector (copy-bytes (vector-ref config 0))
              (utf8->string (string->utf8 (vector-ref config 1))))
      (vector (vector-ref counts 0) (vector-ref counts 1) (vector-ref counts 2)))))
(define (flip-first! bytes)
  (bytevector-u8-set! bytes 0 (if (= (bytevector-u8-ref bytes 0) 0) 1 0)))
(define (all-modes modules expected)
  (let loop ((index 0))
    (if (= index 17) #t
        (and (eq? (module-mode-internal (vector-ref modules index)) expected)
             (loop (+ index 1))))))

(define resolved
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define model (g3c4-model-create-seeded-internal 1729))
(module-train! model)
(define binding (cpu4-model-binding-create-internal model resolved))
(define binding-record (cpu4-model-binding-check-internal binding))
(define handles (vector-ref binding-record 10))
(define modules (vector-ref binding-record 9))
(define lease (cpu4-model-binding-native-lease-internal binding))
(define optimizer
  (o2-public-optimizer-create
    (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu '(none) '(constant)
      (list (list 'group (handle-paths handles) "3dcccccd" "3f000000" "3f000000"
                  "3a83126f" "00000000")))
    (module-parameters model)))
(define arguments (command-line))
(define tokenizer (must "raw V256 tokenizer" (lambda () (t2-wave2-tokenizer-byte resolved))))
(define dataset (must "real N1/T4/V256 dataset" (lambda ()
  (d2-token-dataset-open
    (list ':directory (car (cdr arguments)) ':batch-size 1 ':sequence-length 4
          ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
          ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
          ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer))))
(define initial-cursor (cpu4-d2-cursor-capture-internal dataset))
;;; Constructor must prove real native IDLE and leave a failed row inert.
(check "external READ enter" (= (cpu4-control-native-enter lease 1) 0))
(reject "constructor native contention" 'invalid-state
  (lambda () (cpu4-trainer-create-internal binding tokenizer dataset optimizer)))
(check "external READ leave" (= (cpu4-control-native-leave lease) 0))
(define trainer (must "genuine zero constructor"
  (lambda () (cpu4-trainer-create-internal binding tokenizer dataset optimizer))))
(define record (cpu4-trainer-idle-check-internal trainer 'cpu4-controls-test))
(check "record22 and exact self" (and (= (vector-length record) 22) (eq? record (vector-ref record 1))))
(check "same original C4 model and binding" (and (eq? model (vector-ref record 8)) (eq? binding (vector-ref record 9))))
(check "same exact modules/handles/carriers" (and (eq? modules (vector-ref record 10))
  (eq? handles (vector-ref record 11)) (eq? (vector-ref binding-record 11) (vector-ref record 12))))
(check "genuine O2 and D2 records" (and
  (eq? (o2-require-optimizer 'cpu4-controls-test optimizer) (vector-ref record 14))
  (eq? (d2-open-dataset-state dataset 'cpu4-controls-test) (vector-ref record 16))))
(check "initial zero counts" (and (= (vector-ref record 19) 0) (= (vector-ref record 20) 0) (= (vector-ref record 21) 0)))
(check "original C4 slot7 remains false" (eq? (vector-ref (vector-ref binding-record 3) 7) #f))
(check "all17 TRAIN initially" (all-modes modules 'train))
(reject "overlapping constructor" 'invalid-state
  (lambda () (cpu4-trainer-create-internal binding tokenizer dataset optimizer)))
(check "overlap leaves original idle" (eq? record (cpu4-trainer-idle-check-internal trainer 'cpu4-controls-test)))
(reject "foreign trainer shell" 'invalid-argument
  (lambda () (cpu4-trainer-control-begin-internal (vector 'cpu4-trainer) 'snapshot)))
(reject "step explicitly unsupported" 'unsupported
  (lambda () (cpu4-trainer-control-begin-internal trainer 'step)))
(check "external WRITE enter" (= (cpu4-control-native-enter lease 2) 0))
(reject "begin native WRITE contention" 'invalid-state
  (lambda () (cpu4-trainer-control-begin-internal trainer 'snapshot)))
(check "failed begin keeps canonical idle" (and (eq? (vector-ref record 3) 'idle) (eq? (vector-ref record 4) #f)))
(check "external WRITE leave" (= (cpu4-control-native-leave lease) 0))

(define snapshot (must "snapshot begin"
  (lambda () (cpu4-trainer-control-begin-internal trainer 'snapshot))))
(check "snapshot owns real WRITE" (not (= (cpu4-control-native-enter lease 1) 0)))
(reject "second control while snapshot" 'invalid-state
  (lambda () (cpu4-trainer-control-begin-internal trainer 'restore)))
(reject "foreign parent token" 'invalid-argument
  (lambda () (cpu4-trainer-controls-copy-internal (vector 'cpu4-control))))
(define zero (cpu4-trainer-controls-copy-internal snapshot))
(check "exact zero five-tuple" (and (= (vector-length zero) 5)
  (equal? (vector-ref zero 0) (vector 'philox4x32-10 1 1729 0 0))
  (equal? (vector-ref zero 4) (vector 0 0 0))
  (= (vector-ref (vector-ref zero 1) 1) 256)
  (d2-core-bytes=? initial-cursor (vector-ref (vector-ref zero 2) 0))
  (d2-core-bytes=? initial-cursor (vector-ref (vector-ref zero 2) 1))))
(define detached (cpu4-trainer-controls-copy-internal snapshot))
(let loop ((index 0))
  (if (= index 5) #t
      (begin (check "all five nested vectors detached"
                (not (eq? (vector-ref detached index) (vector-ref zero index)))) (loop (+ index 1)))))
(vector-set! (vector-ref detached 0) 2 1730)
(string-set! (vector-ref (vector-ref detached 1) 0) 0 #\x)
(flip-first! (vector-ref (vector-ref detached 2) 0))
(flip-first! (vector-ref (vector-ref detached 2) 1))
(flip-first! (vector-ref (vector-ref detached 3) 0))
(string-set! (vector-ref (vector-ref detached 3) 1) 0 #\x)
(vector-set! (vector-ref detached 4) 0 99)
(check "snapshot deep detach including strings/bytes" (equal? zero (cpu4-trainer-controls-copy-internal snapshot)))
(reject "snapshot cannot stage restore" 'invalid-state
  (lambda () (cpu4-trainer-controls-restore-stage-internal snapshot zero)))
;;; A dependency preflight failure must retain the exact parent and WRITE lease.
(module-eval! model)
(reject "end preflight refuses EVAL" 'invalid-state
  (lambda () (cpu4-trainer-control-end-internal! snapshot)))
(check "failed end retains same snapshot parent" (and (eq? (vector-ref record 3) 'snapshot)
  (eq? (vector-ref record 4) snapshot) (not (= (cpu4-control-native-enter lease 2) 0))))
(module-train! model)
(check "end retry sees same zero controls" (equal? zero (cpu4-trainer-controls-copy-internal snapshot)))
(check "snapshot end after same-parent retry" (cpu4-trainer-control-end-internal! snapshot))
(reject "closed parent repeat" 'invalid-state (lambda () (cpu4-trainer-control-end-internal! snapshot)))

;;; Genuine advanced D2 cursor, then restore the initial cursor. No training.
(define batch (d2-token-dataset-next-batch dataset))
(check "real T4 batch" (not (d2-token-dataset-end? batch)))
(d2-token-batch-release! batch)
(define advanced-cursor (cpu4-d2-cursor-capture-internal dataset))
(check "D2 actually advanced" (not (d2-core-bytes=? initial-cursor advanced-cursor)))
(cpu4-d2-cursor-restore-internal! dataset initial-cursor)
(define restore (must "restore begin"
  (lambda () (cpu4-trainer-control-begin-internal trainer 'restore))))
(define (bad-stage label category value)
  (reject label category (lambda () (cpu4-trainer-controls-restore-stage-internal restore value)))
  (check "failed stage leaves same parent/no writes" (equal? zero (cpu4-trainer-controls-copy-internal restore))))
(bad-stage "short controls" 'invalid-argument (vector #f #f #f #f))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 0) 2 1730) (bad-stage "wrong seed" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 1) 1 257) (bad-stage "wrong tokenizer vocab" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (string-set! (vector-ref (vector-ref bad 1) 0) 0 #\x) (bad-stage "wrong tokenizer fingerprint" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (flip-first! (vector-ref (vector-ref bad 3) 0)) (bad-stage "wrong canonical config" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (string-set! (vector-ref (vector-ref bad 3) 1) 0 #\x) (bad-stage "wrong config fingerprint" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (flip-first! (vector-ref (vector-ref bad 2) 0)) (bad-stage "corrupt cursor bytes" 'corrupt-data bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 2) 0 advanced-cursor) (bad-stage "cursor/counter mismatch" 'invalid-state bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 2) 1 advanced-cursor) (bad-stage "epoch after current" 'corrupt-data bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 4) 0 1) (bad-stage "token contribution upper bound" 'invalid-state bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 4) 0 -1) (bad-stage "negative counter" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 4) 1 1.0) (bad-stage "inexact counter" 'invalid-argument bad))
(let ((bad (clone-controls zero))) (vector-set! (vector-ref bad 4) 1 9223372036854775807) (bad-stage "contribution overflow" 'invalid-state bad))
(define stage-input (clone-controls zero))
(define stage (must "restore stage"
  (lambda () (cpu4-trainer-controls-restore-stage-internal restore stage-input))))
(vector-set! (vector-ref stage-input 0) 2 1730)
(flip-first! (vector-ref (vector-ref stage-input 2) 1))
(check "stage detaches caller input" (equal? zero (cpu4-trainer-controls-restore-copy-internal stage)))
(define stage-copy (cpu4-trainer-controls-restore-copy-internal stage))
(vector-set! (vector-ref stage-copy 4) 0 88)
(check "stage projection also detached" (equal? zero (cpu4-trainer-controls-restore-copy-internal stage)))
(reject "pending stage blocks second" 'invalid-state
  (lambda () (cpu4-trainer-controls-restore-stage-internal restore zero)))
(reject "pending stage blocks end" 'invalid-state (lambda () (cpu4-trainer-control-end-internal! restore)))
(reject "commit requires precommit" 'invalid-state (lambda () (cpu4-trainer-controls-restore-commit-internal! stage)))
(reject "copied stage token rejected" 'invalid-argument
  (lambda () (cpu4-trainer-controls-restore-precommit-internal (vector (vector-ref stage 0)))))
(check "abort real stage" (cpu4-trainer-controls-restore-abort-internal! stage))
(reject "aborted stage repeat" 'invalid-state (lambda () (cpu4-trainer-controls-restore-abort-internal! stage)))
(reject "aborted stage commit" 'invalid-state (lambda () (cpu4-trainer-controls-restore-commit-internal! stage)))
;;; Controls-only identity commit: dependency state already equals zero. No
;;; C2/I2/O2 plan is claimed or emulated. G3 owns the full transaction gate.
(define retry-stage (cpu4-trainer-controls-restore-stage-internal restore zero))
(check "same parent restages after abort" (equal? zero (cpu4-trainer-controls-restore-copy-internal retry-stage)))
(check "precommit" (cpu4-trainer-controls-restore-precommit-internal retry-stage))
(check "same-stage precommit retry" (cpu4-trainer-controls-restore-precommit-internal retry-stage))
(check "control-only zero identity commit" (cpu4-trainer-controls-restore-commit-internal! retry-stage))
(reject "committed stage repeated commit" 'invalid-state (lambda () (cpu4-trainer-controls-restore-commit-internal! retry-stage)))
(check "committed zero controls" (equal? zero (cpu4-trainer-controls-copy-internal restore)))
(check "restore end" (cpu4-trainer-control-end-internal! restore))
(check "post-restore idle same record" (eq? record (cpu4-trainer-idle-check-internal trainer 'cpu4-controls-test)))
(check "all17 TRAIN after controls" (all-modes modules 'train))

;;; Genuine existing P1 mode transaction, then exact TRAIN restoration.
(define setup (vector (vector 'cpu4-controls-mode-frame) #f))
(check "P1 mode bind" (= ((vector-ref p1-trusted-surface 64) model setup) 0))
(define modes (vector-ref setup 1))
(check "P1 mode prepare" (= ((vector-ref p1-trusted-surface 65) modes) 0))
(check "P1 mode enter" (= ((vector-ref p1-trusted-surface 66) modes) 0))
(check "all17 EVAL" (all-modes modules 'eval))
(reject "control rejects EVAL" 'invalid-state (lambda () (cpu4-trainer-control-begin-internal trainer 'snapshot)))
(check "P1 mode restore" (= ((vector-ref p1-trusted-surface 67) modes) 0))
(check "all17 exact TRAIN restored" (all-modes modules 'train))
(check "P1 mode unbind" (= ((vector-ref p1-trusted-surface 68) modes) 0))
(define final-snapshot (cpu4-trainer-control-begin-internal trainer 'snapshot))
(check "control resumes after P1 restore" (equal? zero (cpu4-trainer-controls-copy-internal final-snapshot)))
(check "final snapshot end" (cpu4-trainer-control-end-internal! final-snapshot))
(d2-token-dataset-close! dataset)
(check "binding release" (cpu4-model-binding-release-internal! binding))
(check "binding release repeat" (cpu4-model-binding-release-internal! binding))
(reject "released binding rejects new control" 'invalid-state
  (lambda () (cpu4-trainer-control-begin-internal trainer 'snapshot)))
(check "canonical C4 retained after release" (eq? model (cpu4-model-binding-model-internal binding)))
(module-eval! model)
(check "all17 EVAL after release" (all-modes modules 'eval))
(display "CPU4 genuine constructor/snapshot/restore controls PASS: checks=") (display checks) (newline)
