;;; Source-private CPU4-v1 union; never install or require this root publicly.
;;; Keep the actual public G2 closure and its original T1/I2/M3 identities.
;;; Both roots use the same short load spelling. Preload their actual distinct
;;; registries before either root; the compiler deduplicates canonical paths.
(load "../internal/t1/lib/transformer/tokenizer_internal.esk")
(load "../internal/t2/lib/transformer/tokenizer_internal.esk")
(load "g3g_manual_package_root.esk")
(load "t2_wave2_root.esk")
(load "o2_wave2_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "c2_x1_canonical_extension.esk")
(load "c2_o2_reconstruct_extension.esk")
(load "c2_training_state_extension.esk")
(load "cpu4_candidate_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_trainer_control_extension.esk")
(load "cpu4_training_schedule_extension.esk")
(load "tr3_o2_step_clear_extension.esk")
(load "cpu4_training_step_extension.esk")
(load "tr3_c_d2_restore_extension.esk")
;;; Exact existing checkpoint-root fail-stop adapter, not a lease authority.
(define (tr3-lease-fail-stop status) (cpu4-binding-fail-stop status))
(load "tr3_c_restore_bindings_extension.esk")
(load "cpu4_checkpoint_extension.esk")
(load "cpu4_trainer_detach_extension.esk")
(load "cpu4_candidate_children_extension.esk")
;;; Existing split FILE reader and authentic K2 admission share the original
;;; I2/D2/O2 owners. The public C2 leaf also requires its SAVE/inspect branches.
(load "k2_wave2_extension.esk")
(load "c2_o2_encode_extension.esk")
(load "c2_model_encode_extension.esk")
(load "c2_persistence_policy_extension.esk")
(load "c2_checkpoint_inspect_extension.esk")
(load "c2_checkpoint_save_extension.esk")
(load "c2_checkpoint_load_extension.esk")
(load "c2_public_extension.esk")
(load "cpu4_checkpoint_factory_extension.esk")
;;; E3 reuses the seven actual M3 boundary definitions already loaded above.
(load "e3_p1_modes_extension.esk")
(load "e3_errors_extension.esk")
(load "e3_cpu4_private_extension.esk")
(load "e3_cpu4_d2_restore.esk")
(load "e3_forward_schedule.esk")
