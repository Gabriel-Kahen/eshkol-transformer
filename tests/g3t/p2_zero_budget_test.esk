(define reference-input (g3t-checked-m3t-input-create))
(check "reference input"
       (g3t-checked-m3t-input-copy! reference-input (list 65 66)))
(define reference-workspace (g3t-checked-m3t-workspace-create model))
(define reference-logits (g3t-checked-m3t-logits-create))
(check "reference begin" (g3t-checked-m3t-workspace-begin!
                            reference-workspace reference-input))
(check "reference ET" (g3t-checked-m3t-embedding! reference-workspace 'token))
(check "reference EP" (g3t-checked-m3t-embedding! reference-workspace 'position))
(check "reference X" (g3t-checked-m3t-residual! reference-workspace 'embeddings))
(check "reference N1" (g3t-checked-m3t-layer-norm! reference-workspace 'block-input))
(check "reference QT" (g3t-checked-m3t-linear! reference-workspace 'q))
(check "reference KT" (g3t-checked-m3t-linear! reference-workspace 'k))
(check "reference VT" (g3t-checked-m3t-linear! reference-workspace 'v))
(check "reference QH" (g3t-checked-m3t-heads-split! reference-workspace 'q))
(check "reference KH" (g3t-checked-m3t-heads-split! reference-workspace 'k))
(check "reference VH" (g3t-checked-m3t-heads-split! reference-workspace 'v))
(check "reference AH" (g3t-checked-m3t-attention! reference-workspace))
(check "reference AT" (g3t-checked-m3t-heads-merge! reference-workspace))
(check "reference AO" (g3t-checked-m3t-linear! reference-workspace 'attention-output))
(check "reference R" (g3t-checked-m3t-residual! reference-workspace 'attention))
(check "reference N2" (g3t-checked-m3t-layer-norm! reference-workspace 'ffn-input))
(check "reference FU" (g3t-checked-m3t-linear! reference-workspace 'ffn-up))
(check "reference FG" (g3t-checked-m3t-gelu! reference-workspace))
(check "reference FD" (g3t-checked-m3t-linear! reference-workspace 'ffn-down))
(check "reference Y" (g3t-checked-m3t-residual! reference-workspace 'ffn))
(check "reference NF" (g3t-checked-m3t-layer-norm! reference-workspace 'final))
(check "reference Z" (g3t-checked-m3t-linear! reference-workspace 'tied-head))
(check "reference copy" (g3t-checked-m3t-workspace-copy-logits!
                          reference-workspace reference-logits))
(define reference-bytes (g3t-checked-m3t-logits-bits reference-logits))
(check "all 256 P2 logits equal independent M3T"
       (let compare ((index 0))
         (if (= index 256) #t
             (let* ((at (+ 1024 (* index 4)))
                    (bits (+ (bytevector-u8-ref reference-bytes at)
                             (* 256 (bytevector-u8-ref reference-bytes (+ at 1)))
                             (* 65536 (bytevector-u8-ref reference-bytes (+ at 2)))
                             (* 16777216 (bytevector-u8-ref reference-bytes (+ at 3))))))
               (and (= bits (vector-ref prefill-bits index))
                    (compare (+ index 1)))))))
(check "reference reset" (g3t-checked-m3t-workspace-reset! reference-workspace))
(check "reference logits release" (g3t-checked-m3t-logits-release! reference-logits))
(check "reference workspace release"
       (g3t-checked-m3t-workspace-release! reference-workspace))
(check "reference input release" (g3t-checked-m3t-input-release! reference-input))

(define wrapped-generator (g3t-generator-create model tokenizer policy))
(define wrapped-input (g3t-generation-t1-input-create t1-p2))
(check "T1 P2 frame source owns I1"
       (let ((native-input
              (vector-ref (g3t-prefill-entry wrapped-input 'input 't1-p2) 3)))
         (and (= 2 (g3t-test-input-length native-input))
              (= 65 (g3t-test-input-word native-input 0))
              (= 66 (g3t-test-input-word native-input 1)))))
(define wrapped-output (g3t-p2-zero-generate! wrapped-generator wrapped-input))
(check "rooted P2/G0 empty result"
       (let ((entry (g3t-prefill-entry wrapped-output 'output 'g3t-p2-rooted)))
         (and (eq? (vector-ref entry 2) 'live)
              (= 0 (bytevector-length (vector-ref entry 6))))))
(define wrapped-native-output
  (vector-ref (g3t-prefill-entry wrapped-output 'output 'g3t-rng-test) 3))
(reject-category "RNG wrapper rejects forged output" 'invalid-argument
  (lambda () (g3t-generation-output-rng (vector 'g3t-output-private))))
(reject-category "RNG wrapper rejects wrong-kind input" 'invalid-argument
  (lambda () (g3t-generation-output-rng wrapped-input)))
(check "RNG wrapper header cut armed" (= 0 (g3t-test-fail-alloc-after 0)))
(reject-category "RNG wrapper header cut maps native failure" 'internal
  (lambda () (g3t-generation-output-rng wrapped-output)))
(check "RNG wrapper cut enrolls no live owner"
       (and (= 0 (live-rng-shells))
            (= 0 (g3t-test-live-rng-clones))
            (eq? (vector-ref (g3t-prefill-entry
                               wrapped-output 'output 'g3t-rng-cut) 2) 'live)
            (= 1 (g3t-test-output-state wrapped-native-output))
            (= 2 (g3t-test-output-word wrapped-native-output 2))
            (= 1729 (g3t-test-output-word wrapped-native-output 8))
            (= 0 (g3t-test-output-word wrapped-native-output 9))))
(check "RNG wrapper header cut disarmed"
       (= 0 (g3t-test-fail-alloc-after 9223372036854775807)))
(define wrapped-id-borrow (g3t-test-output-borrow-begin wrapped-native-output))
(check "RNG wrapper source ID borrow begins" (not (null? wrapped-id-borrow)))
(define wrapped-rng (g3t-generation-output-rng wrapped-output))
(define wrapped-rng-entry (g3t-prefill-entry wrapped-rng 'rng 'g3t-rng-test))
(define wrapped-rng-native (vector-ref wrapped-rng-entry 3))
(check "P2/G0 RNG wrapper owns detached kind-8 snapshot"
       (and (eq? (vector-ref wrapped-rng-entry 2) 'live)
            (eq? (vector-ref wrapped-rng-entry 4) #f)
            (eq? (vector-ref wrapped-rng-entry 5) #f)
            (eq? (vector-ref wrapped-rng-entry 10) #f)
            (= 1 (live-rng-shells))
            (= 1 (g3t-test-live-rng-clones))
            (rng-clone-words? wrapped-rng-native 1 1729 0 0)))
(check "RNG wrapper source ID borrow ends"
       (= 0 (g3t-test-output-borrow-end wrapped-id-borrow)))
(reject-category "tensor release rejects RNG wrapper" 'invalid-argument
  (lambda () (g3t-generation-tensor-release! wrapped-rng)))
(reject-category "RNG release rejects output wrapper" 'invalid-argument
  (lambda () (g3t-generation-rng-release! wrapped-output)))
(check "wrapped close" (g3t-generator-close! wrapped-generator))
(check "wrapped output release" (g3t-output-release! wrapped-output))
(check "P2/G0 RNG shell survives parent close and output release"
       (and (= 1 (live-rng-shells))
            (rng-clone-words? wrapped-rng-native 1 1729 0 0)))
(reject-category "RNG wrapper rejects dead output" 'invalid-state
  (lambda () (g3t-generation-output-rng wrapped-output)))
(check "RNG wrapper typed release and tombstone"
       (and (g3t-generation-rng-release! wrapped-rng)
            (= 0 (live-rng-shells))
            (= 0 (g3t-test-live-rng-clones))
            (= -1 (g3t-test-rng-clone-state wrapped-rng-native))
            (rng-clone-words? wrapped-rng-native 0 0 0 0)
            (g3t-generation-rng-release! wrapped-rng)))
(check "wrapped input release" (g3t-generation-tensor-release! wrapped-input))

;; The same zero-budget envelope remains valid for a one-token prompt.
(define p1-zero-generator (g3t-generator-create model tokenizer policy))
(define p1-zero-input (g3t-generation-t1-input-create t1-p1))
(define p1-zero-output (g3t-zero-generate! p1-zero-generator p1-zero-input))
(define p1-zero-native-output
  (vector-ref (g3t-prefill-entry p1-zero-output 'output 'g3t-p1-zero) 3))
(define p1-zero-clone (g3t-native-output-ids-clone p1-zero-native-output))
(define p1-zero-lengths
  (g3t-native-output-lengths-clone p1-zero-native-output))
(define p1-zero-cache-lengths
  (g3t-native-output-cache-lengths-clone p1-zero-native-output))
(define p1-zero-rng (g3t-native-output-rng-clone p1-zero-native-output))
(check "P1/G0 empty ID clone"
       (and (not (null? p1-zero-clone))
            (= 0 (g3t-test-clone-length p1-zero-clone))
            (= 1 (g3t-test-clone-state p1-zero-clone))))
(check "P1/G0 generated length clone"
       (and (not (null? p1-zero-lengths))
            (= 0 (g3t-test-lengths-clone-value p1-zero-lengths))))
(check "P1/G0 cache length clone is one"
       (and (not (null? p1-zero-cache-lengths))
            (= 1 (g3t-test-cache-lengths-clone-value
                   p1-zero-cache-lengths))))
(check "P1/G0 exact final RNG clone"
       (and (not (null? p1-zero-rng))
            (rng-clone-words? p1-zero-rng 1 1729 0 0)))
(define p1-zero-rng-shell (g3t-generation-output-rng p1-zero-output))
(define p1-zero-rng-shell-native
  (vector-ref (g3t-prefill-entry p1-zero-rng-shell 'rng 'g3t-p1-rng) 3))
(check "P1/G0 RNG wrapper exact copy"
       (rng-clone-words? p1-zero-rng-shell-native 1 1729 0 0))
(define p1-zero-rng-context (generator-from-rng p1-zero-rng 0))
(check "P1/G0 RNG constructor copies without draw"
       (and (not (null? p1-zero-rng-context))
            (= 1 (g3t-test-rng-word p1-zero-rng-context 0))
            (= 1729 (g3t-test-rng-word p1-zero-rng-context 1))
            (= 0 (g3t-test-rng-word p1-zero-rng-context 2))
            (= 0 (g3t-test-rng-word p1-zero-rng-context 3))
            (= 0 (g3t-test-cache-length p1-zero-rng-context))))
(check "P1/G0 RNG context close"
       (= 0 (g3t-native-generator-close p1-zero-rng-context)))
(check "P1/G0 output release" (g3t-output-release! p1-zero-output))
(check "P1/G0 close" (g3t-generator-close! p1-zero-generator))
(check "P1/G0 detached clone survives" (= 0 (g3t-test-clone-length p1-zero-clone)))
(check "P1/G0 detached length survives"
       (= 0 (g3t-test-lengths-clone-value p1-zero-lengths)))
(check "P1/G0 detached cache length survives"
       (= 1 (g3t-test-cache-lengths-clone-value p1-zero-cache-lengths)))
(check "P1/G0 detached RNG survives"
       (rng-clone-words? p1-zero-rng 1 1729 0 0))
(check "P1/G0 RNG shell survives parent releases"
       (rng-clone-words? p1-zero-rng-shell-native 1 1729 0 0))
(check "P1/G0 RNG shell typed release"
       (and (g3t-generation-rng-release! p1-zero-rng-shell)
            (= -1 (g3t-test-rng-clone-state p1-zero-rng-shell-native))))
(check "P1/G0 clone release" (= 0 (g3t-native-tensor-release p1-zero-clone)))
(check "P1/G0 lengths release"
       (= 0 (g3t-native-tensor-release p1-zero-lengths)))
(check "P1/G0 cache-length release"
       (= 0 (g3t-native-tensor-release p1-zero-cache-lengths)))
(check "P1/G0 RNG release"
       (and (= 0 (g3t-native-rng-release p1-zero-rng))
            (rng-clone-words? p1-zero-rng 0 0 0 0)
            (= 0 (g3t-native-rng-release p1-zero-rng))))
(check "P1/G0 input release" (g3t-generation-tensor-release! p1-zero-input))

(define abort-generator (g3t-generator-create model tokenizer policy))
(define abort-native
  (vector-ref (g3t-generator-find abort-generator 'g3t-p2-abort) 3))
(define abort-input (g3t-native-input-from-pair 65 66))
(check "abort acquire" (= 0 (g3t-native-call-acquire abort-native 2)))
(define abort-output (g3t-native-output-reserve abort-native 2))
(check "abort reserve" (not (null? abort-output)))
(check "abort P2 begin" (= 0 (g3t-native-frame-begin abort-native abort-input 1)))
(let roles ((ordinal 0))
  (if (= ordinal 21) #t
      (begin (check "abort P2 role" (= 0 (g3t-native-role-step abort-native ordinal)))
             (roles (+ ordinal 1)))))
(check "abort numeric" (= 0 (g3t-native-output-prepare
                               abort-native abort-output)))
(check "abort IDs" (= 0 (g3t-native-output-copy-decode-ids
                           abort-native abort-output (make-bytevector 0 0))))
(check "abort text" (= 0 (g3t-native-output-accept-text
                            abort-native abort-output (make-bytevector 0 0))))
(check "abort frame prepare" (= 0 (g3t-native-frame-prepare abort-native #f)))
(check "abort A2 cut armed" (= 0 (g3t-test-fail-a2-after 0)))
(check "abort preflight failure"
       (not (= 0 (g3t-native-call-prepare-end abort-native))))
(check "abort A2 cut disarmed"
       (= 0 (g3t-test-fail-a2-after 9223372036854775807)))
(check "abort preflight preserves old cache"
       (and (= 0 (g3t-test-output-state abort-output))
            (= 0 (g3t-test-cache-length abort-native))
            (= 14 (g3t-test-pin-count abort-native))))
(check "abort after failed preflight" (= 0 (g3t-native-call-abort abort-native)))
(check "abort rollback and pin drain"
       (and (= -1 (g3t-test-output-state abort-output))
            (= 0 (g3t-test-cache-length abort-native))
            (= 0 (g3t-test-pin-count abort-native))
            (= 0 (g3t-test-rng-word abort-native 2))))
(check "abort output tombstone release"
       (= 0 (g3t-native-output-release abort-output)))
(check "abort input release" (= 0 (g3t-native-tensor-release abort-input)))
(check "abort generator close" (g3t-generator-close! abort-generator))

(define g1-generator (g3t-generator-create model tokenizer policy-g1))
(define g1-native (vector-ref (g3t-generator-find g1-generator 'g3t-p2-g1) 3))
(define g1-input (g3t-generation-pair-input-create 65 66))
(check "P2/G1 rejected before pins"
       (and (guard (caught (#t caught))
              (g3t-p2-zero-generate! g1-generator g1-input) #f)
            (= 0 (g3t-test-pin-count g1-native))
            (= 0 (g3t-test-cache-length g1-native))
            (= 0 (g3t-test-rng-word g1-native 2))))
(check "G1 close" (g3t-generator-close! g1-generator))
(check "G1 input release" (g3t-generation-tensor-release! g1-input))

;; G1 runs through the same native object with P2 enabled.
(define g1-regression (g3t-generator-create model tokenizer policy-g1))
