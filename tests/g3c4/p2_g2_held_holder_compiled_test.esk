(load "g3c4_p2g2_terminal_held_holder_root.esk")

(extern i64 held-arm i64 :real et_g3c4_p2g2_held_test_arm_v1)
(extern i64 held-observe i64 :real et_g3c4_p2g2_held_test_observe_v1)
(extern i64 held-mark ptr i64 i64
        :real et_g3c4_p2g2_coordinator_test_mark_v1)
(extern i64 held-after-abort ptr i64
        :real et_g3c4_p2g2_coordinator_test_after_abort_v1)

(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "G3-C4 held-holder FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label
    (guard (caught (#t (transformer-error? caught)))
      (thunk) #f)))
(define (config eos)
  (list ':profile 'diagnostic-c4 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256
        ':top-p-bits 1065353216 ':max-new-tokens 2
        ':eos eos ':seed 7))
(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-model-create-seeded-internal 1729))
(define input
  (g3c4-p2g2-owned-input-create
    (t1-wave1-tokenizer-encode tokenizer (bytevector 0 255))))
(define args (command-line))
(define mode (car (cdr args)))
(if (not (or (string=? mode "normal")
             (string=? mode "repeat-busy")
             (string=? mode "postzero")))
    (exit 2))

(define (fresh eos kind phase)
  (let* ((generator (g3c4-generator-create-internal
                      model tokenizer (config eos)))
         (native (vector-ref
                   (g3c4-generator-entry-call-ready generator 'test) 3))
         (holder (g3c4-p2g2-holder-new-internal kind phase)))
    (vector generator native holder)))
(define (roots-clean? old-terminals old-originals old-records old-anchors
                      old-prefixes)
  (and (null? (vector-ref g3c4-p2g2-holder-roots 0))
       (eq? (vector-ref g3c4-p2g2-terminal-anchors 0) old-terminals)
       (eq? (vector-ref g3c4-p2g2-terminal-originals 0) old-originals)
       (eq? (vector-ref g3c4-p2g2-protected-records 0) old-records)
       (eq? (vector-ref g3c4-p2g2-protected-anchors 0) old-anchors)
       (eq? (vector-ref g3c4-p2g2-prefix-input-anchors 0) old-prefixes)))

(define (normal-case kind phase eos expected-count)
  (let* ((triple (fresh eos kind phase))
         (generator (vector-ref triple 0))
         (holder (vector-ref triple 2)))
    (check "arm normal" (= (held-arm 0) 0))
    (let* ((output (g3c4-p2g2-terminal-generate-held-internal
                     generator input holder))
           (snapshot (g3c4-p2g2-terminal-snapshot-internal output)))
      (check "authentic terminal count" (= (vector-ref snapshot 2) expected-count))
      (check "one genuine holder capture" (= (held-observe 1) 1))
      (check "normal holder does not abort"
             (and (= (held-observe 2) 0) (= (held-observe 3) 0)
                  (= (held-observe 4) 0)))
      (check "holder disposed before terminal zero"
             (and (eq? (vector-ref holder 5) 'dead)
                  (null? (vector-ref g3c4-p2g2-holder-roots 0))))
      (check "terminal release" (g3c4-p2g2-terminal-release-internal! output))
      (check "generator close" (g3c4-generator-close-internal! generator))
      (vector-ref snapshot 0))))

(define (wrong-handle)
  (let* ((triple (fresh #f 1 2))
         (generator (vector-ref triple 0))
         (holder (vector-ref triple 2))
         (generation (vector-ref holder 2))
         (old-records (vector-ref g3c4-p2g2-protected-records 0)))
    (vector-set! holder 2 (+ generation 1))
    (reject "wrong generation rejected before transfer"
      (lambda () (g3c4-p2g2-terminal-generate-held-internal
                   generator input holder)))
    (vector-set! holder 2 generation)
    (check "wrong handle did not enroll call"
           (and (eq? (vector-ref g3c4-p2g2-protected-records 0) old-records)
                (null? (vector-ref g3c4-p2g2-holder-roots 0))))
    (check "wrong handle remains caller-owned"
           (g3c4-p2g2-holder-dispose-unbound-internal! holder))
    (check "wrong-handle generator closes"
           (g3c4-generator-close-internal! generator))))

(define (p3-first-eos-reject eos)
  (let* ((triple (fresh eos 1 3))
         (generator (vector-ref triple 0))
         (holder (vector-ref triple 2))
         (old-terminals (vector-ref g3c4-p2g2-terminal-anchors 0))
         (old-originals (vector-ref g3c4-p2g2-terminal-originals 0))
         (old-records (vector-ref g3c4-p2g2-protected-records 0))
         (old-anchors (vector-ref g3c4-p2g2-protected-anchors 0))
         (old-prefixes (vector-ref g3c4-p2g2-prefix-input-anchors 0)))
    (check "arm first EOS P3 rejection" (= (held-arm 0) 0))
    (reject "P3 holder rejects first EOS before its capture"
      (lambda () (g3c4-p2g2-terminal-generate-held-internal
                   generator input holder)))
    (check "P3 first EOS did not acquire holder lease"
           (= (held-observe 1) 0))
    (check "P3 first EOS restored original ledgers"
           (roots-clean? old-terminals old-originals old-records
                         old-anchors old-prefixes))
    (check "P3 first EOS disposed bound holder"
           (eq? (vector-ref holder 5) 'dead))
    (check "P3 first EOS generator closes"
           (g3c4-generator-close-internal! generator))))

(define (retry-case kind phase)
  (let* ((triple (fresh #f kind phase))
         (generator (vector-ref triple 0))
         (native (vector-ref triple 1))
         (holder (vector-ref triple 2))
         (old-terminals (vector-ref g3c4-p2g2-terminal-anchors 0))
         (old-originals (vector-ref g3c4-p2g2-terminal-originals 0))
         (old-records (vector-ref g3c4-p2g2-protected-records 0))
         (old-anchors (vector-ref g3c4-p2g2-protected-anchors 0))
         (old-prefixes (vector-ref g3c4-p2g2-prefix-input-anchors 0)))
    (check "capture native rollback reference" (= (held-mark native 0 255) 0))
    (check "arm fault at HELD witness" (= (held-arm 1) 0))
    (reject "held fault rolls back same call"
      (lambda () (g3c4-p2g2-terminal-generate-held-internal
                   generator input holder)))
    (check "exact first typed busy and one end/retry"
           (and (= (held-observe 1) 1) (= (held-observe 2) 1)
                (= (held-observe 3) 1) (= (held-observe 4) 1)
                (= (held-observe 9) 1)))
    (check "native context rolled back"
           (= (held-after-abort native phase) 0))
    (check "original ledgers and holder root restored"
           (roots-clean? old-terminals old-originals old-records
                         old-anchors old-prefixes))
    (check "holder consumed after successful retry"
           (eq? (vector-ref holder 5) 'dead))
    (check "generator closes after retry"
           (g3c4-generator-close-internal! generator))))

(define first-id (normal-case 1 2 #f 2))
(if (string=? mode "normal")
    (begin
      (normal-case 2 2 #f 2)
      (normal-case 1 3 #f 2)
      (normal-case 2 3 #f 2)
      (normal-case 1 2 first-id 1)
      (normal-case 2 2 first-id 1)
      (p3-first-eos-reject first-id)
      (wrong-handle)
      (retry-case 1 2)
      (retry-case 2 2)
      (retry-case 1 3)
      (retry-case 2 3)
      (check "owned input release" (generation-tensor-release-internal! input))
      (display "G3-C4 held-holder compiled PASS: checks=")
      (display checks) (newline))
    (let* ((triple (fresh #f 1 2))
           (generator (vector-ref triple 0))
           (holder (vector-ref triple 2)))
      (check "arm destructive cut"
             (= (held-arm (if (string=? mode "repeat-busy") 2 3)) 0))
      (g3c4-p2g2-terminal-generate-held-internal generator input holder)
      (display "G3-C4 held-holder FAIL: destructive cut returned")
      (newline) (exit 99)))
