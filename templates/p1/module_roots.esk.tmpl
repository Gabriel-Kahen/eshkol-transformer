(define (live-owned-state-shell-for-entry entry-record raw-entry)
  (if (not (= (vector-length entry-record) 4))
      #f
      (let ((owner-state (vector-ref entry-record 3)))
  (let scan ((records shell-registry))
    (if (null? records)
        #f
        (let* ((record (car records))
               (kind (vector-ref record 1))
               (raw (vector-ref record 2)))
          (if (and (eq? kind 'state)
                   (eq? raw owner-state)
                   (not (eq? raw dead-state-raw))
                   (state-value? raw)
                   (let ((lifecycle (state-lifecycle raw)))
                     (and (eq? (vector-ref lifecycle 1) 'live)
                          (vector-ref lifecycle 2)))
                   (identity-member-local? raw-entry (vector-ref raw 6)))
              (vector-ref record 0)
              (scan (cdr records)))))))))

(define (unwrap-entry-items operation entries)
  (if (not (bounded-list-length entries max-state-entries))
      (fail 'invalid-argument operation
            "state entry input must be a bounded proper list" '())
      (let loop ((remaining entries) (result '()) (provenance '())
                 (proven? #t))
        (if (null? remaining)
            (vector unsafe-entry-input-tag (list-reverse result)
                    (if proven? (list-reverse provenance) #f))
            (let* ((value (car remaining))
                   (shell-record (shell-entry value))
                   (raw
                     (if shell-record
                         (raw-for-shell operation 'entry value)
                         value))
                   (owner-shell
                     (if shell-record
                         (live-owned-state-shell-for-entry shell-record raw)
                         #f)))
              (loop (cdr remaining) (cons raw result)
                    (if owner-shell
                        (cons (vector value owner-shell) provenance)
                        provenance)
                    (and proven? owner-shell)))))))

(define (wrap-entry-items operation state-shell state entries)
  (if (not (bounded-list-length entries max-state-entries))
      (fail 'internal operation "private state entry list is malformed" '())
      (let loop ((remaining entries) (result '()))
        (if (null? remaining)
            (list-reverse result)
            (loop (cdr remaining)
                  (cons (if (state-entry-value? (car remaining))
                            (state-entry-shell-for-raw
                              state-shell state (car remaining))
                            (car remaining))
                        result))))))

