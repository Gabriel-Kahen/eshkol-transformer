;;; Actual closed Scheme functions; native/P1/O2 dependencies are explicit doubles.
(use-modules (srfi srfi-1) (srfi srfi-34))
(define checks 0)
(define (check label value) (if value (set! checks (+ checks 1)) (error label)))
(define (reject? thunk) (guard (caught (#t #t)) (thunk) #f))
(define (cpu4-binding-fail . args) (raise args))
(define (o2-fail . args) (raise args))
(define (o2-native-fail operation) (raise (list 'native operation)))
(define (cpu4-binding-fail-stop code) (raise (list 'fail-stop code)))
(define o2-max-parameters 1365)
(define o2-provider-name 'provider)
(define (o2-member-identity? value values) (and (memq value values) #t))
(define o2-optimizers '())
(define events '())
(define fault #f)
(define live-state? #f)
(define live-context #f)
(define (event item) (set! events (append events (list item))))
(define handles (map (lambda (n) (vector 'handle n)) (iota 14)))
(define parsed (vector 'config (vector 0 0) (vector 0 0 0 0) #f 14))
(define assignments (map (lambda (h) (vector h (vector #f 1 2 3 4 5))) handles))
(define (o2-parse-config . args) parsed)
(define (o2-tree-paths . args) 'paths)
(define (o2-unique-handles . args) (vector handles 'paths))
(define (parameter-tree-tie-groups . args) 'aliases)
(define (o2-group-assignments . args) assignments)
(define (i2-bounded-list-length xs bound)
  (let loop ((xs xs) (n 0))
    (cond ((null? xs) n) ((or (not (pair? xs)) (= n bound)) #f)
          (else (loop (cdr xs) (+ n 1))))))
(define (o2-tr3-create-overlap-check-internal . args) 0)
(define (o2-state-projection-budget! . args) #t)
(define (tensor-provider-preflight-internal . args) #t)
(define (o2-make-identity . args) (vector 'optimizer-shell))
(define (o2-assignment-for-handle h a) (find (lambda (v) (eq? h (vector-ref v 0))) a))
(define (parameter-handle-tensor-internal h) h)
(define (i2-carrier-preflight . args) (vector #f #f 'parameter))
(define (o2-native-builder-create . args)
  (event 'builder-create)
  (check 'envelope-rooted-before-builder (and (pair? o2-optimizers) (not (vector-ref (car o2-optimizers) 1))))
  (if (eq? fault 'create) '() (vector 'builder)))
(define (o2-native-builder-set b index . args)
  (event index) (if (equal? fault index) 1 0))
(define (o2-native-builder-abort b) (event 'builder-abort) 0)
(define (o2-native-builder-finish b)
  (event 'builder-finish) (if (eq? fault 'finish) '() (vector 'native)))
(define (o2-require-optimizer operation shell)
  (or (find (lambda (r) (eq? shell (vector-ref r 0))) o2-optimizers) (raise 'foreign)))
(define (cpu4-owned-native-o2-preflight native diagnostic)
  (event 'preflight) (check 'null-diagnostic (null? diagnostic)) (if live-state? 1 0))
(define (cpu4-candidate-model-create-internal! config)
  (vector 'candidate (vector 'model (make-vector 17 'eval) (vector 17 29 43))))
(define (cpu4-candidate-model-internal c) (vector-ref c 1))
(define (module-parameters c) c)
(define binding-error (vector 'injected-binding-error))
(define context-error (vector 'injected-live-context-error))
(define (all-mode? model mode)
  (every (lambda (value) (eq? value mode)) (vector->list (vector-ref model 1))))
(define (module-eval! model)
  (vector-fill! (vector-ref model 1) 'eval)
  #t)
(define (binding-owner model)
  (find (lambda (r) (eq? model (cpu4-candidate-model-internal (vector-ref r 5))))
        (vector-ref cpu4-owned-candidates 0)))
(define (module-train! model)
  (event (list 'train model))
  (check 'train-under-busy-claim (vector-ref (binding-owner model) 12))
  (if (eq? fault 'train) (raise binding-error))
  (vector-fill! (vector-ref model 1) 'train)
  #t)
(define (cpu4-model-binding-create-internal model resolved)
  (event (list 'binding model resolved))
  (check 'binding-under-busy-claim (vector-ref (binding-owner model) 12))
  (check 'strict-binding-still-requires-all17-train (all-mode? model 'train))
  (if (eq? fault 'binding) (raise binding-error))
  ;; Genuine native context exclusion occurs only after strict TRAIN capture.
  (if live-context (raise context-error))
  (vector 'binding))
(define (cpu4-trainer-create-internal . args) (vector 'trainer))
(define (cpu4-model-binding-release-internal! binding) (event 'binding-release) #t)
(define (cpu4-trainer-detach-internal! trainer) (event 'detach) #t)
(define base-blocked? #f)
(define (cpu4-candidate-retire-owned-optimizer-internal! candidate optimizer)
  (event 'base-retire) (if base-blocked? (raise 'blocked)) #t)
(call-with-input-file "native/cpu4_candidate_children_extension.esk"
  (lambda (p) (let loop ()
    (let ((form (read p)))
      (unless (eof-object? form)
        (when (and (pair? form) (eq? (car form) 'define)) (eval form (current-module)))
        (loop))))))
(define (reset!)
  (set! o2-optimizers '()) (vector-set! cpu4-owned-candidates 0 '())
  (set! events '()) (set! fault #f) (set! live-state? #f)
  (set! live-context #f) (set! base-blocked? #f))
(define (ticket) (cpu4-owned-candidate-create-internal 'resolved))
(define (row t) (cpu4-owned-row t 'test))
(for-each
  (lambda (cut)
    (reset!) (let ((t (ticket)))
      (set! fault cut)
      (check 'construction-fault (reject? (lambda () (cpu4-owned-optimizer-create-internal! t 'config))))
      (check 'no-published-o2 (null? o2-optimizers))
      (check 'no-custody-on-failure (and (not (vector-ref (row t) 6)) (not (vector-ref (row t) 7))
                                       (not (vector-ref (row t) 8)) (not (vector-ref (row t) 14))))
      (check 'builder-abort-exactly-once (= (count (lambda (e) (eq? e 'builder-abort)) events)
                                          (if (eq? cut 'create) 0 1)))
      (set! fault #f)
      (check 'retry-create (cpu4-owned-optimizer-create-internal! t 'config))
      (check 'retire-after-retry (cpu4-owned-candidate-retire-internal! t))
      (check 'no-shell-admission (null? o2-optimizers))))
  (append '(create finish) (iota 14)))
(for-each
  (lambda (with-trainer?)
    (reset!) (let* ((t (ticket)) (opt (cpu4-owned-optimizer-create-internal! t 'config)))
      (cpu4-owned-binding-create-internal! t)
      (when with-trainer? (cpu4-owned-trainer-create-internal! t 'tokenizer 'dataset))
      (set! events '()) (set! live-state? #t)
      (check 'native-preflight-before-drain (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
      (check 'blocked-retains-live-binding (and (not (memq 'detach events)) (not (memq 'binding-release events))
                                               (not (vector-ref (row t) 11))))
      (set! live-state? #f) (set! base-blocked? #t) (set! events '())
      (check 'base-preflight-retry (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
      (check 'drain-recorded (vector-ref (row t) 11))
      (check 'optimizer-still-owned (eq? opt (vector-ref (car o2-optimizers) 0)))
      (set! base-blocked? #f)
      (check 'retry-after-drain (cpu4-owned-candidate-retire-internal! t))
      (check 'single-drain (= 1 (count (lambda (e) (eq? e (if with-trainer? 'detach 'binding-release))) events)))
      (check 'retired-idempotent (cpu4-owned-candidate-retire-internal! t))
      (check 'dead-shell-rejected (reject? (lambda () (o2-require-optimizer 'test opt))))))
  '(#f #t))
(for-each
  (lambda (head-first?)
    (reset!) (let* ((a (ticket)) (b (ticket))
                   (oa (cpu4-owned-optimizer-create-internal! a 'config))
                   (ob (cpu4-owned-optimizer-create-internal! b 'config))
                   (original-head o2-optimizers) (original-tail (cdr o2-optimizers)))
      (cpu4-owned-candidate-retire-internal! (if head-first? b a))
      (check 'unrelated-cons-preserved (eq? o2-optimizers (if head-first? original-tail original-head)))
      (check 'unrelated-shell-live (o2-require-optimizer 'test (if head-first? oa ob)))
      (cpu4-owned-candidate-retire-internal! (if head-first? a b))
      (check 'both-orders-empty (null? o2-optimizers)))) '(#f #t))
(reset!)
(let* ((t (ticket)) (o (cpu4-owned-optimizer-create-internal! t 'config)) (r (row t)))
  (set! o2-optimizers (cons (car o2-optimizers) o2-optimizers))
  (check 'duplicate-registry-rejects (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
  (check 'duplicate-before-drain (not (vector-ref r 11)))
  (set! o2-optimizers (cdr o2-optimizers))
  (let ((saved (vector-ref (vector-ref r 7) 5)))
    (vector-set! (vector-ref r 7) 5 (reverse saved))
    (check 'wrong-order-rejects (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
    (check 'wrong-order-before-drain (not (vector-ref r 11)))
    (vector-set! (vector-ref r 7) 5 saved))
  (cpu4-owned-candidate-retire-internal! t))
(for-each
  (lambda (same-shell?)
    (reset!)
    (let* ((t (ticket)) (o (cpu4-owned-optimizer-create-internal! t 'config))
           (original o2-optimizers) (owned (car original))
           (alias (vector (if same-shell? o (vector 'foreign-shell))
                          (if same-shell? (vector 'foreign-native) (vector-ref owned 1))
                          #f #f #f #f)))
      ;; Alias AFTER the exact owned row exercises the previously missed branch.
      (set-cdr! original (list alias))
      (check 'distinct-alias-rejects (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
      (check 'alias-before-drain (not (vector-ref (row t) 11)))
      (set-cdr! original '())
      (cpu4-owned-candidate-retire-internal! t))) '(#f #t))
(reset!)
(let* ((t (ticket)) (o (cpu4-owned-optimizer-create-internal! t 'config))
       (original o2-optimizers) (cycle (list (vector 'other 'native #f #f #f #f))))
  (set-cdr! cycle cycle) (set! o2-optimizers cycle)
  (check 'cyclic-missing-owned-rejects (reject? (lambda () (cpu4-owned-candidate-retire-internal! t))))
  (check 'cycle-before-drain (not (vector-ref (row t) 11)))
  (set! o2-optimizers original) (cpu4-owned-candidate-retire-internal! t))
(check 'foreign-ticket-rejects (reject? (lambda () (cpu4-owned-model-internal (vector 'foreign)))))
;;; Execute the actual closed binding helper against explicit mode/binding doubles.
(define (same-row-except? left saved exceptions)
  (every (lambda (index) (or (memv index exceptions)
                            (eq? (vector-ref left index) (list-ref saved index))))
         (iota 15)))
(reset!)
(let* ((t (ticket)) (r (row t)) (model (cpu4-owned-model-internal t))
       (saved (vector->list r)) (bits (vector->list (vector-ref model 2))))
  (check 'foreign-binding-rejects
         (reject? (lambda () (cpu4-owned-binding-create-internal! (vector 'foreign)))))
  (check 'foreign-before-mode-change (null? events))
  (check 'missing-o2-binding-rejects
         (reject? (lambda () (cpu4-owned-binding-create-internal! t))))
  (check 'missing-o2-before-mode-change (null? events))
  (vector-set! r 12 #t)
  (check 'busy-binding-rejects (reject? (lambda () (cpu4-owned-binding-create-internal! t))))
  (check 'busy-before-mode-change (null? events))
  (check 'busy-owner-claim-preserved (vector-ref r 12))
  (vector-set! r 12 #f)
  (check 'invalid-binding-keeps-authority (same-row-except? r saved '()))
  (check 'invalid-binding-keeps-mode-and-bits
         (and (all-mode? model 'eval)
              (equal? bits (vector->list (vector-ref model 2))))))
(for-each
  (lambda (cut)
    (reset!)
    (let* ((t (ticket)) (opt (cpu4-owned-optimizer-create-internal! t 'config))
           (r (row t)) (model (cpu4-owned-model-internal t))
           (other (ticket)) (other-model (cpu4-owned-model-internal other))
           (saved (vector->list r)) (registry o2-optimizers)
           (ordered-handles (vector->list (vector-ref r 13)))
           (raw-bits (vector-ref model 2)) (bits (vector->list raw-bits)))
      (set! events '()) (set! fault cut)
      (if (eq? cut 'context) (set! live-context (vector 'context model 'live)))
      (let ((caught (guard (caught (#t caught))
                      (cpu4-owned-binding-create-internal! t) #f)))
        (check 'binding-failure-rethrows-exact-error
               (eq? caught (if (eq? cut 'context) context-error binding-error))))
      (check 'binding-failure-clears-busy (not (vector-ref r 12)))
      (check 'binding-failure-keeps-exact-authority (same-row-except? r saved '()))
      (check 'binding-failure-keeps-o2-registry (eq? registry o2-optimizers))
      (check 'binding-failure-keeps-exact-ordered-handles
             (every (lambda (index) (eq? (vector-ref (vector-ref r 13) index)
                                        (list-ref ordered-handles index))) (iota 14)))
      (check 'binding-failure-keeps-model-bits
             (and (eq? raw-bits (vector-ref model 2))
                  (equal? bits (vector->list raw-bits))))
      (check 'failed-train-or-retained-train
             (all-mode? model (if (eq? cut 'train) 'eval 'train)))
      (check 'binding-failure-call-order
             (equal? events (if (eq? cut 'train) (list (list 'train model))
                               (list (list 'train model) (list 'binding model 'resolved)))))
      (check 'unrelated-candidate-stays-eval (all-mode? other-model 'eval))
      (check 'same-owned-model-reached-train (eq? model (cadr (car events))))
      (if (eq? cut 'context)
          (let ((context live-context))
            (check 'context-rejection-keeps-live-context
                   (and (eq? (vector-ref context 1) model)
                        (eq? (vector-ref context 2) 'live)))
            (check 'context-needs-explicit-eval (not (all-mode? model 'eval)))
            (module-eval! model)
            (check 'context-usable-after-explicit-eval
                   (and (eq? context live-context) (all-mode? model 'eval)
                        (eq? (vector-ref context 2) 'live)))
            ;; Caller closes its own context before retrying owned construction.
            (vector-set! context 2 'closed)
            (set! live-context #f)))
      (set! fault #f) (set! events '())
      (let ((binding (cpu4-owned-binding-create-internal! t)))
        (check 'same-model-train-before-strict-binding
               (equal? events (list (list 'train model) (list 'binding model 'resolved))))
        (check 'both-calls-use-exact-owned-model
               (and (eq? model (cadr (car events)))
                    (eq? model (cadr (cadr events)))))
        (check 'all17-mode-flags-trained (all-mode? model 'train))
        (check 'unrelated-candidate-not-trained (all-mode? other-model 'eval))
        (check 'retry-captures-exact-binding (eq? binding (vector-ref r 9)))
        (check 'retry-preserves-other-authority (same-row-except? r saved '(9)))
        (check 'retry-clears-busy (not (vector-ref r 12)))
        (check 'retry-keeps-exact-ordered-handles
               (every (lambda (index) (eq? (vector-ref (vector-ref r 13) index)
                                          (list-ref ordered-handles index))) (iota 14)))
        (check 'retry-keeps-model-bits
               (and (eq? raw-bits (vector-ref model 2))
                    (equal? bits (vector->list raw-bits))))
        (set! events '())
        (check 'duplicate-binding-rejects
               (reject? (lambda () (cpu4-owned-binding-create-internal! t))))
        (check 'duplicate-before-mode-change (null? events))
        (check 'duplicate-keeps-exact-binding (eq? binding (vector-ref r 9)))
        (check 'duplicate-keeps-authority (same-row-except? r saved '(9)))
        (check 'duplicate-keeps-mode (all-mode? model 'train)))
      (let* ((tokenizer (vector 'caller-tokenizer 'live))
             (dataset (vector 'caller-dataset 'live)))
        (cpu4-owned-trainer-create-internal! t tokenizer dataset)
        (cpu4-owned-candidate-retire-internal! t)
        (check 'caller-t2-d2-survive-owned-retirement
               (and (equal? tokenizer (vector 'caller-tokenizer 'live))
                    (equal? dataset (vector 'caller-dataset 'live)))))
      (cpu4-owned-candidate-retire-internal! other)))
  '(train binding context))
(format #t "CPU4 typed child custody host PASS: ~a checks; explicit nonnative doubles~%" checks)
