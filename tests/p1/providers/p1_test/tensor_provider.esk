    'storage-mutation-v1 fixture-storage-mutate-request))

(define (fixture-register-storage-asymmetric-provider-internal!)
  (fixture-register-storage-probe-provider-internal!
    'storage-asymmetric-v1 fixture-storage-asymmetric))

(define (fixture-register-storage-unstable-provider-internal!)
  (set! fixture-storage-unstable-value #f)
  (fixture-register-storage-probe-provider-internal!
    'storage-unstable-v1 fixture-storage-unstable))

(define (fixture-register-storage-nonreflexive-provider-internal!)
  (fixture-register-storage-probe-provider-internal!
    'storage-nonreflexive-v1 fixture-storage-nonreflexive))

(define (module-create-fixture-internal)
  (module-create-with-provider-internal fixture-provider-name))
