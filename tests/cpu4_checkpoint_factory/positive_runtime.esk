;;; Append after the ONE root-owned C2/K2/CPU4/children/factory aggregate and
;;; nonregional_runtime.esk. Call cpu4-factory-data-runtime! with actual raw-V256
;;; N1/T4 dataset directory and output .c2 path. No imports or identity roots.
;;; Artificial coherent DATA MOVEMENT witness: no training step/evaluator.
(extern void cpu4-fdt-o2-fail i64 :real et_o2_test_fail_alloc_after_v1)
(extern void cpu4-fdt-o2-reset :real et_o2_test_reset_failpoints_v1)
(define cpu4-fdt-checks 0)
(define (cpu4-fdt-check message good)
  (if good (set! cpu4-fdt-checks (+ cpu4-fdt-checks 1))
      (begin (display "CPU4 factory data FAIL: ") (display message) (newline) (exit 1))))
(define (cpu4-fdt-error? thunk)
  (guard (caught (#t (transformer-error? caught))) (thunk) #f))
(define (cpu4-fdt-invalid-state? thunk)
  (guard (caught (#t (and (transformer-error? caught)
                          (eq? (transformer-error-category caught) 'invalid-state))))
    (thunk) #f))
(define (cpu4-fdt-paths)
  (cpu4-checkpoint-vector->list g3c4-model-paths 14))
(define (cpu4-fdt-config seeded?)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        (if seeded? '(global-l2 "40000000") '(none))
        (if seeded? '(linear 2 10 "3e800000") '(constant))
        (list (list 'group (cpu4-fdt-paths)
                    (if seeded? "3e4ccccd" "3dcccccd")
                    "3f000000" "3f000000" "3a83126f" "00000000"))))
(define (cpu4-fdt-bytes elements plane)
  ;; Positive finite binary32 words, distinct by plane and element. The tied
  ;; secondary uses plane10 exactly; all 28 moment planes are nonzero.
  (let ((bytes (make-bytevector (* elements 4) 0)))
    (let element ((index 0))
      (if (= index elements) bytes
          (let byte ((part 0) (word (+ 1056964608 (* plane 4096) (modulo index 4096))))
            (if (= part 4) (element (+ index 1))
                (begin (bytevector-u8-set! bytes (+ (* index 4) part) (modulo word 256))
                       (byte (+ part 1) (quotient word 256)))))))))
(define (cpu4-fdt-primary-bytes)
  (let ((planes (make-vector 14 #f)))
    (let fill ((index 0))
      (if (= index 14) planes
          (begin (vector-set! planes index
                   (cpu4-fdt-bytes (cpu4-checkpoint-product (vector-ref g3c4-model-shapes index)) index))
                 (fill (+ index 1)))))))
(define (cpu4-fdt-moment-bytes)
  (let ((planes (make-vector 28 #f)))
    (let fill ((index 0))
      (if (= index 28) planes
          (begin (vector-set! planes index
                   (cpu4-fdt-bytes
                     (cpu4-checkpoint-product (vector-ref g3c4-model-shapes (quotient index 2)))
                     (+ 32 index)))
                 (fill (+ index 1)))))))
(define (cpu4-fdt-seed-p1 values)
  ;; Existing exact I2 decoder and P1 ownership adoption, not a substitute model.
  ;; C1's real decoder uses the same seven-field record/four-field envelope seam.
  (let ((ownership (vector '())))
    (let decode ((index 0) (records '()) (envelopes '()))
      (if (= index 15)
          (begin
            (vector-set! ownership 0 (o2-reverse envelopes))
            (state-dict-adopt-owned-internal!
              (o2-reverse records) '((("head" "weight") ("token_embedding" "weight")))
              i2-provider-name 2 0 ownership))
          (let* ((primary (if (= index 14) 10 index))
                 (path (if (= index 14) '("token_embedding" "weight")
                           (vector-ref g3c4-model-paths index)))
                 (shape (vector-ref g3c4-model-shapes primary))
                 (request (vector (vector-ref values primary) 'parameter shape 'f32 'cpu
                                  'dense-row-major-contiguous 'cpu4-factory-data #f)))
            (i2-checkpoint-decode request)
            (let ((carrier (vector-ref request 7)))
              (decode (+ index 1)
                (cons (vector path 'parameter shape 'f32 'cpu 'dense-row-major-contiguous carrier) records)
                (cons (vector carrier 'parameter 'cpu4-factory-data #f) envelopes))))))))
(define (cpu4-fdt-seed-o2 moments)
  (let ((entries (make-vector 14 #f)))
    (let fill ((index 0))
      (if (= index 14) #t
          (begin (vector-set! entries index
                   (vector (vector-ref g3c4-model-paths index) (vector-ref g3c4-model-shapes index)
                           (vector-ref moments (* index 2)) (vector-ref moments (+ (* index 2) 1))))
                 (fill (+ index 1)))))
    (let ((request (vector o2-c2-reconstruct-tag (cpu4-fdt-config #t) (cpu4-fdt-paths)
                           '((("head" "weight") ("token_embedding" "weight"))) 1 entries
                           'cpu4-factory-data #f)))
      (o2-state-reconstruct-internal request)
      (vector-ref request 7))))
(define (cpu4-fdt-controls trainer)
  (let ((parent (cpu4-trainer-control-begin-internal trainer 'snapshot)))
    (let ((copy (cpu4-trainer-controls-copy-internal parent)))
      (cpu4-trainer-control-end-internal! parent) copy)))
(define (cpu4-fdt-capture image)
  ;; All data and later metadata detached BEFORE exact C2 borrow end.
  (let* ((operation 'cpu4-factory-data)
         (borrow (c2-training-state-borrow-begin-internal image operation))
         (projection (c2-training-state-borrow-projection-internal borrow))
         (token (c2-training-state-borrow-owner-token-internal borrow operation))
         (p1 (vector-ref projection 0)) (o2 (vector-ref projection 1))
         (p1-data (state-dict-c2-owned-projection-internal p1 token operation))
         (entries (vector-ref p1-data 4)) (values (make-vector 14 #f))
         (moments (make-vector 28 #f)))
    (let value ((index 0) (remaining entries))
      (if (= index 14) #t
          (let* ((entry (car remaining))
                 (carrier (state-dict-c2-owned-tensor-borrow-begin-internal p1 token entry operation))
                 (shape (vector-ref g3c4-model-shapes index)))
            (vector-set! values index
              (c2-model-checkpoint-encode
                (vector carrier 'parameter shape 'f32 'cpu 'dense-row-major-contiguous operation)))
            (state-dict-c2-owned-tensor-borrow-end-internal p1 token entry operation)
            (value (+ index 1) (cdr remaining)))))
    (let moment ((index 0))
      (if (= index 28) #t
          (let* ((parameter (quotient index 2)) (kind (modulo index 2))
                 (elements (cpu4-checkpoint-product (vector-ref g3c4-model-shapes parameter)))
                 (bytes (make-bytevector (* elements 4) 0)))
            (o2-state-copy-moment-bits-c2-owned-internal
              (vector o2 parameter kind bytes elements token operation))
            (vector-set! moments index bytes)
            (moment (+ index 1)))))
    (let* ((controls (cpu4-checkpoint-controls-copy (vector-ref projection 2)))
           (source-o2 (vector-ref projection 4)) (source-topology (vector-ref projection 3))
           (metadata (vector (o2-copy-config-data operation (vector-ref source-o2 0))
                             (o2-copy-paths (vector-ref source-o2 1))
                             (o2-copy-aliases (vector-ref source-o2 2))
                             (vector-ref source-o2 3)))
           (topology (vector (o2-copy-paths (vector-ref source-topology 0))
                             (o2-copy-config-data operation (vector-ref source-topology 1))
                             (o2-copy-aliases (vector-ref source-topology 2))))
           (result (vector values moments controls metadata topology)))
      (c2-training-state-borrow-end-internal borrow)
      result)))
(define (cpu4-fdt-snapshot trainer)
  (let ((cell (vector #f)))
    (cpu4-trainer-snapshot-internal trainer cell)
    (vector-ref cell 0)))
(define (cpu4-fdt-capture-trainer trainer)
  (let* ((image (cpu4-fdt-snapshot trainer)) (copy (cpu4-fdt-capture image)))
    (c2-training-state-release-internal! image 'trainer-state-release!) copy))
(define (cpu4-fdt-planes=? left right count)
  (let compare ((index 0))
    (if (= index count) #t
        (and (d2-core-bytes=? (vector-ref left index) (vector-ref right index))
             (compare (+ index 1))))))
(define (cpu4-fdt-controls=? left right)
  (and (equal? (vector-ref left 0) (vector-ref right 0))
       (equal? (vector-ref left 1) (vector-ref right 1))
       (d2-core-bytes=? (vector-ref (vector-ref left 2) 0) (vector-ref (vector-ref right 2) 0))
       (d2-core-bytes=? (vector-ref (vector-ref left 2) 1) (vector-ref (vector-ref right 2) 1))
       (d2-core-bytes=? (vector-ref (vector-ref left 3) 0) (vector-ref (vector-ref right 3) 0))
       (string=? (vector-ref (vector-ref left 3) 1) (vector-ref (vector-ref right 3) 1))
       (equal? (vector-ref left 4) (vector-ref right 4))))
(define (cpu4-fdt-check-copy expected actual)
  (cpu4-fdt-check "all14 restored value planes" (cpu4-fdt-planes=? (vector-ref expected 0) (vector-ref actual 0) 14))
  (cpu4-fdt-check "all28 restored moment planes" (cpu4-fdt-planes=? (vector-ref expected 1) (vector-ref actual 1) 28))
  (cpu4-fdt-check "all controls and both cursors restored" (cpu4-fdt-controls=? (vector-ref expected 2) (vector-ref actual 2)))
  (cpu4-fdt-check "complete O2 config/schedule/update metadata restored" (equal? (vector-ref expected 3) (vector-ref actual 3)))
  (cpu4-fdt-check "complete topology and tie restored" (equal? (vector-ref expected 4) (vector-ref actual 4))))

;;; Test-only closed interposition: original accepted child functions still do
;;; every allocation/publication. Never rebind provider, codec, C2 reader or native
;;; bridge functions. Restore these entry names before regional/normal assertions.
(define cpu4-fdt-original-candidate cpu4-owned-candidate-create-internal)
(define cpu4-fdt-original-binding cpu4-owned-binding-create-internal!)
(define cpu4-fdt-original-trainer cpu4-owned-trainer-create-internal!)
;;; Test-only R7RS redefinitions give these three names mutable locations in
;;; pinned fe9. Capture the genuine original procedures ABOVE this point; each
;;; transparent body forwards exact arguments to that one original definition.
;;; No production source gains a hook or a second creator implementation.
(define (cpu4-owned-candidate-create-internal resolved)
  (cpu4-fdt-original-candidate resolved))
(define (cpu4-owned-binding-create-internal! child)
  (cpu4-fdt-original-binding child))
(define (cpu4-owned-trainer-create-internal! child tokenizer dataset)
  (cpu4-fdt-original-trainer child tokenizer dataset))
(define cpu4-fdt-cut 'none)
(define cpu4-fdt-observed-cut 'none)
(define cpu4-fdt-before-child 0)
(define (cpu4-fdt-candidate config)
  (let ((row (car (vector-ref cpu4-checkpoint-factories 0))))
    (cpu4-fdt-check "owned C2 released BEFORE actual candidate acquisition"
      (and (not (vector-ref row 11)) (not (vector-ref row 10))
           (= (vector-ref (c2-load-owner-counts-internal) 0) 0)
           (= (cpu4-factory-region-native-count 2) 0)))
    (set! cpu4-fdt-before-child (+ cpu4-fdt-before-child 1)))
  (let ((child (cpu4-fdt-original-candidate config)))
    (if (eq? cpu4-fdt-cut 'optimizer)
        (begin (cpu4-fdt-o2-fail 0) (set! cpu4-fdt-observed-cut 'optimizer)))
    child))
(define (cpu4-fdt-binding child)
  (let ((binding (cpu4-fdt-original-binding child)))
    (if (eq? cpu4-fdt-cut 'binding)
        (begin (set! cpu4-fdt-observed-cut 'binding)
               (cpu4-binding-fail 'internal 'cpu4-factory-data "test cut after actual binding enrollment")))
    binding))
(define (cpu4-fdt-trainer child tokenizer dataset)
  (let ((trainer (cpu4-fdt-original-trainer child tokenizer dataset)))
    (if (eq? cpu4-fdt-cut 'trainer)
        (begin (set! cpu4-fdt-observed-cut 'trainer)
               (cpu4-binding-fail 'internal 'cpu4-factory-data "test cut after actual trainer enrollment")))
    trainer))
(define (cpu4-fdt-restore-entries!)
  (set! cpu4-owned-candidate-create-internal cpu4-fdt-original-candidate)
  (set! cpu4-owned-binding-create-internal! cpu4-fdt-original-binding)
  (set! cpu4-owned-trainer-create-internal! cpu4-fdt-original-trainer)
  (cpu4-fdt-o2-reset))
(define (cpu4-fdt-create path policy report resolved tokenizer dataset recovery)
  (guard (caught (#t (cpu4-fdt-restore-entries!) (raise caught)))
    (set! cpu4-owned-candidate-create-internal cpu4-fdt-candidate)
    (set! cpu4-owned-binding-create-internal! cpu4-fdt-binding)
    (set! cpu4-owned-trainer-create-internal! cpu4-fdt-trainer)
    (let ((trainer (cpu4-checkpoint-factory-create-internal!
                     path policy report resolved tokenizer dataset recovery)))
      (cpu4-fdt-restore-entries!) trainer)))

(define (cpu4-factory-data-runtime! dataset-directory output-path)
  (cpu4-fdt-check "actual nonregional baseline" (null? (cpu4-checkpoint-native-current-region)))
  (let* ((resolved (x1-private-config-resolve (x1-private-config-parse
            "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
         (tokenizer (t2-wave2-tokenizer-byte resolved))
         (dataset (d2-token-dataset-open
           (list ':directory dataset-directory ':batch-size 1 ':sequence-length 4
                 ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
                 ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
                 ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer))
         (initial-cursor (cpu4-d2-cursor-capture-internal dataset))
         (policy (c2-persistence-policy-internal 16777216 524288 8388608 64 'cpu))
         (report (k2-public-capability-discover))
         (source (cpu4-owned-candidate-create-internal resolved)))
    (cpu4-owned-optimizer-create-internal! source (cpu4-fdt-config #f))
    (cpu4-owned-binding-create-internal! source)
    (let* ((trainer (cpu4-owned-trainer-create-internal! source tokenizer dataset))
           (initial-controls (cpu4-fdt-controls trainer))
           (fresh (cpu4-fdt-capture-trainer trainer))
           (values (cpu4-fdt-primary-bytes)) (moments (cpu4-fdt-moment-bytes))
           (batch (d2-token-dataset-next-batch dataset)))
      (cpu4-fdt-check "actual D2 batch exists" (not (d2-token-dataset-end? batch)))
      (d2-token-batch-release! batch)
      (let ((advanced (cpu4-d2-cursor-capture-internal dataset)))
        (cpu4-fdt-check "actual D2 cursor advanced" (not (d2-core-bytes=? advanced initial-cursor)))
        ;; Keep the source trainer's zero tuple coherent before its restore.
        (cpu4-d2-cursor-restore-internal! dataset initial-cursor)
        (vector-set! (vector-ref initial-controls 2) 0 advanced)
        (vector-set! initial-controls 4 (vector 4 1 0))
        (let* ((p1 (cpu4-fdt-seed-p1 values)) (o2 (cpu4-fdt-seed-o2 moments))
               (request (vector c2-training-state-compose-tag p1 o2 initial-controls 'cpu4-factory-data #f)))
          (c2-training-state-compose-internal request)
          (let ((seed (vector-ref request 5)))
            (cpu4-trainer-restore-internal! trainer seed)
            ;; ALL seed C2 owners close, not only the later saved snapshot.
            (c2-training-state-release-internal! seed 'trainer-state-release!))))
      (let* ((snapshot (cpu4-fdt-snapshot trainer)) (expected (cpu4-fdt-capture snapshot))
             (source-optimizer (vector-ref (cpu4-owned-row source 'cpu4-factory-data) 6))
             (schedule-bits (o2-optimizer-schedule-factor-bits-internal source-optimizer)))
        (cpu4-fdt-check "seeded source exactly matches all14 artificial values" (cpu4-fdt-planes=? values (vector-ref expected 0) 14))
        (cpu4-fdt-check "seeded source exactly matches all28 artificial moments" (cpu4-fdt-planes=? moments (vector-ref expected 1) 28))
        (let different ((index 0))
          (if (= index 14) #t
              (begin (cpu4-fdt-check "every source value plane differs from same-seed fresh initialization"
                       (not (d2-core-bytes=? (vector-ref (vector-ref fresh 0) index) (vector-ref values index))))
                     (different (+ index 1)))))
        (let different ((index 0))
          (if (= index 28) #t
              (begin (cpu4-fdt-check "every source moment plane differs from fresh zeros"
                       (not (d2-core-bytes=? (vector-ref (vector-ref fresh 1) index) (vector-ref moments index))))
                     (different (+ index 1)))))
        (cpu4-fdt-check "source native completed count is1" (= (o2-optimizer-completed-updates-internal source-optimizer) 1))
        (c2-public-checkpoint-save! snapshot output-path policy '(:overwrite? #t))
        (c2-training-state-release-internal! snapshot 'trainer-state-release!)
        (cpu4-fdt-check "source owns no seed/snapshot O2 state" (= (cpu4-factory-region-native-count 2) 0))
        (cpu4-owned-candidate-retire-internal! source)
        (cpu4-d2-cursor-restore-internal! dataset initial-cursor)
        ;; Real partial allocation/publication cuts. These are test-only closed
        ;; function interpositions, never a delivered extension API or callback.
        (let ((baseline (cpu4-factory-region-native-counts)))
          (let cuts ((remaining '(optimizer binding trainer)))
            (if (null? remaining) #t
                (let ((recovery (vector #f)))
                  (set! cpu4-fdt-cut (car remaining))
                  (set! cpu4-fdt-observed-cut 'none)
                  (cpu4-fdt-check "actual partial construction raises"
                    (cpu4-fdt-error? (lambda () (cpu4-fdt-create output-path policy report resolved tokenizer dataset recovery))))
                  (cpu4-fdt-check "expected exact native/publication cut was reached"
                    (eq? cpu4-fdt-observed-cut (car remaining)))
                  (cpu4-fdt-check "partial construction retains registered recovery ticket" (vector-ref recovery 0))
                  (cpu4-checkpoint-factory-retire-internal! (vector-ref recovery 0))
                  (cpu4-fdt-check "partial construction restores every native live count"
                    (cpu4-factory-region-counts=? baseline (cpu4-factory-region-native-counts) 6))
                  (cpu4-fdt-check "partial construction preserves caller initial cursor"
                    (d2-core-bytes=? initial-cursor (cpu4-d2-cursor-capture-internal dataset)))
                  (cpu4-fdt-check "partial construction preserves caller T2" (= (t2-wave2-tokenizer-vocab-size tokenizer) 256))
                  (cuts (cdr remaining))))))
        (set! cpu4-fdt-cut 'none)
        (let* ((recovery (vector #f))
               (restored (cpu4-fdt-create output-path policy report resolved tokenizer dataset recovery))
               (ticket (vector-ref recovery 0))
               (row (cpu4-checkpoint-factory-row ticket 'cpu4-factory-data))
               (child (vector-ref row 14))
               (owned (cpu4-owned-row child 'cpu4-factory-data))
               (binding (vector-ref owned 9)) (model (cpu4-owned-model-internal child))
               (optimizer (vector-ref owned 6))
               (record (cpu4-trainer-idle-check-internal restored 'cpu4-factory-data)))
          (cpu4-fdt-check "factory used actual before-child release observation" (>= cpu4-fdt-before-child 4))
          (cpu4-fdt-check "factory returns same retained canonical C4 model and binding"
            (and (eq? restored (vector-ref row 15)) (eq? model (vector-ref record 8))
                 (eq? binding (vector-ref record 9))
                 (not (vector-ref (vector-ref (cpu4-model-binding-check-internal binding) 3) 7))))
          (cpu4-fdt-check "caller T2/D2 identities preserved"
            (and (eq? tokenizer (vector-ref row 8)) (eq? dataset (vector-ref row 9))
                 (eq? dataset (vector-ref record 15))))
          (cpu4-fdt-check "owned loaded image and staging released" (and (not (vector-ref row 10)) (not (vector-ref row 11))))
          (cpu4-fdt-check-copy expected (cpu4-fdt-capture-trainer restored))
          (cpu4-fdt-check "native completed count restored" (= (o2-optimizer-completed-updates-internal optimizer) 1))
          (cpu4-fdt-check "native schedule factor restored" (= schedule-bits (o2-optimizer-schedule-factor-bits-internal optimizer)))
          (cpu4-fdt-check "caller cursor equals checkpoint current cursor"
            (d2-core-bytes=? (cpu4-d2-cursor-capture-internal dataset) (vector-ref (vector-ref (vector-ref expected 2) 2) 0)))
          (cpu4-factory-region-check-held-ticket! ticket)
          ;; A caller-owned genuine C2 snapshot is unrelated global O2 state.
          ;; Cleanup must retain exact live child/trainer and leave that image.
          (let* ((external (cpu4-fdt-snapshot restored))
                 (before (cpu4-factory-region-native-counts)))
            (cpu4-fdt-check "external genuine C2 state blocks factory retirement"
              (cpu4-fdt-invalid-state? (lambda () (cpu4-checkpoint-factory-retire-internal! ticket))))
            (cpu4-fdt-check "blocked cleanup keeps exact live child/trainer/binding"
              (and (eq? child (vector-ref row 14)) (eq? restored (vector-ref row 15))
                   (eq? record (cpu4-trainer-idle-check-internal restored 'cpu4-factory-data))
                   (cpu4-model-binding-check-internal binding)
                   (cpu4-factory-region-counts=? before (cpu4-factory-region-native-counts) 6)))
            (cpu4-fdt-check-copy expected (cpu4-fdt-capture external))
            (cpu4-fdt-check "caller checkpoint remains exact live owner"
              (eq? (vector-ref (c2-training-state-find external) 7) 'live))
            (c2-training-state-release-internal! external 'trainer-state-release!)
            (cpu4-checkpoint-factory-retire-internal! ticket)
            (cpu4-fdt-check "explicit retry consumed exact owned children" (and (eq? (vector-ref row 3) 'dead) (not (vector-ref row 14))))
            (cpu4-fdt-check "retirement idempotent" (cpu4-checkpoint-factory-retire-internal! ticket)))
          (cpu4-fdt-check "factory never retires caller T2" (= (t2-wave2-tokenizer-vocab-size tokenizer) 256))
          (cpu4-fdt-check "factory never retires caller D2" (cpu4-d2-cursor-capture-internal dataset))
          (cpu4-fdt-check "no native checkpoint/reader/fd ownership remains"
            (and (= (cpu4-factory-region-images) 0) (= (cpu4-factory-region-readers) 0)
                 (= (cpu4-factory-region-fds) 0) (= (cpu4-factory-region-native-count 2) 0)))
          ;; Fixture caller closes its own dataset only AFTER survival checks.
          (d2-token-dataset-close! dataset)
          (display "CPU4 artificial coherent FILE factory data movement PASS: checks=")
          (display cpu4-fdt-checks) (newline)
          #t)))))
