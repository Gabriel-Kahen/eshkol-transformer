;;; Append definitions after ONE actual CPU4 union and generated constructor.
;;; No roots/imports here; root supplies actual native shim/link wrappers.
(extern i64 cpu4bw-calibrate :real et_cpu4bw_calibrate)
(extern i64 cpu4bw-calibrated :real et_cpu4bw_calibrated)
(extern i64 cpu4bw-prepare i64 ptr :real et_cpu4bw_prepare)
(extern i64 cpu4bw-fresh :real et_cpu4bw_fresh)
(extern i64 cpu4bw-arm :real et_cpu4bw_arm)
(extern i64 cpu4bw-caught :real et_cpu4bw_caught)
(extern i64 cpu4bw-post :real et_cpu4bw_post)
(extern i64 cpu4bw-failure-attempts :real et_cpu4bw_failure_attempts)
(extern i64 cpu4bw-dead ptr :real et_cpu4bw_dead)
(extern i64 cpu4bw-finish i64 i64 i64 :real et_cpu4bw_finish)
(extern i64 cpu4bw-reserve i64 :real eshkol_runtime_reserve_exception_handlers_v1)
(define cpu4bw-original-capture (vector-ref (vector-ref p1-trusted-surface 74) 0))
(define cpu4bw-mode 0)
(define cpu4bw-model #f)
(define cpu4bw-owner #f)
(define cpu4bw-config #f)
(define (cpu4bw-check label good)
  (if (not good) (begin (display "CPU4 binding witness FAIL: ") (display label) (newline) (exit 71))))
(define (cpu4bw-pending-count)
  (let count-pending ((rows (vector-ref cpu4-model-bindings 0)) (count 0))
    (if (null? rows) count
        (count-pending (cdr rows)
          (+ count (if (and (eq? (vector-ref (car rows) 4) cpu4bw-owner)
                           (eq? (vector-ref (car rows) 1) 'pending)) 1 0))))))
(define (cpu4bw-owner-rows)
  (let owner-row-count ((rows (vector-ref cpu4-model-bindings 0)) (count 0) (dead 0))
    (if (null? rows) (vector count dead)
        (let ((ours (eq? (vector-ref (car rows) 4) cpu4bw-owner)))
          (owner-row-count (cdr rows) (+ count (if ours 1 0))
            (+ dead (if (and ours (eq? (vector-ref (car rows) 1) 'dead)) 1 0)))))))
;;; Explicit fixture-only P1 trusted-slot74 interposition. Genuine capture FIRST.
;;; It changes no provider, model, native lease or production constructor.
(define (cpu4bw-capture model supplied modules handles carriers)
  (let ((status (cpu4bw-original-capture model supplied modules handles carriers)))
    (cpu4bw-check "genuine strict P1 capture before injected reserve" (= status 0))
    (cpu4bw-post)
    ;; Bound is not inferred exhaustion: shim must observe actual handler malloc
    ;; failure and exact static condition5, or this experiment fails.
    (cpu4bw-reserve 129)
    (exit 72)))
(define (cpu4bw-dispatch)
  (if (= cpu4bw-mode 1)
      (cpu4bw-baseline-create cpu4bw-model cpu4bw-config)
      (cpu4-model-binding-create-internal cpu4bw-model cpu4bw-config)))
;;; Non-tail guarded recursion occupies free-list frames until malloc observed.
;;; Preserve each guard across its child call; bound128 is a failure cutoff.
(define (cpu4bw-scope depth)
  (guard (caught (#t (cpu4bw-caught)))
    (if (= (cpu4bw-fresh) 0)
        (if (< depth 128)
            (begin (cpu4bw-scope (+ depth 1)) (cpu4bw-fresh))
            (exit 73))
        (begin (cpu4bw-arm) (cpu4bw-dispatch) (exit 74)))))
(define (cpu4bw-baseline-retry-blocked?)
  (guard (caught (#t (and (transformer-error? caught)
                          (eq? (transformer-error-category caught) 'invalid-state)
                          (eq? (transformer-error-operation caught) 'cpu4-model-binding-create))))
    (cpu4bw-baseline-create cpu4bw-model cpu4bw-config) #f))
(define (cpu4bw-case mode)
  (set! cpu4bw-mode mode)
  (let* ((child (cpu4-owned-candidate-create-internal cpu4bw-config))
         (model (cpu4-owned-model-internal child)))
    (module-train! model)
    (set! cpu4bw-model model)
    (set! cpu4bw-owner (vector-ref (cpu4-binding-live-entry model 'cpu4bw) 3))
    (cpu4bw-check "fresh owner has no prior binding row"
      (equal? (cpu4bw-owner-rows) (vector 0 0)))
    (if (= mode 3) (vector-set! (vector-ref p1-trusted-surface 74) 0 cpu4bw-capture))
    (cpu4bw-prepare mode cpu4bw-owner)
    (cpu4bw-scope 0)
    ;; Restore genuine trusted closure BEFORE any retry, for every case.
    (vector-set! (vector-ref p1-trusted-surface 74) 0 cpu4bw-original-capture)
    (if (= mode 3)
        (cpu4bw-check "current published row retained DEAD before retry"
          (equal? (cpu4bw-owner-rows) (vector 1 1))))
    (let ((pending (cpu4bw-pending-count)))
      (cpu4bw-check "zero native lease attempts at allocation failure" (= (cpu4bw-failure-attempts) 0))
      (if (= mode 1)
          (begin
            (cpu4bw-check "baseline pending defect observed" (= pending 1))
            (cpu4bw-check "baseline same-model retry really rejects" (cpu4bw-baseline-retry-blocked?))
            (cpu4bw-finish mode pending 1)
            ;; BASELINE CONTROL ONLY: quarantine leaked pending authority AFTER
            ;; actual retry rejection; no repair-path result uses this mutation.
            (let quarantine-baseline ((rows (vector-ref cpu4-model-bindings 0)))
              (if (not (null? rows))
                  (if (and (eq? (vector-ref (car rows) 4) cpu4bw-owner)
                           (eq? (vector-ref (car rows) 1) 'pending))
                      (vector-set! (car rows) 1 'dead)
                      (quarantine-baseline (cdr rows))))))
          (begin
            (cpu4bw-check "repaired constructor leaves no pending authority" (= pending 0))
            (let* ((token (cpu4-model-binding-create-internal model cpu4bw-config))
                   (binding (cpu4-model-binding-check-internal token))
                   (lease (cpu4-model-binding-native-lease-internal token)))
              (cpu4bw-check "same-model/native-owner retry" (and
                (eq? model (vector-ref binding 2)) (eq? cpu4bw-owner (vector-ref binding 4))))
              (cpu4bw-check "real lease release" (cpu4-model-binding-release-internal! token))
              (cpu4bw-check "same released native lease rejects check" (= (cpu4bw-dead lease) 1))
              (cpu4bw-finish mode pending 0))))
      (cpu4-owned-candidate-retire-internal! child)
      #t)))
(define (cpu4-binding-witness-run)
  (set! cpu4bw-config (x1-private-config-resolve (x1-private-config-parse
    "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
  (guard (caught (#t (cpu4bw-calibrated))) (cpu4bw-calibrate))
  (cpu4bw-case 1)
  (cpu4bw-case 2)
  (cpu4bw-case 3)
  (display "CPU4-BINDING-WITNESS-PASS relocation=UNPROVEN retained-bytes=UNMEASURED") (newline)
  #t)
