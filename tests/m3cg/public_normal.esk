(require transformer.config)
(require transformer.diagnostic_transport)
(require transformer.model)
(define (m3cg-normal-check value) (if value #t (exit 1)))
(let* ((config (config-resolve (config-parse "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
       (model (diagnostic-model-create config (diagnostic-initializer-state 1729)))
       (input (diagnostic-input-create)))
  (m3cg-normal-check (diagnostic-input-copy! input '(3 197)))
  (let* ((output (model-forward model input)) (logits (model-output-logits output)))
    (m3cg-normal-check (= 2048 (bytevector-length (diagnostic-model-logits-bits logits))))
    (m3cg-normal-check (model-output-release! output))
    (m3cg-normal-check (diagnostic-model-logits-release! logits)))
  (m3cg-normal-check (diagnostic-input-release! input)))
(display "M3CG-NORMAL-PASS")
(newline)
