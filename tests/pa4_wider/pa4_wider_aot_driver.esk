(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 open-attention i32 ptr :real et_pa4_wider_aot_open)
(extern void close-attention ptr :real et_pa4_wider_aot_close)
(extern void store-f32 ptr i64 f64 :real et_pa4_wider_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_pa4_wider_aot_load_f32)
(extern i64 f32-bits ptr i64 :real et_pa4_wider_aot_f32_bits)
(extern void store-i64 ptr i64 i64 :real et_pa4_wider_aot_store_i64)
(extern void store-u8 ptr i64 i64 :real et_pa4_wider_aot_store_u8)
(extern i32 attention-forward ptr i64 i64 i64 i64 i64 i64 ptr ptr ptr ptr ptr ptr ptr
        :real et_pa4_wider_aot_forward)
(extern i32 attention-backward ptr i64 i64 i64 i64 i64 i64 ptr ptr ptr ptr ptr ptr ptr ptr ptr ptr
        :real et_pa4_wider_aot_backward)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define query-heads 4)
(define head-width 16)
(define query-width (* query-heads head-width))
(define max-tokens 64)

(define (require-check label ok)
  (unless ok
    (display label) (newline) (exit 1)))

(define (expect-status operation expected actual)
  (unless (= actual expected)
    (display operation) (display " expected status ") (display expected)
    (display ", received ") (display actual) (newline) (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "PA4-Wider workspace allocation failed" (not (= (ptr->usize p) 0)))
    p))

(define (discover variant)
  (let ((cell (checked-allocate 8)))
    (expect-status "PA4-Wider open" 0 (open-attention variant (ffi-pointer cell)))
    (let ((runtime (volatile-load ptr cell)))
      (release (ffi-pointer cell))
      runtime)))

(define reference (discover 0))
(define online (discover 1))

;; Four input spans followed by three result spans for each provider.
(define span-bytes (* 4 max-tokens query-width))
(define workspace (checked-allocate (* 10 span-bytes)))
(define q workspace)
(define k (ptr-add workspace span-bytes))
(define v (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define ref-a (ptr-add workspace (* 4 span-bytes)))
(define ref-b (ptr-add workspace (* 5 span-bytes)))
(define ref-c (ptr-add workspace (* 6 span-bytes)))
(define online-a (ptr-add workspace (* 7 span-bytes)))
(define online-b (ptr-add workspace (* 8 span-bytes)))
(define online-c (ptr-add workspace (* 9 span-bytes)))
(define query-positions (checked-allocate (* max-tokens 8)))
(define key-positions (checked-allocate (* max-tokens 8)))
(define keep-mask (checked-allocate (* max-tokens max-tokens)))

(define (call-forward runtime tokens kv-heads output)
  (attention-forward (ffi-pointer runtime) 1 query-heads kv-heads tokens tokens head-width
                     (ffi-pointer q) (ffi-pointer k) (ffi-pointer v)
                     (ffi-pointer query-positions) (ffi-pointer key-positions)
                     (ffi-pointer keep-mask) (ffi-pointer output)))

(define (call-backward runtime tokens kv-heads dq dk dv)
  (attention-backward (ffi-pointer runtime) 1 query-heads kv-heads tokens tokens head-width
                      (ffi-pointer q) (ffi-pointer k) (ffi-pointer v)
                      (ffi-pointer query-positions) (ffi-pointer key-positions)
                      (ffi-pointer keep-mask) (ffi-pointer upstream)
                      (ffi-pointer dq) (ffi-pointer dk) (ffi-pointer dv)))

(define (seed index salt scale)
  (* scale (- (modulo (+ (* 29 salt) (* 11 index) (quotient index 5)) 37) 18)))

(define (fill-fixture buffer count salt)
  (do ((i 0 (+ i 1)))
      ((= i count))
    (store-f32 (ffi-pointer buffer) i (seed i salt 0.0078125))))

(define (fill-metadata tokens)
  (do ((t 0 (+ t 1)))
      ((= t tokens))
    (store-i64 (ffi-pointer query-positions) t (* 2 t))
    (store-i64 (ffi-pointer key-positions) t (* 2 t))
    (do ((j 0 (+ j 1)))
        ((= j tokens))
      (store-u8 (ffi-pointer keep-mask) (+ (* t tokens) j)
                (if (or (= t 0) (= (modulo (+ (* 3 t) j) 11) 0)) 0 1)))))

(define (max-forward-diff count)
  (let ((largest 0.0))
    (do ((i 0 (+ i 1)))
        ((= i count) largest)
      (let* ((a (load-f32 (ffi-pointer ref-a) i))
             (b (load-f32 (ffi-pointer online-a) i))
             (diff (abs (- a b))))
        (require-check "PA4-Wider forward difference exceeds 2e-7"
                       (<= diff 0.0000002))
        (when (> diff largest)
          (set! largest diff))))))

(define (check-gradient-bits label first second count)
  (let ((active #f))
    (do ((i 0 (+ i 1)))
        ((= i count) (require-check "PA4-Wider parity gradient is inactive" active))
      (let ((bits (f32-bits (ffi-pointer first) i)))
        (require-check label (= bits (f32-bits (ffi-pointer second) i)))
        (when (and (not (= bits 0)) (not (= bits 2147483648)))
          (set! active #t))))))

(define (check-parity tokens kv-heads)
  (let ((q-count (* tokens query-width))
        (kv-count (* tokens kv-heads head-width)))
    (fill-metadata tokens)
    (fill-fixture q q-count 1)
    (fill-fixture k kv-count 2)
    (fill-fixture v kv-count 3)
    (fill-fixture upstream q-count 4)
    (expect-status "reference forward" 0 (call-forward reference tokens kv-heads ref-a))
    (expect-status "online forward" 0 (call-forward online tokens kv-heads online-a))
    (let ((diff (max-forward-diff q-count)))
      (expect-status "reference backward" 0
                     (call-backward reference tokens kv-heads ref-a ref-b ref-c))
      (expect-status "online backward" 0
                     (call-backward online tokens kv-heads online-a online-b online-c))
      (check-gradient-bits "PA4-Wider dQ bit mismatch" ref-a online-a q-count)
      (check-gradient-bits "PA4-Wider dK bit mismatch" ref-b online-b kv-count)
      (check-gradient-bits "PA4-Wider dV bit mismatch" ref-c online-c kv-count)
      (display "PA4-Wider AOT PARITY ") (display tokens) (display " ")
      (display kv-heads) (display " ") (display (number->string diff))
      (display " dQ=") (display q-count) (display " dK=") (display kv-count)
      (display " dV=") (display kv-count) (display " bitwise=PASS") (newline))))

(define (check-malformed runtime)
  (store-f32 (ffi-pointer online-a) 0 7.0)
  (store-f32 (ffi-pointer online-b) 0 7.0)
  (store-f32 (ffi-pointer online-c) 0 7.0)
  ;; Exercise misaligned pointer rejection through Eshkol's raw-pointer FFI.
  (let ((cell (checked-allocate 16)))
    (expect-status "misaligned open" 1 (open-attention 1 (ptr-add cell 1)))
    (release (ffi-pointer cell)))
  (expect-status "misaligned backward dQ" 1
                 (attention-backward (ffi-pointer runtime) 1 query-heads 1 32 32 head-width
                                     (ffi-pointer q) (ffi-pointer k) (ffi-pointer v)
                                     (ffi-pointer query-positions) (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer upstream)
                                     (ptr-add online-a 1) (ffi-pointer online-b)
                                     (ffi-pointer online-c)))
  ;; K1 rejects the head pair, then the provider rejects the mask and positions.
  (expect-status "nondivisible head pair" 6 (call-forward runtime 32 3 online-a))
  (store-u8 (ffi-pointer keep-mask) 0 2)
  (expect-status "nonboolean keep mask" 1
                 (call-backward runtime 32 1 online-a online-b online-c))
  (store-u8 (ffi-pointer keep-mask) 0 0)
  (store-i64 (ffi-pointer key-positions) 1 0)
  (expect-status "duplicate key position" 1 (call-forward runtime 32 1 online-a))
  (store-i64 (ffi-pointer key-positions) 1 2)
  (require-check "malformed dispatch changed an output"
                 (and (= (load-f32 (ffi-pointer online-a) 0) 7.0)
                      (= (load-f32 (ffi-pointer online-b) 0) 7.0)
                      (= (load-f32 (ffi-pointer online-c) 0) 7.0))))

(define training-tokens 32)
(define model-width 16)
(define inverse-elements (/ 1.0 (* training-tokens query-width)))
(define learning-rate 16.0)
(define steps 12)

(define (seed-tensor rows cols salt scale)
  (let ((tensor (zeros (list rows cols))))
    (do ((r 0 (+ r 1)))
        ((= r rows) tensor)
      (do ((c 0 (+ c 1)))
          ((= c cols))
        (tensor-set! tensor r c (seed (+ (* r cols) c) salt scale))))))

;; The projection is token-major. K1 uses [head,token,feature] for N=1.
(define (head-offset head token feature)
  (+ (* (+ (* head training-tokens) token) head-width) feature))

(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t training-tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (store-f32 (ffi-pointer buffer) (head-offset h t d)
                   (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list training-tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t training-tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (load-f32 (ffi-pointer buffer) (head-offset h t d))))))))

(define (layer-loss weights x target gradients)
  (pack-heads (matmul x (vector-ref weights 0)) query-heads q)
  (pack-heads (matmul x (vector-ref weights 1)) 1 k)
  (pack-heads (matmul x (vector-ref weights 2)) 1 v)
  (expect-status "training forward" 0 (call-forward online training-tokens 1 online-a))
  (let* ((delta (tensor-sub (unpack-heads online-a query-heads) target))
         (loss (* 0.5 inverse-elements (tensor-sum (tensor-mul delta delta)))))
    (when gradients
      (pack-heads (tensor-scale delta inverse-elements) query-heads upstream)
      (expect-status "training backward" 0
                     (call-backward online training-tokens 1 online-a online-b online-c))
      (let ((xt (transpose x)))
        (vector-set! gradients 0 (matmul xt (unpack-heads online-a query-heads)))
        (vector-set! gradients 1 (matmul xt (unpack-heads online-b 1)))
        (vector-set! gradients 2 (matmul xt (unpack-heads online-c 1)))))
    loss))

(define (check-projection-gradient weights x target gradient parameter row col)
  (let* ((weight (vector-ref weights parameter))
         (original (tensor-get weight row col))
         (step 0.03125)
         (analytic (tensor-get (vector-ref gradient parameter) row col)))
    (tensor-set! weight row col (+ original step))
    (let ((plus (layer-loss weights x target #f)))
      (tensor-set! weight row col (- original step))
      (let ((minus (layer-loss weights x target #f)))
        (tensor-set! weight row col original)
        (let ((numeric (/ (- plus minus) (* 2.0 step))))
          (require-check "PA4-Wider projection central difference failed"
                         (<= (abs (- analytic numeric))
                             (+ 0.00000002 (* 0.01 (abs numeric))))))))))

(define (print-loss step loss)
  (display "PA4-Wider AOT LOSS ") (display step) (display " ")
  (display (number->string loss)) (newline))

(define (train)
  (fill-metadata training-tokens)
  (let* ((x (seed-tensor training-tokens model-width 11 0.03125))
         (target (seed-tensor training-tokens query-width 12 0.015625))
         (weights (vector (seed-tensor model-width query-width 21 0.015625)
                          (seed-tensor model-width head-width 22 0.015625)
                          (seed-tensor model-width head-width 23 0.015625)))
         (gradients (make-vector 3 #f))
         (initial (layer-loss weights x target gradients)))
    (do ((p 0 (+ p 1)))
        ((= p 3))
      (require-check "PA4-Wider training projection gradient is inactive"
                     (> (tensor-sum (tensor-abs (vector-ref gradients p))) 0.00000001))
      (check-projection-gradient weights x target gradients p 0 0)
      (check-projection-gradient weights x target gradients p 7 9))
    (print-loss 0 initial)
    (do ((step 1 (+ step 1))
         (previous initial))
        ((> step steps))
      (do ((p 0 (+ p 1)))
          ((= p 3))
        (let* ((gradient (vector-ref gradients p))
               (updated (tensor-sub (vector-ref weights p)
                                    (tensor-scale gradient learning-rate))))
          (vector-set! weights p updated)))
      (let ((current (layer-loss weights x target gradients)))
        (require-check "PA4-Wider training loss failed to decrease"
                       (and (>= current 0.0) (< current previous)))
        (print-loss step current)
        (set! previous current)))
    (display "PA4-Wider AOT TRAIN MQA steps=12 gradients=6 PASS") (newline)))

(check-parity 16 2)
(check-parity 32 1)
(check-malformed reference)
(check-malformed online)
(display "PA4-Wider AOT malformed statuses PASS") (newline)
(check-parity 64 2)
(train)
(close-attention (ffi-pointer reference))
(close-attention (ffi-pointer online))
(release (ffi-pointer workspace))
(release (ffi-pointer query-positions))
(release (ffi-pointer key-positions))
(release (ffi-pointer keep-mask))
