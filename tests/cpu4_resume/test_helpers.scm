;;; Execute actual comparison and cleanup helpers; explicit host doubles only.
(use-modules (rnrs bytevectors) (rnrs exceptions))
(define (select-definitions path names)
  (call-with-input-file path
    (lambda (port)
      (let read-helper-forms ()
        (let ((form (read port)))
          (if (not (eof-object? form))
              (begin
                (if (and (pair? form) (eq? (car form) 'define)
                         (memq (if (pair? (cadr form)) (caadr form) (cadr form)) names))
                    (eval form (current-module)))
                (read-helper-forms))))))))
(select-definitions "internal/d2/lib/d2_semantic_core.esk" '(d2-core-bytes=?))
(select-definitions "tests/cpu4_heldout/body.esk" '(heldout-controls=?))
(select-definitions "tests/cpu4_resume/body.esk"
  '(cpu4-resume-values=? cpu4-resume-copy=? cpu4-resume-plane-size cpu4-resume-capture-cleanup! cpu4-resume-cleanup!))
(define checks 0)
(define (check condition)
  (if (not condition) (error "resume helper check failed" checks))
  (set! checks (+ checks 1)))
(define (planes count)
  (let ((result (make-vector count #f)))
    (let make-host-planes ((index 0))
      (if (= index count) result
          (begin (vector-set! result index (u8-list->bytevector (list index 1 2 3)))
                 (make-host-planes (+ index 1)))))))
(define (controls)
  (vector (vector 'philox4x32-10 1 1729 0 0) (vector "raw" 256)
          (vector (u8-list->bytevector '(1 2)) (u8-list->bytevector '(3 4)))
          (vector (u8-list->bytevector '(5 6)) "fingerprint") (vector 500 125 124)))
(define (copy)
  (vector (planes 14) (planes 28) (controls)
          (vector '(config "3dcccccd" (constant)) '(("path")) '((tie)) 125)
          (vector '(("path")) '((4 4)) '((tie)))))
(define expected (copy))
(check (cpu4-resume-copy=? expected (copy)))
(check (= (cpu4-resume-plane-size (vector-ref expected 0) 14) 56))
(for-each
  (lambda (slot)
    (let mutate-each-plane ((index 0))
      (if (< index (cdr slot))
          (let ((bad (copy)))
            (bytevector-u8-set! (vector-ref (vector-ref bad (car slot)) index) 3 99)
            (check (not (cpu4-resume-copy=? expected bad)))
            (mutate-each-plane (+ index 1))))))
  '((0 . 14) (1 . 28)))
(for-each
  (lambda (slot)
    (let ((bad (copy)))
      (bytevector-u8-set! (vector-ref (vector-ref (vector-ref bad 2) (car slot)) (cadr slot)) 1 99)
      (check (not (cpu4-resume-copy=? expected bad)))))
  '((2 0) (2 1) (3 0)))
(for-each
  (lambda (slot)
    (let ((bad (copy)))
      (vector-set! (vector-ref (vector-ref bad 2) (car slot)) (cadr slot)
        (if (or (= (car slot) 1) (= (car slot) 3)) "changed" 999))
      (check (not (cpu4-resume-copy=? expected bad)))))
  '((0 2) (1 0) (3 1) (4 0) (4 1) (4 2)))
(for-each
  (lambda (slot)
    (let ((bad (copy)))
      (vector-set! (vector-ref bad (car slot)) (cdr slot) '(changed))
      (check (not (cpu4-resume-copy=? expected bad)))))
  '((3 . 0) (3 . 1) (3 . 2) (3 . 3) (4 . 0) (4 . 1) (4 . 2)))
;;; Native owner calls are doubles; these test actual helper ordering/clearing.
(define events '())
(define (event name) (set! events (append events (list name))))
(define (cpu4-binding-fail-stop status) (throw 'fixture-failstop status))
(define (state-dict-c2-owned-tensor-borrow-end-internal p1 token entry operation) (event 'tensor-end))
(define (c2-training-state-borrow-end-internal borrow) (event 'C2-end))
(define borrow-cleanup (vector 'borrow (vector 'p1 'token 'entry)))
(cpu4-resume-capture-cleanup! borrow-cleanup)
(check (equal? events '(tensor-end C2-end)))
(check (equal? borrow-cleanup (vector #f #f)))
(define (c2-training-state-release-internal! image operation) (event 'image-release))
(define (cpu4-checkpoint-factory-retire-internal! ticket) (event 'B-retire))
(define (cpu4-owned-candidate-retire-internal! ticket) (event 'A-retire))
(define (heldout-live-owned) 0)
(set! events '())
(define ledger (vector 'A (vector 'B) (vector 'image)))
(cpu4-resume-cleanup! ledger)
(check (equal? events '(image-release B-retire A-retire)))
(check (not (vector-ref (vector-ref ledger 2) 0)))
(display "CPU4 resume actual comparison/cleanup helpers with doubles PASS: checks=")
(display checks) (newline)
