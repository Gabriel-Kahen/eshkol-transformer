;;; Noninstalled five-layout entry through the ordinary boxed private runner.
(extern void e3-private-test-run ptr ptr ptr :real et_e3_test_run_v1)

(define (check label value)
  (if value #t
      (begin (display "E3-NUMERICAL-FAIL: ") (display label)
             (newline) (exit 1))))

(define (emit-bytes value)
  (let loop ((index 0))
    (if (< index (bytevector-length value))
        (begin
          (if (> index 0) (display ","))
          (display (bytevector-u8-ref value index))
          (loop (+ index 1))))))

(define args (command-line))
(check 'arguments
  (and (pair? args) (pair? (cdr args)) (pair? (cdr (cdr args)))
       (null? (cdr (cdr (cdr args))))))
(define name (list-ref args 1))
(define packed?
  (or (string=? name "packed-single")
      (string=? name "packed-sharded")
      (string=? name "packed-suffix")))
(check 'case (or packed? (string=? name "unpacked-three")
                 (string=? name "unpacked-pairs")))
(define skipped (if (string=? name "packed-suffix") 1 0))
(define output (vector #f))
(e3-private-test-run (vector (vector packed? skipped))
                     (vector (list-ref args 2)) output)
(define result (vector-ref output 0))
(check 'result
  (and (vector? result) (= (vector-length result) 9)
       (eq? (vector-ref result 0) 'e3-private-result-v1)
       (integer? (vector-ref result 5))
       (integer? (vector-ref result 6))
       (bytevector? (vector-ref result 7))
       (bytevector? (vector-ref result 8))))
(display "E3RESULT\t")
(let loop ((index 1))
  (if (< index 7)
      (begin
        (if (> index 1) (display ","))
        (display (vector-ref result index))
        (loop (+ index 1)))))
(display "\t") (emit-bytes (vector-ref result 7))
(display "\t") (emit-bytes (vector-ref result 8))
(newline)
(display "E3-NUMERICAL-RUNTIME-PASS") (newline)
