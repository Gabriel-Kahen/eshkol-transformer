(load "c2_save_image_receipt_root.esk")

(extern i64 c2-image-live-bytes
        :real et_c2_private_save_image_live_bytes_v1)
(extern void c2-image-test-corrupt i64 i64
        :real et_c2_private_save_image_test_corrupt_v1)
(extern void c2-image-io-reset :real et_checkpoint_io_test_reset_v1)
(extern void c2-image-io-fail i64 i64 i64
        :real et_checkpoint_io_test_fail_v1)
(extern i64 c2-image-region-depth :real eshkol_region_mark)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "C2 IMAGE FAIL: ") (display label) (newline) (exit 1))))
(define (expect-error label category thunk)
  (let ((captured #f))
    (guard (raised (#t (set! captured raised) #f)) (thunk))
    (check label
      (and (transformer-error? captured)
           (eq? category (transformer-error-category captured))
           (eq? 'checkpoint-save! (transformer-error-operation captured))))
    captured))
(define (expect-false label thunk)
  (let ((caught? #f))
    (guard (raised (#t (set! caught? (eq? raised #f)) #f)) (thunk))
    (check label caught?)))
(define (details-ref details key)
  (cond ((null? details) #f)
        ((eq? (car (car details)) key) (car (cdr (car details))))
        (else (details-ref (cdr details) key))))
(define (same-bytes? a b)
  (and (= (bytevector-length a) (bytevector-length b))
       (let loop ((i 0))
         (if (= i (bytevector-length a)) #t
             (and (= (bytevector-u8-ref a i) (bytevector-u8-ref b i))
                  (loop (+ i 1)))))))

(define fingerprint
  "sha256:eshkol-bpe-tokenizer-v1:1866ebedd76bf7d0e8e111ab25603a99aee927ea341e1305e4bb2c145648eb72")
(define config-fingerprint
  "sha256:eshkol-config-json-v1:337a2ea0be86b3fccf13a90c895e8a5fe42f94a270395940ac90c41f7cc67ceb")
(define canonical
  (string->utf8
    (string-append
      "{\"canonicalization\":\"eshkol-config-json-v1\",\"checksum-algorithm\":\"sha256\",\"checksum-coverage\":\"whole-document-including-final-lf\",\"config-schema-version\":[1,0],\"format\":\"eshkol-resolved-run\",\"format-version\":[1,0],\"limits\":{\"integer-digits\":19,\"max-input-bytes\":16384,\"max-input-keys\":14,\"max-input-nesting-depth\":1},\"provenance\":{"
      "\"config-schema-major\":\"input\",\"config-schema-minor\":\"input\",\"model.context-length\":\"input\",\"model.device\":\"default\",\"model.dtype\":\"default\",\"model.head-size\":\"derived\",\"model.hidden-size\":\"input\",\"model.kv-head-count\":\"default\",\"model.layer-count\":\"input\",\"model.query-head-count\":\"input\",\"model.vocabulary-size\":\"input\",\"run.deterministic\":\"default\",\"run.seed\":\"input\",\"training.accumulation-steps\":\"default\"},"
      "\"required-features\":[],\"resolved\":{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":128,\"model.device\":\"cpu\",\"model.dtype\":\"f32\",\"model.head-size\":16,\"model.hidden-size\":64,\"model.kv-head-count\":4,\"model.layer-count\":2,\"model.query-head-count\":4,\"model.vocabulary-size\":263,\"run.deterministic\":true,\"run.seed\":1729,\"training.accumulation-steps\":1}}\n")))

(define (optimizer-config path)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        '(none) '(constant)
        (list (list 'group (list path)
                    "3dcccccd" "3f000000" "3f000000"
                    "3a83126f" "00000000"))))
(define (make-o2 path shape completed)
  (let* ((elements
           (let loop ((remaining shape) (product 1))
             (if (null? remaining) product
                 (loop (cdr remaining) (* product (car remaining))))))
         (request
           (vector o2-c2-reconstruct-tag (optimizer-config path) (list path)
                   '() completed
                   (vector
                     (vector path shape
                             (make-bytevector (* elements 4) 0)
                             (make-bytevector (* elements 4) 0)))
                   'checkpoint-load #f)))
    (o2-state-reconstruct-internal request)
    (vector-ref request 7)))
(define (make-p1)
  (let* ((module (i2-module-create-internal))
         (parameter (i2-parameter-create-uniform-internal 4 0)))
    (i2-module-register-parameter-internal! module "weight" parameter)
    (module-state-dict module)))

(define args (command-line))
(define tokenizer-path (car (cdr args)))
(define resource-root (car (cdr (cdr args))))
(define output-root (car (cdr (cdr (cdr args)))))
(define mode (car (cdr (cdr (cdr (cdr args))))))
(define tokenizer-policy
  (c1-wave2-persistence-policy 1048576 1048576 1048576 8 'cpu))
(define tokenizer (t2-wave2-tokenizer-load tokenizer-path tokenizer-policy))
(check "fixture fingerprint"
       (string=? fingerprint (t2-private-tokenizer-fingerprint tokenizer)))
(define dataset
  (d2-token-dataset-open
    (list ':directory (string-append resource-root "/small")
          ':batch-size 1 ':sequence-length 1
          ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
          ':maximum-total-tokens 65536 ':maximum-batch-bytes 17
          ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f)
    tokenizer))
(define cursor (d2-token-dataset-cursor dataset))
(d2-token-dataset-close! dataset)
(define (controls completed)
  (vector
    (vector 'philox4x32-10 1 1729 -1 -9223372036854775808)
    (vector fingerprint 263)
    (vector (bytevector-copy cursor 0 (bytevector-length cursor))
            (bytevector-copy cursor 0 (bytevector-length cursor)))
    (vector (bytevector-copy canonical 0 (bytevector-length canonical))
            config-fingerprint)
    (vector 99 completed 3)))
(define (make-owner)
  (let* ((p1 (make-p1))
         (o2 (make-o2 '("weight") '(4) 17))
         (request
           (vector c2-training-state-compose-tag p1 o2 (controls 17)
                   'checkpoint-load #f)))
    (c2-training-state-compose-internal request)
    (vector-ref request 5)))

(define policy
  (c2-persistence-policy-mode-internal
    1048576 1048576 1048576 16 'cpu 'operational-target))
(define public-policy
  (c2-persistence-policy-internal 1048576 1048576 1048576 16 'cpu))
(define owner (make-owner))
(define public-path (string-append output-root "/public.c2"))
(define image-path (string-append output-root "/image.c2"))
(define pre-path (string-append output-root "/pre.c2"))
(define post-path (string-append output-root "/post.c2"))

(if (string=? mode "fail-stop")
    (let* ((receipt (c2-save-image-receipt-create-internal owner policy))
           (record (c2-image-record receipt))
           (token (c2-image-token (vector-ref record 2))))
      (check "direct release for fail-stop cut" (= (c2-image-release token) 0))
      (c2-save-image-receipt-release-internal! receipt)
      (display "C2 IMAGE FAIL: release returned after uncertain ownership")
      (newline)
      (exit 99)))

(check "public SAVE caller remains usable"
       (c2-checkpoint-save-internal! owner public-path public-policy '()))
(define held (c2-training-state-borrow-begin-internal owner 'checkpoint-save!))
(expect-error "held owner rejects receipt" 'invalid-state
  (lambda () (c2-save-image-receipt-create-internal owner policy)))
(check "held owner borrow ends"
       (c2-training-state-borrow-end-internal held))
(check "held rejection leaves no image" (= (c2-image-live-bytes) 0))

(define saved-measure c2-save-measure-staged-internal)
(define saved-destination c2-save-destination-allocate-internal)
(set! c2-save-measure-staged-internal (lambda (_staged _limits) 16777217))
(set! c2-save-destination-allocate-internal
  (lambda (_bytes)
    (display "C2 IMAGE FAIL: oversize reached destination")
    (newline) (exit 1)))
(expect-error "measured over cap before destination" 'invalid-state
  (lambda () (c2-save-image-receipt-create-internal owner policy)))
(set! c2-save-measure-staged-internal saved-measure)
(set! c2-save-destination-allocate-internal saved-destination)
(check "oversize leaves no image" (= (c2-image-live-bytes) 0))

(define saved-allocate c2-image-allocate-internal)
(set! c2-image-allocate-internal (lambda (_length) #f))
(expect-error "token backing rejected before FFI" 'internal
  (lambda () (c2-save-image-receipt-create-internal owner policy)))
(set! c2-image-allocate-internal saved-allocate)
(check "bad token backing leaves no image" (= (c2-image-live-bytes) 0))

(define saved-encode c2-save-encode-staged-into-internal!)
(set! c2-save-destination-allocate-internal
  (lambda (bytes) (make-bytevector (+ bytes 1) 0)))
(set! c2-save-encode-staged-into-internal!
  (lambda (_staged _limits _destination _bytes) #t))
(expect-error "malformed destination rejected before FFI" 'internal
  (lambda () (c2-save-image-receipt-create-internal owner policy)))
(set! c2-save-encode-staged-into-internal! saved-encode)
(set! c2-save-destination-allocate-internal saved-destination)
(check "bad destination leaves no image" (= (c2-image-live-bytes) 0))

(define saved-after c2-image-after-adopt-internal)
(set! c2-image-after-adopt-internal (lambda () (raise #f)))
(expect-false "post-adopt exception releases native image"
  (lambda () (c2-save-image-receipt-create-internal owner policy)))
(set! c2-image-after-adopt-internal saved-after)
(check "post-adopt native bytes zero" (= (c2-image-live-bytes) 0))
(check "post-adopt registry empty" (null? c2-image-receipts))

(define receipt (c2-save-image-receipt-create-internal owner policy))
(define first-digest (c2-save-image-receipt-digest-copy-internal receipt))
(check "digest extent" (= (bytevector-length first-digest) 32))
(check "ready owns image" (> (c2-image-live-bytes) 0))
(check "receipt publishes without overwrite"
       (c2-save-image-receipt-publish-internal! receipt image-path))
(check "publish frees image" (= (c2-image-live-bytes) 0))
(check "published digest remains"
       (same-bytes? first-digest
         (c2-save-image-receipt-digest-copy-internal receipt)))
(check "published receipt releases"
       (c2-save-image-receipt-release-internal! receipt))
(expect-error "repeated release rejects" 'invalid-state
  (lambda () (c2-save-image-receipt-release-internal! receipt)))

(define collision (c2-save-image-receipt-create-internal owner policy))
(define collision-error
  (expect-error "no-overwrite collision" 'io
    (lambda () (c2-save-image-receipt-publish-internal!
                 collision image-path))))
(check "collision is not published"
       (eq? #f (details-ref (transformer-error-details collision-error)
                            'published?)))
(expect-error "collision receipt consumed" 'invalid-state
  (lambda () (c2-save-image-receipt-digest-copy-internal collision)))
(check "collision image freed" (= (c2-image-live-bytes) 0))

(c2-image-io-reset)
(c2-image-io-fail 11 1 5)
(define pre (c2-save-image-receipt-create-internal owner policy))
(define pre-error
  (expect-error "precommit writer failure" 'io
    (lambda () (c2-save-image-receipt-publish-internal! pre pre-path))))
(check "precommit says not published"
       (eq? #f (details-ref (transformer-error-details pre-error)
                            'published?)))
(check "precommit image freed" (= (c2-image-live-bytes) 0))
(c2-image-io-reset)
(c2-image-io-fail 14 1 5)
(define post (c2-save-image-receipt-create-internal owner policy))
(define post-error
  (expect-error "committed writer failure" 'io
    (lambda () (c2-save-image-receipt-publish-internal! post post-path))))
(check "committed bit passes through"
       (eq? #t (details-ref (transformer-error-details post-error)
                            'published?)))
(check "committed image freed" (= (c2-image-live-bytes) 0))
(c2-image-io-reset)

(define corrupt (c2-save-image-receipt-create-internal owner policy))
(define corrupt-token
  (c2-image-token (vector-ref (c2-image-record corrupt) 2)))
(c2-image-test-corrupt corrupt-token 0)
(expect-error "retained SHA mismatch" 'internal
  (lambda () (c2-save-image-receipt-digest-copy-internal corrupt)))
(expect-error "retained SHA blocks publication" 'internal
  (lambda () (c2-save-image-receipt-publish-internal! corrupt pre-path)))
(check "corrupt READY can release"
       (c2-save-image-receipt-release-internal! corrupt))

(define baseline (length c2-image-receipts))
(let loop ((i 0))
  (if (< i 32)
      (let ((item (c2-save-image-receipt-create-internal owner policy)))
        (check "repeat receipt releases"
               (c2-save-image-receipt-release-internal! item))
        (loop (+ i 1)))))
(check "native image bytes return to zero" (= (c2-image-live-bytes) 0))
(check "receipt registry returns to baseline"
       (= (length c2-image-receipts) baseline))
(check "no regional escape" (= (c2-image-region-depth) 0))
(check "owner releases" (c2-training-state-release-internal!
                            owner 'trainer-state-release!))
(display "C2 IMAGE DIGEST:")
(let loop ((i 0))
  (if (< i 32)
      (begin (display " ") (display (bytevector-u8-ref first-digest i))
             (loop (+ i 1)))))
(newline)
(display "C2 PRIVATE SAVE IMAGE RECEIPT PASS: ")
(display checks)
(display " checks")
(newline)
