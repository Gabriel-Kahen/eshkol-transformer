;;; Compiled Eshkol AOT MOD5 AdamW + LR schedule + grad-norm clipping +
;;; exact bitwise fresh-process training-state save/resume gate.
;;; Links MOD5 K1 kernels + libeshkol_transformer_mod5_adamw.a.

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 format-f64 ptr i64 char* f64 :real strfromd)

;; MOD5 K1 bridge
(extern i32 open-mod5 ptr :real et_mod5_aot_open)
(extern void close-mod5 ptr :real et_mod5_aot_close)
(extern void store-f32 ptr i64 f64 :real et_mod5_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_mod5_aot_load_f32)
(extern i32 rms-forward ptr ptr ptr ptr ptr :real et_mod5_aot_rms_forward)
(extern i32 rms-backward ptr ptr ptr ptr ptr ptr ptr :real et_mod5_aot_rms_backward)
(extern i32 glu-forward ptr ptr ptr ptr :real et_mod5_aot_swiglu_forward)
(extern i32 glu-backward ptr ptr ptr ptr ptr ptr :real et_mod5_aot_swiglu_backward)
(extern i32 attention-forward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr
        :real et_mod5_aot_attention_forward)
(extern i32 attention-backward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr ptr ptr ptr
        :real et_mod5_aot_attention_backward)

;; MOD5 AdamW + LR scheduler + snapshot + D1 shard bridge
(extern i32 adamw-create i64 f64 f64 f64 f64 f64 i32 f64 f64 i64 i64 char* char* ptr
        :real et_mod5_adamw_aot_create)
(extern void adamw-destroy ptr :real et_mod5_adamw_aot_destroy)
(extern i32 adamw-set-param ptr i64 f64 :real et_mod5_adamw_aot_set_param_f64)
(extern f64 adamw-get-param ptr i64 :real et_mod5_adamw_aot_get_param_f64)
(extern i64 adamw-get-param-bits ptr i64 :real et_mod5_adamw_aot_get_param_bits)
(extern i64 adamw-get-m-bits ptr i64 :real et_mod5_adamw_aot_get_m_bits)
(extern i64 adamw-get-v-bits ptr i64 :real et_mod5_adamw_aot_get_v_bits)
(extern i32 m5-adamw-step ptr ptr i64 i64 ptr ptr ptr :real et_mod5_adamw_aot_step)
(extern i32 adamw-save ptr char* :real et_mod5_adamw_aot_save)
(extern i32 adamw-load ptr char* :real et_mod5_adamw_aot_load)
(extern f64 adamw-load-f64 ptr :real et_mod5_adamw_aot_load_f64)
(extern i32 adamw-set-cursor ptr i64 i64 i64 :real et_mod5_adamw_aot_set_cursor)
(extern i64 adamw-get-cursor-shard ptr :real et_mod5_adamw_aot_get_cursor_shard)
(extern i64 adamw-get-cursor-offset ptr :real et_mod5_adamw_aot_get_cursor_offset)
(extern i64 adamw-get-cursor-epoch ptr :real et_mod5_adamw_aot_get_cursor_epoch)
(extern i64 adamw-get-rng-word ptr i32 :real et_mod5_adamw_aot_get_rng_word)
(extern i64 adamw-rng-next ptr :real et_mod5_adamw_aot_rng_next)
(extern i64 adamw-get-step ptr :real et_mod5_adamw_aot_get_step)
(extern i64 adamw-get-tokens ptr :real et_mod5_adamw_aot_get_tokens)
(extern i32 adamw-state-sha256 ptr ptr i64 :real et_mod5_adamw_aot_state_sha256_hex)
(extern i32 adamw-file-sha256 char* ptr i64 :real et_mod5_adamw_aot_file_sha256_hex)
(extern i32 write-d1-shard char* i64 i64 char* ptr i64 :real et_mod5_adamw_aot_write_d1_shard)
(extern i32 read-d1-shard char* i64 i64 char* ptr i64 ptr :real et_mod5_adamw_aot_read_d1_shard)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

;; Model & corpus geometry (MOD5 1-block pre-norm GQA decoder)
(define tokens 8)
(define window-stride 9)
(define windows-per-shard 3)
(define shard-tokens (* window-stride windows-per-shard))
(define shard-count 2)
(define width 16)
(define hidden 32)
(define query-heads 4)
(define head-width 4)
(define kv-heads 2)
(define vocab 16)
(define attn-window tokens)
(define rms-epsilon 0.125)
(define inverse-tokens (/ 1.0 tokens))

;; AdamW + warmup + cosine LR + grad-norm clipping hyperparameters
(define total-steps 16)
(define split-step 8)
(define warmup-steps 4)
(define sched-cosine 2)
(define base-lr 0.05)
(define min-lr 0.005)
(define beta1 0.9)
(define beta2 0.999)
(define adam-eps 1.0e-8)
(define weight-decay 0.01)
(define max-grad-norm 0.5)

(define tokenizer-id "mod5-adamw-token-v1")
(define model-config-tag "mod5-decoder-1l-4q-2kv-d16-h32-v16-v1")

;; Error codes from mod5_adamw_abi.h
(define err-checksum-mismatch -5)
(define err-config-mismatch -7)

(define (require-check label ok)
  (unless ok
    (display "FAIL: ") (display label) (newline)
    (exit 1)))

(define (expect-status label expected actual)
  (unless (= actual expected)
    (display "FAIL: ") (display label)
    (display " expected ") (display expected)
    (display " got ") (display actual) (newline)
    (exit 1)))

(define (checked-allocate bytes)
  (let ((p (allocate bytes)))
    (require-check "allocation failed" (not (= (ptr->usize p) 0)))
    p))

(define (list-len xs)
  (let loop ((cur xs) (n 0))
    (if (null? cur) n (loop (cdr cur) (+ n 1)))))

(define (arg-ref xs idx)
  (let loop ((cur xs) (i idx))
    (if (= i 0) (car cur) (loop (cdr cur) (- i 1)))))

;; Aligned MOD5 K1 workspace
(define span-bytes (* 4 width hidden))
(define workspace (checked-allocate (* 7 span-bytes)))
(define input-a workspace)
(define input-b (ptr-add workspace span-bytes))
(define input-c (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define output-a (ptr-add workspace (* 4 span-bytes)))
(define output-b (ptr-add workspace (* 5 span-bytes)))
(define output-c (ptr-add workspace (* 6 span-bytes)))
(define query-positions (checked-allocate (* tokens 8)))
(define key-positions (checked-allocate (* tokens 8)))
(define keep-mask (checked-allocate (* tokens tokens)))
(define slopes (checked-allocate (* query-heads 4)))
(define epsilon-buffer (checked-allocate 4))
(define fmt-buf (checked-allocate 128))
(define hex-a (checked-allocate 80))
(define hex-b (checked-allocate 80))
(define out-lr-cell (checked-allocate 8))
(define out-gn-cell (checked-allocate 8))
(define out-cl-cell (checked-allocate 4))
(define shard-tok-buf (checked-allocate (* shard-tokens 8)))
(define shard-cnt-cell (checked-allocate 8))

(define runtime-cell (checked-allocate 8))
(expect-status "K1 discovery" 0 (open-mod5 (ffi-pointer runtime-cell)))
(define runtime (volatile-load ptr runtime-cell))
(release runtime-cell)

(do ((t 0 (+ t 1)))
    ((= t tokens))
  (volatile-store! i64 (ptr-add query-positions (* 8 t)) t)
  (volatile-store! i64 (ptr-add key-positions (* 8 t)) t))
(do ((i 0 (+ i 1)))
    ((= i (* tokens tokens)))
  (volatile-store! u8 (ptr-add keep-mask i) 1))
(do ((h 0 (+ h 1)))
    ((= h query-heads))
  (store-f32 (ffi-pointer slopes) h 0.0))
(store-f32 (ffi-pointer epsilon-buffer) 0 rms-epsilon)

;; Parameter roster: 12 tensors, total 2,864 f32 parameters
(define wk 0)
(define wo 1)
(define wq 2)
(define wv 3)
(define wdown 4)
(define wgate 5)
(define wup 6)
(define gamma1 7)
(define gamma2 8)
(define whead 9)
(define gamma-final 10)
(define wembedding 11)
(define num-params 12)

(define param-rows (vector 8 16 16 8 16 32 32 1 1 16 1 16))
(define param-cols (vector 16 16 16 16 32 16 16 16 16 16 16 16))

(define total-param-count
  (let loop ((p 0) (acc 0))
    (if (= p num-params)
        acc
        (loop (+ p 1) (+ acc (* (vector-ref param-rows p) (vector-ref param-cols p)))))))

(define flat-grad-buf (checked-allocate (* 4 total-param-count)))
(define vocabulary-row (ones (list 1 vocab)))

(define (print-real format value)
  (let ((length (format-f64 (ffi-pointer fmt-buf) 128 format value)))
    (require-check "format-f64 failed" (and (>= length 0) (< length 128)))
    (do ((i 0 (+ i 1)))
        ((= i length))
      (display (integer->char (volatile-load u8 (ptr-add fmt-buf i)))))))

(define (print-hex64 buf)
  (do ((i 0 (+ i 1)))
      ((= i 64))
    (display (integer->char (volatile-load u8 (ptr-add buf i))))))

(define (hex64=? a b)
  (let loop ((i 0))
    (if (= i 64)
        #t
        (if (= (volatile-load u8 (ptr-add a i))
               (volatile-load u8 (ptr-add b i)))
            (loop (+ i 1))
            #f))))

(define (pack tensor buffer)
  (let* ((count (tensor-length tensor))
         (flat (reshape tensor (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count))
      (store-f32 (ffi-pointer buffer) i (tensor-ref flat i)))))

(define (unpack buffer rows cols)
  (let* ((count (* rows cols))
         (flat (zeros (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count) (reshape flat (list rows cols)))
      (tensor-set! flat i (load-f32 (ffi-pointer buffer) i)))))

(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (store-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d)
                   (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (load-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d))))))))

(define (rms x gamma)
  (pack x input-a)
  (pack gamma input-b)
  (expect-status "RMSNorm forward" 0
                 (rms-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (unpack output-a tokens width))

(define (rms-grad x gamma dy)
  (pack x input-a)
  (pack gamma input-b)
  (pack dy upstream)
  (expect-status "RMSNorm backward" 0
                 (rms-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                               (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens width) (unpack output-b 1 width)))

(define (glu gate up)
  (pack gate input-a)
  (pack up input-b)
  (expect-status "SwiGLU forward" 0
                 (glu-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer output-a)))
  (unpack output-a tokens hidden))

(define (glu-grad gate up dy)
  (pack gate input-a)
  (pack up input-b)
  (pack dy upstream)
  (expect-status "SwiGLU backward" 0
                 (glu-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens hidden) (unpack output-b tokens hidden)))

(define (attend q k v)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c)
  (expect-status "attention forward" 0
                 (attention-forward (ffi-pointer runtime) kv-heads
                                    (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                    (ffi-pointer query-positions) (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    attn-window (ffi-pointer output-a)))
  (unpack-heads output-a query-heads))

(define (attend-grad q k v dy)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c)
  (pack-heads dy query-heads upstream)
  (expect-status "attention backward" 0
                 (attention-backward (ffi-pointer runtime) kv-heads
                                     (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                     (ffi-pointer query-positions) (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer slopes) attn-window
                                     (ffi-pointer upstream) (ffi-pointer output-a)
                                     (ffi-pointer output-b) (ffi-pointer output-c)))
  (vector (unpack-heads output-a query-heads)
          (unpack-heads output-b kv-heads)
          (unpack-heads output-c kv-heads)))

(define (project x weight) (matmul x (transpose weight)))
(define (project-dx weight dy) (matmul dy weight))
(define (project-dw x dy) (matmul (transpose dy) x))

(define (cross-entropy logits target)
  (let* ((maxima (reshape (tensor-max logits 1) (list tokens 1)))
         (shifted (tensor-sub logits (matmul maxima vocabulary-row)))
         (exponentials (tensor-exp shifted))
         (sums (reshape (tensor-sum exponentials 1) (list tokens 1)))
         (loss (* inverse-tokens
                  (- (tensor-sum (tensor-log sums))
                     (tensor-sum (tensor-mul shifted target))))))
    (vector loss exponentials sums)))

(define (decoder weights input target gradients)
  (let* ((embedding (vector-ref weights wembedding))
         (head (vector-ref weights whead))
         (q-weight (vector-ref weights wq))
         (k-weight (vector-ref weights wk))
         (v-weight (vector-ref weights wv))
         (o-weight (vector-ref weights wo))
         (gate-weight (vector-ref weights wgate))
         (up-weight (vector-ref weights wup))
         (down-weight (vector-ref weights wdown))
         (gamma-a (vector-ref weights gamma1))
         (gamma-b (vector-ref weights gamma2))
         (gamma-c (vector-ref weights gamma-final))
         (x (matmul input embedding))
         (norm-a (rms x gamma-a))
         (q (project norm-a q-weight))
         (k (project norm-a k-weight))
         (v (project norm-a v-weight))
         (attention (attend q k v))
         (residual (tensor-add x (project attention o-weight)))
         (norm-b (rms residual gamma-b))
         (gate (project norm-b gate-weight))
         (up (project norm-b up-weight))
         (gated (glu gate up))
         (block (tensor-add residual (project gated down-weight)))
         (norm-c (rms block gamma-c))
         (logits (project norm-c head))
         (ce (cross-entropy logits target)))
    (when gradients
      (let* ((probabilities (tensor-div (vector-ref ce 1)
                                        (matmul (vector-ref ce 2) vocabulary-row)))
             (dlogits (tensor-scale (tensor-sub probabilities target) inverse-tokens))
             (drms-c (rms-grad block gamma-c (project-dx head dlogits)))
             (dy (vector-ref drms-c 0))
             (dglu (glu-grad gate up (project-dx down-weight dy)))
             (dgate (vector-ref dglu 0))
             (dup (vector-ref dglu 1))
             (dnorm-b (tensor-add (project-dx gate-weight dgate) (project-dx up-weight dup)))
             (drms-b (rms-grad residual gamma-b dnorm-b))
             (dresidual (tensor-add dy (vector-ref drms-b 0)))
             (dqkv (attend-grad q k v (project-dx o-weight dresidual)))
             (dq (vector-ref dqkv 0))
             (dk (vector-ref dqkv 1))
             (dv (vector-ref dqkv 2))
             (dnorm-a (tensor-add (tensor-add (project-dx q-weight dq) (project-dx k-weight dk))
                                  (project-dx v-weight dv)))
             (drms-a (rms-grad x gamma-a dnorm-a))
             (dx (tensor-add dresidual (vector-ref drms-a 0)))
             (dembedding (matmul (transpose input) dx))
             (dhead (project-dw norm-c dlogits)))
        (vector-set! gradients wk (project-dw norm-a dk))
        (vector-set! gradients wo (project-dw attention dresidual))
        (vector-set! gradients wq (project-dw norm-a dq))
        (vector-set! gradients wv (project-dw norm-a dv))
        (vector-set! gradients wdown (project-dw gated dy))
        (vector-set! gradients wgate (project-dw norm-b dgate))
        (vector-set! gradients wup (project-dw norm-b dup))
        (vector-set! gradients gamma1 (vector-ref drms-a 1))
        (vector-set! gradients gamma2 (vector-ref drms-b 1))
        (vector-set! gradients gamma-final (vector-ref drms-c 1))
        (vector-set! gradients whead dhead)
        (vector-set! gradients wembedding dembedding)))
    (vector-ref ce 0)))

;; Deterministic D1 v1.0 corpus (2 shards x 3 windows of 9 tokens each)
(define corpus-pattern (vector 1 4 1 5 9 2 6 5 3))

(define (shard-path dir shard-idx)
  (string-append dir
                 (if (= shard-idx 0)
                     "/shard-0000000000000000.ets"
                     "/shard-0000000000000001.ets")))

(define (write-corpus dir)
  (do ((s 0 (+ s 1)))
      ((= s shard-count))
    (do ((w 0 (+ w 1)))
        ((= w windows-per-shard))
      (do ((k 0 (+ k 1)))
          ((= k window-stride))
        (volatile-store! i64 (ptr-add shard-tok-buf (* 8 (+ (* w window-stride) k)))
                         (vector-ref corpus-pattern k))))
    (expect-status "write D1 shard" 0
                   (write-d1-shard (shard-path dir s) s vocab tokenizer-id
                                   (ffi-pointer shard-tok-buf) shard-tokens)))
  (display "CORPUS_WRITTEN shards=2 tokens_per_shard=27 PASS") (newline))

(define (load-batch-at-cursor dir shard-idx tok-off)
  (expect-status "read D1 shard" 0
                 (read-d1-shard (shard-path dir shard-idx) shard-idx vocab tokenizer-id
                                (ffi-pointer shard-tok-buf) shard-tokens
                                (ffi-pointer shard-cnt-cell)))
  (require-check "D1 shard token count" (= (volatile-load i64 shard-cnt-cell) shard-tokens))
  (let ((input (zeros (list tokens vocab)))
        (target (zeros (list tokens vocab))))
    (do ((t 0 (+ t 1)))
        ((= t tokens) (vector input target))
      (let ((in-id (volatile-load i64 (ptr-add shard-tok-buf (* 8 (+ tok-off t)))))
            (tg-id (volatile-load i64 (ptr-add shard-tok-buf (* 8 (+ tok-off t 1))))))
        (tensor-set! input t in-id 1.0)
        (tensor-set! target t tg-id 1.0)))))

(define (advance-cursor! trainer)
  (let* ((s (adamw-get-cursor-shard (ffi-pointer trainer)))
         (off (adamw-get-cursor-offset (ffi-pointer trainer)))
         (ep (adamw-get-cursor-epoch (ffi-pointer trainer)))
         (next-off (+ off window-stride)))
    (if (< next-off shard-tokens)
        (expect-status "advance cursor offset" 0
                       (adamw-set-cursor (ffi-pointer trainer) s next-off ep))
        (let ((next-s (+ s 1)))
          (if (< next-s shard-count)
              (expect-status "advance cursor shard" 0
                             (adamw-set-cursor (ffi-pointer trainer) next-s 0 ep))
              (expect-status "advance cursor epoch" 0
                             (adamw-set-cursor (ffi-pointer trainer) 0 0 (+ ep 1))))))))

;; Initialize live trainer state with deterministic MOD5 weights
(define (create-trainer wd-override)
  (let ((cell (checked-allocate 8)))
    (expect-status "adamw-create" 0
                   (adamw-create total-param-count beta1 beta2 adam-eps wd-override
                                 max-grad-norm sched-cosine base-lr min-lr
                                 warmup-steps total-steps tokenizer-id
                                 model-config-tag (ffi-pointer cell)))
    (let ((st (volatile-load ptr cell)))
      (release cell)
      st)))

(define (seed-initial-params! trainer)
  (let ((offset 0))
    (do ((p 0 (+ p 1)))
        ((= p num-params))
      (let* ((rows (vector-ref param-rows p))
             (cols (vector-ref param-cols p))
             (base (if (= rows 1) 1.0 0.0)))
        (do ((r 0 (+ r 1)))
            ((= r rows))
          (do ((c 0 (+ c 1)))
              ((= c cols))
            (let* ((i (+ (* r cols) c))
                   (seed (- (modulo (+ (* 29 p) (* 11 i) (quotient i 5)) 37) 18))
                   (val (+ base (* 0.0078125 seed))))
              (expect-status "seed param" 0
                             (adamw-set-param (ffi-pointer trainer) offset val))
              (set! offset (+ offset 1)))))))))

(define (unpack-weights-from-trainer trainer)
  (let ((weights (make-vector num-params #f))
        (offset 0))
    (do ((p 0 (+ p 1)))
        ((= p num-params) weights)
      (let* ((rows (vector-ref param-rows p))
             (cols (vector-ref param-cols p))
             (w (zeros (list rows cols))))
        (do ((r 0 (+ r 1)))
            ((= r rows))
          (do ((c 0 (+ c 1)))
              ((= c cols))
            (tensor-set! w r c (adamw-get-param (ffi-pointer trainer) offset))
            (set! offset (+ offset 1))))
        (vector-set! weights p w)))))

(define (pack-grads-flat gradients)
  (let ((offset 0))
    (do ((p 0 (+ p 1)))
        ((= p num-params))
      (let* ((g (vector-ref gradients p))
             (rows (vector-ref param-rows p))
             (cols (vector-ref param-cols p)))
        (do ((r 0 (+ r 1)))
            ((= r rows))
          (do ((c 0 (+ c 1)))
              ((= c cols))
            (store-f32 (ffi-pointer flat-grad-buf) offset (tensor-get g r c))
            (set! offset (+ offset 1))))))))

;; Verify central-difference gradient check on step 0 for all 12 parameters.
(define (check-gradients weights input target gradients)
  (do ((p 0 (+ p 1)))
      ((= p num-params))
    (let* ((weight (vector-ref weights p))
           (rows (vector-ref param-rows p))
           (cols (vector-ref param-cols p))
           (gradient (vector-ref gradients p))
           (best-r 0)
           (best-c 0)
           (peak 0.0))
      (do ((r 0 (+ r 1)))
          ((= r rows))
        (do ((c 0 (+ c 1)))
            ((= c cols))
          (let ((mag (abs (tensor-get gradient r c))))
            (when (> mag peak)
              (set! best-r r)
              (set! best-c c)
              (set! peak mag)))))
      (require-check "inactive parameter gradient" (> peak 0.0000001))
      (let ((eps 0.001953125)
            (orig (tensor-get weight best-r best-c))
            (analytic (tensor-get gradient best-r best-c)))
        (tensor-set! weight best-r best-c (+ orig eps))
        (let ((plus (decoder weights input target #f)))
          (tensor-set! weight best-r best-c (- orig eps))
          (let ((numerical (/ (- plus (decoder weights input target #f)) (* 2.0 eps))))
            (tensor-set! weight best-r best-c orig)
            (require-check "MOD5 central-difference gradient check failed"
                           (<= (abs (- analytic numerical))
                               (+ 0.000015 (* 0.005 (abs numerical)))))))))))

(define (run-steps! trainer corpus-dir start-step end-step do-grad-check?)
  (let ((gradients (make-vector num-params #f))
        (prev-loss 1.0e9)
        (first-loss 0.0)
        (last-loss 0.0))
    (do ((step start-step (+ step 1)))
        ((> step end-step) (vector first-loss last-loss))
      (let* ((weights (unpack-weights-from-trainer trainer))
             (cur-s (adamw-get-cursor-shard (ffi-pointer trainer)))
             (cur-off (adamw-get-cursor-offset (ffi-pointer trainer)))
             (batch (load-batch-at-cursor corpus-dir cur-s cur-off))
             (input (vector-ref batch 0))
             (target (vector-ref batch 1))
             (loss (decoder weights input target gradients)))
        (when (and do-grad-check? (= step 1))
          (check-gradients weights input target gradients)
          (display "GRAD_CHECK params=12 PASS") (newline))
        (when (= step start-step) (set! first-loss loss))
        (when (> step start-step)
          (require-check "loss strictly decreased" (and (>= loss 0.0) (< loss prev-loss))))
        (set! prev-loss loss)
        (set! last-loss loss)
        (pack-grads-flat gradients)
        (expect-status "m5-adamw-step" 0
                       (m5-adamw-step (ffi-pointer trainer) (ffi-pointer flat-grad-buf)
                                      total-param-count tokens
                                      (ffi-pointer out-lr-cell)
                                      (ffi-pointer out-gn-cell)
                                      (ffi-pointer out-cl-cell)))
        (advance-cursor! trainer)
        (let* ((rng-sample (adamw-rng-next (ffi-pointer trainer)))
               (lr (adamw-load-f64 (ffi-pointer out-lr-cell)))
               (gn (adamw-load-f64 (ffi-pointer out-gn-cell)))
               (cl (volatile-load i32 out-cl-cell))
               (s-after (adamw-get-cursor-shard (ffi-pointer trainer)))
               (o-after (adamw-get-cursor-offset (ffi-pointer trainer)))
               (e-after (adamw-get-cursor-epoch (ffi-pointer trainer)))
               (toks (adamw-get-tokens (ffi-pointer trainer))))
          (require-check "step counter matches"
                         (= (adamw-get-step (ffi-pointer trainer)) step))
          (display "STEP ") (display step)
          (display " loss=") (print-real "%.17g" loss)
          (display " loss_hex=") (print-real "%a" loss)
          (display " lr=") (print-real "%.17g" lr)
          (display " lr_hex=") (print-real "%a" lr)
          (display " grad_norm=") (print-real "%.17g" gn)
          (display " clipped=") (display cl)
          (display " cursor=") (display s-after) (display ":") (display o-after)
          (display ":") (display e-after)
          (display " tokens=") (display toks)
          (display " rng=") (display rng-sample)
          (newline))))))

(define (print-final-summary label trainer snap-path)
  (expect-status "state sha256" 0
                 (adamw-state-sha256 (ffi-pointer trainer) (ffi-pointer hex-a) 80))
  (expect-status "file sha256" 0
                 (adamw-file-sha256 snap-path (ffi-pointer hex-b) 80))
  (display label)
  (display " step=") (display (adamw-get-step (ffi-pointer trainer)))
  (display " tokens=") (display (adamw-get-tokens (ffi-pointer trainer)))
  (display " cursor=") (display (adamw-get-cursor-shard (ffi-pointer trainer)))
  (display ":") (display (adamw-get-cursor-offset (ffi-pointer trainer)))
  (display ":") (display (adamw-get-cursor-epoch (ffi-pointer trainer)))
  (display " p0_bits=") (display (adamw-get-param-bits (ffi-pointer trainer) 0))
  (display " m0_bits=") (display (adamw-get-m-bits (ffi-pointer trainer) 0))
  (display " v0_bits=") (display (adamw-get-v-bits (ffi-pointer trainer) 0))
  (display " rng0=") (display (adamw-get-rng-word (ffi-pointer trainer) 0))
  (display " state_sha256=") (print-hex64 hex-a)
  (display " snap_sha256=") (print-hex64 hex-b)
  (newline))

(define (run-full corpus-dir final-snap)
  (let ((trainer (create-trainer weight-decay)))
    (seed-initial-params! trainer)
    (let* ((losses (run-steps! trainer corpus-dir 1 total-steps #t))
           (first-loss (vector-ref losses 0))
           (last-loss (vector-ref losses 1)))
      ;; Evaluate post-step-16 loss on window 0 to verify substantial reduction.
      (let* ((weights (unpack-weights-from-trainer trainer))
             (batch (load-batch-at-cursor corpus-dir 0 0))
             (final-eval (decoder weights (vector-ref batch 0) (vector-ref batch 1) #f)))
        (require-check "final eval loss decreased strictly and substantially"
                       (and (< final-eval last-loss) (< final-eval (* first-loss 0.5))))
        (display "FINAL_EVAL loss=") (print-real "%.17g" final-eval)
        (display " loss_hex=") (print-real "%a" final-eval) (newline)))
    (expect-status "save full final snapshot" 0
                   (adamw-save (ffi-pointer trainer) final-snap))
    (print-final-summary "SUMMARY" trainer final-snap)
    (adamw-destroy (ffi-pointer trainer))))

(define (run-part1 corpus-dir mid-snap)
  (let ((trainer (create-trainer weight-decay)))
    (seed-initial-params! trainer)
    (run-steps! trainer corpus-dir 1 split-step #f)
    (expect-status "save midpoint snapshot" 0
                   (adamw-save (ffi-pointer trainer) mid-snap))
    (print-final-summary "MID_SUMMARY" trainer mid-snap)
    (adamw-destroy (ffi-pointer trainer))))

(define (run-part2 corpus-dir mid-snap corrupt-snap mismatch-snap final-snap)
  (let ((trainer (create-trainer weight-decay)))
    ;; Fresh OS process: load midpoint snapshot from Process 1.
    (expect-status "load midpoint snapshot" 0
                   (adamw-load (ffi-pointer trainer) mid-snap))
    (require-check "loaded step is 8" (= (adamw-get-step (ffi-pointer trainer)) split-step))
    (require-check "loaded tokens is 64" (= (adamw-get-tokens (ffi-pointer trainer)) (* split-step tokens)))

    ;; Record exact live state SHA-256 before testing negative snapshot rejections.
    (expect-status "state sha256 before negatives" 0
                   (adamw-state-sha256 (ffi-pointer trainer) (ffi-pointer hex-a) 80))

    ;; Corrupt snapshot must reject with checksum mismatch and leave live state untouched.
    (expect-status "corrupt snapshot rejected" err-checksum-mismatch
                   (adamw-load (ffi-pointer trainer) corrupt-snap))
    (expect-status "state sha256 after corrupt" 0
                   (adamw-state-sha256 (ffi-pointer trainer) (ffi-pointer hex-b) 80))
    (require-check "corrupt load preserved live state" (hex64=? hex-a hex-b))

    ;; Config-mismatch snapshot must reject with config mismatch and leave live state untouched.
    (expect-status "config-mismatch snapshot rejected" err-config-mismatch
                   (adamw-load (ffi-pointer trainer) mismatch-snap))
    (expect-status "state sha256 after mismatch" 0
                   (adamw-state-sha256 (ffi-pointer trainer) (ffi-pointer hex-b) 80))
    (require-check "mismatch load preserved live state" (hex64=? hex-a hex-b))
    (display "NEGATIVE_LOAD_REJECTION corrupt=-5 mismatch=-7 state_untouched=1 PASS") (newline)

    ;; Continue training steps 9..16 from the restored snapshot.
    (let* ((losses (run-steps! trainer corpus-dir (+ split-step 1) total-steps #f))
           (last-loss (vector-ref losses 1)))
      (let* ((weights (unpack-weights-from-trainer trainer))
             (batch (load-batch-at-cursor corpus-dir 0 0))
             (final-eval (decoder weights (vector-ref batch 0) (vector-ref batch 1) #f)))
        (require-check "resumed final eval decreased" (< final-eval last-loss))
        (display "FINAL_EVAL loss=") (print-real "%.17g" final-eval)
        (display " loss_hex=") (print-real "%a" final-eval) (newline)))
    (expect-status "save resumed final snapshot" 0
                   (adamw-save (ffi-pointer trainer) final-snap))
    (print-final-summary "SUMMARY" trainer final-snap)
    (adamw-destroy (ffi-pointer trainer))))

(define (make-mismatch out-snap)
  (let ((trainer (create-trainer 0.02)))
    (seed-initial-params! trainer)
    (expect-status "save mismatch snapshot" 0
                   (adamw-save (ffi-pointer trainer) out-snap))
    (adamw-destroy (ffi-pointer trainer))
    (display "MISMATCH_WRITTEN PASS") (newline)))

(define (cleanup)
  (close-mod5 (ffi-pointer runtime))
  (release workspace)
  (release query-positions)
  (release key-positions)
  (release keep-mask)
  (release slopes)
  (release epsilon-buffer)
  (release fmt-buf)
  (release hex-a)
  (release hex-b)
  (release out-lr-cell)
  (release out-gn-cell)
  (release out-cl-cell)
  (release shard-tok-buf)
  (release shard-cnt-cell)
  (release flat-grad-buf))

(define (mod5-adamw-main args)
  (let ((argc (list-len args)))
    (cond
      ((and (= argc 4) (string=? (arg-ref args 1) "--mode")
            (string=? (arg-ref args 2) "write-corpus"))
       (write-corpus (arg-ref args 3)))
      ((and (= argc 4) (string=? (arg-ref args 1) "--mode")
            (string=? (arg-ref args 2) "make-mismatch"))
       (make-mismatch (arg-ref args 3)))
      ((and (= argc 5) (string=? (arg-ref args 1) "--mode")
            (string=? (arg-ref args 2) "run-full"))
       (run-full (arg-ref args 3) (arg-ref args 4)))
      ((and (= argc 5) (string=? (arg-ref args 1) "--mode")
            (string=? (arg-ref args 2) "run-part1"))
       (run-part1 (arg-ref args 3) (arg-ref args 4)))
      ((and (= argc 8) (string=? (arg-ref args 1) "--mode")
            (string=? (arg-ref args 2) "run-part2"))
       (run-part2 (arg-ref args 3) (arg-ref args 4) (arg-ref args 5)
                  (arg-ref args 6) (arg-ref args 7)))
      (else
       (display "Usage: mod5-adamw-aot --mode write-corpus <dir> | make-mismatch <snap> | run-full <dir> <out> | run-part1 <dir> <mid> | run-part2 <dir> <mid> <corrupt> <mismatch> <out>")
       (newline)
       (cleanup)
       (exit 2))))
  (cleanup))

(mod5-adamw-main (command-line))
