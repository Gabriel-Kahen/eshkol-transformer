;;; Focused source-private test with a receipt-registry double. This does not
;;; claim real C2 file admission; the production receipt test owns that gate.
(load "c1_sha256.esk")
(load "g3r_record_codec_extension.esk")

(define receipt-shell (list 'receipt))
(define foreign-shell (list 'receipt))
(define borrow-shell (list 'borrow))
(define foreign-borrow-shell (list 'borrow))
(define owner-shell (list 'owner))
(define image-sha (make-bytevector 32 7))
(define receipt-record (vector receipt-shell borrow-shell owner-shell
                               image-sha (list 'c2-borrow)))
(define foreign-record (vector foreign-shell foreign-borrow-shell
                               (list 'other-owner)
                               (bytevector-copy image-sha 0 32)
                               (list 'other-c2-borrow)))
(define (c2-load-fail category operation message details)
  (raise (vector category operation message details)))
(define (g3r-c2-receipt-find shell)
  (cond ((eq? shell receipt-shell) receipt-record)
        ((eq? shell foreign-shell) foreign-record)
        (else #f)))
(define (g3r-c2-receipt-borrow-find borrow operation)
  (cond ((eq? borrow borrow-shell) receipt-record)
        ((eq? borrow foreign-borrow-shell) foreign-record)
        (else (c2-load-fail 'invalid-argument operation "foreign borrow" '()))))
(define (g3r-c2-receipt-borrow-sha-internal borrow operation)
  (cond ((eq? borrow borrow-shell)
         (bytevector-copy (vector-ref receipt-record 3) 0 32))
        ((eq? borrow foreign-borrow-shell)
         (bytevector-copy (vector-ref foreign-record 3) 0 32))
        (else (c2-load-fail 'invalid-argument operation "foreign borrow" '()))))
(load "g3r_checked_pair_extension.esk")

(define checks 0)
(define (check label ok)
  (if ok (set! checks (+ checks 1))
      (begin (display "G3-R checked pair FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label thunk)
  (let ((caught #f))
    (guard (condition (#t (set! caught #t))) (thunk))
    (check label caught)))
(define (all-zero? bytes)
  (let loop ((index 0))
    (if (= index (bytevector-length bytes)) #t
        (and (= (bytevector-u8-ref bytes index) 0)
             (loop (+ index 1))))))

(define policy (vector 0 1065353216 256 1065353216 1 -1))
(define rng (vector 1 7 0 0))
(define history (bytevector 7 11))
(define fingerprint
  (string->utf8
    "sha256:eshkol-byte-tokenizer-v1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(define caller (make-bytevector 288 0))
(g3r-record-encode! caller policy rng history 1 1 0 fingerprint image-sha)
(define pair (g3r-checked-pair-admit-internal caller borrow-shell))
(check "exact pair admitted" (g3r-checked-pair-recheck-internal pair receipt-shell))
(define fields (make-vector 8 #f))
(g3r-checked-pair-copy-fields-internal! pair receipt-shell fields)
(check "copied digest" (g3r-bytes=? (vector-ref fields 7) 0 image-sha 0 32))
(bytevector-u8-set! caller 120 99)
(vector-set! (vector-ref fields 0) 0 1)
(bytevector-u8-set! (vector-ref fields 7) 0 99)
(check "caller and copyout mutation cannot change authority"
  (g3r-checked-pair-recheck-internal pair receipt-shell))
(define fresh (make-vector 8 #f))
(g3r-checked-pair-copy-fields-internal! pair receipt-shell fresh)
(check "fresh copyout is original" (= (vector-ref (vector-ref fresh 0) 0) 0))
(check "fresh image digest is original" (= (bytevector-u8-ref (vector-ref fresh 7) 0) 7))

(reject "short record" (lambda ()
  (g3r-checked-pair-admit-internal (bytevector-copy caller 0 287) borrow-shell)))
(define wrong-pair (make-bytevector 288 0))
(g3r-record-encode! wrong-pair policy rng history 1 1 0 fingerprint
                    (make-bytevector 32 8))
(reject "valid record for another C2 image" (lambda ()
  (g3r-checked-pair-admit-internal wrong-pair borrow-shell)))
(reject "foreign borrow" (lambda ()
  (g3r-checked-pair-admit-internal caller (list 'borrow))))
(reject "torn caller record" (lambda ()
  (g3r-checked-pair-admit-internal caller borrow-shell)))
(reject "forged pair shell" (lambda ()
  (g3r-checked-pair-recheck-internal (list 'g3r-checked-pair-v1) receipt-shell)))
(reject "foreign receipt" (lambda ()
  (g3r-checked-pair-recheck-internal pair foreign-shell)))
(define foreign-bytes (make-bytevector 288 0))
(g3r-record-encode! foreign-bytes policy rng history 1 1 0
                    fingerprint image-sha)
(define foreign-pair
  (g3r-checked-pair-admit-internal foreign-bytes foreign-borrow-shell))
(check "foreign pair valid on its own active receipt"
  (g3r-checked-pair-recheck-internal foreign-pair foreign-shell))
(reject "foreign active pair" (lambda ()
  (g3r-checked-pair-recheck-internal foreign-pair receipt-shell)))

(define entry (g3r-checked-pair-find pair))
(bytevector-u8-set! (vector-ref entry 3) 120 42)
(reject "mutated sealed bytes" (lambda ()
  (g3r-checked-pair-recheck-internal pair receipt-shell)))
(bytevector-u8-set! (vector-ref entry 3) 120 7)
(check "original seal still valid" (g3r-checked-pair-recheck-internal pair receipt-shell))
(vector-set! receipt-record 4 #f)
(vector-set! receipt-record 1 'live)
(check "recheck after borrow end" (g3r-checked-pair-recheck-internal pair receipt-shell))
(vector-set! receipt-record 1 'dead)
(reject "dead receipt" (lambda ()
  (g3r-checked-pair-recheck-internal pair receipt-shell)))
(reject "dead receipt cannot copy out" (lambda ()
  (g3r-checked-pair-copy-fields-internal!
    pair receipt-shell (make-vector 8 #f))))
(define sealed-bytes (vector-ref entry 3))
(define sealed-record-sha (vector-ref entry 4))
(define sealed-image-sha (vector-ref entry 5))
(check "exact pair retirement" (g3r-checked-pair-retire-internal! pair))
(check "retirement scrubs owner and bytes"
  (and (eq? (vector-ref entry 6) 'dead)
       (not (vector-ref entry 1)) (not (vector-ref entry 2))
       (not (vector-ref entry 3)) (not (vector-ref entry 4))
       (not (vector-ref entry 5))
       (all-zero? sealed-bytes) (all-zero? sealed-record-sha)
       (all-zero? sealed-image-sha)))
(check "retirement is idempotent" (g3r-checked-pair-retire-internal! pair))
(reject "retired pair cannot recheck" (lambda ()
  (g3r-checked-pair-recheck-internal pair receipt-shell)))
(reject "retired pair cannot copy out" (lambda ()
  (g3r-checked-pair-copy-fields-internal!
    pair receipt-shell (make-vector 8 #f))))
(reject "forged pair cannot retire" (lambda ()
  (g3r-checked-pair-retire-internal! (list 'g3r-checked-pair-v1))))
(check "foreign pair retirement" (g3r-checked-pair-retire-internal! foreign-pair))
(display "G3-R checked pair PASS: checks=") (display checks) (newline)
