(define checks 0)
(define (check label value)
  (if value (set! checks (+ checks 1))
      (begin (display "G3-T P2 zero budget FAIL: ")
             (display label) (newline) (exit 1))))
(define (rng-clone-words? clone a b c d)
  (and (= a (g3t-test-rng-clone-word clone 0))
       (= b (g3t-test-rng-clone-word clone 1))
       (= c (g3t-test-rng-clone-word clone 2))
       (= d (g3t-test-rng-clone-word clone 3))))
(define (live-rng-shells)
  (let walk ((entries (vector-ref g3t-registry 0)) (count 0))
    (if (null? entries) count
        (let ((entry (car entries)))
          (walk (cdr entries)
                (if (and (eq? (vector-ref entry 1) 'rng)
                         (eq? (vector-ref entry 2) 'live))
                    (+ count 1) count))))))
(define (reject-category label category thunk)
  (check label
    (guard (caught
             (#t (and (transformer-error? caught)
                      (eq? (transformer-error-category caught) category))))
      (thunk) #f)))
(define config
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define initial (g3t-checked-m3t-initializer-state 1729))
(define model
  (with-region ('g3t-p2-model 65536)
    (g3t-checked-m3t-model-create config initial)))
(check "eval" (module-eval! model))
(define native-model (vector-ref (g3t-model-entry-live model 'g3t-rng-test #f) 3))
(define (generator-from-rng source budget)
  (g3t-native-generator-rng native-model source 1 #x3f800000 256
                            #x3f800000 budget -1))
(define tokenizer (t1-private-tokenizer-byte config))
(define t1-p2 (t1-wave1-tokenizer-encode tokenizer (bytevector 65 66)))
(define t1-p1 (t1-wave1-tokenizer-encode tokenizer (bytevector 255)))
(define t1-empty (t1-wave1-tokenizer-encode tokenizer (bytevector)))
(define t1-long (t1-wave1-tokenizer-encode tokenizer (bytevector 1 2 3)))
(check "T1 sources admitted in same aggregate"
       (and (t1-wave1-tensor-admitted? t1-p2)
            (t1-wave1-tensor-admitted? t1-p1)))
(reject-category "foreign T1 wrapper rejected" 'invalid-argument
  (lambda () (g3t-generation-t1-input-create (vector 'foreign))))
(reject-category "empty T1 prompt rejected" 'shape-mismatch
  (lambda () (g3t-generation-t1-input-create t1-empty)))
(reject-category "P3 T1 prompt rejected" 'shape-mismatch
  (lambda () (g3t-generation-t1-input-create t1-long)))
(check "T1 shape rejects enroll no native input"
       (= 0 (g3t-test-live-t1-inputs)))
(define old-t1-registry t1-wave1-tensor-registry)
(set! t1-wave1-tensor-registry '())
(reject-category "withdrawn T1 authority rejected" 'invalid-argument
  (lambda () (g3t-generation-t1-input-create t1-p2)))
(set! t1-wave1-tensor-registry old-t1-registry)
(define t1-unsealed (t1-shell-create 1))
(check "unsealed T1 fixture" (not (null? t1-unsealed)))
(check "unsealed T1 word" (= 0 (t1-shell-write t1-unsealed 0 65)))
(check "unsealed T1 native reject"
       (and (null? (g3t-native-input-from-t1 t1-unsealed))
            (= 2 (g3t-test-last-error-category))
            (= 2 (g3t-test-last-error-code))))
(check "abort unsealed T1 fixture" (= 0 (t1-shell-abort t1-unsealed)))
(check "stale T1 native reject"
       (and (null? (g3t-native-input-from-t1 t1-unsealed))
            (= 1 (g3t-test-last-error-category))
            (= 1 (g3t-test-last-error-code))))
(check "foreign native T1 reject"
       (and (null? (g3t-native-input-from-t1 (vector 'foreign)))
            (= 1 (g3t-test-last-error-category))
            (= 1 (g3t-test-last-error-code))))
(define t1-out-of-range (t1-shell-create 1))
(check "out-of-range T1 fixture" (not (null? t1-out-of-range)))
(check "out-of-range T1 write"
       (= 0 (t1-shell-write t1-out-of-range 0 256)))
(check "out-of-range T1 seal"
       (= 0 (t1-shell-seal t1-out-of-range)))
(check "out-of-range T1 native reject"
       (and (null? (g3t-native-input-from-t1 t1-out-of-range))
            (= 3 (g3t-test-last-error-category))
            (= 4 (g3t-test-last-error-code))))
(define t1-i1-baseline (g3t-test-i1-count 0))
(check "T1 header cut armed" (= 0 (g3t-test-fail-alloc-after 0)))
(check "T1 header cut atomic"
       (and (null? (g3t-native-input-from-t1 t1-p2))
            (= 5 (g3t-test-last-error-category))
            (= 7 (g3t-test-last-error-code))
            (= 0 (g3t-test-live-t1-inputs))
            (= t1-i1-baseline (g3t-test-i1-count 0))))
(check "T1 header cut disarmed"
       (= 0 (g3t-test-fail-alloc-after 9223372036854775807)))
(let cuts ((index 0))
  (if (= index 4) #t
      (begin
        (check "T1 I1 cut armed" (= 0 (g3t-test-fail-i1-after index)))
        (check "T1 I1 cut atomic"
               (and (null? (g3t-native-input-from-t1 t1-p2))
                    (= 0 (g3t-test-live-t1-inputs))
                    (= t1-i1-baseline (g3t-test-i1-count 0))))
        (cuts (+ index 1)))))
(check "T1 I1 cuts disarmed"
       (= 0 (g3t-test-fail-i1-after 9223372036854775807)))
(define t1-native-copy (g3t-native-input-from-t1 t1-p2))
(check "T1 P2 owns exact independent I1"
       (and (not (null? t1-native-copy))
            (= 2 (g3t-test-input-length t1-native-copy))
            (= 65 (g3t-test-input-word t1-native-copy 0))
            (= 66 (g3t-test-input-word t1-native-copy 1))
            (= 1 (g3t-test-live-t1-inputs))
            (= (+ t1-i1-baseline 1) (g3t-test-i1-count 0))))
(define t1-input-borrow (g3t-test-input-borrow-begin t1-native-copy))
(check "T1-owned I1 borrow begins" (not (null? t1-input-borrow)))
(check "T1-owned I1 borrow blocks release"
       (and (not (= 0 (g3t-native-tensor-release t1-native-copy)))
            (= 1 (g3t-test-live-t1-inputs))
            (= (+ t1-i1-baseline 1) (g3t-test-i1-count 0))))
(check "T1-owned I1 borrow ends"
       (= 0 (g3t-test-input-borrow-end t1-input-borrow)))
(check "T1-native typed release"
       (and (= 0 (g3t-native-tensor-release t1-native-copy))
            (= 0 (g3t-native-tensor-release t1-native-copy))
            (= 0 (g3t-test-live-t1-inputs))
            (= t1-i1-baseline (g3t-test-i1-count 0))))
(check "dead T1 input cannot be reused"
       (= -1 (g3t-test-input-length t1-native-copy)))
(check "T1 source unchanged by copy/release"
       (and (= 2 (t1-shell-length t1-p2))
            (= 65 (t1-shell-read t1-p2 0))
            (= 66 (t1-shell-read t1-p2 1))))
(define t1-wrapper-p1 (g3t-generation-t1-input-create t1-p1))
(define t1-wrapper-p1-native
  (vector-ref (g3t-prefill-entry t1-wrapper-p1 'input 't1-p1) 3))
(check "same-aggregate P1 copies byte 255"
       (= 255 (g3t-test-input-word t1-wrapper-p1-native 0)))
(check "same-aggregate P1 release"
       (and (g3t-generation-tensor-release! t1-wrapper-p1)
            (g3t-generation-tensor-release! t1-wrapper-p1)
            (= t1-i1-baseline (g3t-test-i1-count 0))))
(check "wrapper I1 cut armed" (= 0 (g3t-test-fail-i1-after 0)))
(reject-category "wrapper I1 cut raises" 'internal
  (lambda () (g3t-generation-t1-input-create t1-p2)))
(check "wrapper I1 cut tombstone and no owner"
       (let ((entry (car (vector-ref g3t-registry 0))))
         (and (eq? (vector-ref entry 2) 'dead)
              (not (vector-ref entry 3))
              (not (vector-ref entry 10))
              (= 0 (g3t-test-live-t1-inputs))
              (= t1-i1-baseline (g3t-test-i1-count 0)))))
(check "wrapper I1 cut disarmed"
       (= 0 (g3t-test-fail-i1-after 9223372036854775807)))
(define (t1-retention-cycles count)
  (let cycle ((index 0))
    (if (= index count) #t
        (let ((copy (g3t-generation-t1-input-create t1-p2)))
          (check "T1 retention one live input"
                 (= 1 (g3t-test-live-t1-inputs)))
          (check "T1 retention one live I1"
                 (= (+ t1-i1-baseline 1) (g3t-test-i1-count 0)))
          (check "T1 retention typed release"
                 (g3t-generation-tensor-release! copy))
          (check "T1 retention no live input"
                 (= 0 (g3t-test-live-t1-inputs)))
          (check "T1 retention no live I1"
                 (= t1-i1-baseline (g3t-test-i1-count 0)))
          (cycle (+ index 1))))))
(check "T1 1024-cycle retention" (t1-retention-cycles 1024))
(check "T1 8192-cycle retention" (t1-retention-cycles 8192))
(define policy
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 0
        ':eos #f ':seed 1729))
(define policy-g1
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos #f ':seed 1729))

(define generator (g3t-generator-create model tokenizer policy))
(define native (vector-ref (g3t-generator-find generator 'g3t-p2) 3))
(define input (g3t-native-input-from-pair 65 66))
(check "two-token input" (not (null? input)))
(check "invalid pair rejected"
       (null? (g3t-native-input-from-pair 65 256)))
(check "P2 preflight" (= 0 (g3t-native-prompt-preflight native input)))
(check "length>2 setup" (= 0 (g3t-test-input-length-set input 3)))
(check "length>2 rejected before pins"
       (and (not (= 0 (g3t-native-prompt-preflight native input)))
            (= 0 (g3t-test-pin-count native))
            (= 0 (g3t-test-cache-length native))))
(check "length restored" (= 0 (g3t-test-input-length-set input 2)))

(check "acquire" (= 0 (g3t-native-call-acquire native 2)))
(check "14 pins" (= 14 (g3t-test-pin-count native)))
(define output (g3t-native-output-reserve native 2))
(check "empty ID owner reserved" (and (not (null? output))
                                       (= 1 (g3t-test-output-word output 5))))
(check "pending output cannot clone IDs"
       (and (null? (g3t-native-output-ids-clone output))
            (= 0 (g3t-test-live-clones))))
(check "pending output cannot clone lengths"
       (and (null? (g3t-native-output-lengths-clone output))
            (= 0 (g3t-test-live-lengths-clones))))
(check "pending output cannot clone cache length"
       (and (null? (g3t-native-output-cache-lengths-clone output))
            (= 0 (g3t-test-live-cache-lengths-clones))))
(check "pending output cannot clone RNG"
       (and (null? (g3t-native-output-rng-clone output))
            (= 0 (g3t-test-live-rng-clones))))
(define wrong-input (g3t-native-input-from-token 65))
(check "wrong length frame rejected"
       (not (= 0 (g3t-native-frame-begin native wrong-input 1))))
(check "wrong input release" (= 0 (g3t-native-tensor-release wrong-input)))
(check "A2 create cut armed" (= 0 (g3t-test-fail-a2-after 0)))
(check "P2 create cut rejected"
       (not (= 0 (g3t-native-frame-begin native input 1))))
(check "A2 create cut disarmed"
       (= 0 (g3t-test-fail-a2-after 9223372036854775807)))
(check "P2 create cut preserves old cache"
       (and (= 0 (g3t-test-cache-length native))
            (= 14 (g3t-test-pin-count native))))
(check "P2 begin" (= 0 (g3t-native-frame-begin native input 1)))
(let roles ((ordinal 0))
  (if (= ordinal 10)
      #t
      (begin (check "P2 role 0..9"
                    (= 0 (g3t-native-role-step native ordinal)))
             (roles (+ ordinal 1)))))
(check "A2 attention cut armed" (= 0 (g3t-test-fail-a2-after 0)))
(check "A2 attention rejected"
       (not (= 0 (g3t-native-role-step native 10))))
(check "A2 attention cut disarmed"
       (= 0 (g3t-test-fail-a2-after 9223372036854775807)))
(check "A2 attention rollback"
       (and (= 0 (g3t-test-cache-length native))
            (= 14 (g3t-test-pin-count native))))
(check "P2 attention" (= 0 (g3t-native-role-step native 10)))
(let roles ((ordinal 11))
  (if (= ordinal 21)
      #t
      (begin (check "P2 role 11..20"
                    (= 0 (g3t-native-role-step native ordinal)))
             (roles (+ ordinal 1)))))
(check "no sampler in G0" (not (= 0 (g3t-native-sample native))))
(check "no append frame in G0"
       (not (= 0 (g3t-native-frame-begin native #f 2))))
(check "numeric zero preparation"
       (= 0 (g3t-native-output-prepare native output)))
(define staging (make-bytevector 0 0))
(define raw (make-bytevector 0 0))
(check "empty IDs" (= 0 (g3t-native-output-copy-decode-ids
                              native output staging)))
(check "T1 empty raw decode" (eq? raw (t1-private-g3-decode-raw-into!
                                        tokenizer staging raw)))
(check "empty text accepted" (= 0 (g3t-native-output-accept-text
                                     native output raw)))
(check "P2 output ready"
       (and (= 0 (g3t-test-output-word output 1))
            (= 2 (g3t-test-output-word output 2))
            (= 1 (g3t-test-output-word output 3))
            (= 1 (g3t-test-output-word output 4))))
(check "frame prepare" (= 0 (g3t-native-frame-prepare native #f)))
(check "binding flip" (= 0 (g3t-test-frame-binding-flip native)))
(check "stale binding blocks preflight"
       (and (not (= 0 (g3t-native-call-prepare-end native)))
            (= 0 (g3t-test-output-state output))
            (= 0 (g3t-test-cache-length native))))
(check "binding restore" (= 0 (g3t-test-frame-binding-flip native)))
(define borrow (g3t-test-output-borrow-begin output))
(check "empty ID borrow" (not (null? borrow)))
(check "borrow blocks preflight and abort"
       (and (not (= 0 (g3t-native-call-prepare-end native)))
            (not (= 0 (g3t-native-call-abort native)))
            (= 14 (g3t-test-pin-count native))))
(check "borrow end" (= 0 (g3t-test-output-borrow-end borrow)))
(check "preflight" (= 0 (g3t-native-call-prepare-end native)))
(check "P2 joint commit" (= 0 (g3t-native-frame-commit native)))
(define prefill-bits (make-vector 256 0))
(let capture ((index 0))
  (if (= index 256) #t
      (begin (vector-set! prefill-bits index
                          (g3t-test-logit-bits native index))
             (capture (+ index 1)))))
(check "published P2/G0 state"
       (and (= 1 (g3t-test-output-state output))
            (= 0 (g3t-test-output-word output 1))
            (= 2 (g3t-test-output-word output 2))
            (= 2 (g3t-test-cache-length native))
            (= -1 (g3t-test-sample-token native))))
(check "RNG unchanged"
       (let same ((index 0))
         (if (= index 4) #t
             (and (= (g3t-test-rng-word native index)
                     (g3t-test-output-word output (+ 7 index)))
                  (= (g3t-test-rng-word native index)
                     (cond ((= index 0) 1) ((= index 1) 1729) (else 0)))
                  (same (+ index 1))))))
(check "finish" (= 0 (g3t-native-call-finish native)))
(check "pins drained" (= 0 (g3t-test-pin-count native)))
(check "P2/G0 clone header cut armed" (= 0 (g3t-test-fail-alloc-after 0)))
(check "P2/G0 header cut is atomic"
       (and (null? (g3t-native-output-ids-clone output))
            (= 0 (g3t-test-live-clones))
            (= 1 (g3t-test-output-state output))
            (= 2 (g3t-test-cache-length native))))
(check "P2/G0 header cut disarmed"
       (= 0 (g3t-test-fail-alloc-after 9223372036854775807)))
(let cuts ((index 0))
  (if (= index 3) #t
      (begin
        (check "P2/G0 I1 clone cut armed"
               (= 0 (g3t-test-fail-i1-after index)))
        (check "P2/G0 I1 clone cut atomic"
               (and (null? (g3t-native-output-ids-clone output))
                    (= 0 (g3t-test-live-clones))
                    (= 1 (g3t-test-output-state output))
                    (= 2 (g3t-test-cache-length native))
                    (= 0 (g3t-test-rng-word native 2))))
        (cuts (+ index 1)))))
(check "P2/G0 I1 cuts disarmed"
