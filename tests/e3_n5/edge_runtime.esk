;;; One genuine model, four authentic D2 edge cases, exact emitted cursor bytes.
(extern void e3-n5-edge-run ptr ptr ptr ptr ptr :real et_e3_n5_edge_run_v1)

(define (edge-check ok)
  (if ok #t (begin (display "E3-N5-EDGE-FAIL") (newline) (exit 1))))
(define (edge-count values)
  (let loop ((rest values) (count 0))
    (if (null? rest) count (loop (cdr rest) (+ count 1)))))
(define (edge-emit-cursor label value)
  (edge-check (bytevector? value))
  (display "CURSOR ") (display label)
  (let loop ((index 0))
    (if (= index (bytevector-length value)) (newline)
        (begin (display " ") (display (bytevector-u8-ref value index))
               (loop (+ index 1))))))

(define args (command-line))
(edge-check (= (edge-count args) 5))
(define output (vector #f))
(e3-n5-edge-run (vector (car (cdr args)))
                (vector (car (cdr (cdr args))))
                (vector (car (cdr (cdr (cdr args)))))
                (vector (car (cdr (cdr (cdr (cdr args)))))) output)
(define result (vector-ref output 0))
(edge-check (and (vector? result) (= (vector-length result) 6)
                 (eq? (vector-ref result 0) 'e3-n5-edge-result-v1)))
(define metrics (vector-ref result 1))
(edge-check (and (vector? metrics) (= (vector-length metrics) 6)
                 (= (vector-ref metrics 1) 1065353216)
                 (= (vector-ref metrics 3) 0)
                 (= (vector-ref metrics 4) 1)
                 (= (vector-ref metrics 5) 1)))
(display "OUTPUTS")
(let loop ((index 0))
  (if (= index 6) (newline)
      (begin (display " ") (display (vector-ref metrics index))
             (loop (+ index 1)))))
(edge-emit-cursor "one-token" (vector-ref result 2))
(edge-emit-cursor "empty" (vector-ref result 3))
(edge-emit-cursor "singleton" (vector-ref result 4))
(edge-emit-cursor "entry-eos" (vector-ref result 5))
(display "E3-N5-EDGE-PASS one=1 rejected=3 outputs=6 cursors=4")
(newline)
