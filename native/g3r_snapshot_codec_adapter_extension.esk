;;; Source-private G3-R in-memory adapter. Load only after the committed-save
;;; snapshot and G3RCV1 codec in a same-owner feature aggregate. No SAVE or I/O.

(define (g3r-snapshot-record-fields? snapshot fingerprint digest)
  (and (vector? snapshot) (= (vector-length snapshot) 7)
       (g3r-record-fields? (vector-ref snapshot 0) (vector-ref snapshot 1)
                           (vector-ref snapshot 2) (vector-ref snapshot 3)
                           (vector-ref snapshot 4) (vector-ref snapshot 5)
                           fingerprint digest)
       (g3r-bytes=? fingerprint 0
         (string->utf8 g3r-save-tokenizer-fingerprint) 0 96)
       (let* ((policy (vector-ref snapshot 0))
              (history (vector-ref snapshot 2))
              (generated (vector-ref snapshot 4))
              (terminal (vector-ref snapshot 6))
              (last (bytevector-u8-ref history
                      (- (bytevector-length history) 1)))
              (eos (vector-ref policy 5)))
         (and (or (equal? terminal 0) (equal? terminal 1))
              (= terminal (if (and (= generated 1) (>= eos 0)
                                   (= last eos)) 1 0))))))

(define (g3r-snapshot-record-encode! generator destination c2-digest)
  (if (not (and (bytevector? destination)
                (= (bytevector-length destination) g3r-record-size)
                (bytevector? c2-digest)
                (= (bytevector-length c2-digest) 32)))
      (g3r-record-fail "G3-R snapshot adapter: invalid destination or C2 digest extent"))
  (let* ((snapshot-scratch (make-bytevector g3r-save-size 0))
         (snapshot (g3r-committed-save-snapshot! generator snapshot-scratch))
         ;; The snapshot checked this exact raw-V256 identity against its live T1.
         (fingerprint (string->utf8 g3r-save-tokenizer-fingerprint)))
    (if (not (and (= (bytevector-length fingerprint) 96)
                  (g3r-fingerprint? fingerprint)
                  (g3r-snapshot-record-fields? snapshot fingerprint c2-digest)))
        (g3r-record-fail "G3-R snapshot adapter: inconsistent detached fields"))
    (let ((record-scratch (make-bytevector g3r-record-size 0)))
      (if (or (eq? destination snapshot-scratch)
              (eq? destination record-scratch)
              (eq? snapshot-scratch record-scratch))
          (g3r-record-fail "G3-R snapshot adapter: scratch aliases destination"))
      (g3r-record-encode! record-scratch
                          (vector-ref snapshot 0) (vector-ref snapshot 1)
                          (vector-ref snapshot 2) (vector-ref snapshot 3)
                          (vector-ref snapshot 4) (vector-ref snapshot 5)
                          fingerprint c2-digest)
      (if (not (= (bytevector-length record-scratch) g3r-record-size))
          (g3r-record-fail "G3-R snapshot adapter: staged extent changed"))
      (bytevector-copy! destination 0 record-scratch 0 g3r-record-size)
      destination)))
