;;; Private V1 producer witness. The observer sees the decoded replay owner's
;;; no-draw P1 and genuine G1 before that owner is released.
(extern i64 g3rt-host-little-endian
        :real et_g3r_private_transcript_host_le_v1)
(define g3rt-size 6292)
(define g3rt-trace-start 5056)
(define g3rt-checksum-start 6260)
(define g3rt-magic (string->utf8 "G3RTV1"))

(define (g3rt-fail detail)
  (c2-load-fail 'invalid-state 'g3r-trained-transcript detail '()))

(define (g3rt-u32? word)
  (and (integer? word) (exact? word) (>= word 0)
       (<= word 4294967295)))

(define (g3rt-words index)
  (cond ((<= index 3) 16) ((<= index 5) 32)
        ((<= index 9) 4) ((= index 10) 1024)
        ((<= index 12) 4) (else 8)))

(define (g3rt-rank index)
  (if (and (>= index 6) (<= index 9)) 1
      (if (and (>= index 11) (<= index 12)) 1 2)))

(define (g3rt-dim0 index)
  (cond ((= index 5) 8) ((= index 10) 256)
        ((= index 13) 2) (else 4)))

(define (g3rt-dim1 index)
  (cond ((= (g3rt-rank index) 1) 0)
        ((= index 4) 8) (else 4)))

(define (g3rt-stage-parameters! bytes tree)
  (let ((paths (cli3-b-unique-paths tree))
        (head (parameter-tree-handle tree '("head" "weight")))
        (embedding
          (parameter-tree-handle tree '("token_embedding" "weight"))))
    (if (not (and (eq? head embedding)
                  (eq? (parameter-handle-tensor-identity-internal head)
                       (parameter-handle-tensor-identity-internal embedding))))
        (g3rt-fail "live tied embedding identity changed"))
    (let loop ((rest paths) (index 0) (offset 96))
      (if (= index 14)
          (if (and (null? rest) (= offset g3rt-trace-start)) #t
              (g3rt-fail "live parameter roster count changed"))
          (if (null? rest)
              (g3rt-fail "live parameter roster is short")
              (let* ((path (car rest))
                     (handle (parameter-tree-handle tree path))
                     (shape (parameter-handle-shape handle))
                     (carrier (parameter-handle-tensor-internal handle))
                     (checked
                       (i2-carrier-preflight carrier 'parameter
                                             'g3r-trained-transcript))
                     (length (* 4 (g3rt-words index)))
                     (payload (make-bytevector length 0)))
                (if (not (and (tr3-fixed-path? path index)
                              (tr3-fixed-shape? shape index)
                              (eq? (parameter-handle-dtype handle) 'f32)
                              (eq? (parameter-handle-device handle) 'cpu)
                              (= (i2-native-byte-length
                                   (vector-ref checked 2)
                                   (i2-native-role checked)
                                   (vector-ref checked 3)) length)
                              (= (i2-native-copy-bytes
                                   (vector-ref checked 2)
                                   (i2-native-role checked)
                                   (vector-ref checked 3)
                                   payload length) 0)))
                    (g3rt-fail "live parameter path, shape or bits changed"))
                (g3r-u-write! bytes offset 4 index)
                (g3r-u-write! bytes (+ offset 4) 4 (g3rt-rank index))
                (g3r-u-write! bytes (+ offset 8) 4 (g3rt-dim0 index))
                (g3r-u-write! bytes (+ offset 12) 4 (g3rt-dim1 index))
                (bytevector-copy! bytes (+ offset 16) payload 0 length)
                (loop (cdr rest) (+ index 1) (+ offset 16 length))))))))

(define (g3rt-stage-header! bytes tree c2-digest companion-digest prompt)
  (if (not (and (= (g3rt-host-little-endian) 1)
                (bytevector? bytes) (= (bytevector-length bytes) g3rt-size)
                (bytevector? c2-digest) (= (bytevector-length c2-digest) 32)
                (bytevector? companion-digest)
                (= (bytevector-length companion-digest) 32)
                (integer? prompt) (exact? prompt)
                (>= prompt 0) (<= prompt 255)))
      (g3rt-fail "invalid transcript header inputs"))
  (bytevector-copy! bytes 0 g3rt-magic 0 6)
  (g3r-u-write! bytes 8 4 1)
  (g3r-u-write! bytes 12 4 g3rt-size)
  (bytevector-copy! bytes 16 c2-digest 0 32)
  (bytevector-copy! bytes 48 companion-digest 0 32)
  (g3r-u-write! bytes 80 4 prompt)
  (g3r-u-write! bytes 84 4 2)
  (g3r-u-write! bytes 88 4 14)
  (g3rt-stage-parameters! bytes tree))

(define (g3rt-trace-word! bytes offset word)
  (if (not (g3rt-u32? word)) (g3rt-fail "invalid live f32 trace word"))
  (g3r-u-write! bytes offset 4 word))

(define (g3rt-stage-p1! bytes native companion-rng)
  (if (not (= (g3r-test-cache-length native) 1))
      (g3rt-fail "replayed P1 cache length changed"))
  (let logits ((index 0))
    (if (< index 256)
        (begin
          (g3rt-trace-word! bytes (+ g3rt-trace-start (* index 4))
                            (g3r-test-logit native index))
          (logits (+ index 1)))))
  (let kv ((which 0) (index 0))
    (if (< which 2)
        (if (= index 4) (kv (+ which 1) 0)
            (begin
              (g3rt-trace-word! bytes (+ 6080 (* which 16) (* index 4))
                                (g3r-test-cache-kv native which index))
              (kv which (+ index 1))))))
  (let rng ((index 0))
    (if (< index 4)
        (let ((word (g3r-test-rng native index)))
          (if (not (and (g3r-i64? word)
                        (= word (vector-ref companion-rng index))))
              (g3rt-fail "replayed P1 RNG differs from companion"))
          (g3r-i64-write! bytes (+ 6112 (* index 8)) word)
          (rng (+ index 1)))))
  (g3r-u-write! bytes 6144 4 1)
  (g3r-u-write! bytes 6148 4 1))

(define (g3rt-stage-g1! bytes native output)
  (let ((token (g3r-test-output output 6)))
    (if (not (and (integer? token) (>= token 0) (<= token 255)
                  (= (g3r-test-output output 1) 1)
                  (= (g3r-test-output output 2) 2)
                  (= (g3r-test-cache-length native) 2)))
        (g3rt-fail "replayed G1 ID or lengths changed"))
    (g3r-u-write! bytes 6152 4 token))
  (let kv ((which 0) (index 0))
    (if (< which 2)
        (if (= index 8) (kv (+ which 1) 0)
            (begin
              (g3rt-trace-word! bytes (+ 6156 (* which 32) (* index 4))
                                (g3r-test-cache-kv native which index))
              (kv which (+ index 1))))))
  (let rng ((index 0))
    (if (< index 4)
        (let ((word (g3r-test-rng native index)))
          (if (not (g3r-i64? word))
              (g3rt-fail "invalid replayed G1 RNG word"))
          (g3r-i64-write! bytes (+ 6220 (* index 8)) word)
          (rng (+ index 1)))))
  (g3r-u-write! bytes 6252 4 1)
  (g3r-u-write! bytes 6256 4 2))

(define (g3rt-seal! bytes)
  (bytevector-copy! bytes g3rt-checksum-start
                    (c1-sha256 (bytevector-copy bytes 0
                                                 g3rt-checksum-start))
                    0 32))

(define (g3rt-decode! source c2-digest companion-record destination)
  (if (not (and (bytevector? source)
                (= (bytevector-length source) g3rt-size)
                (bytevector? c2-digest) (= (bytevector-length c2-digest) 32)
                (bytevector? companion-record)
                (= (bytevector-length companion-record) 288)
                (vector? destination) (= (vector-length destination) 1)))
      (g3rt-fail "invalid transcript decode extents"))
  (let ((companion (make-vector 8 #f)))
    (g3r-record-decode! companion-record c2-digest companion)
    (if (not (and (= (vector-ref (vector-ref companion 0) 4) 1)
                  (= (vector-ref companion 3) 1)
                  (= (vector-ref companion 4) 0)
                  (= (vector-ref companion 5) 0)))
        (g3rt-fail "companion is not the budget-one P1 capture")))
  (if (not (and (g3r-bytes=? source 0 g3rt-magic 0 6)
                (g3r-zero-range? source 6 8)
                (= (g3r-u-read source 8 4) 1)
                (= (g3r-u-read source 12 4) g3rt-size)
                (g3r-bytes=? source 16 c2-digest 0 32)
                (g3r-bytes=? source 48 (c1-sha256 companion-record) 0 32)
                (<= (g3r-u-read source 80 4) 255)
                (= (g3r-u-read source 80 4)
                   (bytevector-u8-ref companion-record 120))
                (= (g3r-u-read source 84 4) 2)
                (= (g3r-u-read source 88 4) 14)
                (= (g3r-u-read source 92 4) 0)
                (g3r-bytes=? source g3rt-checksum-start
                              (c1-sha256
                                (bytevector-copy source 0
                                                 g3rt-checksum-start))
                              0 32)))
      (g3rt-fail "transcript header, pair or checksum"))
  (let records ((index 0) (offset 96))
    (if (= index 14)
        (if (not (= offset g3rt-trace-start))
            (g3rt-fail "transcript parameter extent changed"))
        (if (not (and (= (g3r-u-read source offset 4) index)
                      (= (g3r-u-read source (+ offset 4) 4)
                         (g3rt-rank index))
                      (= (g3r-u-read source (+ offset 8) 4)
                         (g3rt-dim0 index))
                      (= (g3r-u-read source (+ offset 12) 4)
                         (g3rt-dim1 index))))
            (g3rt-fail "transcript parameter roster changed")
            (records (+ index 1)
                     (+ offset 16 (* 4 (g3rt-words index)))))))
  (if (not (and (= (g3r-u-read source 6144 4) 1)
                (= (g3r-u-read source 6148 4) 1)
                (<= (g3r-u-read source 6152 4) 255)
                (= (g3r-u-read source 6252 4) 1)
                (= (g3r-u-read source 6256 4) 2)))
      (g3rt-fail "transcript P1/G1 trace changed"))
  (let rng ((index 0))
    (if (< index 4)
        (if (not (= (g3r-i64-read source (+ 6112 (* index 8)))
                    (g3r-i64-read companion-record (+ 88 (* index 8)))))
            (g3rt-fail "transcript P1 RNG differs from companion")
            (rng (+ index 1)))))
  (vector-set! destination 0 (bytevector-copy source))
  #t)

(define (g3rt-observer-create tree c2-digest record prompt path)
  (let ((bytes (make-bytevector g3rt-size 0))
        (phase 0))
    (g3rt-stage-header! bytes tree c2-digest (c1-sha256 record) prompt)
    (lambda (step native output companion-rng)
      (cond
        ((eq? step 'p1)
         (if (not (= phase 0)) (g3rt-fail "transcript P1 phase changed"))
         (g3rt-stage-p1! bytes native companion-rng)
         (set! phase 1)
         #t)
        ((eq? step 'g1)
         (if (not (= phase 1)) (g3rt-fail "transcript G1 phase changed"))
         (g3rt-stage-g1! bytes native output)
         (set! phase 2)
         #t)
        ((eq? step 'finish)
         (if (not (= phase 2)) (g3rt-fail "transcript is incomplete"))
         (g3rt-seal! bytes)
         (let ((decoded (vector 'untouched)))
           (g3rt-decode! bytes c2-digest record decoded)
           (if (not (g3r-bytes=? bytes 0 (vector-ref decoded 0) 0
                                  g3rt-size))
               (g3rt-fail "transcript round trip changed")))
         (if (not (= 0 (t1-native-atomic-write path bytes g3rt-size 0)))
             (c2-load-fail 'io 'g3r-trained-transcript
                           "transcript publication failed" '()))
         (set! phase 3)
         (c1-sha256 bytes))
        (else (g3rt-fail "unknown transcript phase"))))))

(define (g3rt-decode-rejects? source c2-digest companion at reseal? detail)
  (let ((changed (bytevector-copy source))
        (destination (vector 'untouched)))
    (bytevector-u8-set!
      changed at (bitwise-xor (bytevector-u8-ref changed at) 1))
    (if reseal? (g3rt-seal! changed))
    (and
      (guard (caught
               (#t (and (transformer-error? caught)
                        (eq? (transformer-error-category caught)
                             'invalid-state)
                        (eq? (transformer-error-operation caught)
                             'g3r-trained-transcript)
                        (string=? (transformer-error-message caught)
                                  detail))))
        (g3rt-decode! changed c2-digest companion destination)
        #f)
      (eq? (vector-ref destination 0) 'untouched))))

(define (g3rt-private-decode-check arguments)
  (if (not (and (vector? arguments) (= (vector-length arguments) 3)))
      (g3rt-fail "decoder fixture requires three paths"))
  (let* ((saved (g3r-trained-replay-file-image
                  (vector-ref arguments 0) 16777216))
         (companion (g3r-trained-replay-file-image
                      (vector-ref arguments 1) 288))
         (source (g3r-trained-replay-file-image
                   (vector-ref arguments 2) g3rt-size))
         (digest (c1-sha256 saved))
         (destination (vector 'untouched)))
    (g3rt-decode! source digest companion destination)
    (if (not (g3r-bytes=? source 0 (vector-ref destination 0) 0 g3rt-size))
        (g3rt-fail "decoder changed authenticated bytes"))
    (if (not (and
               (g3rt-decode-rejects? source digest companion 16 #t
                 "transcript header, pair or checksum")
               (g3rt-decode-rejects? source digest companion 88 #t
                 "transcript header, pair or checksum")
               (g3rt-decode-rejects? source digest companion 104 #t
                 "transcript parameter roster changed")
               (g3rt-decode-rejects? source digest companion 6144 #t
                 "transcript P1/G1 trace changed")
               (g3rt-decode-rejects? source digest companion 6112 #t
                 "transcript P1 RNG differs from companion")
               (g3rt-decode-rejects? source digest companion 6260 #f
                 "transcript header, pair or checksum")))
        (g3rt-fail "decoder negative category or destination changed"))
    6))
