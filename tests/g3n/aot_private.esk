;;; Private diagnostic bridge; no public Eshkol tensor/model transport.
(extern i64 g3n-test-provider :real et_g3n_test_provider_transport_v1)
(if (= (g3n-test-provider) 11)
    (begin (display "G3-N PRIVATE AOT PASS: eleven forward rows and negatives")
           (newline) (exit 0))
    (begin (display "G3-N PRIVATE AOT FAIL") (newline) (exit 1)))
