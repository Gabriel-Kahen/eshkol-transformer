;;; Genuine uninstalled CPU4 binding/P1/D2/native evaluator consumer.
(load "e3_cpu4_private_root.esk")
(extern ptr destination-borrow ptr :real et_cpu4_consumer_borrow_begin)
(extern i64 destination-unborrow ptr :real et_cpu4_consumer_borrow_end)
(extern i64 view-word ptr i64 :real et_cpu4_consumer_view_word)
(extern ptr destination-create :real et_cpu4_consumer_destination_create)
(extern i64 destination-destroy ptr :real et_cpu4_consumer_destination_destroy)
(extern i64 destination-bits ptr :real et_cpu4_consumer_destination_bits)
(extern i64 seed-gradients ptr :real et_cpu4_consumer_seed_gradients)
(extern ptr image-create ptr :real et_cpu4_consumer_image_create)
(extern i64 image-zero-control ptr ptr :real et_cpu4_consumer_image_zero_control)
(extern i64 image-equal ptr ptr :real et_cpu4_consumer_image_equal)
(extern void image-destroy ptr :real et_cpu4_consumer_image_destroy)
(extern i64 lease-enter ptr i64 :real et_g3c4_private_training_lease_enter_v1)
(extern i64 lease-leave ptr :real et_g3c4_private_training_lease_leave_v1)
(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4-CONSUMER-FAIL ") (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label (guard (caught (#t (transformer-error? caught))) (thunk) #f)))
(define (copy-vector value)
  (let ((out (make-vector (vector-length value) #f)))
    (let loop ((i 0))
      (if (= i (vector-length value)) out
          (begin (vector-set! out i (vector-ref value i)) (loop (+ i 1)))))))
(define resolved (x1-private-config-resolve (x1-private-config-parse
 "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define model (g3c4-model-create-seeded-internal 1729))
(module-train! model)
(define binding (cpu4-model-binding-create-internal model resolved))
(define binding-record (cpu4-model-binding-check-internal binding))
(define lease (cpu4-model-binding-native-lease-internal binding))
(define args (command-line))
(define gradient (car (cdr (cdr args))))
(check 'gradient-option (or (string=? gradient "absent") (string=? gradient "present")))
(if (string=? gradient "present") (check 'seed-gradients-after-seal (= (seed-gradients lease) 0)))
(define tokenizer (t1-private-tokenizer-byte resolved))
(check 'raw-v256 (= (t1-private-tokenizer-vocab-size tokenizer) 256))
(define (destinations-create)
  (let ((out (vector #f #f #f #f)))
    (let loop ((i 0))
      (if (= i 4) out
          (let ((value (destination-create)))
            (check 'destination-allocation (not (null? value)))
            (vector-set! out i value) (loop (+ i 1)))))))
(define destinations (destinations-create))
(define second-destinations (destinations-create))
(define frame (cpu4-e3-frame-bind-internal binding destinations))
(define entry (e3-frame-entry-live frame 'consumer))
(define native (vector-ref entry 4))
(define dataset (d2-token-dataset-open
  (list ':directory (car (cdr args)) ':batch-size 1 ':sequence-length 4
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer))
(define state (d2-open-dataset-state dataset 'consumer))
(define config (vector-ref state 3))
(define metadata (vector-ref state 4))
(define manifest (vector-ref state 5))
(define core (vector-ref state 6))
(define first-batch (d2-token-dataset-next-batch dataset))
(d2-token-batch-release! first-batch)
(define cursor (d2-token-dataset-cursor dataset))
(define initial-generation (vector-ref state 8))
(define core-header (make-vector 15 #f))
(e3-d2-snapshot-fill! core-header core)
(check 'nonzero-start (= (vector-ref core 15) 1))
(define image (image-create lease))
(check 'snapshot (not (null? image)))
(if (string=? gradient "present")
    (check 'gradient-zeroing-negative-control (= (image-zero-control lease image) 1)))
(define (modes)
  (let ((out (make-vector 17 #f)))
    (let loop ((i 0))
      (if (= i 17) out
          (begin (vector-set! out i (module-mode-internal (vector-ref (vector-ref binding-record 9) i)))
                 (loop (+ i 1)))))))
(define train-modes (modes))
(define (publication-of selected-frame selected-destinations)
  (vector (destination-bits (vector-ref selected-destinations 0))
          (destination-bits (vector-ref selected-destinations 1))
          (destination-bits (vector-ref selected-destinations 2))
          (destination-bits (vector-ref selected-destinations 3))
          (e3-counter-ref selected-frame 0) (e3-counter-ref selected-frame 1)))
(define (publication) (publication-of frame destinations))
(define (restored label)
  (check label (and (d2-core-bytes=? cursor (d2-token-dataset-cursor dataset))
    (eq? config (vector-ref state 3)) (eq? metadata (vector-ref state 4))
    (eq? manifest (vector-ref state 5)) (eq? core (vector-ref state 6))
    (e3-d2-snapshot-matches? core-header core) (e3-d2-source-idle? state)
    (= (e3-d2-native-idle dataset) 0) (equal? train-modes (modes))
    (= (image-equal lease image) 1) (= (vector-ref entry 1) 1)
    (= (vector-ref entry 10) 0)))
  (check 'strict-binding-after-restore (eq? binding-record (cpu4-model-binding-check-internal binding))))
(define (evaluate)
  (with-region ('cpu4-consumer-call 262144)
    (e3-evaluate-into! model dataset frame)))
(evaluate)
(restored 'success)
(check 'traversal-generation-grew (> (vector-ref state 8) initial-generation))
(define expected (publication))
;;; Existing P1 authority permits one enrolled E3 frame per model.
(reject 'second-bind-idle
  (lambda () (cpu4-e3-frame-bind-internal binding second-destinations)))
(restored 'idle-second-bind-preserves-first)
(check 'idle-second-bind-preserves-report (equal? expected (publication)))
(check 'physical-counts (and (= (vector-ref expected 4) 8) (= (vector-ref expected 5) 2)))
(evaluate)
(check 'same-bound-repeat (equal? expected (publication)))
(restored 'repeat)
;;; Malformed source profiles fail before entry; restore mutations before retry.
(define (bad-cell vector index value)
  (let ((saved (vector-ref vector index)))
    (vector-set! vector index value)
    (reject 'profile-denial evaluate)
    (vector-set! vector index saved)
    (restored 'profile-rollback)
    (check 'profile-preserves-report (equal? expected (publication)))))
(bad-cell config 3 2)
(bad-cell config 3 3)
(bad-cell config 3 5)
(bad-cell config 7 67)
(bad-cell core 9 67)
(bad-cell core 3 255)
(bad-cell config 9 2)
(bad-cell config 10 #t)
(bad-cell metadata 4 "foreign-tokenizer")
(bad-cell core 15 -1)
(bad-cell binding-record 7 "foreign-canonical-config")
(bad-cell (vector-ref (vector-ref binding-record 3) 5) 1 1730)
(let ((saved-total (vector-ref core 14)) (saved-rows (vector-ref state 17)))
  (vector-set! core 14 8194) (vector-set! state 17 8194)
  (reject 'over-8192-remaining evaluate)
  (vector-set! core 14 saved-total) (vector-set! state 17 saved-rows)
  (restored 'bound-rejection-restores))
(bad-cell (vector-ref binding-record 10) 0 #f)
(reject 'foreign-frame (lambda () (e3-evaluate-into! model dataset (vector #f))))
;;; A separate real equal-seed owner is still foreign to this frame.
(define foreign (g3c4-model-create-seeded-internal 1729))
(module-train! foreign)
(reject 'foreign-model (lambda () (e3-evaluate-into! foreign dataset frame)))
(restored 'foreign-rollback)
;;; Native READ busy is tested independently from the source registry claim.
(check 'external-read (= (lease-enter lease 1) 0))
(reject 'native-read-busy evaluate)
(check 'external-read-release (= (lease-leave lease) 0))
(restored 'native-busy-restored)
;;; Execute the production partial transaction explicitly, without new hooks.
(define (begin-partial enter?)
  (vector-set! entry 1 2)
  (check 'prepare (= (p1-e3-mode-prepare! (vector-ref entry 6)) 0))
  (e3-entry-bit-set! entry 4)
  (check 'd2-prepare (e3-d2-prepare! frame dataset))
  (e3-entry-bit-set! entry 16)
  (if enter?
      (begin
        (check 'native-acquire (= (e3-native-acquire native) 0))
        (e3-entry-bit-set! entry 1) (e3-entry-bit-set! entry 2)
        (check 'enter (= (p1-e3-mode-enter! (vector-ref entry 6)) 0))
        (e3-entry-bit-set! entry 8) (vector-set! entry 13 #t))))
(define (abort-retry label)
  (e3-abort! frame) (restored label)
  (check 'failure-preserves-prior-report (equal? expected (publication)))
  (evaluate) (restored 'same-bound-retry)
  (check 'retry-exact-report (equal? expected (publication))))
(begin-partial #f)
(reject 'second-bind-prepared
  (lambda () (cpu4-e3-frame-bind-internal binding second-destinations)))
(reject 'same-frame-prepared-busy (lambda () (e3-evaluate-into! model dataset frame)))
(check 'same-frame-remains-prepared (= (vector-ref entry 1) 2))
(check 'prepared-busy-modes-unchanged (equal? train-modes (modes)))
(abort-retry 'before-enter)
(begin-partial #t)
(define eval-modes (modes))
(let loop ((i 0))
  (if (= i 17) #t
      (begin (check 'all17-train (eq? (vector-ref train-modes i) 'train))
             (check 'all17-eval (eq? (vector-ref eval-modes i) 'eval))
             (loop (+ i 1)))))
(reject 'second-bind-eval
  (lambda () (cpu4-e3-frame-bind-internal binding second-destinations)))
(check 'busy-before-mode-change (equal? eval-modes (modes)))
(abort-retry 'after-enter)
(begin-partial #t)
(let* ((batch (d2-token-dataset-next-batch dataset))
       (owned (vector batch (vector-ref state 8) #t (cons #f '()))))
  (e3-entry-bit-set! entry 32)
  (reject 'during-real-borrow
    (lambda ()
      (d2-token-tensor-with-view-internal (d2-token-batch-inputs batch)
        (lambda (view)
          (check 'stage-real-inputs (e3-d2-inputs-consumer frame view))
          (et-e1b-private-raise 'internal 'consumer "controlled borrowed-view failure" '() #f)))))
  (check 'borrow-closed (= (vector-ref state 15) 0))
  (e3-d2-release-owned! frame owned))
(abort-retry 'during-batch)
;;; Check restored strict P1 identity while native READ/workspace still exists.
(begin-partial #t)
(check 'real-traversal (e3-traverse! frame dataset))
(e3-cleanup-preflight! frame)
(check 'restore-preflight (e3-d2-restore-preflight! frame))
(e3-native-drain native)
(check 'closed-d2-restore (e3-d2-restore-commit! frame))
(check 'real-p1-restore (= (p1-e3-mode-restore! (vector-ref entry 6)) 0))
(check 'binding-check-before-finish (eq? binding-record (cpu4-model-binding-check-internal binding)))
(check 'read-still-held (not (= (lease-enter lease 1) 0)))
(let* ((handles (vector-ref binding-record 10)) (saved (vector-ref handles 0)))
  (vector-set! handles 0 #f)
  (check 'late-publication-denied (not (e3-publish! frame)))
  (vector-set! handles 0 saved))
(e3-native-finish native)
(e3-source-finish! entry)
(restored 'late-denial)
(check 'late-denial-keeps-prior (equal? expected (publication)))
(evaluate)
(check 'late-same-bound-retry (equal? expected (publication)))
;;; Native atomic publication denial: borrow begins only after cleanup/drain.
(begin-partial #t)
(check 'publish-denial-traversal (e3-traverse! frame dataset))
(e3-cleanup-preflight! frame)
(check 'publish-denial-preflight (e3-d2-restore-preflight! frame))
(e3-native-drain native)
(check 'publish-denial-d2 (e3-d2-restore-commit! frame))
(check 'publish-denial-p1 (= (p1-e3-mode-restore! (vector-ref entry 6)) 0))
(check 'publish-denial-binding (eq? binding-record (cpu4-model-binding-check-internal binding)))
(let ((borrow (destination-borrow (vector-ref destinations 3))))
  (check 'late-destination-borrow (not (null? borrow)))
  (check 'native-publish-denied (not (e3-publish! frame)))
  (e3-native-finish native)
  (e3-source-finish! entry)
  (check 'destination-borrow-release (= (destination-unborrow borrow) 0)))
(restored 'native-publish-rollback)
(check 'atomic-four-words-and-counts (equal? expected (publication)))
(evaluate)
(check 'native-publish-same-bound-retry (equal? expected (publication)))
;;; Full production restore catches late binding failure and always finishes.
(begin-partial #t)
(check 'second-real-traversal (e3-traverse! frame dataset))
(let* ((handles (vector-ref binding-record 10)) (saved (vector-ref handles 0)))
  (vector-set! handles 0 #f)
  (check 'closed-late-check-denied (not (e3-restore-closed! frame #t)))
  (vector-set! handles 0 saved))
(check 'typed-first-late-check
  (and (transformer-error? (vector-ref entry 11))
       (eq? (transformer-error-category (vector-ref entry 11)) 'invalid-state)
       (eq? (transformer-error-operation (vector-ref entry 11)) 'e3-evaluate-into!)
       (= (vector-ref entry 15) (+ (* 12 12) (e3-error-category-index 'invalid-state)))
       (= (vector-ref (vector-ref entry 12) 0) 12)
       (= (vector-ref (vector-ref entry 12) 1) 0)
       (= (vector-ref (vector-ref entry 12) 2) 5)
       (= (vector-ref (vector-ref entry 12) 3) 9)
       (vector-ref entry 14)))
(restored 'closed-check-finishes)
(check 'closed-check-keeps-report (equal? expected (publication)))
(evaluate)
(restored 'final-retry)
;;; Restored logical position produces the same next data at newer generation.
(define old-generation (vector-ref state 8))
(define next-batch (d2-token-dataset-next-batch dataset))
(check 'generation-not-rewound (> (vector-ref state 8) old-generation))
(d2-token-tensor-with-view-internal (d2-token-batch-inputs next-batch)
  (lambda (view)
    (check 'same-logical-next-data
      (and (= (view-word view 0) 7) (= (view-word view 1) 2)
           (= (view-word view 2) 9) (= (view-word view 3) 5)))))
(reject 'stale-first-capability (lambda () (d2-token-batch-validate first-batch)))
(d2-token-batch-release! next-batch)
(d2-token-dataset-seek! dataset cursor)
(display "CPU4-CONSUMER-REPORT ") (write expected) (newline)
(e3-frame-unbind! frame)
;;; Handoff uses the same still-live authenticated binding after real retirement.
(define handoff (cpu4-e3-frame-bind-internal binding second-destinations))
(with-region ('cpu4-consumer-handoff 262144)
  (e3-evaluate-into! model dataset handoff))
(check 'sequential-rebind-exact-report
  (equal? expected (publication-of handoff second-destinations)))
(check 'sequential-rebind-cursor
  (d2-core-bytes=? cursor (d2-token-dataset-cursor dataset)))
(check 'sequential-rebind-modes (equal? train-modes (modes)))
(check 'sequential-rebind-model (= (image-equal lease image) 1))
(e3-frame-unbind! handoff)
(d2-token-dataset-close! dataset)
(check 'release (cpu4-model-binding-release-internal! binding))
(image-destroy image)
(let loop ((i 0))
  (if (= i 4) #t
      (begin (check 'destroy (= (destination-destroy (vector-ref destinations i)) 0))
             (check 'second-destroy (= (destination-destroy (vector-ref second-destinations i)) 0))
             (loop (+ i 1)))))
(display "CPU4-CONSUMER-PASS checks=") (display checks) (newline)
