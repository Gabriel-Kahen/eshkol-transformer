;;; Feature-private original-owner P1/O2/C2 gate. Never install this root.
;;; One D2/T2/I2/P1 registry also hosts M3T, G3 and C2. The T1 and T2 byte
;;; tokenizer shells remain distinct; only their checked fingerprint matches.
(load "d2_wave2_root.esk")
(load "cli3_generate_t2_bridge.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "o2_wave2_extension.esk")
(load "c2_x1_canonical_extension.esk")
(load "c2_training_state_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "m3_call_adapters.esk")
(load "g3t_model_admission_extension.esk")
(load "g3t_generator_constructor_extension.esk")
(load "g3t_prefill_sample_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3t_output_text_extension.esk")
(load "g3t_final_publication_extension.esk")
(load "g3t_manual_p1_extension.esk")
(load "g3t_manual_logits_materialize_extension.esk")
(load "g3m_prefill_p1_extension.esk")
(load "g3m_prefill_p2_extension.esk")
(load "g3m_manual_decode_extension.esk")
(load "g3m_seeded_p1_g1_extension.esk")
(load "g3r_committed_save_snapshot_extension.esk")
(load "g3r_held_o2_adopter_extension.esk")
(load "g3r_joint_issued_o2_adopter_extension.esk")
(load "g3r_joint_begin_extension.esk")
(load "g3r_joint_c2_claim_extension.esk")
(load "g3r_joint_original_owner_binding_extension.esk")
(load "g3r_joint_p1_provenance_extension.esk")

(extern i64 g3r-test-held-bits-begin ptr
        :real et_g3r_test_held_bits_begin_v1)
(extern i64 g3r-test-held-bits-check ptr
        :real et_g3r_test_held_bits_check_v1)
(extern i64 g3r-test-held-bits-end ptr
        :real et_g3r_test_held_bits_end_v1)
(extern i64 g3t-test-fail-f32-after i64
        :real et_g3t_test_fail_f32_after_v1)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "G3-R HELD P1/C2 FAIL: ") (display label)
             (newline) (exit 1))))
(define (bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))
(define (byte-list=? left right)
  (if (null? left) (null? right)
      (and (pair? left) (pair? right)
           (bytes=? (car left) (car right))
           (byte-list=? (cdr left) (cdr right)))))
(define (error? thunk)
  (guard (caught (#t (transformer-error? caught))) (thunk) #f))
(define (dataset-config directory)
  (list ':directory directory ':batch-size 1 ':sequence-length 1
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 65536 ':maximum-batch-bytes 17
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f))
(define (handle-paths handles)
  (let loop ((index 0))
    (if (= index (vector-length handles)) '()
        (cons (parameter-handle-path (vector-ref handles index))
              (loop (+ index 1))))))
(define (optimizer-config handles)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        '(none) '(constant)
        (list (list 'group (handle-paths handles)
                    "3dcccccd" "3f000000" "3f000000"
                    "3a83126f" "00000000"))))
(define (policy)
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos #f ':seed 1729))
(define (parameter-bits handle)
  (i2-checkpoint-encode
    (vector (parameter-handle-tensor-internal handle) 'parameter
            (parameter-handle-shape handle) 'f32 'cpu
            'dense-row-major-contiguous 'g3r-held-p1-c2-gate)))
(define (model-bits handles)
  (let loop ((index 0))
    (if (= index 14) '()
        (cons (parameter-bits (vector-ref handles index))
              (loop (+ index 1))))))
(define (gradient-state handles)
  (let loop ((index 0))
    (if (= index 14) '()
        (cons (i2-parameter-gradient-metadata-internal
                (parameter-handle-tensor-internal
                  (vector-ref handles index)))
              (loop (+ index 1))))))
(define (snapshot generator)
  (let ((bytes (make-bytevector 136 0)))
    (g3r-committed-save-snapshot! generator bytes)
    bytes))
(define (fixture directory)
  (let* ((config
           (x1-private-config-resolve
             (x1-private-config-parse
               "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
             '()))
         (t1 (t2-private-tokenizer-byte config))
         (t2 (t2-wave2-tokenizer-byte config))
         (dataset (d2-token-dataset-open (dataset-config directory) t2))
         (model (with-region ('g3r-held-p1-model 65536)
                  (g3t-checked-m3t-model-create
                    config (g3t-checked-m3t-initializer-state 1729))))
         (handles (vector-ref (m3t-entry model 'model 'g3r-held-p1-c2-gate #t) 8))
         (optimizer (o2-public-optimizer-create
                      (optimizer-config handles) (module-parameters model)))
         (cursor (d2-token-dataset-cursor dataset))
         (controls
           (vector (vector 'philox4x32-10 1 1729 0 0)
                   (vector (t2-private-tokenizer-fingerprint t2) 256)
                   (vector cursor cursor)
                   (vector (string->utf8 (x1-private-config-canonical config))
                           (x1-private-config-fingerprint config))
                   (vector 0 0 0))))
    (check "T1/T2 fingerprint equality without shell identity"
           (and (not (eq? t1 t2))
                (string=? (vector-ref (vector-ref controls 1) 0)
                          g3r-save-tokenizer-fingerprint)))
    (check "fourteen original M3T handles" (= (vector-length handles) 14))
    (check "C2 controls accepted"
           (vector? (c2-training-state-controls-copy
                      'g3r-held-p1-c2-gate controls)))
    (check "model eval" (module-eval! model))
    (let* ((generator (g3t-generator-create model t1 (policy)))
           (input (g3t-generation-token-input-create 65))
           (output (g3m-generate-p1-g1! generator input)))
      (check "committed P1/G1 output released"
             (g3t-output-release! output))
      (vector config t1 t2 dataset model handles optimizer controls
              generator input))))
(define (controls tuple) (vector-ref tuple 7))
(define (begin-held tuple)
  (let* ((joint (g3r-joint-begin! (vector-ref tuple 8)
                                  (vector-ref tuple 4)
                                  (vector-ref tuple 1)
                                  (vector-ref tuple 6)))
         (o2 (g3r-joint-o2-adopt! joint (vector-ref tuple 6))))
    (check "joint and issued O2 live"
           (and (= 1 (g3r-joint-o2-lifecycle joint))
                (eq? (vector-ref o2 8) 'enrolled)
                (= 0 (g3r-joint-o2-issued-match
                        joint (vector-ref (vector-ref o2 4) 0)))))
    (vector joint o2)))
(define (clone tuple held)
  (g3r-joint-p1-provenance!
    (vector-ref tuple 8) (vector-ref tuple 4)
    (vector-ref tuple 1) (vector-ref tuple 6)
    (vector-ref held 1) (controls tuple)))
(define (claim tuple held p1)
  (g3r-joint-c2-original-bound-claim!
    (vector-ref tuple 8) (vector-ref tuple 4)
    (vector-ref tuple 1) (vector-ref tuple 6)
    (vector-ref held 1) p1 (controls tuple)))
(define (retire tuple)
  (check "input released"
         (g3t-generation-tensor-release! (vector-ref tuple 9)))
  (check "generator closed" (g3t-generator-close! (vector-ref tuple 8)))
  (check "dataset closed" (d2-token-dataset-close! (vector-ref tuple 3))))

(define corpus-directory (car (cdr (command-line))))
(define original (fixture corpus-directory))
(define before-bits (model-bits (vector-ref original 5)))
(define before-gradients (gradient-state (vector-ref original 5)))
(define before-history (snapshot (vector-ref original 8)))
(check "foreign model rejected before hold acquisition"
       (error? (lambda ()
                 (g3r-joint-begin! (vector-ref original 8)
                                   (vector 'foreign-model)
                                   (vector-ref original 1)
                                   (vector-ref original 6)))))
(define held (begin-held original))
(define native-model
  (vector-ref (g3t-model-entry-live
                (vector-ref original 4) 'g3r-held-p1-c2-gate #f) 3))
(check "all fourteen original value and absent-gradient bit baselines captured"
       (= 0 (g3r-test-held-bits-begin native-model)))
(define p1 (clone original held))
(check "exact P1 record and fourteen-path tied topology"
       (and (g3r-joint-p1-provenance-live-record p1)
            (equal? (vector-ref (vector-ref p1 3) 0)
                    (handle-paths (vector-ref original 5)))
            (equal? (vector-ref (vector-ref p1 3) 2)
                    '((("head" "weight") ("token_embedding" "weight"))))))
(check "held original bits and history unchanged by clone"
       (and (= 0 (g3r-test-held-bits-check native-model))
            (= 0 (g3r-joint-original-owner-match
                    (vector-ref held 0)
                    (vector-ref (g3t-generator-find
                                  (vector-ref original 8) 'g3r-held-p1-c2-gate) 3)
                    (vector-ref (g3t-model-entry-live
                                  (vector-ref original 4) 'g3r-held-p1-c2-gate #f) 3)
                    (vector-ref (o2-require-optimizer
                                  'g3r-held-p1-c2-gate
                                  (vector-ref original 6)) 1)))
            (let ((words (make-bytevector 136 0)))
              (and (= 0 (g3r-joint-c2-copy-words
                            (vector-ref held 0) words))
                   (bytes=? words before-history)))))
(check "all fourteen value and gradient witnesses close while pins live"
       (= 0 (g3r-test-held-bits-end native-model)))
(define claimed (claim original held p1))
(define claim-result (vector-ref claimed 2))
(define request (vector-ref claim-result 2))
(check "exact C2 claim and reverse-order hold drain"
       (and (eq? (vector-ref claim-result 4) 'drained)
            (= 2 (g3r-joint-o2-lifecycle (vector-ref held 0)))
            (eq? (vector-ref (vector-ref held 1) 8) 'c2-owned)
            (not (vector-ref request 1))
            (not (vector-ref request 2))
            (c2-training-state-find (vector-ref request 5))
            (bytes=? (vector-ref claim-result 3) before-history)))
(check "original fourteen values, gradients and G3 history unchanged"
       (and (byte-list=? before-bits (model-bits (vector-ref original 5)))
            (equal? before-gradients
                    (gradient-state (vector-ref original 5)))
            (bytes=? before-history (snapshot (vector-ref original 8)))))
(check "C2 owner released"
       (c2-training-state-release-internal!
         (vector-ref request 5) 'g3r-held-p1-c2-gate))
(retire original)

;;; A caller-side ledger substitution must release the registry-owned clone,
;;; retain the first error, and leave original holds for explicit reverse drain.
(define mutant (fixture corpus-directory))
(define mutant-held (begin-held mutant))
(define mutant-p1 (clone mutant mutant-held))
(define foreign-p1 (module-state-dict (vector-ref mutant 4)))
(vector-set! mutant-p1 2 foreign-p1)
(check "substituted P1 shell rejected and registry clone released"
       (and (error? (lambda () (claim mutant mutant-held mutant-p1)))
            (not (g3r-joint-p1-provenance-live-record mutant-p1))
            (vector-ref mutant-p1 5)
            (eq? (vector-ref (vector-ref mutant-held 1) 8) 'enrolled)))
(check "foreign P1 shell survives cleanup" (state-dict-release! foreign-p1))
(check "exact O2 then G3 preclaim drain"
       (and (g3r-joint-o2-drain-preclaim! (vector-ref mutant-held 1))
            (= 2 (g3r-joint-o2-lifecycle (vector-ref mutant-held 0)))))
(check "stale owner rejected" (error? (lambda () (clone mutant mutant-held))))
(retire mutant)

;;; A malformed control rejects before cloning. A topology fault after the
;;; provider clone must release precisely its detached P1 state, yet retain
;;; the issued O2 state and both original holds for a valid retry.
(define preclaim (fixture corpus-directory))
(define preclaim-history (snapshot (vector-ref preclaim 8)))
(define preclaim-held (begin-held preclaim))
(define invalid-controls (vector-copy (controls preclaim)))
(vector-set! invalid-controls 1 (vector "not-a-fingerprint" 256))
(check "malformed C2 controls reject before P1 clone"
       (error? (lambda ()
                 (g3r-joint-p1-provenance!
                   (vector-ref preclaim 8) (vector-ref preclaim 4)
                   (vector-ref preclaim 1) (vector-ref preclaim 6)
                   (vector-ref preclaim-held 1) invalid-controls))))
(define clone-count-before (i2-owned-clone-live-count-internal))
(define original-topology-query g3r-joint-p1-topology-query)
(set! g3r-joint-p1-topology-query
  (lambda (state operation)
    (let ((topology (original-topology-query state operation)))
      (vector '() (vector-ref topology 1) (vector-ref topology 2)))))
(check "provider clone with malformed topology rejects"
       (error? (lambda () (clone preclaim preclaim-held))))
(set! g3r-joint-p1-topology-query original-topology-query)
(check "failed topology releases detached P1 and preserves held originals"
       (and (= clone-count-before (i2-owned-clone-live-count-internal))
            (= 1 (g3r-joint-o2-lifecycle (vector-ref preclaim-held 0)))
            (eq? (vector-ref (vector-ref preclaim-held 1) 8) 'enrolled)
            (let ((words (make-bytevector 136 0)))
              (and (= 0 (g3r-joint-c2-copy-words
                            (vector-ref preclaim-held 0) words))
                   (bytes=? preclaim-history words)))))
(define preclaim-retry (clone preclaim preclaim-held))
(check "same held owner accepts valid P1 clone after cleanup"
       (g3r-joint-p1-provenance-live-record preclaim-retry))
(check "retry P1 shell releases before original hold"
       (g3r-joint-p1-provenance-release! preclaim-retry))
(check "retry P1 release tombstones exact registry record"
       (not (g3r-joint-p1-provenance-live-record preclaim-retry)))
(check "preclaim O2 then G3 drain"
       (and (g3r-joint-o2-drain-preclaim! (vector-ref preclaim-held 1))
            (= 2 (g3r-joint-o2-lifecycle (vector-ref preclaim-held 0)))))
(retire preclaim)

;;; Fail the authentic I2-owned F32 clone while both original pins and the
;;; exact issued O2 state are live. The same held owner must remain retryable.
(define provider-fault (fixture corpus-directory))
(define provider-fault-bits (model-bits (vector-ref provider-fault 5)))
(define provider-fault-gradients
  (gradient-state (vector-ref provider-fault 5)))
(define provider-fault-history (snapshot (vector-ref provider-fault 8)))
(define provider-fault-held (begin-held provider-fault))
(define provider-fault-native-model
  (vector-ref (g3t-model-entry-live
                (vector-ref provider-fault 4) 'g3r-held-p1-c2-gate #f) 3))
(check "provider cut captures all fourteen original witnesses"
       (= 0 (g3r-test-held-bits-begin provider-fault-native-model)))
(define provider-fault-clones (i2-owned-clone-live-count-internal))
(define provider-fault-p1-registry g3r-joint-p1-provenance-registry)
(define provider-fault-c2-registry c2-training-state-states)
(check "authentic F32 clone allocation cut armed"
       (= 0 (g3t-test-fail-f32-after 0)))
(define provider-fault-error
  (guard (caught (#t caught))
    (clone provider-fault provider-fault-held) #f))
(check "authentic F32 clone allocation cut reset"
       (= 0 (g3t-test-fail-f32-after 9223372036854775807)))
(check "provider allocation failure is typed at the I2 clone"
       (and (transformer-error? provider-fault-error)
            (eq? (transformer-error-category provider-fault-error) 'internal)
            (eq? (transformer-error-operation provider-fault-error)
                 'module-state-dict)))
(check "failed provider clone has no owned clone, P1 record or C2 child"
       (and (= provider-fault-clones
               (i2-owned-clone-live-count-internal))
            (eq? provider-fault-p1-registry
                 g3r-joint-p1-provenance-registry)
            (eq? provider-fault-c2-registry c2-training-state-states)))
(check "failed provider clone preserves both original pins and issued O2"
       (and (= 1 (g3r-joint-o2-lifecycle
                    (vector-ref provider-fault-held 0)))
            (eq? (vector-ref (vector-ref provider-fault-held 1) 8)
                 'enrolled)
            (= 0 (g3r-joint-o2-issued-match
                    (vector-ref provider-fault-held 0)
                    (vector-ref (vector-ref
                                  (vector-ref provider-fault-held 1) 4) 0)))
            (= 0 (g3r-joint-original-owner-match
                    (vector-ref provider-fault-held 0)
                    (vector-ref (g3t-generator-find
                                  (vector-ref provider-fault 8)
                                  'g3r-held-p1-c2-gate) 3)
                    provider-fault-native-model
                    (vector-ref (o2-require-optimizer
                                  'g3r-held-p1-c2-gate
                                  (vector-ref provider-fault 6)) 1)))))
(check "failed provider clone preserves fourteen held bit witnesses"
       (= 0 (g3r-test-held-bits-check provider-fault-native-model)))
(check "failed provider clone closes fourteen held bit witnesses"
       (= 0 (g3r-test-held-bits-end provider-fault-native-model)))
(check "failed provider clone preserves original values and gradients"
       (and (byte-list=? provider-fault-bits
                         (model-bits (vector-ref provider-fault 5)))
            (equal? provider-fault-gradients
                    (gradient-state (vector-ref provider-fault 5)))))
(check "failed provider clone preserves held seventeen history words"
       (let ((words (make-bytevector 136 0)))
         (and (= 0 (g3r-joint-c2-copy-words
                       (vector-ref provider-fault-held 0) words))
              (bytes=? words provider-fault-history))))
(define provider-fault-retry
  (clone provider-fault provider-fault-held))
(check "reset hook permits same-owner exact P1 retry"
       (and (g3r-joint-p1-provenance-live-record provider-fault-retry)
            (> (i2-owned-clone-live-count-internal)
               provider-fault-clones)))
(check "same-owner retry P1 releases"
       (g3r-joint-p1-provenance-release! provider-fault-retry))
(check "same-owner retry removes exact P1 clone"
       (and (not (g3r-joint-p1-provenance-live-record
                   provider-fault-retry))
            (= provider-fault-clones
               (i2-owned-clone-live-count-internal))))
(check "provider cut drains issued O2 then both original pins"
       (and (g3r-joint-o2-drain-preclaim!
              (vector-ref provider-fault-held 1))
            (= 2 (g3r-joint-o2-lifecycle
                    (vector-ref provider-fault-held 0)))))
(retire provider-fault)

;;; C2's injected O2 claim defect occurs after the token-matched O2 claim.
;;; Its guard rolls back both children; the joint guard releases issued O2 and
;;; drains originals; the outer provenance guard then releases exact P1.
(define partial (fixture corpus-directory))
(define partial-held (begin-held partial))
(define partial-p1 (clone partial partial-held))
(define original-o2-claim c2-training-state-claim-o2!)
(set! c2-training-state-claim-o2!
  (lambda (state token)
    (original-o2-claim state token)
    (m3t-fail 'internal 'g3r-held-p1-c2-gate "injected post-O2 claim")))
(check "partial C2 claim rolls back and preserves typed first error"
       (guard (caught
                (#t (and (transformer-error? caught)
                         (eq? (transformer-error-category caught) 'internal)
                         (eq? (transformer-error-operation caught)
                              'g3r-held-p1-c2-gate))))
         (claim partial partial-held partial-p1) #f))
(set! c2-training-state-claim-o2! original-o2-claim)
(check "partial claim retires P1/issued O2 and both original holds"
       (and (not (g3r-joint-p1-provenance-live-record partial-p1))
            (= 2 (g3r-joint-o2-lifecycle (vector-ref partial-held 0)))
            (eq? (vector-ref (vector-ref partial-held 1) 8) 'drained)))
(retire partial)
(display "G3-R held P1/C2 source aggregate PASS: checks=")
(display checks)
(newline)
