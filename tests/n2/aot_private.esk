;;; Test-only AOT orchestration. Native fixed buffers carry every tensor.
(extern i64 n2-test-provider
        :real et_n2_test_provider_transport_v1)

(if (= (n2-test-provider) 1)
    (begin
      (display "N2 PRIVATE AOT PASS: fixed native forward/backward dispatch")
      (newline)
      (exit 0))
    (begin
      (display "N2 PRIVATE AOT FAIL")
      (newline)
      (exit 1)))
