(require transformer.config)
(require transformer.module)
(require transformer.tokenizer)
(require transformer.error_public)
(require transformer.error_consumer)
(require transformer.diagnostic_transport)
(require transformer.model)

(define (check value) (if value #t (exit 1)))
(define args (command-line))
(define horizon (car (cdr args)))
(define mode (car (cdr (cdr args))))
(define limit (cond ((string=? horizon "1024") 1024)
                    ((string=? horizon "8192") 8192) (else (exit 64))))
(check (or (string=? mode "forward") (string=? mode "logits")
           (string=? mode "vjp") (string=? mode "reset") (string=? mode "failure")))
(define cfg (config-resolve
  (config-parse "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define model (diagnostic-model-create cfg (diagnostic-initializer-state 1729)))
(define input (diagnostic-input-create))
(define seed (diagnostic-logits-create))
(diagnostic-input-copy! input '(3 197))
(define graph (model-forward model input))
(define upstream (make-bytevector 2048 0))
(if (string=? mode "failure")
    (begin (bytevector-u8-set! upstream 2 192) (bytevector-u8-set! upstream 3 127)))
(diagnostic-logits-copy-bits! seed upstream)
(let loop ((iteration 0))
  (if (= iteration limit) #t
      (begin
        (with-region ('m3-measured-iteration 65536)
          (cond
            ((string=? mode "forward")
             (let ((output (model-forward model input))) (check (model-output-release! output))))
            ((string=? mode "logits")
             (let* ((output (model-forward model input)) (logits (model-output-logits output)))
               (check (model-output-release! output))
               (check (= (bytevector-length (diagnostic-model-logits-bits logits)) 2048))
               (check (diagnostic-model-logits-release! logits))))
            ((string=? mode "vjp")
             (check (diagnostic-output-vjp! graph seed 1065353216 iteration)))
            ((string=? mode "reset")
             (check (diagnostic-output-vjp! graph seed 1065353216 0))
             (check (module-zero-grad! model)))
            (else
             (let ((caught #f))
               (guard (raised
                        (#t (set! caught
                              (and (transformer-error? raised)
                                   (eq? (transformer-error-category raised) 'invalid-argument)
                                   (eq? (transformer-error-operation raised) 'diagnostic-output-vjp!)))))
                 (diagnostic-output-vjp! graph seed 1065353216 0))
               (check caught)))))
        (loop (+ iteration 1)))))
(model-output-release! graph)
(diagnostic-input-release! input)
(diagnostic-logits-release! seed)
(display "M3-ARENA-RETENTION-PASS ") (display mode) (display " ") (display limit) (newline)
