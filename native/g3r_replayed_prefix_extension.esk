;;; Private G3-R P1 continuation over an already committed manual cache.
;;; The native owner admits the replay; G3-T keeps sample/decode/publication.
(extern i64 g3r-native-replayed-call-acquire ptr ptr
        :real et_g3t_private_replayed_prefix_call_acquire_v1)

(define (g3r-replayed-call-acquire generator-entry)
  (let* ((operation 'g3r-replayed-call-acquire)
         (model-entry (vector-ref generator-entry 5))
         (shell (vector 'g3r-replayed-call-private))
         (entry (vector shell 'call 'pending (vector-ref generator-entry 3)
                        generator-entry model-entry
                        (vector-ref generator-entry 6) #f #f #f #f #f)))
    (if (not (eq? (vector-ref m3-call-state 0) #t))
        (g3t-fail-raw 'invalid-state operation 2
                      "G3-R call requires the shared M3 guard"))
    (if (not (and (eq? (vector-ref generator-entry 2) 'live)
                  (eq? (g3t-generator-find
                         (vector-ref generator-entry 0) operation)
                       generator-entry)
                  (eq? (vector-ref generator-entry 9) #f)
                  (eq? (vector-ref model-entry 10) #f)
                  (eq? (g3t-model-entry-live
                         (vector-ref model-entry 0) operation #f)
                       model-entry)))
        (g3t-fail-raw 'invalid-state operation 2
                      "G3-R generator and exact model must be idle and live"))
    (vector-set! g3t-registry 0
                 (cons entry (vector-ref g3t-registry 0)))
    (if (not (= 0 (g3r-native-replayed-call-acquire
                     (vector-ref generator-entry 3)
                     (vector-ref model-entry 3))))
        (begin (g3t-prefill-dead! entry)
               (g3t-native-fail-raw operation)))
    (vector-set! generator-entry 9 entry)
    (vector-set! model-entry 10 entry)
    (vector-set! entry 2 'live)
    (vector-set! m3-call-state 0 entry)
    shell))

(define (g3r-generate-replayed-p1! generator)
  (let ((operation 'g3r-generate-replayed-p1!))
    (m3-call operation
      (let* ((generator-entry (g3t-generator-find generator operation))
             (model-entry (vector-ref generator-entry 5))
             (tokenizer (vector-ref generator-entry 6))
             (tokenizer-entry (t1-private-entry tokenizer)))
        (if (not (and (vector? generator-entry)
                      (= (vector-length generator-entry) 12)
                      (eq? (vector-ref generator-entry 1) 'generator)
                      (eq? (vector-ref generator-entry 2) 'live)
                      (eq? (vector-ref generator-entry 11) 'diagnostic-c2)
                      (eq? (vector-ref generator-entry 5) model-entry)
                      (pair? tokenizer-entry)
                      (eq? (car tokenizer-entry) tokenizer)
                      (pair? (cdr tokenizer-entry))
                      (null? (cdr (cdr tokenizer-entry)))))
            (g3t-fail-raw 'invalid-state operation 2
                          "G3-R generator/tokenizer registry binding changed"))
        (let ((core (car (cdr tokenizer-entry))))
          (if (not (and (t1-core-tokenizer? core)
                        (eq? (vector-ref core 1) 'raw)
                        (null? (vector-ref core 2))
                        (null? (vector-ref core 3))
                        (null? (vector-ref core 4))
                        (= (t1-tokenizer-core-vocab-size core) 256)
                        (string? (vector-ref core 6))
                        (string=? (vector-ref core 6)
                          "sha256:eshkol-byte-tokenizer-v1:aabb31f49216963582383a00fd2e85d7c20b658d5bef0e7945344ed6bfe50704")))
              (g3t-fail-raw 'invalid-state operation 2
                            "G3-R requires the exact registered raw V256 tokenizer")))
        (let ((call #f))
          (guard (caught
                   (#t (if call
                           (let ((entry (g3t-prefill-entry call 'call operation)))
                             (if (eq? (vector-ref entry 2) 'live)
                                 (g3t-call-abort call))))
                       (raise caught)))
            (set! call (g3r-replayed-call-acquire generator-entry))
            (let ((output (g3t-output-reserve call 1)))
              (g3t-sample call)
              (g3t-frame-begin call #f 2)
              (g3t-role-step call 0)
              (g3t-role-step call 1)
              (g3t-role-step call 2)
              (g3t-role-step call 3)
              (g3t-role-step call 4)
              (g3t-role-step call 5)
              (g3t-role-step call 6)
              (g3t-role-step call 7)
              (g3t-role-step call 8)
              (g3t-role-step call 9)
              (g3t-role-step call 10)
              (g3t-role-step call 11)
              (g3t-role-step call 12)
              (g3t-role-step call 13)
              (g3t-role-step call 14)
              (g3t-role-step call 15)
              (g3t-role-step call 16)
              (g3t-role-step call 17)
              (g3t-role-step call 18)
              (g3t-role-step call 19)
              (g3t-role-step call 20)
              (g3t-output-prepare call output)
              (g3t-t1-decode-output! call output)
              (g3t-final-commit! call output))))))))
