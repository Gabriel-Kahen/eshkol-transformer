(define path "eshkol-r0-file-io.txt")
(define out (open-output-file path))
(write-line "r0-safe-data-v1" out)
(close-port out)
(define in (open-input-file path))
(define line (read-line in))
(close-port in)
(display (if (string=? line "r0-safe-data-v1") "PASS file round trip" "FAIL file round trip"))
(newline)
(display "R0_DONE file_io") (newline)
