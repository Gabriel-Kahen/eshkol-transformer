        (loop (cdr remaining) (cons (car remaining) result)))))

(define (copy-data-consume! operation category depth composite ancestors budget)
  (vector-set! budget 0 (+ (vector-ref budget 0) 1))
  (if (or (> depth max-data-depth)
          (> (vector-ref budget 0) max-data-nodes)
          (and composite (identity-member-local? composite ancestors)))
      (fail category operation "data contains a cycle or exceeds bounds" '())
      #t))

(define (copy-data-walk operation category item depth ancestors budget)
  (cond
    ((pair? item)
     (if (not (bounded-acyclic-list-spine? item max-data-nodes))
         (fail category operation "data list is cyclic or exceeds bounds" '())
         (let loop ((remaining item) (result '()))
           (cond
             ((null? remaining) (copy-data-reverse result))
             ((not (pair? remaining))
              (copy-data-reverse-onto
                result
                (copy-data-walk operation category remaining depth ancestors
                                budget)))
             (else
               (copy-data-consume! operation category depth remaining ancestors
                                   budget)
               (loop (cdr remaining)
                     (cons (copy-data-walk
                             operation category (car remaining) (+ depth 1)
                             (cons remaining ancestors) budget)
                           result)))))))
    ((vector? item)
     (let ((size (vector-length item)))
       (if (> size max-data-nodes)
           (fail category operation "data vector exceeds bounds" '())
           #t)
       (copy-data-consume! operation category depth item ancestors budget)
       (if (> (+ (vector-ref budget 0) size) max-data-nodes)
           (fail category operation "data vector exceeds node budget" '())
           #t)
       (let ((result (make-vector size #f)))
         (let loop ((index 0))
           (if (= index size)
               result
               (begin
                 (vector-set! result index
                   (copy-data-walk operation category (vector-ref item index)
                                   (+ depth 1) (cons item ancestors) budget))
                 (loop (+ index 1))))))))
    ((string? item)
     (copy-data-consume! operation category depth #f ancestors budget)
     (if (> (string-byte-length item) max-string-bytes)
         (fail category operation "data string exceeds bounds" '())
         (string-copy item)))
    (else
      (copy-data-consume! operation category depth #f ancestors budget)
      item)))

(define (copy-data-for operation category value)
  (copy-data-walk operation category value 0 '() (vector 0)))

(define (copy-data value)
  (copy-data-for 'p1-core-copy 'internal value))

(define (list-reverse values)
  (let loop ((remaining values) (result '()))
    (if (null? remaining) result
        (loop (cdr remaining) (cons (car remaining) result)))))

(define (list-append left right)
  (if (null? left) right
      (cons (car left) (list-append (cdr left) right))))

(define (identity-member? value values)
  (cond
    ((null? values) #f)
    ((eq? value (car values)) #t)
    (else (identity-member? value (cdr values)))))

(define (list-length values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))

(define (valid-shape? shape)
  (and (bounded-list-length shape max-shape-rank)
       (let loop ((dimensions shape))
         (if (null? dimensions)
             #t
             (and (integer? (car dimensions))
                  (exact? (car dimensions))
                  (>= (car dimensions) 0)
                  (loop (cdr dimensions)))))))

(define (valid-name? name)
  (and (string? name)
       (> (string-length name) 0)
       (<= (string-byte-length name) max-string-bytes)
       (string=? name (utf8->string (string->utf8 name)))))

(define (valid-path? path)
  (and (bounded-list-length path max-path-segments)
       (not (null? path))
       (let loop ((segments path))
         (if (null? segments)
             #t
             (and (valid-name? (car segments))
                  (loop (cdr segments)))))))

(define (require-valid-name operation message name)
  (if (valid-name? name)
      #t
      (fail 'invalid-argument operation message '())))

(define (segment<? left right)
  (let ((left-bytes (string->utf8 left))
        (right-bytes (string->utf8 right)))
    (let loop ((index 0))
      (cond
        ((= index (bytevector-length left-bytes))
         (< index (bytevector-length right-bytes)))
        ((= index (bytevector-length right-bytes)) #f)
        ((< (bytevector-u8-ref left-bytes index)
            (bytevector-u8-ref right-bytes index)) #t)
        ((> (bytevector-u8-ref left-bytes index)
            (bytevector-u8-ref right-bytes index)) #f)
        (else (loop (+ index 1)))))))

(define (path<? left right)
  (let loop ((a left) (b right))
    (cond
      ((null? a) (not (null? b)))
      ((null? b) #f)
      ((segment<? (car a) (car b)) #t)
      ((segment<? (car b) (car a)) #f)
      (else (loop (cdr a) (cdr b))))))

(define (insert-path path paths)
  (cond
    ((null? paths) (list path))
    ((path<? path (car paths)) (cons path paths))
    (else (cons (car paths) (insert-path path (cdr paths))))))

(define (sort-paths paths)
  (let loop ((remaining paths) (result '()))
    (if (null? remaining)
        result
        (loop (cdr remaining) (insert-path (car remaining) result)))))

(define (entry-path entry) (vector-ref entry 1))

(define (insert-entry entry entries)
  (cond
    ((null? entries) (list entry))
    ((path<? (entry-path entry) (entry-path (car entries))) (cons entry entries))
    (else (cons (car entries) (insert-entry entry (cdr entries))))))

(define (sort-entries entries)
  (let loop ((remaining entries) (result '()))
    (if (null? remaining)
        result
        (loop (cdr remaining) (insert-entry (car remaining) result)))))

(define (path-member? path paths)
  (cond
    ((null? paths) #f)
    ((equal? path (car paths)) #t)
    (else (path-member? path (cdr paths)))))

(define (module-value? value)
  (and (vector? value) (= (vector-length value) 13)
       (eq? (vector-ref value 0) module-tag)))

(define (handle-value? value)
  (and (vector? value) (= (vector-length value) 8)
       (eq? (vector-ref value 0) parameter-handle-tag)))

(define (tree-value? value)
  (and (vector? value) (= (vector-length value) 3)
       (eq? (vector-ref value 0) parameter-tree-tag)))

(define (state-value? value)
  (and (vector? value) (= (vector-length value) 9)
       (eq? (vector-ref value 0) state-dict-tag)))

(define (state-tensor-value? value)
  (and (vector? value) (= (vector-length value) 3)
       (eq? (vector-ref value 0) state-tensor-tag)))

(define (state-entry-value? value)
  (and (vector? value) (= (vector-length value) 8)
       (eq? (vector-ref value 0) state-entry-tag)))

(define (tensor-provider-value? value)
  (and (vector? value)
       (or (= (vector-length value) 10) (= (vector-length value) 11))
       (eq? (vector-ref value 0) tensor-provider-tag)))

(define (require-module operation value)
  (if (module-value? value) value
      (fail 'invalid-argument operation "expected module" '())))

(define (require-handle operation value)
  (if (handle-value? value) value
      (fail 'invalid-argument operation "expected parameter handle" '())))

(define (require-tree operation value)
  (if (tree-value? value) value
      (fail 'invalid-argument operation "expected parameter tree" '())))

(define (require-state operation value)
  (if (state-value? value) value
      (fail 'invalid-argument operation "expected state dictionary" '())))

(define (state-lifecycle state) (vector-ref state 8))

(define (require-live-state operation value)
  (let* ((state (require-state operation value))
         (lifecycle (state-lifecycle state)))
    (if (and (vector? lifecycle) (= (vector-length lifecycle) 7)
             (eq? (vector-ref lifecycle 0) state-lifecycle-tag)
             (eq? (vector-ref lifecycle 1) 'live))
        state
        (fail 'invalid-state operation "state dictionary is released" '()))))

(define (state-use-begin! operation state access)
  (require-live-state operation state)
  (let ((lifecycle (state-lifecycle state)))
    (if (not (vector-ref lifecycle 6))
        (begin (vector-set! lifecycle 6 access) state)
        (fail 'invalid-state operation
              "state dictionary access is already active" '()))))

(define (state-use-end! operation state access)
  (let ((lifecycle (state-lifecycle (require-live-state operation state))))
    (if (eq? (vector-ref lifecycle 6) access)
        (begin (vector-set! lifecycle 6 #f) #t)
        (fail 'invalid-argument operation
              "state dictionary scoped access handle differs" '()))))

(define (tensor-provider-create-internal
          (name : symbol)
          (describe : (-> vector vector))
          (clone : (-> vector vector))
          (storage-identical? : (-> vector boolean))
          (value-equal? : (-> vector boolean))
          (device-equal? : (-> vector boolean))
          (prepare-load : (-> vector vector))
          (commit-load! : (-> vector vector))
          (release-owned! : (-> vector vector)))
  (if (not (symbol? name))
      (fail 'invalid-argument 'tensor-provider-create-internal
            "provider name must be a symbol" '())
      (if (not (and (procedure? describe) (procedure? clone)
                    (procedure? storage-identical?) (procedure? value-equal?)
                    (procedure? device-equal?) (procedure? prepare-load)
                    (procedure? commit-load!) (procedure? release-owned!)))
          (fail 'invalid-argument 'tensor-provider-create-internal
                "provider operations must be procedures" '())
          (vector tensor-provider-tag name describe clone storage-identical?
                  value-equal? device-equal? prepare-load commit-load!
                  release-owned!))))

(define (tensor-provider-name provider) (vector-ref provider 1))

(define (tensor-provider-identity provider)
  (list provider-identity-format provider-interface-major
        provider-interface-minor (tensor-provider-name provider)))

(define (state-provider-binding-find state)
  (require-live-state 'state-provider-binding-find state)
  (let* ((shell (shell-for-raw 'state state))
         (status (p1-native-state-provider native-context shell)))
    (if (= status 0)
        (raw-for-shell 'state-provider-binding-find 'provider
                       (p1-native-result-ptr native-context))
        (if (= (p1-native-error-code native-context) 11)
            #f
            (native-raise
              'state-provider-binding-find status
              (p1-native-error-code native-context))))))

(define (state-provider-bind! operation state provider)
  (let ((state-shell (shell-for-raw 'state state))
        (provider-shell (shell-for-raw 'provider provider)))
    (native-check operation
                  (p1-native-state-bind native-context state-shell
                                        provider-shell))
    (vector-set! (state-lifecycle state) 3 provider)
    state))

(define (tensor-provider-registration-find name)
  (let loop ((providers tensor-providers))
    (cond
      ((null? providers) #f)
      ((eq? name (vector-ref (car providers) 0)) (car providers))
      (else (loop (cdr providers))))))

(define (tensor-provider-find name)
  (let ((registration (tensor-provider-registration-find name)))
    (if registration (vector-ref registration 2) #f)))

(define (tensor-provider-snapshot provider)
  (vector tensor-provider-tag (vector-ref provider 1)
          (vector-ref provider 2) (vector-ref provider 3)
          (vector-ref provider 4) (vector-ref provider 5)
          (vector-ref provider 6) (vector-ref provider 7)
          (vector-ref provider 8) (vector-ref provider 9) #f))

(define (replace-shell-raw! operation kind old-raw new-raw)
  (let find ((entries shell-registry))
    (cond
      ((null? entries)
       (fail 'internal operation "opaque identity registry entry is missing" '()))
      ((and (eq? kind (vector-ref (car entries) 1))
            (eq? old-raw (vector-ref (car entries) 2)))
       (vector-set! (car entries) 2 new-raw))
      (else (find (cdr entries))))))

(define (native-created-callbacks-revoke! operation callbacks)
  (let loop ((remaining callbacks))
    (if (null? remaining)
        #t
        (begin
          (native-check
            operation
            (p1-native-callback-revoke native-context (car remaining)))
          (loop (cdr remaining))))))

(define (native-callback-identities operation)
  (let ((live-before (native-live-count operation))
        (tombstones-before (native-tombstone-count operation)))
    (let create ((index 0) (created '()))
      (if (= index 8)
          (let ((result (make-vector 8 #f)))
            (let install ((remaining (list-reverse created)) (slot 0))
              (if (null? remaining)
                  result
                  (begin
                    (vector-set! result slot (car remaining))
                    (install (cdr remaining) (+ slot 1))))))
          (let ((status (p1-native-callback-create native-context)))
            (if (= status 0)
                (create (+ index 1)
                        (cons (p1-native-result-ptr native-context) created))
                (let ((caught-status status)
                      (caught-code (p1-native-error-code native-context))
                      (released (list-length created)))
                  (native-created-callbacks-revoke! operation created)
                  (if (and (= (native-live-count operation) live-before)
                           (= (native-tombstone-count operation)
                              (+ tombstones-before released)))
                      (native-raise operation caught-status caught-code)
                      (fail 'internal operation
                            "partial callback cleanup count mismatch"
                            '())))))))))

(define (native-provider-seal! operation provider callbacks)
  (let ((shell (shell-for-raw 'provider provider)))
    (native-check
      operation
      (p1-native-provider-seal
        native-context shell
        (vector-ref callbacks 0) (vector-ref callbacks 1)
        (vector-ref callbacks 2) (vector-ref callbacks 3)
        (vector-ref callbacks 4) (vector-ref callbacks 5)
        (vector-ref callbacks 6) (vector-ref callbacks 7)))))

(define (native-provider-snapshot-check! operation provider)
  (if (not (= (vector-length provider) 11))
      (fail 'unsupported operation "tensor provider is not admitted" '())
      (let ((callbacks (vector-ref provider 10)))
        (native-check
          operation
          (p1-native-provider-matches
            native-context (shell-for-raw 'provider provider)
            (vector-ref callbacks 0) (vector-ref callbacks 1)
            (vector-ref callbacks 2) (vector-ref callbacks 3)
            (vector-ref callbacks 4) (vector-ref callbacks 5)
            (vector-ref callbacks 6) (vector-ref callbacks 7))))))

(define (native-callback-identities-revoke! operation callbacks)
  (let loop ((index 0))
    (if (= index 8)
        #t
        (begin
          (native-check
            operation
            (p1-native-callback-revoke native-context
                                       (vector-ref callbacks index)))
          (loop (+ index 1))))))

(define (native-provider-admission-abort!
          operation shell shell-record callbacks)
  (let* ((live-before (native-live-count operation))
         (tombstones-before (native-tombstone-count operation))
         (callback-count (if (vector? callbacks) 8 0))
         (released (+ callback-count 1)))
    (if (vector? callbacks)
        (native-callback-identities-revoke! operation callbacks)
        #t)
    (native-check operation
                  (p1-native-provider-abort native-context shell))
    ;; Retain native tombstones but make the rejected shell unusable through
    ;; the private Eshkol registry as well.
    (vector-set! shell-record 1 'revoked-provider)
    (vector-set! shell-record 2 #f)
    (if (and (= (native-live-count operation) (- live-before released))
             (= (native-tombstone-count operation)
                (+ tombstones-before released)))
        #t
        (fail 'internal operation
              "provider admission cleanup count mismatch" '()))))

(define (abort-unpublished-provider! operation provider)
  (let* ((shell (shell-for-raw 'provider provider))
         (shell-record (shell-entry shell))
         (existing
           (tensor-provider-registration-find (tensor-provider-name provider))))
    (if (and existing (eq? (vector-ref existing 1) shell))
        #f
        (native-provider-admission-abort!
          operation shell shell-record #f))))

(define (tensor-provider-register-internal! provider evidence)
  (if tensor-provider-admission-active?
      (begin
        (if (tensor-provider-value? provider)
            (let ((nested-shell (shell-for-raw 'provider provider)))
              ;; The outer guard owns cleanup of the provider currently being
              ;; admitted. Distinct nested providers have no such owner and
              ;; must be tombstoned here before the reentrancy failure escapes.
              (if (eq? nested-shell tensor-provider-admission-active-shell)
                  #f
                  (abort-unpublished-provider!
                    'tensor-provider-register-internal! provider)))
            #f)
        (fail 'invalid-state 'tensor-provider-register-internal!
              "tensor provider admission is not reentrant" '()))
      (if (not (tensor-provider-value? provider))
          (fail 'invalid-argument 'tensor-provider-register-internal!
                "expected tensor provider" '())
          (let ((existing
                  (tensor-provider-registration-find
                    (tensor-provider-name provider))))
            (if existing
                (let ((shell (shell-for-raw 'provider provider)))
                  (if (eq? (vector-ref existing 1) shell)
                      provider
                      (begin
                        (abort-unpublished-provider!
                          'tensor-provider-register-internal!
                          provider)
                        (fail 'invalid-state
                              'tensor-provider-register-internal!
                              "tensor provider name is already registered"
                              '()))))
                (let* ((admitted (tensor-provider-snapshot provider))
                       (shell (shell-for-raw 'provider provider))
                       (shell-record (shell-entry shell))
                       (live-before (native-live-count
                                      'tensor-provider-register-internal!))
                       (tombstones-before (native-tombstone-count
                                            'tensor-provider-register-internal!))
                       (registration
                         (vector (tensor-provider-name admitted)
                                 shell admitted))
                       (next-providers (cons registration tensor-providers))
                       (callbacks #f)
                       (outcome (vector #f #f))
                       (abort-failed? #f)
                       (abort-error #f))
                  (guard (error
                           (#t
                             (vector-set! outcome 0 #f)
                             (vector-set! outcome 1 error)
                             outcome))
                    (set! tensor-provider-admission-active-shell shell)
                    (tensor-provider-admit! admitted evidence)
                    (set! tensor-provider-admission-active-shell #f)
                    (set! callbacks
                          (native-callback-identities
                            'tensor-provider-register-internal!))
                    (if (and (= (native-live-count
                                  'tensor-provider-register-internal!)
                                (+ live-before 8))
                             (= (native-tombstone-count
                                  'tensor-provider-register-internal!)
                                tombstones-before))
                        #t
                        (fail 'internal 'tensor-provider-register-internal!
                              "provider callback admission count mismatch" '()))
                    (if (or (not shell-record)
                            (not (eq? (vector-ref shell-record 1) 'provider))
                            (not (eq? (vector-ref shell-record 2) provider)))
                        (fail 'internal 'tensor-provider-register-internal!
                              "opaque provider identity changed during admission"
                              '())
                        #t)
                    (native-provider-seal!
                      'tensor-provider-register-internal! provider callbacks)
                    (vector-set! outcome 0 #t)
                    (vector-set! outcome 1 admitted))
                  (if (vector-ref outcome 0)
                      (begin
                        ;; All allocations and recoverable branches precede
                        ;; sealing. These writes are bounded and nonraising.
                        (vector-set! admitted 10 callbacks)
                        (vector-set! shell-record 2 admitted)
                        (set! tensor-providers next-providers)
                        admitted)
                      (begin
                        (set! tensor-provider-admission-active-shell #f)
                        (guard (caught
                                 (#t
                                   (set! abort-failed? #t)
                                   (set! abort-error caught)
                                   #f))
                          (native-provider-admission-abort!
                            'tensor-provider-register-internal!
                            shell shell-record callbacks))
                        (if abort-failed?
                            (raise abort-error)
                            (raise (vector-ref outcome 1)))))))))))

(define (require-provider-name operation name)
  (if (not (symbol? name))
      (fail 'corrupt-data operation "malformed tensor provider name" '())
      (let ((provider (tensor-provider-find name)))
        (if provider
            (begin (native-provider-snapshot-check! operation provider)
                   provider)
            (fail 'unsupported operation "tensor provider is unavailable" '())))))

(define (require-provider operation provider)
  (if (and (tensor-provider-value? provider)
           (= (vector-length provider) 11))
      (begin (native-provider-snapshot-check! operation provider)
             provider)
      (fail 'unsupported operation "no verified tensor provider is configured" '())))

(define (tensor-provider-preflight-internal provider-name major minor)
  ;; Trusted persistence consumers reject obsolete inert identities before a
  ;; codec or provider callback can observe a carrier.
  (if (or (not (integer? major)) (not (exact? major))
          (not (integer? minor)) (not (exact? minor))
          (not (= major provider-interface-major))
          (not (= minor provider-interface-minor)))
      (fail 'version-mismatch 'tensor-provider-preflight-internal
            "unsupported tensor provider interface version" '())
      (require-provider-name 'tensor-provider-preflight-internal
                             provider-name)))

(define (tensor-provider-release-owned-internal!
          provider-name major minor release-envelope)
  (if (not (and (vector? release-envelope)
                (= (vector-length release-envelope) 4)))
      (fail 'invalid-argument 'tensor-provider-release-owned-internal!
            "owned tensor release envelope is invalid" '())
      #t)
  ;; Taxonomy is structural first: malformed, wrong-kind, or otherwise invalid
  ;; envelopes are invalid-argument even if a field happens to name a protected
  ;; live carrier.
  (if (not (and
             (vector-ref release-envelope 0)
             (or (eq? (vector-ref release-envelope 1) 'parameter)
                 (eq? (vector-ref release-envelope 1) 'buffer))
             (symbol? (vector-ref release-envelope 2))
             (eq? (vector-ref release-envelope 3) #f)))
      (fail 'invalid-argument 'tensor-provider-release-owned-internal!
            "owned tensor release envelope is invalid" '())
      #t)
  ;; This is the last-chance sanitizer for a decoder that republishes storage
  ;; from a live P1 state and then fails before adoption. It precedes provider
  ;; lookup/version checks so caller cleanup can never release that storage.
  (if (and (vector-ref release-envelope 0)
           (carrier-protected-from-release?
             'tensor-provider-release-owned-internal! #f
             (vector-ref release-envelope 0)
             (vector-ref release-envelope 1) #f))
      (begin
        (vector-set! release-envelope 0 #f)
        ;; Cleanup consumers must be able to continue releasing later genuine
        ;; owners without relying on exception unwinding across this private
        ;; module seam. False is the narrow protected-carrier rejection status.
        #f)
      (let ((provider
              (tensor-provider-preflight-internal
                provider-name major minor)))
        (let ((carrier (vector-ref release-envelope 0))
              (metadata-ok? #t)
              (metadata-error #f)
              (protected? #f))
          ;; A carrier must first pass this exact admitted provider's metadata
          ;; boundary. Neutralize before that first fallible provider call;
          ;; caller rollback must not retry an unvalidated carrier into the
          ;; destructive release callback.
          (vector-set! release-envelope 0 #f)
          (guard (caught
                   (#t
                     (set! metadata-ok? #f)
                     (set! metadata-error caught)
                     #f))
            (tensor-metadata
              'tensor-provider-release-owned-internal! provider carrier
              (vector-ref release-envelope 1)))
          (if (not metadata-ok?)
              (raise metadata-error)
              #t)
          ;; A defective comparator can report an error, but caller rollback
          ;; can never retry this neutral envelope into a destructive callback.
          (set! protected?
                (carrier-protected-from-release?
                  'tensor-provider-release-owned-internal! provider
                  carrier (vector-ref release-envelope 1) #t))
          (if protected?
              #f
              (begin
                (vector-set! release-envelope 0 carrier)
                (tensor-release-owned!
                  'tensor-provider-release-owned-internal!
                  provider release-envelope)))))))

(define (tensor-provider-admit-owned-internal!
          provider-name major minor release-envelope prior-envelopes)
  (let ((operation 'tensor-provider-admit-owned-internal!))
    (if (not (and (vector? release-envelope)
                  (= (vector-length release-envelope) 4)))
        (fail 'invalid-argument operation
              "owned tensor admission envelope is invalid" '())
        #t)
    (let ((carrier (vector-ref release-envelope 0))
          (kind (vector-ref release-envelope 1)))
      ;; Neutralize before provider lookup, metadata validation, or storage
      ;; comparison. Every fallible exit and every alias result therefore leaves
      ;; the later ambiguous publication without destructive release authority.
      (vector-set! release-envelope 0 #f)
      (if (not (and carrier
                    (or (eq? kind 'parameter) (eq? kind 'buffer))
                    (symbol? (vector-ref release-envelope 2))
                    (eq? (vector-ref release-envelope 3) #f)
                    (bounded-list-length prior-envelopes max-state-entries)))
          (fail 'invalid-argument operation
                "owned tensor admission input is invalid" '())
          #t)
      (let validate-priors ((remaining prior-envelopes))
        (if (null? remaining)
            #t
            (let ((item (car remaining)))
              (if (not (and (vector? item) (= (vector-length item) 4)
                            (not (eq? item release-envelope))
                            (or
                              (not (vector-ref item 0))
                              (and
                                (or (eq? (vector-ref item 1) 'parameter)
                                    (eq? (vector-ref item 1) 'buffer))
                                (symbol? (vector-ref item 2))
                                (eq? (vector-ref item 3) #f)))))
                  (fail 'invalid-argument operation
                        "prior owned tensor admission envelope is invalid" '())
                  (validate-priors (cdr remaining))))))
      (let ((provider
              (tensor-provider-preflight-internal provider-name major minor)))
        ;; The candidate and each actionable prior owner cross this exact
        ;; provider's metadata boundary before their first physical comparison.
        (tensor-metadata operation provider carrier kind)
        (let prevalidate-priors ((remaining prior-envelopes))
          (if (null? remaining)
              #t
              (let ((item (car remaining)))
                (if (vector-ref item 0)
                    (tensor-metadata operation provider
                                     (vector-ref item 0)
                                     (vector-ref item 1))
                    #t)
                (prevalidate-priors (cdr remaining)))))
        (if (or
              (owned-carrier-storage-member?
                operation provider carrier kind prior-envelopes '())
              (carrier-protected-from-release?
                operation provider carrier kind #t))
            #f
            (begin
              (vector-set! release-envelope 0 carrier)
              #t))))))

(define (device-budget-consume! depth budget)
  (vector-set! budget 0 (+ (vector-ref budget 0) 1))
  (and (<= depth max-data-depth)
       (<= (vector-ref budget 0) max-state-entries)))

(define (valid-device-walk? value depth ancestors budget)
  (cond
    ((symbol? value) (device-budget-consume! depth budget))
    ((string? value)
     (and (<= (string-byte-length value) max-string-bytes)
          (device-budget-consume! depth budget)))
    ((or (boolean? value)
         (and (integer? value) (exact? value)))
     (device-budget-consume! depth budget))
    ((null? value) (device-budget-consume! depth budget))
    ((pair? value)
     (and (not (identity-member-local? value ancestors))
          (bounded-acyclic-list-spine? value max-state-entries)
          (let loop ((remaining value))
            (cond
              ((null? remaining) #t)
              ((not (pair? remaining)) #f)
              (else
                (and (device-budget-consume! depth budget)
                     (valid-device-walk?
                       (car remaining) (+ depth 1)
                       (cons remaining ancestors) budget)
                     (loop (cdr remaining))))))))
    ((vector? value)
     (and (not (identity-member-local? value ancestors))
          (device-budget-consume! depth budget)
          (<= (+ (vector-ref budget 0) (vector-length value))
              max-state-entries)
          (let loop ((index 0))
            (if (= index (vector-length value))
                #t
                (and (valid-device-walk?
                       (vector-ref value index) (+ depth 1)
                       (cons value ancestors) budget)
                     (loop (+ index 1)))))))
    (else #f)))

(define (valid-device-descriptor? device)
  (and (not (or (null? device) (boolean? device)
                (integer? device) (string? device)))
       (valid-device-walk? device 0 '() (vector 0))))

(define (validate-provider-identity operation identity)
  (if (not (equal? (bounded-list-length identity 5) 4))
      (fail 'corrupt-data operation "malformed tensor provider identity" '())
      (if (not (and (symbol? (car identity))
                    (integer? (car (cdr identity)))
                    (exact? (car (cdr identity)))
                    (integer? (car (cdr (cdr identity))))
                    (exact? (car (cdr (cdr identity))))
                    (>= (car (cdr identity)) 0)
                    (>= (car (cdr (cdr identity))) 0)
                    (symbol? (car (cdr (cdr (cdr identity)))))))
          (fail 'corrupt-data operation "malformed tensor provider identity" '())
          (if (or (not (eq? (car identity) provider-identity-format))
                  (not (= (car (cdr identity)) provider-interface-major))
                  (not (= (car (cdr (cdr identity))) provider-interface-minor)))
              (fail 'version-mismatch operation
                    "unsupported tensor provider interface version" '())
              identity))))

(define (tensor-device-equal? operation provider left right)
  (let ((result ((vector-ref provider 6) (vector left right operation))))
    (if (boolean? result) result
        (fail 'internal operation
              "tensor provider device comparison returned non-boolean" '()))))

(define (tensor-metadata operation provider tensor kind)
  (let ((metadata ((vector-ref provider 2) (vector tensor kind operation))))
    (if (not (and (vector? metadata) (= (vector-length metadata) 4)))
        (fail 'internal operation "tensor provider returned malformed metadata" '())
        (let ((shape (vector-ref metadata 0))
              (dtype (vector-ref metadata 1))
              (device (vector-ref metadata 2))
              (layout (vector-ref metadata 3)))
          (if (not (valid-shape? shape))
              (fail 'corrupt-data operation "tensor provider returned malformed shape" '())
              (if (not (symbol? dtype))
                  (fail 'corrupt-data operation "tensor provider returned malformed dtype" '())
                  (if (not (valid-device-descriptor? device))
                      (fail 'corrupt-data operation
                            "tensor provider returned malformed device" '())
                      (if (not (symbol? layout))
                          (fail 'corrupt-data operation
                                "tensor provider returned malformed layout" '())
                          (if (not (eq? layout row-major-layout))
                              (fail 'noncontiguous operation
                                    "tensor is not dense row-major contiguous" '())
                              (if (and (eq? kind 'parameter) (not (eq? dtype 'f32)))
                                  (fail 'dtype-mismatch operation
                                        "parameters require f32 metadata" '())
                                  (if (and (eq? kind 'buffer)
                                           (not (or (eq? dtype 'bool)
                                                    (eq? dtype 'i64)
                                                    (eq? dtype 'f32))))
                                      (fail 'dtype-mismatch operation
                                            "buffers require bool, i64, or f32 metadata"
                                            '())
                                      (vector (copy-data shape) dtype
                                              (copy-data device) layout))))))))))))

(define (same-tensor-metadata! operation provider expected actual)
  (if (not (equal? (vector-ref expected 0) (vector-ref actual 0)))
      (fail 'shape-mismatch operation "provider clone changed tensor shape" '())
      (if (not (eq? (vector-ref expected 1) (vector-ref actual 1)))
          (fail 'dtype-mismatch operation "provider clone changed tensor dtype" '())
          (if (not (tensor-device-equal? operation provider
                                         (vector-ref expected 2)
                                         (vector-ref actual 2)))
              (fail 'device-mismatch operation "provider clone changed tensor device" '())
              #t))))

(define (tensor-release-owned! operation provider release-envelope)
  ;; The exact callback envelope was allocated and ledgered before publication.
  ;; Release performs no vector/cons allocation and clears carrier retention
  ;; even when the trusted callback raises after freeing the native owner.
  (if (not (and (vector? release-envelope)
                (= (vector-length release-envelope) 4)
                (vector-ref release-envelope 0)
                (or (eq? (vector-ref release-envelope 1) 'parameter)
                    (eq? (vector-ref release-envelope 1) 'buffer))
                (symbol? (vector-ref release-envelope 2))
                (eq? (vector-ref release-envelope 3) #f)))
      (fail 'internal operation "malformed owned tensor release envelope" '())
      (let ((tensor (vector-ref release-envelope 0))
            (kind (vector-ref release-envelope 1))
            (stored-operation (vector-ref release-envelope 2))
            (returned #f)
            (callback-failed? #f)
            (callback-error #f))
        (guard (caught
                 (#t
                   (set! callback-failed? #t)
                   (set! callback-error caught)
                   #f))
          (set! returned ((vector-ref provider 9) release-envelope)))
        (let ((valid?
                (and (eq? returned release-envelope)
                     (eq? (vector-ref release-envelope 0) tensor)
                     (eq? (vector-ref release-envelope 1) kind)
                     (eq? (vector-ref release-envelope 2)
                          stored-operation)
                     (eq? (vector-ref release-envelope 3) #t))))
          ;; Clear carrier retention outside the callback handler on every
          ;; path. Locals above are part of the already-entered call frame; no
          ;; vector or pair is allocated after release admission.
          (vector-set! release-envelope 0 #f)
          (if callback-failed?
              (raise callback-error)
              (if valid?
                  #t
                  (fail 'internal operation
                        "tensor provider returned malformed release acknowledgement"
                        '())))))))

(define (release-owned-list! operation provider ownership)
  (let ((items (vector-ref ownership 0)))
    ;; Clearing the ledger before callbacks makes reentrancy and raised release
    ;; callbacks exact-once. Continue releasing all remaining owners and then
    ;; rethrow the first provider defect.
    (vector-set! ownership 0 '())
    (let loop ((remaining items) (have-first-error? #f) (first-error #f))
      (if (null? remaining)
          (if have-first-error? (raise first-error) #t)
          (let ((item (car remaining))
                (item-failed? #f)
                (item-error #f))
            (if (and (vector? item) (= (vector-length item) 4)
                     (not (vector-ref item 0)))
                #t
                (guard (caught
                         (#t
                           (set! item-failed? #t)
                           (set! item-error caught)
                           #f))
                  (tensor-release-owned! operation provider item)))
            ;; Continue from ordinary control flow so a release callback defect
            ;; cannot skip later siblings under pinned strict AOT.
            (loop (cdr remaining)
                  (or have-first-error? item-failed?)
                  (if have-first-error? first-error item-error)))))))

(define (owned-carrier-identity-member? carrier envelopes)
  (cond
    ((null? envelopes) #f)
    ((and (vector? (car envelopes))
          (= (vector-length (car envelopes)) 4)
          (eq? carrier (vector-ref (car envelopes) 0))) #t)
    (else (owned-carrier-identity-member? carrier (cdr envelopes)))))

(define (owned-carrier-storage-member?
          operation provider carrier carrier-kind envelopes stop)
  ;; Scratch owners earlier in the same ledger are protected just like live
  ;; state owners. Only actionable, well-formed envelopes participate; the new
  ;; publication remains disarmed throughout this scan, so an alias or
  ;; comparator defect can never create a second destructive owner.
  (cond
    ((or (null? envelopes) (eq? envelopes stop)) #f)
    ((and (vector? (car envelopes))
          (= (vector-length (car envelopes)) 4)
          (vector-ref (car envelopes) 0)
          (or (eq? (vector-ref (car envelopes) 1) 'parameter)
              (eq? (vector-ref (car envelopes) 1) 'buffer))
          (or
            (eq? carrier (vector-ref (car envelopes) 0))
            (protected-storage-identical?
              operation provider carrier (vector-ref (car envelopes) 0)
              carrier-kind (vector-ref (car envelopes) 1)))) #t)
    (else
      (owned-carrier-storage-member?
        operation provider carrier carrier-kind (cdr envelopes) stop))))

(define (borrowed-carrier-identity-member? carrier borrowed)
  (cond
    ((null? borrowed) #f)
    ((eq? carrier (vector-ref (car borrowed) 0)) #t)
    (else (borrowed-carrier-identity-member? carrier (cdr borrowed)))))

(define (borrowed-carrier-storage-member?
          operation provider carrier carrier-kind borrowed)
  (cond
    ((null? borrowed) #f)
    ((protected-storage-identical?
       operation provider carrier (vector-ref (car borrowed) 0)
       carrier-kind (vector-ref (car borrowed) 1)) #t)
    (else
      (borrowed-carrier-storage-member?
        operation provider carrier carrier-kind (cdr borrowed)))))

(define (carrier-owned-by-live-state?
          operation provider carrier carrier-kind compare-storage?)
  ;; The registry is the sole process-local authority for published states.
  ;; Exact identity protection does not invoke a provider. After trusted
  ;; provider preflight, the same scan may use that provider's admitted
  ;; storage-identity callback to reject a distinct wrapper over live storage.
  (let scan-states ((records shell-registry))
    (if (null? records)
        #f
        (let* ((record (car records))
               (kind (vector-ref record 1))
               (raw (vector-ref record 2)))
          (if (and (eq? kind 'state)
                   (not (eq? raw dead-state-raw))
                   (state-value? raw)
                   (let ((lifecycle (state-lifecycle raw)))
                     (and (eq? (vector-ref lifecycle 1) 'live)
                          (or (not compare-storage?)
                              (eq? provider (vector-ref lifecycle 3)))
                          (let scan-owned
                               ((owned (vector-ref
                                         (vector-ref lifecycle 5) 0)))
                            (cond
                              ((null? owned) #f)
                              ((and
                                 (vector? (car owned))
                                 (= (vector-length (car owned)) 4)
                                 (vector-ref (car owned) 0)
                                 (or
                                   (eq? carrier
                                        (vector-ref (car owned) 0))
                                   (and compare-storage?
                                        (protected-storage-identical?
                                          operation provider carrier
                                          (vector-ref (car owned) 0)
                                          carrier-kind
                                          (vector-ref (car owned) 1))))) #t)
                              (else (scan-owned (cdr owned))))))))
              #t
              (scan-states (cdr records)))))))

(define (carrier-borrowed-by-module?
          operation provider carrier carrier-kind module compare-storage?)
  (let scan-parameters ((bindings (vector-ref module 2)))
    (if (null? bindings)
        (let scan-buffers ((buffers (vector-ref module 3)))
          (cond
            ((null? buffers) #f)
            ((or (eq? carrier (vector-ref (car buffers) 2))
                 (and compare-storage?
                      (protected-storage-identical?
                        operation provider carrier
                        (vector-ref (car buffers) 2)
                        carrier-kind 'buffer))) #t)
            (else (scan-buffers (cdr buffers)))))
        (let ((handle (vector-ref (car bindings) 2)))
          (if (or (eq? carrier (vector-ref handle 6))
                  (and compare-storage?
                       (protected-storage-identical?
                         operation provider carrier (vector-ref handle 6)
                         carrier-kind 'parameter)))
              #t
              (scan-parameters (cdr bindings)))))))

(define (carrier-protected-from-release?
          operation provider carrier carrier-kind compare-storage?)
  ;; Modules borrow their parameter/buffer carriers and published states own
  ;; their ledger carriers. Neither class may be authorized by clone, codec,
  ;; adoption, or the narrow private release helper as a new owner.
  (if (carrier-owned-by-live-state?
        operation provider carrier carrier-kind compare-storage?)
      #t
      (let scan-modules ((records shell-registry))
        (if (null? records)
            #f
            (let* ((record (car records))
                   (kind (vector-ref record 1))
                   (raw (vector-ref record 2)))
              (if (and
                    (eq? kind 'module) (module-value? raw)
                    (or (not compare-storage?)
                        (eq? provider (vector-ref raw 6)))
                    (carrier-borrowed-by-module?
                      operation provider carrier carrier-kind raw
                      compare-storage?))
                  #t
                  (scan-modules (cdr records))))))))

(define (tensor-copy-outcome
          operation provider tensor kind ownership borrowed-carriers)
  (let* ((source-metadata #f)
         (published-metadata #f)
         (request (vector tensor kind operation #f))
         (release-envelope (vector #f kind operation #f))
         (ledger-cell
           (cons release-envelope (vector-ref ownership 0)))
         (publication-admitted? #f)
         (storage-outcome (vector #f #f))
         (outcome (vector #f #f)))
    ;; The envelope and its list cell exist before provider publication.
    (vector-set! ownership 0 ledger-cell)
    (guard (caught
             (#t
               (vector-set! outcome 0 #f)
               (vector-set! outcome 1 caught)
               outcome))
      (vector-set! outcome 0 #t)
      (set! source-metadata
            (tensor-metadata operation provider tensor kind))
      (vector-set! outcome 1 ((vector-ref provider 3) request)))
    ;; Publication admission also runs outside the clone callback guard. Every
    ;; provider storage comparison is captured into the same total outcome so
    ;; a defective comparison cannot escape around caller ledger cleanup.
    (let ((published (vector-ref request 3)))
      (if published
          (if (or (borrowed-carrier-identity-member?
                    published borrowed-carriers)
                  (carrier-protected-from-release?
                    operation provider published kind #f)
                  (eq? published request)
                  (eq? published release-envelope)
                  (eq? published kind)
                  (eq? published operation)
                  (owned-carrier-identity-member?
                    published (cdr ledger-cell)))
              ;; A borrowed source or an earlier owner is not a new owner for
              ;; this envelope and must never be released through it.
              (vector-set! release-envelope 0 #f)
              (begin
                (guard (caught
                         (#t
                           (vector-set! storage-outcome 0 #f)
                           (vector-set! storage-outcome 1 caught)
                           storage-outcome))
                  (vector-set! storage-outcome 0 #t)
                  ;; Validate the published carrier with the exact admitted
                  ;; provider before its first storage-identity comparison.
                  ;; The release envelope is still neutral here.
                  (set! published-metadata
                        (tensor-metadata operation provider published kind))
                  (vector-set!
                    storage-outcome 1
                    (or
                      (borrowed-carrier-storage-member?
                        operation provider published kind borrowed-carriers)
                      (owned-carrier-storage-member?
                        operation provider published kind (cdr ledger-cell) #f)
                      (carrier-protected-from-release?
                        operation provider published kind #t))))
                (if (not (vector-ref storage-outcome 0))
                    (begin
                      ;; A provider that cannot establish physical ownership
                      ;; separation cannot authorize destructive rollback.
                      (vector-set! release-envelope 0 #f)
                      (if (vector-ref outcome 0)
                          (begin
                            (vector-set! outcome 0 #f)
                            (vector-set! outcome 1
                                         (vector-ref storage-outcome 1)))
                          #t))
                    (if (vector-ref storage-outcome 1)
                        (vector-set! release-envelope 0 #f)
                        (begin
                          (vector-set! release-envelope 0 published)
                          (set! publication-admitted? #t))))))
          #t))
    (if (vector-ref outcome 0)
        ;; Every validation failure is captured here. The total core never
        ;; raises across its guard boundary; ownership orchestrators can drain
        ;; their ledgers in ordinary control flow.
        (guard (caught
                 (#t
                   (vector-set! outcome 0 #f)
                   (vector-set! outcome 1 caught)
                   outcome))
          (let ((returned (vector-ref outcome 1)))
            (if (not (and (eq? returned request)
                          (eq? (vector-ref request 0) tensor)
                          (eq? (vector-ref request 1) kind)
                          (eq? (vector-ref request 2) operation)))
                (fail 'internal operation
                      "tensor provider substituted its clone request" '())
                #t)
            (let ((copied (vector-ref request 3)))
              (if (not copied)
                  (fail 'internal operation
                        "tensor provider did not publish its owned clone" '())
                  #t)
              ;; Publication identity was sanitized before callback-error
              ;; propagation and before this envelope became actionable. Do
              ;; not rescan after installation: a live target ledger would see
              ;; its own newly recorded carrier as protected storage.
              (if (not publication-admitted?)
                  (fail
                    'internal operation
                    "tensor provider did not publish a new unique clone identity"
                    '())
                  #t)
              (let ((copied-metadata published-metadata))
                (same-tensor-metadata! operation provider source-metadata
                                       copied-metadata)
                (if (tensor-storage-identical?
                      operation provider tensor copied kind kind)
                    (fail 'internal operation
                          "tensor provider clone aliases source storage" '())
                    (if (not (tensor-value-equal?
                               operation provider tensor copied kind))
                        (fail 'internal operation
                              "tensor provider clone changed tensor value" '())
                        (begin
                          (vector-set! outcome 0 #t)
                          (vector-set! outcome 1 copied)
                          outcome)))))))
        outcome)
    outcome))

(define (tensor-copy operation provider tensor kind ownership borrowed-carriers)
  ;; This wrapper contains no guard. Admission and state snapshot callers have
  ;; an enclosing ownership guard, so a total-core failure enters that caller's
  ;; rollback handler without crossing a nested handler rethrow.
  (let ((outcome
          (tensor-copy-outcome operation provider tensor kind ownership
                               borrowed-carriers)))
    (if (vector-ref outcome 0)
        (vector-ref outcome 1)
        (raise (vector-ref outcome 1)))))

(define (protected-storage-identical?
          operation provider left right left-kind right-kind)
  ;; One process-local request is allocated before any callback can publish an
  ;; owner. P1 is serialized/nonreentrant, so protection scans may reuse it
  ;; without allocating after publication or while a release envelope is
  ;; disarmed. Every exit clears temporary carrier references.
  (if protected-storage-comparison-active?
      (fail 'invalid-state operation
            "protected storage comparison is not reentrant" '())
      #t)
  (set! protected-storage-comparison-active? #t)
  (vector-set! protected-storage-comparison-request 0 left)
  (vector-set! protected-storage-comparison-request 1 right)
  (vector-set! protected-storage-comparison-request 2 left-kind)
  (vector-set! protected-storage-comparison-request 3 right-kind)
  (vector-set! protected-storage-comparison-request 4 operation)
  (let ((returned #f) (callback-failed? #f) (callback-error #f))
    (guard (caught
             (#t
               (set! callback-failed? #t)
               (set! callback-error caught)
               #f))
      (set! returned
            ((vector-ref provider 4) protected-storage-comparison-request)))
    (let ((valid?
            (and (boolean? returned)
                 (eq? (vector-ref protected-storage-comparison-request 0) left)
                 (eq? (vector-ref protected-storage-comparison-request 1) right)
                 (eq? (vector-ref protected-storage-comparison-request 2)
                      left-kind)
                 (eq? (vector-ref protected-storage-comparison-request 3)
                      right-kind)
                 (eq? (vector-ref protected-storage-comparison-request 4)
                      operation))))
      (vector-set! protected-storage-comparison-request 0 #f)
      (vector-set! protected-storage-comparison-request 1 #f)
      (vector-set! protected-storage-comparison-request 2 #f)
      (vector-set! protected-storage-comparison-request 3 #f)
      (vector-set! protected-storage-comparison-request 4 #f)
      (set! protected-storage-comparison-active? #f)
      (if callback-failed?
          (raise callback-error)
          (if valid?
              returned
              (fail 'internal operation
                    "tensor provider corrupted protected storage comparison"
                    '()))))))

(define (tensor-storage-identical? operation provider left right left-kind right-kind)
  ;; Every storage comparison, including ordinary pre-commit alias checks,
  ;; shares the same serialized lifetime pin and preallocated request. A
  ;; provider callback therefore cannot reenter a public/trusted P1 boundary
  ;; to retain or destroy either carrier and then return a misleading result.
  (protected-storage-identical?
    operation provider left right left-kind right-kind))

(define (tensor-value-equal? operation provider left right kind)
  (let ((result ((vector-ref provider 5) (vector left right kind operation))))
    (if (boolean? result) result
        (fail 'internal operation "tensor provider equality returned non-boolean" '()))))

(define (tensor-prepare-load operation provider assignments)
  (let ((result ((vector-ref provider 7) (vector assignments operation))))
    (if (and (vector? result) (= (vector-length result) 1)
             (vector? (vector-ref result 0)))
        (vector-ref result 0)
        (fail 'internal operation "tensor provider returned malformed load plan" '()))))

(define (tensor-commit-load! operation provider plan)
  ;; Registration requires this whole-batch commit to be one-shot,
  ;; allocation-free, infallible, and non-raising after preparation succeeds.
  (let ((returned ((vector-ref provider 8) plan)))
    (if (eq? returned plan)
        #t
        ;; This is a trusted-provider contract violation detected after the
        ;; mutation boundary, not a recoverable malformed-state branch.
        (fail 'internal operation
              "tensor provider substituted the validated commit carrier" '()))))

(define (admission-evidence-valid? evidence)
  (let ((count (bounded-list-length evidence 17)))
    (and count (>= count 2) (<= count 16)
         (let loop ((remaining evidence))
           (if (null? remaining)
               #t
               (let ((assignment (car remaining)))
                 (and (vector? assignment) (= (vector-length assignment) 3)
                      (or (eq? (vector-ref assignment 2) 'parameter)
                          (eq? (vector-ref assignment 2) 'buffer))
                      (loop (cdr remaining)))))))))

(define (assignment-borrowed-carriers assignments)
  (let scan ((remaining assignments) (result '()))
    (if (null? remaining)
        result
        (let* ((assignment (car remaining))
               (destination (vector-ref assignment 0))
               (source (vector-ref assignment 1))
               (kind (vector-ref assignment 2))
               (with-destination
                 (if (borrowed-carrier-identity-member? destination result)
                     result
                     (cons (vector destination kind) result))))
          (scan (cdr remaining)
                (if (borrowed-carrier-identity-member?
                      source with-destination)
                    with-destination
                    (cons (vector source kind) with-destination)))))))

(define (assignment-baselines
          operation provider assignments field ownership borrowed-carriers)
  (let loop ((remaining assignments) (result '()))
    (if (null? remaining)
        (list-reverse result)
        (let* ((assignment (car remaining))
               (kind (vector-ref assignment 2))
               (tensor (vector-ref assignment field)))
          (let ((copy
                  (tensor-copy operation provider tensor kind ownership
                               borrowed-carriers)))
            (loop (cdr remaining) (cons copy result)))))))

(define (assignments-match-baselines?
          operation provider assignments field baselines)
  (let loop ((remaining assignments) (copies baselines))
    (if (null? remaining)
        #t
        (let* ((assignment (car remaining))
               (kind (vector-ref assignment 2)))
          (and (tensor-value-equal? operation provider
                                    (vector-ref assignment field)
                                    (car copies) kind)
               (loop (cdr remaining) (cdr copies)))))))

(define (assignments-committed?
          operation provider assignments destination-identities)
  (let loop ((remaining assignments) (identities destination-identities))
    (if (null? remaining)
        #t
        (let* ((assignment (car remaining))
               (destination (vector-ref assignment 0))
               (source (vector-ref assignment 1))
               (kind (vector-ref assignment 2)))
          (and (eq? destination (car identities))
               (tensor-value-equal? operation provider destination source kind)
               (loop (cdr remaining) (cdr identities)))))))

(define (assignment-identities assignments field)
  (let loop ((remaining assignments) (result '()))
    (if (null? remaining)
        (list-reverse result)
        (loop (cdr remaining)
              (cons (vector-ref (car remaining) field) result)))))

(define (admission-evidence-nontrivial? operation provider assignments)
  (let loop ((remaining assignments))
    (if (null? remaining)
        #t
        (let* ((assignment (car remaining))
               (destination (vector-ref assignment 0))
               (source (vector-ref assignment 1))
               (kind (vector-ref assignment 2)))
          (and (not (tensor-value-equal? operation provider
                                         destination source kind))
               (loop (cdr remaining)))))))

(define (admission-storage-item-identity-member? carrier items)
  (cond
    ((null? items) #f)
    ((eq? carrier (vector-ref (car items) 0)) #t)
    (else
      (admission-storage-item-identity-member? carrier (cdr items)))))

(define (prevalidate-admission-storage-items operation provider assignments)
  ;; Provider storage identity is meaningful only for a carrier already
  ;; accepted by that exact provider. Validate every evidence occurrence
  ;; before the first comparison, while retaining one kind-tagged item per
  ;; exact wrapper for the bounded equivalence probe.
  (let loop ((remaining assignments) (items '()))
    (if (null? remaining)
        (list-reverse items)
        (let* ((assignment (car remaining))
               (destination (vector-ref assignment 0))
               (source (vector-ref assignment 1))
               (kind (vector-ref assignment 2))
               (with-destination
                 (begin
                   (tensor-metadata operation provider destination kind)
                   (if (admission-storage-item-identity-member?
                         destination items)
                       items
                       (cons (vector destination kind) items)))))
          (tensor-metadata operation provider source kind)
          (loop
            (cdr remaining)
            (if (admission-storage-item-identity-member?
                  source with-destination)
                with-destination
                (cons (vector source kind) with-destination)))))))

(define (prove-admission-storage-equivalence!
          operation provider items)
  ;; Admission evidence declares every distinct scratch carrier physically
  ;; disjoint. Probe the existing callback as a stable equivalence relation:
  ;; exact wrappers are reflexive twice, and every distinct pair is false in
  ;; both directions twice. Non-booleans are rejected by the callback wrapper.
  (let outer ((remaining items))
    (if (null? remaining)
        #t
        (let* ((left-item (car remaining))
               (left (vector-ref left-item 0))
               (left-kind (vector-ref left-item 1))
               (self-first
                 (protected-storage-identical?
                   operation provider left left left-kind left-kind))
               (self-second
                 (protected-storage-identical?
                   operation provider left left left-kind left-kind)))
          (if (not (and self-first self-second))
              (fail 'unsupported operation
                    "provider storage identity is not stably reflexive" '())
              #t)
          (let pairs ((others (cdr remaining)))
            (if (null? others)
                (outer (cdr remaining))
                (let* ((right-item (car others))
                       (right (vector-ref right-item 0))
                       (right-kind (vector-ref right-item 1))
                       (left-right-first
                         (protected-storage-identical?
                           operation provider left right
                           left-kind right-kind))
                       (right-left-first
                         (protected-storage-identical?
                           operation provider right left
                           right-kind left-kind))
                       (left-right-second
                         (protected-storage-identical?
                           operation provider left right
                           left-kind right-kind))
                       (right-left-second
                         (protected-storage-identical?
                           operation provider right left
                           right-kind left-kind)))
                  (if (or left-right-first right-left-first
                          left-right-second right-left-second)
                      (fail
                        'unsupported operation
                        "provider storage identity is not stable, symmetric, and disjoint"
                        '())
                      (pairs (cdr others))))))))))

(define (tensor-provider-admit! provider evidence)
  (if tensor-provider-admission-active?
      (fail 'invalid-state 'tensor-provider-register-internal!
            "tensor provider admission is not reentrant" '())
      (let ((ownership (vector '()))
            (outcome (vector #f #f))
            (cleanup-failed? #f)
            (cleanup-error #f))
        (set! tensor-provider-admission-active? #t)
        (guard (error
                 (#t
                   (vector-set! outcome 0 #f)
                   (vector-set! outcome 1 error)
                   outcome))
          (if (not (admission-evidence-valid? evidence))
              (begin
                (set! tensor-provider-admission-active? #f)
                (fail 'invalid-argument 'tensor-provider-register-internal!
                      "provider admission requires 2..16 scratch assignments" '()))
              (let* ((operation 'tensor-provider-register-internal!)
                     (storage-items
                       (prevalidate-admission-storage-items
                         operation provider evidence))
                     (storage-equivalence
                       (prove-admission-storage-equivalence!
                         operation provider storage-items))
                     (borrowed-carriers
                       (assignment-borrowed-carriers evidence))
                     (destination-identities
                       (assignment-identities evidence 0))
                     (destination-baselines
                       (assignment-baselines operation provider evidence 0
                                             ownership borrowed-carriers))
                     (source-baselines
                       (assignment-baselines operation provider evidence 1
                                             ownership borrowed-carriers))
                     (nontrivial
                       (if (admission-evidence-nontrivial?
                             operation provider evidence)
                           #t
                           (fail 'invalid-argument operation
                                 "provider admission destinations must differ"
                                 '())))
                     (unique
                       (ensure-assignment-storage-unique!
                         operation provider evidence))
                     (disjoint
                       (ensure-sources-do-not-alias-destinations!
                         operation provider evidence))
                     (plan (tensor-prepare-load operation provider evidence)))
                (if (not (and
                           (assignments-match-baselines?
                             operation provider evidence 0
                             destination-baselines)
                           (assignments-match-baselines?
                             operation provider evidence 1 source-baselines)))
                    (begin
                      (set! tensor-provider-admission-active? #f)
                      (fail 'unsupported operation
                            "provider prepare mutated admission tensors" '()))
                    (let ((returned ((vector-ref provider 8) plan)))
                      (if (not (eq? returned plan))
                          (begin
                            (set! tensor-provider-admission-active? #f)
                            (fail 'unsupported operation
                                  "provider commit substituted its plan carrier"
                                  '()))
                          (if (not (and
                                     (assignments-committed?
                                       operation provider evidence
                                       destination-identities)
                                     (assignments-match-baselines?
                                       operation provider evidence 1
                                       source-baselines)))
                              (begin
                                (set! tensor-provider-admission-active? #f)
                                (fail 'unsupported operation
                                      "provider commit failed admission evidence"
                                      '()))
                              (let ((rejected-repeat?
                                      (guard (raised (#t #t))
                                        ((vector-ref provider 8) plan)
                                        #f)))
                                (if (not rejected-repeat?)
                                    (begin
                                      (set! tensor-provider-admission-active? #f)
                                      (fail 'unsupported operation
                                            "provider commit accepted a consumed plan"
                                            '()))
                                    (if (not (and
                                               (assignments-committed?
                                                 operation provider evidence
                                                 destination-identities)
                                               (assignments-match-baselines?
                                                 operation provider evidence 1
                                                 source-baselines)))
                                        (begin
                                          (set! tensor-provider-admission-active? #f)
                                          (fail 'unsupported operation
                                                "rejected repeat commit mutated admission tensors"
                                                '()))
                                        (begin
                                          (let ((release-live-before
                                                  (native-live-count operation))
                                                (release-tombstones-before
                                                  (native-tombstone-count
                                                    operation)))
                                            (release-owned-list!
                                              operation provider ownership)
                                            (if (and
                                                  (= (native-live-count operation)
                                                     release-live-before)
                                                  (= (native-tombstone-count
                                                       operation)
                                                     release-tombstones-before))
                                                #t
                                                (fail
                                                  'unsupported operation
                                                  "provider release callback changed native identity allocation state"
                                                  '())))
                                          (set! tensor-provider-admission-active? #f)
                                          (vector-set! outcome 0 #t)
                                          (vector-set! outcome 1 provider)
                                          outcome)))))))))))
        (if (vector-ref outcome 0)
            (vector-ref outcome 1)
            (begin
              ;; Cleanup stays inside the admission critical section, but its
              ;; guard records and returns. The selected error is raised only
              ;; after the ledger is drained and reentrancy is disabled.
              (set! tensor-provider-admission-active? #t)
              (guard (release-error
                       (#t
                         (set! cleanup-failed? #t)
                         (set! cleanup-error release-error)
                         #f))
                (release-owned-list!
                  'tensor-provider-register-internal! provider ownership))
              (set! tensor-provider-admission-active? #f)
              (if cleanup-failed?
                  (raise cleanup-error)
                  (raise (vector-ref outcome 1))))))))

(define (module-create-with-provider-internal provider-name)
  (let ((provider (require-provider-name 'module-create-with-provider-internal
                                         provider-name)))
  ;; Fields: tag, mode, parameters, buffers, children, parent, provider,
  ;; topology-finalized?, logical-device, subtree entry count, subtree node
  ;; count, subtree height in child edges, and maximum generated entry-path
  ;; depth relative to this module (zero when the subtree has no leaves).
    (vector module-tag 'train '() '() '() #f provider #f #f 0 1 0 0)))

(define (module-create-internal)
  (vector module-tag 'train '() '() '() #f #f #f #f 0 1 0 0))

(define (local-name-used? module name)
  (let scan ((groups (list (vector-ref module 2) (vector-ref module 3)
                           (vector-ref module 4))))
    (if (null? groups)
        #f
        (let scan-group ((items (car groups)))
          (cond
            ((null? items) (scan (cdr groups)))
            ((string=? name (vector-ref (car items) 1)) #t)
            (else (scan-group (cdr items))))))))

(define (module-root module)
  (if (vector-ref module 5) (module-root (vector-ref module 5)) module))

(define (require-root-module operation module)
  (require-module operation module)
  (if (vector-ref module 5)
      (fail 'invalid-state operation "public module receiver must be a root" '())
      module))

(define (require-mutable-module operation module)
  (if (vector-ref (module-root module) 7)
      (fail 'invalid-state operation "module topology is finalized" '())
      module))

(define (require-module-provider operation module)
  (require-provider operation (vector-ref module 6)))

(define (preflight-module-device operation provider module device)
  (let* ((root (module-root module)) (current (vector-ref root 8)))
    (if current
        (if (tensor-device-equal? operation provider current device)
            (vector root #f #f)
            (fail 'device-mismatch operation
                  "all module leaves must use one logical device" '()))
        (vector root #t (copy-data device)))))

(define (commit-module-device! plan)
  (if (vector-ref plan 1)
      (vector-set! (vector-ref plan 0) 8 (vector-ref plan 2))
      #t))

(define (claim-module-device! operation provider module device)
  (commit-module-device!
    (preflight-module-device operation provider module device)))

(define (module-storage-items module)
  ;; A tied parameter has many logical paths but one authoritative handle and
  ;; one storage.  Deduplicate by handle identity before invoking provider
  ;; storage comparisons so subtree admission is bounded by unique storages,
  ;; not the Cartesian product of aliases.
  (let walk ((pending (list module)) (seen-handles '()) (items '()))
    (if (null? pending)
        (list-reverse items)
        (let* ((current (car pending))
               (parameter-result
                 (let scan ((bindings (vector-ref current 2))
                            (seen seen-handles) (result items))
                   (if (null? bindings)
                       (vector seen result)
                       (let ((handle (vector-ref (car bindings) 2)))
                         (if (identity-member? handle seen)
                             (scan (cdr bindings) seen result)
                             (scan
                               (cdr bindings) (cons handle seen)
                               (cons (vector (vector-ref handle 6) 'parameter)
                                     result)))))))
               (next-seen (vector-ref parameter-result 0))
               (with-buffers
                 (let scan ((bindings (vector-ref current 3))
                            (result (vector-ref parameter-result 1)))
                   (if (null? bindings)
                       result
                       (scan
                         (cdr bindings)
                         (cons (vector (vector-ref (car bindings) 2) 'buffer)
                               result))))))
          (walk (prepend-child-modules (vector-ref current 4) (cdr pending))
                next-seen with-buffers)))))

(define (ensure-storage-distinct-from-items! operation provider tensor kind items)
  (let loop ((remaining items))
    (if (null? remaining)
        #t
        (if (tensor-storage-identical?
              operation provider tensor (vector-ref (car remaining) 0)
              kind (vector-ref (car remaining) 1))
            (fail 'internal operation
                  (if (eq? (vector-ref (car remaining) 1) 'parameter)
                      "module tensor aliases existing parameter storage"
                      "module tensor aliases existing buffer storage")
                  '())
            (loop (cdr remaining))))))

(define (ensure-storage-not-in-module! operation provider tensor kind module)
  (ensure-storage-distinct-from-items!
    operation provider tensor kind (module-storage-items module)))

(define (ensure-module-storage-distinct-from-tree! operation provider source tree)
  (let ((tree-items (module-storage-items tree)))
    (let loop ((source-items (module-storage-items source)))
      (if (null? source-items)
          #t
          (begin
            (ensure-storage-distinct-from-items!
              operation provider (vector-ref (car source-items) 0)
              (vector-ref (car source-items) 1) tree-items)
            (loop (cdr source-items)))))))

(define (module-ancestry operation module)
  (let loop ((current module) (depth 0) (result '()))
    (if (> depth max-topology-depth)
        (fail 'internal operation "module topology depth invariant failed" '())
        (let ((next (cons current result)))
          (if (vector-ref current 5)
              (loop (vector-ref current 5) (+ depth 1) next)
              (vector next depth))))))

(define (preflight-leaf-registration operation module)
  (let* ((ancestry (module-ancestry operation module))
         (modules (vector-ref ancestry 0))
         (depth (vector-ref ancestry 1))
         (root (car modules)))
    (if (>= depth max-path-segments)
        (fail 'invalid-argument operation
              "registered leaf path exceeds topology depth bound" '())
        (if (>= (vector-ref root 9) max-state-entries)
            (fail 'invalid-argument operation
                  "module state schema exceeds entry bound" '())
            (let loop ((remaining modules) (module-depth 0) (updates '()))
              (if (null? remaining)
                  (list-reverse updates)
                  (let* ((current (car remaining))
                         (candidate-path-depth (+ (- depth module-depth) 1))
                         (current-path-depth (vector-ref current 12)))
                    (loop
                      (cdr remaining) (+ module-depth 1)
                      (cons
                        (vector current (+ (vector-ref current 9) 1)
                                (if (> candidate-path-depth current-path-depth)
                                    candidate-path-depth current-path-depth))
                        updates)))))))))

(define (apply-leaf-topology-updates! updates)
  (let loop ((remaining updates))
    (if (null? remaining)
        #t
        (begin
          (vector-set! (vector-ref (car remaining) 0) 9
                       (vector-ref (car remaining) 1))
          (vector-set! (vector-ref (car remaining) 0) 12
                       (vector-ref (car remaining) 2))
          (loop (cdr remaining))))))

(define (preflight-child-topology operation module child)
  (let* ((ancestry (module-ancestry operation module))
         (modules (vector-ref ancestry 0))
         (parent-depth (vector-ref ancestry 1))
         (root (car modules))
         (child-entries (vector-ref child 9))
         (child-nodes (vector-ref child 10))
         (child-entry-depth (vector-ref child 12))
         (deepest (+ parent-depth 1 (vector-ref child 11)))
         (deepest-entry
           (if (= child-entry-depth 0)
               0
               (+ parent-depth 1 child-entry-depth))))
    (if (> deepest max-topology-depth)
        (fail 'invalid-argument operation
              "attached child exceeds topology depth bound" '())
        (if (> deepest-entry max-path-segments)
            (fail 'invalid-argument operation
                  "attached child generates an over-limit entry path" '())
        (if (> (+ (vector-ref root 9) child-entries) max-state-entries)
            (fail 'invalid-argument operation
                  "attached child exceeds module state entry bound" '())
            (if (> (+ (vector-ref root 10) child-nodes) max-topology-nodes)
                (fail 'invalid-argument operation
                      "attached child exceeds topology node bound" '())
                (let loop ((remaining modules) (depth 0) (updates '()))
                  (if (null? remaining)
                      (list-reverse updates)
                      (let* ((current (car remaining))
                             (candidate-height (- deepest depth))
                             (current-height (vector-ref current 11))
                             (candidate-entry-depth
                               (if (= deepest-entry 0)
                                   0
                                   (- deepest-entry depth)))
                             (current-entry-depth (vector-ref current 12)))
                        (loop
                          (cdr remaining) (+ depth 1)
                          (cons
                            (vector current
                                    (+ (vector-ref current 9) child-entries)
                                    (+ (vector-ref current 10) child-nodes)
                                    (if (> candidate-height current-height)
                                        candidate-height current-height)
                                    (if (> candidate-entry-depth
                                           current-entry-depth)
                                        candidate-entry-depth
                                        current-entry-depth))
                            updates)))))))))))

(define (apply-child-topology-updates! updates)
  (let loop ((remaining updates))
    (if (null? remaining)
        #t
        (let ((update (car remaining)))
          (vector-set! (vector-ref update 0) 9 (vector-ref update 1))
          (vector-set! (vector-ref update 0) 10 (vector-ref update 2))
          (vector-set! (vector-ref update 0) 11 (vector-ref update 3))
          (vector-set! (vector-ref update 0) 12 (vector-ref update 4))
          (loop (cdr remaining))))))

(define (prepend-child-modules children pending)
  (let loop ((remaining children) (result pending))
    (if (null? remaining)
        result
        (loop (cdr remaining)
              (cons (vector-ref (car remaining) 2) result)))))

(define (finalization-plan operation module)
  (let ((root (module-root module)))
    (let loop ((pending (list root)) (result '()) (count 0))
      (if (null? pending)
          (if (= count (vector-ref root 10))
              (list-reverse result)
              (fail 'internal operation
                    "module topology node count invariant failed" '()))
          (if (>= count max-topology-nodes)
              (fail 'internal operation
                    "module topology exceeds finalization bound" '())
              (let ((current (car pending)))
                (loop
                  (prepend-child-modules (vector-ref current 4)
                                         (cdr pending))
                  (cons current result) (+ count 1))))))))

(define (finalize-modules! modules)
  (let loop ((remaining modules))
    (if (null? remaining)
        #t
        (begin
          (vector-set! (car remaining) 7 #t)
          (loop (cdr remaining))))))

(define (prepare-parameter-registration module name tensor)
  (require-module 'module-register-parameter-internal! module)
  (require-mutable-module 'module-register-parameter-internal! module)
  (require-valid-name 'module-register-parameter-internal!
                      "parameter name must be 1..65536 encoded UTF-8 bytes" name)
  (let ((provider (require-module-provider
                    'module-register-parameter-internal! module)))
    (if (local-name-used? module name)
            (fail 'invalid-argument 'module-register-parameter-internal!
                  "duplicate local module name" name)
            (let ((topology-updates
                    (preflight-leaf-registration
                      'module-register-parameter-internal! module)))
              (let ((ownership (vector '())))
                (guard (caught
                         (#t
                           (release-owned-list!
                             'module-register-parameter-internal! provider
                             ownership)
                           (raise caught)))
                  (let* ((metadata
                           (tensor-metadata
                             'module-register-parameter-internal!
                             provider tensor 'parameter))
                         ;; Module bindings borrow provider-owned live tensors.
                         ;; Only state dictionaries and internal scratch own
                         ;; provider clones because modules have no release API.
                         (prepared tensor)
                         (stored-name (string-copy name))
                         (handle (vector parameter-handle-tag module #f
                                         (copy-data (vector-ref metadata 0))
                                         (vector-ref metadata 1)
                                         (vector-ref metadata 2) prepared provider))
                         (next-bindings
                           (cons (vector 'parameter-binding stored-name handle)
                                 (vector-ref module 2))))
                  (ensure-storage-not-in-module!
                    'module-register-parameter-internal! provider prepared
                    'parameter (module-root module))
                  (let ((device-plan
                          (preflight-module-device
                            'module-register-parameter-internal! provider module
                            (vector-ref metadata 2))))
                    (vector module handle next-bindings topology-updates
                            device-plan ownership)))))))))

(define (commit-parameter-registration! plan)
  (commit-module-device! (vector-ref plan 4))
  (vector-set! (vector-ref plan 0) 2 (vector-ref plan 2))
  (apply-leaf-topology-updates! (vector-ref plan 3))
  ;; Ownership transfers to the installed live module binding.
  (vector-set! (vector-ref plan 5) 0 '())
  (vector-ref plan 1))

(define (module-register-parameter-internal! module name tensor)
  (commit-parameter-registration!
    (prepare-parameter-registration module name tensor)))

(define (module-register-tied-parameter-internal! module name handle)
  (require-module 'module-register-tied-parameter-internal! module)
  (require-handle 'module-register-tied-parameter-internal! handle)
  (require-mutable-module 'module-register-tied-parameter-internal! module)
  (require-valid-name 'module-register-tied-parameter-internal!
                      "parameter name must be 1..65536 encoded UTF-8 bytes" name)
  (let ((provider (require-module-provider
                    'module-register-tied-parameter-internal! module)))
    (if (local-name-used? module name)
            (fail 'invalid-argument 'module-register-tied-parameter-internal!
                  "duplicate local module name" name)
            (if (not (eq? (module-root module) (module-root (vector-ref handle 1))))
                (fail 'invalid-argument 'module-register-tied-parameter-internal!
                      "tied parameter must belong to the same module tree" name)
                (if (not (eq? provider (vector-ref handle 7)))
                    (fail 'unsupported 'module-register-tied-parameter-internal!
                          "parameter and module tensor providers differ" '())
                    (let* ((topology-updates
                             (preflight-leaf-registration
                               'module-register-tied-parameter-internal! module))
                           (next-bindings
                             (cons (vector 'parameter-binding
                                           (string-copy name) handle)
                                   (vector-ref module 2))))
                      (claim-module-device! 'module-register-tied-parameter-internal!
                                            provider module (vector-ref handle 5))
                      (vector-set! module 2 next-bindings)
                      (apply-leaf-topology-updates! topology-updates)
                      handle))))))

(define (module-register-buffer-internal! module name tensor)
  (require-module 'module-register-buffer-internal! module)
  (require-mutable-module 'module-register-buffer-internal! module)
  (require-valid-name 'module-register-buffer-internal!
                      "buffer name must be 1..65536 encoded UTF-8 bytes" name)
  (let ((provider (require-module-provider
                    'module-register-buffer-internal! module)))
    (if (local-name-used? module name)
            (fail 'invalid-argument 'module-register-buffer-internal!
                  "duplicate local module name" name)
            (let ((topology-updates
                    (preflight-leaf-registration
                      'module-register-buffer-internal! module)))
              (let ((ownership (vector '())))
                (guard (caught
                         (#t
                           (release-owned-list!
                             'module-register-buffer-internal! provider
                             ownership)
                           (raise caught)))
                  (let* ((metadata
                           (tensor-metadata 'module-register-buffer-internal!
                                            provider tensor 'buffer))
                         ;; See parameter registration: a live module binding
                         ;; borrows its provider-owned carrier.
                         (prepared tensor)
                         (binding
                           (vector 'buffer-binding (string-copy name) prepared))
                         (next-bindings
                           (cons binding (vector-ref module 3))))
                  (ensure-storage-not-in-module!
                    'module-register-buffer-internal! provider prepared 'buffer
                    (module-root module))
                  (claim-module-device! 'module-register-buffer-internal!
                                        provider module (vector-ref metadata 2))
                  (vector-set! module 3 next-bindings)
                  (apply-leaf-topology-updates! topology-updates)
                  (vector-set! ownership 0 '())
                  binding)))))))

(define (module-register-child-internal! module name child)
  (require-module 'module-register-child-internal! module)
  (require-module 'module-register-child-internal! child)
  (require-mutable-module 'module-register-child-internal! module)
  (require-mutable-module 'module-register-child-internal! child)
  (require-valid-name 'module-register-child-internal!
                      "child name must be 1..65536 encoded UTF-8 bytes" name)
  (if (local-name-used? module name)
          (fail 'invalid-argument 'module-register-child-internal!
                "duplicate local module name" name)
          (if (not (eq? (vector-ref module 6) (vector-ref child 6)))
              (fail 'unsupported 'module-register-child-internal!
                    "parent and child tensor providers differ" '())
              (if (or (eq? module child) (eq? child (module-root module))
                  (vector-ref child 5))
              (fail 'invalid-argument 'module-register-child-internal!
                    "child already has a parent or would form a cycle" name)
              (let* ((topology-updates
                       (preflight-child-topology
                         'module-register-child-internal! module child))
                     (root (module-root module))
                     (parent-device (vector-ref root 8))
                     (child-device (vector-ref child 8))
                     (binding
                       (vector 'child-binding (string-copy name) child))
                     (next-children (cons binding (vector-ref module 4))))
                (if (and parent-device child-device
                         (not (tensor-device-equal?
                                'module-register-child-internal!
                                (vector-ref module 6) parent-device child-device)))
                    (fail 'device-mismatch 'module-register-child-internal!
                          "parent and child logical devices differ" '())
                    (begin
                      (ensure-module-storage-distinct-from-tree!
                        'module-register-child-internal! (vector-ref module 6)
                        child root)
                      (if (and (not parent-device) child-device)
                          (vector-set! root 8 child-device)
                          #t)
                      (vector-set! child 5 module)
                      (vector-set! module 4 next-children)
                      (apply-child-topology-updates! topology-updates)
                      child)))))))

(define (flatten-parameters module prefix)
  (list-append
    (let loop ((bindings (vector-ref module 2)) (result '()))
      (if (null? bindings)
          result
          (loop (cdr bindings)
                (cons (vector 'flat-parameter
                              (list-append prefix (list (vector-ref (car bindings) 1)))
                              (vector-ref (car bindings) 2))
                      result))))
    (let loop ((children (vector-ref module 4)) (result '()))
      (if (null? children)
          result
          (loop (cdr children)
                (list-append
                  (flatten-parameters
                    (vector-ref (car children) 2)
                    (list-append prefix (list (vector-ref (car children) 1))))
                  result))))))

(define (flatten-buffers module prefix)
  (list-append
    (let loop ((bindings (vector-ref module 3)) (result '()))
      (if (null? bindings)
          result
          (loop (cdr bindings)
                (cons (vector 'flat-buffer
                              (list-append prefix (list (vector-ref (car bindings) 1)))
                              (car bindings))
                      result))))
    (let loop ((children (vector-ref module 4)) (result '()))
      (if (null? children)
          result
          (loop (cdr children)
                (list-append
                  (flatten-buffers
                    (vector-ref (car children) 2)
                    (list-append prefix (list (vector-ref (car children) 1))))
                  result))))))

(define (paths-for-handle entries handle)
  (let loop ((remaining entries) (paths '()))
    (if (null? remaining)
        (list-reverse paths)
        (loop (cdr remaining)
              (if (eq? handle (vector-ref (car remaining) 2))
                  (cons (entry-path (car remaining)) paths)
                  paths)))))

(define (canonical-path-updates entries)
  (let loop ((remaining entries) (seen '()) (updates '()))
    (if (null? remaining)
        (list-reverse updates)
        (let ((handle (vector-ref (car remaining) 2)))
          (if (identity-member? handle seen)
              (loop (cdr remaining) seen updates)
              (let ((paths (paths-for-handle entries handle)))
                (loop (cdr remaining) (cons handle seen)
                      (cons (vector handle (copy-data (car paths)))
                            updates))))))))

(define (install-canonical-paths! updates)
  (let loop ((remaining updates))
    (if (null? remaining)
        #t
        (begin
          (vector-set! (vector-ref (car remaining) 0) 2
                       (vector-ref (car remaining) 1))
          (loop (cdr remaining))))))

(define (tie-groups-from-entries entries)
  (let loop ((remaining entries) (seen '()) (groups '()))
    (if (null? remaining)
        (list-reverse groups)
        (let ((handle (vector-ref (car remaining) 2)))
          (if (identity-member? handle seen)
              (loop (cdr remaining) seen groups)
              (let ((paths (paths-for-handle entries handle)))
                (loop (cdr remaining) (cons handle seen)
                      (if (> (list-length paths) 1)
                          (cons paths groups) groups))))))))

(define (validate-generated-entry-paths! operation entries)
  (let ((count (bounded-list-length entries max-state-entries)))
    (if (not count)
        (fail 'internal operation
              "generated module entries exceed state schema bound" '())
        (let loop ((remaining entries))
          (if (null? remaining)
              count
              (if (valid-path? (entry-path (car remaining)))
                  (loop (cdr remaining))
                  (fail 'internal operation
                        "generated module path violates path contract" '())))))))

(define (commit-module-observation! observation)
  ;; Every allocation, validation, callback, shell registration, and traversal
  ;; must finish before this vector-set-only bounded tail begins.
  (install-canonical-paths! (vector-ref observation 1))
  (finalize-modules! (vector-ref observation 2))
  (vector-ref observation 0))

(define (prepare-module-parameters module)
  (require-root-module 'module-parameters module)
  (let* ((finalizers (finalization-plan 'module-parameters module))
         (entries (sort-entries (flatten-parameters module '())))
         (count (validate-generated-entry-paths! 'module-parameters entries))
         (groups (tie-groups-from-entries entries))
         (updates (canonical-path-updates entries))
         (tree (vector parameter-tree-tag entries groups)))
    (vector tree updates finalizers)))

(define (module-parameters module)
  (commit-module-observation! (prepare-module-parameters module)))

(define (parameter-tree-paths tree)
  (require-tree 'parameter-tree-paths tree)
  (let loop ((entries (vector-ref tree 1)) (paths '()))
    (if (null? entries) (list-reverse paths)
        (loop (cdr entries) (cons (copy-data (entry-path (car entries))) paths)))))

(define (parameter-tree-handle tree path)
  (require-tree 'parameter-tree-handle tree)
  (if (not (valid-path? path))
      (fail 'invalid-argument 'parameter-tree-handle "invalid parameter path" '())
      (let loop ((entries (vector-ref tree 1)))
        (cond
          ((null? entries)
           (fail 'invalid-argument 'parameter-tree-handle "unknown parameter path" path))
          ((equal? path (entry-path (car entries))) (vector-ref (car entries) 2))
          (else (loop (cdr entries)))))))

(define (parameter-tree-tie-groups tree)
  (copy-data (vector-ref (require-tree 'parameter-tree-tie-groups tree) 2)))

(define (parameter-handle-path handle)
  (require-handle 'parameter-handle-path handle)
  (if (vector-ref handle 2) (copy-data (vector-ref handle 2))
      (fail 'invalid-state 'parameter-handle-path
            "handle has not been enumerated in its module tree" '())))

(define (parameter-handle-shape handle)
  (copy-data (vector-ref (require-handle 'parameter-handle-shape handle) 3)))

(define (parameter-handle-dtype handle)
  (vector-ref (require-handle 'parameter-handle-dtype handle) 4))

(define (parameter-handle-device handle)
  (copy-data (vector-ref (require-handle 'parameter-handle-device handle) 5)))

(define (parameter-handle-tensor-internal handle)
  (let ((value (require-handle 'parameter-handle-tensor-internal handle)))
    ;; Trusted synchronous consumers borrow the live module carrier. This seam
    ;; never manufactures an owner that lacks a release path.
    (vector-ref value 6)))

(define (parameter-handle-tensor-identity-internal handle)
  (vector-ref (require-handle 'parameter-handle-tensor-identity-internal handle) 6))

(define (state-entry-internal path kind shape dtype device layout tensor)
  (vector state-entry-tag
          (copy-data-for 'state-entry-internal 'invalid-argument path)
          kind
          (copy-data-for 'state-entry-internal 'invalid-argument shape)
          dtype
          (copy-data-for 'state-entry-internal 'invalid-argument device)
          layout tensor))

(define (state-entry-path-internal entry) (copy-data (vector-ref entry 1)))
(define (state-entry-kind-internal entry) (vector-ref entry 2))
(define (state-entry-shape-internal entry) (copy-data (vector-ref entry 3)))
(define (state-entry-dtype-internal entry) (vector-ref entry 4))
(define (state-entry-device-internal entry) (copy-data (vector-ref entry 5)))
(define (state-entry-layout-internal entry) (vector-ref entry 6))
(define (copy-state-entry-records entries)
  (let loop ((remaining entries) (result '()))
    (if (null? remaining)
        (list-reverse result)
        (let ((entry (car remaining)))
          (loop
            (cdr remaining)
            (cons
              (vector state-entry-tag
                      (copy-data (vector-ref entry 1))
                      (vector-ref entry 2)
                      (copy-data (vector-ref entry 3))
                      (vector-ref entry 4)
                      (copy-data (vector-ref entry 5))
                      (vector-ref entry 6)
                      (vector-ref entry 7))
              result))))))

(define (state-dict-create-unsafe-internal format major minor features adapter entry-input aliases)
  ;; Malformed-state tests deliberately create an unbound logical value. Loading
  ;; validates it with the destination provider; standalone accessors require a
  ;; trusted provider binding created by module-state-dict/module-buffers.
  (if (not (and (vector? entry-input) (= (vector-length entry-input) 3)
                (eq? (vector-ref entry-input 0) unsafe-entry-input-tag)))
      (fail 'internal 'state-dict-create-unsafe-internal
            "unsafe entry provenance packet is malformed" '())
      (vector state-dict-tag format major minor
              (copy-data-for 'state-dict-create-unsafe-internal
                             'invalid-argument features)
              (copy-data-for 'state-dict-create-unsafe-internal
                             'invalid-argument adapter)
              (copy-state-entry-records (vector-ref entry-input 1))
              (copy-data-for 'state-dict-create-unsafe-internal
                             'invalid-argument aliases)
              (vector state-lifecycle-tag 'live #f #f '()
                      (vector '() (vector-ref entry-input 2)) #f))))

(define (state-dict-format-internal state)
  (vector-ref (require-live-state 'state-dict-format-internal state) 1))

(define (state-dict-version-internal state)
  (let ((value (require-live-state 'state-dict-version-internal state)))
    (list (vector-ref value 2) (vector-ref value 3))))

(define (state-dict-features-internal state)
  (copy-data
    (vector-ref (require-live-state 'state-dict-features-internal state) 4)))

(define (state-dict-adapter-internal state)
  (copy-data
    (vector-ref (require-live-state 'state-dict-adapter-internal state) 5)))

(define (state-dict-entries-internal state)
  (vector-ref (require-live-state 'state-dict-entries-internal state) 6))

(define (flat-tensor-carrier flat kind)
  (let ((target (vector-ref flat 2)))
    (if (eq? kind 'parameter)
        (vector-ref target 6)
        (vector-ref target 2))))

(define (state-borrowed-carriers parameters buffers)
  (let collect ((remaining parameters) (kind 'parameter) (result '()))
    (if (null? remaining)
        (if (eq? kind 'parameter)
            (collect buffers 'buffer result)
            result)
        (let ((carrier (flat-tensor-carrier (car remaining) kind)))
          (collect (cdr remaining) kind
                   (if (borrowed-carrier-identity-member? carrier result)
                       result
                       (cons (vector carrier kind) result)))))))

(define (state-entry-from-flat
          flat kind operation provider ownership borrowed-carriers)
  (let* ((path (entry-path flat))
         (tensor (flat-tensor-carrier flat kind))
         (metadata (tensor-metadata operation provider tensor kind))
         (copy
           (tensor-copy operation provider tensor kind ownership
                        borrowed-carriers)))
    (state-entry-internal
      path kind (vector-ref metadata 0) (vector-ref metadata 1)
      (vector-ref metadata 2) (vector-ref metadata 3)
      copy)))

(define (state-entry-contract-from-flat flat kind operation provider)
  (let* ((path (entry-path flat))
         (target (vector-ref flat 2))
         (tensor (if (eq? kind 'parameter)
                     (vector-ref target 6)
                     (vector-ref target 2)))
         (metadata (tensor-metadata operation provider tensor kind)))
    (vector state-entry-tag path kind (vector-ref metadata 0)
            (vector-ref metadata 1) (vector-ref metadata 2)
            (vector-ref metadata 3) tensor)))

(define (state-contract-from-flat parameters buffers operation provider)
  (sort-entries
    (list-append
      (let loop ((items parameters) (result '()))
        (if (null? items)
            result
            (loop (cdr items)
                  (cons (state-entry-contract-from-flat
                          (car items) 'parameter operation provider)
                        result))))
      (let loop ((items buffers) (result '()))
        (if (null? items)
            result
            (loop (cdr items)
                  (cons (state-entry-contract-from-flat
                          (car items) 'buffer operation provider)
                        result)))))))

(define (ensure-entry-storage-unique! operation provider entries category)
  (let outer ((remaining entries))
    (if (null? remaining)
        #t
        (let ((entry (car remaining)))
          (let inner ((others (cdr remaining)))
            (if (null? others)
                (outer (cdr remaining))
                (if (tensor-storage-identical?
                      operation provider (vector-ref entry 7)
                      (vector-ref (car others) 7) (vector-ref entry 2)
                      (vector-ref (car others) 2))
                    (fail category operation
                          "state entries alias tensor storage" '())
                    (inner (cdr others)))))))))

(define (state-from-flat parameters buffers aliases operation provider)
  (let ((ownership (vector '()))
        (borrowed-carriers (state-borrowed-carriers parameters buffers))
        (state #f)
        (state-shell #f)
        (entries '())
        (cleanup-failed? #f)
        (cleanup-error #f)
        (outcome (vector #f #f)))
    (guard (caught
             (#t
               (vector-set! outcome 0 #f)
               (vector-set! outcome 1 caught)
               outcome))
      (set! entries
            (sort-entries
             (list-append
              (let loop ((items parameters) (result '()))
                (if (null? items) result
                    (loop (cdr items)
                          (cons (state-entry-from-flat
                                  (car items) 'parameter operation provider
                                  ownership borrowed-carriers)
                                result))))
              (let loop ((items buffers) (result '()))
                (if (null? items) result
                    (loop (cdr items)
                          (cons (state-entry-from-flat
                                  (car items) 'buffer operation provider
                                  ownership borrowed-carriers)
                                result)))))))
      (ensure-entry-storage-unique! operation provider entries 'internal)
      (set! state
            (vector state-dict-tag state-format state-major state-minor '()
                    (tensor-provider-identity provider) entries
                    (copy-data aliases)
                    (vector state-lifecycle-tag 'live #t provider '()
                            ownership #f)))
      ;; Capture publication so rollback can revoke a shell even when native
      ;; bind fails after shell creation.
      (set! state-shell (shell-for-raw 'state state))
      (vector-set! outcome 0 #t)
      (vector-set! outcome 1
                   (state-provider-bind! operation state provider)))
    (if (vector-ref outcome 0)
        (vector-ref outcome 1)
        (begin
          (if state
              (begin
                (vector-set! (state-lifecycle state) 1 'released)
                (vector-set! (state-lifecycle state) 3 #f)
                (vector-set! (state-lifecycle state) 4 '())
                (let clear ((remaining entries))
                  (if (null? remaining)
                      #t
                      (begin
                        (vector-set! (car remaining) 7 #f)
                        (clear (cdr remaining)))))
                #t)
              #t)
          (if state-shell
              (guard (revoke-error
                       (#t
                         (set! cleanup-failed? #t)
                         (set! cleanup-error revoke-error)
                         #f))
                (native-check operation
                  (p1-native-state-revoke native-context state-shell)))
              #t)
          (guard (release-error
                   (#t
                     (if cleanup-failed?
                         #t
                         (begin
                           (set! cleanup-failed? #t)
                           (set! cleanup-error release-error)))
                     #f))
            (release-owned-list! operation provider ownership))
          ;; Publication rollback severs every registry edge even when native
          ;; revoke or provider release reports a defect.
          (if state-shell
              (compact-released-state-shells! state)
              #t)
          (if cleanup-failed?
              (raise cleanup-error)
              (raise (vector-ref outcome 1)))))))

(define (prepare-module-state-dict module)
  (require-root-module 'module-state-dict module)
  (let* ((provider (require-module-provider 'module-state-dict module))
         (finalizers (finalization-plan 'module-state-dict module))
         (parameters (sort-entries (flatten-parameters module '())))
         (buffers (sort-entries (flatten-buffers module '())))
         (parameter-count
           (validate-generated-entry-paths! 'module-state-dict parameters))
         (buffer-count
           (validate-generated-entry-paths! 'module-state-dict buffers))
         (entry-count (+ parameter-count buffer-count))
         (groups (tie-groups-from-entries parameters))
         (updates (canonical-path-updates parameters)))
    (if (not (= entry-count (vector-ref module 9)))
        (fail 'internal 'module-state-dict
              "module state entry count invariant failed" '())
        (let ((state
                (state-from-flat parameters buffers groups 'module-state-dict
                                 provider)))
          (vector state updates finalizers)))))

(define (module-state-dict module)
  (commit-module-observation! (prepare-module-state-dict module)))

(define (prepare-module-buffers module)
  (require-root-module 'module-buffers module)
  (let* ((provider (require-module-provider 'module-buffers module))
         (finalizers (finalization-plan 'module-buffers module))
         (buffers (sort-entries (flatten-buffers module '())))
         (count (validate-generated-entry-paths! 'module-buffers buffers))
         (state (state-from-flat '() buffers '() 'module-buffers provider)))
    (vector state '() finalizers)))

(define (module-buffers module)
  (commit-module-observation! (prepare-module-buffers module)))

(define (valid-feature-list? features)
  (and (bounded-list-length features max-feature-count)
       (let loop ((items features) (previous #f))
         (if (null? items)
             #t
             (and (symbol? (car items))
                  (or (not previous)
                      (segment<? (symbol->string previous)
                                 (symbol->string (car items))))
                  (loop (cdr items) (car items)))))))

(define (validate-state-entry operation provider entry previous-path seen)
  (if (not (state-entry-value? entry))
      (fail 'corrupt-data operation "malformed state entry" '())
      (let ((path (vector-ref entry 1))
            (kind (vector-ref entry 2))
            (shape (vector-ref entry 3))
            (dtype (vector-ref entry 4))
            (device (vector-ref entry 5))
            (layout (vector-ref entry 6))
            (tensor (vector-ref entry 7)))
        (if (not (valid-path? path))
            (fail 'corrupt-data operation "malformed state path" path)
            (if (path-member? path seen)
                (fail 'corrupt-data operation "duplicate state path" path)
                (if (and previous-path (not (path<? previous-path path)))
                    (fail 'corrupt-data operation "state entries are not canonical" path)
                    (if (not (or (eq? kind 'parameter) (eq? kind 'buffer)))
                        (fail 'corrupt-data operation "invalid state entry kind" kind)
                        (if (not (valid-shape? shape))
                            (fail 'corrupt-data operation "malformed entry shape" shape)
                            (if (not (symbol? dtype))
                                (fail 'corrupt-data operation "malformed entry dtype" '())
                                (if (not (valid-device-descriptor? device))
                                    (fail 'corrupt-data operation "malformed entry device" '())
                                    (if (not (symbol? layout))
                                        (fail 'corrupt-data operation
                                              "malformed entry layout" '())
                                        (let ((metadata
                                                (tensor-metadata operation provider
                                                                 tensor kind)))
                                          (if (not (equal? shape
                                                           (vector-ref metadata 0)))
                                              (fail 'shape-mismatch operation
                                                    "entry shape disagrees with tensor" path)
                                              (if (not (eq? dtype
                                                            (vector-ref metadata 1)))
                                                  (fail 'dtype-mismatch operation
                                                        "entry dtype disagrees with tensor" path)
                                                  (if (not (tensor-device-equal?
                                                             operation provider device
                                                             (vector-ref metadata 2)))
                                                      (fail 'device-mismatch operation
                                                            "entry device disagrees with tensor"
                                                            path)
                                                      (if (not (eq? layout
                                                                    (vector-ref metadata 3)))
                                                          (fail 'noncontiguous operation
                                                                "entry layout disagrees with tensor"
                                                                path)
                                                          #t))))))))))))))))

(define (validate-state-entries operation provider entries)
  (if (not (bounded-list-length entries max-state-entries))
      (fail 'corrupt-data operation "state entries must be a list" '())
      (let loop ((items entries) (previous #f) (seen '()))
        (if (null? items)
            (ensure-entry-storage-unique! operation provider entries
                                          'corrupt-data)
            (begin
              (validate-state-entry operation provider (car items) previous seen)
              (loop (cdr items) (entry-path (car items))
                    (cons (entry-path (car items)) seen)))))))

(define (state-entry-for-path entries path)
  (let loop ((items entries))
    (cond
      ((null? items) #f)
      ((equal? path (entry-path (car items))) (car items))
      (else (loop (cdr items))))))

(define (validate-alias-groups operation provider groups entries)
  (if (not (bounded-list-length groups max-alias-groups))
      (fail 'corrupt-data operation "alias groups must be a list" '())
      (let loop ((remaining groups) (previous-first #f) (seen '())
                 (total-members 0))
        (if (null? remaining)
            #t
            (let* ((group (car remaining))
                   (group-members
                     (bounded-list-length group max-alias-members)))
              (if (or (not group-members)
                      (< group-members 2)
                      (> (+ total-members group-members) max-state-entries)
                      (not (let valid-paths ((paths group))
                             (if (null? paths) #t
                                 (and (valid-path? (car paths))
                                      (valid-paths (cdr paths))))))
                      (not (equal? group (sort-paths group))))
                  (fail 'corrupt-data operation "malformed alias group" group)
                  (if (and previous-first
                           (not (path<? previous-first (car group))))
                      (fail 'corrupt-data operation "alias groups are not canonical" group)
                      (let validate-paths ((paths group) (next-seen seen)
                                           (first-tensor #f))
                        (if (null? paths)
                            (loop (cdr remaining) (car group) next-seen
                                  (+ total-members group-members))
                            (let ((entry (state-entry-for-path entries (car paths))))
                              (if (path-member? (car paths) next-seen)
                                  (fail 'corrupt-data operation
                                        "path appears in multiple alias groups" (car paths))
                                  (if (or (not entry)
                                          (not (eq? (vector-ref entry 2) 'parameter)))
                                      (fail 'corrupt-data operation
                                            "alias path is not a parameter" (car paths))
                                      (if (and first-tensor
                                               (not (tensor-value-equal?
                                                      operation provider first-tensor
                                                      (vector-ref entry 7) 'parameter)))
                                          (fail 'corrupt-data operation
                                                "conflicting tied parameter payloads"
                                                group)
                                          (validate-paths
                                            (cdr paths) (cons (car paths) next-seen)
                                            (if first-tensor first-tensor
                                                (vector-ref entry 7))))))))))))))))

(define (validate-state-envelope operation state)
  (require-live-state operation state)
  (if (not (symbol? (vector-ref state 1)))
      (fail 'corrupt-data operation "malformed state dictionary format" '())
      (if (not (eq? (vector-ref state 1) state-format))
          (fail 'version-mismatch operation "unsupported state dictionary format" '())
      (if (or (not (integer? (vector-ref state 2)))
              (not (integer? (vector-ref state 3)))
              (not (exact? (vector-ref state 2)))
              (not (exact? (vector-ref state 3)))
              (< (vector-ref state 2) 0)
              (< (vector-ref state 3) 0))
          (fail 'corrupt-data operation "malformed state dictionary version"
                (list (vector-ref state 2) (vector-ref state 3)))
          (if (or (not (= (vector-ref state 2) state-major))
                  (not (= (vector-ref state 3) state-minor)))
              (fail 'version-mismatch operation "unsupported state dictionary version"
                    (list (vector-ref state 2) (vector-ref state 3)))
              (if (not (valid-feature-list? (vector-ref state 4)))
                  (fail 'corrupt-data operation "malformed required-feature list" '())
                  (if (not (null? (vector-ref state 4)))
                      (fail 'version-mismatch operation "unsupported required feature"
                            (vector-ref state 4))
                      (validate-provider-identity operation
                                                  (vector-ref state 5)))))))))

(define (validate-state-with-provider operation state provider)
  (let ((identity (validate-state-envelope operation state)))
    (if (not (equal? identity (tensor-provider-identity provider)))
        (fail 'unsupported operation
              "state and destination tensor providers differ" '())
        (begin
          (validate-state-entries operation provider (vector-ref state 6))
          (validate-alias-groups operation provider (vector-ref state 7)
                                 (vector-ref state 6))
          provider))))

(define (validate-bound-state operation state)
  (require-state operation state)
  (let ((provider (require-provider operation
                                    (state-provider-binding-find state))))
    (validate-state-with-provider operation state provider)))

(define (unsafe-entry-copy-matches-source? copied source)
  (and (state-entry-value? copied) (state-entry-value? source)
       (equal? (vector-ref copied 1) (vector-ref source 1))
       (eq? (vector-ref copied 2) (vector-ref source 2))
       (equal? (vector-ref copied 3) (vector-ref source 3))
       (eq? (vector-ref copied 4) (vector-ref source 4))
       (equal? (vector-ref copied 5) (vector-ref source 5))
       (eq? (vector-ref copied 6) (vector-ref source 6))
       (eq? (vector-ref copied 7) (vector-ref source 7))))

(define (resolve-unsafe-entry-provenance operation state provenance)
  (if (not provenance)
      (fail 'unsupported operation
            "nonempty unsafe state entries lack live owner provenance" '())
      (let loop ((entries (vector-ref state 6)) (proofs provenance)
                 (owners '()))
        (cond
          ((and (null? entries) (null? proofs)) owners)
          ((or (null? entries) (null? proofs))
           (fail 'invalid-state operation
                 "unsafe state entry provenance differs" '()))
          (else
            (let ((proof (car proofs)))
              (if (not (and (vector? proof) (= (vector-length proof) 2)))
                  (fail 'invalid-state operation
                        "unsafe state entry provenance is malformed" '())
                  (let* ((source-entry
                           (raw-for-shell operation 'entry
                                          (vector-ref proof 0)))
                         (owner
                           (raw-for-shell operation 'state
                                          (vector-ref proof 1)))
                         (lifecycle (state-lifecycle owner)))
                    (if (not (and (eq? (vector-ref lifecycle 1) 'live)
                                  (vector-ref lifecycle 2)
                                  (identity-member-local?
                                    source-entry (vector-ref owner 6))
                                  (unsafe-entry-copy-matches-source?
                                    (car entries) source-entry)))
                        (fail 'invalid-state operation
                              "unsafe state entry owner provenance is stale"
                              '())
                        (loop
                          (cdr entries) (cdr proofs)
                          (if (identity-member-local? owner owners)
                              owners
                              (cons owner owners))))))))))))

(define (pin-state-owners! operation owners access)
  (let loop ((remaining owners))
    (if (null? remaining)
        #t
        (begin
          (state-use-begin! operation (car remaining) access)
          (loop (cdr remaining))))))

(define (unpin-state-owners! operation owners access)
  (let loop ((remaining owners))
    (if (null? remaining)
        #t
        (let* ((owner (car remaining))
               (lifecycle (state-lifecycle owner)))
          (if (eq? (vector-ref lifecycle 6) access)
              (state-use-end! operation owner access)
              #t)
          (loop (cdr remaining))))))

(define (clone-unsafe-state-entries
          operation entries provider ownership borrowed-carriers)
  (let ((outcome (vector #f #f)))
    (guard (caught
             (#t
               (vector-set! outcome 0 #f)
               (vector-set! outcome 1 caught)
               outcome))
      (let loop ((remaining entries) (result '()))
        (if (null? remaining)
            (begin
              (vector-set! outcome 0 #t)
              (vector-set! outcome 1 (list-reverse result))
              outcome)
            (let* ((entry (car remaining))
                   (copy-outcome
                     (tensor-copy-outcome
                       operation provider (vector-ref entry 7)
                       (vector-ref entry 2) ownership borrowed-carriers)))
              (if (not (vector-ref copy-outcome 0))
                  (begin
                    (vector-set! outcome 0 #f)
                    (vector-set! outcome 1 (vector-ref copy-outcome 1))
                    outcome)
                  (loop
                    (cdr remaining)
                    (cons
                      (state-entry-internal
                        (vector-ref entry 1) (vector-ref entry 2)
                        (vector-ref entry 3) (vector-ref entry 4)
                        (vector-ref entry 5) (vector-ref entry 6)
                        (vector-ref copy-outcome 1))
                      result)))))))
    outcome))

(define (validate-unsafe-state-clones-outcome
          operation state provider ownership borrowed-carriers)
  ;; Source owners remain pinned while this total phase performs every provider
  ;; callback and source-carrier dereference. No error crosses back into bind;
  ;; its caller can therefore unpin in ordinary control flow on every branch.
  (let ((outcome (vector #f #f)))
    (guard (caught
             (#t
               (vector-set! outcome 0 #f)
               (vector-set! outcome 1 caught)
               outcome))
      (validate-state-with-provider operation state provider)
      (let ((clone-outcome
              (clone-unsafe-state-entries
                operation (vector-ref state 6) provider ownership
                borrowed-carriers)))
        (if (not (vector-ref clone-outcome 0))
            (begin
              (vector-set! outcome 0 #f)
              (vector-set! outcome 1 (vector-ref clone-outcome 1))
              outcome)
            (let ((cloned-entries (vector-ref clone-outcome 1)))
              (ensure-entry-storage-unique!
                operation provider cloned-entries 'corrupt-data)
              (validate-alias-groups operation provider
                                     (vector-ref state 7) cloned-entries)
              (vector-set! outcome 0 #t)
              (vector-set! outcome 1 cloned-entries)
              outcome))))
    outcome))

(define (registered-entry-records-for-entries state entries)
  ;; This snapshot is allocated before native bind. After bind succeeds the
  ;; bounded tail only mutates these already-existing registry records, so a
  ;; shell published for a pre-clone entry cannot retain borrowed storage.
  (let scan ((records shell-registry) (result '()))
    (if (null? records)
        result
        (let ((record (car records)))
          (scan
            (cdr records)
            (if (and (eq? (vector-ref record 1) 'entry)
                     (= (vector-length record) 4)
                     (eq? (vector-ref record 3) state)
                     (identity-member-local?
                       (vector-ref record 2) entries))
                (cons record result)
                result))))))

(define (tombstone-entry-records! records)
  (let loop ((remaining records))
    (if (null? remaining)
        #t
        (begin
          (vector-set! (car remaining) 2 dead-state-entry-raw)
          (vector-set! (car remaining) 3 dead-state-raw)
          (loop (cdr remaining))))))

(define (state-bind-pretransfer-outcome operation state provider)
  ;; Registry snapshot allocation, shell resolution, and native bind are the
  ;; last fallible steps before ownership transfer. Return a total result so no
  ;; failure can bypass Eshkol ledger cleanup across a compiled guard handler.
  (let ((outcome (vector #f #f)))
    (guard (caught
             (#t
               (vector-set! outcome 0 #f)
               (vector-set! outcome 1 caught)
               outcome))
      (let ((pre-bind-entry-records
              (registered-entry-records-for-entries
                state (vector-ref state 6)))
            (state-shell (shell-for-raw 'state state))
            (provider-shell (shell-for-raw 'provider provider)))
        (native-check
          operation
          (p1-native-state-bind native-context state-shell provider-shell))
        (vector-set! outcome 0 #t)
        (vector-set! outcome 1 pre-bind-entry-records)))
    outcome))

(define (state-dict-bind-provider-internal! state provider-name)
  (let ((operation 'state-dict-bind-provider-internal!))
    (state-use-begin! operation state operation)
    ;; Keep every failure inside an outcome until the target access token has
    ;; been ended in ordinary control flow. Pinned strict AOT does not reliably
    ;; transfer a rethrow from a nested cleanup handler into an outer guard.
    (let ((provider #f)
          (ownership #f)
          (owners '())
          (access #f)
          (pinned? #f)
          (rollback? #f)
          (cloned-entries '())
          (cleanup-failed? #f)
          (cleanup-error #f)
          (outcome (vector #f #f)))
      (guard (caught
               (#t
                 (if pinned?
                     (unpin-state-owners! operation owners access)
                     #t)
                 (set! pinned? #f)
                 (let clear ((remaining cloned-entries))
                   (if (null? remaining)
                       #t
                       (begin
                         (vector-set! (car remaining) 7 #f)
                         (clear (cdr remaining)))))
                 (if rollback?
                     (guard (release-error
                              (#t
                                (set! cleanup-failed? #t)
                                (set! cleanup-error release-error)
                                #f))
                       (release-owned-list!
                         operation provider ownership))
                     #t)
                 (vector-set! outcome 0 #f)
                 (vector-set! outcome 1
                              (if cleanup-failed? cleanup-error caught))
                 outcome))
        ;; The caller selects a trusted registered provider explicitly. The
        ;; inert identity is only compared; it never drives callback lookup.
        (validate-state-envelope operation state)
        (set! provider (require-provider-name operation provider-name))
        (let ((bound (state-provider-binding-find state)))
          (if bound
              (begin
                (validate-state-with-provider operation state provider)
                (vector-set! outcome 0 #t)
                (vector-set!
                  outcome 1
                  (state-provider-bind! operation state provider)))
              (let* ((lifecycle (state-lifecycle state))
                     (provenance
                       (begin
                         (set! ownership (vector-ref lifecycle 5))
                         (set! rollback? #t)
                         (if (> (vector-length ownership) 1)
                             (vector-ref ownership 1)
                             #f)))
                     (borrowed-carriers
                       (let collect ((remaining (vector-ref state 6))
                                     (result '()))
                         (if (null? remaining)
                             result
                             (let ((carrier (vector-ref (car remaining) 7)))
                               (collect
                                 (cdr remaining)
                                 (if (borrowed-carrier-identity-member?
                                       carrier result)
                                     result
                                     (cons
                                       (vector carrier
                                               (vector-ref (car remaining) 2))
                                       result))))))))
                (set! owners
                      (resolve-unsafe-entry-provenance
                        operation state provenance))
                (set! access
                      (vector state-borrow-access-tag 'unsafe-bind state))
                (set! pinned? #t)
                (pin-state-owners! operation owners access)
                (let ((validation-outcome
                        (validate-unsafe-state-clones-outcome
                          operation state provider ownership
                          borrowed-carriers)))
                  (unpin-state-owners! operation owners access)
                  (set! pinned? #f)
                  (if (not (vector-ref validation-outcome 0))
                      (begin
                        ;; The total pinned phase reports failure without
                        ;; crossing a guard. Drain every published prefix in
                        ;; this ordinary path, then let the common tail end the
                        ;; target access token exactly once.
                        (guard (release-error
                                 (#t
                                   (set! cleanup-failed? #t)
                                   (set! cleanup-error release-error)
                                   #f))
                          (release-owned-list!
                            operation provider ownership))
                        (set! rollback? #f)
                        (vector-set! outcome 0 #f)
                        (vector-set!
                          outcome 1
                          (if cleanup-failed?
                              cleanup-error
                              (vector-ref validation-outcome 1))))
                      (begin
                        (set! cloned-entries
                              (vector-ref validation-outcome 1))
                        ;; Take this registry snapshot after the final provider
                        ;; callback: a defective callback may have published
                        ;; another shell for an old target entry while the bind
                        ;; was open.
                        (let ((bind-outcome
                                (state-bind-pretransfer-outcome
                                  operation state provider)))
                            (if (not (vector-ref bind-outcome 0))
                                (begin
                                  (let clear ((remaining cloned-entries))
                                    (if (null? remaining)
                                        #t
                                        (begin
                                          (vector-set! (car remaining) 7 #f)
                                          (clear (cdr remaining)))))
                                  (guard (release-error
                                           (#t
                                             (set! cleanup-failed? #t)
                                             (set! cleanup-error release-error)
                                             #f))
                                    (release-owned-list!
                                      operation provider ownership))
                                  (set! rollback? #f)
                                  (vector-set! outcome 0 #f)
                                  (vector-set!
                                    outcome 1
                                    (if cleanup-failed?
                                        cleanup-error
                                        (vector-ref bind-outcome 1))))
                                (begin
                                  ;; Native binding succeeded. Every remaining
                                  ;; action is a bounded nonraising transfer.
                                  (tombstone-entry-records!
                                    (vector-ref bind-outcome 1))
                                  (vector-set! state 6 cloned-entries)
                                  (vector-set! lifecycle 2 #t)
                                  (vector-set! lifecycle 3 provider)
                                  (vector-set! ownership 1 '())
                                  (set! rollback? #f)
                                  (vector-set! outcome 0 #t)
                                  (vector-set! outcome 1 state)))))))))))
      (state-use-end! operation state operation)
      (if (vector-ref outcome 0)
          (vector-ref outcome 1)
          (raise (vector-ref outcome 1))))))

(define (state-dict-paths state)
  (let ((operation 'state-dict-paths))
    (state-use-begin! operation state operation)
    (guard (caught
             (#t
               (state-use-end! operation state operation)
               (raise caught)))
      (validate-bound-state operation state)
      (let ((result
              (let loop ((entries (vector-ref state 6)) (paths '()))
                (if (null? entries) (list-reverse paths)
                    (loop (cdr entries)
                          (cons (copy-data (entry-path (car entries)))
                                paths))))))
        (state-use-end! operation state operation)
        result))))

(define (state-tensor-for-entry state entry)
  (let* ((lifecycle (state-lifecycle state))
         (cache (vector-ref lifecycle 4)))
    (let find ((remaining cache))
      (cond
        ((null? remaining)
         (let ((handle (vector state-tensor-tag state entry)))
           (vector-set! lifecycle 4 (cons (vector entry handle) cache))
           handle))
        ((eq? entry (vector-ref (car remaining) 0))
         (vector-ref (car remaining) 1))
        (else (find (cdr remaining)))))))

(define (state-entry-identical-member? entry entries)
  (cond
    ((null? entries) #f)
    ((eq? entry (car entries)) #t)
    (else (state-entry-identical-member? entry (cdr entries)))))

(define (state-tensor-cached? lifecycle entry tensor)
  (let find ((remaining (vector-ref lifecycle 4)))
    (cond
      ((null? remaining) #f)
      ((and (eq? entry (vector-ref (car remaining) 0))
            (eq? tensor (vector-ref (car remaining) 1))) #t)
      (else (find (cdr remaining))))))

(define (state-dict-tensor state path)
  (if (not (valid-path? path))
      (fail 'invalid-argument 'state-dict-tensor "invalid state path" '())
      (let ((operation 'state-dict-tensor))
        (state-use-begin! operation state operation)
        (guard (caught
                 (#t
                   (state-use-end! operation state operation)
                   (raise caught)))
          (validate-bound-state operation state)
          (let ((entry (state-entry-for-path (vector-ref state 6) path)))
            (if entry
                (let ((result (state-tensor-for-entry state entry)))
                  (state-use-end! operation state operation)
                  result)
                (fail 'invalid-argument operation
                      "unknown state path" path)))))))

(define (state-dict-tensor-borrow-begin-internal state tensor)
  (let* ((operation 'state-dict-tensor-borrow-begin-internal)
         (live-state (require-live-state operation state))
         (access (vector state-borrow-access-tag 'opening live-state tensor)))
    (if (or (not (state-tensor-value? tensor))
            (not (eq? live-state (vector-ref tensor 1)))
            (not (state-entry-value? (vector-ref tensor 2)))
            (not (state-entry-identical-member?
                   (vector-ref tensor 2) (vector-ref live-state 6)))
            (not (state-tensor-cached?
                   (state-lifecycle live-state) (vector-ref tensor 2) tensor)))
        (fail 'invalid-argument operation
              "state-backed tensor resolution chain is invalid" '())
        (begin
          ;; Pin this exact handle before provider validation can observe its
          ;; carrier. Public release rejects the non-#f active identity.
          (state-use-begin! operation live-state access)
          (guard (caught
                   (#t
                     (state-use-end! operation live-state access)
                     (raise caught)))
            (validate-bound-state operation live-state)
            (let ((carrier (vector-ref (vector-ref tensor 2) 7)))
              (if carrier
                  (begin
                    ;; This bounded write is the only transition that admits
                    ;; the matching borrow-end operation.
                    (vector-set! access 1 'borrowed)
                    carrier)
                  (fail 'invalid-state operation
                        "state-backed tensor is released" '()))))))))

(define (state-dict-tensor-borrow-end-internal state tensor)
  (let* ((operation 'state-dict-tensor-borrow-end-internal)
         (live-state (require-live-state operation state)))
    (if (or (not (state-tensor-value? tensor))
            (not (eq? live-state (vector-ref tensor 1)))
            (not (state-entry-value? (vector-ref tensor 2)))
            (not (state-entry-identical-member?
                   (vector-ref tensor 2) (vector-ref live-state 6)))
            (not (state-tensor-cached?
                   (state-lifecycle live-state) (vector-ref tensor 2) tensor)))
        (fail 'invalid-argument operation
              "state-backed tensor resolution chain is invalid" '())
        (let ((access (vector-ref (state-lifecycle live-state) 6)))
          (if (and (vector? access) (= (vector-length access) 4)
                   (eq? (vector-ref access 0) state-borrow-access-tag)
                   (eq? (vector-ref access 2) live-state)
                   (eq? (vector-ref access 3) tensor))
              (if (eq? (vector-ref access 1) 'borrowed)
                  (state-use-end! operation live-state access)
                  (fail 'invalid-state operation
                        "state-backed tensor borrow is still opening" '()))
              (fail 'invalid-argument operation
                    "state dictionary scoped access handle differs" '()))))))

(define (state-dict-alias-groups state)
  (let ((operation 'state-dict-alias-groups))
    (state-use-begin! operation state operation)
    (guard (caught
             (#t
               (state-use-end! operation state operation)
               (raise caught)))
      (validate-bound-state operation state)
      (let ((result (copy-data (vector-ref state 7))))
        (state-use-end! operation state operation)
        result))))

(define (state-dict-release-owned! state)
  (let* ((lifecycle (state-lifecycle state))
         (provider (vector-ref lifecycle 3))
         (ownership (vector-ref lifecycle 5))
         (release-failed? #f)
         (release-error #f))
    (if (vector-ref lifecycle 6)
        (fail 'invalid-state 'state-dict-release!
              "state dictionary has an active tensor borrow" '())
        #t)
    (vector-set! lifecycle 1 'released)
    (vector-set! lifecycle 4 '())
    (if (> (vector-length ownership) 1)
        (vector-set! ownership 1 '())
        #t)
    ;; Clear every state entry before invoking provider code. No later path may
    ;; inspect or compare an opaque carrier after its release callback begins.
    (let clear ((entries (vector-ref state 6)))
      (if (null? entries)
          #t
          (begin
            (vector-set! (car entries) 7 #f)
            (clear (cdr entries)))))
    (guard (caught
             (#t
               (set! release-failed? #t)
               (set! release-error caught)
               #f))
      (if (vector-ref lifecycle 2)
          (release-owned-list! 'state-dict-release! provider ownership)
          #t))
    (vector-set! lifecycle 3 #f)
    (if release-failed?
        (raise release-error)
        #t)))

(define (decoded-owned-record? record)
  (and (vector? record) (= (vector-length record) 7)
       (valid-path? (vector-ref record 0))
       (or (eq? (vector-ref record 1) 'parameter)
           (eq? (vector-ref record 1) 'buffer))
       (valid-shape? (vector-ref record 2))
       (symbol? (vector-ref record 3))
       (valid-device-descriptor? (vector-ref record 4))
       (symbol? (vector-ref record 5))
       (vector-ref record 6)))

(define (decoded-records-match-ownership? records owned)
  (cond
    ((and (null? records) (null? owned)) #t)
    ((or (null? records) (null? owned)) #f)
    (else
      (let ((record (car records)) (item (car owned)))
        (and (vector? item) (= (vector-length item) 4)
             (vector-ref item 0)
             (eq? (vector-ref record 6) (vector-ref item 0))
             (eq? (vector-ref record 1) (vector-ref item 1))
             (symbol? (vector-ref item 2))
             (eq? (vector-ref item 3) #f)
             (decoded-records-match-ownership? (cdr records)
                                               (cdr owned)))))))

(define (decoded-ownership-identities-unique? owned)
  (let outer ((remaining owned))
    (if (null? remaining)
        #t
        (let ((envelope (car remaining)))
          (let inner ((others (cdr remaining)))
            (cond
              ((null? others) (outer (cdr remaining)))
              ((or (eq? envelope (car others))
                   (eq? (vector-ref envelope 0)
                        (vector-ref (car others) 0))) #f)
              (else (inner (cdr others)))))))))

(define (neutralize-live-state-owned-envelopes!
          operation provider owned compare-storage?)
  ;; Sanitize the entire bounded ledger before any detailed validation can
  ;; fail. A malformed sibling must not leave a later live-state carrier armed
  ;; for caller cleanup, and every conflict must be neutralized.
  (if compare-storage?
      ;; Ownership ledgers are newest-first. Disarm the current (newer)
      ;; candidate, sanitize the older tail, then compare the current carrier
      ;; only against older actionable owners. Thus an alias always sacrifices
      ;; the newer publication and preserves the original owner.
      (let ((found #f) (have-error? #f) (first-error #f))
        (let scan-oldest-first ((remaining owned))
          (if (null? remaining)
              #t
              (let ((item (car remaining)))
                (if (and (vector? item) (= (vector-length item) 4)
                         (vector-ref item 0)
                         (or (eq? (vector-ref item 1) 'parameter)
                             (eq? (vector-ref item 1) 'buffer)))
                    (let ((carrier (vector-ref item 0))
                          (comparison-ok? #t)
                          (comparison-error #f)
                          (protected? #f))
                      ;; Capture and neutralize before the older tail can invoke
                      ;; any provider callback. Restore only after the older
                      ;; owners are settled and this carrier proves independent.
                      (vector-set! item 0 #f)
                      (scan-oldest-first (cdr remaining))
                      (guard (caught
                               (#t
                                 (set! comparison-ok? #f)
                                 (set! comparison-error caught)
                                 #f))
                        (tensor-metadata
                          operation provider carrier (vector-ref item 1))
                        (set! protected?
                              (or
                                (carrier-protected-from-release?
                                  operation provider carrier
                                  (vector-ref item 1) #t)
                                (owned-carrier-storage-member?
                                  operation provider carrier
                                  (vector-ref item 1) (cdr remaining) '()))))
                      (if comparison-ok?
                          (if protected?
                              (set! found #t)
                              (vector-set! item 0 carrier))
                          (begin
                            (if have-error?
                                #t
                                (set! first-error comparison-error))
                            (set! have-error? #t))))
                    (scan-oldest-first (cdr remaining))))))
        (if have-error? (raise first-error) found))
      ;; The first pass is exact-identity-only and callback-free; its order does
      ;; not affect ownership preference.
      (let scan-exact ((remaining owned) (found #f))
        (if (null? remaining)
            found
            (let ((item (car remaining)))
              (if (and (vector? item) (= (vector-length item) 4)
                       (vector-ref item 0)
                       (carrier-protected-from-release?
                         operation provider (vector-ref item 0)
                         (vector-ref item 1) #f))
                  (begin
                    (vector-set! item 0 #f)
                    (scan-exact (cdr remaining) #t))
                  (scan-exact (cdr remaining) found)))))))

(define (state-dict-adopt-owned-internal!
          records aliases provider-name major minor ownership)
  (let* ((operation 'state-dict-adopt-owned-internal!)
         (record-count (bounded-list-length records max-state-entries))
         (owned
           (if (and (vector? ownership) (= (vector-length ownership) 1))
               (vector-ref ownership 0)
               #f)))
    ;; Everything before clearing the caller ledger is non-consuming. C1 keeps
    ;; responsibility for its decoded prefix if this preflight fails.
    (if (or (not record-count)
            (not (bounded-list-length owned max-state-entries)))
        (fail 'invalid-argument operation
              "decoded ownership input must be bounded proper lists" '())
        #t)
    (if (neutralize-live-state-owned-envelopes!
          operation #f owned #f)
        (fail 'invalid-argument operation
              "decoded ownership republishes a live state carrier" '())
        #t)
    ;; Provider lookup is deliberately after the total ownership sanitizer:
    ;; even a version/name failure must not leave a live carrier armed for the
    ;; caller's rollback cleanup.
    (let ((provider
            (tensor-provider-preflight-internal provider-name major minor)))
      (if (neutralize-live-state-owned-envelopes!
            operation provider owned #t)
          (fail 'invalid-argument operation
                "decoded ownership aliases protected live storage" '())
          #t)
      (let validate-records ((remaining records))
        (if (null? remaining)
            #t
            (if (decoded-owned-record? (car remaining))
                (validate-records (cdr remaining))
                (fail 'invalid-argument operation
                      "decoded owned tensor record is malformed" '()))))
      (if (or (not (decoded-records-match-ownership? records owned))
              (not (decoded-ownership-identities-unique? owned)))
          (fail 'invalid-argument operation
                "decoded records and ownership ledger differ or duplicate identity"
                '())
          #t)
      (let* ((adopted-ownership (vector owned))
           (entries
             (let build ((remaining records) (result '()))
               (if (null? remaining)
                   (list-reverse result)
                   (let ((record (car remaining)))
                     (build
                       (cdr remaining)
                       (cons
                         (state-entry-internal
                           (vector-ref record 0) (vector-ref record 1)
                           (vector-ref record 2) (vector-ref record 3)
                           (vector-ref record 4) (vector-ref record 5)
                           (vector-ref record 6))
                         result))))))
           (state
             (vector state-dict-tag state-format state-major state-minor '()
                     (tensor-provider-identity provider) entries
                     (copy-data aliases)
                     (vector state-lifecycle-tag 'live #f #f '()
                             adopted-ownership #f)))
           (state-shell #f)
           (cleanup-failed? #f)
           (cleanup-error #f)
           (outcome (vector #f #f)))
      ;; Clearing the caller ledger is the transfer point. P1 owns every
      ;; carrier from here through live-state publication.
      (vector-set! ownership 0 '())
      (guard (caught
               (#t
                 (vector-set! outcome 0 #f)
                 (vector-set! outcome 1 caught)
                 outcome))
        (validate-state-with-provider operation state provider)
        (set! state-shell (shell-for-raw 'state state))
        (state-provider-bind! operation state provider)
        ;; No fallible operation follows transfer into the live state.
        (vector-set! (state-lifecycle state) 2 #t)
        (vector-set! outcome 0 #t)
        (vector-set! outcome 1 state))
      (if (vector-ref outcome 0)
          (vector-ref outcome 1)
          (begin
            (let clear ((remaining entries))
              (if (null? remaining)
                  #t
                  (begin
                    (vector-set! (car remaining) 7 #f)
                    (clear (cdr remaining)))))
            (vector-set! (state-lifecycle state) 1 'released)
            (if state-shell
                (guard (revoke-error
                         (#t
                           (set! cleanup-failed? #t)
                           (set! cleanup-error revoke-error)
                           #f))
                  (native-check operation
                    (p1-native-state-revoke native-context state-shell)))
                #t)
            (guard (release-error
                     (#t
                       (if cleanup-failed?
                           #t
                           (begin
                             (set! cleanup-failed? #t)
                             (set! cleanup-error release-error)))
                       #f))
              (release-owned-list!
                operation provider adopted-ownership))
            (if state-shell
                (compact-released-state-shells! state)
                #t)
            (if cleanup-failed?
                (raise cleanup-error)
                (raise (vector-ref outcome 1)))))))))

(define (same-entry-contract! operation provider expected actual)
  (let ((path (entry-path expected)))
    (if (not (eq? (vector-ref expected 2) (vector-ref actual 2)))
        (fail 'shape-mismatch operation "state entry kind mismatch" path)
        (if (not (equal? (vector-ref expected 3) (vector-ref actual 3)))
            (fail 'shape-mismatch operation "state tensor shape mismatch" path)
            (if (not (eq? (vector-ref expected 4) (vector-ref actual 4)))
                (fail 'dtype-mismatch operation "state tensor dtype mismatch" path)
                (if (not (tensor-device-equal? operation provider
                                               (vector-ref expected 5)
                                               (vector-ref actual 5)))
                    (fail 'device-mismatch operation "state tensor device mismatch" path)
                    #t))))))

(define (validate-destination-contract operation provider expected incoming)
  (let loop ((left expected) (right incoming))
    (cond
      ((and (null? left) (null? right)) #t)
      ((or (null? left) (null? right))
       (fail 'shape-mismatch operation "missing or unexpected state path" '()))
      ((not (equal? (entry-path (car left)) (entry-path (car right))))
       (fail 'shape-mismatch operation "missing or unexpected state path"
             (list (entry-path (car left)) (entry-path (car right)))))
      (else
       (same-entry-contract! operation provider (car left) (car right))
       (loop (cdr left) (cdr right))))))

(define (load-assignments expected incoming)
  (let loop ((left expected) (right incoming) (seen '()) (updates '()))
    (if (null? left)
        (list-reverse updates)
        (let* ((flat (car left))
               (target (vector-ref flat 2))
               (entry (car right))
               (kind (vector-ref entry 2)))
          (if (and (eq? kind 'parameter) (identity-member? target seen))
              (loop (cdr left) (cdr right) seen updates)
              (let* ((existing
                       (if (eq? kind 'parameter)
                           (vector-ref target 6)
                           (vector-ref target 2)))
                     (source (vector-ref entry 7)))
                (loop (cdr left) (cdr right)
                      (if (eq? kind 'parameter) (cons target seen) seen)
                      (cons (vector existing source kind) updates))))))))

(define (ensure-assignment-storage-unique! operation provider assignments)
  (let outer ((remaining assignments))
    (if (null? remaining)
        #t
        (let ((assignment (car remaining)))
          (let inner ((others (cdr remaining)))
            (if (null? others)
                (outer (cdr remaining))
                (if (tensor-storage-identical?
                      operation provider (vector-ref assignment 0)
                      (vector-ref (car others) 0) (vector-ref assignment 2)
                      (vector-ref (car others) 2))
                    (fail 'internal operation
                          "distinct load destinations alias tensor storage" '())
                    (inner (cdr others)))))))))

(define (ensure-sources-do-not-alias-destinations!
          operation provider assignments)
  (let scan-sources ((sources assignments))
    (if (null? sources)
        #t
        (let ((source (vector-ref (car sources) 1))
              (source-kind (vector-ref (car sources) 2)))
          (let scan-destinations ((destinations assignments))
            (if (null? destinations)
                (scan-sources (cdr sources))
                (if (tensor-storage-identical?
                      operation provider source
                      (vector-ref (car destinations) 0)
                      source-kind (vector-ref (car destinations) 2))
                    (fail 'corrupt-data operation
                          "state source aliases destination tensor storage" '())
                    (scan-destinations (cdr destinations)))))))))

(define (module-load-state-dict-scoped! module state)
  (require-root-module 'module-load-state-dict! module)
  (let ((provider (require-module-provider 'module-load-state-dict! module)))
    ;; Validate the inert envelope before consulting the process-local binding.
    ;; Unbound state is never eligible to load or commit.
    (validate-state-envelope 'module-load-state-dict! state)
    (let ((bound
            (require-provider 'module-load-state-dict!
                              (state-provider-binding-find state))))
      (if (not (eq? bound provider))
          (fail 'unsupported 'module-load-state-dict!
                "state binding and destination tensor providers differ" '())
          #t))
    ;; All tensor validation uses only the admitted, explicitly bound provider.
    (validate-state-with-provider 'module-load-state-dict! state provider)
    ;; Enumeration, metadata checks, canonical-path copies, and provider prepare
    ;; are pure with respect to module topology.  The only topology writes occur
    ;; after the provider's admitted one-shot commit has returned.
    (let* ((finalizers
             (finalization-plan 'module-load-state-dict! module))
           (parameters (sort-entries (flatten-parameters module '())))
           (buffers (sort-entries (flatten-buffers module '())))
           (parameter-count
             (validate-generated-entry-paths!
               'module-load-state-dict! parameters))
           (buffer-count
             (validate-generated-entry-paths!
               'module-load-state-dict! buffers))
           (entry-count (+ parameter-count buffer-count))
           (destinations (sort-entries (list-append parameters buffers)))
           (expected
             (state-contract-from-flat parameters buffers
                                       'module-load-state-dict! provider))
           (expected-aliases (tie-groups-from-entries parameters))
           (canonical-updates (canonical-path-updates parameters))
           (observation (vector #t canonical-updates finalizers))
           (incoming (vector-ref state 6)))
      (if (not (= entry-count (vector-ref module 9)))
          (fail 'internal 'module-load-state-dict!
                "module state entry count invariant failed" '())
          #t)
      (validate-destination-contract 'module-load-state-dict! provider
                                     expected incoming)
      (if (not (equal? expected-aliases (vector-ref state 7)))
          (fail 'shape-mismatch 'module-load-state-dict!
                "state alias graph does not match destination module" '())
          (let* ((assignments (load-assignments destinations incoming))
                 (unique (ensure-assignment-storage-unique!
                           'module-load-state-dict! provider assignments))
                 (disjoint (ensure-sources-do-not-alias-destinations!
                             'module-load-state-dict! provider assignments))
                 (plan (tensor-prepare-load 'module-load-state-dict! provider
                                            assignments)))
            (tensor-commit-load! 'module-load-state-dict! provider plan)
            (commit-module-observation! observation))))))

(define (module-load-state-dict! module state)
  (let ((operation 'module-load-state-dict!))
    (state-use-begin! operation state operation)
    (guard (caught
             (#t
               (state-use-end! operation state operation)
               (raise caught)))
      (let ((result (module-load-state-dict-scoped! module state)))
        (state-use-end! operation state operation)
        result))))

