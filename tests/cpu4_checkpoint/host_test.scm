  (check "serialized source tuple uses2field cursor and config pairs"
    (and (= (vector-length (vector-ref tuple 2)) 2)
         (= (vector-length (vector-ref tuple 3)) 2)))
  expanded-controls)
(define (c2-training-state-borrow-begin-internal source operation) (event 'borrow) 'borrow)
(define (c2-training-state-borrow-projection-internal borrow)
  (vector 'source-p1 'source-o2 expanded-controls (vector paths shapes aliases)
          (vector 'config paths aliases 0)))
