;;; Development-only source composition over the genuine M3 constructor.
;;; This inert frame key tests P1 helper semantics, not E3 frame admission.
(load "m3_package_root.esk")
(load "e3_p1_modes_extension.esk")
(define (check label actual expected)
  (if (equal? actual expected) #t
      (begin (display "FAIL ") (display label) (display " actual=")
             (display actual) (display " expected=") (display expected)
             (newline) (exit 1))))
(define config (x1-private-config-resolve
  (x1-private-config-parse "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
(define model (m3t-public-model-create config (m3t-public-initializer-state 1729)))
(define setup (vector (vector #f) #f))
(check "surface length" (vector-length p1-trusted-surface) 69)
(check "bind foreign" (p1-e3-mode-bind! (vector #f) setup) 1)
(check "bind malformed" (p1-e3-mode-bind! model (vector #f)) 1)
(check "bind" (p1-e3-mode-bind! model setup) 0)
(define token (vector-ref setup 1))
(check "bind duplicate" (p1-e3-mode-bind! model setup) 2)
(check "foreign prepare" (p1-e3-mode-prepare! (vector #f)) 1)
(check "idle enter" (p1-e3-mode-enter! token) 2)
(check "prepare" (p1-e3-mode-prepare! token) 0)
(check "prepared unbind" (p1-e3-mode-unbind! token) 2)
(check "prepared restore" (p1-e3-mode-restore! token) 0)
(check "prepare second" (p1-e3-mode-prepare! token) 0)
(check "enter" (p1-e3-mode-enter! token) 0)
(check "root eval" (module-mode-internal model) 'eval)
(check "repeat enter" (p1-e3-mode-enter! token) 2)
(check "restore" (p1-e3-mode-restore! token) 0)
(check "root train" (module-mode-internal model) 'train)
(check "repeat restore" (p1-e3-mode-restore! token) 2)
(check "unbind" (p1-e3-mode-unbind! token) 0)
(check "dead unbind" (p1-e3-mode-unbind! token) 0)
(check "dead prepare" (p1-e3-mode-prepare! token) 2)
(display "E3-P1-MODES-SMOKE-PASS") (newline)
