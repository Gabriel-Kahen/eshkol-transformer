    fixture-device-equal? fixture-prepare-load fixture-commit-load!
    fixture-release-owned!))

(define (fixture-admission-evidence)
  (list
    (vector
      (fixture-tensor-internal '(2) 'f32 'cpu
                               (vector 'admission-destination-a 'bits-v1))
      (fixture-tensor-internal '(2) 'f32 'cpu
                               (vector 'admission-source-a 'bits-v1))
      'parameter)
    (vector
      (fixture-tensor-internal '(2) 'f32 'cpu
                               (vector 'admission-destination-b 'bits-v1))
      (fixture-tensor-internal '(2) 'f32 'cpu
                               (vector 'admission-source-b 'bits-v1))
      'parameter)))

(define (reentrant-prepare-guarded request)
  (tensor-provider-register-internal! reentrant-target-provider
                                      (fixture-admission-evidence))
  (fixture-prepare-load request))

(define (reentrant-prepare (request : vector)) : vector
  (let ((result (reentrant-prepare-guarded request)))
    (if (vector? result) result
        (fixture-fail 'internal 'reentrant-prepare
                      "reentrant prepare returned a non-vector"))))

(define reentrant-provider
  (tensor-provider-create-internal
    'reentrant-v1 fixture-describe fixture-clone
    fixture-storage-identical? fixture-value-equal?
    fixture-device-equal? reentrant-prepare fixture-commit-load!
    fixture-release-owned!))

(define (self-reentrant-prepare-guarded request)
  (tensor-provider-register-internal! self-reentrant-provider
                                      (fixture-admission-evidence))
  (fixture-prepare-load request))

(define (self-reentrant-prepare (request : vector)) : vector
  (let ((result (self-reentrant-prepare-guarded request)))
    (if (vector? result) result
        (fixture-fail 'internal 'self-reentrant-prepare
                      "self-reentrant prepare returned a non-vector"))))

(define self-reentrant-provider
