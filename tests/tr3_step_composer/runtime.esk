(load "tr3_step_composer_root.esk")

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "TR3-STEP-COMPOSER-FAIL ") (display label)
             (newline) (exit 1))))
(define (error-at? category operation thunk)
  (guard (caught
           (#t (and (transformer-error? caught)
                    (eq? category (transformer-error-category caught))
                    (eq? operation (transformer-error-operation caught)))))
    (thunk) #f))
(define (diagnose label thunk)
  (guard (caught
           (#t (begin
                 (display "TR3-STEP-COMPOSER-ERROR ") (display label)
                 (if (transformer-error? caught)
                     (begin (display " ")
                            (display (transformer-error-category caught))
                            (display " ")
                            (display (transformer-error-operation caught))
                            (display " ")
                            (display (transformer-error-message caught)))
                     (display " foreign"))
                 (newline) (exit 2))))
    (thunk)))
(define (same-bytes? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((i 0))
         (if (= i (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left i) (bytevector-u8-ref right i))
                  (loop (+ i 1)))))))
(define (u32-le bytes offset)
  (+ (bytevector-u8-ref bytes offset)
     (* 256 (bytevector-u8-ref bytes (+ offset 1)))
     (* 65536 (bytevector-u8-ref bytes (+ offset 2)))
     (* 16777216 (bytevector-u8-ref bytes (+ offset 3)))))
(define (emit-bytes label bytes)
  (display label)
  (let loop ((i 0))
    (if (= i (bytevector-length bytes)) (newline)
        (begin (display " ") (display (bytevector-u8-ref bytes i))
               (loop (+ i 1))))))
(define (dataset-config directory)
  (list ':directory directory ':batch-size 1 ':sequence-length 2
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 4 ':maximum-batch-bytes 34
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #t))
(define (handle-paths handles)
  (let loop ((i 0))
    (if (= i (vector-length handles)) '()
        (cons (parameter-handle-path (vector-ref handles i))
              (loop (+ i 1))))))
(define (optimizer-config handles)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        '(none) '(constant)
        (list (list 'group (handle-paths handles)
                    "3dcccccd" "3f000000" "3f000000"
                    "3a83126f" "00000000"))))
(define (parameter-bits handle)
  (i2-checkpoint-encode
    (vector (parameter-handle-tensor-internal handle) 'parameter
            (parameter-handle-shape handle) 'f32 'cpu
            'dense-row-major-contiguous 'TR3-STEP-LEAF)))
(define (gradient-metadata handle)
  (i2-parameter-gradient-metadata-internal
    (parameter-handle-tensor-internal handle)))
(define (all-gradient-metadata? handles state count)
  (let loop ((i 0))
    (if (= i (vector-length handles)) #t
        (let ((meta (gradient-metadata (vector-ref handles i))))
          (and (= (vector-ref meta 0) state)
               (= (vector-ref meta 1) count)
               (loop (+ i 1)))))))

(define directory (diagnose 'argv (lambda () (car (cdr (command-line))))))
(define resolved
  (diagnose 'config (lambda ()
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729,\"training.accumulation-steps\":2}")
    '()))))
(define tokenizer (diagnose 'tokenizer (lambda () (t2-wave2-tokenizer-byte resolved))))
(define dataset (diagnose 'dataset (lambda () (d2-token-dataset-open (dataset-config directory) tokenizer))))
(define model
  (diagnose 'model (lambda ()
    (m3t-public-model-create resolved (m3t-public-initializer-state 1729)))))
(define handles (vector-ref (m3t-entry model 'model 'trainer-create #t) 8))
(define optimizer
  (diagnose 'optimizer (lambda ()
    (o2-public-optimizer-create (optimizer-config handles)
                                (module-parameters model)))))
(define trainer
  (diagnose 'trainer (lambda ()
    (tr3-lease-create-internal resolved tokenizer dataset model optimizer))))
(define record (car (vector-ref tr3-trainers 0)))
(define token (vector-ref record 5))
(check "enrolled exact shell" (eq? (vector-ref record 2) trainer))
(check "fixed accumulation two"
       (= (x1-private-config-ref resolved 'training.accumulation-steps) 2))
(define before (diagnose 'parameter-bits (lambda () (parameter-bits (vector-ref handles 0)))))
(check "key weight shape [4,4]" (= (bytevector-length before) 64))
(emit-bytes "TR3-STEP-KEY-BEFORE" before)

(define start-cursor (d2-token-dataset-cursor dataset))
(define start-rng (vector-copy (vector-ref record 18)))
(define injected #f)
(define (live-transients)
  (let loop ((remaining (vector-ref m3t-registry 0)) (count 0))
    (if (null? remaining) count
        (let* ((entry (car remaining))
               (kind (vector-ref entry 1)))
          (loop (cdr remaining)
                (if (and (eq? (vector-ref entry 2) 'live)
                         (or (eq? kind 'input) (eq? kind 'logits)
                             (eq? kind 'model-output)
                             (eq? kind 'model-logits)))
                    (+ count 1) count))))))
(define baseline-transients (live-transients))
(set! tr3-step-composer-test-hook
  (lambda (stage ordinal observation)
    (if (eq? stage 'observation)
        (begin
          (display "TR3-STEP-COMPOSER-OBS ") (display ordinal)
          (display " ") (display (u32-le observation 0))
          (display " ") (display (u32-le observation 4))
          (display " ") (display (u32-le observation 8))
          (newline)))
    (if (and (eq? stage 'early) (= ordinal 0) (eq? injected 'early))
        (check "reentrant composer rejects"
               (error-at? 'invalid-state 'tr3-step-composer-internal!
                 (lambda () (tr3-step-composer-internal! trainer)))))
    (if (eq? stage injected)
        (tr3-step-composer-fail 'invalid-state "injected pre-write failure"))
    #t))

(define (clean-after-failure label)
  (check label
    (and (not (vector-ref tr3-step-composer-active 0))
         (null? (vector-ref tr3-step-frames 0))
         (eq? (vector-ref record 3) 'idle)
         (not (vector-ref record 4))
         (= (live-transients) baseline-transients)
         (all-gradient-metadata? handles 0 0)
         (= (o2-optimizer-completed-updates-internal optimizer) 0)
         (same-bytes? start-cursor (d2-token-dataset-cursor dataset))
         (equal? start-rng (vector-ref record 18))
         (= (vector-ref record 19) 0)
         (= (vector-ref record 20) 0)
         (= (vector-ref record 21) 0)
         (same-bytes? before (parameter-bits (vector-ref handles 0)))
         (tr3-lease-restore-enter-admission! record
                                             'tr3-step-composer-test))))

(check "malformed trainer rejects"
       (error-at? 'invalid-argument 'tr3-step-transaction
         (lambda () (tr3-step-composer-internal! #f))))
(clean-after-failure "malformed trainer cleanup")

(set! injected 'early)
(check "early failure is categorized"
       (error-at? 'invalid-state 'tr3-step-composer-internal!
         (lambda () (tr3-step-composer-internal! trainer))))
(clean-after-failure "early owner and state cleanup")

(set! injected 'mid)
(check "mid-VJP failure is categorized"
       (error-at? 'invalid-state 'tr3-step-composer-internal!
         (lambda () (tr3-step-composer-internal! trainer))))
(clean-after-failure "mid gradient, graph, batch cleanup")

(set! injected 'precommit)
(check "prepared-plan failure is categorized"
       (error-at? 'invalid-state 'tr3-step-composer-internal!
         (lambda () (tr3-step-composer-internal! trainer))))
(clean-after-failure "prepared plan and all owners cleanup")

(set! injected #f)
(check "same trainer commits on retry"
       (diagnose 'successful-step
         (lambda () (tr3-step-composer-internal! trainer))))
(define committed-cursor (d2-token-dataset-cursor dataset))
(check "exact committed controls"
       (and (not (same-bytes? start-cursor committed-cursor))
            (equal? start-rng (vector-ref record 18))
            (= (vector-ref record 19) 3)
            (= (vector-ref record 20) 1)
            (= (vector-ref record 21) 0)
            (= (o2-optimizer-completed-updates-internal optimizer) 1)))
(check "success clears gradients and retires every transient"
       (and (all-gradient-metadata? handles 0 0)
            (= (live-transients) baseline-transients)
            (null? (vector-ref tr3-step-frames 0))
            (not (vector-ref tr3-step-composer-active 0))
            (eq? (vector-ref record 3) 'idle)
            (not (vector-ref record 4))
            (tr3-lease-restore-enter-admission! record
                                                'tr3-step-composer-test)))
(define after (parameter-bits (vector-ref handles 0)))
(check "parameter updated" (not (same-bytes? before after)))
(emit-bytes "TR3-STEP-KEY-AFTER" after)

(check "EOS is explicit unsupported condition"
       (error-at? 'invalid-state 'tr3-step-composer-internal!
         (lambda () (tr3-step-composer-internal! trainer))))
(check "EOS failure preserves prior committed step"
       (and (same-bytes? after (parameter-bits (vector-ref handles 0)))
            (same-bytes? committed-cursor
                         (d2-token-dataset-cursor dataset))
            (= (vector-ref record 19) 3)
            (= (vector-ref record 20) 1)
            (all-gradient-metadata? handles 0 0)
            (= (live-transients) baseline-transients)
            (null? (vector-ref tr3-step-frames 0))
            (not (vector-ref tr3-step-composer-active 0))))
(check "lease unlink" (tr3-lease-unenroll-internal! trainer))
(check "dataset close" (d2-token-dataset-close! dataset))
(display "TR3-STEP-COMPOSER-PASS checks=") (display checks) (newline)
