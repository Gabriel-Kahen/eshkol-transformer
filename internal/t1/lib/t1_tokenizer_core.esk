;;; T1 byte-tokenizer core.
;;;
;;; This source is build-only and deliberately has no provide form. It contains
;;; only Eshkol-authored tokenizer semantics, canonical-format logic, validation,
;;; and SHA-256. It is not an installed facade and does not choose X1 fields,
;;; persistence policy, E1B package topology, or I1 handle lifetime.
;;;
;;; The encode/decode seam below uses private canonical i64-le bytes solely as a
;;; staging representation for a future reviewed I1 consumer bridge. It is never
;;; a public tokenizer result and is not a tensor, dtype relabel, or fallback.

(define t1-core-major 1)
(define t1-core-minor 0)
(define t1-core-max-artifact-bytes 1048576)
(define t1-core-max-specials 4096)
(define t1-core-max-name-bytes 64)
(define t1-core-max-header-items 4096)
(define t1-core-max-optional-value-bytes 64)
(define t1-core-max-prefix 4096)
(define t1-core-max-suffix 4096)
(define t1-core-max-line-bytes 256)
(define t1-core-max-i64 9223372036854775807)
(define t1-core-max-i64-elements 2305843009213693951)

(define t1-core-error-tag (vector 't1-core-error-v1))
(define t1-core-tokenizer-tag (vector 't1-core-tokenizer-v1))

(define (t1-core-fail-raw category operation message)
  (let ((unreachable
         (raise (vector t1-core-error-tag category operation message))))
    unreachable))

(define-syntax t1-core-fail
  (syntax-rules ()
    ((_ category operation message)
     (let ((result (t1-core-fail-raw category operation message))) result))))

(define (t1-core-error? value)
  (and (vector? value) (= (vector-length value) 4)
       (eq? (vector-ref value 0) t1-core-error-tag)))

(define (t1-core-error-category value)
  (if (t1-core-error? value) (vector-ref value 1)
      (raise "t1-core-error-category: invalid receiver")))

(define (t1-core-error-operation value)
  (if (t1-core-error? value) (vector-ref value 2)
      (raise "t1-core-error-operation: invalid receiver")))

(define (t1-core-error-message value)
  (if (t1-core-error? value) (vector-ref value 3)
      (raise "t1-core-error-message: invalid receiver")))

(define (t1-core-reverse values)
  (let loop ((remaining values) (result '()))
    (if (null? remaining) result
        (loop (cdr remaining) (cons (car remaining) result)))))

(define (t1-core-append left right)
  (let loop ((remaining (t1-core-reverse left)) (result right))
    (if (null? remaining) result
        (loop (cdr remaining) (cons (car remaining) result)))))

(define (t1-core-proper-acyclic-list? value)
  (let loop ((slow value) (fast value))
    (cond
      ((null? fast) #t)
      ((not (pair? fast)) #f)
      (else
       (let ((fast-one (cdr fast)))
         (cond
           ((null? fast-one) #t)
           ((not (pair? fast-one)) #f)
           ((not (pair? slow)) #f)
           (else
            (let ((slow-one (cdr slow)) (fast-two (cdr fast-one)))
              (and (not (eq? slow-one fast-two))
                   (loop slow-one fast-two))))))))))

(define (t1-core-list-length-bounded values limit)
  (if (not (t1-core-proper-acyclic-list? values)) #f
      (let loop ((remaining values) (count 0))
        (cond ((null? remaining) count)
              ((>= count limit) #f)
              (else (loop (cdr remaining) (+ count 1)))))))

(define (t1-core-list-ref values wanted)
  (let loop ((remaining values) (index 0))
    (if (= index wanted) (car remaining)
        (loop (cdr remaining) (+ index 1)))))

(define (t1-core-copy-string-raw value)
  (let ((result (utf8->string (string->utf8 value)))) result))

(define-syntax t1-core-copy-string
  (syntax-rules ()
    ((_ value)
     (let ((result (t1-core-copy-string-raw value))) result))))

(define (t1-core-copy-bytes-raw value)
  (let ((result (bytevector-copy value 0 (bytevector-length value)))) result))

(define-syntax t1-core-copy-bytes
  (syntax-rules ()
    ((_ value)
     (let ((result (t1-core-copy-bytes-raw value))) result))))

(define (t1-core-bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define (t1-core-copy-into! destination offset source)
  (bytevector-copy! destination offset source 0 (bytevector-length source))
  destination)

(define (t1-core-concat parts)
  (let total ((remaining parts) (size 0))
    (if (null? remaining)
        (let ((result (make-bytevector size 0)))
          (let copy ((items parts) (offset 0))
            (if (null? items) result
                (begin
                  (t1-core-copy-into! result offset (car items))
                  (copy (cdr items)
                        (+ offset (bytevector-length (car items))))))))
        (total (cdr remaining) (+ size (bytevector-length (car remaining)))))))

(define (t1-core-ascii value)
  (let ((result (string->utf8 value))) result))

(define (t1-core-decimal value)
  (let ((result (t1-core-ascii (number->string value)))) result))

;;; -------------------------------------------------------------------------
;;; Eshkol-native SHA-256.

(define t1-core-sha256-u32-mask 4294967295)
(define t1-core-sha256-k
  (vector
   1116352408 1899447441 3049323471 3921009573
   961987163 1508970993 2453635748 2870763221
   3624381080 310598401 607225278 1426881987
   1925078388 2162078206 2614888103 3248222580
   3835390401 4022224774 264347078 604807628
   770255983 1249150122 1555081692 1996064986
   2554220882 2821834349 2952996808 3210313671
   3336571891 3584528711 113926993 338241895
   666307205 773529912 1294757372 1396182291
   1695183700 1986661051 2177026350 2456956037
   2730485921 2820302411 3259730800 3345764771
   3516065817 3600352804 4094571909 275423344
   430227734 506948616 659060556 883997877
   958139571 1322822218 1537002063 1747873779
   1955562222 2024104815 2227730452 2361852424
   2428436474 2756734187 3204031479 3329325298))

(define (t1-core-u32 value)
  (let ((result (bitwise-and value t1-core-sha256-u32-mask))) result))
(define (t1-core-shr value count)
  (arithmetic-shift (t1-core-u32 value) (- count)))
(define (t1-core-rotr value count)
  (let ((result
         (t1-core-u32
          (bitwise-or (t1-core-shr value count)
                      (arithmetic-shift (t1-core-u32 value)
                                        (- 32 count))))))
    result))
(define (t1-core-xor3 a b c)
  (let ((result (bitwise-xor (bitwise-xor a b) c))) result))
(define (t1-core-choice x y z)
  (let ((result
         (t1-core-u32
          (bitwise-xor (bitwise-and x y)
                       (bitwise-and (bitwise-not x) z)))))
    result))
(define (t1-core-majority x y z)
  (let ((result
         (t1-core-xor3 (bitwise-and x y) (bitwise-and x z)
                       (bitwise-and y z))))
    result))
(define (t1-core-big0 x)
  (let ((result
         (t1-core-xor3 (t1-core-rotr x 2) (t1-core-rotr x 13)
                       (t1-core-rotr x 22))))
    result))
(define (t1-core-big1 x)
  (let ((result
         (t1-core-xor3 (t1-core-rotr x 6) (t1-core-rotr x 11)
                       (t1-core-rotr x 25))))
    result))
(define (t1-core-small0 x)
  (let ((result
         (t1-core-xor3 (t1-core-rotr x 7) (t1-core-rotr x 18)
                       (t1-core-shr x 3))))
    result))
(define (t1-core-small1 x)
  (let ((result
         (t1-core-xor3 (t1-core-rotr x 17) (t1-core-rotr x 19)
                       (t1-core-shr x 10))))
    result))

(define (t1-core-load-be32 bytes offset)
  (let ((result
         (t1-core-u32
          (+ (arithmetic-shift (bytevector-u8-ref bytes offset) 24)
             (arithmetic-shift (bytevector-u8-ref bytes (+ offset 1)) 16)
             (arithmetic-shift (bytevector-u8-ref bytes (+ offset 2)) 8)
             (bytevector-u8-ref bytes (+ offset 3))))))
    result))

(define (t1-core-sha-expand! words block offset)
  (let fill ((index 0))
    (if (< index 16)
        (begin
          (vector-set! words index
                       (t1-core-load-be32 block (+ offset (* index 4))))
          (fill (+ index 1)))))
  (let expand ((index 16))
    (if (< index 64)
        (begin
          (vector-set!
           words index
           (t1-core-u32
            (+ (t1-core-small1 (vector-ref words (- index 2)))
               (vector-ref words (- index 7))
               (t1-core-small0 (vector-ref words (- index 15)))
               (vector-ref words (- index 16)))))
          (expand (+ index 1))))))

(define (t1-core-sha-compress! state words)
  (let ((work (vector-copy state)))
    (let rounds ((index 0))
      (if (< index 64)
          (let* ((a (vector-ref work 0)) (b (vector-ref work 1))
                 (c (vector-ref work 2)) (d (vector-ref work 3))
                 (e (vector-ref work 4)) (f (vector-ref work 5))
                 (g (vector-ref work 6)) (h (vector-ref work 7))
                 (t1 (t1-core-u32
                      (+ h (t1-core-big1 e) (t1-core-choice e f g)
                         (vector-ref t1-core-sha256-k index)
                         (vector-ref words index))))
                 (t2 (t1-core-u32
                      (+ (t1-core-big0 a) (t1-core-majority a b c)))))
            (vector-set! work 0 (t1-core-u32 (+ t1 t2)))
            (vector-set! work 1 a)
            (vector-set! work 2 b)
            (vector-set! work 3 c)
            (vector-set! work 4 (t1-core-u32 (+ d t1)))
            (vector-set! work 5 e)
            (vector-set! work 6 f)
            (vector-set! work 7 g)
            (rounds (+ index 1)))))
    (let add ((index 0))
      (if (< index 8)
          (begin
            (vector-set! state index
                         (t1-core-u32 (+ (vector-ref state index)
                                         (vector-ref work index))))
            (add (+ index 1)))))))

(define (t1-core-sha-pad bytes)
  (let* ((length (bytevector-length bytes))
         (padded-length (* (quotient (+ length 72) 64) 64))
         (padded (make-bytevector padded-length 0))
         (bit-length (* length 8)))
    (bytevector-copy! padded 0 bytes 0 length)
    (bytevector-u8-set! padded length 128)
    (let loop ((index 0))
      (if (< index 8)
          (begin
            (bytevector-u8-set!
             padded (+ (- padded-length 8) index)
             (bitwise-and
              (arithmetic-shift bit-length (- (* (- 7 index) 8))) 255))
            (loop (+ index 1)))))
    padded))

(define (t1-core-sha-state-bytes state)
  (let ((digest (make-bytevector 32 0)))
    (let words ((wi 0))
      (if (< wi 8)
          (let ((word (vector-ref state wi)))
            (let bytes ((bi 0))
              (if (< bi 4)
                  (begin
                    (bytevector-u8-set!
                     digest (+ (* wi 4) bi)
                     (bitwise-and
                      (arithmetic-shift word (- (* (- 3 bi) 8))) 255))
                    (bytes (+ bi 1)))))
            (words (+ wi 1)))))
    digest))

(define (t1-core-sha256 bytes)
  (if (not (bytevector? bytes))
      (t1-core-fail 'invalid-argument 't1-core-sha256
                    "SHA-256 input must be a bytevector"))
  (if (> (bytevector-length bytes) t1-core-max-i64-elements)
      (t1-core-fail 'invalid-argument 't1-core-sha256
                    "SHA-256 input exceeds its length field"))
  (let* ((padded (t1-core-sha-pad bytes))
         (state (vector 1779033703 3144134277 1013904242 2773480762
                        1359893119 2600822924 528734635 1541459225))
         (words (make-vector 64 0)))
    (let blocks ((offset 0))
      (if (< offset (bytevector-length padded))
          (begin
            (t1-core-sha-expand! words padded offset)
            (t1-core-sha-compress! state words)
            (blocks (+ offset 64)))))
    (let ((result (t1-core-sha-state-bytes state))) result)))

(define t1-core-hex-digits "0123456789abcdef")

(define (t1-core-hex bytes)
  (let* ((length (bytevector-length bytes))
         (result (make-string (* length 2) #\0)))
    (let loop ((index 0))
      (if (= index length) result
          (let ((value (bytevector-u8-ref bytes index)))
            (string-set! result (* index 2)
                         (string-ref t1-core-hex-digits (quotient value 16)))
            (string-set! result (+ (* index 2) 1)
                         (string-ref t1-core-hex-digits (modulo value 16)))
            (loop (+ index 1)))))))

;;; -------------------------------------------------------------------------
;;; Data validation and canonical construction.

(define (t1-core-exact-nonnegative-i64? value)
  (and (integer? value) (exact? value) (real? value)
       (>= value 0) (<= value t1-core-max-i64)))

(define (t1-core-name-byte? value first?)
  (or (and (>= value 97) (<= value 122))
      (and (not first?) (>= value 48) (<= value 57))
      (and (not first?) (or (= value 46) (= value 95) (= value 45)))))

(define (t1-core-valid-name? name)
  (and (string? name)
       (let ((bytes (string->utf8 name)))
         (and (> (bytevector-length bytes) 0)
              (<= (bytevector-length bytes) t1-core-max-name-bytes)
              (let loop ((index 0))
                (if (= index (bytevector-length bytes)) #t
                    (and (t1-core-name-byte?
                          (bytevector-u8-ref bytes index) (= index 0))
                         (loop (+ index 1)))))))))

(define (t1-core-special-record? value)
  (and (t1-core-proper-acyclic-list? value)
       (= (t1-core-list-length-bounded value 4) 3)
       (t1-core-exact-nonnegative-i64? (car value))
       (t1-core-valid-name? (car (cdr value)))
       (let ((policy (car (cdr (cdr value)))))
         (or (eq? policy 'omit) (eq? policy 'error)))))

(define (t1-core-insert-special special sorted)
  (if (or (null? sorted) (< (car special) (car (car sorted))))
      (cons special sorted)
      (cons (car sorted)
            (t1-core-insert-special special (cdr sorted)))))

(define (t1-core-sort-specials specials)
  (let loop ((remaining specials) (result '()))
    (if (null? remaining) result
        (loop (cdr remaining)
              (t1-core-insert-special (car remaining) result)))))

(define (t1-core-copy-special special)
  (list (car special) (t1-core-copy-string (car (cdr special)))
        (car (cdr (cdr special)))))

(define (t1-core-special-by-id specials token-id)
  (let loop ((remaining specials))
    (cond ((null? remaining) #f)
          ((= token-id (car (car remaining))) (car remaining))
          (else (loop (cdr remaining))))))

(define (t1-core-special-name-present? specials name)
  (let loop ((remaining specials))
    (and (not (null? remaining))
         (or (string=? name (car (cdr (car remaining))))
             (loop (cdr remaining))))))

(define (t1-core-validate-specials specials operation)
  (let ((count (t1-core-list-length-bounded
                specials (+ t1-core-max-specials 1))))
    (if (not count)
        (t1-core-fail 'invalid-argument operation
                      "specials must be a bounded proper acyclic list"))
    (if (> count t1-core-max-specials)
        (t1-core-fail 'invalid-argument operation
                      "special count exceeds 4096"))
    (let copy ((remaining specials) (result '()))
      (if (null? remaining)
          (let ((sorted (t1-core-sort-specials (t1-core-reverse result))))
            (let check ((items sorted) (expected 256) (seen-names '()))
              (if (null? items) sorted
                  (let* ((special (car items))
                         (name (car (cdr special))))
                    (if (not (= (car special) expected))
                        (t1-core-fail 'invalid-argument operation
                                      "special IDs must be contiguous from 256"))
                    (let names ((seen seen-names))
                      (if (not (null? seen))
                          (if (string=? name (car seen))
                              (t1-core-fail 'invalid-argument operation
                                            "special names must be unique")
                              (names (cdr seen)))))
                    (check (cdr items) (+ expected 1)
                           (cons name seen-names))))))
          (if (not (t1-core-special-record? (car remaining)))
              (t1-core-fail 'invalid-argument operation
                            "malformed special-token record")
              (copy (cdr remaining)
                    (cons (t1-core-copy-special (car remaining)) result)))))))

(define (t1-core-validate-insertions values specials maximum operation field)
  (let ((count (t1-core-list-length-bounded values (+ maximum 1))))
    (if (not count)
        (t1-core-fail 'invalid-argument operation
                      "insertion IDs must be a bounded proper acyclic list"))
    (if (> count maximum)
        (t1-core-fail 'invalid-argument operation field))
    (let loop ((remaining values) (result '()))
      (if (null? remaining) (t1-core-reverse result)
          (let* ((token-id (car remaining))
                 (special (and (t1-core-exact-nonnegative-i64? token-id)
                               (t1-core-special-by-id specials token-id))))
            (if (not special)
                (t1-core-fail 'invalid-argument operation
                              "insertion references an unknown special ID"))
            (if (not (eq? (car (cdr (cdr special))) 'omit))
                (t1-core-fail 'invalid-argument operation
                              "inserted special must use omit decode policy"))
            (loop (cdr remaining) (cons token-id result)))))))

(define (t1-core-line . fields)
  (let build ((remaining fields) (first? #t) (parts '()))
    (if (null? remaining)
        (t1-core-concat (t1-core-reverse (cons (bytevector 10) parts)))
        (build (cdr remaining) #f
               (cons (car remaining)
                     (if first? parts (cons (bytevector 9) parts)))))))

(define t1-core-identity-domain
  (t1-core-ascii "sha256:eshkol-byte-tokenizer-v1\n"))
(define t1-core-checksum-domain
  (t1-core-ascii "eshkol-byte-tokenizer-checksum-v1\n"))

(define t1-core-v1-header
  (t1-core-ascii
   (string-append
    "format\teshkol-byte-tokenizer\n"
    "version\t1\t0\n"
    "required-features\t0\n"
    "optional-fields\t0\n"
    "limit-file-bytes\t1048576\n"
    "limit-specials\t4096\n"
    "limit-name-bytes\t64\n"
    "limit-header-items\t4096\n"
    "limit-optional-value-bytes\t64\n"
    "limit-prefix\t4096\n"
    "limit-suffix\t4096\n")))

(define (t1-core-payload policy specials prefix suffix)
  (let ((base
         (list
          (t1-core-line (t1-core-ascii "kind") (t1-core-ascii "byte"))
          (t1-core-line (t1-core-ascii "normalization") (t1-core-ascii "none"))
          (t1-core-line (t1-core-ascii "utf8-policy")
                        (t1-core-ascii (symbol->string policy)))
          (t1-core-line (t1-core-ascii "byte-ids")
                        (t1-core-ascii "0") (t1-core-ascii "255"))
          (t1-core-line
           (t1-core-ascii "special-count")
           (t1-core-decimal
            (t1-core-list-length-bounded specials 4097))))))
    (let add-specials ((remaining specials) (result (t1-core-reverse base)))
      (if (null? remaining)
          (let add-prefix
              ((values prefix) (index 0)
               (prefix-result
                (t1-core-append
                 (list
                  (t1-core-line
                   (t1-core-ascii "prefix-count")
                   (t1-core-decimal
                    (t1-core-list-length-bounded prefix 4097))))
                 result)))
            (if (null? values)
                (let add-suffix
                    ((suffix-values suffix) (suffix-index 0)
                     (suffix-result
                      (t1-core-append
                       (list
                        (t1-core-line
                         (t1-core-ascii "suffix-count")
                         (t1-core-decimal
                          (t1-core-list-length-bounded suffix 4097))))
                       prefix-result)))
                  (if (null? suffix-values)
                      (t1-core-concat (t1-core-reverse suffix-result))
                      (add-suffix
                       (cdr suffix-values) (+ suffix-index 1)
                       (t1-core-append
                        (list
                         (t1-core-line
                          (t1-core-ascii "suffix")
                          (t1-core-decimal suffix-index)
                          (t1-core-decimal (car suffix-values))))
                        suffix-result))))
                (add-prefix
                 (cdr values) (+ index 1)
                 (t1-core-append
                  (list
                   (t1-core-line
                    (t1-core-ascii "prefix")
                    (t1-core-decimal index)
                    (t1-core-decimal (car values))))
                  prefix-result))))
          (let ((special (car remaining)))
            (add-specials
             (cdr remaining)
             (t1-core-append
              (list
               (t1-core-line
                (t1-core-ascii "special")
                (t1-core-decimal (car special))
                (t1-core-ascii (car (cdr special)))
                (t1-core-ascii
                 (symbol->string (car (cdr (cdr special)))))))
              result)))))))

(define (t1-core-build-artifact policy specials prefix suffix)
  (let* ((payload (t1-core-payload policy specials prefix suffix))
         (payload-size-line
          (t1-core-line (t1-core-ascii "payload-bytes")
                        (t1-core-decimal (bytevector-length payload))))
         (algorithm-line
          (t1-core-line (t1-core-ascii "checksum-algorithm")
                        (t1-core-ascii "sha256")))
         (unsigned (t1-core-concat
                    (list t1-core-v1-header payload-size-line payload
                          algorithm-line)))
         (checksum
          (t1-core-hex
           (t1-core-sha256
            (t1-core-concat (list t1-core-checksum-domain unsigned)))))
         (artifact
          (t1-core-concat
           (list unsigned
                 (t1-core-line (t1-core-ascii "checksum")
                               (t1-core-ascii checksum)))))
         (identity-digest
          (t1-core-hex
           (t1-core-sha256
            (t1-core-concat
             (list t1-core-identity-domain t1-core-v1-header payload)))))
         (fingerprint
          (string-append "sha256:eshkol-byte-tokenizer-v1:" identity-digest)))
    (if (> (bytevector-length artifact) t1-core-max-artifact-bytes)
        (t1-core-fail 'invalid-argument 't1-tokenizer-core-create
                      "canonical tokenizer artifact exceeds 1 MiB"))
    (vector artifact fingerprint payload)))

(define (t1-tokenizer-core-create utf8-policy specials prefix suffix)
  (let ((operation 't1-tokenizer-core-create))
    (if (not (or (eq? utf8-policy 'raw) (eq? utf8-policy 'strict)))
        (t1-core-fail 'invalid-argument operation
                      "UTF-8 policy must be raw or strict"))
    (let* ((checked-specials (t1-core-validate-specials specials operation))
           (checked-prefix
            (t1-core-validate-insertions
             prefix checked-specials t1-core-max-prefix operation
             "prefix count exceeds 4096"))
           (checked-suffix
            (t1-core-validate-insertions
             suffix checked-specials t1-core-max-suffix operation
             "suffix count exceeds 4096"))
           (built (t1-core-build-artifact
                   utf8-policy checked-specials checked-prefix checked-suffix)))
      (vector t1-core-tokenizer-tag utf8-policy checked-specials
              checked-prefix checked-suffix
              (vector-ref built 0) (vector-ref built 1)
              (bytevector-length (vector-ref built 2))))))

(define (t1-core-tokenizer? value)
  (and (vector? value) (= (vector-length value) 8)
       (eq? (vector-ref value 0) t1-core-tokenizer-tag)))

(define (t1-core-require-tokenizer value operation)
  (if (t1-core-tokenizer? value) value
      (t1-core-fail 'invalid-argument operation
                    "expected an internal T1 tokenizer")))

(define (t1-tokenizer-core-serialize tokenizer)
  (let ((value (t1-core-require-tokenizer
                tokenizer 't1-tokenizer-core-serialize)))
    (let ((result (t1-core-copy-bytes (vector-ref value 5)))) result)))

(define (t1-tokenizer-core-fingerprint tokenizer)
  (let ((value (t1-core-require-tokenizer
                tokenizer 't1-tokenizer-core-fingerprint)))
    (let ((result (t1-core-copy-string (vector-ref value 6)))) result)))

(define (t1-tokenizer-core-payload-size tokenizer)
  (let ((value (t1-core-require-tokenizer
                tokenizer 't1-tokenizer-core-payload-size)))
    (vector-ref value 7)))

(define (t1-tokenizer-core-vocab-size tokenizer)
  (let ((value (t1-core-require-tokenizer
                tokenizer 't1-tokenizer-core-vocab-size)))
    (+ 256 (t1-core-list-length-bounded (vector-ref value 2) 4097))))

(define (t1-tokenizer-core-special-token-id tokenizer name)
  (let* ((value (t1-core-require-tokenizer
                 tokenizer 't1-tokenizer-core-special-token-id))
         (specials (vector-ref value 2)))
    (if (not (string? name))
        (t1-core-fail 'invalid-argument 't1-tokenizer-core-special-token-id
                      "special-token name must be a string"))
    (let loop ((remaining specials))
      (cond
        ((null? remaining)
         (t1-core-fail 'invalid-argument 't1-tokenizer-core-special-token-id
                       "special-token name is not configured"))
        ((string=? name (car (cdr (car remaining))))
         (car (car remaining)))
        (else (loop (cdr remaining)))))))

;;; -------------------------------------------------------------------------
;;; Strict canonical parser.

(define (t1-core-line-at bytes offset operation)
  (let ((length (bytevector-length bytes)))
    (let loop ((index offset))
      (cond
        ((>= index length)
         (t1-core-fail 'corrupt-data operation "missing final LF"))
        ((= (bytevector-u8-ref bytes index) 10)
         (if (> (- index offset) t1-core-max-line-bytes)
             (t1-core-fail 'corrupt-data operation "line exceeds 256 bytes")
             (vector offset index (+ index 1))))
        ((= (bytevector-u8-ref bytes index) 13)
         (t1-core-fail 'corrupt-data operation "CR is not canonical"))
        ((> (bytevector-u8-ref bytes index) 127)
         (t1-core-fail 'corrupt-data operation "artifact must be ASCII"))
        (else (loop (+ index 1)))))))

(define (t1-core-line-fields bytes line)
  (let ((start (vector-ref line 0)) (end (vector-ref line 1)))
    (let loop ((index start) (field-start start) (result '()))
      (if (= index end)
          (t1-core-reverse
           (cons (bytevector-copy bytes field-start end) result))
          (if (= (bytevector-u8-ref bytes index) 9)
              (loop (+ index 1) (+ index 1)
                    (cons (bytevector-copy bytes field-start index) result))
              (loop (+ index 1) field-start result))))))

(define (t1-core-take-line bytes cursor-box length operation message)
  (if (>= (vector-ref cursor-box 0) length)
      (t1-core-fail 'corrupt-data operation message))
  (let ((line (t1-core-line-at bytes (vector-ref cursor-box 0) operation)))
    (vector-set! cursor-box 0 (vector-ref line 2))
    (let ((result (t1-core-line-fields bytes line))) result)))

(define (t1-core-fields-exact? fields expected)
  (cond
    ((null? fields) (null? expected))
    ((null? expected) #f)
    ((t1-core-bytes=? (car fields) (t1-core-ascii (car expected)))
     (t1-core-fields-exact? (cdr fields) (cdr expected)))
    (else #f)))

(define (t1-core-require-fields fields expected operation message)
  (if (t1-core-fields-exact? fields expected) #t
      (t1-core-fail 'corrupt-data operation message)))

(define (t1-core-canonical-unsigned bytes maximum operation field)
  (let ((length (bytevector-length bytes)))
    (if (= length 0)
        (t1-core-fail 'corrupt-data operation field))
    (if (and (> length 1) (= (bytevector-u8-ref bytes 0) 48))
        (t1-core-fail 'corrupt-data operation field))
    (let loop ((index 0) (value 0))
      (if (= index length) value
          (let ((digit (bytevector-u8-ref bytes index)))
            (if (or (< digit 48) (> digit 57))
                (t1-core-fail 'corrupt-data operation field))
            (let ((next (+ (* value 10) (- digit 48))))
              (if (> next maximum)
                  (t1-core-fail 'corrupt-data operation field))
              (loop (+ index 1) next)))))))

(define (t1-core-ascii-field-string bytes operation field)
  (let loop ((index 0))
    (if (< index (bytevector-length bytes))
        (if (> (bytevector-u8-ref bytes index) 127)
            (t1-core-fail 'corrupt-data operation field)
            (loop (+ index 1)))))
  (guard (caught (#t (t1-core-fail 'corrupt-data operation field)))
    (utf8->string bytes)))

(define (t1-core-field<? left right)
  (let ((left-length (bytevector-length left))
        (right-length (bytevector-length right)))
    (let loop ((index 0))
      (cond ((= index left-length) (< left-length right-length))
            ((= index right-length) #f)
            ((< (bytevector-u8-ref left index)
                (bytevector-u8-ref right index)) #t)
            ((> (bytevector-u8-ref left index)
                (bytevector-u8-ref right index)) #f)
            (else (loop (+ index 1)))))))

(define (t1-core-lower-hex? bytes exact-length allow-empty?)
  (let ((length (bytevector-length bytes)))
    (and (if exact-length (= length exact-length)
             (or allow-empty? (> length 0)))
         (let loop ((index 0))
           (if (= index length) #t
               (let ((value (bytevector-u8-ref bytes index)))
                 (and (or (and (>= value 48) (<= value 57))
                          (and (>= value 97) (<= value 102)))
                      (loop (+ index 1)))))))))

(define (t1-core-parse-name bytes operation field)
  (let ((name (t1-core-ascii-field-string bytes operation field)))
    (if (t1-core-valid-name? name) name
        (t1-core-fail 'corrupt-data operation field))))

(define (t1-core-parse-special-records payload cursor-box length operation count)
  (let loop ((index 0) (result '()))
    (if (= index count)
        (t1-core-reverse result)
        (let ((fields
               (t1-core-take-line payload cursor-box length operation
                                  "missing special record")))
          (if (or (not (= (t1-core-list-length-bounded fields 5) 4))
                  (not (t1-core-bytes=? (car fields)
                                        (t1-core-ascii "special"))))
              (t1-core-fail 'corrupt-data operation
                            "malformed special record"))
          (let* ((token-id
                  (t1-core-canonical-unsigned
                   (car (cdr fields)) (+ 255 t1-core-max-specials)
                   operation "invalid special ID"))
                 (name
                  (t1-core-parse-name
                   (car (cdr (cdr fields))) operation
                   "invalid special name"))
                 (policy-bytes (car (cdr (cdr (cdr fields)))))
                 (decode
                  (cond
                    ((t1-core-bytes=? policy-bytes
                                      (t1-core-ascii "omit")) 'omit)
                    ((t1-core-bytes=? policy-bytes
                                      (t1-core-ascii "error")) 'error)
                    (else
                     (t1-core-fail 'corrupt-data operation
                                   "invalid special decode policy")))))
            (if (not (= token-id (+ 256 index)))
                (t1-core-fail 'corrupt-data operation
                              "special IDs are not contiguous"))
            (loop (+ index 1) (cons (list token-id name decode) result)))))))

(define (t1-core-parse-insertion-records payload cursor-box length operation
                                         label count maximum)
  (let ((label-bytes (t1-core-ascii label)))
    (let loop ((position 0) (result '()))
      (if (= position count)
          (t1-core-reverse result)
          (let ((fields
                 (t1-core-take-line payload cursor-box length operation
                                    "missing insertion record")))
            (if (or (not (= (t1-core-list-length-bounded fields 4) 3))
                    (not (t1-core-bytes=? (car fields) label-bytes)))
                (t1-core-fail 'corrupt-data operation
                              "malformed insertion record"))
            (let ((actual
                   (t1-core-canonical-unsigned
                    (car (cdr fields)) (- maximum 1) operation
                    "invalid insertion position"))
                  (token-id
                   (t1-core-canonical-unsigned
                    (car (cdr (cdr fields))) t1-core-max-i64 operation
                    "invalid insertion ID")))
              (if (not (= actual position))
                  (t1-core-fail 'corrupt-data operation
                                "noncanonical insertion position"))
              (loop (+ position 1) (cons token-id result))))))))

(define (t1-core-count-record payload cursor-box length operation label maximum)
  (let ((fields
         (t1-core-take-line payload cursor-box length operation
                            "missing count record")))
    (if (or (not (= (t1-core-list-length-bounded fields 3) 2))
            (not (t1-core-bytes=?
                  (car fields) (t1-core-ascii label))))
        (t1-core-fail 'corrupt-data operation "malformed count record"))
    (let ((result
           (t1-core-canonical-unsigned (car (cdr fields)) maximum operation
                                       "invalid count record")))
      result)))

(define (t1-core-parse-payload payload operation)
  (let* ((cursor-box (vector 0))
         (length (bytevector-length payload)))
    (t1-core-require-fields
     (t1-core-take-line payload cursor-box length operation "missing kind record")
     '("kind" "byte") operation "kind must be byte")
    (t1-core-require-fields
     (t1-core-take-line payload cursor-box length operation
                        "missing normalization record")
     '("normalization" "none") operation "normalization must be none")
    (let* ((policy-fields
            (t1-core-take-line payload cursor-box length operation
                               "missing UTF-8 policy"))
           (policy
            (cond
              ((t1-core-fields-exact? policy-fields '("utf8-policy" "raw"))
               'raw)
              ((t1-core-fields-exact? policy-fields '("utf8-policy" "strict"))
               'strict)
              (else
               (t1-core-fail 'corrupt-data operation
                             "UTF-8 policy must be raw or strict")))))
      (t1-core-require-fields
       (t1-core-take-line payload cursor-box length operation
                          "missing byte ID range")
       '("byte-ids" "0" "255") operation
       "byte ID range must be exactly 0..255")
      (let* ((special-count
              (t1-core-count-record payload cursor-box length operation
                                    "special-count" t1-core-max-specials))
             (specials
              (t1-core-parse-special-records
               payload cursor-box length operation special-count))
             (prefix-count
              (t1-core-count-record payload cursor-box length operation
                                    "prefix-count" t1-core-max-prefix))
             (prefix
              (t1-core-parse-insertion-records
               payload cursor-box length operation "prefix"
               prefix-count t1-core-max-prefix))
             (suffix-count
              (t1-core-count-record payload cursor-box length operation
                                    "suffix-count" t1-core-max-suffix))
             (suffix
              (t1-core-parse-insertion-records
               payload cursor-box length operation "suffix"
               suffix-count t1-core-max-suffix)))
        (if (not (= (vector-ref cursor-box 0) length))
            (t1-core-fail 'corrupt-data operation
                          "unknown or trailing payload record"))
        (guard
         (caught
          ((t1-core-error? caught)
           (t1-core-fail 'corrupt-data operation
                         "invalid tokenizer semantics"))
          (else (raise caught)))
         (let ((validated
                (t1-tokenizer-core-create policy specials prefix suffix)))
           (vector policy (vector-ref validated 2) (vector-ref validated 3)
                   (vector-ref validated 4))))))))

(define (t1-tokenizer-core-parse-under-limit bytes metadata-limit)
  (let ((operation 't1-tokenizer-core-parse))
    (if (not (bytevector? bytes))
        (t1-core-fail 'invalid-argument operation
                      "artifact must be a bytevector"))
    (if (> (bytevector-length bytes) t1-core-max-artifact-bytes)
        (t1-core-fail 'corrupt-data operation "artifact exceeds 1 MiB"))
    (let ((cursor-box (vector 0)) (length (bytevector-length bytes)))
      (define-syntax take
        (syntax-rules ()
          ((_ message)
           (t1-core-take-line bytes cursor-box length operation message))))
      (t1-core-require-fields (take "missing format record")
                              '("format" "eshkol-byte-tokenizer") operation
                              "invalid tokenizer format")
      (let ((version-fields (take "missing version record")))
        (if (or (not (= (t1-core-list-length-bounded version-fields 4) 3))
                (not (t1-core-bytes=? (car version-fields)
                                      (t1-core-ascii "version"))))
            (t1-core-fail 'corrupt-data operation "malformed version record"))
        (let ((major (t1-core-canonical-unsigned
                      (car (cdr version-fields)) t1-core-max-i64 operation
                      "invalid major version"))
              (minor (t1-core-canonical-unsigned
                      (car (cdr (cdr version-fields))) t1-core-max-i64 operation
                      "invalid minor version")))
          (if (not (= major t1-core-major))
              (t1-core-fail 'version-mismatch operation
                            "unsupported tokenizer major version"))
          (let ((required-fields (take "missing required-feature count")))
            (if (or (not (= (t1-core-list-length-bounded required-fields 3) 2))
                    (not (t1-core-bytes=?
                          (car required-fields)
                          (t1-core-ascii "required-features"))))
                (t1-core-fail 'corrupt-data operation
                              "malformed required-feature count"))
            (let ((required-count
                   (t1-core-canonical-unsigned
                    (car (cdr required-fields)) t1-core-max-header-items
                    operation "invalid required-feature count")))
              (let parse-required ((index 0) (previous #f))
                (if (= index required-count)
                    (if (> required-count 0)
                        (t1-core-fail 'unsupported operation
                                      "required tokenizer feature is unsupported"))
                    (let ((fields (take "missing required-feature record")))
                      (if (or (not (= (t1-core-list-length-bounded fields 3) 2))
                              (not (t1-core-bytes=?
                                    (car fields)
                                    (t1-core-ascii "required-feature"))))
                          (t1-core-fail 'corrupt-data operation
                                        "malformed required-feature record"))
                      (let ((name (car (cdr fields))))
                        (t1-core-parse-name name operation
                                            "invalid required-feature name")
                        (if (and previous
                                 (not (t1-core-field<? previous name)))
                            (t1-core-fail 'corrupt-data operation
                                          "required features are not sorted unique"))
                        (parse-required (+ index 1) name)))))
              (let ((optional-fields (take "missing optional-field count")))
                (if (or (not (= (t1-core-list-length-bounded optional-fields 3) 2))
                        (not (t1-core-bytes=?
                              (car optional-fields)
                              (t1-core-ascii "optional-fields"))))
                    (t1-core-fail 'corrupt-data operation
                                  "malformed optional-field count"))
                (let ((optional-count
                       (t1-core-canonical-unsigned
                        (car (cdr optional-fields)) t1-core-max-header-items
                        operation "invalid optional-field count")))
                  (let parse-optional ((index 0) (previous #f))
                    (if (= index optional-count)
                        #t
                        (let ((fields (take "missing optional-field record")))
                          (if (or (not (= (t1-core-list-length-bounded fields 4) 3))
                                  (not (t1-core-bytes=?
                                        (car fields)
                                        (t1-core-ascii "optional-field"))))
                              (t1-core-fail 'corrupt-data operation
                                            "malformed optional-field record"))
                          (let ((name (car (cdr fields)))
                                (value (car (cdr (cdr fields)))))
                            (t1-core-parse-name name operation
                                                "invalid optional-field name")
                            (if (or (= (bytevector-length value) 0)
                                    (> (bytevector-length value)
                                       (* 2 t1-core-max-optional-value-bytes))
                                    (not (= (modulo (bytevector-length value) 2) 0))
                                    (not (t1-core-lower-hex? value #f #f)))
                                (t1-core-fail 'corrupt-data operation
                                              "invalid optional-field value"))
                            (if (and previous
                                     (not (t1-core-field<? previous name)))
                                (t1-core-fail
                                 'corrupt-data operation
                                 "optional fields are not sorted unique"))
                            (parse-optional (+ index 1) name)))))
                  (if (and (= minor 0) (> optional-count 0))
                      (t1-core-fail 'corrupt-data operation
                                    "version 1.0 has no optional fields"))
                  (let ((limits
                         '(("limit-file-bytes" "1048576")
                           ("limit-specials" "4096")
                           ("limit-name-bytes" "64")
                           ("limit-header-items" "4096")
                           ("limit-optional-value-bytes" "64")
                           ("limit-prefix" "4096")
                           ("limit-suffix" "4096"))))
                    (let parse-limits ((remaining limits))
                      (if (not (null? remaining))
                          (begin
                            (t1-core-require-fields
                             (take "missing hard-limit record")
                             (car remaining) operation
                             "hard-limit record differs from version 1")
                            (parse-limits (cdr remaining)))))
                    (let* ((header-end (vector-ref cursor-box 0))
                           (payload-fields (take "missing payload byte count")))
                      (if (or (not (= (t1-core-list-length-bounded
                                       payload-fields 3) 2))
                              (not (t1-core-bytes=?
                                    (car payload-fields)
                                    (t1-core-ascii "payload-bytes"))))
                          (t1-core-fail 'corrupt-data operation
                                        "malformed payload byte count"))
                      (let* ((payload-size
                              (t1-core-canonical-unsigned
                               (car (cdr payload-fields))
                               t1-core-max-artifact-bytes operation
                               "invalid payload byte count"))
                             (payload-start (vector-ref cursor-box 0))
                             (payload-end (+ payload-start payload-size)))
                        (if (> payload-size metadata-limit)
                            (t1-core-fail 'corrupt-data operation
                                          "tokenizer payload exceeds persistence policy"))
                        (if (> payload-end length)
                            (t1-core-fail 'corrupt-data operation
                                          "truncated tokenizer payload"))
                        (let ((payload
                               (bytevector-copy bytes payload-start payload-end)))
                          (vector-set! cursor-box 0 payload-end)
                          (let* ((algorithm-fields
                                  (take "missing checksum algorithm"))
                                 (algorithm-end (vector-ref cursor-box 0)))
                            (if (or (not (= (t1-core-list-length-bounded
                                             algorithm-fields 3) 2))
                                    (not (t1-core-bytes=?
                                          (car algorithm-fields)
                                          (t1-core-ascii
                                           "checksum-algorithm"))))
                                (t1-core-fail 'corrupt-data operation
                                              "malformed checksum algorithm"))
                            (if (not (t1-core-bytes=?
                                      (car (cdr algorithm-fields))
                                      (t1-core-ascii "sha256")))
                                (t1-core-fail 'unsupported operation
                                              "unsupported checksum algorithm"))
                            (let ((checksum-fields
                                   (take "missing checksum record")))
                              (if (or (not (= (t1-core-list-length-bounded
                                               checksum-fields 3) 2))
                                      (not (t1-core-bytes=?
                                            (car checksum-fields)
                                            (t1-core-ascii "checksum")))
                                      (not (t1-core-lower-hex?
                                            (car (cdr checksum-fields)) 64 #f)))
                                  (t1-core-fail 'corrupt-data operation
                                                "malformed checksum record"))
                              (if (not (= (vector-ref cursor-box 0) length))
                                  (t1-core-fail 'corrupt-data operation
                                                "trailing artifact bytes"))
                              (let ((actual
                                     (t1-core-ascii
                                      (t1-core-hex
                                       (t1-core-sha256
                                        (t1-core-concat
                                         (list
                                          t1-core-checksum-domain
                                          (bytevector-copy
                                           bytes 0 algorithm-end))))))))
                                (if (not (t1-core-bytes=?
                                          actual (car (cdr checksum-fields))))
                                    (t1-core-fail 'corrupt-data operation
                                                  "tokenizer checksum mismatch")))
                              (let* ((parsed
                                      (t1-core-parse-payload
                                       payload operation))
                                     (fingerprint
                                      (string-append
                                       "sha256:eshkol-byte-tokenizer-v1:"
                                       (t1-core-hex
                                        (t1-core-sha256
                                         (t1-core-concat
                                          (list
                                           t1-core-identity-domain
                                           (bytevector-copy bytes 0 header-end)
                                           payload)))))))
                                (vector
                                 t1-core-tokenizer-tag
                                 (vector-ref parsed 0)
                                 (vector-ref parsed 1)
                                 (vector-ref parsed 2)
                                 (vector-ref parsed 3)
                                 (t1-core-copy-bytes bytes)
                                 fingerprint
                                 payload-size)))))))))))))))))

;;; -------------------------------------------------------------------------
;;; Byte-exact encode/decode semantics.

(define (t1-core-utf8-continuation? value)
  (and (>= value 128) (<= value 191)))

(define (t1-core-valid-utf8? bytes)
  (let ((length (bytevector-length bytes)))
    (let loop ((offset 0))
      (if (= offset length) #t
          (let ((first (bytevector-u8-ref bytes offset)))
            (cond
              ((<= first 127) (loop (+ offset 1)))
              ((and (>= first 194) (<= first 223)
                    (< (+ offset 1) length)
                    (t1-core-utf8-continuation?
                     (bytevector-u8-ref bytes (+ offset 1))))
               (loop (+ offset 2)))
              ((and (>= first 224) (<= first 239)
                    (< (+ offset 2) length)
                    (let ((second (bytevector-u8-ref bytes (+ offset 1)))
                          (third (bytevector-u8-ref bytes (+ offset 2))))
                      (and
                       (t1-core-utf8-continuation? third)
                       (cond
                         ((= first 224) (and (>= second 160) (<= second 191)))
                         ((= first 237) (and (>= second 128) (<= second 159)))
                         (else (t1-core-utf8-continuation? second))))))
               (loop (+ offset 3)))
              ((and (>= first 240) (<= first 244)
                    (< (+ offset 3) length)
                    (let ((second (bytevector-u8-ref bytes (+ offset 1))))
                      (and
                       (cond
                         ((= first 240) (and (>= second 144) (<= second 191)))
                         ((= first 244) (and (>= second 128) (<= second 143)))
                         (else (t1-core-utf8-continuation? second)))
                       (t1-core-utf8-continuation?
                        (bytevector-u8-ref bytes (+ offset 2)))
                       (t1-core-utf8-continuation?
                        (bytevector-u8-ref bytes (+ offset 3))))))
               (loop (+ offset 4)))
              (else #f)))))))

(define (t1-core-input-bytes input policy operation)
  (let ((bytes
         (cond ((bytevector? input) (t1-core-copy-bytes input))
               ((string? input) (string->utf8 input))
               (else
                (t1-core-fail 'invalid-argument operation
                              "input must be a bytevector or UTF-8 string")))))
    (if (and (eq? policy 'strict) (not (t1-core-valid-utf8? bytes)))
        (t1-core-fail 'invalid-argument operation
                      "strict tokenizer input is malformed UTF-8"))
    bytes))

(define (t1-core-write-i64-le! bytes offset value)
  (let loop ((index 0) (remaining value))
    (if (= index 8) bytes
        (begin
          (bytevector-u8-set! bytes (+ offset index) (modulo remaining 256))
          (loop (+ index 1) (quotient remaining 256))))))

(define (t1-core-read-u64-le bytes offset)
  (let loop ((index 7) (result 0))
    (if (< index 0) result
        (loop (- index 1)
              (+ (* result 256)
                 (bytevector-u8-ref bytes (+ offset index)))))))

(define (t1-core-write-id-list! result start values)
  (let loop ((remaining values) (index start))
    (if (null? remaining) index
        (begin
          (t1-core-write-i64-le! result (* index 8) (car remaining))
          (loop (cdr remaining) (+ index 1))))))

(define (t1-tokenizer-core-encode-i64-le tokenizer input)
  (let* ((operation 't1-tokenizer-core-encode-i64-le)
         (value (t1-core-require-tokenizer tokenizer operation))
         (policy (vector-ref value 1))
         (prefix (vector-ref value 3))
         (suffix (vector-ref value 4))
         (input-bytes (t1-core-input-bytes input policy operation))
         (prefix-count (t1-core-list-length-bounded prefix 4097))
         (suffix-count (t1-core-list-length-bounded suffix 4097))
         (count (+ prefix-count (bytevector-length input-bytes) suffix-count)))
    (if (> count t1-core-max-i64-elements)
        (t1-core-fail 'invalid-argument operation
                      "encoded token extent exceeds exact i64 storage"))
    (let ((result (make-bytevector (* count 8) 0)))
      (let ((after-prefix (t1-core-write-id-list! result 0 prefix)))
        (let write-input ((index 0))
          (if (= index (bytevector-length input-bytes))
              (begin
                (t1-core-write-id-list! result (+ after-prefix index) suffix)
                result)
              (begin
                (t1-core-write-i64-le!
                 result (* (+ after-prefix index) 8)
                 (bytevector-u8-ref input-bytes index))
                (write-input (+ index 1)))))))))

(define (t1-tokenizer-core-encoded-count encoded)
  (if (not (bytevector? encoded))
      (t1-core-fail 'invalid-argument 't1-tokenizer-core-encoded-count
                    "encoded staging value must be a bytevector"))
  (if (not (= (modulo (bytevector-length encoded) 8) 0))
      (t1-core-fail 'invalid-argument 't1-tokenizer-core-encoded-count
                    "encoded staging byte count is not divisible by eight"))
  (quotient (bytevector-length encoded) 8))

(define (t1-tokenizer-core-decode-i64-le tokenizer encoded)
  (let* ((operation 't1-tokenizer-core-decode-i64-le)
         (value (t1-core-require-tokenizer tokenizer operation)))
    (if (not (bytevector? encoded))
        (t1-core-fail 'invalid-argument operation
                      "encoded staging value must be a bytevector"))
    (if (not (= (modulo (bytevector-length encoded) 8) 0))
        (t1-core-fail 'shape-mismatch operation
                      "encoded staging byte count is not divisible by eight"))
    (let* ((count (quotient (bytevector-length encoded) 8))
           (specials (vector-ref value 2))
           (vocab-size (+ 256 (t1-core-list-length-bounded specials 4097)))
           (scratch (make-bytevector count 0)))
      (let loop ((index 0) (written 0))
        (if (= index count)
            (let ((result (bytevector-copy scratch 0 written)))
              (if (and (eq? (vector-ref value 1) 'strict)
                       (not (t1-core-valid-utf8? result)))
                  (t1-core-fail 'invalid-argument operation
                                "decoded bytes are malformed UTF-8"))
              result)
            (let ((token-id (t1-core-read-u64-le encoded (* index 8))))
              (cond
                ((>= token-id vocab-size)
                 (t1-core-fail 'invalid-argument operation
                               "token ID is outside the tokenizer vocabulary"))
                ((< token-id 256)
                 (bytevector-u8-set! scratch written token-id)
                 (loop (+ index 1) (+ written 1)))
                (else
                 (let ((special (t1-core-special-by-id specials token-id)))
                   (if (not special)
                       (t1-core-fail 'invalid-argument operation
                                     "token ID is outside the tokenizer vocabulary"))
                   (if (eq? (car (cdr (cdr special))) 'error)
                       (t1-core-fail 'invalid-argument operation
                                     "special token is forbidden during decode"))
                   (loop (+ index 1) written))))))))))
