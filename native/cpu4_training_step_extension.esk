;;; Private CPU4 full step. Load after the genuine control producer, accepted
;;; microbatch schedule and tr3_o2_step_clear_extension (O2 algorithms only).
;;; No TR3 trainer/M3T authority, callback, public API or new native ABI.
(define cpu4-step-tag (vector 'cpu4-step-v1))
(define cpu4-step-frames (vector '() #f))
(define cpu4-step-exact-weight-max 16777216)
;;; Frame: [tag,self,record,row,state,lease,cursor,RNG,modes,counts,epoch,
;;; batch,contributions,active-tokens,epoch-delta,O2-plan,WRITE?,result,
;;; staged-controls,accumulation]. Exact closed frames remain inert tombstones.
(define (cpu4-step-fail category message)
  (cpu4-control-fail category 'cpu4-training-step! message))
(define-syntax cpu4-step-operation
  (syntax-rules ()
    ((_ expression ...)
     (begin
       (if (vector-ref cpu4-step-frames 1)
           (cpu4-step-fail 'invalid-state "CPU4 step operation is busy"))
       (vector-set! cpu4-step-frames 1 #t)
       (guard (caught (#t (vector-set! cpu4-step-frames 1 #f) (raise caught)))
         (let ((answer (begin expression ...)))
           (vector-set! cpu4-step-frames 1 #f)
           answer))))))
(define (cpu4-step-row-member? row)
  (let scan ((rows (vector-ref cpu4-trainers 0)))
    (and (pair? rows) (or (eq? row (car rows)) (scan (cdr rows))))))
(define (cpu4-step-frame-internal token)
  ;; Registry membership precedes all reads of the supplied candidate.
  (let scan ((rows (vector-ref cpu4-step-frames 0)))
    (cond ((null? rows) (cpu4-step-fail 'invalid-argument "CPU4 step frame is not registered"))
          ((eq? token (car rows))
           (let* ((frame (car rows)) (record (vector-ref frame 2))
                  (row (vector-ref frame 3)))
             (if (not (and (cpu4-control-vector? frame 20)
                           (eq? (vector-ref frame 0) cpu4-step-tag)
                           (eq? (vector-ref frame 1) frame)
                           (or (eq? (vector-ref frame 4) 'active)
                               (eq? (vector-ref frame 4) 'prepared))
                           (cpu4-step-row-member? row)
                           (eq? (vector-ref row 0) record)
                           (cpu4-control-vector? record 22)
                           (eq? (vector-ref record 0) cpu4-trainer-tag)
                           (eq? (vector-ref record 1) record)
                           (eq? (vector-ref record 3) 'step)
                           (eq? (vector-ref record 4) frame)))
                 (cpu4-step-fail 'invalid-state "CPU4 step frame is stale"))
             frame))
          (else (scan (cdr rows))))))
(define (cpu4-step-modes record)
  (let ((modes (make-vector 17 #f)))
    (let capture ((index 0))
      (if (= index 17) modes
          (let ((mode (module-mode-internal (vector-ref (vector-ref record 10) index))))
            (if (not (eq? mode 'train))
                (cpu4-step-fail 'invalid-state "CPU4 step requires all17 TRAIN modes"))
            (vector-set! modes index mode)
            (capture (+ index 1)))))))
(define (cpu4-step-modes-check! frame)
  (let ((modules (vector-ref (vector-ref frame 2) 10))
        (modes (vector-ref frame 8)))
    (let scan ((index 0))
      (if (= index 17) #t
          (if (not (eq? (module-mode-internal (vector-ref modules index))
                        (vector-ref modes index)))
              (cpu4-step-fail 'invalid-state "CPU4 module mode changed during step")
              (scan (+ index 1)))))))
(define (cpu4-step-components! frame)
  ;; The control producer's idle checker requires absent gradients. During
  ;; accumulation this exact-frame authority retains the same components and
  ;; saved controls; O2 prepare subsequently proves all14 gradient metadata.
  (let* ((record (vector-ref frame 2)) (row (vector-ref frame 3))
         (binding (cpu4-model-binding-check-internal (vector-ref record 9)))
         (tokenizer (vector-ref row 1)) (identity (d2-tokenizer-identity tokenizer))
         (state (d2-open-dataset-state (vector-ref record 15) 'cpu4-training-step!))
         (core (cpu4-d2-idle-core (vector-ref record 15) 'cpu4-training-step!))
         (optimizer (o2-require-optimizer 'cpu4-training-step! (vector-ref record 13)))
         (saved (vector-ref frame 9)) (retained (vector-ref record 7)))
    (if (not (and (eq? (vector-ref binding 5) (vector-ref frame 5))
                  (eq? (vector-ref record 6) (vector-ref binding 6))
                  (eq? (vector-ref record 8) (vector-ref binding 2))
                  (eq? (vector-ref record 10) (vector-ref binding 9))
                  (eq? (vector-ref record 11) (vector-ref binding 10))
                  (eq? (vector-ref record 12) (vector-ref binding 11))
                  (eq? (t2-private-entry tokenizer) (vector-ref row 2))
                  (cpu4-control-raw-tokenizer? tokenizer 'cpu4-training-step!)
                  (string=? (vector-ref retained 0) (vector-ref identity 0))
                  (= (vector-ref identity 1) 256)
                  (string=? (vector-ref retained 0) (vector-ref core 2))
                  (eq? state (vector-ref record 16))
                  (eq? optimizer (vector-ref record 14))
                  (cpu4-control-handle-list? (vector-ref record 11) (vector-ref optimizer 5))
                  (equal? (vector-ref record 18) (vector-ref frame 7))
                  (= (vector-ref record 19) (vector-ref saved 0))
                  (= (vector-ref record 20) (vector-ref saved 1))
                  (= (vector-ref record 21) (vector-ref saved 2))
                  (d2-core-bytes=? (vector-ref record 17) (vector-ref frame 10))))
        (cpu4-step-fail 'invalid-state "CPU4 retained step component or control differs"))
    ;; A prepared O2 plan exclusively owns its optimizer and its commit checks
    ;; the expected update count. The ordinary getter intentionally rejects it.
    (if (not (vector-ref frame 15))
        (let ((completed (o2-native-optimizer-completed-updates (vector-ref optimizer 1))))
          (if (< completed 0) (o2-native-fail 'cpu4-training-step!))
          (if (not (= completed (vector-ref saved 1)))
              (cpu4-step-fail 'invalid-state "CPU4 optimizer updates changed during step"))))
    (let scan ((rows o2-optimizers))
      (if (pair? rows)
          (begin
            (if (and (not (eq? optimizer (car rows)))
                     (cpu4-control-handle-overlap?
                       (vector-ref optimizer 5) (vector-ref (car rows) 5)))
                (cpu4-step-fail 'invalid-state "CPU4 parameters overlap another optimizer"))
            (scan (cdr rows)))))
    (cpu4-step-modes-check! frame)
    record))
(define (cpu4-step-enter-write! frame)
  (if (not (vector-ref frame 16))
      (begin
        (g3c4-native-check (cpu4-control-native-enter (vector-ref frame 5) 2) 'cpu4-training-step!)
        (vector-set! frame 16 #t)))
  #t)
(define (cpu4-step-leave-write! frame)
  ;; Every owned O2 transaction has drained before this terminal transition.
  ;; A failure cannot be safely reported as a recoverable completed cleanup.
  (if (vector-ref frame 16)
      (begin
        (if (not (= (cpu4-control-native-leave (vector-ref frame 5)) 0))
            (cpu4-binding-fail-stop 70))
        (vector-set! frame 16 #f)))
  #t)
(define (cpu4-step-recover-write! frame)
  ;; Before parameter commit a prepared plan can still pin canonical storage.
  ;; Preserve WRITE and exact ownership until its abort succeeds. Even with no
  ;; plan, a categorized native leave rejection retains the phase for retry.
  (if (and (vector-ref frame 16) (not (vector-ref frame 15)))
      (if (= (cpu4-control-native-leave (vector-ref frame 5)) 0)
          (vector-set! frame 16 #f)))
  #t)
(define (cpu4-training-step-start-internal trainer)
  (cpu4-step-operation
    (let* ((record (cpu4-trainer-idle-check-internal trainer 'cpu4-training-step!))
           (row (cpu4-trainer-row-internal trainer 'cpu4-training-step!))
           (accumulation (x1-private-config-ref (vector-ref record 6) 'training.accumulation-steps)))
      (if (or (not (m3t-exact-i64? accumulation)) (<= accumulation 0)
              (> accumulation (quotient cpu4-step-exact-weight-max 4)))
          (cpu4-step-fail 'unsupported "CPU4 accumulation exceeds worst-case T4 exact-f32 weight range"))
      (if (= (vector-ref record 20) cpu4-control-i64-max)
          (cpu4-step-fail 'invalid-state "CPU4 update count would overflow"))
      (let* ((cursor (cpu4-d2-cursor-capture-internal (vector-ref record 15)))
             (rng (vector-ref record 18))
             (rng-copy (vector (vector-ref rng 0) (vector-ref rng 1) (vector-ref rng 2)
                               (vector-ref rng 3) (vector-ref rng 4)))
             (modes (cpu4-step-modes record))
             (counts (vector (vector-ref record 19) (vector-ref record 20) (vector-ref record 21)))
             (epoch (cpu4-control-bytes (vector-ref record 17)))
             (observations (make-vector accumulation #f))
             (result (vector 0 0 0 observations))
             (frame (vector cpu4-step-tag #f record row 'pending
                       (cpu4-model-binding-native-lease-internal (vector-ref record 9))
                       cursor rng-copy modes counts epoch #f 0 0 0 #f #f result #f accumulation))
             (next (cons frame (vector-ref cpu4-step-frames 0))))
        (let allocate ((ordinal 0))
          (if (< ordinal accumulation)
              (begin (vector-set! observations ordinal (make-bytevector 12 0))
                     (allocate (+ ordinal 1)))))
        ;; Root before native enrollment and read the canonical promoted frame
        ;; back. Never publish a local pre-promotion pointer as exact identity.
        (vector-set! cpu4-step-frames 0 next)
        (let* ((canonical (car (vector-ref cpu4-step-frames 0)))
               (owner (vector-ref canonical 2)))
          (vector-set! canonical 1 canonical)
          (guard (caught (#t (vector-set! canonical 4 'dead) (raise caught)))
            ;; Last fallible dependency checks precede native IDLE proof and
            ;; rooted publication. No transient owner is created here.
            (cpu4-trainer-idle-check-internal (vector-ref owner 2) 'cpu4-training-step!)
            (g3c4-native-check (cpu4-control-native-enter (vector-ref canonical 5) 2) 'cpu4-training-step!)
            (if (not (= (cpu4-control-native-leave (vector-ref canonical 5)) 0))
                (cpu4-binding-fail-stop 70))
            (vector-set! canonical 4 'active)
            (vector-set! owner 3 'step)
            (vector-set! owner 4 canonical)
            canonical))))))
(define (cpu4-step-release-batch! frame)
  (if (vector-ref frame 11)
      (begin (d2-token-batch-release! (vector-ref frame 11))
             (vector-set! frame 11 #f)))
  #t)
(define (cpu4-step-next-batch! frame)
  (let* ((record (vector-ref frame 2)) (dataset (vector-ref record 15))
         (batch (d2-token-dataset-next-batch dataset)))
    (if (not (d2-token-dataset-end? batch)) batch
        (let* ((epoch-bytes (vector-ref frame 10))
               (epoch (d2-core-cursor-decode epoch-bytes))
               (current (d2-core-cursor-decode (cpu4-d2-cursor-capture-internal dataset))))
          (if (not (and (d2-core-state-identity=? epoch current)
                        (< (vector-ref epoch 15) (vector-ref epoch 14))
                        (= (vector-ref current 15) (vector-ref current 14))
                        (< (vector-ref frame 14) (vector-ref frame 19))
                        (< (vector-ref frame 14)
                           (- cpu4-control-i64-max (vector-ref (vector-ref frame 9) 2)))))
              (cpu4-step-fail 'invalid-state "CPU4 finite dataset cannot advance epoch"))
          (cpu4-d2-cursor-restore-internal! dataset epoch-bytes)
          (vector-set! frame 14 (+ (vector-ref frame 14) 1))
          (let ((next (d2-token-dataset-next-batch dataset)))
            (if (d2-token-dataset-end? next)
                (cpu4-step-fail 'invalid-state "CPU4 epoch is empty after rewind"))
            next)))))
(define (cpu4-step-weight-count bits)
  (cond ((= bits 1065353216) 1) ((= bits 1073741824) 2)
        ((= bits 1077936128) 3) ((= bits 1082130432) 4)
        (else (cpu4-step-fail 'invalid-state "CPU4 bool-mask weight is not one through four"))))
(define (cpu4-training-step-microbatch-internal! token)
  (cpu4-step-operation
    (let* ((frame (cpu4-step-frame-internal token))
           (ordinal (vector-ref frame 12)))
      (if (or (not (eq? (vector-ref frame 4) 'active))
              (vector-ref frame 11) (vector-ref frame 16)
              (>= ordinal (vector-ref frame 19)))
          (cpu4-step-fail 'invalid-state "CPU4 frame cannot accept another microbatch"))
      (cpu4-step-components! frame)
      (let* ((batch (cpu4-step-next-batch! frame))
             (observation (vector-ref (vector-ref (vector-ref frame 17) 3) ordinal)))
        (vector-set! frame 11 batch)
        (cpu4-training-microbatch-internal! (vector-ref (vector-ref frame 2) 9)
                                           batch ordinal observation)
        ;; Upstream success has drained READ and committed a complete atomic
        ;; contribution. The frame retains batch ownership until exact release.
        (vector-set! frame 12 (+ ordinal 1))
        (vector-set! frame 13 (+ (vector-ref frame 13)
                                (cpu4-step-weight-count (cpu4-training-u32 observation 4))))
        (cpu4-step-release-batch! frame)
        #t))))
(define (cpu4-step-f32-integer-bits value)
  (let loop ((power 1) (exponent 0))
    (if (<= (* power 2) value)
        (loop (* power 2) (+ exponent 1))
        (+ (* (+ exponent 127) 8388608)
           (quotient (* (- value power) 8388608) power)))))
(define (cpu4-training-step-prepare-internal! token)
  (cpu4-step-operation
    (let* ((frame (cpu4-step-frame-internal token)) (record (vector-ref frame 2))
           (saved (vector-ref frame 9)) (active (vector-ref frame 13)))
      (if (or (not (eq? (vector-ref frame 4) 'active))
              (vector-ref frame 11) (vector-ref frame 16)
              (not (= (vector-ref frame 12) (vector-ref frame 19)))
              (< active (vector-ref frame 19))
              (> active cpu4-step-exact-weight-max)
              (> active (- cpu4-control-i64-max (vector-ref saved 0)))
              (> (vector-ref frame 14) (- cpu4-control-i64-max (vector-ref saved 2))))
          (cpu4-step-fail 'invalid-state "CPU4 step is incomplete or its counters overflow"))
      (cpu4-step-components! frame)
      (let* ((tuple (cpu4-control-current-tuple record))
             (next-updates (+ (vector-ref saved 1) 1))
             (next-epochs (+ (vector-ref saved 2) (vector-ref frame 14))))
        (vector-set! tuple 4 (vector (+ (vector-ref saved 0) active) next-updates next-epochs))
        (vector-set! frame 18 (cpu4-control-validate-copy record tuple 'cpu4-training-step!))
        (let ((result (vector-ref frame 17)))
          (vector-set! result 0 active)
          (vector-set! result 1 next-updates)
          (vector-set! result 2 next-epochs))
        ;; Enter proves zero surviving native READ children before O2 writes.
        (cpu4-step-enter-write! frame)
        (guard (caught (#t (cpu4-step-recover-write! frame) (raise caught)))
          (let ((plan (o2-trainer-step-clear-prepare-internal
                        (vector-ref record 13) (vector-ref saved 1)
                        (vector-ref frame 19) (cpu4-step-f32-integer-bits active))))
            (vector-set! frame 15 plan)
            (vector-set! frame 4 'prepared)
            #t))))))
(define (cpu4-training-step-commit-internal! token)
  (cpu4-step-operation
    (let* ((frame (cpu4-step-frame-internal token)) (record (vector-ref frame 2))
           (controls (vector-ref frame 18)))
      (if (not (and (eq? (vector-ref frame 4) 'prepared)
                    (vector-ref frame 15) (vector-ref frame 16) controls
                    (not (vector-ref frame 11))))
          (cpu4-step-fail 'invalid-state "CPU4 step is not prepared for commit"))
      (cpu4-step-components! frame)
      (if (not (d2-core-bytes=?
                 (cpu4-d2-cursor-capture-internal (vector-ref record 15))
                 (vector-ref (vector-ref controls 2) 0)))
          (cpu4-step-fail 'invalid-state "CPU4 D2 cursor changed after prepare"))
      ;; fe9 guard installation calls eshkol_push_exception_handler, which can
      ;; malloc. Bind the flag and install this handler BEFORE native commit.
      ;; A categorized native rejection is pre-write; a completed native update
      ;; permits only the fixed flag/control tail, with defects fail-stopping.
      (let ((committed? #f))
       (guard (caught (#t (if committed? (cpu4-binding-fail-stop 70) (raise caught))))
        (o2-trainer-step-clear-commit-internal! (vector-ref frame 15))
        (set! committed? #t)
        (vector-set! record 18 (vector-ref controls 0))
        (vector-set! record 19 (vector-ref (vector-ref controls 4) 0))
        (vector-set! record 20 (vector-ref (vector-ref controls 4) 1))
        (vector-set! record 21 (vector-ref (vector-ref controls 4) 2))
        (cpu4-step-leave-write! frame)
        (vector-set! record 4 #f)
        (vector-set! record 3 'idle)
        (vector-set! frame 15 #f)
        (vector-set! frame 18 #f)
        (vector-set! frame 4 'committed)
        (vector-ref frame 17))))))
(define (cpu4-training-step-abort-internal! token)
  (cpu4-step-operation
    (let* ((frame (cpu4-step-frame-internal token)) (record (vector-ref frame 2)))
      ;; If exact batch release itself rejects, keep its owner and frame for
      ;; retry. Upstream microbatch always drains native READ before returning.
      (cpu4-step-release-batch! frame)
      (cpu4-step-enter-write! frame)
      (guard (caught (#t (cpu4-step-recover-write! frame) (raise caught)))
        (if (vector-ref frame 15)
            (begin (o2-trainer-step-clear-abort-internal! (vector-ref frame 15))
                   (vector-set! frame 15 #f)
                   (vector-set! frame 4 'active)))
        (cpu4-step-components! frame)
        ;; Genuine failure-atomic cleanup. Either rejection leaves this exact
        ;; rooted busy frame for retry. The handler releases WRITE only when
        ;; native storage is unpinned; otherwise the exact held phase remains.
        (cpu4-d2-cursor-restore-internal! (vector-ref record 15) (vector-ref frame 6))
        (o2-public-optimizer-zero-grad! (vector-ref record 13))
        (vector-set! record 18 (vector-ref frame 7))
        (vector-set! record 19 (vector-ref (vector-ref frame 9) 0))
        (vector-set! record 20 (vector-ref (vector-ref frame 9) 1))
        (vector-set! record 21 (vector-ref (vector-ref frame 9) 2))
        (g3c4-native-check (cpu4-control-native-leave (vector-ref frame 5)) 'cpu4-training-step!)
        (vector-set! frame 16 #f)
        (vector-set! record 4 #f)
        (vector-set! record 3 'idle)
        (vector-set! frame 18 #f)
        (vector-set! frame 4 'aborted)
        #t))))
(define (cpu4-training-step-internal! trainer)
  (let ((frame (cpu4-training-step-start-internal trainer)))
    (guard (caught
             (#t
               ;; Cleanup failure is reported with the exact frame retained;
               ;; the trainer remains busy until explicit same-frame abort.
               (cpu4-training-step-abort-internal! frame)
               (raise caught)))
      (let accumulate ((ordinal 0))
        (if (< ordinal (vector-ref frame 19))
            (begin (cpu4-training-step-microbatch-internal! frame)
                   (accumulate (+ ordinal 1)))))
      (cpu4-training-step-prepare-internal! frame)
      (cpu4-training-step-commit-internal! frame))))
