(fixture-reset-shared-clone-internal!)
(let* ((before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (first-module (module-create-fixture-internal)))
  (module-register-parameter-internal!
    first-module "weight"
    (fixture-tensor-internal
      '(1) 'f32 'cpu (vector 'live-state-owner)))
  (let* ((first-state (module-state-dict first-module))
         (first-handle (state-dict-tensor first-state '("weight")))
         (second-module (module-create-fixture-internal)))
    (let* ((protected
             (state-dict-tensor-borrow-begin-internal
               first-state first-handle))
           (alias (fixture-storage-alias-wrapper-internal protected)))
      (state-dict-tensor-borrow-end-internal first-state first-handle)
      (check "state storage attack uses a distinct carrier wrapper"
             (not (eq? alias protected)))
      (module-register-parameter-internal!
        second-module "weight"
        (fixture-tensor-unsafe-internal
          '(1) 'f32 'cpu #t (vector 'live-state-owner)
          'cross-publication))
      (fixture-arm-cross-publication-internal! alias)
      (expect-error
        "clone cannot publish a wrapper over another live state's storage"
        'internal
        (lambda () (module-state-dict second-module))))
    (check "cross-state clone rejection invokes no release callback"
           (= release-before (fixture-release-call-count-internal)))
    (let ((carrier
            (state-dict-tensor-borrow-begin-internal
              first-state first-handle)))
      (check "cross-state clone rejection preserves first state storage"
             (equal? (fixture-tensor-payload-internal carrier)
                     (vector 'live-state-owner)))
      (state-dict-tensor-borrow-end-internal first-state first-handle))
    (check "cross-state clone owner releases once"
           (state-dict-release! first-state))
    (check "cross-state clone cleanup returns to baseline"
           (= before (fixture-owned-live-count-internal)))))
(fixture-reset-shared-clone-internal!)

