;;; The joint exact artifact is authoritative for the measured lifecycle.
(define (run-joint-mode)
(define lifecycle-before (snapshot-counts))
(define owner-before (c2-load-owner-counts-internal))
(define stage-before (c2-load-stage-counts-internal))
(define require-before (c2-operational-k2-require-count))
(define owner
  (c2-public-checkpoint-load
    joint-path target-policy operational-report))
(check "joint public load requires every one of 64 descriptors exactly once"
       (= (c2-operational-k2-require-count) (+ require-before 64)))
(check "joint exact reconstruction publishes one exact C2 owner"
       (c2-load-exact-live-owner? owner))
(define live (snapshot-counts))
(check "joint E=62/P=1 owner has exact live storage"
  (and (= (vector-ref live 0) (+ 64 (vector-ref lifecycle-before 0)))
       (= (vector-ref live 1) (vector-ref lifecycle-before 1))
       (= (vector-ref live 2) (vector-ref lifecycle-before 2))
       (= (vector-ref live 3) (vector-ref lifecycle-before 3))
       (= (vector-ref live 4) (vector-ref lifecycle-before 4))
       (= (vector-ref live 5) (vector-ref lifecycle-before 5))
       (= (vector-ref live 6) (+ 64 (vector-ref lifecycle-before 6)))
       (= (vector-ref live 17) (vector-ref lifecycle-before 17))
       (= (vector-ref live 18) (vector-ref lifecycle-before 18))
       (= (vector-ref live 19) (vector-ref lifecycle-before 19))
       (= (vector-ref live 22) (+ 62 (vector-ref lifecycle-before 22)))
       (= (vector-ref live 24) (vector-ref lifecycle-before 24))
       (= (vector-ref live 25) (vector-ref lifecycle-before 25))
       (= (vector-ref live 26) (+ 1 (vector-ref lifecycle-before 26)))
       (= (vector-ref live 28) (+ 2 (vector-ref lifecycle-before 28)))
       (= (vector-ref live 30) (vector-ref lifecycle-before 30))
       (= (vector-ref live 31) (+ 2 (vector-ref lifecycle-before 31)))
       (= (vector-ref live 32) (vector-ref lifecycle-before 32))
       (= (vector-ref live 33) (+ 1 (vector-ref lifecycle-before 33)))))
(check "joint exact owner count is live/nonbusy"
  (let ((counts (c2-load-owner-counts-internal)))
    (and (= (vector-ref counts 0) (+ 1 (vector-ref owner-before 0)))
         (= (vector-ref counts 1) (vector-ref owner-before 1))
         (= (vector-ref counts 2) (vector-ref owner-before 2))
         (= (vector-ref counts 3) (vector-ref owner-before 3)))))

;;; Save three times from the same owner. Both model and O2 exact-bit paths
;;; must leave every one of the 35 live/retired test counters flat per cycle.
(define save-a (string-append output-root "/joint-a.c2"))
(define save-b (string-append output-root "/joint-b.c2"))
(define joint-measure-current (make-vector 3 0))
(define joint-measure-peak (make-vector 3 0))
(define joint-borrow-arena (make-vector 3 0))
(define joint-preflight-arena (make-vector 3 0))
(define joint-measure-arena (make-vector 3 0))
(define joint-encode-arena (make-vector 3 0))
(define joint-publish-arena (make-vector 3 0))
(define joint-encode-current (make-vector 3 0))
(define joint-encode-peak (make-vector 3 0))
(define joint-publish-current (make-vector 3 0))
(define joint-publish-peak (make-vector 3 0))
(define joint-measure-calls 0)
(define joint-encode-calls 0)
(define joint-publish-calls 0)
(define joint-borrow-calls 0)
(define joint-preflight-calls 0)
(define saved-operational-borrow c2-save-borrow-begin-internal)
(define saved-operational-preflight c2-save-o2-policy-preflight-internal)
(define saved-operational-measure c2-save-measure-staged-internal)
(define saved-operational-encode c2-save-encode-staged-into-internal!)
(define saved-operational-publish c2-save-publish-internal)
(set! c2-save-borrow-begin-internal
  (lambda (state operation)
    (let ((result (saved-operational-borrow state operation)))
      (vector-set! joint-borrow-arena joint-borrow-calls (__arena-used))
      (set! joint-borrow-calls (+ joint-borrow-calls 1))
      result)))
(set! c2-save-o2-policy-preflight-internal
  (lambda (topology o2-projection limits)
    (let ((result
            (saved-operational-preflight topology o2-projection limits)))
      (vector-set! joint-preflight-arena joint-preflight-calls (__arena-used))
      (set! joint-preflight-calls (+ joint-preflight-calls 1))
      result)))
(set! c2-save-measure-staged-internal
  (lambda (staged limits)
    (let ((result (saved-operational-measure staged limits)))
      (vector-set! joint-measure-current joint-measure-calls
                   (c2-operational-current-rss))
      (vector-set! joint-measure-peak joint-measure-calls
                   (c2-operational-peak-rss))
      (vector-set! joint-measure-arena joint-measure-calls (__arena-used))
      (set! joint-measure-calls (+ joint-measure-calls 1))
      result)))
(set! c2-save-encode-staged-into-internal!
  (lambda (staged limits destination file-bytes)
    (let ((result
            (saved-operational-encode
              staged limits destination file-bytes)))
      (vector-set! joint-encode-current joint-encode-calls
                   (c2-operational-current-rss))
      (vector-set! joint-encode-peak joint-encode-calls
                   (c2-operational-peak-rss))
      (vector-set! joint-encode-arena joint-encode-calls (__arena-used))
      (set! joint-encode-calls (+ joint-encode-calls 1))
      result)))
(set! c2-save-publish-internal
  (lambda (path bytes overwrite)
    (let ((result (saved-operational-publish path bytes overwrite)))
      (vector-set! joint-publish-current joint-publish-calls
                   (c2-operational-current-rss))
      (vector-set! joint-publish-peak joint-publish-calls
                   (c2-operational-peak-rss))
      (vector-set! joint-publish-arena joint-publish-calls (__arena-used))
      (set! joint-publish-calls (+ joint-publish-calls 1))
      result)))
(define first-save-counts (snapshot-counts))
(define first-save-arena-before (__arena-used))
(check "first joint operational save succeeds"
       (c2-public-checkpoint-save! owner save-a target-policy '()))
(define first-save-arena-delta (- (__arena-used) first-save-arena-before))
(check "first joint save retains under two exact file images"
       (and (>= first-save-arena-delta 0)
            (< first-save-arena-delta 33554432)))
(set! exact-save-max-arena-delta first-save-arena-delta)
(check "first joint save only publishes 124 lazy P1 identities"
       (same-except-delta?
         first-save-counts (snapshot-counts) 33 124))
(define save-counts (snapshot-counts))
(define second-save-arena-before (__arena-used))
(check "second joint operational save succeeds"
       (c2-public-checkpoint-save! owner save-b target-policy '()))
(define second-save-arena-delta (- (__arena-used) second-save-arena-before))
(if (or (< second-save-arena-delta 0)
        (>= second-save-arena-delta 32768))
    (begin
      (display "C2 OPERATIONAL DIAGNOSTIC: second-save-arena-delta=")
      (display second-save-arena-delta)
      (display " before=") (display second-save-arena-before)
      (display " borrow=") (display (vector-ref joint-borrow-arena 1))
      (display " preflight=") (display (vector-ref joint-preflight-arena 1))
      (display " measure=") (display (vector-ref joint-measure-arena 1))
      (display " encode=") (display (vector-ref joint-encode-arena 1))
      (display " publish=") (display (vector-ref joint-publish-arena 1))
      (display " after=") (display (__arena-used)) (newline)))
(check "warmed second joint save retains under 32 KiB"
       (and (>= second-save-arena-delta 0)
            (< second-save-arena-delta 32768)))
(if (> second-save-arena-delta exact-save-max-arena-delta)
    (set! exact-save-max-arena-delta second-save-arena-delta))
(check "second joint operational save is control-flat"
       (equal? save-counts (snapshot-counts)))
(define overwrite-save-arena-before (__arena-used))
(check "overwrite joint operational save succeeds"
       (c2-public-checkpoint-save!
         owner save-a target-policy '(:overwrite? #t)))
(define overwrite-save-arena-delta
  (- (__arena-used) overwrite-save-arena-before))
(if (or (< overwrite-save-arena-delta 0)
        (>= overwrite-save-arena-delta 32768))
    (begin
      (display "C2 OPERATIONAL DIAGNOSTIC: overwrite-save-arena-delta=")
      (display overwrite-save-arena-delta)
      (display " before=") (display overwrite-save-arena-before)
      (display " borrow=") (display (vector-ref joint-borrow-arena 2))
      (display " preflight=") (display (vector-ref joint-preflight-arena 2))
      (display " measure=") (display (vector-ref joint-measure-arena 2))
      (display " encode=") (display (vector-ref joint-encode-arena 2))
      (display " publish=") (display (vector-ref joint-publish-arena 2))
      (display " after=") (display (__arena-used)) (newline)))
(check "warmed overwrite joint save retains under 32 KiB"
       (and (>= overwrite-save-arena-delta 0)
            (< overwrite-save-arena-delta 32768)))
(if (> overwrite-save-arena-delta exact-save-max-arena-delta)
    (set! exact-save-max-arena-delta overwrite-save-arena-delta))
(check "overwrite joint operational save is control-flat"
       (equal? save-counts (snapshot-counts)))
(set! c2-save-measure-staged-internal saved-operational-measure)
(set! c2-save-encode-staged-into-internal! saved-operational-encode)
(set! c2-save-publish-internal saved-operational-publish)
(set! c2-save-o2-policy-preflight-internal saved-operational-preflight)
(set! c2-save-borrow-begin-internal saved-operational-borrow)
(check "joint phase probes observe exactly three complete saves"
       (and (= joint-borrow-calls 3)
            (= joint-preflight-calls 3)
            (= joint-measure-calls 3)
            (= joint-encode-calls 3)
            (= joint-publish-calls 3)))

(check "joint exact owner releases"
       (c2-public-trainer-state-release! owner))
(define lifecycle-after (snapshot-counts))
(define stage-after (c2-load-stage-counts-internal))
(define owner-after (c2-load-owner-counts-internal))
(check "joint exact lifecycle restores all storage live counters"
       (same-live-storage? lifecycle-before lifecycle-after))
(check "joint exact lifecycle has exact retired controls"
  (and (= (vector-ref lifecycle-after 7)
          (+ 128 (vector-ref lifecycle-before 7)))
       (= (vector-ref lifecycle-after 13)
          (+ (* 128 f32-control-bytes)
             (vector-ref lifecycle-before 13)))
       (= (vector-ref lifecycle-after 8) (vector-ref lifecycle-before 8))
       (= (vector-ref lifecycle-after 9) (vector-ref lifecycle-before 9))
       (= (vector-ref lifecycle-after 10) (vector-ref lifecycle-before 10))
       (= (vector-ref lifecycle-after 11) (vector-ref lifecycle-before 11))
       (= (vector-ref lifecycle-after 12) (vector-ref lifecycle-before 12))
       (= (vector-ref lifecycle-after 20) (vector-ref lifecycle-before 20))
       (= (vector-ref lifecycle-after 21) (vector-ref lifecycle-before 21))
       (= (vector-ref lifecycle-after 22)
          (+ 62 (vector-ref lifecycle-before 22)))
       (= (vector-ref lifecycle-after 23)
          (+ (* 62 i2-decode-control-bytes)
             (vector-ref lifecycle-before 23)))
       (= (vector-ref lifecycle-after 34)
          (+ 125 (vector-ref lifecycle-before 34)))
       (= (vector-ref lifecycle-after 27)
          (+ 1 (vector-ref lifecycle-before 27)))
       (= (vector-ref lifecycle-after 29)
          (+ 2 (vector-ref lifecycle-before 29)))))
(check "joint exact stage is consumed and clears four large references"
  (and (= (vector-ref stage-after 0) (vector-ref stage-before 0))
       (= (vector-ref stage-after 1) (vector-ref stage-before 1))
       (= (vector-ref stage-after 2) (+ 1 (vector-ref stage-before 2)))
       (= (vector-ref stage-after 3) (vector-ref stage-before 3))))
(check "joint exact C2 owner retires once"
  (and (= (vector-ref owner-after 0) (vector-ref owner-before 0))
       (= (vector-ref owner-after 1) (vector-ref owner-before 1))
       (= (vector-ref owner-after 2) (vector-ref owner-before 2))
       (= (vector-ref owner-after 3) (+ 1 (vector-ref owner-before 3)))))
(check "joint lifecycle drains all image/reader/fd state" (native-flat?))

(define retained-rss (c2-operational-current-rss))
(define peak-rss (c2-operational-peak-rss))
(define elapsed-ms (- (c2-operational-now) start-ms))
(display "C2 OPERATIONAL MEASURE: mode=joint baseline-kib=")
(display baseline-rss)
(display " retained-kib=") (display retained-rss)
(display " peak-kib=") (display peak-rss)
(display " elapsed-ms=") (display elapsed-ms)
(display " exact-save-max-arena-delta=")
(display exact-save-max-arena-delta)
(newline)
(display "C2 OPERATIONAL PHASE: mode=joint")
(display " first-save-arena-delta=") (display first-save-arena-delta)
(display " second-save-arena-delta=") (display second-save-arena-delta)
(display " overwrite-save-arena-delta=") (display overwrite-save-arena-delta)
(let phase ((index 0))
  (if (= index 3) #t
      (begin
        (display " measure-current-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-measure-current index))
        (display " measure-peak-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-measure-peak index))
        (display " encode-current-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-encode-current index))
        (display " encode-peak-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-encode-peak index))
        (display " publish-current-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-publish-current index))
        (display " publish-peak-kib-") (display (+ index 1))
        (display "=") (display (vector-ref joint-publish-peak index))
        (phase (+ index 1)))))
(newline)
(check "measured retained RSS is below 512 MiB"
       (and (> retained-rss 0) (< retained-rss 524288)))
(check "measured process peak RSS is below 512 MiB"
       (and (> peak-rss 0) (< peak-rss 524288)))
(check "measured runtime is inside the explicit watchdog"
       (and (>= elapsed-ms 0) (< elapsed-ms 1800000)))

(display "C2 OPERATIONAL RUNTIME PASS: ")
(display checks)
(display " checks mode=joint")
(display " baseline-kib=") (display baseline-rss)
(display " retained-kib=") (display retained-rss)
(display " peak-kib=") (display peak-rss)
(display " elapsed-ms=") (display elapsed-ms)
(display " f32-retained-bytes=")
(display (* 128 f32-control-bytes))
(display " i2-retained-bytes=")
(display (* 62 i2-decode-control-bytes))
(display " stage-dead-delta=")
(display (- (vector-ref stage-after 2) (vector-ref stage-before 2)))
(display " c2-dead-delta=")
(display (- (vector-ref owner-after 3) (vector-ref owner-before 3)))
(display " p1-first-touch=") (display 124)
(display " p1-tombstone-delta=")
(display (- (vector-ref lifecycle-after 34)
            (vector-ref lifecycle-before 34)))
(display " rejected-save-max-arena-delta=")
(display rejected-save-max-arena-delta)
(display " exact-save-max-arena-delta=")
(display exact-save-max-arena-delta)
(newline))
