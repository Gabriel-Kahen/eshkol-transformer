(define live-state-conflict-owned-before (fixture-owned-live-count-internal))
(define live-state-conflict-native-before (c1-p1-test-live-count))
(define live-state-conflict-carrier
  (fixture-owned-tensor-internal '(1) 'i64 'cpu (vector 73)))
(define live-state-conflict-envelope
  (vector live-state-conflict-carrier 'buffer
          'state-dict-adopt-owned-internal! #f))
(define live-state-conflict-ownership
  (vector (list live-state-conflict-envelope)))
(define live-state-conflict-state
  (state-dict-adopt-owned-internal!
    (list
      (vector '("live") 'buffer '(1) 'i64 'cpu
              'dense-row-major-contiguous live-state-conflict-carrier))
    '() 'fixture-v1 2 0 live-state-conflict-ownership))
(define live-state-conflict-release-before
  (fixture-release-call-count-internal))
(define live-state-conflict-decode-calls 0)
(define live-state-conflict-codec
  (c1-checkpoint-codec-internal
   'fixture-v1
   (lambda (request) (bytevector))
   (lambda (request)
     (set! live-state-conflict-decode-calls
           (+ live-state-conflict-decode-calls 1))
     (cond
       ((= live-state-conflict-decode-calls 1)
        (publish-decoded! request (decode-request-to-fixture request)))
       ((= live-state-conflict-decode-calls 2)
        (publish-decoded! request live-state-conflict-carrier))
       (else
        (transformer-error-raise
          'corrupt-data 'c1-live-state-conflict-trigger
          "injected decoder rollback trigger" '() #f))))))
(expect-error "decoder publishes live-state-owned carrier" 'internal
              (lambda ()
                (c1-checkpoint-decode-state-internal
                 encoded-a policy live-state-conflict-codec 'fixture-v1)))
(check "live-state carrier conflict reaches the second decoder request"
       (= live-state-conflict-decode-calls 3))
(check "live-state carrier conflict releases only the genuine sibling"
       (= (fixture-release-call-count-internal)
          (+ live-state-conflict-release-before 1)))
(check "live-state carrier conflict preserves its state owner"
       (= (fixture-owned-live-count-internal)
          (+ live-state-conflict-owned-before 1)))
(check "live-state carrier remains synchronously borrowable"
       (equal? (payload live-state-conflict-state '("live")) (vector 73)))
(check "live-state carrier owner releases exactly once"
       (state-dict-release! live-state-conflict-state))
(check "live-state carrier release invokes its one provider callback"
       (= (fixture-release-call-count-internal)
          (+ live-state-conflict-release-before 2)))
(check "live-state carrier release restores provider/native baselines"
       (and (= live-state-conflict-owned-before
               (fixture-owned-live-count-internal))
            (= live-state-conflict-native-before (c1-p1-test-live-count))))
(check "live-state carrier repeated release is a no-callback no-op"
       (and (state-dict-release! live-state-conflict-state)
            (= (fixture-release-call-count-internal)
               (+ live-state-conflict-release-before 2))))

