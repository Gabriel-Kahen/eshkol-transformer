;;; Source-private original authority for a detached terminal output.
;;; Allocate after pending reservation and before the first native sample.
;;; A live record retains no call, model, generator, or tokenizer edge.

(define g3c4-p2g2-terminal-live-anchors (vector '()))
(define g3c4-p2g2-terminal-live-originals (vector '()))

(define (g3c4-p2g2-terminal-live-prepare call pending)
  (let* ((operation 'g3c4-p2g2-terminal-live-prepare)
         (checked (g3c4-p2g2-terminal-pending-check call pending operation))
         (output (vector-ref checked 4))
         (shell (vector-ref checked 5))
         (native (vector-ref checked 6))
         (text-one (vector-ref checked 13))
         (text-two (vector-ref checked 14))
         (old-anchors (vector-ref g3c4-p2g2-terminal-live-anchors 0))
         (old-originals (vector-ref g3c4-p2g2-terminal-live-originals 0))
         ;; Count, selected text, IDs and cache expectation are bound once
         ;; after the authentic precommit frame.
         (live (vector 'unpublished output shell native text-one text-two
                       #f #f #f #f #f old-anchors old-originals #f #f #f))
         (original
           (let ((bound? #f) (nodes-bound? #f)
                 (native-released? #f) (retired? #f)
                 (original-anchor-node #f) (original-original-node #f)
                 (count #f) (selected #f) (id-zero #f) (id-one #f))
             (lambda (command candidate)
               (cond
                 ((eq? command 'shell) shell)
                 ((eq? command 'entry) output)
                 ((eq? command 'root)
                  (and nodes-bound? (pair? candidate)
                       (eq? (car candidate) original-anchor-node)
                       (eq? (cdr candidate) original-original-node)
                       (eq? (car original-anchor-node) live)))
                 ((eq? command 'nodes)
                  (if nodes-bound? (exit 134))
                  (set! original-anchor-node (vector-ref live 13))
                  (set! original-original-node (vector-ref live 14))
                  (if (not (and (eq? candidate live)
                                (pair? original-anchor-node)
                                (eq? (car original-anchor-node) live)
                                (eq? (cdr original-anchor-node) old-anchors)
                                (pair? original-original-node)
                                (eq? (cdr original-original-node)
                                     old-originals)))
                      (exit 134))
                  (set! nodes-bound? #t)
                  #t)
                 ((eq? command 'bind)
                  (if (or bound? (not nodes-bound?))
                      (g3c4-fail 'invalid-state operation
                                 "terminal original already bound"))
                  (if (not (and (vector? candidate)
                                (= (vector-length candidate) 31)
                                (eq? (vector-ref candidate 3) output)
                                (eq? (vector-ref candidate 4) shell)
                                (eq? (vector-ref candidate 6) native)
                                (eq? (vector-ref candidate 27) text-one)
                                (eq? (vector-ref candidate 28) text-two)
                                (or (= (vector-ref candidate 11) 1)
                                    (= (vector-ref candidate 11) 2))))
                      (g3c4-fail 'invalid-state operation
                                 "terminal frame changed before bind"))
                  (set! count (vector-ref candidate 11))
                  (set! selected (vector-ref candidate 12))
                  (set! id-zero (bytevector-u8-ref
                                   (if (= count 1) text-one text-two) 0))
                  (set! id-one (if (= count 2)
                                   (bytevector-u8-ref text-two 1) #f))
                  (if (not (eq? selected
                                (if (= count 1) text-one text-two)))
                      (g3c4-fail 'invalid-state operation
                                 "terminal selected text changed"))
                  (vector-set! live 6 count)
                  (vector-set! live 7 selected)
                  (vector-set! live 8 id-zero)
                  (vector-set! live 9 id-one)
                  (vector-set! live 15 (+ count 2))
                  (set! bound? #t)
                  #t)
                 ((eq? command 'check)
                  (and bound? nodes-bound? (not native-released?)
                       (not retired?) (eq? candidate live)
                       (eq? (vector-ref live 0) 'live)
                       (eq? (vector-ref live 1) output)
                       (eq? (vector-ref live 2) shell)
                       (eq? (vector-ref live 3) native)
                       (eq? (vector-ref live 4) text-one)
                       (eq? (vector-ref live 5) text-two)
                       (m3t-exact-i64? (vector-ref live 6))
                       (= (vector-ref live 6) count)
                       (eq? (vector-ref live 7) selected)
                       (m3t-exact-i64? (vector-ref live 8))
                       (= (vector-ref live 8) id-zero)
                       (equal? (vector-ref live 9) id-one)
                       (m3t-exact-i64? (vector-ref live 15))
                       (= (vector-ref live 15) (+ count 2))
                       (eq? (vector-ref live 11) old-anchors)
                       (eq? (vector-ref live 12) old-originals)
                       (eq? (vector-ref live 13) original-anchor-node)
                       (eq? (vector-ref live 14) original-original-node)
                       (bytevector? text-one)
                       (= (bytevector-length text-one) 1)
                       (bytevector? text-two)
                       (= (bytevector-length text-two) 2)
                       (= (bytevector-u8-ref selected 0) id-zero)
                       (if (= count 1)
                           (and (eq? selected text-one)
                                (g3c4-p2g2-terminal-text-zero? text-two 2))
                           (and (eq? selected text-two)
                                (= (bytevector-u8-ref text-two 1) id-one)
                                (g3c4-p2g2-terminal-text-zero? text-one 1)))))
                 ((eq? command 'native-release)
                  (if (not (and bound? nodes-bound? (not native-released?)
                                (not retired?) (pair? candidate)
                                (eq? (car candidate) live)
                                (vector? (cdr candidate))
                                (= (vector-length (cdr candidate)) 1)
                                (eq? (vector-ref (cdr candidate) 0) #f)
                                (eq? (vector-ref live 0) 'live)
                                (eq? (vector-ref output 2) 'live)
                                (eq? (vector-ref output 3) native)))
                      (g3c4-fail 'invalid-state operation
                                 "terminal original release owner changed"))
                  (let ((status (g3c4-native-output-release native)))
                    (if (= status 0)
                        (begin
                          (vector-set! (cdr candidate) 0 #t)
                          (set! native-released? #t)))
                    status))
                 ((eq? command 'retire)
                  (if (not (and native-released? (not retired?)
                                (eq? candidate output)
                                (g3c4-dead-entry? output 'terminal-output)))
                      (g3c4-fail 'invalid-state operation
                                 "terminal original cannot retire"))
                  (set! retired? #t)
                  #t)
                 ((eq? command 'dead)
                  (and bound? nodes-bound? native-released? retired?
                       (eq? candidate output)
                       (eq? (vector-ref output 0) shell)
                       (g3c4-dead-entry? output 'terminal-output)
                       (let clear-entry ((index 3))
                         (if (= index 12) #t
                             (and (eq? (vector-ref output index) #f)
                                  (clear-entry (+ index 1)))))
                       (eq? (vector-ref live 0) 'dead)
                       (let clear-live ((index 1))
                         (if (= index 16) #t
                             (and (eq? (vector-ref live index) #f)
                                  (clear-live (+ index 1)))))
                       (= (bytevector-u8-ref text-one 0) 0)
                       (= (bytevector-u8-ref text-two 0) 0)
                       (= (bytevector-u8-ref text-two 1) 0)))
                 (else #f)))))
         (anchor-node (cons live old-anchors))
         (original-node (cons original old-originals)))
    (vector-set! live 10 original)
    (vector-set! live 13 anchor-node)
    (vector-set! live 14 original-node)
    (original 'nodes live)
    (g3c4-p2g2-terminal-pending-check call pending operation)
    live))

(define (g3c4-p2g2-terminal-live-bind! call pending live frame)
  (let ((operation 'g3c4-p2g2-terminal-live-bind!))
    (g3c4-p2g2-terminal-pending-check call pending operation)
    (if (not (and (vector? live) (= (vector-length live) 16)
                  (eq? (vector-ref live 0) 'unpublished)
                  (eq? (vector-ref frame 2) pending)
                  (eq? (vector-ref live 1) (vector-ref frame 3))
                  (eq? (vector-ref live 2) (vector-ref frame 4))
                  (eq? (vector-ref live 3) (vector-ref frame 6))
                  (eq? (vector-ref live 4) (vector-ref frame 27))
                  (eq? (vector-ref live 5) (vector-ref frame 28))
                  (procedure? (vector-ref live 10))
                  (eq? (vector-ref g3c4-p2g2-terminal-live-anchors 0)
                       (vector-ref live 11))
                  (eq? (vector-ref g3c4-p2g2-terminal-live-originals 0)
                       (vector-ref live 12))
                  (pair? (vector-ref live 13))
                  (eq? (car (vector-ref live 13)) live)
                  (eq? (cdr (vector-ref live 13)) (vector-ref live 11))
                  (pair? (vector-ref live 14))
                  (eq? (car (vector-ref live 14)) (vector-ref live 10))
                  (eq? (cdr (vector-ref live 14)) (vector-ref live 12))))
        (g3c4-fail 'invalid-state operation
                   "terminal original owner changed before commit"))
    ((vector-ref live 10) 'bind frame)
    live))

;;; Only a detached private reader may call this after the coordinator has
;;; returned. Root traversal admits older terminal outputs too.
(define (g3c4-p2g2-terminal-output-entry-live shell operation)
  (let ((output (g3c4-registry-find shell operation)))
    (let loop ((anchors (vector-ref g3c4-p2g2-terminal-live-anchors 0))
               (originals (vector-ref g3c4-p2g2-terminal-live-originals 0)))
      (if (or (not (pair? anchors)) (not (pair? originals)))
          (g3c4-fail 'invalid-state operation
                     "terminal original live root missing")
          (let* ((live (car anchors))
                 (original (car originals)))
            (if (and (vector? live) (= (vector-length live) 16)
                     (eq? (vector-ref live 2) shell))
                (if (not (and (eq? (vector-ref live 1) output)
                              (eq? (vector-ref live 10) original)
                              (eq? (vector-ref live 11) (cdr anchors))
                              (eq? (vector-ref live 12) (cdr originals))
                              (eq? (vector-ref live 13) anchors)
                              (eq? (vector-ref live 14) originals)
                              (procedure? original)
                              (original 'check live)
                              (vector? output) (= (vector-length output) 12)
                              (eq? (vector-ref output 0) shell)
                              (eq? (vector-ref output 1) 'terminal-output)
                              (eq? (vector-ref output 2) 'live)
                              (eq? (vector-ref output 3) (vector-ref live 3))
                              (eq? (vector-ref output 4) #f)
                              (eq? (vector-ref output 5) #f)
                              (eq? (vector-ref output 6) #f)
                              (eq? (vector-ref output 8) (vector-ref live 7))
                              (eq? (vector-ref output 9) #f)
                              (eq? (vector-ref output 10) #f)
                              (eq? (vector-ref output 11) g3c4-model-profile)))
                    (g3c4-fail 'invalid-state operation
                               "terminal original live identity changed")
                    output)
                (loop (cdr anchors) (cdr originals))))))))

;;; Rooted original closure, rather than mutable output state, decides whether
;;; a dead entry ever crossed the native zero boundary in this process.
(define (g3c4-p2g2-terminal-output-original-for shell output operation)
  (let loop ((anchors (vector-ref g3c4-p2g2-terminal-live-anchors 0))
             (originals (vector-ref g3c4-p2g2-terminal-live-originals 0)))
    (if (or (not (pair? anchors)) (not (pair? originals)))
        (g3c4-fail 'invalid-state operation
                   "terminal original release authority is missing"))
    (let ((original (car originals)))
      (if (and (procedure? original) (eq? (original 'shell #f) shell))
          (if (and (original 'root (cons anchors originals))
                   (eq? (original 'entry #f) output))
              original
              (g3c4-fail 'invalid-state operation
                         "terminal original release identity changed"))
          (loop (cdr anchors) (cdr originals))))))

(define (g3c4-p2g2-terminal-output-entry-dead shell output operation)
  (let ((original (g3c4-p2g2-terminal-output-original-for
                    shell output operation)))
    (if (not (original 'dead output))
        (g3c4-fail 'invalid-state operation
                   "terminal original dead owner changed"))
    output))
