;;; Future compiled gate entry: same authentic corpus and private authority.
(extern void e3-n5-cap-run ptr ptr ptr :real et_e3_fault_run_v1)
(extern i64 e3-n5-rss-kib :real et_e3_retention_rss_kib_v1)
(extern void e3-n5-rss-record i64 i64 :real et_e3_retention_rss_record_v1)

(define (check label condition)
  (if condition #t
      (begin (display "E3-N5-FAIL: ") (display label) (newline) (exit 1))))

(define (argument-count values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))

(define (argument-ref values wanted)
  (let loop ((remaining values) (index 0))
    (if (= index wanted) (car remaining)
        (loop (cdr remaining) (+ index 1)))))

(define args (command-line))
(check 'arguments (= (argument-count args) 4))
(define corpus (argument-ref args 1))
(define gradient (argument-ref args 2))
(define mode (argument-ref args 3))
(check 'gradient-option (or (string=? gradient "present")
                            (string=? gradient "absent")))
(check 'mode-option (or (string=? mode "normal") (string=? mode "gte")
                        (string=? mode "oracle")))
(define present? (string=? gradient "present"))
(define mutant? (string=? mode "gte"))
(define oracle? (string=? mode "oracle"))
(define scenario
  (vector (if oracle? (vector 'n5-oracle present?)
              (vector 'n5-cap present? mutant?))))
(define input (vector corpus))
(define output (vector #f))
(define rss-before (e3-n5-rss-kib))
(e3-n5-cap-run scenario input output)
(define rss-after (e3-n5-rss-kib))
(e3-n5-rss-record rss-before rss-after)
(define result (vector-ref output 0))
(define (metrics? values)
  (and (vector? values) (= (vector-length values) 6)
       (= (vector-ref values 4) 16384)
       (= (vector-ref values 5) 8192)))
(define (print-metrics values)
  (display "E3-N5-METRICS loss_bits=") (display (vector-ref values 0))
  (display " weight_bits=") (display (vector-ref values 1))
  (display " ppl_bits=") (display (vector-ref values 2))
  (display " accuracy_bits=") (display (vector-ref values 3))
  (display " tokens=") (display (vector-ref values 4))
  (display " batches=") (display (vector-ref values 5)) (newline))
(if oracle?
    (begin
      (check 'oracle-result
        (and (vector? result) (= (vector-length result) 3)
             (eq? (vector-ref result 0) 'e3-n5-oracle-result-v1)
             (eq? (vector-ref result 1) present?)
             (metrics? (vector-ref result 2))))
      (print-metrics (vector-ref result 2)))
    (begin
      (check 'result
        (and (vector? result) (= (vector-length result) 8)
             (eq? (vector-ref result 0) 'e3-n5-cap-result-v1)
             (eq? (vector-ref result 1) present?)
             (eq? (vector-ref result 2) mutant?)
             (= (vector-ref result 3) 8193)
             (= (vector-ref result 4) 8192)
             (= (vector-ref result 5) 29)
             (eq? (vector-ref result 6)
                  (if mutant? 'unsupported 'success))
             (if mutant? (eq? (vector-ref result 7) #f)
                 (metrics? (vector-ref result 7)))))
      (display "E3-N5-CAP-PASS gradient=") (display gradient)
      (display " mode=") (display mode)
      (display " one_over=8193 boundary=8192 first_error=29 boundary_result=")
      (display (vector-ref result 6)) (newline)
      (if (not mutant?) (print-metrics (vector-ref result 7)))))
