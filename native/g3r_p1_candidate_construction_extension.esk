;;; Load only in the feature-local P1 owner with
;;; ET_G3R_CANDIDATE_RETIRE_PRIVATE on its trusted native P1 object.
(extern i64 g3r-p1-native-candidate-begin ptr
        :real et_p1_private_candidate_construction_begin_v1)
(extern i64 g3r-p1-native-candidate-preflight ptr ptr
        :real et_p1_private_candidate_graph_preflight_v1)

(module-candidate-construction-bind-native-internal!
  (lambda (context) (g3r-p1-native-candidate-begin context))
  (lambda (context construction)
    (g3r-p1-native-candidate-preflight context construction)))
