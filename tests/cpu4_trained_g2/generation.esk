;;; Closed fixture-only caller; all native imports are existing read-only counts.
(extern i64 cpu4-trained-g2-count i64 :real et_cpu4_child_test_o2_count)
(define cpu4-trained-g2-session (vector #f))
(define cpu4-trained-g2-checks 0)
(define (cpu4-trained-g2-check label good)
  (if good (set! cpu4-trained-g2-checks (+ cpu4-trained-g2-checks 1))
      (cpu4-binding-fail 'invalid-state 'cpu4-trained-g2 label)))
(define (cpu4-trained-g2-mode mode)
  (if (not (or (eq? mode 'two-token) (eq? mode 'first-eos)
               (eq? mode 'second-eos)))
      (cpu4-binding-fail 'invalid-argument 'cpu4-trained-g2 "closed generation mode required"))
  mode)
;;; [phase,recovery,T1,encoding,input,pair,output,IDs,lengths,cache,RNG,text,
;;; before-counts,exact-model,original-handles,mode]. Root BEFORE training/transfer.
(define (cpu4-trained-g2-ledger mode)
  (vector 'training (vector #f) #f #f #f #f #f #f #f #f #f #f #f #f #f mode))
(define (cpu4-trained-g2-config mode)
  (cpu4-trained-g2-mode mode)
  (list ':profile 'diagnostic-c4-p2g2 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256 ':top-p-bits 1065353216
        ':max-new-tokens 2 ':eos (cond ((eq? mode 'two-token) 255)
                                       ((eq? mode 'second-eos) 41)
                                       (else 3)) ':seed 41))
(define (cpu4-trained-g2-counts)
  (vector (cpu4-trained-g2-count 0) (cpu4-trained-g2-count 1)
          (cpu4-trained-g2-count 2) (cpu4-trained-g2-count 3)
          (cpu4-trained-g2-count 4) (cpu4-trained-g2-count 5)))
(define (cpu4-trained-g2-handles-copy handles)
  (let ((copy (make-vector 14 #f)))
    (let copy-handles ((index 0))
      (if (= index 14) copy
          (begin (vector-set! copy index (vector-ref handles index))
                 (copy-handles (+ index 1)))))))
(define (cpu4-trained-g2-handles=? left right)
  (let compare-handles ((index 0))
    (or (= index 14) (and (eq? (vector-ref left index) (vector-ref right index))
                          (compare-handles (+ index 1))))))
(define (cpu4-trained-g2-values handles)
  (let ((planes (make-vector 14 #f)))
    (let copy-values ((index 0))
      (if (= index 14) planes
          (begin
            (vector-set! planes index
              (i2-checkpoint-encode
                (vector (parameter-handle-tensor-identity-internal (vector-ref handles index))
                        'parameter (vector-ref g3c4-model-shapes index)
                        'f32 'cpu 'dense-row-major-contiguous 'cpu4-trained-g2)))
            (copy-values (+ index 1)))))))
(define (cpu4-trained-g2-modes? record expected)
  (let ((modes (heldout-modes record)))
    (let compare-modes ((index 0))
      (or (= index 17) (and (eq? (vector-ref modes index) expected)
                            (compare-modes (+ index 1)))))))
;;; Before the transfer starts, original cleanup is safe. Once attempted, retain
;;; the complete rooted pending/adopted graph and exact ticket for fatal exit.
;;; No forced busy-child retirement, rollback, implicit retry or second creator.
(define (cpu4-trained-g2-failure-cleanup! ledger generation)
  (if (eq? (vector-ref generation 0) 'training)
      (cpu4-resume-cleanup! ledger)
      (begin (display "CPU4-TRAINED-G2-PENDING ")
             (display (vector-ref generation 0)) (newline))))
(define (cpu4-trained-g2-release! generation)
  (cpu4-trained-g2-check "terminal output releases"
    (g3g-public-generation-output-release (vector-ref generation 6)))
  (vector-set! generation 6 #f)
  (cpu4-trained-g2-check "detached IDs release"
    (g3g-public-generation-tensor-release (vector-ref generation 7)))
  (vector-set! generation 7 #f)
  (cpu4-trained-g2-check "detached lengths release"
    (g3g-public-generation-tensor-release (vector-ref generation 8)))
  (vector-set! generation 8 #f)
  (cpu4-trained-g2-check "detached cache lengths release"
    (g3g-public-generation-tensor-release (vector-ref generation 9)))
  (vector-set! generation 9 #f)
  (cpu4-trained-g2-check "detached RNG release"
    (g3g-public-generation-rng-release (vector-ref generation 10)))
  (vector-set! generation 10 #f)
  (cpu4-trained-g2-check "public input release"
    (g3g-public-generation-tensor-release (vector-ref generation 4)))
  (vector-set! generation 4 #f)
  (cpu4-trained-g2-check "public generator closes"
    (g3g-public-generator-close (vector-ref (vector-ref generation 5) 1)))
  (vector-set! generation 0 'released))
(define (cpu4-trained-g2-generate! resolved tokenizer train-a train-b heldout factory b-record final-b generation)
  (let* ((mode (vector-ref generation 15))
         (child (cpu4-owned-row (vector-ref factory 14) 'cpu4-trained-g2))
         (handles (vector-ref child 13)) (model (vector-ref b-record 8)))
    (cpu4-trained-g2-check "final B is idle TRAIN after complete E3 finish/unbind"
      (and (eq? model (cpu4-owned-model-internal (vector-ref factory 14)))
           (eq? (vector-ref b-record 15) train-b)
           (cpu4-trained-g2-modes? b-record 'train)
           (not (vector-ref child 12)) (not (vector-ref factory 10))
           (not (vector-ref factory 11)) (null? (cpu4-checkpoint-native-current-region))))
    (vector-set! generation 13 model)
    (vector-set! generation 14 (cpu4-trained-g2-handles-copy handles))
    (vector-set! generation 12 (cpu4-trained-g2-counts))
    (vector-set! generation 2 (t1-wave1-tokenizer-byte resolved))
    (cpu4-trained-g2-check "distinct genuine generation T1 and retained T2"
      (and (not (eq? (vector-ref generation 2) tokenizer))
           (= (t2-wave2-tokenizer-vocab-size tokenizer) 256)))
    (vector-set! generation 3
      (t1-wave1-tokenizer-encode (vector-ref generation 2) (bytevector 3 197)))
    (vector-set! generation 4
      (g3c4-public-generation-input-create (vector-ref generation 3)))
    (vector-set! generation 0 'handoff)
    (vector-set! generation 5
      (cpu4-checkpoint-factory-generator-handoff-internal!
        (vector-ref factory 2) (vector-ref generation 2)
        (cpu4-trained-g2-config mode) (vector-ref generation 1)))
    (vector-set! generation 0 'adopted)
    (let* ((pair (vector-ref generation 5)) (generator (vector-ref pair 1))
           (row (cpu4-handoff-row (vector-ref (vector-ref generation 1) 0) 'cpu4-trained-g2))
           (entry (g3c4-generator-entry-call-ready generator 'cpu4-trained-g2))
           (before (vector-ref generation 12)) (after (cpu4-trained-g2-counts)))
      (cpu4-trained-g2-check "same exact B model/T1 public generator and adoption"
        (and (eq? (vector-ref pair 0) model) (eq? (vector-ref row 3) 'adopted)
             (eq? (vector-ref entry 5) (vector-ref row 7))
             (eq? (vector-ref entry 6) (vector-ref generation 2))
             (g3c4-public-g2-profile-live generator 'cpu4-trained-g2)))
      (cpu4-trained-g2-check "all original handles and final B values survive handoff"
        (and (cpu4-trained-g2-handles=? (vector-ref generation 14) handles)
             (cpu4-resume-values=? (vector-ref final-b 0) (cpu4-trained-g2-values handles))))
      (cpu4-trained-g2-check "only B optimizer and28 moments retire; original parameters survive"
        (and (= (vector-ref after 0) 0) (= (vector-ref after 2) 0)
             (= (vector-ref after 1) (- (vector-ref before 1) 1))
             (= (vector-ref after 3) (- (vector-ref before 3) 28))
             (= (vector-ref after 4) (- (vector-ref before 4) 28))
             (= (vector-ref after 5) (vector-ref before 5))))
      (display "CPU4-TRAINED-G2-HANDOFF ") (display mode)
      (display " 14 4768 1 28 28") (newline)
      (vector-set! generation 6 (g3g-public-generator-generate generator (vector-ref generation 4)))
      (vector-set! generation 7 (car (g3g-public-generation-output-ids (vector-ref generation 6))))
      (vector-set! generation 8 (g3g-public-generation-output-lengths (vector-ref generation 6)))
      (vector-set! generation 9 (g3g-public-generation-output-cache-lengths (vector-ref generation 6)))
      (vector-set! generation 11 (car (g3g-public-generation-output-text (vector-ref generation 6))))
      (vector-set! generation 10 (g3g-public-generation-output-rng (vector-ref generation 6)))
      (let* ((ids (g3c4-p2g2-typed-copy-private (vector-ref generation 7)))
             (lengths (g3c4-p2g2-typed-copy-private (vector-ref generation 8)))
             (caches (g3c4-p2g2-typed-copy-private (vector-ref generation 9)))
             (text (vector-ref generation 11))
             (count (if (eq? mode 'first-eos) 1 2))
             (snapshot (g3c4-public-g2-source-snapshot (vector-ref generation 6) 'cpu4-trained-g2))
             (rng (vector-ref (g3c4-registry-find (vector-ref generation 10) 'cpu4-trained-g2) 7)))
        (cpu4-trained-g2-check "frozen genuine typed IDs and length/cache"
          (and (= (bytevector-length ids) (* count 8))
               (= (g3c4-public-g2-word ids 0) 3)
               (or (= count 1) (= (g3c4-public-g2-word ids 8) 41))
               (= (g3c4-public-g2-word lengths 0) count)
               (= (g3c4-public-g2-word caches 0) (+ count 2))))
        (cpu4-trained-g2-check "frozen exact raw text bytes"
          (and (= (bytevector-length text) count) (= (bytevector-u8-ref text 0) 3)
               (or (= count 1) (= (bytevector-u8-ref text 1) 41))))
        (cpu4-trained-g2-check "actual detached RNG words equal genuine terminal snapshot"
          (and (= (vector-ref rng 1) (vector-ref snapshot 4))
               (= (vector-ref rng 2) (vector-ref snapshot 5))
               (= (vector-ref rng 3) (vector-ref snapshot 6))
               (= (vector-ref rng 4) (vector-ref snapshot 7))))
        (display "CPU4-TRAINED-G2-RESULT ") (display mode)
        (display " ") (display (cond ((eq? mode 'two-token) 255)
                                      ((eq? mode 'second-eos) 41)
                                      (else 3)))
        (display " ") (display (g3c4-public-g2-word lengths 0))
        (display " ") (display (g3c4-public-g2-word caches 0))
        (let emit-actual-ids ((index 0))
          (if (< index count)
              (begin (display " ") (display (g3c4-public-g2-word ids (* index 8)))
                     (emit-actual-ids (+ index 1)))))
        (let emit-actual-text ((index 0))
          (if (< index count)
              (begin (display " ") (display (bytevector-u8-ref text index))
                     (emit-actual-text (+ index 1))))) (newline)
        (display "CPU4-TRAINED-G2-RNG")
        (let emit-actual-rng ((index 1))
          (if (< index 5)
              (begin (display " ") (display (vector-ref rng index))
                     (emit-actual-rng (+ index 1))))) (newline))
      (cpu4-trained-g2-check "generation preserves all14 final B values and handles"
        (and (cpu4-trained-g2-handles=? (vector-ref generation 14) handles)
             (cpu4-resume-values=? (vector-ref final-b 0) (cpu4-trained-g2-values handles))))
      (cpu4-trained-g2-release! generation))))
(define (cpu4-trained-g2-finish! generation tokenizer train-a train-b heldout final-b)
  (let ((counts (cpu4-trained-g2-counts)))
    (cpu4-trained-g2-check "explicit public resources released; B original owners deliberately retained"
      (and (eq? (vector-ref generation 0) 'released)
           (not (vector-ref generation 4)) (not (vector-ref generation 6))
           (not (vector-ref generation 7)) (not (vector-ref generation 8))
           (not (vector-ref generation 9)) (not (vector-ref generation 10))
           (= (vector-ref counts 0) 0) (= (vector-ref counts 1) 0)
           (= (vector-ref counts 2) 0) (= (vector-ref counts 3) 0)
           (= (vector-ref counts 4) 28) (= (vector-ref counts 5) 14)))
    (cpu4-trained-g2-check "adopted B values/handles and model stay live after old factory retirement"
      (and (g3c4-model-entry-live (vector-ref generation 13) 'cpu4-trained-g2 #f)
           (cpu4-resume-values=? (vector-ref final-b 0)
             (cpu4-trained-g2-values (vector-ref generation 14)))))
    (cpu4-trained-g2-check "caller T2 and all three D2 shells survive"
      (and (= (t2-wave2-tokenizer-vocab-size tokenizer) 256)
           (cpu4-d2-cursor-capture-internal train-a)
           (cpu4-d2-cursor-capture-internal train-b)
           (cpu4-d2-cursor-capture-internal heldout)))
    (vector-set! generation 0 'done)
    (display "CPU4-TRAINED-G2-PASS ") (display (vector-ref generation 15))
    (display " ") (display cpu4-trained-g2-checks)
    (display " 375 14 28 0 0 retained-model-and-T1 partial-bytes=13424 census=NOT-RUN") (newline)))
