(load "m3_package_root.esk")
(load "m3_call_adapters.esk")
(load "g3t_model_admission_extension.esk")
(load "g3t_generator_constructor_extension.esk")
(load "g3t_prefill_sample_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3t_output_text_extension.esk")
(load "g3t_final_publication_extension.esk")
(load "g3t_manual_p1_extension.esk")
(load "g3t_manual_logits_materialize_extension.esk")
(load "g3m_prefill_p1_extension.esk")
(load "g3m_prefill_p2_extension.esk")
(load "g3m_manual_decode_extension.esk")
(load "g3m_seeded_p1_g1_extension.esk")
(load "g3r_committed_save_snapshot_extension.esk")

(extern i64 g3r-test-cache-length ptr :real et_g3t_test_cache_length_v1)
(extern i64 g3r-test-rng-word ptr i64 :real et_g3t_test_rng_word_v1)
(extern i64 g3r-test-output-word ptr i64 :real et_g3t_test_output_word_v1)
(extern ptr g3r-test-cache-borrow-begin ptr
        :real et_g3t_test_manual_cache_borrow_begin_v1)
(extern i64 g3r-test-cache-borrow-end ptr
        :real et_g3t_test_manual_cache_borrow_end_v1)
(extern i64 g3r-test-dispatch-fail-after i64
        :real et_g3t_test_manual_p2_fail_dispatch_after_v1)
(extern i64 g3r-native-call-acquire ptr i64
        :real et_g3t_private_call_acquire_v1)
(extern i64 g3r-native-call-abort ptr
        :real et_g3t_private_call_abort_v1)

(define checks 0)
(define (check label value)
  (if value (set! checks (+ checks 1))
      (begin (display "G3-R committed save aggregate FAIL: ")
             (display label) (newline) (exit 1))))
(define (all-sentinel? bytes)
  (let loop ((index 0))
    (if (= index (bytevector-length bytes)) #t
        (and (= (bytevector-u8-ref bytes index) 90)
             (loop (+ index 1))))))
(define (destination)
  (make-bytevector 136 90))
(define (record-word bytes index)
  (let loop ((part 7) (value 0))
    (if (< part 0)
        (if (>= value 9223372036854775808)
            (- value 18446744073709551616) value)
        (loop (- part 1)
              (+ (* value 256)
                 (bytevector-u8-ref bytes (+ (* index 8) part)))))))
(define (reject-unchanged label generator)
  (let ((bytes (destination)))
    (check label
      (and (guard (caught (#t (transformer-error? caught)))
             (g3r-committed-save-snapshot! generator bytes) #f)
           (all-sentinel? bytes)))))
(define (policy seed eos)
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos eos ':seed seed))
(define config
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define initial (g3t-checked-m3t-initializer-state 1729))
(define model
  (with-region ('g3r-save-model 65536)
    (g3t-checked-m3t-model-create config initial)))
(define tokenizer (t1-private-tokenizer-byte config))
(check "model in eval mode" (module-eval! model))

(define generator (g3t-generator-create model tokenizer (policy 1729 #f)))
(define entry (g3t-generator-find generator 'g3r-test))
(define native (vector-ref entry 3))
(reject-unchanged "no committed history rejected" generator)
(define input (g3t-generation-token-input-create 65))
(define output (g3m-generate-p1-g1! generator input))
(define output-native (vector-ref (g3t-prefill-entry output 'output 'g3r-test) 3))
(define sampled (g3r-test-output-word output-native 6))
(check "real sampled commit and A2 length"
       (and (>= sampled 0) (<= sampled 255)
            (= 2 (g3r-test-cache-length native))))
(define bytes (destination))
(define snapshot (g3r-committed-save-snapshot! generator bytes))
(check "real P1 generated partition"
       (and (vector? snapshot) (= (vector-length snapshot) 7)
            (= 1 (vector-ref snapshot 3))
            (= 1 (vector-ref snapshot 4))
            (= 0 (vector-ref snapshot 5))
            (= 0 (vector-ref snapshot 6))
            (= 2 (bytevector-length (vector-ref snapshot 2)))
            (= 65 (bytevector-u8-ref (vector-ref snapshot 2) 0))
            (= sampled (bytevector-u8-ref (vector-ref snapshot 2) 1))))
(check "policy and all RNG words from same owner"
       (and (= 1 (vector-ref (vector-ref snapshot 0) 0))
            (= -1 (vector-ref (vector-ref snapshot 0) 5))
            (let loop ((index 0))
              (if (= index 4) #t
                  (and (= (vector-ref (vector-ref snapshot 1) index)
                          (g3r-test-rng-word native index))
                       (loop (+ index 1)))))))
(check "original destination receives record after success"
       (and (not (all-sentinel? bytes))
            (= 136 (bytevector-length bytes))
            (= 65 (record-word bytes 10))
            (= sampled (record-word bytes 11))
            (= 2 (record-word bytes 12))
            (= (vector-ref snapshot 3) (record-word bytes 13))
            (= (vector-ref snapshot 4) (record-word bytes 14))
            (= (vector-ref snapshot 5) (record-word bytes 15))
            (= (vector-ref snapshot 6) (record-word bytes 16))
            (let loop ((index 0))
              (if (= index 6) #t
                  (and (= (vector-ref (vector-ref snapshot 0) index)
                          (record-word bytes index))
                       (loop (+ index 1)))))
            (let loop ((index 0))
              (if (= index 4) #t
                  (and (= (vector-ref (vector-ref snapshot 1) index)
                          (record-word bytes (+ 6 index)))
                       (loop (+ index 1)))))))
(check "detached output release" (g3t-output-release! output))
(check "snapshot survives detached output release"
       (= sampled (bytevector-u8-ref
                    (vector-ref (g3r-committed-save-snapshot!
                                  generator (destination)) 2) 1)))

(define lease (g3r-test-cache-borrow-begin native))
(check "held A2 read borrow acquired" (not (null? lease)))
(reject-unchanged "held A2 read borrow rejected" generator)
(check "held A2 read borrow released" (= 0 (g3r-test-cache-borrow-end lease)))
(check "snapshot after A2 borrow release"
       (= 2 (bytevector-length
              (vector-ref (g3r-committed-save-snapshot!
                            generator (destination)) 2))))
(check "native manual call acquired" (= 0 (g3r-native-call-acquire native 0)))
(reject-unchanged "busy native generator rejected" generator)
(check "native manual call aborted" (= 0 (g3r-native-call-abort native)))

(define saved-policy (vector-ref entry 7))
(define forged-policy (vector-copy saved-policy))
(vector-set! forged-policy 3 1)
(vector-set! entry 7 forged-policy)
(reject-unchanged "registered policy mismatch rejected after native copy" generator)
(vector-set! entry 7 saved-policy)
(define saved-tokenizer (vector-ref entry 6))
(vector-set! entry 6 (vector 'foreign-tokenizer))
(reject-unchanged "foreign tokenizer rejected" generator)
(vector-set! entry 6 saved-tokenizer)
(define foreign-model
  (with-region ('g3r-save-foreign-model 65536)
    (g3t-checked-m3t-model-create config initial)))
(check "second authentic model in eval mode" (module-eval! foreign-model))
(define saved-model-entry (vector-ref entry 5))
(vector-set! entry 5 (g3t-model-entry-live foreign-model 'g3r-test #f))
(reject-unchanged "different live model owner rejected" generator)
(vector-set! entry 5 saved-model-entry)
(reject-unchanged "forged generator rejected" (vector 'foreign-generator))
(reject-unchanged "wrong-kind model rejected" model)
(check "short destination rejected unchanged"
       (let ((short (make-bytevector 135 90)))
         (and (guard (caught (#t (transformer-error? caught)))
                (g3r-committed-save-snapshot! generator short) #f)
              (all-sentinel? short))))

(define partial (g3t-generator-create model tokenizer (policy 1729 #f)))
(define partial-input (g3t-generation-token-input-create 66))
(check "post-P1 G1 failure cut armed"
       (= 0 (g3r-test-dispatch-fail-after 21)))
(check "real post-prefill G1 failure injected"
       (guard (caught (#t (transformer-error? caught)))
         (g3m-generate-p1-g1! partial partial-input) #f))
(check "post-P1 G1 failure cut disarmed"
       (= 0 (g3r-test-dispatch-fail-after 9223372036854775807)))
(check "partial G1 retained native P1 cache"
       (= 1 (g3r-test-cache-length
              (vector-ref (g3t-generator-find partial 'g3r-test) 3))))
(reject-unchanged "idle post-P1 G1 abort rejected" partial)

(check "owners close"
       (and (g3t-generation-tensor-release! input)
            (g3t-generation-tensor-release! partial-input)
            (g3t-generator-close! partial)
            (g3t-generator-close! generator)))
(reject-unchanged "stale closed generator rejected" generator)
(check "detached snapshot survives owner close"
       (and (= sampled (bytevector-u8-ref (vector-ref snapshot 2) 1))
            (= 1 (vector-ref snapshot 4))))
(display "G3-R committed save aggregate PASS: checks=")
(display checks)
(newline)
