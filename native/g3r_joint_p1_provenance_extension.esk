;;; Source-private detached P1 provenance under the original G3/O2 joint hold.
;;; Load after G3-T, M3T, P1, the joint O2 adopter, and original binding.
;;; No aggregate loads this leaf yet: held-pin clone behavior still needs a
;;; compiled fixture before this may authorize a C2 claim.

(define g3r-joint-p1-provenance-tag (vector 'g3r-joint-p1-provenance-v1))
(define g3r-joint-p1-owner-witness-tag
  (vector 'g3r-joint-p1-owner-witness-v1))
(define g3r-joint-p1-provenance-registry '())

;;; A fresh private snapshot, not the mutable binding returned in the ledger.
;;; C2's validator makes a separate deep copy of all mutable control leaves.
(define (g3r-joint-p1-owner-witness-copy operation binding)
  (vector g3r-joint-p1-owner-witness-tag
          (vector-ref binding 1) (vector-ref binding 2)
          (vector-ref binding 3) (vector-ref binding 4)
          (vector-ref binding 5) (vector-ref binding 6)
          (vector-ref binding 7) (vector-ref binding 8)
          (c2-training-state-controls-copy operation (vector-ref binding 9))))

(define (g3r-joint-p1-owner-witness-match? witness binding)
  (and (vector? witness) (= (vector-length witness) 10)
       (eq? (vector-ref witness 0) g3r-joint-p1-owner-witness-tag)
       (vector? binding) (= (vector-length binding) 10)
       (eq? (vector-ref binding 0) g3r-joint-original-binding-tag)
       (let same ((index 1))
         (if (= index 9) #t
             (and (eq? (vector-ref witness index)
                       (vector-ref binding index))
                  (same (+ index 1)))))
       (equal? (vector-ref witness 9) (vector-ref binding 9))))

;;; The topology excludes the secondary tied path. The P1-owned clone must
;;; reproduce the fourteen canonical M3T parameters and the one tied alias.
(define (g3r-joint-p1-topology-check! state operation)
  (let* ((topology (state-dict-c2-parameter-topology-internal state operation))
         (paths (vector-ref topology 0))
         (shapes (vector-ref topology 1)))
    (if (not (equal? (vector-ref topology 2)
                     '((("head" "weight") ("token_embedding" "weight")))))
        (m3t-fail 'invalid-state operation "detached P1 tied alias differs"))
    (let check ((index 0) (remaining-paths paths) (remaining-shapes shapes))
      (if (= index 14)
          (if (or (not (null? remaining-paths))
                  (not (null? remaining-shapes)))
              (m3t-fail 'invalid-state operation
                        "detached P1 has extra parameters")
              topology)
          (if (or (null? remaining-paths) (null? remaining-shapes)
                  (not (equal? (car remaining-paths)
                               (vector-ref m3t-paths index)))
                  (not (equal? (car remaining-shapes)
                               (vector-ref m3t-shapes index))))
              (m3t-fail 'invalid-state operation
                        "detached P1 canonical parameter differs")
              (check (+ index 1) (cdr remaining-paths)
                     (cdr remaining-shapes)))))))

;;; Ledger: tag, exact original binding, exact detached P1 shell, topology,
;;; phase, first caught value. Its separate private owner witness, record and
;;; registry cell are allocated before cloning; enrollment is assignment-only.
;;; The returned ledger never exposes the witness or record.
;;; No original hold is owned by this ledger.
(define (g3r-joint-p1-provenance!
          generator model tokenizer optimizer-value o2-ledger controls)
  (let* ((operation 'g3r-joint-p1-provenance!)
         (binding (g3r-joint-original-binding-check!
                    generator model tokenizer optimizer-value o2-ledger
                    controls))
         (witness (g3r-joint-p1-owner-witness-copy operation binding))
         (ledger (vector g3r-joint-p1-provenance-tag binding #f #f
                         'prepared #f))
         (record (vector ledger witness #f 'prepared))
         (enrollment (cons record g3r-joint-p1-provenance-registry)))
    (guard (caught
             (#t
               (vector-set! ledger 5 caught)
               (if (vector-ref ledger 2)
                   ;; A released P1 shell may report a provider defect after
                   ;; tombstoning. Until compiled lifecycle evidence exists,
                   ;; any uncertain cleanup fails stop with the first error
                   ;; still rooted in this ledger.
                   (guard (release-error
                            (#t (g3r-held-o2-fail-stop)))
                     (state-dict-release! (vector-ref ledger 2))
                     (vector-set! ledger 2 #f)))
               (raise caught)))
      ;; The joint owner is checked before and after this provider-driven
      ;; clone. Store the returned shell immediately so every later failure
      ;; releases exactly the P1 clone, never either original owner hold.
      (vector-set! ledger 2 (module-state-dict model))
      (vector-set! ledger 4 'cloned)
      (vector-set! ledger 3
        (g3r-joint-p1-topology-check! (vector-ref ledger 2) operation))
      (let ((rechecked
              (g3r-joint-original-binding-check!
                generator model tokenizer optimizer-value o2-ledger controls)))
        (if (not (g3r-joint-p1-owner-witness-match? witness rechecked))
            (m3t-fail 'invalid-state operation
                      "original owner or controls changed during P1 clone")))
      (vector-set! ledger 4 'preclaim)
      (vector-set! record 2 (vector-ref ledger 2))
      (vector-set! record 3 'preclaim)
      (set! g3r-joint-p1-provenance-registry enrollment)
      ledger)))

(define (g3r-joint-p1-provenance-record ledger)
  (let find ((entries g3r-joint-p1-provenance-registry))
    (if (null? entries) #f
        (if (eq? (vector-ref (car entries) 0) ledger)
            (car entries)
            (find (cdr entries))))))

(define (g3r-joint-p1-provenance-live-record ledger)
  (let ((record (g3r-joint-p1-provenance-record ledger)))
    (if (and record (eq? (vector-ref record 3) 'preclaim)
             (vector-ref record 2))
        record
        #f)))

(define (g3r-joint-p1-provenance-owned-shell ledger operation)
  (let ((record (g3r-joint-p1-provenance-live-record ledger)))
    (if (or (not record)
            (not (eq? (vector-ref ledger 0) g3r-joint-p1-provenance-tag))
            (not (eq? (vector-ref ledger 4) 'preclaim))
            (not (g3r-joint-p1-owner-witness-match?
                   (vector-ref record 1) (vector-ref ledger 1)))
            (not (eq? (vector-ref record 2) (vector-ref ledger 2))))
        (m3t-fail 'invalid-state operation
                  "P1 shell or binding differs from its private record"))
    (vector-ref record 2)))

(define (g3r-joint-p1-provenance-check! ledger operation)
  (g3r-joint-p1-topology-check!
    (g3r-joint-p1-provenance-owned-shell ledger operation) operation)
  ledger)

(define (g3r-joint-p1-provenance-release! ledger)
  (let* ((operation 'g3r-joint-p1-provenance-release!)
         (record (g3r-joint-p1-provenance-live-record ledger)))
    (if (not record)
        (m3t-fail 'invalid-state operation
                  "no exact live P1 state remains for release"))
    ;; This helper owns only its detached P1 state. A provider failure may
    ;; occur after native tombstoning; do not infer that an exception left the
    ;; state live, and do not release the original joint hold here.
    (guard (release-error
             (#t
               (if (not (vector-ref ledger 5))
                   (vector-set! ledger 5 release-error))
               (g3r-held-o2-fail-stop)))
      (state-dict-release! (vector-ref record 2))
      (vector-set! ledger 2 #f)
      (vector-set! record 2 #f)
      (vector-set! record 3 'released)
      (vector-set! ledger 4 'released)
      #t)))
