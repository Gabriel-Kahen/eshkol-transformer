(define record (make-vector 22 #f))
(vector-set! record 2 'trainer)
(vector-set! record 11 (make-vector 14 'handle))
(vector-set! record 12 (make-vector 14 'carrier))
(vector-set! record 20 0)
(define parent (cpu4-checkpoint-parent 'trainer))
(vector-set! parent 8 controls)
(vector-set! (vector-ref parent 6) 0 (list->vector (map (lambda (i) (vector 'buffer 'owned-clone 'raw)) (iota 28))))
(for-each (lambda (cell) (vector-set! cell 0 (vector 'parameter 'owned-clone 'raw)))
          (vector->list (vector-ref parent 5)))
(define staged (vector (vector paths shapes aliases) (vector 'config paths aliases 0)))
(cpu4-checkpoint-prepare! record parent staged)
(check "staged controls before all busy participant plans"
       (equal? (take events 6) '(begin stage copy d2-prepare o2-prepare i2-create)))
(check "all14 genuine destinations appended" (= (count (lambda (x) (eq? x 'parameter)) events) 14))
(check "all preflights precede seal"
       (equal? (take-right events 5) '(p1 control-precommit d2-check o2-check i2-prepare)))
(check "moment ownership moves only to published plan"
       (and (not (vector-ref (vector-ref parent 6) 0)) (vector-ref (vector-ref parent 11) 0)))
(define (tr3-c-restore-i2-commit-tail-internal! i2) (event 'i2-commit))
(define (tr3-c-restore-o2-commit-tail-internal! o2) (event 'o2-commit))
(define (tr3-c-restore-o2-finalize-tail-internal! o2) (event 'o2-finalize))
(define (tr3-d2-restore-commit-internal! d2) (event 'd2-commit))
(define (cpu4-trainer-controls-restore-commit-internal! stage) (event 'controls-commit))
(define (tr3-c-restore-owned-release-tail-internal! carrier)
  (vector-set! carrier 2 '()) (event 'release))
(define (cpu4-trainer-control-end-internal! control)
  (vector-set! control 5 'closed) (event 'end))
(set! events '())
(cpu4-checkpoint-commit! parent)
(check "controls-last commit then child release then native parent end"
       (equal? events (append '(i2-commit o2-commit o2-finalize d2-commit controls-commit)
                              (make-list 14 'release) '(end))))
(check "parent closes and all14 clone authorities consumed"
       (and (eq? (vector-ref parent 3) 'dead) (not (vector-ref parent 13))
            (every (lambda (cell) (not (vector-ref cell 0)))
                   (vector->list (vector-ref parent 5)))))
(display "CPU4 checkpoint actual source host orchestration PASS: checks=")
(display checks) (newline)

;;; Before-publication failure keeps all28 moment stages in the envelope.
(define saved-o2-prepare tr3-c-restore-o2-prepare-internal)
(define fault (vector 'fault))
(define (failed-prepare after-publication?)
  (set! events '())
  (let ((p (cpu4-checkpoint-parent 'trainer)))
    (vector-set! p 8 controls)
    (vector-set! (vector-ref p 6) 0 (list->vector (map (lambda (i) (vector 'buffer 'owned-clone 'raw)) (iota 28))))
    (set! tr3-c-restore-o2-prepare-internal
      (lambda (request)
        (if after-publication? (saved-o2-prepare request))
        (raise fault)))
    (check "original failed prepare exception preserved"
      (guard (caught (#t (eq? caught fault)))
        (cpu4-checkpoint-prepare! record p staged) #f))
    (check "exact native plan publication determines stage custody"
      (if after-publication?
          (and (vector-ref (vector-ref p 11) 0)
               (not (vector-ref (vector-ref p 6) 0)))
          (and (not (vector-ref (vector-ref p 11) 0))
               (vector-ref (vector-ref p 6) 0))))
    p))
(define before-failure (failed-prepare #f))
(define after-failure (failed-prepare #t))
(set! tr3-c-restore-o2-prepare-internal saved-o2-prepare)
(for-each load-function '(cpu4-checkpoint-abort! cpu4-checkpoint-release-cell!
                         cpu4-checkpoint-access-clear?))
(define (tr3-c-restore-i2-abort-internal! i2)
  (vector-set! i2 5 'aborted) (event 'i2-abort))
(define (tr3-d2-restore-abort-internal! d2)
  (vector-set! d2 5 'aborted) (event 'd2-abort))
(define (tr3-c-restore-o2-abort-internal! o2)
  (vector-set! o2 7 'aborted) (event 'o2-abort))
(define (cpu4-trainer-controls-restore-abort-internal! stage)
  (vector-set! stage 4 'aborted) (event 'control-abort))
(for-each
  (lambda (p)
    (set! events '())
    (cpu4-checkpoint-abort! p)
    (check "all child custody drains before staged controls and native parent"
      (and (eq? (car events) 'd2-abort)
           (equal? (take-right events 2) '(control-abort end))
           (eq? (vector-ref p 3) 'dead)))
    (check "moment cleanup uses only the owner that actually published"
      (if (eq? p before-failure)
          (= 28 (count (lambda (x) (eq? x 'release)) events))
          (equal? (take events 2) '(d2-abort o2-abort)))))
  (list before-failure after-failure))

;;; Snapshot transfer must observe exact C2 child clearing even if composition
;;; raises after publication. Exercise the actual production snapshot function.
(for-each load-function '(cpu4-snapshot-transfer! cpu4-snapshot-abort!
                         cpu4-trainer-snapshot-internal))
(define cpu4-snapshot-envelopes (vector '()))
(for-each load-function '(cpu4-checkpoint-drain-pending! cpu4-snapshot-drain-pending!))
(define c2-training-state-compose-tag (vector 'c2-tag))
(define state-row #f)
(define (cpu4-trainer-idle-check-internal trainer operation) record)
(define (cpu4-trainer-controls-copy-internal control) controls)
(define (module-state-dict model) (event 'snapshot-p1) 'p1-owner)
(define (o2-public-optimizer-state optimizer) (event 'snapshot-o2) 'o2-owner)
(define (c2-training-state-find output) (and (eq? output 'c2-owner) state-row))
(define snapshot-fault-mode 'none)
(define (c2-training-state-compose-internal request)
  (if (eq? snapshot-fault-mode 'before) (raise fault))
  (set! state-row (vector 'c2-owner (vector-ref request 1) (vector-ref request 2)
                          #f #f #f #f 'live))
  (vector-set! request 1 #f)
  (vector-set! request 2 #f)
  (vector-set! request 5 'c2-owner)
  (event 'compose)
  (if (eq? snapshot-fault-mode 'after) (raise fault))
  request)
(define (state-dict-release! p1) (event 'release-p1))
(define (o2-public-optimizer-state-release! o2) (event 'release-o2))
(define (c2-training-state-release-internal! owner operation) (event 'release-c2))
(set! events '())
(define result (vector #f))
(check "snapshot publishes exact deep C2 owner after native parent end"
  (and (eq? (cpu4-trainer-snapshot-internal 'trainer result) 'c2-owner)
       (eq? (vector-ref result 0) 'c2-owner)
       (equal? events '(begin snapshot-p1 snapshot-o2 compose end))))
(for-each
  (lambda (mode)
    (set! snapshot-fault-mode mode)
    (set! events '())
    (let ((result (vector #f)))
      (check "snapshot dependency failure preserves original exception"
        (guard (caught (#t (eq? caught fault)))
          (cpu4-trainer-snapshot-internal 'trainer result) #f))
      (check "failed snapshot never publishes result"
        (not (vector-ref result 0)))
      (check "snapshot partial publication chooses exactly one release authority"
        (equal? events
          (if (eq? mode 'before)
              '(begin snapshot-p1 snapshot-o2 release-o2 release-p1 end)
              '(begin snapshot-p1 snapshot-o2 compose release-c2 end))))))
  '(before after))
(display "CPU4 checkpoint failure/publication host PASS: checks=")
(display checks) (newline)

