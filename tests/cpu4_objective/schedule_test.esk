(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_training_schedule_extension.esk")
(define checks 0)
(define (check label good)
 (if good (set! checks (+ checks 1))
     (begin (display "CPU4 binding FAIL: ") (display label) (newline) (exit 1))))
(define (reject label thunk)
 (check label (guard (caught (#t (transformer-error? caught))) (thunk) #f)))
(define-syntax diagnosed
 (syntax-rules ()
  ((_ label expression)
   (guard (caught
    (#t (display "CPU4 binding stage failed: ") (display label)
        (if (transformer-error? caught)
         (begin (display " category=") (display (transformer-error-category caught))
                (display " operation=") (display (transformer-error-operation caught))
                (display " message=") (display (transformer-error-message caught)))
         (display " foreign condition"))
        (newline) (exit 1))) expression))))
(define (config context seed)
 (x1-private-config-resolve
  (x1-private-config-parse
   (string-append "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":"
    (number->string context) ",\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":"
    (number->string seed) "}")) '()))
(define model (diagnosed "C4 construct" (g3c4-model-create-seeded-internal 1729)))
(define resolved (config 4 1729))
(reject "C2 config refused" (lambda () (cpu4-model-binding-create-internal model (config 2 1729))))
(reject "wrong original seed refused" (lambda () (cpu4-model-binding-create-internal model (config 4 1730))))
(reject "eval tree refused" (lambda () (cpu4-model-binding-create-internal model resolved)))
(module-train! model)
(define binding (diagnosed "binding create" (cpu4-model-binding-create-internal model resolved)))
(define record (cpu4-model-binding-check-internal binding))
(define lease (cpu4-model-binding-native-lease-internal binding))
(check "same canonical C4 model" (eq? model (cpu4-model-binding-model-internal binding)))
(check "canonical slot7 remains false" (eq? (vector-ref (vector-ref record 3) 7) #f))
(check "real17module capture" (= (vector-length (vector-ref record 9)) 17))
(check "real14handle capture" (= (vector-length (vector-ref record 10)) 14))
(let loop ((index 0))
 (if (= index 14) #t
  (let ((handle (vector-ref (vector-ref record 10) index))
        (carrier (vector-ref (vector-ref record 11) index)))
   (check "exactP1handle/nativeidentity" (eq? (cpu4-native-lease-identity lease index) handle))
   (check "samecanonicalnativeparameter" (eq? (cpu4-native-lease-parameter lease index) (vector-ref carrier 2)))
   (check "fullposition4shape" (equal? (parameter-handle-shape handle) (vector-ref g3c4-model-shapes index)))
   (loop (+ index 1)))))
(reject "foreign binding" (lambda () (cpu4-model-binding-check-internal (vector #f))))
(reject "duplicate canonical binding" (lambda () (cpu4-model-binding-create-internal model resolved)))
;;; Existing genuine P1 mode authority, all17nodes, no new mode API.
(define setup (vector (vector 'cpu4-mode-frame) #f))
(check "modebind" (= ((vector-ref p1-trusted-surface 64) model setup) 0))
(define modes (vector-ref setup 1))
(check "modeprepare" (= ((vector-ref p1-trusted-surface 65) modes) 0))
(check "modeenter" (= ((vector-ref p1-trusted-surface 66) modes) 0))
(reject "bindingcheck whileeval refused" (lambda () (cpu4-model-binding-check-internal binding)))
(check "moderestore" (= ((vector-ref p1-trusted-surface 67) modes) 0))
(check "canonical binding afterrealmoderestore" (eq? record (cpu4-model-binding-check-internal binding)))
(check "modeunbind" (= ((vector-ref p1-trusted-surface 68) modes) 0))
;;; A real N1/T4 byte-token D2 owner and checksummed cursor round trip.
(define args (command-line))
(define tokenizer (diagnosed "raw tokenizer" (t2-wave2-tokenizer-byte resolved)))
(check "real raw tokenizer vocabulary256" (= (t2-wave2-tokenizer-vocab-size tokenizer) 256))
(check "real raw tokenizer corpus identity"
 (string=? (t2-wave2-tokenizer-fingerprint tokenizer)
  "sha256:eshkol-byte-tokenizer-v1:aabb31f49216963582383a00fd2e85d7c20b658d5bef0e7945344ed6bfe50704"))
(define dataset (diagnosed "D2 open" (d2-token-dataset-open
 (list ':directory (car (cdr args)) ':batch-size 1 ':sequence-length 4
       ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
       ':maximum-total-tokens 65536 ':maximum-batch-bytes 68
       ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer)))
(define initial (diagnosed "initial cursor" (cpu4-d2-cursor-capture-internal dataset)))
(define checksums (make-vector 14 0))
(define (value-checksum index)
 (let* ((carrier (vector-ref (vector-ref record 11) index))
        (value (i2-native-borrow-checksum (vector-ref carrier 2)
          (i2-native-role carrier) (vector-ref carrier 3))))
  (if (< value 0) (i2-native-fail 'cpu4-value-checksum)) value))
(let capture ((index 0))
 (if (< index 14)
  (begin (vector-set! checksums index (value-checksum index)) (capture (+ index 1)))))
(define batch (d2-token-dataset-next-batch dataset))
(check "fourtokenbatch exists" (not (d2-token-dataset-end? batch)))
(reject "cursor withlivebatch refused" (lambda () (cpu4-d2-cursor-capture-internal dataset)))
(define observation (make-bytevector 12 0))
(reject "wrong contribution ordinal" (lambda () (cpu4-training-microbatch-internal! binding batch 1 observation)))
(check "failed contribution preserves observation" (= (cpu4-training-u32 observation 4) 0))
(let absent ((index 0))
 (if (< index 14)
  (begin (check "failed contribution absent gradients"
   (equal? (i2-parameter-gradient-metadata-internal (vector-ref (vector-ref record 11) index)) (vector 0 0)))
   (absent (+ index 1)))))
(diagnosed "actual Eshkol forward/objective/reverse/contribution"
 (cpu4-training-microbatch-internal! binding batch 0 observation))
(check "four active tokens weight" (= (cpu4-training-u32 observation 4) 1082130432))
(let verify ((index 0))
 (if (< index 14)
  (begin
   (check "same canonical values after contribution" (= (value-checksum index) (vector-ref checksums index)))
   (check "full fourteen native gradients contributed"
    (equal? (i2-parameter-gradient-metadata-internal (vector-ref (vector-ref record 11) index)) (vector 1 1)))
   (verify (+ index 1)))))
(check "actual P1/native binding preserved" (eq? record (cpu4-model-binding-check-internal binding)))
(d2-token-batch-release! batch)
(check "restorefourcursor" (cpu4-d2-cursor-restore-internal! dataset initial))
(check "exactencodedcursor restored" (d2-core-bytes=? initial (cpu4-d2-cursor-capture-internal dataset)))
(d2-token-dataset-close! dataset)
(check "release typedlease" (cpu4-model-binding-release-internal! binding))
(check "exactrelease repeat" (cpu4-model-binding-release-internal! binding))
(reject "released lease accessor refused" (lambda () (cpu4-model-binding-native-lease-internal binding)))
(module-eval! model)
(check "released canonicalmodel preserved" (eq? model (cpu4-model-binding-model-internal binding)))
(display "CPU4 genuine Eshkol training microbatch PASS: checks=") (display checks) (newline)
