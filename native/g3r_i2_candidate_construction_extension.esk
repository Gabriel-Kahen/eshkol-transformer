;;; Feature-local I2 candidate construction owner. Load after i2_wave2_root,
;;; g3r_p1_candidate_construction_extension, and the G3-C4 P1 prepared split.
;;; No ordinary I2/P1 package or caller-owned graph imports this source.

;;; Cell: state, exact I2 record, preallocated P1 candidate cell, sealed count.
;;; Private sidecar: cell, record, P1 cell, state, prior head/count, member
;;; snapshot, root, P1 identity, root member, sealed list head, member count,
;;; construction anchor.
(define i2-candidate-registry-root (vector '()))

(define (i2-candidate-fail operation message)
  (i2-fail 'invalid-state operation message))

(define (i2-candidate-sidecar cell operation)
  (let find ((remaining (vector-ref i2-candidate-registry-root 0)))
    (cond ((null? remaining)
           (i2-fail 'invalid-argument operation "foreign I2 candidate cell"))
          ((eq? cell (vector-ref (car remaining) 0)) (car remaining))
          (else (find (cdr remaining))))))

(define (i2-candidate-cell-check! sidecar expected operation)
  (let ((cell (vector-ref sidecar 0))
        (record (vector-ref sidecar 1))
        (p1-cell (vector-ref sidecar 2)))
    (if (or (not (vector? cell)) (not (= (vector-length cell) 4))
            (not (eq? (vector-ref sidecar 3) expected))
            (not (eq? (vector-ref cell 0) expected))
            (not (eq? (vector-ref cell 1) record))
            (not (eq? (vector-ref cell 2) p1-cell))
            (not (eq? (i2-construction-record record operation) record))
            (not (eq? (vector-ref record 2) (vector-ref sidecar 7)))
            (not (eq? (vector-ref p1-cell 1) (vector-ref sidecar 8)))
            (not (eq? (vector-ref p1-cell 2) (vector-ref sidecar 7)))
            (not (eq? (vector-ref record 0) 'i2-construction))
            (not (eq? (vector-ref record 9) 'm3t))
            (vector-ref record 10))
        (i2-candidate-fail operation "candidate I2/P1 identity changed"))
    (if (eq? expected 'sealed)
        (if (or (not (integer? (vector-ref cell 3)))
                (not (= (vector-ref cell 3) (vector-ref sidecar 11)))
                (not (eq? (vector-ref p1-cell 0) 'sealed)))
            (i2-candidate-fail operation "sealed candidate cell changed"))
        (if (or (vector-ref cell 3)
                (not (eq? (vector-ref p1-cell 0) 'open))
                (vector-ref p1-cell 3)
                (not (eq? (vector-ref record 1) (vector-ref sidecar 8))))
            (i2-candidate-fail operation "open candidate cell changed")))
    record))

(define (i2-candidate-member-prefix! sidecar head roster sealed? operation)
  (let loop ((current head) (members roster)
             (snapshot (vector-ref sidecar 6)) (count 0))
    (cond
      ((and (eq? current (vector-ref sidecar 4)) (null? members))
       (if (and (or (not snapshot) (null? snapshot))
                (> count 0)
                (or (not (vector-ref sidecar 11))
                    (= count (vector-ref sidecar 11))))
           count
           (i2-candidate-fail operation "candidate member count changed")))
      ((or (>= count 4096) (not (pair? current))
           (not (pair? members))
           (and sealed?
                (or (not (vector? (car members)))
                    (not (= (vector-length (car members)) 2))))
           (not (eq? (car current)
                     (if sealed? (vector-ref (car members) 0)
                         (car members)))))
       (i2-candidate-fail operation "candidate membership prefix changed"))
      (else
        (let ((member (if sealed? (vector-ref (car members) 0)
                          (car members))))
          (if (or (not (vector? member))
                  (not (= (vector-length member) 1))
                  (not (vector-ref member 0))
                  (and (null? (cdr members))
                       (not (eq? member (vector-ref sidecar 9))))
                  (and snapshot
                       (or (not (pair? snapshot))
                           (not (eq? member (vector-ref (car snapshot) 0)))
                           (not (eq? (vector-ref member 0)
                                     (vector-ref (car snapshot) 1))))))
              (i2-candidate-fail operation "candidate member identity changed"))
          (loop (cdr current) (cdr members)
                (if snapshot (cdr snapshot) #f) (+ count 1)))))))

(define (i2-candidate-stage-members! sidecar record count)
  (let stage ((remaining (vector-ref record 4)) (snapshot '()))
    (if (null? remaining)
        (begin
          (vector-set! sidecar 6 (i2-reverse snapshot))
          (vector-set! sidecar 11 count)
          #t)
        (let ((member (car remaining)))
          (stage (cdr remaining)
                 (cons (vector member (vector-ref member 0)) snapshot))))))

(define (i2-candidate-stage-head! sidecar count operation)
  ;; Publish the exact I2 list head to the rooted sidecar before P1's
  ;; irreversible native seal. This may promote the list and may raise.
  (vector-set! sidecar 10 (i2-modules-current))
  (if (or (not (eq? (vector-ref sidecar 10) (i2-modules-current)))
          (not (= count (vector-ref sidecar 11)))
          (not (= i2-module-count (+ (vector-ref sidecar 5) count))))
      (i2-candidate-fail operation "candidate staged head changed"))
  (i2-candidate-member-prefix!
    sidecar (vector-ref sidecar 10) (vector-ref (vector-ref sidecar 1) 4)
    #f operation)
  #t)

(define (i2-candidate-active-check! sidecar expected operation)
  (let* ((record (i2-candidate-cell-check! sidecar expected operation))
         (state (vector-ref record 3)))
    (if (or (not (eq? state expected))
            (not (eq? record (vector-ref i2-construction-registry-root 1)))
            i2-parameter-admission-carrier
            (not (eq? (vector-ref record 6) (vector-ref sidecar 4)))
            (not (integer? (vector-ref record 7)))
            (not (= (vector-ref record 7) (vector-ref sidecar 5)))
            (not (eq? (vector-ref record 8) (vector-ref sidecar 12))))
        (i2-candidate-fail operation "candidate construction is closed or changed"))
    (let ((count
            (i2-candidate-member-prefix!
              sidecar (i2-modules-current) (vector-ref record 4) #f
              operation)))
      (if (not (= i2-module-count (+ (vector-ref sidecar 5) count)))
          (i2-candidate-fail operation "candidate module count changed"))
      (i2-construction-retained-preflight! record operation)
      (vector record count))))

(define (i2-candidate-mark-dead! sidecar)
  (let ((cell (vector-ref sidecar 0))
        (p1-cell (vector-ref sidecar 2)))
    (vector-set! sidecar 3 'dead)
    (vector-set! sidecar 6 #f)
    (vector-set! sidecar 10 #f)
    (vector-set! sidecar 11 #f)
    (vector-set! sidecar 12 #f)
    (vector-set! cell 0 'dead)
    (vector-set! cell 1 #f)
    (vector-set! cell 3 #f)
    (if (not (eq? (vector-ref p1-cell 0) 'dead))
        (begin
          (vector-set! p1-cell 0 'dead)
          (vector-set! p1-cell 1 #f)
          (vector-set! p1-cell 2 #f)
          (vector-set! p1-cell 3 #f)))
    #t))

(define (i2-candidate-construction-begin-internal! cell)
  (let ((operation 'i2-candidate-construction-begin-internal!))
    (if (or (not (vector? cell)) (not (= (vector-length cell) 4))
            (vector-ref cell 0) (vector-ref cell 1) (vector-ref cell 3)
            (not (vector? (vector-ref cell 2)))
            (not (= (vector-length (vector-ref cell 2)) 4))
            (vector-ref (vector-ref cell 2) 0)
            (vector-ref (vector-ref cell 2) 1)
            (vector-ref (vector-ref cell 2) 2)
            (vector-ref (vector-ref cell 2) 3))
        (i2-fail 'invalid-argument operation "expected fresh I2/P1 candidate cells"))
    (if (= (i2-native-construction-parameter-preflight '() '()) -1)
        (i2-fail 'unsupported operation "M3T construction bridge is unavailable"))
    (if (or (vector-ref i2-construction-registry-root 1)
            (>= i2-module-count 4096))
        (i2-candidate-fail operation "I2 construction is busy or full"))
    (let* ((membership (vector #f))
           (p1-cell (vector-ref cell 2))
           (record (vector 'i2-construction #f #f 'aborted
                           (list membership) '() (i2-modules-current)
                           i2-module-count
                           (i2-carrier 'parameter '() 'parameter) 'm3t #f))
           (sidecar (vector cell record p1-cell 'aborted
                            (i2-modules-current) i2-module-count #f #f #f
                            membership #f #f (vector-ref record 8)))
           (next-records
             (cons record (vector-ref i2-construction-registry-root 0)))
           (next-candidates
             (cons sidecar (vector-ref i2-candidate-registry-root 0))))
      ;; Both private roots and the first I2 member precede P1 token creation.
      (vector-set! i2-construction-registry-root 0 next-records)
      (vector-set! i2-candidate-registry-root 0 next-candidates)
      (let* ((canonical (car (vector-ref i2-construction-registry-root 0)))
             (owner (car (vector-ref i2-candidate-registry-root 0)))
             (root-member (car (vector-ref canonical 4))))
        (guard (caught
                 (#t
                   ;; P1 publishes its identity into this rooted cell before
                   ;; returning. I2's record slot can still be unset if its
                   ;; later write barrier fails, so recover from P1's cell.
                   (if (vector-ref p1-cell 1)
                       (module-construction-abort-internal!
                         (vector-ref p1-cell 1)))
                   (i2-construction-rollback-tail! canonical)
                   (i2-candidate-mark-dead! owner)
                   (raise caught)))
          (vector-set! i2-module-registry-root 0
                       (cons root-member (vector-ref owner 4)))
          (set! i2-module-count (+ (vector-ref owner 5) 1))
          (vector-set! i2-construction-registry-root 1 canonical)
          (let ((construction
                  (module-candidate-construction-begin-internal
                    i2-provider-name p1-cell)))
            (vector-set! canonical 1 construction)
            (vector-set! owner 8 construction)
            (let ((root (module-construction-root-internal construction)))
              (vector-set! canonical 2 root)
              (vector-set! root-member 0 root)
              (vector-set! owner 7 root)
              (vector-set! canonical 3 'open)
              (vector-set! owner 3 'open)
              (vector-set! cell 1 canonical)
              (vector-set! cell 0 'open)
              canonical)))))))

(define (i2-candidate-construction-abort-internal! cell)
  (let* ((operation 'i2-candidate-construction-abort-internal!)
         (sidecar (i2-candidate-sidecar cell operation)))
    (if (eq? (vector-ref sidecar 3) 'dead)
        #t
        (begin
          (if (eq? (vector-ref sidecar 3) 'sealed)
              (i2-candidate-fail operation "candidate construction is sealed"))
          (i2-candidate-active-check! sidecar (vector-ref sidecar 3) operation)
          (module-construction-abort-internal! (vector-ref sidecar 8))
          (i2-construction-rollback-tail! (vector-ref sidecar 1))
          (i2-candidate-mark-dead! sidecar)))))

(define (i2-candidate-construction-seal-internal! cell)
  (let* ((operation 'i2-candidate-construction-seal-internal!)
         (sidecar (i2-candidate-sidecar cell operation))
         (checked (i2-candidate-active-check! sidecar 'open operation))
         (record (vector-ref checked 0))
         (count (vector-ref checked 1)))
    (i2-candidate-stage-members! sidecar record count)
    (i2-candidate-stage-head! sidecar count operation)
    (let ((root (module-construction-seal-internal! (vector-ref sidecar 8))))
      ;; The native P1 seal is complete. This is an assignment-only tail.
      (vector-set! record 1 #f)
      (vector-set! record 3 'sealed)
      (vector-set! record 4 '())
      (vector-set! record 5 '())
      (vector-set! record 6 '())
      (vector-set! record 7 0)
      (vector-set! record 8 #f)
      (vector-set! record 10 #f)
      (vector-set! i2-construction-registry-root 1 #f)
      (vector-set! sidecar 3 'sealed)
      (vector-set! cell 3 count)
      (vector-set! cell 0 'sealed)
      root)))

(define (i2-candidate-construction-prepare-eval-internal! cell)
  (let* ((operation 'i2-candidate-construction-prepare-eval-internal!)
         (sidecar (i2-candidate-sidecar cell operation))
         (checked (i2-candidate-active-check! sidecar 'open operation))
         (record (vector-ref checked 0)))
    (i2-candidate-stage-members! sidecar record (vector-ref checked 1))
    (guard (caught
             (#t
               ;; P1's guarded prepare has already aborted its own scope.
               (i2-construction-rollback-tail! record)
               (i2-candidate-mark-dead! sidecar)
               (raise caught)))
      (let ((root (module-construction-prepare-eval-internal!
                    (vector-ref sidecar 8))))
        (vector-set! record 3 'prepared)
        (vector-set! sidecar 3 'prepared)
        (vector-set! cell 0 'prepared)
        root))))

(define (i2-candidate-construction-seal-prepared-internal! cell)
  (let* ((operation 'i2-candidate-construction-seal-prepared-internal!)
         (sidecar (i2-candidate-sidecar cell operation))
         (checked (i2-candidate-active-check! sidecar 'prepared operation))
         (record (vector-ref checked 0))
         (count (vector-ref checked 1)))
    ;; P1's prepared commit rejects before native mutation or fails stop.
    (i2-candidate-stage-head! sidecar count operation)
    (let ((root (module-construction-seal-prepared-internal!
                  (vector-ref sidecar 8))))
      ;; The native P1 commit is complete. This is an assignment-only tail.
      (vector-set! record 1 #f)
      (vector-set! record 3 'sealed)
      (vector-set! record 4 '())
      (vector-set! record 5 '())
      (vector-set! record 6 '())
      (vector-set! record 7 0)
      (vector-set! record 8 #f)
      (vector-set! record 10 #f)
      (vector-set! i2-construction-registry-root 1 #f)
      (vector-set! sidecar 3 'sealed)
      (vector-set! cell 3 count)
      (vector-set! cell 0 'sealed)
      root)))

(define (i2-candidate-construction-preflight-internal! cell)
  (let* ((operation 'i2-candidate-construction-preflight-internal!)
         (sidecar (i2-candidate-sidecar cell operation))
         (record (i2-candidate-cell-check! sidecar 'sealed operation)))
    (if (or (not (eq? (vector-ref record 3) 'sealed))
            (vector-ref i2-construction-registry-root 1)
            (vector-ref record 1)
            (not (null? (vector-ref record 4)))
            (not (null? (vector-ref record 5)))
            (not (null? (vector-ref record 6)))
            (vector-ref record 8))
        (i2-candidate-fail operation "sealed I2 rollback authority changed"))
    (let find ((remaining (i2-modules-current)) (steps 0))
      (cond ((eq? remaining (vector-ref sidecar 10)) #t)
            ((or (not (pair? remaining)) (>= steps 4096))
             (i2-candidate-fail operation "candidate module chain changed"))
            (else (find (cdr remaining) (+ steps 1)))))
    (i2-candidate-member-prefix!
      sidecar (vector-ref sidecar 10) (vector-ref sidecar 6) #t operation)
    (module-candidate-construction-preflight-internal!
      (vector-ref sidecar 2))
    #t))
