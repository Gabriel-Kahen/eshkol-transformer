;;; Private one-root proof of genuine postcreation T1 retirement.
;;; Never load beside an installed G3-G package or expose this route publicly.
(load "g3g_manual_package_root.esk")
(extern i64 test-t1-release ptr
        :real et_t1_i64_shell_test_release_sealed_v1)
(extern i64 test-t1-live-count
        :real et_t1_i64_shell_test_live_count_v1)

(define checks 0)
(define (check label truth)
  (if truth (set! checks (+ checks 1))
      (begin (display "private T1 release FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label category operation thunk)
  (check label
    (guard (caught
             (#t (and (transformer-error? caught)
                      (eq? (transformer-error-category caught) category)
                      (eq? (transformer-error-operation caught) operation))))
      (thunk) #f)))
(define (t1-test-reverse values)
  (let loop ((rest values) (result '()))
    (if (null? rest) result
        (loop (cdr rest) (cons (car rest) result)))))
(define (t1-test-list-length values)
  (let loop ((rest values) (count 0))
    (if (null? rest) count (loop (cdr rest) (+ count 1)))))

;;; Construct the complete replacement list before touching the native owner.
;;; A missing or duplicated Eshkol admission cannot reach the native hook.
(define (retire-authentic-t1! encoded)
  (let ((old t1-wave1-tensor-registry))
    (let scan ((remaining old) (kept '()) (matches 0))
      (if (null? remaining)
          (if (= matches 1)
              (let ((prepared (t1-test-reverse kept)))
                (if (= (test-t1-release encoded) 0)
                    (begin (set! t1-wave1-tensor-registry prepared) #t)
                    #f))
              #f)
          (if (eq? (vector-ref (car remaining) 0) encoded)
              (scan (cdr remaining) kept (+ matches 1))
              (scan (cdr remaining) (cons (car remaining) kept) matches))))))

(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-public-model-create-seeded 1729))
(define encoded (t1-wave1-tokenizer-encode tokenizer (bytevector 0 255)))
(define input (g3c4-public-generation-input-create encoded))
(define (policy eos)
  (list ':profile 'diagnostic-c4-p2g2 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256
        ':top-p-bits 1065353216 ':max-new-tokens 2
        ':eos eos ':seed 41))

;;; Probe before retirement to select genuine EOS and non-EOS branches.
(define (first-id)
  (let ((probe (g3g-public-generator-create model tokenizer (policy 0)))
        (selected -1))
    (g3c4-with-p2g2-prefix-call 'private-t1-retire-first-reference
      probe input (call)
      (g3c4-p2g2-protected-reserve call)
      (set! selected (g3c4-p2g2-prefix-commit! call input))
      (g3c4-p2g2-protected-abort! call))
    (check "genuine first ID is a byte"
      (and (<= 0 selected) (<= selected 255)))
    (check "probe closes" (g3g-public-generator-close probe))
    selected))
(define selected-first (first-id))

;;; Exactly one Eshkol admission reaches native preflight and is refused.
;;; The sealed length-one shell is intentionally retained until process exit.
(define wrong-length (t1-shell-create 1))
(check "wrong-length shell created" (not (null? wrong-length)))
(check "wrong-length shell written" (= (t1-shell-write wrong-length 0 7) 0))
(check "wrong-length shell sealed" (= (t1-shell-seal wrong-length) 0))
(define saved-registry t1-wave1-tensor-registry)
(set! t1-wave1-tensor-registry (cons (vector wrong-length) '()))
(define wrong-registry t1-wave1-tensor-registry)
(define wrong-native (test-t1-live-count))
(check "registered sealed wrong-length reaches native refusal"
  (and (= (t1-test-list-length wrong-registry) 1)
       (eq? (vector-ref (car wrong-registry) 0) wrong-length)
       (not (retire-authentic-t1! wrong-length))
       (= (t1-shell-last-status) 2)))
(check "native refusal preserves singleton registry identity and owner"
  (and (eq? t1-wave1-tensor-registry wrong-registry)
       (= (t1-test-list-length t1-wave1-tensor-registry) 1)
       (eq? (vector-ref (car t1-wave1-tensor-registry) 0) wrong-length)
       (= (test-t1-live-count) wrong-native)
       (= (t1-shell-length wrong-length) 1)))
(set! t1-wave1-tensor-registry saved-registry)

(define before-native (test-t1-live-count))
(define before-aggregate (t1-test-list-length t1-wave1-tensor-registry))
(check "absent admission refuses without native cleanup"
  (not (retire-authentic-t1! (vector 'foreign-t1))))
(check "absent admission preserved native and aggregate"
  (and (= (test-t1-live-count) before-native)
       (= (t1-test-list-length t1-wave1-tensor-registry) before-aggregate)))
(define authentic-registry t1-wave1-tensor-registry)
(set! t1-wave1-tensor-registry
      (cons (vector encoded) authentic-registry))
(check "duplicate admission refuses without native cleanup"
  (not (retire-authentic-t1! encoded)))
(check "duplicate admission preserved both entries and native owner"
  (and (= (test-t1-live-count) before-native)
       (= (t1-test-list-length t1-wave1-tensor-registry)
          (+ before-aggregate 1))))
(set! t1-wave1-tensor-registry authentic-registry)
(check "genuine sealed T1 retirement" (retire-authentic-t1! encoded))
(check "exact native and Eshkol removal"
  (and (= (test-t1-live-count) (- before-native 1))
       (= (t1-test-list-length t1-wave1-tensor-registry)
          (- before-aggregate 1))
       (not (t1-wave1-tensor-admitted? encoded))))
(check "native stale length refuses"
  (and (= (t1-shell-length encoded) -1)
       (= (t1-shell-last-status) 1)))
(check "native stale read refuses"
  (and (= (t1-shell-read encoded 0) -9223372036854775808)
       (= (t1-shell-last-status) 1)))
(check "native repeated release refuses" (= (test-t1-release encoded) 1))
(reject "public decode refuses retired source" 'invalid-argument
        'tokenizer-decode
        (lambda () (t1-wave1-tokenizer-decode tokenizer encoded)))
(reject "new C4 input refuses retired source" 'invalid-argument
        'generation-c4-input-create
        (lambda () (g3c4-public-generation-input-create encoded)))
(define successor (t1-wave1-tokenizer-encode tokenizer (bytevector 3 4)))
(check "new T1 cannot reuse retired address"
  (and (not (eq? successor encoded))
       (= (t1-shell-length encoded) -1)
       (= (t1-shell-last-status) 1)))

(define (check-branch eos expected-count expected-cache)
  (let* ((generator (g3g-public-generator-create model tokenizer (policy eos)))
         (output (g3g-public-generator-generate generator input))
         (text (car (g3g-public-generation-output-text output)))
         (terminal (g3c4-p2g2-terminal-snapshot-private output))
         (history (g3c4-public-p2g2-history-capture-internal!
                    generator input output))
         (descriptor (g3c4-public-p2g2-history-admit-once-internal!
                       history generator input output)))
    (check "retired T1 original IDs retained by C4"
      (and (= (vector-ref descriptor 0) 0)
           (= (vector-ref descriptor 1) 255)))
    (check "generated IDs, EOS, count, cache match terminal"
      (and (= (vector-ref descriptor 2) selected-first)
           (= (vector-ref descriptor 2) (vector-ref terminal 0))
           (= (vector-ref descriptor 3) (vector-ref terminal 1))
           (= (vector-ref descriptor 4) expected-count)
           (= (vector-ref descriptor 5) expected-cache)
           (= (vector-ref descriptor 10) eos)
           (= (bytevector-length text) expected-count)
           (= (bytevector-u8-ref text 0) selected-first)))
    (check "all four terminal RNG words match"
      (let loop ((index 0))
        (if (= index 4) #t
            (and (= (vector-ref descriptor (+ 6 index))
                    (vector-ref terminal (+ 4 index)))
                 (loop (+ index 1))))))
    (reject "history admits exactly once" 'invalid-state
            'g3c4-public-p2g2-history
            (lambda ()
              (g3c4-public-p2g2-history-admit-once-internal!
                history generator input output)))
    (check "C4 output and generator release independently"
      (and (g3g-public-generation-output-release output)
           (g3g-public-generator-close generator)))))

(check-branch selected-first 1 3)
(check-branch (if (= selected-first 255) 0 255) 2 4)
(check "C4 input release after both histories"
  (g3g-public-generation-tensor-release input))
(display "G3G-MANUAL-PRIVATE-T1-RETIRE-PASS: checks=")
(display checks) (newline)
