;;; Lease-aware outer wrappers for the eventual TR3 public facade.  The raw
;;; component spellings remain lexical and are called only after this gate.

(define (tr3-public-record-for-module value)
  (let records ((remaining (vector-ref tr3-trainers 0)))
    (if (null? remaining) #f
        (let modules ((index 0))
          (cond ((= index 17) (records (cdr remaining)))
                ((eq? value (vector-ref (vector-ref (car remaining) 10) index))
                 (car remaining))
                (else (modules (+ index 1))))))))

(define (tr3-public-record-for-model-entry entry)
  (let loop ((remaining (vector-ref tr3-trainers 0)))
    (cond ((null? remaining) #f)
          ((eq? entry (vector-ref (car remaining) 9)) (car remaining))
          (else (loop (cdr remaining))))))

(define (tr3-public-record-for-optimizer value)
  (let loop ((remaining (vector-ref tr3-trainers 0)))
    (cond ((null? remaining) #f)
          ((eq? value (vector-ref (car remaining) 13)) (car remaining))
          (else (loop (cdr remaining))))))

(define (tr3-public-record-for-dataset value)
  (let loop ((remaining (vector-ref tr3-trainers 0)))
    (cond ((null? remaining) #f)
          ((eq? value (vector-ref (car remaining) 15)) (car remaining))
          (else (loop (cdr remaining))))))

(define (tr3-public-reject-if-leased record operation)
  (if record
      (m3t-fail 'invalid-state operation
                "component mutation is owned by an enrolled trainer"))
  #t)

(define (tr3-public-gate-module value operation)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-module value) operation))

(define (tr3-public-gate-model value operation)
  (let ((entry (m3t-find value)))
    (if entry
        (tr3-public-reject-if-leased
          (tr3-public-record-for-model-entry
            (if (eq? (vector-ref entry 1) 'model)
                entry (vector-ref entry 4)))
          operation)))
  #t)

(define (tr3-public-gate-workspace value operation)
  (let ((entry (m3t-find value)))
    (if (and entry (eq? (vector-ref entry 1) 'workspace))
        (tr3-public-reject-if-leased
          (tr3-public-record-for-model-entry (vector-ref entry 4)) operation)))
  #t)

(define (tr3-public-module-load-state-dict! module state)
  (tr3-public-gate-module module 'module-load-state-dict!)
  (module-load-state-dict! module state))
(define (tr3-public-module-train! module)
  (tr3-public-gate-module module 'module-train!)
  (module-train! module))
(define (tr3-public-module-eval! module)
  (tr3-public-gate-module module 'module-eval!)
  (module-eval! module))
(define (tr3-public-module-zero-grad! module)
  (tr3-public-gate-module module 'module-zero-grad!)
  (module-zero-grad! module))

(define (tr3-public-model-forward model input options)
  (tr3-public-gate-model model 'model-forward)
  (m3-public-model-forward model input options))
(define (tr3-public-model-output-logits value)
  (tr3-public-gate-model value 'model-output-logits)
  (m3-public-model-output-logits value))
(define (tr3-public-model-output-loss value)
  (tr3-public-gate-model value 'model-output-loss)
  (m3-public-model-output-loss value))
(define (tr3-public-model-output-rng value)
  (tr3-public-gate-model value 'model-output-rng)
  (m3-public-model-output-rng value))
(define (tr3-public-model-output-release! value)
  (tr3-public-gate-model value 'model-output-release!)
  (m3-public-model-output-release! value))
(define (tr3-public-diagnostic-model-logits-bits value)
  (tr3-public-gate-model value 'diagnostic-model-logits-bits)
  (m3-public-diagnostic-model-logits-bits value))
(define (tr3-public-diagnostic-model-logits-release! value)
  (tr3-public-gate-model value 'diagnostic-model-logits-release!)
  (m3-public-diagnostic-model-logits-release! value))
(define (tr3-public-diagnostic-output-vjp! value seed weight ordinal)
  (tr3-public-gate-model value 'diagnostic-output-vjp!)
  (m3-public-diagnostic-output-vjp! value seed weight ordinal))

(define (tr3-public-workspace-create model)
  (tr3-public-gate-model model 'diagnostic-workspace-create)
  (m3t-public-workspace-create model))
(define (tr3-public-workspace-begin! workspace input)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-begin!)
  (m3t-public-workspace-begin! workspace input))
(define (tr3-public-workspace-vjp-begin! workspace logits)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-vjp-begin!)
  (m3t-public-workspace-vjp-begin! workspace logits))
(define (tr3-public-workspace-copy-logits! workspace logits)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-copy-logits!)
  (m3t-public-workspace-copy-logits! workspace logits))
(define (tr3-public-workspace-check-primals workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-check-primals)
  (m3t-public-workspace-check-primals workspace))
(define (tr3-public-workspace-reset! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-reset!)
  (m3t-public-workspace-reset! workspace))
(define (tr3-public-workspace-release! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-workspace-release!)
  (m3t-public-workspace-release! workspace))

(define (tr3-public-embedding! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-embedding!)
  (m3t-public-embedding! workspace selector))
(define (tr3-public-embedding-vjp! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-embedding-vjp!)
  (m3t-public-embedding-vjp! workspace selector))
(define (tr3-public-linear! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-linear!)
  (m3t-public-linear! workspace selector))
(define (tr3-public-linear-vjp! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-linear-vjp!)
  (m3t-public-linear-vjp! workspace selector))
(define (tr3-public-layer-norm! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-layer-norm!)
  (m3t-public-layer-norm! workspace selector))
(define (tr3-public-layer-norm-vjp! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-layer-norm-vjp!)
  (m3t-public-layer-norm-vjp! workspace selector))
(define (tr3-public-gelu! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-gelu!)
  (m3t-public-gelu! workspace))
(define (tr3-public-gelu-vjp! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-gelu-vjp!)
  (m3t-public-gelu-vjp! workspace))
(define (tr3-public-residual! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-residual!)
  (m3t-public-residual! workspace selector))
(define (tr3-public-residual-vjp! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-residual-vjp!)
  (m3t-public-residual-vjp! workspace selector))
(define (tr3-public-heads-split! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-heads-split!)
  (m3t-public-heads-split! workspace selector))
(define (tr3-public-heads-split-vjp! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-heads-split-vjp!)
  (m3t-public-heads-split-vjp! workspace selector))
(define (tr3-public-heads-merge! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-heads-merge!)
  (m3t-public-heads-merge! workspace))
(define (tr3-public-heads-merge-vjp! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-heads-merge-vjp!)
  (m3t-public-heads-merge-vjp! workspace))
(define (tr3-public-attention! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-attention!)
  (m3t-public-attention! workspace))
(define (tr3-public-attention-vjp! workspace)
  (tr3-public-gate-workspace workspace 'diagnostic-attention-vjp!)
  (m3t-public-attention-vjp! workspace))
(define (tr3-public-sum! workspace selector)
  (tr3-public-gate-workspace workspace 'diagnostic-sum!)
  (m3t-public-sum! workspace selector))

(define (tr3-public-optimizer-step! optimizer)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-optimizer optimizer) 'optimizer-step!)
  (o2-public-optimizer-step! optimizer))
(define (tr3-public-optimizer-zero-grad! optimizer)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-optimizer optimizer) 'optimizer-zero-grad!)
  (o2-public-optimizer-zero-grad! optimizer))
(define (tr3-public-optimizer-load-state! optimizer state)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-optimizer optimizer) 'optimizer-load-state!)
  (o2-public-optimizer-load-state! optimizer state))

(define (tr3-public-token-dataset-next-batch dataset)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-dataset dataset) 'token-dataset-next-batch)
  (d2-token-dataset-next-batch dataset))
(define (tr3-public-token-dataset-seek! dataset cursor)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-dataset dataset) 'token-dataset-seek!)
  (d2-token-dataset-seek! dataset cursor))
(define (tr3-public-token-dataset-close! dataset)
  (tr3-public-reject-if-leased
    (tr3-public-record-for-dataset dataset) 'token-dataset-close!)
  (d2-token-dataset-close! dataset))
(define (tr3-public-token-batch-release! batch)
  (let ((capability (d2-batch-capability batch 'token-batch-release!)))
    (tr3-public-reject-if-leased
      (tr3-public-record-for-dataset (vector-ref capability 1))
      'token-batch-release!))
  (d2-token-batch-release! batch))
