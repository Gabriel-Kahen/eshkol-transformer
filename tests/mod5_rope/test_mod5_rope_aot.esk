;;; 2-layer Llama-style decoder (RMSNorm + RoPE on Q & K + GQA Hq=4, Hkv=2 +
;;; SwiGLU + residuals + final RMSNorm + LM head + cross-entropy loss).
;;; Composes libeshkol_transformer_mod5_rope.a + libeshkol_transformer_mod5.a +
;;; libeshkol_transformer_k1.a in compiled Eshkol AOT (--strict-types --optimize 0 --no-stdlib).

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern f64 c-exp f64 :real exp)
(extern f64 c-log f64 :real log)

;; MOD5 core primitives (RMSNorm, SwiGLU, GQA attention)
(extern i32 open-mod5 ptr :real et_mod5_aot_open)
(extern void close-mod5 ptr :real et_mod5_aot_close)
(extern void store-f32 ptr i64 f64 :real et_mod5_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_mod5_aot_load_f32)
(extern i32 rms-forward ptr ptr ptr ptr ptr :real et_mod5_aot_rms_forward)
(extern i32 rms-backward ptr ptr ptr ptr ptr ptr ptr :real et_mod5_aot_rms_backward)
(extern i32 glu-forward ptr ptr ptr ptr :real et_mod5_aot_swiglu_forward)
(extern i32 glu-backward ptr ptr ptr ptr ptr ptr :real et_mod5_aot_swiglu_backward)
(extern i32 attention-forward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr
        :real et_mod5_aot_attention_forward)
(extern i32 attention-backward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr ptr ptr ptr
        :real et_mod5_aot_attention_backward)

;; MOD5 RoPE K1 provider bridge
(extern i32 open-rope ptr :real et_mod5_rope_aot_open)
(extern void close-rope ptr :real et_mod5_rope_aot_close)
(extern void rope-store-f32 ptr i64 f64 :real et_mod5_rope_aot_store_f32)
(extern f64 rope-load-f32 ptr i64 :real et_mod5_rope_aot_load_f32)
(extern void rope-store-i64 ptr i64 i64 :real et_mod5_rope_aot_store_i64)
(extern i32 rope-forward ptr i64 i64 i64 i64 ptr ptr f64 f64 ptr
        :real et_mod5_rope_aot_forward)
(extern i32 rope-backward ptr i64 i64 i64 i64 ptr ptr f64 f64 ptr
        :real et_mod5_rope_aot_backward)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define tokens 8)
(define width 16)
(define hidden 32)
(define query-heads 4)
(define kv-heads 2)
(define head-width 4)
(define kv-width (* kv-heads head-width))
(define vocab 8)
(define window 8)
(define sgd-steps 12)
(define epsilon 0.125)
(define rope-theta 10000.0)
(define rope-scale 1.0)
(define learning-rate 0.25)

(define (expect-status operation expected actual)
  (unless (= actual expected)
    (display operation) (display " expected status ") (display expected)
    (display ", received ") (display actual) (newline) (exit 1)))

(define (require-check label ok)
  (unless ok (display label) (newline) (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "MOD5 RoPE AOT workspace allocation failed"
                   (not (= (ptr->usize p) 0)))
    p))

;; Disjoint aligned f32 workspace spans + metadata buffers.
(define span-bytes (* 4 tokens hidden))
(define workspace (checked-allocate (* 7 span-bytes)))
(define input-a workspace)
(define input-b (ptr-add workspace span-bytes))
(define input-c (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define output-a (ptr-add workspace (* 4 span-bytes)))
(define output-b (ptr-add workspace (* 5 span-bytes)))
(define output-c (ptr-add workspace (* 6 span-bytes)))

(define query-positions (checked-allocate (* tokens 8)))
(define key-positions (checked-allocate (* tokens 8)))
(define rope-positions (checked-allocate (* tokens 8)))
(define keep-mask (checked-allocate (* tokens tokens)))
(define slopes (checked-allocate (* query-heads 4)))
(define epsilon-buffer (checked-allocate 4))

(define mod5-runtime
  (let ((cell (checked-allocate 8)))
    (expect-status "MOD5 discovery" 0 (open-mod5 (ffi-pointer cell)))
    (let ((rt (volatile-load ptr cell)))
      (release (ffi-pointer cell))
      rt)))

(define rope-runtime
  (let ((cell (checked-allocate 8)))
    (expect-status "MOD5 RoPE discovery" 0 (open-rope (ffi-pointer cell)))
    (let ((rt (volatile-load ptr cell)))
      (release (ffi-pointer cell))
      rt)))

;; Initialize metadata: positions 0..7, full causal keep mask, zero ALiBi slopes
;; (pure RoPE Llama-style positional encoding).
(do ((t 0 (+ t 1)))
    ((= t tokens))
  (rope-store-i64 (ffi-pointer query-positions) t t)
  (rope-store-i64 (ffi-pointer key-positions) t t)
  (rope-store-i64 (ffi-pointer rope-positions) t t))
(do ((i 0 (+ i 1)))
    ((= i (* tokens tokens)))
  (volatile-store! u8 (ptr-add keep-mask i) 1))
(do ((h 0 (+ h 1)))
    ((= h query-heads))
  (store-f32 (ffi-pointer slopes) h 0.0))
(store-f32 (ffi-pointer epsilon-buffer) 0 epsilon)

;; Pack/unpack helpers between Eshkol f64 tensors and borrowed f32 spans.
(define (pack tensor buffer)
  (let* ((count (tensor-length tensor))
         (flat (reshape tensor (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count))
      (store-f32 (ffi-pointer buffer) i (tensor-ref flat i)))))

(define (unpack buffer rows cols)
  (let* ((count (* rows cols))
         (flat (zeros (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count) (reshape flat (list rows cols)))
      (tensor-set! flat i (load-f32 (ffi-pointer buffer) i)))))

(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (rope-store-f32 (ffi-pointer buffer)
                        (+ (* (+ (* h tokens) t) head-width) d)
                        (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (rope-load-f32 (ffi-pointer buffer)
                                      (+ (* (+ (* h tokens) t) head-width) d))))))))

;; Kernel wrappers.
(define (rms x gamma)
  (pack x input-a)
  (pack gamma input-b)
  (expect-status "RMSNorm forward" 0
                 (rms-forward (ffi-pointer mod5-runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (unpack output-a tokens width))

(define (rms-grad x gamma dy)
  (pack x input-a)
  (pack gamma input-b)
  (pack dy upstream)
  (expect-status "RMSNorm backward" 0
                 (rms-backward (ffi-pointer mod5-runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                               (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens width) (unpack output-b 1 width)))

(define (glu gate up)
  (pack gate input-a)
  (pack up input-b)
  (expect-status "SwiGLU forward" 0
                 (glu-forward (ffi-pointer mod5-runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer output-a)))
  (unpack output-a tokens hidden))

(define (glu-grad gate up dy)
  (pack gate input-a)
  (pack up input-b)
  (pack dy upstream)
  (expect-status "SwiGLU backward" 0
                 (glu-backward (ffi-pointer mod5-runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens hidden) (unpack output-b tokens hidden)))

(define (rope-fwd-heads x heads)
  (pack-heads x heads input-a)
  (expect-status "RoPE forward" 0
                 (rope-forward (ffi-pointer rope-runtime)
                               1 heads tokens head-width
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               rope-theta rope-scale (ffi-pointer output-a)))
  (unpack-heads output-a heads))

(define (rope-bwd-heads dy heads)
  (pack-heads dy heads input-a)
  (expect-status "RoPE backward" 0
                 (rope-backward (ffi-pointer rope-runtime)
                                1 heads tokens head-width
                                (ffi-pointer input-a) (ffi-pointer rope-positions)
                                rope-theta rope-scale (ffi-pointer output-a)))
  (unpack-heads output-a heads))

(define (attend-gqa q k v)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c)
  (expect-status "GQA attention forward" 0
                 (attention-forward (ffi-pointer mod5-runtime) kv-heads
                                    (ffi-pointer input-a) (ffi-pointer input-b)
                                    (ffi-pointer input-c)
                                    (ffi-pointer query-positions)
                                    (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    window (ffi-pointer output-a)))
  (unpack-heads output-a query-heads))

(define (attend-gqa-grad q k v dy)
  (pack-heads q query-heads input-a)
  (pack-heads k kv-heads input-b)
  (pack-heads v kv-heads input-c)
  (pack-heads dy query-heads upstream)
  (expect-status "GQA attention backward" 0
                 (attention-backward (ffi-pointer mod5-runtime) kv-heads
                                     (ffi-pointer input-a) (ffi-pointer input-b)
                                     (ffi-pointer input-c)
                                     (ffi-pointer query-positions)
                                     (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer slopes)
                                     window (ffi-pointer upstream)
                                     (ffi-pointer output-a)
                                     (ffi-pointer output-b)
                                     (ffi-pointer output-c)))
  (vector (unpack-heads output-a query-heads)
          (unpack-heads output-b kv-heads)
          (unpack-heads output-c kv-heads)))

(define (project x w) (matmul x w))
(define (project-dx w dy) (matmul dy (transpose w)))
(define (project-dw x dy) (matmul (transpose x) dy))

;; Per-layer offsets (9 tensors per Llama decoder layer).
(define off-wq 0)
(define off-wk 1)
(define off-wv 2)
(define off-wo 3)
(define off-wgate 4)
(define off-wup 5)
(define off-wdown 6)
(define off-gamma1 7)
(define off-gamma2 8)
(define layer-params 9)

(define idx-layer0 0)
(define idx-layer1 layer-params)
(define idx-gamma-final (* 2 layer-params))
(define idx-wlm (+ (* 2 layer-params) 1))
(define total-params (+ (* 2 layer-params) 2))
(define idx-input-grad total-params)

(define (layer-forward base weights h-in)
  (let* ((wq (vector-ref weights (+ base off-wq)))
         (wk (vector-ref weights (+ base off-wk)))
         (wv (vector-ref weights (+ base off-wv)))
         (wo (vector-ref weights (+ base off-wo)))
         (wgate (vector-ref weights (+ base off-wgate)))
         (wup (vector-ref weights (+ base off-wup)))
         (wdown (vector-ref weights (+ base off-wdown)))
         (g1 (vector-ref weights (+ base off-gamma1)))
         (g2 (vector-ref weights (+ base off-gamma2)))
         (norm1 (rms h-in g1))
         (q-raw (project norm1 wq))
         (k-raw (project norm1 wk))
         (v (project norm1 wv))
         (q-rot (rope-fwd-heads q-raw query-heads))
         (k-rot (rope-fwd-heads k-raw kv-heads))
         (attn (attend-gqa q-rot k-rot v))
         (res1 (tensor-add h-in (project attn wo)))
         (norm2 (rms res1 g2))
         (gate (project norm2 wgate))
         (up (project norm2 wup))
         (gated (glu gate up))
         (h-out (tensor-add res1 (project gated wdown))))
    (vector h-out norm1 q-rot k-rot v attn res1 norm2 gate up gated)))

(define (layer-backward base weights h-in cache dh-out gradients)
  (let* ((wq (vector-ref weights (+ base off-wq)))
         (wk (vector-ref weights (+ base off-wk)))
         (wv (vector-ref weights (+ base off-wv)))
         (wo (vector-ref weights (+ base off-wo)))
         (wgate (vector-ref weights (+ base off-wgate)))
         (wup (vector-ref weights (+ base off-wup)))
         (wdown (vector-ref weights (+ base off-wdown)))
         (g1 (vector-ref weights (+ base off-gamma1)))
         (g2 (vector-ref weights (+ base off-gamma2)))
         (norm1 (vector-ref cache 1))
         (q-rot (vector-ref cache 2))
         (k-rot (vector-ref cache 3))
         (v (vector-ref cache 4))
         (attn (vector-ref cache 5))
         (res1 (vector-ref cache 6))
         (norm2 (vector-ref cache 7))
         (gate (vector-ref cache 8))
         (up (vector-ref cache 9))
         (gated (vector-ref cache 10))
         (dgated (project-dx wdown dh-out))
         (dglu (glu-grad gate up dgated))
         (dgate (vector-ref dglu 0))
         (dup (vector-ref dglu 1))
         (dnorm2 (tensor-add (project-dx wgate dgate) (project-dx wup dup)))
         (drms2 (rms-grad res1 g2 dnorm2))
         (dres1 (tensor-add dh-out (vector-ref drms2 0)))
         (dattn (project-dx wo dres1))
         (dqkv-rot (attend-gqa-grad q-rot k-rot v dattn))
         (dq-rot (vector-ref dqkv-rot 0))
         (dk-rot (vector-ref dqkv-rot 1))
         (dv (vector-ref dqkv-rot 2))
         (dq-raw (rope-bwd-heads dq-rot query-heads))
         (dk-raw (rope-bwd-heads dk-rot kv-heads))
         (dnorm1 (tensor-add (tensor-add (project-dx wq dq-raw)
                                         (project-dx wk dk-raw))
                             (project-dx wv dv)))
         (drms1 (rms-grad h-in g1 dnorm1))
         (dh-in (tensor-add dres1 (vector-ref drms1 0))))
    (vector-set! gradients (+ base off-wq) (project-dw norm1 dq-raw))
    (vector-set! gradients (+ base off-wk) (project-dw norm1 dk-raw))
    (vector-set! gradients (+ base off-wv) (project-dw norm1 dv))
    (vector-set! gradients (+ base off-wo) (project-dw attn dres1))
    (vector-set! gradients (+ base off-wgate) (project-dw norm2 dgate))
    (vector-set! gradients (+ base off-wup) (project-dw norm2 dup))
    (vector-set! gradients (+ base off-wdown) (project-dw gated dh-out))
    (vector-set! gradients (+ base off-gamma1) (vector-ref drms1 1))
    (vector-set! gradients (+ base off-gamma2) (vector-ref drms2 1))
    dh-in))

;; Exact log-softmax cross-entropy loss + analytic logit gradient in f64.
(define (cross-entropy-forward-backward logits targets dlogits)
  (let ((total-loss 0.0)
        (inv-tokens (/ 1.0 tokens)))
    (do ((t 0 (+ t 1)))
        ((= t tokens) (* total-loss inv-tokens))
      (let ((target (vector-ref targets t))
            (peak (tensor-get logits t 0)))
        (do ((v 1 (+ v 1)))
            ((= v vocab))
          (let ((val (tensor-get logits t v)))
            (when (> val peak) (set! peak val))))
        (let ((sum-exp 0.0))
          (do ((v 0 (+ v 1)))
              ((= v vocab))
            (set! sum-exp (+ sum-exp (c-exp (- (tensor-get logits t v) peak)))))
          (let ((target-shifted (- (tensor-get logits t target) peak)))
            (set! total-loss (+ total-loss (- (c-log sum-exp) target-shifted))))
          (when dlogits
            (do ((v 0 (+ v 1)))
                ((= v vocab))
              (let* ((prob (/ (c-exp (- (tensor-get logits t v) peak)) sum-exp))
                     (grad (* inv-tokens (if (= v target) (- prob 1.0) prob))))
                (tensor-set! dlogits t v grad)))))))))

(define (model-loss weights x0 targets gradients)
  (let* ((cache0 (layer-forward idx-layer0 weights x0))
         (h1 (vector-ref cache0 0))
         (cache1 (layer-forward idx-layer1 weights h1))
         (h2 (vector-ref cache1 0))
         (g-final (vector-ref weights idx-gamma-final))
         (wlm (vector-ref weights idx-wlm))
         (h-final (rms h2 g-final))
         (logits (project h-final wlm))
         (dlogits (if gradients (zeros (list tokens vocab)) #f))
         (loss (cross-entropy-forward-backward logits targets dlogits)))
    (when gradients
      (let* ((dh-final (project-dx wlm dlogits))
             (drms-final (rms-grad h2 g-final dh-final))
             (dh2 (vector-ref drms-final 0))
             (dh1 (layer-backward idx-layer1 weights h1 cache1 dh2 gradients))
             (dx0 (layer-backward idx-layer0 weights x0 cache0 dh1 gradients)))
        (vector-set! gradients idx-gamma-final (vector-ref drms-final 1))
        (vector-set! gradients idx-wlm (project-dw h-final dlogits))
        (vector-set! gradients idx-input-grad dx0)))
    loss))

(define (seed-tensor rows cols salt base scale)
  (let ((tensor (zeros (list rows cols))))
    (do ((r 0 (+ r 1)))
        ((= r rows) tensor)
      (do ((c 0 (+ c 1)))
          ((= c cols))
        (let* ((i (+ (* r cols) c))
               (seed (- (modulo (+ (* 31 salt) (* 13 i) (quotient i 5)) 37) 18)))
          (tensor-set! tensor r c (+ base (* scale seed))))))))

(define (initial-weights)
  (vector
   ;; Layer 0
   (seed-tensor width width 1 0.0 0.015625)
   (seed-tensor width kv-width 2 0.0 0.015625)
   (seed-tensor width kv-width 3 0.0 0.015625)
   (seed-tensor width width 4 0.0 0.015625)
   (seed-tensor width hidden 5 0.0 0.015625)
   (seed-tensor width hidden 6 0.0 0.015625)
   (seed-tensor hidden width 7 0.0 0.015625)
   (seed-tensor 1 width 8 1.0 0.0078125)
   (seed-tensor 1 width 9 1.0 0.0078125)
   ;; Layer 1
   (seed-tensor width width 11 0.0 0.015625)
   (seed-tensor width kv-width 12 0.0 0.015625)
   (seed-tensor width kv-width 13 0.0 0.015625)
   (seed-tensor width width 14 0.0 0.015625)
   (seed-tensor width hidden 15 0.0 0.015625)
   (seed-tensor width hidden 16 0.0 0.015625)
   (seed-tensor hidden width 17 0.0 0.015625)
   (seed-tensor 1 width 18 1.0 0.0078125)
   (seed-tensor 1 width 19 1.0 0.0078125)
   ;; Final RMSNorm + LM Head
   (seed-tensor 1 width 20 1.0 0.0078125)
   (seed-tensor width vocab 21 0.0 0.03125)))

;; Negative / malformed RoPE calls via raw FFI pointers with sentinel check.
(define (check-malformed-calls)
  (pack-heads (seed-tensor tokens width 7 0.0 0.015625) query-heads input-a)
  (rope-store-f32 (ffi-pointer output-a) 0 13.5)
  (rope-store-f32 (ffi-pointer output-a) 7 -4.25)

  ;; 1. Odd Dh -> UNSUPPORTED (6)
  (expect-status "RoPE odd Dh" 6
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens 3
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               rope-theta rope-scale (ffi-pointer output-a)))

  ;; 2. Misaligned raw pointer via ptr-add -> INVALID_ARGUMENT (1)
  (expect-status "RoPE misaligned input" 1
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens head-width
                               (ptr-add input-a 1) (ffi-pointer rope-positions)
                               rope-theta rope-scale (ffi-pointer output-a)))
  (expect-status "RoPE misaligned output" 1
                 (rope-backward (ffi-pointer rope-runtime)
                                1 query-heads tokens head-width
                                (ffi-pointer input-a) (ffi-pointer rope-positions)
                                rope-theta rope-scale (ptr-add output-a 2)))

  ;; 3. Non-finite input (+Inf via f32 overflow) -> INVALID_ARGUMENT (1)
  (rope-store-f32 (ffi-pointer input-a) 3 1.0e308)
  (expect-status "RoPE non-finite input" 1
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens head-width
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               rope-theta rope-scale (ffi-pointer output-a)))

  ;; 4. Invalid theta / scale / negative position -> INVALID_ARGUMENT (1)
  (rope-store-f32 (ffi-pointer input-a) 3 0.25)
  (expect-status "RoPE invalid theta" 1
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens head-width
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               1.0 rope-scale (ffi-pointer output-a)))
  (expect-status "RoPE invalid scale" 1
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens head-width
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               rope-theta 0.0 (ffi-pointer output-a)))
  (rope-store-i64 (ffi-pointer rope-positions) 2 -1)
  (expect-status "RoPE negative position" 1
                 (rope-forward (ffi-pointer rope-runtime)
                               1 query-heads tokens head-width
                               (ffi-pointer input-a) (ffi-pointer rope-positions)
                               rope-theta rope-scale (ffi-pointer output-a)))
  (rope-store-i64 (ffi-pointer rope-positions) 2 2)

  ;; Verify output sentinels completely untouched.
  (require-check "RoPE AOT sentinel 0 changed"
                 (= (rope-load-f32 (ffi-pointer output-a) 0) 13.5))
  (require-check "RoPE AOT sentinel 7 changed"
                 (= (rope-load-f32 (ffi-pointer output-a) 7) -4.25))
  (display "MOD5 ROPE AOT malformed statuses PASS") (newline))

(define (check-one-grad p weights x0 targets operand derivative row col)
  (let* ((original (tensor-get operand row col))
         (step 0.00390625))
    (tensor-set! operand row col (+ original step))
    (let ((plus (model-loss weights x0 targets #f)))
      (tensor-set! operand row col (- original step))
      (let* ((minus (model-loss weights x0 targets #f))
             (numerical (/ (- plus minus) (* 2.0 step)))
             (analytic (tensor-get derivative row col))
             (diff (abs (- analytic numerical))))
        (tensor-set! operand row col original)
        (unless (<= diff (+ 0.0001 (* 0.01 (abs numerical))))
          (display "FD mismatch p=") (display p)
          (display " row=") (display row) (display " col=") (display col)
          (display " analytic=") (display (number->string analytic))
          (display " numerical=") (display (number->string numerical))
          (display " diff=") (display (number->string diff)) (newline)
          (exit 1))
        diff))))

(define (check-all-gradients weights x0 targets gradients)
  (let ((checked 0)
        (max-err 0.0))
    (do ((p 0 (+ p 1)))
        ((> p total-params)
         (display "MOD5 ROPE AOT FD_GRADIENTS checked=") (display checked)
         (display " max_abs_err=") (display (number->string max-err))
         (display " PASS") (newline))
      (let* ((operand (if (= p idx-input-grad) x0 (vector-ref weights p)))
             (derivative (vector-ref gradients p))
             (shape (tensor-shape operand))
             (rows (car shape))
             (cols (car (cdr shape))))
        (require-check "MOD5 ROPE AOT inactive gradient"
                       (> (tensor-sum (tensor-abs derivative)) 0.000001))
        (let ((e1 (check-one-grad p weights x0 targets operand derivative 0 0))
              (e2 (check-one-grad p weights x0 targets operand derivative
                                  (- rows 1) (- cols 1))))
          (when (> e1 max-err) (set! max-err e1))
          (when (> e2 max-err) (set! max-err e2))
          (set! checked (+ checked 2)))))))

(define (parameter-checksum weights)
  (do ((p 0 (+ p 1))
       (total 0.0 (+ total (* (+ p 1) (tensor-sum (vector-ref weights p))))))
      ((= p total-params) total)))

(define (print-loss step loss)
  (display "MOD5 ROPE AOT LOSS ") (display step)
  (display " ") (display (number->string loss)) (newline))

(define (train-2layer-llama)
  (let* ((weights (initial-weights))
         (x0 (seed-tensor tokens width 23 0.0 0.0625))
         (targets (vector 1 2 3 4 5 6 7 0))
         (gradients (make-vector (+ total-params 1) #f))
         (initial (model-loss weights x0 targets gradients))
         (initial-checksum (parameter-checksum weights)))
    (check-all-gradients weights x0 targets gradients)
    (print-loss 0 initial)
    (do ((step 1 (+ step 1))
         (previous initial))
        ((> step sgd-steps)
         (let ((checksum (parameter-checksum weights)))
           (require-check "MOD5 ROPE AOT parameters did not update"
                          (not (= checksum initial-checksum)))
           (display "MOD5 ROPE AOT RESULT layers=2 hq=4 hkv=2 steps=12 initial=")
           (display (number->string initial))
           (display " final=") (display (number->string previous))
           (display " checksum=") (display (number->string checksum))
           (newline)))
      (do ((p 0 (+ p 1)))
          ((= p total-params))
        (let ((derivative (vector-ref gradients p)))
          (require-check "MOD5 ROPE AOT nonfinite gradient"
                         (< (tensor-sum (tensor-abs derivative)) 1.0e300))
          (vector-set! weights p
                       (tensor-sub (vector-ref weights p)
                                   (tensor-scale derivative learning-rate)))))
      (let ((current (model-loss weights x0 targets gradients)))
        (require-check "MOD5 ROPE AOT loss failed to decrease"
                       (and (>= current 0.0) (< current previous)))
        (print-loss step current)
        (set! previous current)))))

(check-malformed-calls)
(train-2layer-llama)

(close-rope (ffi-pointer rope-runtime))
(close-mod5 (ffi-pointer mod5-runtime))
(release (ffi-pointer workspace))
(release (ffi-pointer query-positions))
(release (ffi-pointer key-positions))
(release (ffi-pointer rope-positions))
(release (ffi-pointer keep-mask))
(release (ffi-pointer slopes))
(release (ffi-pointer epsilon-buffer))
