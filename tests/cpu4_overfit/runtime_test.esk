;;; Same canonical C4, genuine N1/T4 full-mask row, 250 actual O2 updates.
;;; Loss observations come exclusively from actual full-step return values.
(load "t2_wave2_root.esk")
(load "i2_wave2_extension.esk")
(load "o2_wave2_extension.esk")
(define t1-wave1-tensor-admitted? t2-wave2-tensor-admitted?)
(load "m3t_transport_extension.esk")
(load "m3_schedule.esk")
(load "m3_model_extension.esk")
(load "d2_semantic_core.esk")
(load "d2_dataset.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_p1_fixed_set_extension.esk")
(load "cpu4_model_binding_extension.esk")
(load "cpu4_trainer_control_extension.esk")
(load "cpu4_training_schedule_extension.esk")
(load "tr3_o2_step_clear_extension.esk")
(load "cpu4_training_step_extension.esk")
(extern i64 retention-capture :real et_cpu4_overfit_test_capture)
(extern i64 retention-equal :real et_cpu4_overfit_test_payload_equal)
(extern i64 retention-count i64 :real et_cpu4_overfit_test_count)
(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4 OVERFIT FAIL: ") (display label) (newline) (exit 1))))
(define-syntax must
  (syntax-rules () ((_ label expression)
    (guard (caught (#t (display "CPU4 OVERFIT ERROR: ") (display label)
      (if (transformer-error? caught)
          (begin (display " ") (display (transformer-error-category caught))
                 (display " ") (display (transformer-error-operation caught))
                 (display " ") (display (transformer-error-message caught)))
          (display " foreign condition"))
      (newline) (exit 1))) expression))))
(define (paths handles)
  (let loop ((index 0))
    (if (= index 14) '()
        (cons (parameter-handle-path (vector-ref handles index)) (loop (+ index 1))))))
(define resolved (must "config" (x1-private-config-resolve
  (x1-private-config-parse
    "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729,\"training.accumulation-steps\":1}") '())))
(define model (must "canonical C4" (g3c4-model-create-seeded-internal 1729)))
(module-train! model)
(define binding (must "canonical binding" (cpu4-model-binding-create-internal model resolved)))
(define b (cpu4-model-binding-check-internal binding))
(define handles (vector-ref b 10))
(define lease (vector-ref b 5))
(define optimizer (must "optimizer" (o2-public-optimizer-create
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu '(none) '(constant)
    (list (list 'group (paths handles) "3dcccccd" "3f000000" "3f000000"
                "3a83126f" "00000000"))) (module-parameters model))))
(define tokenizer (must "raw V256" (t2-wave2-tokenizer-byte resolved)))
(define dataset (must "single T4 row" (d2-token-dataset-open
  (list ':directory (car (cdr (command-line))) ':batch-size 1 ':sequence-length 4
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 5 ':maximum-batch-bytes 68
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f) tokenizer)))
(define trainer (must "own CPU4 trainer" (cpu4-trainer-create-internal binding tokenizer dataset optimizer)))
(define record (cpu4-trainer-idle-check-internal trainer 'cpu4-overfit))
(define (values-bytes)
  (let ((result (make-vector 14 #f)))
    (let loop ((index 0))
      (if (= index 14) result
          (let ((handle (vector-ref handles index)))
            (vector-set! result index (i2-checkpoint-encode
              (vector (parameter-handle-tensor-internal handle) 'parameter
                      (parameter-handle-shape handle) 'f32 'cpu
                      'dense-row-major-contiguous 'CPU4-OVERFIT)))
            (loop (+ index 1)))))))
(define (gradients-absent?)
  (let scan ((index 0))
    (if (= index 14) #t
        (and (equal? (i2-parameter-gradient-metadata-internal
                       (vector-ref (vector-ref b 11) index)) (vector 0 0))
             (scan (+ index 1))))))
(define before (values-bytes))
(define initial-cursor (cpu4-d2-cursor-capture-internal dataset))
(define decoded-initial (d2-core-cursor-decode initial-cursor))
(check "exact one-row finite corpus" (and (= (vector-ref decoded-initial 14) 1)
  (= (vector-ref decoded-initial 15) 0)))
(check "same C4 model and position4x4" (and (eq? model (vector-ref record 8))
  (eq? (vector-ref (vector-ref b 3) 7) #f)
  (equal? (parameter-handle-shape (vector-ref handles 13)) '(4 4))))
(check "native model plus O2 payload baseline" (= (retention-capture) 1))
(define (sample? update)
  (or (= update 1) (= update 2) (= update 10) (= update 25) (= update 50)
      (= update 100) (= update 150) (= update 200) (= update 250)))
(define (emit update result observation)
  (display "CPU4-OVERFIT-OBS ") (display update) (display " ") (display (- update 1))
  (display " ") (display (cpu4-training-u32 observation 0))
  (display " ") (display (cpu4-training-u32 observation 4))
  (display " ") (display (cpu4-training-u32 observation 8))
  (display " ") (display (vector-ref result 0))
  (display " ") (display (vector-ref result 1))
  (display " ") (display (vector-ref result 2)) (newline))
(let overfit-update-loop ((update 1))
  (if (<= update 250)
      (let* ((result (must "actual full step" (cpu4-training-step-internal! trainer)))
             (observations (vector-ref result 3)) (observation (vector-ref observations 0)))
        (check "one actual full-mask observation" (and (= (vector-length observations) 1)
          (= (bytevector-length observation) 12) (= (cpu4-training-u32 observation 4) 1082130432)))
        (check "authentic update token epoch counts" (and (= (vector-ref result 0) 4)
          (= (vector-ref result 1) update) (= (vector-ref result 2) (- update 1))
          (= (vector-ref record 19) (* update 4)) (= (vector-ref record 20) update)
          (= (vector-ref record 21) (- update 1))))
        (check "same canonical authority and exact control equation"
          (eq? record (cpu4-trainer-idle-check-internal trainer 'cpu4-overfit)))
        (let ((cursor (d2-core-cursor-decode (cpu4-d2-cursor-capture-internal dataset))))
          (check "independent one-row cursor equation" (and (= (vector-ref cursor 14) 1)
            (= (vector-ref cursor 15) 1) (= update (+ (vector-ref record 21) (vector-ref cursor 15))))))
        (check "all fourteen gradients absent" (gradients-absent?))
        (check "native IDLE after real update" (= (cpu4-control-native-enter lease 1) 0))
        (check "native IDLE read proof drains" (= (cpu4-control-native-leave lease) 0))
        (check "native payload returns to baseline" (= (retention-equal) 1))
        (if (sample? update) (emit update result observation))
        (overfit-update-loop (+ update 1)))))
(define after (values-bytes))
(define changed (let scan ((index 0) (count 0) (bytes 0))
  (if (= index 14)
      (begin (check "exact1192 values4768bytes" (= bytes 4768)) count)
      (scan (+ index 1)
            (+ count (if (d2-core-bytes=? (vector-ref before index) (vector-ref after index)) 0 1))
            (+ bytes (bytevector-length (vector-ref after index)))))))
(check "actual canonical parameters changed" (> changed 0))
(define frame-count (i2-bounded-list-length (vector-ref cpu4-step-frames 0) 250))
(check "250 exact committed step records" (equal? frame-count 250))
(check "native O2 plans all committed and payload gone" (and (= (retention-count 3) 0)
  (= (retention-count 4) 250) (= (retention-count 5) 0) (= (retention-count 6) 0)))
(check "finite250 F32 retired-control bound64MiB" (and
  (>= (retention-count 2) (retention-count 1))
  (<= (- (retention-count 2) (retention-count 1)) 67108864)))
(check "finite250 O2 retired-control bound256KiB" (<= (retention-count 7) 262144))
(display "CPU4-OVERFIT-TRAIN ") (display (vector-ref record 20)) (display " ")
(display (vector-ref record 19)) (display " ") (display (vector-ref record 21)) (newline)
(display "CPU4-OVERFIT-PARAM ") (display changed) (display " 1192 4768") (newline)
(display "CPU4-OVERFIT-RETENTION ") (display frame-count)
(let emit-counts ((selector 0))
  (if (< selector 8) (begin (display " ") (display (retention-count selector))
                          (emit-counts (+ selector 1))) (newline)))
(d2-token-dataset-close! dataset)
(check "release exact trained binding" (cpu4-model-binding-release-internal! binding))
(display "CPU4-OVERFIT-RUNTIME-PASS ") (display checks) (newline)
