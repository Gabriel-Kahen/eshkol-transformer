;;; Source-private CPU4 trainer/control authority; no public facade or TR3 ledger.
;;; Required source dependencies in the SAME identity aggregate, in order:
;;; X1 + T2/D2 roots, O2 extension, c2_d2_cursor_pair_extension.esk,
;;; cpu4_p1_fixed_set_extension.esk + cpu4_model_binding_extension.esk.
;;; No stdlib dependency, caller callbacks, imported parameter roster or new owner.
(extern i64 cpu4-control-native-enter ptr i64
        :real et_g3c4_private_training_lease_enter_v1)
(extern i64 cpu4-control-native-leave ptr
        :real et_g3c4_private_training_lease_leave_v1)

(define cpu4-trainer-tag (vector 'cpu4-trainer-v1))
(define cpu4-control-parent-tag (vector 'cpu4-control-parent-v1))
(define cpu4-control-stage-tag (vector 'cpu4-control-stage-v1))
;;; Registry rows: [record22, exact tokenizer shell, exact T2 registry entry].
;;; Record: [tag,self,shell,state,parent,owner-token,resolved,tokenizer-identity,
;;; model,binding,modules17,handles14,carriers14,optimizer,O2-record,dataset,
;;; D2-state,epoch-cursor,RNG,tokens,updates,epochs].
(define cpu4-trainers (vector '() #f))
(define cpu4-control-parents (vector '()))
(define cpu4-control-stages (vector '()))
(define cpu4-control-i64-max 9223372036854775807)

(define (cpu4-control-fail category operation message)
  (cpu4-binding-fail category operation message))
(define (cpu4-control-vector? value size)
  (and (vector? value) (= (vector-length value) size)))
(define (cpu4-control-count? value)
  (and (m3t-exact-i64? value) (>= value 0)))
(define (cpu4-control-product left right operation)
  (if (and (> left 0) (> right (quotient cpu4-control-i64-max left)))
      (cpu4-control-fail 'invalid-state operation "CPU4 contribution product overflows"))
  (* left right))
(define (cpu4-control-bytes value)
  (bytevector-copy value 0 (bytevector-length value)))
(define (cpu4-control-string value)
  (utf8->string (string->utf8 value)))

(define (cpu4-trainer-row-internal shell operation)
  (let find ((rows (vector-ref cpu4-trainers 0)))
    (cond ((null? rows)
           (cpu4-control-fail 'invalid-argument operation "CPU4 trainer is not registered"))
          ((eq? shell (vector-ref (vector-ref (car rows) 0) 2))
           (let ((record (vector-ref (car rows) 0)))
             (if (not (and (cpu4-control-vector? record 22)
                           (eq? (vector-ref record 0) cpu4-trainer-tag)
                           (eq? (vector-ref record 1) record)
                           (or (eq? (vector-ref record 3) 'idle)
                               (eq? (vector-ref record 3) 'snapshot)
                               (eq? (vector-ref record 3) 'restore))))
                 (cpu4-control-fail 'invalid-state operation "CPU4 trainer is not live"))
             (car rows)))
          (else (find (cdr rows))))))
(define (cpu4-trainer-record-internal shell operation)
  (vector-ref (cpu4-trainer-row-internal shell operation) 0))

(define (cpu4-control-raw-tokenizer? tokenizer operation)
  (let ((core (t2-private-require-core tokenizer operation 'invalid-argument)))
    (and (t1-core-tokenizer? core) (eq? (vector-ref core 1) 'raw)
         (null? (vector-ref core 2)) (null? (vector-ref core 3))
         (null? (vector-ref core 4)) (= (t1-tokenizer-core-vocab-size core) 256))))
(define (cpu4-control-handle-list? handles values)
  (let check ((index 0) (remaining values))
    (if (= index 14) (null? remaining)
        (and (pair? remaining) (eq? (vector-ref handles index) (car remaining))
             (check (+ index 1) (cdr remaining))))))
(define (cpu4-control-handle-overlap? left right)
  (let outer ((xs left))
    (if (null? xs) #f
        (let inner ((ys right))
          (cond ((null? ys) (outer (cdr xs)))
                ((eq? (car xs) (car ys)) #t)
                (else (inner (cdr ys))))))))
(define (cpu4-control-o2-check! record operation)
  (let ((optimizer (o2-require-optimizer operation (vector-ref record 13)))
        (updates (vector-ref record 20)))
    (if (not (and (eq? optimizer (vector-ref record 14))
                  (cpu4-control-handle-list? (vector-ref record 11)
                                            (vector-ref optimizer 5))
                  (cpu4-control-count? updates)))
        (cpu4-control-fail 'invalid-state operation "CPU4 optimizer identity or handle order differs"))
    (let ((completed (o2-native-optimizer-completed-updates (vector-ref optimizer 1))))
      (if (< completed 0) (o2-native-fail operation))
      (if (not (= completed updates))
          (cpu4-control-fail 'invalid-state operation "CPU4 optimizer and trainer updates differ")))
    (if (not (= (o2-native-optimizer-require-absent-gradients
                  (vector-ref optimizer 1)) 0))
        (o2-native-fail operation))
    (let scan ((rows o2-optimizers))
      (if (null? rows) #t
          (begin
            (if (and (not (eq? optimizer (car rows)))
                     (cpu4-control-handle-overlap?
                       (vector-ref optimizer 5) (vector-ref (car rows) 5)))
                (cpu4-control-fail 'invalid-state operation "CPU4 parameters overlap another optimizer"))
            (scan (cdr rows)))))
    optimizer))

(define (cpu4-trainer-components! record row operation)
  (let* ((binding (cpu4-model-binding-check-internal (vector-ref record 9)))
         (tokenizer (vector-ref row 1))
         (identity (d2-tokenizer-identity tokenizer))
         (state (d2-open-dataset-state (vector-ref record 15) operation))
         (core (cpu4-d2-idle-core (vector-ref record 15) operation))
         (retained (vector-ref record 7)))
    (if (not (and (eq? (vector-ref record 6) (vector-ref binding 6))
                  (eq? (vector-ref record 8) (vector-ref binding 2))
                  (eq? (vector-ref record 10) (vector-ref binding 9))
                  (eq? (vector-ref record 11) (vector-ref binding 10))
                  (eq? (vector-ref record 12) (vector-ref binding 11))
                  (eq? (t2-private-entry tokenizer) (vector-ref row 2))
                  (cpu4-control-raw-tokenizer? tokenizer operation)
                  (cpu4-control-vector? retained 3)
                  (eq? (vector-ref retained 2) #t)
                  (string=? (vector-ref retained 0) (vector-ref identity 0))
                  (= (vector-ref retained 1) 256) (= (vector-ref identity 1) 256)
                  (eq? state (vector-ref record 16))
                  (eq? core (vector-ref state 6))
                  (string=? (vector-ref retained 0) (vector-ref core 2))))
        (cpu4-control-fail 'invalid-state operation "CPU4 retained component identity differs"))
    (if (and (eq? (vector-ref state 10) 'released) (= (vector-ref state 8) 0))
        (cpu4-control-fail 'invalid-state operation "CPU4 dataset generation is malformed"))
    (cpu4-control-o2-check! record operation)
    binding))

;;; Validate and detach data only. This does NOT authenticate model/moment bytes.
(define (cpu4-control-validate-copy record controls operation)
  (if (not (and (cpu4-control-vector? controls 5)
                (cpu4-control-vector? (vector-ref controls 0) 5)
                (cpu4-control-vector? (vector-ref controls 1) 2)
                (cpu4-control-vector? (vector-ref controls 2) 2)
                (cpu4-control-vector? (vector-ref controls 3) 2)
                (cpu4-control-vector? (vector-ref controls 4) 3)))
      (cpu4-control-fail 'invalid-argument operation "CPU4 controls require the exact five-tuple"))
  (let* ((rng (vector-ref controls 0)) (tokenizer (vector-ref controls 1))
         (pair (vector-ref controls 2)) (config (vector-ref controls 3))
         (counts (vector-ref controls 4)) (resolved (vector-ref record 6))
         (retained (vector-ref record 7))
         (canonical (string->utf8 (x1-private-config-canonical resolved)))
         (fingerprint (x1-private-config-fingerprint resolved)))
    (if (not (and (eq? (vector-ref rng 0) 'philox4x32-10)
                  (equal? (vector-ref rng 1) 1)
                  (cpu4-control-count? (vector-ref rng 2))
                  (= (vector-ref rng 2) (x1-private-config-ref resolved 'run.seed))
                  (equal? (vector-ref rng 3) 0) (equal? (vector-ref rng 4) 0)
                  (string? (vector-ref tokenizer 0))
                  (string=? (vector-ref tokenizer 0) (vector-ref retained 0))
                  (equal? (vector-ref tokenizer 1) 256)
                  (bytevector? (vector-ref pair 0)) (bytevector? (vector-ref pair 1))
                  (bytevector? (vector-ref config 0)) (string? (vector-ref config 1))
                  (equal? (vector-ref config 0) canonical)
                  (string=? (vector-ref config 1) fingerprint)
                  (cpu4-control-count? (vector-ref counts 0))
                  (cpu4-control-count? (vector-ref counts 1))
                  (cpu4-control-count? (vector-ref counts 2))))
        (cpu4-control-fail 'invalid-argument operation "CPU4 RNG/config/tokenizer/counters differ"))
    (let* ((request (vector (vector-ref pair 0) (vector-ref pair 1)
                            (vector-ref tokenizer 0) 256 operation #f)))
      (c2-d2-cursor-pair-internal request)
      (let* ((projection (vector-ref request 5))
             (decoded (c2-d2-decode (vector-ref projection 3) operation))
             (core (vector-ref (vector-ref record 16) 6))
             (total (vector-ref projection 7)) (position (vector-ref projection 8))
             (start (vector-ref projection 9))
             (tokens (vector-ref counts 0)) (updates (vector-ref counts 1))
             (epochs (vector-ref counts 2))
             (accumulation (x1-private-config-ref resolved 'training.accumulation-steps)))
        (if (not (and (= (vector-ref decoded 4) 1) (= (vector-ref decoded 5) 4)
                      (d2-core-state-identity=? core decoded)
                      (cpu4-control-count? accumulation) (> accumulation 0)))
            (cpu4-control-fail 'invalid-argument operation "CPU4 cursor or accumulation profile differs"))
        (let* ((contributions (cpu4-control-product updates accumulation operation))
               (epoch-contributions (cpu4-control-product epochs (- total start) operation))
               (offset (- position start))
               (maximum-tokens (cpu4-control-product 4 contributions operation)))
          (if (or (> epoch-contributions (- cpu4-control-i64-max offset))
                  (not (= contributions (+ epoch-contributions offset)))
                  (> contributions tokens) (> tokens maximum-tokens))
              (cpu4-control-fail 'invalid-state operation "CPU4 counters and cursor contributions differ")))
        (vector (vector 'philox4x32-10 1 (vector-ref rng 2) 0 0)
                (vector (cpu4-control-string (vector-ref tokenizer 0)) 256)
                (vector (cpu4-control-bytes (vector-ref projection 3))
                        (cpu4-control-bytes (vector-ref projection 4)))
                (vector (cpu4-control-bytes canonical) (cpu4-control-string fingerprint))
                (vector tokens updates epochs))))))

(define (cpu4-control-current-tuple record)
  (let ((identity (vector-ref record 7)) (resolved (vector-ref record 6)))
    (vector (vector-ref record 18)
            (vector (vector-ref identity 0) (vector-ref identity 1))
            (vector (cpu4-d2-cursor-capture-internal (vector-ref record 15))
                    (vector-ref record 17))
            (vector (string->utf8 (x1-private-config-canonical resolved))
                    (x1-private-config-fingerprint resolved))
            (vector (vector-ref record 19) (vector-ref record 20) (vector-ref record 21)))))
(define (cpu4-trainer-idle-check-internal shell operation)
  (let* ((row (cpu4-trainer-row-internal shell operation)) (record (vector-ref row 0)))
    (if (or (not (eq? (vector-ref record 3) 'idle)) (vector-ref record 4))
        (cpu4-control-fail 'invalid-state operation "CPU4 trainer has an active control parent"))
    (cpu4-trainer-components! record row operation)
    (cpu4-control-validate-copy record (cpu4-control-current-tuple record) operation)
    record))

(define (cpu4-trainer-overlap! record operation)
  (let scan ((rows (vector-ref cpu4-trainers 0)))
    (if (null? rows) #t
        (let ((other (vector-ref (car rows) 0)))
          (if (and (not (eq? other record)) (not (eq? (vector-ref other 3) 'dead))
                   (or (eq? (vector-ref record 8) (vector-ref other 8))
                       (eq? (vector-ref record 9) (vector-ref other 9))
                       (eq? (vector-ref record 13) (vector-ref other 13))
                       (eq? (vector-ref record 15) (vector-ref other 15))
                       (cpu4-control-handle-overlap?
                         (vector-ref (vector-ref record 14) 5)
                         (vector-ref (vector-ref other 14) 5))))
              (cpu4-control-fail 'invalid-state operation "CPU4 trainer components overlap"))
          (scan (cdr rows))))))

(define (cpu4-trainer-create-internal binding-token tokenizer dataset optimizer)
  (let ((operation 'cpu4-trainer-create))
    (if (vector-ref cpu4-trainers 1)
        (cpu4-control-fail 'invalid-state operation "CPU4 trainer creation is active"))
    (guard (caught (#t (vector-set! cpu4-trainers 1 #f) (raise caught)))
      (vector-set! cpu4-trainers 1 #t)
      (let* ((binding (cpu4-model-binding-check-internal binding-token))
             (identity (d2-tokenizer-identity tokenizer))
             (state (d2-open-dataset-state dataset operation))
             (core (cpu4-d2-idle-core dataset operation))
             (o2 (o2-require-optimizer operation optimizer))
             (cursor (cpu4-d2-cursor-capture-internal dataset))
             (resolved (vector-ref binding 6)))
        (if (or (not (cpu4-control-raw-tokenizer? tokenizer operation))
                (>= (vector-ref core 15) (vector-ref core 14)))
            (cpu4-control-fail 'invalid-state operation "CPU4 trainer requires raw byte tokens and a resumable dataset"))
        (let* ((record
                 (vector cpu4-trainer-tag #f (vector 'cpu4-trainer) 'idle #f
                         (vector 'cpu4-owner) resolved
                         (vector (cpu4-control-string (vector-ref identity 0)) 256 #t)
                         (vector-ref binding 2) binding-token
                         (vector-ref binding 9) (vector-ref binding 10) (vector-ref binding 11)
                         optimizer o2 dataset state cursor
                         (vector 'philox4x32-10 1 (x1-private-config-ref resolved 'run.seed) 0 0)
                         0 0 0))
               (row (vector record tokenizer (t2-private-entry tokenizer)))
               (next (cons row (vector-ref cpu4-trainers 0))))
          ;; Root all fresh values before final dependency checks. Failed rows
          ;; remain inert identity tombstones and never enroll native authority.
          (vector-set! cpu4-trainers 0 next)
          (let* ((canonical-row (car (vector-ref cpu4-trainers 0)))
                 (canonical (vector-ref canonical-row 0)))
            (vector-set! canonical 1 canonical)
            (guard (caught (#t (vector-set! canonical 3 'dead) (raise caught)))
              (cpu4-trainer-overlap! canonical operation)
              (cpu4-trainer-idle-check-internal (vector-ref canonical 2) operation)
              ;; Authenticate native IDLE through its real closed transition;
              ;; roster/check alone deliberately does not observe lease phase.
              (let ((lease (cpu4-model-binding-native-lease-internal
                             (vector-ref canonical 9))))
                (g3c4-native-check (cpu4-control-native-enter lease 2) operation)
                ;; No allocation, dependency, borrow or child creation occurs
                ;; between enter and leave. A defect here cannot be retried.
                (if (not (= (cpu4-control-native-leave lease) 0))
                    (cpu4-binding-fail-stop 70)))
              (vector-set! cpu4-trainers 1 #f)
              (vector-ref canonical 2))))))))

;;; Parent ledger: [tag,self,token,record,kind,state,native-lease,pending-stage].
(define (cpu4-control-parent-internal token operation)
  (let find ((parents (vector-ref cpu4-control-parents 0)))
    (cond ((null? parents)
           (cpu4-control-fail 'invalid-argument operation "CPU4 control parent is not registered"))
          ((eq? token (vector-ref (car parents) 2))
           (let* ((parent (car parents)) (record (vector-ref parent 3)))
             (if (not (and (cpu4-control-vector? parent 8)
                           (eq? (vector-ref parent 0) cpu4-control-parent-tag)
                           (eq? (vector-ref parent 1) parent)
                           (eq? (vector-ref parent 5) 'active)
                           (eq? record (cpu4-trainer-record-internal (vector-ref record 2) operation))
                           (eq? (vector-ref record 4) token)
                           (eq? (vector-ref record 3) (vector-ref parent 4))))
                 (cpu4-control-fail 'invalid-state operation "CPU4 control parent is stale"))
             parent))
          (else (find (cdr parents))))))
(define (cpu4-trainer-control-begin-internal shell kind)
  (let ((operation 'cpu4-control-begin))
    (if (eq? kind 'step)
        (cpu4-control-fail 'unsupported operation "CPU4 step READ-to-WRITE handoff is not admitted"))
    (if (not (or (eq? kind 'snapshot) (eq? kind 'restore)))
        (cpu4-control-fail 'invalid-argument operation "CPU4 control kind is not supported"))
    (let* ((record (cpu4-trainer-idle-check-internal shell operation))
           (lease (cpu4-model-binding-native-lease-internal (vector-ref record 9)))
           (parent (vector cpu4-control-parent-tag #f (vector 'cpu4-control)
                           record kind 'pending lease #f))
           (next (cons parent (vector-ref cpu4-control-parents 0))))
      (vector-set! cpu4-control-parents 0 next)
      (let* ((canonical (car (vector-ref cpu4-control-parents 0)))
             (trainer (vector-ref canonical 3)))
        (vector-set! canonical 1 canonical)
        (guard (caught (#t (vector-set! canonical 5 'dead) (raise caught)))
          (cpu4-trainer-idle-check-internal (vector-ref trainer 2) operation)
          ;; WRITE=2 in the accepted native lease. No invented IDLE observer.
          (g3c4-native-check (cpu4-control-native-enter (vector-ref canonical 6) 2) operation)
          (vector-set! trainer 3 (vector-ref canonical 4))
          (vector-set! trainer 4 (vector-ref canonical 2))
          (vector-set! canonical 5 'active)
          (vector-ref canonical 2))))))
(define (cpu4-trainer-control-end-internal! token)
  (let* ((operation 'cpu4-control-end)
         (parent (cpu4-control-parent-internal token operation))
         (record (vector-ref parent 3)))
    (if (vector-ref parent 7)
        (cpu4-control-fail 'invalid-state operation "CPU4 control has a pending restore stage"))
    (cpu4-trainer-components! record (cpu4-trainer-row-internal (vector-ref record 2) operation) operation)
    (cpu4-control-validate-copy record (cpu4-control-current-tuple record) operation)
    (g3c4-native-check (cpu4-control-native-leave (vector-ref parent 6)) operation)
    (vector-set! record 4 #f)
    (vector-set! record 3 'idle)
    (vector-set! parent 5 'closed)
    #t))
(define (cpu4-trainer-controls-copy-internal token)
  (let* ((operation 'cpu4-controls-copy)
         (parent (cpu4-control-parent-internal token operation))
         (record (vector-ref parent 3)))
    (cpu4-trainer-components! record (cpu4-trainer-row-internal (vector-ref record 2) operation) operation)
    (cpu4-control-validate-copy record (cpu4-control-current-tuple record) operation)))

;;; Stage ledger: [tag,self,token,parent,state,private-detached-controls].
(define (cpu4-control-stage-internal token operation)
  (let find ((stages (vector-ref cpu4-control-stages 0)))
    (cond ((null? stages)
           (cpu4-control-fail 'invalid-argument operation "CPU4 restore stage is not registered"))
          ((eq? token (vector-ref (car stages) 2))
           (let* ((stage (car stages))
                  (parent (cpu4-control-parent-internal (vector-ref stage 3) operation)))
             (if (not (and (cpu4-control-vector? stage 6)
                           (eq? (vector-ref stage 0) cpu4-control-stage-tag)
                           (eq? (vector-ref stage 1) stage)
                           (or (eq? (vector-ref stage 4) 'staged)
                               (eq? (vector-ref stage 4) 'prepared))
                           (eq? (vector-ref parent 4) 'restore)
                           (eq? (vector-ref parent 7) token)))
                 (cpu4-control-fail 'invalid-state operation "CPU4 restore stage is stale"))
             stage))
          (else (find (cdr stages))))))
(define (cpu4-trainer-controls-restore-stage-internal token controls)
  (let* ((operation 'cpu4-controls-stage)
         (parent (cpu4-control-parent-internal token operation))
         (record (vector-ref parent 3)))
    (if (or (not (eq? (vector-ref parent 4) 'restore)) (vector-ref parent 7))
        (cpu4-control-fail 'invalid-state operation "CPU4 restore parent is not stage-free"))
    (cpu4-trainer-components! record (cpu4-trainer-row-internal (vector-ref record 2) operation) operation)
    (let* ((copy (cpu4-control-validate-copy record controls operation))
           (stage (vector cpu4-control-stage-tag #f (vector 'cpu4-controls)
                          token 'pending copy))
           (next (cons stage (vector-ref cpu4-control-stages 0))))
      (vector-set! cpu4-control-stages 0 next)
      (let* ((canonical (car (vector-ref cpu4-control-stages 0)))
             (canonical-parent (cpu4-control-parent-internal (vector-ref canonical 3) operation)))
        (vector-set! canonical 1 canonical)
        (if (vector-ref canonical-parent 7)
            (cpu4-control-fail 'invalid-state operation "CPU4 restore stage appeared during staging"))
        (vector-set! canonical-parent 7 (vector-ref canonical 2))
        (vector-set! canonical 4 'staged)
        (vector-ref canonical 2)))))
(define (cpu4-trainer-controls-restore-precommit-internal token)
  (let ((stage (cpu4-control-stage-internal token 'cpu4-controls-precommit)))
    (vector-set! stage 4 'prepared)
    #t))
(define (cpu4-trainer-controls-restore-copy-internal token)
  (let* ((operation 'cpu4-controls-stage-copy)
         (stage (cpu4-control-stage-internal token operation))
         (parent (cpu4-control-parent-internal (vector-ref stage 3) operation)))
    (cpu4-control-validate-copy (vector-ref parent 3) (vector-ref stage 5) operation)))
(define (cpu4-trainer-controls-restore-abort-internal! token)
  (let* ((stage (cpu4-control-stage-internal token 'cpu4-controls-abort))
         (parent (cpu4-control-parent-internal (vector-ref stage 3) 'cpu4-controls-abort)))
    (vector-set! parent 7 #f)
    (vector-set! stage 4 'aborted)
    (vector-set! stage 5 #f)
    #t))
(define (cpu4-trainer-controls-restore-commit-internal! token)
  (let* ((operation 'cpu4-controls-commit)
         (stage (cpu4-control-stage-internal token operation))
         (parent (cpu4-control-parent-internal (vector-ref stage 3) operation))
         (record (vector-ref parent 3)) (controls (vector-ref stage 5))
         (pair (vector-ref controls 2)) (counts (vector-ref controls 4)))
    (if (not (eq? (vector-ref stage 4) 'prepared))
        (cpu4-control-fail 'invalid-state operation "CPU4 controls are not prepared"))
    ;; Trusted G3 caller has ALREADY committed its genuine I2/O2/D2 plans.
    ;; This tail has no dependency calls or allocations. Only trainer controls
    ;; 17..21 change; private stage/parent stores consume the one-shot authority.
    (vector-set! record 17 (vector-ref pair 1))
    (vector-set! record 18 (vector-ref controls 0))
    (vector-set! record 19 (vector-ref counts 0))
    (vector-set! record 20 (vector-ref counts 1))
    (vector-set! record 21 (vector-ref counts 2))
    (vector-set! parent 7 #f)
    (vector-set! stage 4 'committed)
    (vector-set! stage 5 #f)
    #t))
