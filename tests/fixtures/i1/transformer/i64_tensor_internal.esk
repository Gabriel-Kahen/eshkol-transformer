        :real et_i64_tensor_eshkol_context_call_count_v1)

(extern i64 i1-abi-major :real et_i64_tensor_eshkol_abi_major_v1)
(extern i64 i1-abi-minor :real et_i64_tensor_eshkol_abi_minor_v1)
(extern ptr i1-capability-name
        :real et_i64_tensor_eshkol_capability_name_v1)
