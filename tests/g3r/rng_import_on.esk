(load "g3r_rng_import_extension.esk")

(extern i64 g3r-test-live-rng-clones
        :real et_g3t_test_live_rng_clones_v1)
(extern i64 g3t-test-live-contexts
        :real et_g3t_test_live_contexts_v1)
(extern i64 g3r-test-rng-clone-word ptr i64
        :real et_g3t_test_rng_clone_word_v1)
(extern i64 g3r-test-rng-clone-state ptr
        :real et_g3t_test_rng_clone_state_v1)
(extern i64 g3r-test-rng-clone-busy-set ptr i64
        :real et_g3t_test_rng_clone_busy_set_v1)
(extern i64 g3r-test-rng-word ptr i64
        :real et_g3t_test_rng_word_v1)
(extern i64 g3r-test-cache-length ptr
        :real et_g3t_test_cache_length_v1)
(extern i64 g3r-test-pin-count ptr
        :real et_g3t_test_pin_count_v1)
(extern i64 g3r-test-output-word ptr i64
        :real et_g3t_test_output_word_v1)
(extern i64 g3r-test-logit-bits ptr i64
        :real et_g3t_test_logit_bits_v1)
(extern i64 g3r-test-fail-alloc-after i64
        :real et_g3t_test_fail_alloc_after_v1)
(extern ptr g3r-native-direct-create i64 i64 i64 i64
        :real et_g3t_private_rng_words_create_v1)
(extern i64 g3r-native-direct-release ptr
        :real et_g3t_private_rng_release_v1)
(extern ptr g3r-native-generator-rng ptr ptr i64 i64 i64 i64 i64 i64
        :real et_g3t_private_generator_rng_v1)
(extern i64 g3r-native-idle-rng-equal ptr i64 i64 i64 i64
        :real et_g3t_private_idle_rng_words_equal_v1)
(extern i64 g3r-native-call-acquire ptr i64
        :real et_g3t_private_call_acquire_v1)
(extern i64 g3r-native-call-abort ptr
        :real et_g3t_private_call_abort_v1)
(extern ptr g3r-native-output-reserve ptr i64
        :real et_g3t_private_output_reserve_v1)
(extern i64 g3r-native-error-domain
        :real et_g3t_private_last_error_domain_v1)
(extern i64 g3r-native-error-category
        :real et_g3t_private_last_error_category_v1)
(extern i64 g3r-native-error-code
        :real et_g3t_private_last_error_code_v1)
(extern i64 g3r-allocation-arm i64 i64
        :real et_g3r_rng_alloc_arm_v1)
(extern i64 g3r-allocation-consumed
        :real et_g3r_rng_alloc_consumed_v1)
(extern i64 g3r-allocation-disarm
        :real et_g3r_rng_alloc_disarm_v1)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "G3-R typed RNG import FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label
    (guard (caught (#t (and caught (not (vector-ref m3-call-state 0)))))
      (thunk) #f)))
(define (rng-policy source mode)
  (list ':profile 'diagnostic-c2 ':sampling mode
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos #f ':rng source))
(define (seed-policy seed)
  (list ':profile 'diagnostic-c2 ':sampling 'categorical
        ':temperature-bits #x3f800000 ':top-k 256
        ':top-p-bits #x3f800000 ':max-new-tokens 1
        ':eos #f ':seed seed))
(define (live-rng-shells)
  (let loop ((tail (vector-ref g3t-registry 0)) (count 0))
    (if (null? tail) count
        (let ((entry (car tail)))
          (loop (cdr tail)
                (if (and (eq? (vector-ref entry 1) 'rng)
                         (eq? (vector-ref entry 2) 'live))
                    (+ count 1) count))))))
(define (word-matrix version seed low high)
  (let* ((shell (g3r-rng-owner-from-checked-words version seed low high))
         (entry (g3t-prefill-entry shell 'rng 'g3r-matrix))
         (native (vector-ref entry 3)))
    (check "live exact 12-slot owned entry"
           (and (= 12 (vector-length entry))
                (eq? (vector-ref entry 2) 'live)
                (eq? (vector-ref entry 10) #f)
                (eq? (vector-ref entry 11) 'diagnostic-c2)
                (= 1 (g3r-test-rng-clone-state native))))
    (check "all four signed words bit-exact"
           (and (= version (g3r-test-rng-clone-word native 0))
                (= seed (g3r-test-rng-clone-word native 1))
                (= low (g3r-test-rng-clone-word native 2))
                (= high (g3r-test-rng-clone-word native 3))))
    (check "typed release" (g3t-generation-rng-release! shell))
    (check "idempotent typed release" (g3t-generation-rng-release! shell))
    (check "native zeroing and tombstone"
           (and (eq? (vector-ref entry 2) 'dead)
                (= -1 (g3r-test-rng-clone-state native))
                (= 0 (g3r-test-rng-clone-word native 0))
                (= 0 (g3r-test-rng-clone-word native 1))
                (= 0 (g3r-test-rng-clone-word native 2))
                (= 0 (g3r-test-rng-clone-word native 3))))))

(check "root initially empty" (= 0 (g3r-test-live-rng-clones)))
(reject "invalid version" (lambda ()
  (g3r-rng-owner-from-checked-words 2 7 0 0)))
(reject "negative seed" (lambda ()
  (g3r-rng-owner-from-checked-words 1 -1 0 0)))
(reject "overwide seed" (lambda ()
  (g3r-rng-owner-from-checked-words 1 9223372036854775808 0 0)))
(reject "overwide counter" (lambda ()
  (g3r-rng-owner-from-checked-words 1 7 -9223372036854775809 0)))
(check "bad scalars create no clone" (= 0 (g3r-test-live-rng-clones)))
(check "arm native allocation cut" (= 0 (g3r-test-fail-alloc-after 0)))
(reject "native allocation cut" (lambda ()
  (g3r-rng-owner-from-checked-words 1 7 0 0)))
(check "cut tombstones pending entry without clone"
       (and (= 0 (g3r-test-live-rng-clones))
            (let ((entry (car (vector-ref g3t-registry 0))))
              (and (eq? (vector-ref entry 2) 'dead)
                   (eq? (vector-ref entry 10) #f)))))
(check "disarm native allocation cut"
       (= 0 (g3r-test-fail-alloc-after 9223372036854775807)))

(define (sweep-allocation kind)
  (let loop ((index 0))
    (if (> index 24) (exit 4))
    (let ((caught #f) (created #f))
      (check "arm Eshkol allocation cut"
             (= 0 (g3r-allocation-arm kind index)))
      (guard (condition (#t (set! caught condition)))
        (set! created (g3r-rng-owner-from-checked-words 1 7 0 0)))
      (let* ((consumed (g3r-allocation-consumed))
            (seen (g3r-allocation-disarm)))
        (if (= consumed 1)
            (begin
              (check "Eshkol allocation cut caught and unheld"
                     (and caught (not (vector-ref m3-call-state 0))
                          (= seen (+ index 1))))
              (check "Eshkol allocation cut leaves no live shell or clone"
                     (and (= 0 (live-rng-shells))
                          (= 0 (g3r-test-live-rng-clones))))
              (loop (+ index 1)))
            (begin
              (check "Eshkol allocation sweep reaches successful tail"
                     (and (not caught) created))
              (check "post-cut owner release"
                     (g3t-generation-rng-release! created))
              index))))))
(define vector-cuts (sweep-allocation 1))
(define cons-cuts (sweep-allocation 2))
(check "Eshkol vector/cons allocation cuts reached"
       (and (>= vector-cuts 3) (>= cons-cuts 1)
            (= 0 (g3r-test-live-rng-clones))))

(word-matrix 1 0 0 0)
(word-matrix 1 9223372036854775807 -9223372036854775808
             9223372036854775807)
(word-matrix 1 1729 -1 0)
(word-matrix 1 1729 -2 -1)
(word-matrix 1 1729 -1 -1)

(define config
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define initial (g3t-checked-m3t-initializer-state 1729))
(define model
  (with-region ('g3r-rng-model 65536)
    (g3t-checked-m3t-model-create config initial)))
(define tokenizer (t1-private-tokenizer-byte config))
(check "model eval" (module-eval! model))
(define model-entry (m3t-entry model 'model 'g3r-import #t))
(check "foreign M3 registry pointer rejected as native G3-T RNG"
       (null? (g3r-native-generator-rng
                (vector-ref model-entry 3) (vector-ref model-entry 3)
                0 #x3f800000 256 #x3f800000 1 -1)))

(define (rng-equal-status native version seed low high category code)
  (let ((status (g3r-native-idle-rng-equal native version seed low high)))
    (and (= status category)
         (= (g3r-native-error-domain) 0)
         (= (g3r-native-error-category) category)
         (= (g3r-native-error-code) code))))
(define (rng-equal-case seed low high)
  (let* ((source (g3r-rng-owner-from-checked-words 1 seed low high))
         (source-native (vector-ref (g3t-prefill-entry source 'rng 'equal) 3))
         (generator (g3t-generator-create model tokenizer
                      (rng-policy source 'greedy)))
         (native (vector-ref (g3t-generator-find generator 'equal) 3))
         (live-count (g3t-test-live-contexts)))
    (check "genuine imported generator exact idle RNG equality"
           (rng-equal-status native 1 seed low high 0 0))
    (check "source RNG remains independent and live"
           (and (= 1 (g3r-test-rng-clone-state source-native))
                (= low (g3r-test-rng-clone-word source-native 2))
                (= high (g3r-test-rng-clone-word source-native 3))))
    (check "wrong version and seed provenance"
           (and (rng-equal-status native 2 seed low high 1 3)
                (rng-equal-status native 1 -1 low high 1 3)))
    (check "version validation and seed/counter mismatches"
           (and (rng-equal-status native 0 seed low high 1 3)
                (rng-equal-status native 1 (if (= seed 0) 1 0)
                                  low high 2 10)
                (rng-equal-status native 1 seed
                                  (if (= low 0) 1 0) high 2 10)
                (rng-equal-status native 1 seed low
                                  (if (= high 0) 1 0) 2 10)))
    (check "wrong-kind and foreign generator identity"
           (and (rng-equal-status source-native 1 seed low high 1 1)
                (rng-equal-status (vector-ref model-entry 3)
                                  1 seed low high 1 1)
                (rng-equal-status (vector 'foreign)
                                  1 seed low high 1 1)))
    (check "RNG mismatch leaves context and source intact"
           (and (= live-count (g3t-test-live-contexts))
                (= 0 (g3r-test-cache-length native))
                (= 0 (g3r-test-pin-count native))
                (= low (g3r-test-rng-word native 2))
                (= high (g3r-test-rng-word native 3))
                (= 1 (g3r-test-rng-clone-state source-native))))
    (check "authentic active call holds pins"
           (and (= 0 (g3r-native-call-acquire native 0))
                (= 14 (g3r-test-pin-count native))))
    (check "busy frame and pins reject equality"
           (rng-equal-status native 1 seed low high 2 2))
    (check "abort restores idle equality"
           (and (= 0 (g3r-native-call-abort native))
                (rng-equal-status native 1 seed low high 0 0)))
    (check "real pending output is owned by an active call"
           (and (= 0 (g3r-native-call-acquire native 2))
                (not (null? (g3r-native-output-reserve native 1)))))
    (check "pending output rejects equality without changing RNG"
           (and (rng-equal-status native 1 seed low high 2 2)
                (= low (g3r-test-rng-word native 2))
                (= high (g3r-test-rng-word native 3))))
    (check "pending output abort restores equality"
           (and (= 0 (g3r-native-call-abort native))
                (rng-equal-status native 1 seed low high 0 0)))
    (check "source release does not change current generator"
           (and (g3t-generation-rng-release! source)
                (rng-equal-status native 1 seed low high 0 0)))
    (check "generator close and stale lifecycle"
           (and (g3t-generator-close! generator)
                (rng-equal-status native 1 seed low high 2 2)
                (= (- live-count 1) (g3t-test-live-contexts))))))

(rng-equal-case 0 0 0)
(rng-equal-case 9223372036854775807 -9223372036854775808
                9223372036854775807)
(rng-equal-case 1729 -1 0)
(rng-equal-case 1729 -2 -1)
(rng-equal-case 1729 -1 -1)

(define manual-source (g3r-rng-owner-from-checked-words 1 1729 -2 -1))
(define manual-generator
  (g3t-generator-create model tokenizer (rng-policy manual-source 'greedy)))
(define manual-native
  (vector-ref (g3t-generator-find manual-generator 'equal-manual) 3))
(define manual-input (g3t-generation-token-input-create 65))
(check "manual generator starts with exact imported current RNG"
       (rng-equal-status manual-native 1 1729 -2 -1 0 0))
(define manual-logits (g3m-prefill-p1! manual-generator manual-input))
(check "real manual prefill and call-finish retain idle RNG"
       (and (= 1 (g3r-test-cache-length manual-native))
            (= 0 (g3r-test-pin-count manual-native))
            (>= (g3r-test-logit-bits manual-native 0) 0)
            (rng-equal-status manual-native 1 1729 -2 -1 0 0)))
(define lease-input (g3t-checked-m3t-input-create))
(check "model lease input" (g3t-checked-m3t-input-copy! lease-input '(17 19)))
(define lease-workspace (g3t-checked-m3t-workspace-create model))
(check "genuine model lease begins"
       (g3t-checked-m3t-workspace-begin! lease-workspace lease-input))
(check "idle generator rejects held model lease"
       (rng-equal-status manual-native 1 1729 -2 -1 2 2))
(check "model lease release permits exact equality"
       (and (g3t-checked-m3t-workspace-reset! lease-workspace)
            (rng-equal-status manual-native 1 1729 -2 -1 0 0)))
(check "model lease cleanup"
       (and (g3t-checked-m3t-workspace-release! lease-workspace)
            (g3t-checked-m3t-input-release! lease-input)))
(check "arm native allocation denial for equality"
       (= 0 (g3r-test-fail-alloc-after 0)))
(check "idle equality needs no native G3-T allocation"
       (rng-equal-status manual-native 1 1729 -2 -1 0 0))
(check "disarm native allocation denial"
       (= 0 (g3r-test-fail-alloc-after 9223372036854775807)))
(check "detached logits and import owner release preserve equality"
       (and (g3t-generation-tensor-release! manual-logits)
            (g3t-generation-tensor-release! manual-input)
            (g3t-generation-rng-release! manual-source)
            (rng-equal-status manual-native 1 1729 -2 -1 0 0)))
(check "manual generator cleanup" (g3t-generator-close! manual-generator))

(define predecessor-generator
  (g3t-generator-create model tokenizer (seed-policy 1729)))
(define predecessor-input (g3t-generation-token-input-create 65))
(define predecessor-output
  (g3m-generate-p1-g1! predecessor-generator predecessor-input))
(define predecessor-clone (g3t-generation-output-rng predecessor-output))
(define predecessor-native
  (vector-ref (g3t-prefill-entry predecessor-clone 'rng 'g3r-predecessor) 3))
(check "genuine published-output RNG predecessor words"
       (and (= 1 (g3r-test-rng-clone-word predecessor-native 0))
            (= 1729 (g3r-test-rng-clone-word predecessor-native 1))
            (= 1 (g3r-test-rng-clone-word predecessor-native 2))
            (= 0 (g3r-test-rng-clone-word predecessor-native 3))))
(check "published-output clone survives its generator and output"
       (and (g3t-output-release! predecessor-output)
            (g3t-generation-tensor-release! predecessor-input)
            (g3t-generator-close! predecessor-generator)
            (= 1 (g3r-test-rng-clone-state predecessor-native))))
(define imported-successor (g3r-rng-owner-from-checked-words 1 1729 1 0))
(define imported-successor-native
  (vector-ref (g3t-prefill-entry imported-successor 'rng 'g3r-predecessor) 3))
(check "imported four words equal authentic output-clone predecessor"
       (let compare ((index 0))
         (if (= index 4) #t
             (and (= (g3r-test-rng-clone-word predecessor-native index)
                     (g3r-test-rng-clone-word imported-successor-native index))
                  (compare (+ index 1))))))
(define clone-derived
  (g3t-generator-create model tokenizer
    (rng-policy predecessor-clone 'categorical)))
(define imported-derived
  (g3t-generator-create model tokenizer
    (rng-policy imported-successor 'categorical)))
(define clone-derived-native
  (vector-ref (g3t-generator-find clone-derived 'g3r-predecessor) 3))
(define imported-derived-native
  (vector-ref (g3t-generator-find imported-derived 'g3r-predecessor) 3))
(check "both authentic clone and imported owner seed equivalent contexts"
       (let compare ((index 0))
         (if (= index 4) #t
             (and (= (g3r-test-rng-word clone-derived-native index)
                     (g3r-test-rng-word imported-derived-native index))
                  (compare (+ index 1))))))
(check "predecessor shell independent release and context cleanup"
       (and (g3t-generation-rng-release! predecessor-clone)
            (g3t-generation-rng-release! imported-successor)
            (= -1 (g3r-test-rng-clone-state predecessor-native))
            (= -1 (g3r-test-rng-clone-state imported-successor-native))
            (g3t-generator-close! clone-derived)
            (g3t-generator-close! imported-derived)))

(define (oracle-run low high expected-low expected-high mode)
  (let* ((source (g3r-rng-owner-from-checked-words 1 1729 low high))
         (source-entry (g3t-prefill-entry source 'rng 'g3r-run))
         (native-source (vector-ref source-entry 3))
         (generator (g3t-generator-create model tokenizer
                      (rng-policy source mode)))
         (native-generator (vector-ref (g3t-generator-find generator 'g3r-run) 3)))
    (check "constructor copies all four imported words"
           (and (= 1 (g3r-test-rng-word native-generator 0))
                (= 1729 (g3r-test-rng-word native-generator 1))
                (= low (g3r-test-rng-word native-generator 2))
                (= high (g3r-test-rng-word native-generator 3))))
    (check "source shell release independent of generator"
           (g3t-generation-rng-release! source))
    (check "source native scrubbed after generator copy"
           (= -1 (g3r-test-rng-clone-state native-source)))
    (let* ((input (g3t-generation-token-input-create 65))
           (output (g3m-generate-p1-g1! generator input))
           (native-output (vector-ref (g3t-prefill-entry output 'output 'g3r-run) 3))
           (output-clone (g3t-generation-output-rng output))
           (native-clone (vector-ref
                           (g3t-prefill-entry output-clone 'rng 'g3r-run) 3))
           (id (g3r-test-output-word native-output 6)))
      (check "successor words match independent carry expectation"
             (and (= expected-low (g3r-test-rng-word native-generator 2))
                  (= expected-high (g3r-test-rng-word native-generator 3))))
      (display "G3R_ORACLE ") (display mode) (display " ")
      (display 1729) (display " ") (display low) (display " ")
      (display high) (display " ") (display id)
      (let emit-state ((index 0))
        (if (< index 4)
            (begin (display " ")
                   (display (g3r-test-rng-word native-generator index))
                   (emit-state (+ index 1)))))
      (let emit-clone ((index 0))
        (if (< index 4)
            (begin (display " ")
                   (display (g3r-test-rng-clone-word native-clone index))
                   (emit-clone (+ index 1)))))
      (let emit ((index 0))
        (if (< index 256)
            (begin (display " ")
                   (display (g3r-test-logit-bits native-generator index))
                   (emit (+ index 1)))))
      (newline)
      (check "output release" (g3t-output-release! output))
      (check "input release" (g3t-generation-tensor-release! input))
      (check "output RNG clone survives output release"
             (= 1 (g3r-test-rng-clone-state native-clone)))
      (check "output RNG clone typed release"
             (g3t-generation-rng-release! output-clone)))
    (check "generator close" (g3t-generator-close! generator))))

(oracle-run -1 0 0 1 'categorical)
(oracle-run -2 -1 -1 -1 'categorical)
(oracle-run -1 -1 -1 -1 'greedy)

(define exhausted (g3r-rng-owner-from-checked-words 1 1729 -1 -1))
(define exhausted-generator
  (g3t-generator-create model tokenizer (rng-policy exhausted 'categorical)))
(define exhausted-native
  (vector-ref (g3t-generator-find exhausted-generator 'g3r-exhausted) 3))
(define exhausted-input (g3t-generation-token-input-create 65))
(reject "exhaustion before categorical draw" (lambda ()
  (g3m-generate-p1-g1! exhausted-generator exhausted-input)))
(check "exhaustion preserves full RNG"
       (and (= 1 (g3r-test-rng-word exhausted-native 0))
            (= 1729 (g3r-test-rng-word exhausted-native 1))
            (= -1 (g3r-test-rng-word exhausted-native 2))
            (= -1 (g3r-test-rng-word exhausted-native 3))
            (= 0 (g3r-test-cache-length exhausted-native))
            (= 0 (g3r-test-pin-count exhausted-native))))
(check "exhausted cleanup"
       (and (g3t-generation-tensor-release! exhausted-input)
            (g3t-generator-close! exhausted-generator)
            (g3t-generation-rng-release! exhausted)))

(define forged (vector 'g3t-rng-private))
(reject "forged shell rejected" (lambda ()
  (g3t-generator-create model tokenizer (rng-policy forged 'greedy))))
(define stale (g3r-rng-owner-from-checked-words 1 99 0 0))
(check "stale release" (g3t-generation-rng-release! stale))
(reject "stale shell rejected" (lambda ()
  (g3t-generator-create model tokenizer (rng-policy stale 'greedy))))
(define busy (g3r-rng-owner-from-checked-words 1 99 0 0))
(define busy-native (vector-ref (g3t-prefill-entry busy 'rng 'g3r-busy) 3))
(check "set busy" (= 0 (g3r-test-rng-clone-busy-set busy-native 1)))
(reject "busy source rejected" (lambda ()
  (g3t-generator-create model tokenizer (rng-policy busy 'greedy))))
(check "clear busy" (= 0 (g3r-test-rng-clone-busy-set busy-native 0)))
(check "busy source release" (g3t-generation-rng-release! busy))
(define direct (g3r-native-direct-create 1 99 0 0))
(reject "raw native pointer not Eshkol owner" (lambda ()
  (g3t-generator-create model tokenizer (rng-policy direct 'greedy))))
(check "direct native cleanup" (= 0 (g3r-native-direct-release direct)))
(check "all native clones released" (= 0 (g3r-test-live-rng-clones)))
(display "G3-R typed RNG import PASS: checks=") (display checks) (newline)
