;;; Tuple-local exact guard forms copied from root0064. No numerical M3T
;;; transport/model declaration or authority is loaded by this CPU4 consumer.
;;; Keep original names/semantics for unchanged C4 and binding source users.

(define (m3t-fail-raw category operation message)
  (let* ((native-category
           (cond ((eq? category 'invalid-argument) 1)
                 ((eq? category 'invalid-state) 2)
                 ((eq? category 'shape-mismatch) 3)
                 ((eq? category 'unsupported) 4) (else 5)))
         (code (cond ((= native-category 1) 1) ((= native-category 2) 2)
                     ((= native-category 3) 4) ((= native-category 4) 8) (else 10)))
         (unreachable
           (et-e1b-private-raise category operation message
             (list (list 'source-domain 'm3t-transport)
                   (list 'source-code code)
                   (list 'source-message message)
                   (list 'native-category native-category)) #f)))
    unreachable))

(define-syntax m3t-fail
  (syntax-rules ()
    ((_ category operation message)
     (let ((result (m3t-fail-raw category operation message))) result))))

(define (m3t-rethrow-raw caught operation)
  (let ((unreachable
          (if (transformer-error? caught)
              ;; Our fixed-operation errors already snapshot bounded native
              ;; details before cleanup. Dependency errors use another operation
              ;; and may contain context graphs, so replace their details.
              (if (eq? (transformer-error-operation caught) operation)
                  (et-e1b-private-raise
                    (transformer-error-category caught) operation
                    "diagnostic transport rejected the request"
                    (transformer-error-details caught) #f)
                  (m3t-fail (transformer-error-category caught) operation
                    "diagnostic dependency rejected the request"))
              (m3t-fail 'internal operation
                "diagnostic dependency raised a foreign value"))))
    unreachable)
  :runtime-emergency-rethrow-param caught)

(define-syntax m3t-boundary
  (syntax-rules ()
    ((_ operation body ...)
     (guard (caught (#t (let ((result (m3t-rethrow-raw caught operation))) result)))
       body ...))))

(define (m3t-exact-i64? value)
  (and (integer? value) (exact? value) (real? value)
       (>= value -9223372036854775808) (<= value 9223372036854775807)))

(define m3-call-state (vector #f))

(define-syntax m3-call
  (syntax-rules ()
    ((_ operation body ...)
     (m3t-boundary operation
       (if (vector-ref m3-call-state 0)
           (m3t-fail 'invalid-state operation "model operation is already active"))
       (guard (caught (#t (begin (vector-set! m3-call-state 0 #f)
                                (m3t-rethrow-raw caught operation))))
         ;; Install cleanup before publishing the busy state. If handler
         ;; allocation fails, the outer boundary observes an idle call guard.
         (vector-set! m3-call-state 0 #t)
         (let ((answer (begin body ...)))
           (vector-set! m3-call-state 0 #f)
           answer))))))
