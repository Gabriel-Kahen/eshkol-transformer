;;; Trusted MOD5 width-16 V256 staging policy. Load after the C2 aggregate.
;;; This checks staged controls and metadata before any I2 decode. It never
;;; selects a provider and receives only the aggregate's authenticated stage.

(define c2-mod5-v256-roster
  '((("blocks" "0" "attention" "key" "weight") (8 16))
    (("blocks" "0" "attention" "output" "weight") (16 16))
    (("blocks" "0" "attention" "query" "weight") (16 16))
    (("blocks" "0" "attention" "value" "weight") (8 16))
    (("blocks" "0" "ffn" "down" "weight") (16 32))
    (("blocks" "0" "ffn" "gate" "weight") (32 16))
    (("blocks" "0" "ffn" "up" "weight") (32 16))
    (("blocks" "0" "norm1" "weight") (16))
    (("blocks" "0" "norm2" "weight") (16))
    (("head" "weight") (256 16))
    (("norm_final" "weight") (16))
    (("token_embedding" "weight") (256 16))))

(define c2-mod5-v256-tie '(9 11))

(define (c2-mod5-v256-controls-match? controls operation)
  (let* ((rng (vector-ref controls 0))
         (tokenizer (vector-ref controls 1))
         (cursors (vector-ref controls 2))
         (current (c2-d2-decode (vector-ref cursors 0) operation))
         (manifest (vector-ref controls 3))
         (request (vector (vector-ref manifest 0) (vector-ref manifest 1)
                          operation #f)))
    (x1-canonical-inspect-internal request)
    (and (eq? (c2-d2-fingerprint-family (vector-ref tokenizer 0)) 't1-byte)
         (= (vector-ref current 4) 1)
         (= (vector-ref current 5) 8)
         (not (vector-ref current 12))
         (equal? (vector-ref request 3)
                 (vector 'eshkol-resolved-run 1 0 256 8 16 1 4 2 4
                         'f32 'cpu #t (vector-ref rng 2) 1)))))

;;; The native stage validated this C1 table, including equal aliased
;;; payload bytes. This bounded projection reads only its model metadata.
(define (c2-mod5-v256-model-roster-match? model tied?)
  (let* ((payload (c2-load-u64 model 64))
         (provider-length (c2-load-u32 model 88))
         (first (+ 128 provider-length)))
    (and (= (c2-load-u32 model 80) 12)
         (= (c2-load-u64 model 72) 42176)
         (= (c2-load-u32 model 84) (if tied? 1 0))
         (string=? (utf8->string (bytevector-copy model 128 first))
                   (symbol->string i2-provider-name))
         (let loop ((at first) (remaining c2-mod5-v256-roster))
           (if (null? remaining)
               (if tied?
                   (and (= (+ at 16) payload)
                        (= (c2-load-u32 model at) 2)
                        (= (c2-load-u32 model (+ at 4)) 0)
                        (= (c2-load-u32 model (+ at 8)) (car c2-mod5-v256-tie))
                        (= (c2-load-u32 model (+ at 12)) (cadr c2-mod5-v256-tie)))
                   (= at payload))
               (let* ((row (car remaining))
                      (rank (c2-load-u16 model (+ at 30)))
                      (segments (c2-load-u16 model (+ at 28)))
                      (shape-start (+ at 80))
                      (path-start (+ shape-start (* 8 rank)))
                      (path (c2-load-copy-path model path-start segments))
                      (next (+ at (c2-load-u64 model at))))
                 (and (= (vector-ref path 1) next) (<= next payload)
                      (= (bytevector-u8-ref model (+ at 32)) 1)
                      (= (bytevector-u8-ref model (+ at 33)) 3)
                      (= (bytevector-u8-ref model (+ at 34)) 1)
                      (= (bytevector-u8-ref model (+ at 35)) 1)
                      (equal? (vector-ref path 0) (car row))
                      (equal? (c2-load-copy-shape model shape-start rank) (cadr row))
                      (loop next (cdr remaining)))))))))

(define (c2-mod5-v256-optimizer-roster-match? projection tied?)
  (let ((paths (vector-ref projection 1))
        (entries (vector-ref projection 2))
        (count (if tied? 11 12)))
    (and (= (vector-length entries) count)
         (let loop ((index 0) (rows c2-mod5-v256-roster) (remaining paths))
           (if (= index count)
               (null? remaining)
               (and (pair? remaining)
                    (let* ((expected (car rows))
                           (entry (vector-ref entries index))
                           (shape (cadr expected))
                           (bytes (* 4 (c1-shape-product shape 'checkpoint-load))))
                      (and (equal? (car expected) (car remaining))
                           (equal? (car expected) (vector-ref entry 0))
                           (equal? shape (vector-ref entry 1))
                           (= bytes (bytevector-length (vector-ref entry 2)))
                           (= bytes (bytevector-length (vector-ref entry 3)))
                           (loop (+ index 1) (cdr rows) (cdr remaining))))))))))

(define (c2-mod5-v256-check-stage! shell tied?)
  (let* ((operation 'checkpoint-load)
         (entry (c2-load-find-stage shell)))
    (if (or (not entry) (not (boolean? tied?)))
        (c2-load-fail 'invalid-argument operation
                      "expected exact MOD5 V256 staging and topology" '()))
    (if (not (eq? (vector-ref entry 2) 'live))
        (c2-load-fail 'invalid-state operation
                      "MOD5 V256 checkpoint staging is consumed or busy" '()))
    (if (not (c2-mod5-v256-controls-match? (vector-ref entry 5) operation))
        (c2-load-fail 'shape-mismatch operation
                      "checkpoint T1, D2, or X1 differs from the MOD5 V256 training profile" '()))
    (if (or (not (c2-mod5-v256-model-roster-match? (vector-ref entry 3) tied?))
            (not (c2-mod5-v256-optimizer-roster-match? (vector-ref entry 4) tied?)))
        (c2-load-fail 'shape-mismatch operation
                      "checkpoint model or optimizer roster differs from MOD5 V256" '()))
    #t))
