;;; Focused lifetime proof for the private P1 shell registry.
;;;
;;; The child shell is first published while nested scratch regions are active.
;;; Returning that shell does not itself retain the private registry entry or
;;; registry-list spine.  A later sibling region must therefore recover the
;;; exact canonical shell through the root-owned registry holder after the
;;; creating regions have been poisoned and destroyed.

(require transformer.module)
(require p1_test.tensor_provider)

(define checks 0)

(define (check label condition)
  (if condition
      (set! checks (+ checks 1))
      (begin
        (display "P1 registry publication FAIL: ")
        (display label)
        (newline)
        (exit 1))))

(define parent (module-create-internal))
(define child
  (with-region ('p1-registry-outer 65536)
    (with-region ('p1-registry-inner 65536)
      (module-create-internal))))

(check "shell survives destroyed nested publication regions"
       (eq? (module-mode-internal child) 'train))

;; Child registration asks shell-for-raw for the already-published child raw
;; value.  Exact identity proves traversal of the promoted registry graph.
(with-region ('p1-registry-sibling 65536)
  (check "sibling lookup returns exact canonical shell"
         (eq? child
              (module-register-child-internal! parent "child" child)))
  (check "canonical shell remains usable in sibling region"
         (eq? (module-mode-internal child) 'train)))

(check "canonical shell remains usable after sibling destruction"
       (eq? (module-mode-internal child) 'train))

;; Provider admission rewrites the opaque shell from the unsealed input to the
;; admitted snapshot, then publishes that exact canonical snapshot through the
;; provider registry. Both registries must survive the nested poisoned arenas.
(define region-provider-error #f)
(define region-provider-published?
  (guard (raised
           (#t
             (set! region-provider-error raised)
             #f))
    (with-region ('p1-provider-outer 1048576)
      (with-region ('p1-provider-inner 1048576)
        (begin
          (fixture-register-region-provider-internal!)
          #t)))))
(if region-provider-error
    (begin
      (display "P1 registry publication provider error: ")
      (if (transformer-error? region-provider-error)
          (begin
            (display (transformer-error-category region-provider-error))
            (display " ")
            (display (transformer-error-operation region-provider-error))
            (display " ")
            (display (transformer-error-message region-provider-error)))
          (display region-provider-error))
      (newline)
      (exit 1)))
(check "nested provider publication completes"
       region-provider-published?)
(define region-provider
  (tensor-provider-preflight-internal 'region-publication-v1 2 0))

(with-region ('p1-provider-sibling 1048576)
  (check "provider lookup returns exact canonical admitted identity"
         (eq? region-provider
              (tensor-provider-preflight-internal
                'region-publication-v1 2 0)))
  (check "canonical provider remains usable in sibling region"
         (eq? (module-mode-internal
                (module-create-with-provider-internal
                  'region-publication-v1))
              'train)))

(check "provider survives sibling destruction"
       (eq? region-provider
            (tensor-provider-preflight-internal
              'region-publication-v1 2 0)))

;; Parameter registration publishes the handle shell before committing the
;; binding. The pending binding must be rewritten to the canonical raw handle.
(define parameter-case
  (with-region ('p1-parameter-outer 1048576)
    (with-region ('p1-parameter-inner 1048576)
      (let* ((module (module-create-fixture-internal))
             (handle
               (module-register-parameter-internal!
                 module "weight"
                 (fixture-tensor-internal '(2) 'f32 'cpu
                                          (vector 'weight 'bits-v1)))))
        (vector module handle)))))
(define parameter-module (vector-ref parameter-case 0))
(define parameter-handle (vector-ref parameter-case 1))

(with-region ('p1-parameter-sibling 1048576)
  (check "tied binding returns exact canonical parameter handle"
         (eq? parameter-handle
              (module-register-tied-parameter-internal!
                parameter-module "weight-tied" parameter-handle)))
  (check "canonical parameter handle remains usable"
         (equal? '(2) (parameter-handle-shape parameter-handle))))

(check "parameter handle survives sibling destruction"
       (eq? 'f32 (parameter-handle-dtype parameter-handle)))

;; State publication uses the same staged active-record path. A later sibling
;; lookup and release must use the canonical record after region destruction.
(define state-seed (module-state-dict (module-create-fixture-internal)))
(define region-state-error #f)
(define region-state
  (guard (raised
           (#t (set! region-state-error raised) #f))
    (with-region ('p1-state-outer 8388608)
      (with-region ('p1-state-inner 8388608)
        (state-dict-create-unsafe-internal
          (state-dict-format-internal state-seed) 1 0 '()
          (state-dict-adapter-internal state-seed) '() '())))))
(if region-state-error
    (begin
      (display "P1 region state error: ")
      (if (transformer-error? region-state-error)
          (begin
            (display (transformer-error-category region-state-error))
            (display " ")
            (display (transformer-error-operation region-state-error))
            (display " ")
            (display (transformer-error-message region-state-error)))
          (display region-state-error))
      (newline)
      (exit 1)))
(state-dict-bind-provider-internal! region-state 'fixture-v1)
(check "state survives destroyed nested publication regions"
       (null? (state-dict-paths region-state)))
(with-region ('p1-state-sibling 1048576)
  (check "state remains usable in sibling region"
         (null? (state-dict-paths region-state))))

;; The two hot raw lookups publish a state-owned tensor and entry while
;; regional, then find those exact shells after the region has been poisoned.
(define indexed-module (module-create-fixture-internal))
(module-register-parameter-internal!
  indexed-module "weight"
  (fixture-tensor-internal '(2) 'f32 'cpu (vector 'indexed 'bits-v1)))
(define indexed-state (module-state-dict indexed-module))
(define indexed-path (car (state-dict-paths indexed-state)))
(define indexed-shells
  (with-region ('p1-indexed-outer 8388608)
    (with-region ('p1-indexed-inner 8388608)
      (vector (car (state-dict-entries-internal indexed-state))
              (state-dict-tensor indexed-state indexed-path)))))
(define indexed-entry (vector-ref indexed-shells 0))
(define indexed-tensor (vector-ref indexed-shells 1))
(with-region ('p1-indexed-sibling 8388608)
  (check "state entry lookup returns exact promoted shell"
         (eq? indexed-entry
              (car (state-dict-entries-internal indexed-state))))
  (check "state tensor lookup returns exact promoted shell"
         (eq? indexed-tensor
              (state-dict-tensor indexed-state indexed-path))))
(check "forged entry shell rejects"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-argument
                              (transformer-error-category raised)))))
         (state-entry-kind-internal (vector 'forged-entry))
         #f))
(check "forged tensor shell rejects"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-argument
                              (transformer-error-category raised)))))
         (state-dict-tensor-borrow-begin-internal
           indexed-state (vector 'forged-tensor))
         #f))
(check "indexed state release completes" (state-dict-release! indexed-state))
(check "released entry shell remains stale"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-state
                              (transformer-error-category raised)))))
         (state-entry-kind-internal indexed-entry)
         #f))
(check "released tensor shell remains stale"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-state
                              (transformer-error-category raised)))))
         (state-dict-tensor-borrow-begin-internal indexed-state indexed-tensor)
         #f))
(check "state release completes" (state-dict-release! region-state))
(state-dict-release! state-seed)
(check "released state remains stale"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-state
                              (transformer-error-category raised)))))
         (state-dict-paths region-state)
         #f))
(check "forged module shell rejects"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-argument
                              (transformer-error-category raised)))))
         (module-mode-internal (vector 'forged-module))
         #f))
(check "forged state shell rejects"
       (guard (raised
                (#t (and (transformer-error? raised)
                         (eq? 'invalid-argument
                              (transformer-error-category raised)))))
         (state-dict-release! (vector 'forged-state))
         #f))

(display "P1 REGISTRY PUBLICATION PASS: ")
(display checks)
(display " checks")
(newline)
