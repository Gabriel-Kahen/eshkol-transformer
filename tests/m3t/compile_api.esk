(require transformer.diagnostic_transport)
(define (m3t-api-contract first second)
  (diagnostic-initializer-state first)
  (diagnostic-initializer-algorithm first)
  (diagnostic-initializer-words first)
  (diagnostic-model-create first second)
  (diagnostic-model-profile first)
  (diagnostic-model-initializer first)
  (diagnostic-input-create)
  (diagnostic-input-copy! first second)
  (diagnostic-input-copy-tokenizer! first second)
  (diagnostic-input-release! first)
  (diagnostic-logits-create)
  (diagnostic-logits-copy-bits! first second)
  (diagnostic-logits-bits first)
  (diagnostic-logits-release! first)
  (diagnostic-workspace-create first)
  (diagnostic-workspace-begin! first second)
  (diagnostic-workspace-vjp-begin! first second)
  (diagnostic-workspace-copy-logits! first second)
  (diagnostic-workspace-check-primals first)
  (diagnostic-workspace-reset! first)
  (diagnostic-workspace-release! first)
  (diagnostic-embedding! first second)
  (diagnostic-linear! first second)
  (diagnostic-layer-norm! first second)
  (diagnostic-gelu! first)
  (diagnostic-residual! first second)
  (diagnostic-heads-split! first second)
  (diagnostic-heads-merge! first)
  (diagnostic-attention! first)
  (diagnostic-embedding-vjp! first second)
  (diagnostic-linear-vjp! first second)
  (diagnostic-layer-norm-vjp! first second)
  (diagnostic-gelu-vjp! first)
  (diagnostic-residual-vjp! first second)
  (diagnostic-heads-split-vjp! first second)
  (diagnostic-heads-merge-vjp! first)
  (diagnostic-attention-vjp! first)
  (diagnostic-sum! first second))
(display "M3T-COMPILE-API")
