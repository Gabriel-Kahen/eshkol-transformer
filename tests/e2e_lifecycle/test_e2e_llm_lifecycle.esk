;;; Compiled Eshkol AOT End-to-End Full LLM Lifecycle Suite (Stages 1-8).
;;; Composes DATA4 + T2 BPE + MOD5 RoPE + MOD5 AdamW (D1 .ets + ETM5TRN1 resume)
;;; + LoRA (ETLR1000) + DPO + EVAL5 + Speculative Decoding + IO5 Quantization
;;; across real multi-process OS save/reload boundaries.
;;;
;;; Invoked per phase as:
;;;   test_e2e_llm_lifecycle --phase <phase> --work-dir <dir>
;;; Phases:
;;;   stage1-2      : Stage 1 DATA4 hygiene/near-dedup + Stage 2a BPE train/save
;;;   stage2-3a     : Stage 2b fresh BPE reload/decode/shard + Stage 3a 8-step & 4-step split
;;;   stage3b-4a    : Stage 3b fresh snapshot resume parity + Stage 4a LoRA train/save
;;;   stage4b-8     : Stage 4b fresh LoRA reload + Stage 5 DPO + Stage 6a EVAL5
;;;                   + Stage 7 Spec Decode + Stage 8 IO5 F16/BF16/Q8_0
;;;   stage6-verify : Stage 6b fresh-process EVAL5 manifest reload & SHA-256 verify

(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 format-f64 ptr i64 char* f64 :real strfromd)

(extern i32 e2e-create ptr :real et_e2e_aot_create)
(extern void e2e-destroy ptr :real et_e2e_aot_destroy)

(extern i32 e2e-stage1-data4 ptr char* :real et_e2e_aot_run_stage1_data4)
(extern i32 e2e-stage2-train ptr char* :real et_e2e_aot_run_stage2_train_save)
(extern i32 e2e-stage2-reload ptr char* :real et_e2e_aot_run_stage2_reload_encode)
(extern i32 e2e-stage3-part1 ptr char* :real et_e2e_aot_run_stage3_pretrain_part1)
(extern i32 e2e-stage3-resume ptr char* :real et_e2e_aot_run_stage3_pretrain_resume)
(extern i32 e2e-stage4-train ptr char* :real et_e2e_aot_run_stage4_lora_train_save)
(extern i32 e2e-stage4-reload ptr char* :real et_e2e_aot_run_stage4_lora_reload)
(extern i32 e2e-stage5-dpo ptr char* :real et_e2e_aot_run_stage5_dpo)
(extern i32 e2e-stage6-eval5 ptr char* :real et_e2e_aot_run_stage6_eval5)
(extern i32 e2e-stage6-verify ptr char* :real et_e2e_aot_run_stage6_verify_fresh)
(extern i32 e2e-stage7-spec ptr char* :real et_e2e_aot_run_stage7_spec_decode)
(extern i32 e2e-stage8-io5 ptr char* :real et_e2e_aot_run_stage8_io5_quant)

(extern i64 e2e-get-i64 ptr i32 :real et_e2e_aot_get_i64)
(extern f64 e2e-get-f64 ptr i32 :real et_e2e_aot_get_f64)
(extern i32 e2e-get-sha256 ptr i32 ptr i64 :real et_e2e_aot_get_sha256_hex)
(extern i64 e2e-read-byte ptr i64 :real et_e2e_aot_read_byte)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define status-ok 0)

;; Integer metric IDs (e2e_lifecycle_eshkol_bridge.h)
(define m-s1-input-docs 100)
(define m-s1-kept-docs 101)
(define m-s1-dropped-exact 102)
(define m-s1-dropped-near 103)
(define m-s1-dropped-utf8 104)
(define m-s1-dropped-length 105)
(define m-s1-dropped-quality 106)
(define m-s1-kept-bytes 107)

(define m-s2-vocab-size 200)
(define m-s2-merge-count 201)
(define m-s2-bos-id 202)
(define m-s2-eos-id 203)
(define m-s2-raw-bytes 204)
(define m-s2-encoded-tokens 205)
(define m-s2-lossless-verified 206)
(define m-s2-reload-sha-match 207)

(define m-s3-param-count 300)
(define m-s3-shard-tokens 301)
(define m-s3-steps-full 302)
(define m-s3-steps-split 303)
(define m-s3-weights-bitwise-equal 304)
(define m-s3-snapshot-sha-equal 305)
(define m-s3-corrupt-rejected 306)

(define m-s4-rank 400)
(define m-s4-steps 401)
(define m-s4-base-frozen-equal 402)
(define m-s4-reload-equal 403)

(define m-s5-steps 500)
(define m-s5-ref-frozen-equal 501)

(define m-s6-contam-status 600)
(define m-s6-contam-manifest-absent 601)
(define m-s6-contam-docs-found 602)
(define m-s6-clean-contam-docs 603)
(define m-s6-fresh-reload-verified 604)

(define m-s7-horizon 700)
(define m-s7-greedy-emitted 701)
(define m-s7-greedy-accepted 702)
(define m-s7-greedy-exact-match 703)
(define m-s7-stoch-emitted 704)
(define m-s7-stoch-replay-match 705)
(define m-s7-eos-hit 706)
(define m-s7-eos-emitted 707)

(define m-s8-weight-count 800)
(define m-s8-q8-0-bytes 801)

;; Floating-point metric IDs
(define f-s2-compression-ratio 250)
(define f-s3-loss-step1 350)
(define f-s3-loss-step4 351)
(define f-s3-loss-step8 352)
(define f-s4-initial-loss 450)
(define f-s4-final-loss 451)
(define f-s4-merge-max-abs-err 452)
(define f-s4-unmerge-max-abs-err 453)
(define f-s5-initial-loss 550)
(define f-s5-final-loss 551)
(define f-s5-initial-margin 552)
(define f-s5-final-margin 553)
(define f-s5-final-accuracy 554)
(define f-s6-lm-mean-nll 650)
(define f-s6-lm-perplexity 651)
(define f-s6-mc-accuracy 652)
(define f-s8-f16-max-abs-err 850)
(define f-s8-bf16-max-abs-err 851)
(define f-s8-q8-0-max-abs-err 852)
(define f-s8-q8-0-rel-l2-err 853)

;; Digest IDs
(define d-s1-report 1)
(define d-s2-tokenizer 2)
(define d-s3-full-snap 3)
(define d-s3-resumed-snap 4)
(define d-s4-base-weight 5)
(define d-s4-lora-ckpt 6)
(define d-s5-ref-weight 7)
(define d-s6-manifest 8)

(define (fail-msg msg)
  (display "E2E AOT FAIL: ")
  (display msg)
  (newline)
  (exit 1))

(define (require-check label ok)
  (unless ok
    (fail-msg label)))

(define (expect-status label expected actual)
  (unless (= expected actual)
    (display "E2E AOT FAIL: ")
    (display label)
    (display " expected=") (display expected)
    (display " actual=") (display actual)
    (newline)
    (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "allocation failed" (not (= (ptr->usize p) 0)))
    p))

(define (display-cstr buf max-len)
  (let loop ((i 0))
    (when (< i max-len)
      (let ((b (e2e-read-byte (ffi-pointer buf) i)))
        (when (> b 0)
          (display (integer->char b))
          (loop (+ i 1)))))))

(define (display-f64-exact fmt-buf value)
  (let ((n (format-f64 (ffi-pointer fmt-buf) 64 "%.17g" value)))
    (require-check "strfromd failed" (and (> n 0) (< n 64)))
    (display-cstr fmt-buf 64)))

(define (display-digest ctx digest-id hex-buf)
  (expect-status "get-sha256" status-ok
                 (e2e-get-sha256 (ffi-pointer ctx) digest-id
                                 (ffi-pointer hex-buf) 80))
  (display-cstr hex-buf 65))

(define (create-ctx)
  (let ((cell (checked-allocate 8)))
    (expect-status "e2e-create" status-ok (e2e-create (ffi-pointer cell)))
    (let ((ctx (volatile-load ptr cell)))
      (release (ffi-pointer cell))
      (require-check "null e2e ctx" (not (= (ptr->usize ctx) 0)))
      ctx)))

(define (run-phase-stage1-2 work-dir)
  (let ((ctx (create-ctx))
        (hex-buf (checked-allocate 80))
        (fmt-buf (checked-allocate 64)))
    (expect-status "stage1-data4" status-ok
                   (e2e-stage1-data4 (ffi-pointer ctx) work-dir))
    (let ((in-docs (e2e-get-i64 (ffi-pointer ctx) m-s1-input-docs))
          (kept (e2e-get-i64 (ffi-pointer ctx) m-s1-kept-docs))
          (exact (e2e-get-i64 (ffi-pointer ctx) m-s1-dropped-exact))
          (near (e2e-get-i64 (ffi-pointer ctx) m-s1-dropped-near))
          (utf8 (e2e-get-i64 (ffi-pointer ctx) m-s1-dropped-utf8))
          (len-drop (e2e-get-i64 (ffi-pointer ctx) m-s1-dropped-length))
          (qual (e2e-get-i64 (ffi-pointer ctx) m-s1-dropped-quality))
          (kbytes (e2e-get-i64 (ffi-pointer ctx) m-s1-kept-bytes)))
      (require-check "s1 counts" (and (= in-docs 11) (= kept 6) (= exact 1)
                                      (= near 1) (= utf8 1) (= len-drop 1)
                                      (= qual 1)))
      (display "E2E STAGE1_DATA4 input=") (display in-docs)
      (display " kept=") (display kept)
      (display " exact_dup=") (display exact)
      (display " near_dup=") (display near)
      (display " bad_utf8=") (display utf8)
      (display " bad_len=") (display len-drop)
      (display " bad_qual=") (display qual)
      (display " kept_bytes=") (display kbytes)
      (display " report_sha256=") (display-digest ctx d-s1-report hex-buf)
      (newline))

    (expect-status "stage2-train" status-ok
                   (e2e-stage2-train (ffi-pointer ctx) work-dir))
    (let ((vocab (e2e-get-i64 (ffi-pointer ctx) m-s2-vocab-size))
          (merges (e2e-get-i64 (ffi-pointer ctx) m-s2-merge-count))
          (bos (e2e-get-i64 (ffi-pointer ctx) m-s2-bos-id))
          (eos (e2e-get-i64 (ffi-pointer ctx) m-s2-eos-id)))
      (require-check "s2 vocab" (and (> vocab 256) (> merges 0)))
      (display "E2E STAGE2A_BPE_TRAIN vocab=") (display vocab)
      (display " merges=") (display merges)
      (display " bos=") (display bos)
      (display " eos=") (display eos)
      (display " tokenizer_sha256=") (display-digest ctx d-s2-tokenizer hex-buf)
      (newline))

    (e2e-destroy (ffi-pointer ctx))
    (release (ffi-pointer hex-buf))
    (release (ffi-pointer fmt-buf))))

(define (run-phase-stage2-3a work-dir)
  (let ((ctx (create-ctx))
        (hex-buf (checked-allocate 80))
        (fmt-buf (checked-allocate 64)))
    (expect-status "stage2-reload" status-ok
                   (e2e-stage2-reload (ffi-pointer ctx) work-dir))
    (let ((vocab (e2e-get-i64 (ffi-pointer ctx) m-s2-vocab-size))
          (raw-bytes (e2e-get-i64 (ffi-pointer ctx) m-s2-raw-bytes))
          (enc-toks (e2e-get-i64 (ffi-pointer ctx) m-s2-encoded-tokens))
          (lossless (e2e-get-i64 (ffi-pointer ctx) m-s2-lossless-verified))
          (ratio (e2e-get-f64 (ffi-pointer ctx) f-s2-compression-ratio))
          (shard-toks (e2e-get-i64 (ffi-pointer ctx) m-s3-shard-tokens)))
      (require-check "s2 lossless" (= lossless 1))
      (require-check "s2 compression > 1.5x" (> ratio 1.5))
      (display "E2E STAGE2B_BPE_RELOAD vocab=") (display vocab)
      (display " raw_bytes=") (display raw-bytes)
      (display " encoded_tokens=") (display enc-toks)
      (display " compression=") (display-f64-exact fmt-buf ratio)
      (display " lossless=") (display lossless)
      (display " shard_tokens=") (display shard-toks)
      (display " tokenizer_sha256=") (display-digest ctx d-s2-tokenizer hex-buf)
      (newline))

    (expect-status "stage3-part1" status-ok
                   (e2e-stage3-part1 (ffi-pointer ctx) work-dir))
    (let ((params (e2e-get-i64 (ffi-pointer ctx) m-s3-param-count))
          (l1 (e2e-get-f64 (ffi-pointer ctx) f-s3-loss-step1))
          (l4 (e2e-get-f64 (ffi-pointer ctx) f-s3-loss-step4))
          (l8 (e2e-get-f64 (ffi-pointer ctx) f-s3-loss-step8)))
      (require-check "s3 strict loss decrease" (and (< l4 l1) (< l8 l4)))
      (display "E2E STAGE3A_PRETRAIN params=") (display params)
      (display " steps_full=8 steps_split=4")
      (display " loss1=") (display-f64-exact fmt-buf l1)
      (display " loss4=") (display-f64-exact fmt-buf l4)
      (display " loss8=") (display-f64-exact fmt-buf l8)
      (display " full_snap_sha256=") (display-digest ctx d-s3-full-snap hex-buf)
      (newline))

    (e2e-destroy (ffi-pointer ctx))
    (release (ffi-pointer hex-buf))
    (release (ffi-pointer fmt-buf))))

(define (run-phase-stage3b-4a work-dir)
  (let ((ctx (create-ctx))
        (hex-buf (checked-allocate 80))
        (fmt-buf (checked-allocate 64)))
    (expect-status "stage3-resume" status-ok
                   (e2e-stage3-resume (ffi-pointer ctx) work-dir))
    (let ((w-eq (e2e-get-i64 (ffi-pointer ctx) m-s3-weights-bitwise-equal))
          (s-eq (e2e-get-i64 (ffi-pointer ctx) m-s3-snapshot-sha-equal))
          (corrupt (e2e-get-i64 (ffi-pointer ctx) m-s3-corrupt-rejected))
          (l8 (e2e-get-f64 (ffi-pointer ctx) f-s3-loss-step8)))
      (require-check "s3 resume parity" (and (= w-eq 1) (= s-eq 1) (= corrupt 1)))
      (display "E2E STAGE3B_RESUME weights_bitwise_equal=") (display w-eq)
      (display " snapshot_sha_equal=") (display s-eq)
      (display " corrupt_rejected=") (display corrupt)
      (display " loss8=") (display-f64-exact fmt-buf l8)
      (display " resumed_snap_sha256=") (display-digest ctx d-s3-resumed-snap hex-buf)
      (newline))

    (expect-status "stage4-train" status-ok
                   (e2e-stage4-train (ffi-pointer ctx) work-dir))
    (let ((rank (e2e-get-i64 (ffi-pointer ctx) m-s4-rank))
          (steps (e2e-get-i64 (ffi-pointer ctx) m-s4-steps))
          (frozen (e2e-get-i64 (ffi-pointer ctx) m-s4-base-frozen-equal))
          (l0 (e2e-get-f64 (ffi-pointer ctx) f-s4-initial-loss))
          (lf (e2e-get-f64 (ffi-pointer ctx) f-s4-final-loss))
          (merr (e2e-get-f64 (ffi-pointer ctx) f-s4-merge-max-abs-err))
          (uerr (e2e-get-f64 (ffi-pointer ctx) f-s4-unmerge-max-abs-err)))
      (require-check "s4 lora invariants"
                     (and (= rank 4) (= frozen 1) (< lf l0)
                          (<= merr 1.0e-6) (<= uerr 1.0e-6)))
      (display "E2E STAGE4A_LORA rank=") (display rank)
      (display " steps=") (display steps)
      (display " loss0=") (display-f64-exact fmt-buf l0)
      (display " lossf=") (display-f64-exact fmt-buf lf)
      (display " base_frozen=") (display frozen)
      (display " merge_err=") (display-f64-exact fmt-buf merr)
      (display " unmerge_err=") (display-f64-exact fmt-buf uerr)
      (display " base_sha256=") (display-digest ctx d-s4-base-weight hex-buf)
      (display " ckpt_sha256=") (display-digest ctx d-s4-lora-ckpt hex-buf)
      (newline))

    (e2e-destroy (ffi-pointer ctx))
    (release (ffi-pointer hex-buf))
    (release (ffi-pointer fmt-buf))))

(define (run-phase-stage4b-8 work-dir)
  (let ((ctx (create-ctx))
        (hex-buf (checked-allocate 80))
        (fmt-buf (checked-allocate 64)))
    ;; Stage 4b: Fresh-process LoRA reload & merge
    (expect-status "stage4-reload" status-ok
                   (e2e-stage4-reload (ffi-pointer ctx) work-dir))
    (let ((rel-eq (e2e-get-i64 (ffi-pointer ctx) m-s4-reload-equal)))
      (require-check "s4 reload" (= rel-eq 1))
      (display "E2E STAGE4B_LORA_RELOAD reload_equal=") (display rel-eq)
      (display " base_sha256=") (display-digest ctx d-s4-base-weight hex-buf)
      (display " ckpt_sha256=") (display-digest ctx d-s4-lora-ckpt hex-buf)
      (newline))

    ;; Stage 5: DPO preference alignment
    (expect-status "stage5-dpo" status-ok
                   (e2e-stage5-dpo (ffi-pointer ctx) work-dir))
    (let ((steps (e2e-get-i64 (ffi-pointer ctx) m-s5-steps))
          (ref-eq (e2e-get-i64 (ffi-pointer ctx) m-s5-ref-frozen-equal))
          (l0 (e2e-get-f64 (ffi-pointer ctx) f-s5-initial-loss))
          (lf (e2e-get-f64 (ffi-pointer ctx) f-s5-final-loss))
          (m0 (e2e-get-f64 (ffi-pointer ctx) f-s5-initial-margin))
          (mf (e2e-get-f64 (ffi-pointer ctx) f-s5-final-margin))
          (acc (e2e-get-f64 (ffi-pointer ctx) f-s5-final-accuracy)))
      (require-check "s5 dpo invariants"
                     (and (= ref-eq 1) (< lf l0) (> mf m0) (> mf 0.0)
                          (= acc 1.0)))
      (display "E2E STAGE5_DPO steps=") (display steps)
      (display " loss0=") (display-f64-exact fmt-buf l0)
      (display " lossf=") (display-f64-exact fmt-buf lf)
      (display " margin0=") (display-f64-exact fmt-buf m0)
      (display " marginf=") (display-f64-exact fmt-buf mf)
      (display " acc=") (display-f64-exact fmt-buf acc)
      (display " ref_frozen=") (display ref-eq)
      (display " ref_sha256=") (display-digest ctx d-s5-ref-weight hex-buf)
      (newline))

    ;; Stage 6a: EVAL5 contamination fail-closed + clean scoring & manifest
    (expect-status "stage6-eval5" status-ok
                   (e2e-stage6-eval5 (ffi-pointer ctx) work-dir))
    (let ((cst (e2e-get-i64 (ffi-pointer ctx) m-s6-contam-status))
          (cabs (e2e-get-i64 (ffi-pointer ctx) m-s6-contam-manifest-absent))
          (cdocs (e2e-get-i64 (ffi-pointer ctx) m-s6-contam-docs-found))
          (clean (e2e-get-i64 (ffi-pointer ctx) m-s6-clean-contam-docs))
          (nll (e2e-get-f64 (ffi-pointer ctx) f-s6-lm-mean-nll))
          (ppl (e2e-get-f64 (ffi-pointer ctx) f-s6-lm-perplexity))
          (mc (e2e-get-f64 (ffi-pointer ctx) f-s6-mc-accuracy)))
      (require-check "s6 eval5 invariants"
                     (and (= cst -7) (= cabs 1) (= cdocs 1) (= clean 0)
                          (> ppl 1.0)))
      (display "E2E STAGE6A_EVAL5 contam_status=") (display cst)
      (display " contam_manifest_absent=") (display cabs)
      (display " contam_docs=") (display cdocs)
      (display " clean_contam=") (display clean)
      (display " lm_nll=") (display-f64-exact fmt-buf nll)
      (display " lm_ppl=") (display-f64-exact fmt-buf ppl)
      (display " mc_acc=") (display-f64-exact fmt-buf mc)
      (display " manifest_sha256=") (display-digest ctx d-s6-manifest hex-buf)
      (newline))

    ;; Stage 7: Exact lossless speculative decoding
    (expect-status "stage7-spec" status-ok
                   (e2e-stage7-spec (ffi-pointer ctx) work-dir))
    (let ((hor (e2e-get-i64 (ffi-pointer ctx) m-s7-horizon))
          (gem (e2e-get-i64 (ffi-pointer ctx) m-s7-greedy-emitted))
          (gacc (e2e-get-i64 (ffi-pointer ctx) m-s7-greedy-accepted))
          (geq (e2e-get-i64 (ffi-pointer ctx) m-s7-greedy-exact-match))
          (sem (e2e-get-i64 (ffi-pointer ctx) m-s7-stoch-emitted))
          (seq (e2e-get-i64 (ffi-pointer ctx) m-s7-stoch-replay-match))
          (ehit (e2e-get-i64 (ffi-pointer ctx) m-s7-eos-hit))
          (eem (e2e-get-i64 (ffi-pointer ctx) m-s7-eos-emitted)))
      (require-check "s7 spec invariants"
                     (and (= geq 1) (= seq 1) (= ehit 1) (= eem 2)))
      (display "E2E STAGE7_SPEC horizon=") (display hor)
      (display " greedy_emitted=") (display gem)
      (display " greedy_accepted=") (display gacc)
      (display " greedy_exact=") (display geq)
      (display " stoch_emitted=") (display sem)
      (display " stoch_replay=") (display seq)
      (display " eos_hit=") (display ehit)
      (display " eos_emitted=") (display eem)
      (newline))

    ;; Stage 8: Native IO5 F16/BF16/Q8_0 codec round-trip
    (expect-status "stage8-io5" status-ok
                   (e2e-stage8-io5 (ffi-pointer ctx) work-dir))
    (let ((wcnt (e2e-get-i64 (ffi-pointer ctx) m-s8-weight-count))
          (q8b (e2e-get-i64 (ffi-pointer ctx) m-s8-q8-0-bytes))
          (f16e (e2e-get-f64 (ffi-pointer ctx) f-s8-f16-max-abs-err))
          (bf16e (e2e-get-f64 (ffi-pointer ctx) f-s8-bf16-max-abs-err))
          (q8max (e2e-get-f64 (ffi-pointer ctx) f-s8-q8-0-max-abs-err))
          (q8rel (e2e-get-f64 (ffi-pointer ctx) f-s8-q8-0-rel-l2-err)))
      (require-check "s8 io5 bounds"
                     (and (> wcnt 0) (<= f16e 1.0e-3) (<= bf16e 1.0e-2)
                          (<= q8rel 1.0e-2)))
      (display "E2E STAGE8_IO5 weights=") (display wcnt)
      (display " q8_0_bytes=") (display q8b)
      (display " f16_max_err=") (display-f64-exact fmt-buf f16e)
      (display " bf16_max_err=") (display-f64-exact fmt-buf bf16e)
      (display " q8_0_max_err=") (display-f64-exact fmt-buf q8max)
      (display " q8_0_rel_l2=") (display-f64-exact fmt-buf q8rel)
      (newline))

    (e2e-destroy (ffi-pointer ctx))
    (release (ffi-pointer hex-buf))
    (release (ffi-pointer fmt-buf))))

(define (run-phase-stage6-verify work-dir)
  (let ((ctx (create-ctx))
        (hex-buf (checked-allocate 80))
        (fmt-buf (checked-allocate 64)))
    (expect-status "stage6-verify-fresh" status-ok
                   (e2e-stage6-verify (ffi-pointer ctx) work-dir))
    (let ((ver (e2e-get-i64 (ffi-pointer ctx) m-s6-fresh-reload-verified))
          (clean (e2e-get-i64 (ffi-pointer ctx) m-s6-clean-contam-docs))
          (nll (e2e-get-f64 (ffi-pointer ctx) f-s6-lm-mean-nll))
          (ppl (e2e-get-f64 (ffi-pointer ctx) f-s6-lm-perplexity))
          (mc (e2e-get-f64 (ffi-pointer ctx) f-s6-mc-accuracy)))
      (require-check "s6 fresh reload" (and (= ver 1) (= clean 0) (> ppl 1.0)))
      (display "E2E STAGE6B_EVAL5_FRESH verified=") (display ver)
      (display " clean_contam=") (display clean)
      (display " lm_nll=") (display-f64-exact fmt-buf nll)
      (display " lm_ppl=") (display-f64-exact fmt-buf ppl)
      (display " mc_acc=") (display-f64-exact fmt-buf mc)
      (display " manifest_sha256=") (display-digest ctx d-s6-manifest hex-buf)
      (newline))

    (e2e-destroy (ffi-pointer ctx))
    (release (ffi-pointer hex-buf))
    (release (ffi-pointer fmt-buf))))

(define (main-parse args)
  (let ((phase "")
        (work-dir ""))
    (let loop ((rest args))
      (unless (null? rest)
        (when (null? (cdr rest))
          (fail-msg "missing value for CLI flag"))
        (let ((flag (car rest))
              (val (car (cdr rest)))
              (tail (cdr (cdr rest))))
          (cond
            ((string=? flag "--phase") (set! phase val))
            ((string=? flag "--work-dir") (set! work-dir val))
            (else (fail-msg "unknown CLI flag")))
          (loop tail))))
    (require-check "missing --work-dir" (> (string-length work-dir) 0))
    (cond
      ((string=? phase "stage1-2") (run-phase-stage1-2 work-dir))
      ((string=? phase "stage2-3a") (run-phase-stage2-3a work-dir))
      ((string=? phase "stage3b-4a") (run-phase-stage3b-4a work-dir))
      ((string=? phase "stage4b-8") (run-phase-stage4b-8 work-dir))
      ((string=? phase "stage6-verify") (run-phase-stage6-verify work-dir))
      (else (fail-msg "unknown --phase")))))

(main-parse (cdr (command-line)))
