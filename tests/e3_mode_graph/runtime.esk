;;; Execute the exact noninstalled in-call E3 witness through its boxed bridge.
(extern void e3-mg-run ptr ptr ptr :real et_e3_mode_graph_run_v1)
(define args (command-line))
(if (not (and (pair? args) (pair? (cdr args))
              (pair? (cdr (cdr args)))
              (null? (cdr (cdr (cdr args))))))
    (exit 2))
(define corpus (car (cdr args)))
(define gradient (car (cdr (cdr args))))
(define present? (string=? gradient "present"))
(if (not (or present? (string=? gradient "absent"))) (exit 2))
(define output (vector #f))
(e3-mg-run (vector (vector present?)) (vector corpus) output)
(if (not (eq? (vector-ref output 0) #t)) (exit 1))
(display "E3-MODE-GRAPH-RUNTIME-PASS") (newline)
