(define (near a b tolerance) (< (abs (- a b)) tolerance))
(let* ((actual (gradient
                 (lambda (v)
                   (+ (* (tensor-get v 0) (tensor-get v 0))
                      (* 3.0 (tensor-get v 1))))
                 #(2.0 5.0))))
  (display
    (if (and (near (tensor-get actual 0) 4.0 1e-8)
             (near (tensor-get actual 1) 3.0 1e-8))
        "PASS gradient tensor" "FAIL gradient tensor"))
  (newline))
(display "R0_DONE autodiff_gradient_tensor") (newline)
