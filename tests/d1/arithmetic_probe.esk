;;; Test-only access to private checked-arithmetic logic with synthetic counts.

(require transformer.error_internal)
(load "eshkol_transformer/token_shard.esk")

(define failures 0)
(define (expect-invalid thunk)
  (guard (raised (#t
                  (if (and (transformer-error? raised)
                           (eq? (transformer-error-category raised)
                                'invalid-argument))
                      #t
                      (set! failures (+ failures 1)))))
    (thunk)
    (set! failures (+ failures 1))))

(expect-invalid
 (lambda ()
   (d1-token-derived-sizes 1152921504606846901 1 1 'token-corpus-write!)))
(expect-invalid
 (lambda ()
   (d1-token-derived-sizes 10000000000000001 1 1 'token-corpus-write!)))
(expect-invalid
 (lambda ()
   (d1-token-derived-sizes 1152921504606846900 116 192
                           'token-corpus-write!)))
(expect-invalid
 (lambda ()
   (d1-token-derived-sizes 288230376151711710 288230376151711710 192
                           'token-corpus-write!)))

(if (= failures 0)
    (begin (display "D1_ARITHMETIC_PASS") (newline))
    (begin (display "D1_ARITHMETIC_FAIL") (newline) (exit 1)))
