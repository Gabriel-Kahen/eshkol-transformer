(define g3g-safe-generator-create
  (let ()
    (extern void g3g-boxed-generator-create ptr ptr ptr ptr
            :real et_e1b_public_g3_generator_create_v1)
    (lambda (arg0 arg1 arg2)
      (let ((output (vector #f)))
        (g3g-boxed-generator-create (vector arg0) (vector arg1) (vector arg2) output)
        (vector-ref output 0)))))
(define (generator-create arg0 arg1 arg2)
  (g3g-safe-generator-create arg0 arg1 arg2))

(define g3g-safe-generator-generate
  (let ()
