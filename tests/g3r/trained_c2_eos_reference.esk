;;; Thin caller. The one private package owns CLI3, T2, TR3 and G3-T.
(extern void g3r-private-produce ptr ptr
        :real et_g3r_private_test_trained_pair_produce_v1)
(define args (command-line))
(define (argument at)
  (let loop ((remaining (cdr args)) (index at))
    (if (= index 0) (car remaining)
        (loop (cdr remaining) (- index 1)))))
(define (proper-length values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))
(define hex-digits "0123456789abcdef")
(define (hex2 byte)
  (let ((high (quotient byte 16)) (low (modulo byte 16)))
    (string-append (substring hex-digits high (+ high 1))
                   (substring hex-digits low (+ low 1)))))
(if (not (= (proper-length args) 6)) (exit 2))
(define output (vector #f))
(g3r-private-produce
  (vector (vector (argument 0) (argument 1) (argument 2)
                  (argument 3) (argument 4)))
  output)
(define result (vector-ref output 0))
(if (not (and (vector? result) (= (vector-length result) 4))) (exit 1))
(define digest (vector-ref result 0))
(define prompt (vector-ref result 1))
(define id (vector-ref result 2))
(define rng (vector-ref result 3))
(if (not (and (bytevector? digest) (= (bytevector-length digest) 32)
              (integer? prompt) (>= prompt 0) (<= prompt 255)
              (integer? id) (>= id 0) (<= id 255)
              (vector? rng) (= (vector-length rng) 4)
              (= (vector-ref rng 0) 1) (= (vector-ref rng 1) 1729)
              (= (vector-ref rng 2) 1) (= (vector-ref rng 3) 0)))
    (exit 1))
(display "G3-R TRAINED EOS REFERENCE PASS c2_sha256=")
(let loop ((index 0))
  (if (< index 32)
      (begin (display (hex2 (bytevector-u8-ref digest index)))
             (loop (+ index 1)))))
(display " prompt=") (display (hex2 prompt))
(display " id=") (display (hex2 id))
(display " terminal=1 generated=1 history=2 rng=")
(let loop ((index 0))
  (if (< index 4)
      (begin
        (if (> index 0) (display ","))
        (display (vector-ref rng index))
        (loop (+ index 1)))))
(newline)
