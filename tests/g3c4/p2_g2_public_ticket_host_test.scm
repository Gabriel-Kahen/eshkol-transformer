;;; Host-only coordinator control-flow test. Providers/owners are explicit stubs;
;;; this proves no Eshkol AOT, native numerical, device or allocator behavior.
(use-modules ((rnrs exceptions) #:select (guard)) (rnrs bytevectors) (ice-9 match))
(define-syntax extern (syntax-rules () ((_ args ...) (begin))))
(define-syntax m3-call
  (syntax-rules () ((_ operation body ...)
    (dynamic-wind (lambda () #t) (lambda () body ...)
                  (lambda () (vector-set! m3-call-state 0 #t))))))
(define checks 0)
(define (check label value)
  (set! checks (+ checks 1))
  (if (not value) (error label)))
(define (reject label thunk)
  (check label (guard (caught (#t #t)) (thunk) #f)))
(define (g3c4-fail . args) (throw 'g3c4-test-failure args))
(define (g3c4-native-check status operation)
  (if (not (= status 0)) (g3c4-fail operation status)))
(define (m3t-exact-i64? value) (integer? value))
(define (g3c4-call-tuple? p g) (and (= p 2) (= g 2)))
(define (g3c4-call-dead! entry)
  (vector-set! entry 2 'dead)
  (do ((i 3 (+ i 1))) ((= i 12)) (vector-set! entry i #f)))
(define (g3c4-p2g2-zero-bytes! bytes count)
  (do ((i 0 (+ i 1))) ((= i count)) (bytevector-u8-set! bytes i 0)))
(define g3c4-model-profile 'diagnostic)
(define m3-call-state (vector #t))
(define g3c4-registry (vector '()))
(define g3c4-p2g2-ownership-gate (vector #t))
(define g3c4-p2g2-protected-records (vector '()))
(define g3c4-p2g2-protected-anchors (vector '()))
(define g3c4-p2g2-prefix-input-anchors (vector '()))
(define g3c4-p2g2-terminal-pending-anchors (vector '()))
(define g3c4-p2g2-terminal-pending-originals (vector '()))
(define g3c4-p2g2-terminal-live-anchors (vector '()))
(define g3c4-p2g2-terminal-live-originals (vector '()))
(define generator #f) (define input #f) (define model #f)
(define tokenizer (vector 'tokenizer)) (define tokenizer-core (vector 'core))
(define native (vector 'native))
(define pending #f) (define live #f) (define output #f)
(define current-call #f) (define frame #f)
(define roots #f) (define ticket #f) (define public-row #f) (define public-anchor #f)
(define profile #f) (define binding #f) (define mutation #f)
(define commits 0) (define aborts 0) (define native-status 0)
(define (g3c4-p2g2-prefix-preflight g i) input)
(define (g3c4-input-entry-live i operation) input)
(define (g3c4-generator-entry-call-ready g operation) generator)
(define (g3c4-baseline-tokenizer-entry . args) (list tokenizer tokenizer-core))
(define (g3c4-native-call-acquire . args) 0)
(define (g3c4-p2g2-terminal-pending-reserve! call)
  (set! current-call call) (set! pending (make-vector 19 #f))
  (vector-set! pending 17 (vector-ref g3c4-p2g2-terminal-pending-anchors 0))
  (vector-set! pending 18 (vector-ref g3c4-p2g2-terminal-pending-originals 0))
  pending)
(define (g3c4-p2g2-terminal-live-prepare call pending)
  (set! output (vector (vector 'output) 'output 'pending (vector 'output-native)
                       #f #f #f #f #f #f #f g3c4-model-profile))
  (set! live (vector 'unpublished output (vector-ref output 0) (vector-ref output 3)
                    (make-bytevector 1 0) (make-bytevector 2 0) #f #f #f #f
                    (lambda args #t)
                    (vector-ref g3c4-p2g2-terminal-live-anchors 0)
                    (vector-ref g3c4-p2g2-terminal-live-originals 0) #f #f #f))
  (vector-set! live 13 (cons live (vector-ref live 11)))
  (vector-set! live 14 (cons (vector-ref live 10) (vector-ref live 12)))
  live)
(define (g3c4-p2g2-terminal-first-sample-decode! . args) 7)
(define (g3c4-p2g2-terminal-pending-check . args)
  (vector #f #f (car (vector-ref g3c4-p2g2-protected-records 0))))
(define (g3c4-p2g2-terminal-non-eos-prefix-commit! . args) #t)
(define (g3c4-p2g2-terminal-second-sample-decode! . args) 8)
(define (g3c4-p2g2-terminal-text-preflight! call pending first second)
  (let* ((count (if second 2 1)) (text (vector-ref live (if second 5 4))))
    (bytevector-u8-set! text 0 first)
    (if second (bytevector-u8-set! text 1 second))
    count))
(define (g3c4-p2g2-terminal-precommit-frame call pending first second count)
  (if (not frame)
      (let ((record (car (vector-ref g3c4-p2g2-protected-records 0))))
        (set! frame
          (vector 'precommit call pending output (vector-ref output 0) native
                  (vector-ref output 3) (vector-ref record 11) 9
                  (if second (make-bytevector 1 0) #f) (if second 9 0)
                  count (vector-ref live (if second 5 4))
                  record (car (vector-ref g3c4-p2g2-protected-anchors 0))
                  (car (vector-ref g3c4-p2g2-prefix-input-anchors 0))
                  (vector-ref call 10) generator model
                  (vector-ref pending 17) (vector-ref pending 18)
                  (cdr (vector-ref g3c4-p2g2-protected-records 0))
                  (cdr (vector-ref g3c4-p2g2-protected-anchors 0))
                  (cdr (vector-ref g3c4-p2g2-prefix-input-anchors 0))
                  (vector-ref record 12) (make-bytevector 8 0)
                  (if second (make-bytevector 1 0) (make-bytevector 1 0))
                  (vector-ref live 4) (vector-ref live 5)
                  (make-bytevector 2 0) (make-bytevector 16 0)))))
  (list->vector (vector->list frame)))
(define (g3c4-p2g2-terminal-live-bind! call pending live frame)
  (vector-set! live 6 (vector-ref frame 11))
  (vector-set! live 7 (vector-ref frame 12))
  (vector-set! live 8 7)
  (vector-set! live 9 (if (= (vector-ref frame 11) 2) 8 #f))
  (vector-set! live 15 (+ 2 (vector-ref frame 11))) live)
(define (g3c4-p2g2-native-terminal-commit . args)
  (set! commits (+ commits 1)) native-status)
(define (g3c4-p2g2-terminal-pending-abort! call pending)
  (if (equal? (getenv "G3C4_TICKET_CASE") "held-abort") (error "held lease rejects abort"))
  (set! aborts (+ aborts 1)) (g3c4-call-dead! call)
  (vector-set! g3c4-p2g2-protected-records 0 '())
  (vector-set! g3c4-p2g2-protected-anchors 0 '()))
(define (g3c4-p2g2-protected-abort! call)
  (g3c4-p2g2-terminal-pending-abort! call pending))

(define (stage action g i issued out row anchor count first second operation)
  (check "stage runs before native zero" (= commits 0))
  (check "stage sees original ticket" (eq? issued ticket))
  (cond
    ((eq? action 'admit) #t)
    ((eq? action 'bind)
     (do ((slot 5 (+ slot 1)) (value (list (vector-ref out 0) out (vector-ref out 3) row anchor) (cdr value)))
         ((= slot 10)) (vector-set! issued slot (car value)))
     (vector-set! binding 0 (vector-ref out 0))
     (for-each (lambda (r)
       (vector-set! r 0 (vector-ref out 0)) (vector-set! r 1 out)
       (vector-set! r 2 (vector-ref out 3)) (vector-set! r 6 row) (vector-set! r 7 anchor))
       (list public-row public-anchor)))
    ((eq? action 'verify)
     (vector-set! issued 13 count) (vector-set! issued 14 first) (vector-set! issued 15 second)
     (for-each (lambda (r) (vector-set! r 9 count) (vector-set! r 10 first) (vector-set! r 11 second))
               (list public-row public-anchor))
     (if mutation (mutation)))))

(define (reset eos)
  (set! commits 0) (set! aborts 0) (set! native-status 0) (set! mutation #f)
  (set! frame #f)
  (for-each (lambda (r) (vector-set! r 0 '()))
    (list g3c4-registry g3c4-p2g2-protected-records g3c4-p2g2-protected-anchors
          g3c4-p2g2-prefix-input-anchors g3c4-p2g2-terminal-pending-anchors
          g3c4-p2g2-terminal-pending-originals g3c4-p2g2-terminal-live-anchors
          g3c4-p2g2-terminal-live-originals))
  (set! model (make-vector 12 #f)) (vector-set! model 3 (vector 'model-native))
  (set! generator (make-vector 12 #f)) (vector-set! generator 3 native)
  (vector-set! generator 5 model) (vector-set! generator 6 tokenizer)
  (vector-set! generator 7 (vector 'policy 1 1065353216 256 1065353216 2 eos))
  (set! input (make-vector 12 #f)) (vector-set! input 3 (vector 'input-native))
  (set! profile (vector generator generator native model tokenizer (vector-ref generator 7) 'diagnostic-c4-p2g2 'live))
  (set! public-row (vector #f #f #f generator input profile #f #f 'pending 0 -1 -1))
  (set! public-anchor (list->vector (vector->list public-row)))
  (set! binding (vector #f (lambda args #t)))
  (set! ticket (vector 'secret generator input profile input #f #f #f #f #f
                       public-row public-anchor 'pending 0 -1 -1 (vector-ref binding 1)
                       '() '() '() '()))
  (set! roots (vector (vector (list ticket)) (vector (list public-row))
                       (vector (list public-anchor)) (vector (list binding))
                       (vector (list profile))
                       (vector (list (list->vector (vector->list profile))))
                       (vector (list (vector generator (lambda args #t)))))))
(define source (or (getenv "G3C4_TEST_SOURCE")
  (string-append (getenv "G3C4_TEST_ROOT") "/native/g3c4_p2g2_terminal_commit_extension.esk")))
(define (install)
  (load source)
  (g3c4-p2g2-terminal-enrollment-route-private stage roots))
(let ((mode (getenv "G3C4_TICKET_CASE")))
  (if mode
      (begin
        (reset 255)
        (if (equal? mode "alias-roots")
            (begin (vector-set! roots 1 (vector-ref roots 0)) (install))
            (let ((route (install)))
              (cond ((equal? mode "reinstall")
                     (g3c4-p2g2-terminal-enrollment-route-private stage roots))
                    ((equal? mode "held-abort")
                     (set! mutation (lambda () (vector-set! public-row 3 #f)))
                     (route generator input ticket))
                    (else (route generator input ticket)))))
        (exit 0))))
(for-each (lambda (eos)
  (reset eos)
  (let ((route (install)))
    (check "native zero returns original shell" (eq? (route generator input ticket) (vector-ref output 0)))
    (check "one native commit" (= commits 1))
    (check "no abort after zero" (= aborts 0))
    (check "three marker writes" (and (eq? (vector-ref ticket 12) 'live)
                                      (eq? (vector-ref public-row 8) 'live)
                                      (eq? (vector-ref public-anchor 8) 'live)))
    (check "logical count" (= (vector-ref live 6) (if (= eos 7) 1 2))))) '(7 255))
(for-each (lambda (mutate)
  (reset 255)
  (let ((route (install)))
    (set! mutation mutate)
    (reject "postverify mutation rejected before native zero" (lambda () (route generator input ticket)))
    (check "invalid enrollment never commits" (= commits 0))
    (check "prezero reject aborts call" (= aborts 1))
    (check "invalid marker stays pending" (eq? (vector-ref ticket 12) 'pending))))
  (list (lambda () (vector-set! (vector-ref roots 0) 0 '()))
        (lambda () (vector-set! public-row 3 #f))
        (lambda () (vector-set! public-anchor 11 99))
        (lambda () (vector-set! ticket 16 (lambda args #t)))
        (lambda () (vector-set! live 10 (lambda args #t)))
        (lambda () (vector-set! generator 7 (vector 'policy 1 1 1 1 2 255)))
        (lambda () (vector-set! (vector-ref generator 7) 6 4))
        (lambda () (vector-set! ticket 0 #f))
        (lambda () (set-cdr! (vector-ref (vector-ref roots 0) 0) (list (vector 'unrelated))))
        (lambda () (vector-set! ticket 17 (list (vector 'substituted-tail))))
        (lambda () (set-car! (vector-ref (vector-ref roots 4) 0) (vector 'substituted-generator-row)))
        (lambda () (vector-set! (car (vector-ref (vector-ref roots 5) 0)) 7 'dead))
        (lambda () (vector-set! (car (vector-ref (vector-ref roots 6) 0)) 1 (lambda args #t)))))
;;; Complete final-authority inventory. Each field/edge is changed only by
;;; the last callable stage; every case must abort before native commit.
(define authority-mutations 0)
(define (authority-reject mutate)
  (reset 255)
  (let ((route (install)))
    (set! mutation mutate)
    (reject "authority inventory rejects postverify mutation"
            (lambda () (route generator input ticket)))
    (check "authority inventory never reaches native commit" (= commits 0))
    (check "authority inventory aborts the original call" (= aborts 1))
    (set! authority-mutations (+ authority-mutations 1))))
(do ((slot 0 (+ slot 1))) ((= slot 21))
  (let ((index slot))
    (authority-reject (lambda () (vector-set! ticket index 'corrupted-ticket-field)))))
(for-each (lambda (which)
  (do ((slot 0 (+ slot 1))) ((= slot 12))
    (let ((index slot))
      (authority-reject (lambda ()
        (vector-set! (if (= which 0) public-row public-anchor) index 'corrupted-output-field)))))) '(0 1))
(do ((index 0 (+ index 1))) ((= index 4))
  (let ((root-index index))
    (authority-reject (lambda ()
      (set-car! (vector-ref (vector-ref roots root-index) 0) (vector 'replacement-node-car))))
    (authority-reject (lambda ()
      (set-cdr! (vector-ref (vector-ref roots root-index) 0) (list (vector 'replacement-node-tail)))))))
(do ((index 0 (+ index 1))) ((= index 2))
  (let ((slot index))
    (authority-reject (lambda () (vector-set! binding slot 'corrupted-output-binding)))))
(do ((index 4 (+ index 1))) ((= index 7))
  (let ((root-index index))
    (authority-reject (lambda ()
      (set-car! (vector-ref (vector-ref roots root-index) 0) (vector 'replacement-generator-car))))
    (authority-reject (lambda ()
      (set-cdr! (vector-ref (vector-ref roots root-index) 0) (list (vector 'replacement-generator-tail)))))
    (do ((field 0 (+ field 1))) ((= field (if (= index 6) 2 8)))
      (let ((slot field))
        (authority-reject (lambda ()
          (vector-set! (car (vector-ref (vector-ref roots root-index) 0)) slot 'corrupted-generator-field)))))))
(do ((index 0 (+ index 1))) ((= index 7))
  (let ((root-index index))
    (authority-reject (lambda () (vector-set! (vector-ref roots root-index) 0 '())))))
(do ((index 1 (+ index 1))) ((= index 7))
  (let ((slot index))
    (authority-reject (lambda ()
      (vector-set! (vector-ref generator 7) slot (+ (vector-ref (vector-ref generator 7) slot) 1))))))
(check "complete authority mutation inventory count" (= authority-mutations 92))
;;; Generator provenance need not be at the root head. Capture and recheck
;;; the selected interior node, including reachability and its original tail.
(define (prepend-other-generator!)
  (do ((index 4 (+ index 1))) ((= index 7))
    (vector-set! (vector-ref roots index) 0
      (cons (vector (vector 'other-generator)) (vector-ref (vector-ref roots index) 0)))))
(reset 255)
(prepend-other-generator!)
(let ((route (install)))
  (check "older generator remains admitted"
    (eq? (route generator input ticket) (vector-ref output 0))))
(for-each (lambda (mutate)
  (reset 255) (prepend-other-generator!)
  (let ((route (install)))
    (set! mutation mutate)
    (reject "older generator node corruption rejects" (lambda () (route generator input ticket)))
    (check "older corrupted generator never commits" (= commits 0))
    (check "older corrupted generator aborts" (= aborts 1))))
  (list (lambda () (set-car! (cdr (vector-ref (vector-ref roots 4) 0)) (vector 'replacement)))
        (lambda () (set-cdr! (vector-ref (vector-ref roots 4) 0) '()))
        (lambda () (set-cdr! (cdr (vector-ref (vector-ref roots 4) 0)) (list (vector 'extra))))))
(reset 255)
(let ((route (install)))
  (set! native-status 99)
  (reject "native rejection raises" (lambda () (route generator input ticket)))
  (check "failed native commit aborts exactly once" (= aborts 1))
  (check "failed native commit keeps pending ticket" (eq? (vector-ref ticket 12) 'pending)))
(reset 255)
(install)
(check "original private two-argument entry remains callable"
       (eq? (g3c4-p2g2-terminal-commit-private! generator input) (vector-ref output 0)))
(reset #f)
(install)
(check "private path keeps its original no-EOS policy"
       (eq? (g3c4-p2g2-terminal-commit-private! generator input) (vector-ref output 0)))
(display "G3-C4 public ticket coordinator host PASS: checks=") (display checks) (newline)
