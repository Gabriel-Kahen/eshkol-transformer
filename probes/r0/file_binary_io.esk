(define path "/tmp/eshkol-r0-binary-io.bin")
(define out (open-binary-output-file path))
(write-u8 0 out)
(write-u8 127 out)
(write-u8 255 out)
(close-port out)
(define in (open-binary-input-file path))
(define a (read-u8 in))
(define b (read-u8 in))
(define c (read-u8 in))
(close-port in)
(file-delete path)
(display (if (and (= a 0) (= b 127) (= c 255))
             "PASS binary byte round trip" "FAIL binary byte round trip"))
(newline)
(display "R0_DONE file_binary_io") (newline)
