;;; The actual secret issuer + result/access/release bodies, with explicit
;;; native/private-provider stubs. This is not native or AOT admission.
(load (string-append (getenv "G3C4_TEST_ROOT") "/tests/g3c4/p2_g2_typed_wrapper_rollback_test.scm"))
(load (string-append (getenv "G3C4_TEST_ROOT") "/native/g3c4_public_g2_result_extension.esk"))
(define-syntax g3c4-public-boundary (syntax-rules () ((_ operation body ...) (begin body ...))))
(define g3c4-rng-algorithm 'algorithm)
(define (m3t-exact-i64? word) (integer? word))
(define (g3c4-rng-snapshot? words)
  (and (vector? words) (= (vector-length words) 5)
       (eq? (vector-ref words 0) g3c4-rng-algorithm)
       (= (vector-ref words 1) 1) (>= (vector-ref words 2) 0)))
(define generator (vector 'generator-shell))
(define input (vector 'input-shell))
(define policy (vector 'policy 1 1065353216 256 1065353216 2 0))
(define generator-entry
  (vector generator 'generator 'live (vector 'generator-native) #f #f #f policy #f #f #f g3c4-model-profile))
(define input-entry (vector input 'input 'live (vector 'input-native) #f #f #f #f #f #f #f g3c4-model-profile))
(define profile (vector generator generator-entry (vector-ref generator-entry 3) #f #f policy 'diagnostic-c4-p2g2 'live))
(define g3c4-public-g2-generator-rows (vector (list profile)))
(define g3c4-public-g2-generator-anchors (vector (list (list->vector (vector->list profile)))))
(define g3c4-public-g2-generator-bindings (vector (list (vector generator (lambda args #t)))))
(define profile-validations 0)
(define (g3c4-public-g2-profile-original shell operation)
  (set! profile-validations (+ profile-validations 1))
  (if (not (and (eq? (vector-ref generator-entry 2) 'live)
                (eq? (vector-ref profile 7) 'live))) (error "generator closed")) profile)
(define (g3c4-public-g2-profile-live shell operation)
  (g3c4-public-g2-profile-original shell operation))
(define (g3c4-public-transport-member shell)
  (cond ((eq? shell generator) generator-entry) ((eq? shell input) input-entry) (else #f)))
(define (g3c4-generator-entry-call-ready shell operation)
  (if (not (eq? (vector-ref generator-entry 2) 'live)) (error "generator closed")) generator-entry)
(define (g3c4-input-entry-live shell operation) input-entry)
(define (g3c4-p2g2-prefix-preflight g i) input-entry)
(define output-shell (vector 'terminal-shell))
(define output-native (vector 'terminal-native))
(define output-entry (vector output-shell 'output 'pending output-native #f #f #f #f #f #f #f g3c4-model-profile))
(define original (lambda args #t))
(define terminal (vector 'unpublished output-entry output-shell output-native
                         (make-bytevector 1 0) (make-bytevector 2 0) 1 (make-bytevector 1 0) 0 #f original
                         '() '() #f #f 3))
(define fail-attempt? #f)
(define simulated-commits 0)
(define (g3c4-p2g2-terminal-enrollment-route-private stage roots)
  (lambda (g i issued)
    (let* ((out (if fail-attempt?
                    (vector (vector 'failed-output) 'output 'pending (vector 'failed-native)
                            #f #f #f #f #f #f #f g3c4-model-profile)
                    output-entry))
           (original-owner (if fail-attempt? (lambda args #t) original))
           (live-row (if fail-attempt?
                         (vector 'unpublished out (vector-ref out 0) (vector-ref out 3)
                                 (make-bytevector 1 0) (make-bytevector 2 0)
                                 1 (make-bytevector 1 0) 0 #f original-owner '() '() #f #f 3)
                         terminal)))
      (stage 'admit g i issued #f #f #f 0 -1 -1 'test)
      (stage 'bind g i issued out live-row original-owner 0 -1 -1 'test)
      (stage 'verify g i issued out live-row original-owner 1 0 0 'test)
      ;; No provider call is made in this stub. A failed construction is fully
      ;; drained; actual core abort/drain is checked in its separate harness.
      (if fail-attempt?
          (begin
            (if (equal? (getenv "G3C4_LIFETIME_CASE") "cleanup-mismatch")
                (vector-set! g3c4-public-g2-tickets 0 '())
                (set-cdr! (vector-ref g3c4-public-g2-tickets 0) (list (vector 'unexpected-tail))))
            (error "prezero construction failure")))
      (set! simulated-commits (+ simulated-commits 1))
      (vector-set! out 1 'terminal-output)
      (vector-set! out 2 'live)
      (vector-set! live-row 0 'live)
      (vector-set! issued 12 'live)
      (vector-set! (vector-ref issued 10) 8 'live)
      (vector-set! (vector-ref issued 11) 8 'live)
      (vector-ref out 0))))

(define (load-definition name)
  (call-with-input-file
    (string-append (getenv "G3C4_TEST_ROOT") "/native/g3c4_public_generation_dispatch_extension.esk")
    (lambda (port) (let find () (let ((form (read port)))
      (if (eof-object? form) (error "missing definition" name)
          (if (and (pair? form) (eq? (car form) 'define)
                   (eq? (if (pair? (cadr form)) (caadr form) (cadr form)) name))
              (eval form (current-module)) (find))))))))
(for-each load-definition '(g3c4-public-g2-tickets g3c4-public-g2-output-rows
  g3c4-public-g2-output-anchors g3c4-public-g2-output-bindings
  g3c4-public-generator-generate g3c4-p2g2-terminal-close-public-private
  g3c4-public-result-rng-entry))
(define (g3c4-p2g2-terminal-output-entry-live shell operation)
  (if (not (and (eq? shell output-shell) (eq? (vector-ref output-entry 2) 'live)))
      (error "output unavailable")) output-entry)
(define (g3c4-p2g2-terminal-snapshot-live-for shell entry operation) terminal)
(define (g3c4-p2g2-terminal-output-original-for shell entry operation) original)
(define held? #f)
(define (g3c4-p2g2-terminal-release-private! shell)
  (if held? (error "held I1 lease"))
  (g3c4-entry-dead! output-entry) (vector-set! terminal 0 'dead) #t)
(define snapshot (vector 0 0 1 3 1 41 42 43))
(define (g3c4-p2g2-native-terminal-snapshot native bytes extent)
  (if (not (and (eq? native output-native) (= extent 72))) (error "wrong snapshot operand"))
  (do ((i 0 (+ i 1))) ((= i 8)) (bytevector-u8-set! bytes (* i 8) (vector-ref snapshot i))) 0)
(define (g3c4-p2g2-terminal-snapshot-private shell)
  (g3c4-p2g2-terminal-output-entry-live shell 'test)
  (let ((bytes (make-bytevector 64 0)))
    (g3c4-p2g2-native-terminal-snapshot output-native bytes 72) bytes))
(define (g3c4-p2g2-terminal-ids-clone-private shell)
  (g3c4-p2g2-terminal-output-entry-live shell 'test)
  (let* ((clone (vector 'clone))
         (entry (vector clone 'terminal-ids 'live (vector 'clone-native) #f #f #f
                        1 (make-bytevector 8 0) #f #f g3c4-model-profile)))
    (vector-set! g3c4-registry 0 (cons entry (vector-ref g3c4-registry 0))) (list clone)))
(define (g3c4-p2g2-terminal-ids-release-private! clone)
  (g3c4-entry-dead! (g3c4-p2g2-terminal-ids-entry-live clone 'test)) #t)
(define (g3c4-native-result-rng-create algorithm seed low high)
  (vector 'rng (vector algorithm seed low high) 'live))
(define (g3c4-native-rng-word-checked native index operation)
  (if (not (and (eq? (vector-ref native 0) 'rng) (eq? (vector-ref native 2) 'live)))
      (error "wrong RNG kind")) (vector-ref (vector-ref native 1) index))
(define (g3c4-native-rng-release native) (vector-set! native 2 'dead) 0)
(define (g3c4-public-result-record . args) #f)
(define (g3c4-public-result-entry-live . args) (error "not scalar profile"))
(vector-set! g3c4-registry 0 (list generator-entry input-entry output-entry))
(check (eq? (g3c4-public-generator-generate generator input) output-shell))
(check (> profile-validations 0))
(define old-public-roots
  (vector (vector-ref g3c4-public-g2-tickets 0)
          (vector-ref g3c4-public-g2-output-rows 0)
          (vector-ref g3c4-public-g2-output-anchors 0)
          (vector-ref g3c4-public-g2-output-bindings 0)))
(set! fail-attempt? #t)
(if (equal? (getenv "G3C4_LIFETIME_CASE") "cleanup-mismatch")
    (g3c4-public-generator-generate generator input)
    (check (reject (lambda () (g3c4-public-generator-generate generator input)))))
(check (= simulated-commits 1))
(check (eq? (vector-ref g3c4-public-g2-tickets 0) (vector-ref old-public-roots 0)))
(check (eq? (vector-ref g3c4-public-g2-output-rows 0) (vector-ref old-public-roots 1)))
(check (eq? (vector-ref g3c4-public-g2-output-anchors 0) (vector-ref old-public-roots 2)))
(check (eq? (vector-ref g3c4-public-g2-output-bindings 0) (vector-ref old-public-roots 3)))
(check (eq? (vector-ref (car (vector-ref old-public-roots 0)) 12) 'live))
(check (g3c4-public-g2-output-live output-shell 'test))
(set! fail-attempt? #f)
;;; Tombstone the original generator and profile before the first output read.
(g3c4-entry-dead! generator-entry)
(vector-set! profile 7 'dead)
(vector-set! (car (vector-ref g3c4-public-g2-generator-anchors 0)) 7 'dead)
(define validations-at-close profile-validations)
(define ids (car (g3c4-public-g2-output-access output-shell 'ids 'test)))
(define lengths (g3c4-public-g2-output-access output-shell 'lengths 'test))
(define caches (g3c4-public-g2-output-access output-shell 'cache-lengths 'test))
(define text (car (g3c4-public-g2-output-access output-shell 'text 'test)))
(define rng (g3c4-public-g2-output-access output-shell 'result-rng 'test))
(check (= (bytevector-length text) 1))
(check (= profile-validations validations-at-close))
(check (g3c4-public-result-rng-entry rng 'test))
(let* ((row-node (vector-ref g3c4-public-g2-output-rows 0))
       (anchor-node (vector-ref g3c4-public-g2-output-anchors 0))
       (row (car row-node)) (anchor (car anchor-node))
       (issued (car (vector-ref g3c4-public-g2-tickets 0)))
       (replacement-row (list->vector (vector->list row)))
       (replacement-anchor (list->vector (vector->list anchor))))
  (set-car! row-node replacement-row) (set-car! anchor-node replacement-anchor)
  (vector-set! issued 10 replacement-row) (vector-set! issued 11 replacement-anchor)
  (check (reject (lambda () (g3c4-public-g2-output-access output-shell 'text 'test))))
  (set-car! row-node row) (set-car! anchor-node anchor)
  (vector-set! issued 10 row) (vector-set! issued 11 anchor))
(let ((row (car (vector-ref g3c4-public-g2-output-rows 0))))
  (vector-set! row 3 (vector 'forged-creator))
  (vector-set! (car (vector-ref g3c4-public-g2-output-anchors 0)) 3 (vector-ref row 3))
  (check (reject (lambda () (g3c4-public-g2-output-access output-shell 'text 'test))))
  (vector-set! row 3 generator)
  (vector-set! (car (vector-ref g3c4-public-g2-output-anchors 0)) 3 generator))
(set! held? #t)
(check (reject (lambda () (g3c4-public-g2-output-release! output-shell 'test))))
(check (eq? (vector-ref output-entry 2) 'live))
(set! held? #f)
(check (g3c4-public-g2-output-release! output-shell 'test))
(check (g3c4-public-g2-output-release! output-shell 'test))
(check (reject (lambda () (g3c4-public-g2-output-access output-shell 'text 'test))))
;;; Detached typed/RNG owners remain authentic after source output retirement.
(for-each (lambda (pair)
  (check (g3c4-public-g2-typed-result-live (cdr pair) (car pair) 'test))
  (check (g3c4-public-g2-result-release! (cdr pair) (car pair) 'test)))
  (list (cons 'ids ids) (cons 'lengths lengths) (cons 'cache-lengths caches)))
(check (g3c4-public-result-rng-entry rng 'test))
(check (g3c4-public-g2-result-release! rng 'result-rng 'test))
(check (= created released))
(check (= profile-validations validations-at-close))
(display "G3-C4 detached output lifetime host PASS: checks=") (display checks) (newline)
