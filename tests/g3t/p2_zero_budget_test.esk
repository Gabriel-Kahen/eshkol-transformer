(check "G1 regression pins drained"
       (= 0 (g3t-test-pin-count g1-regression-native)))
(check "G1 exact final RNG published"
       (and (= 1 (g3t-test-output-word g1-regression-output 7))
            (= 1729 (g3t-test-output-word g1-regression-output 8))
            (= 1 (g3t-test-output-word g1-regression-output 9))
            (= 0 (g3t-test-output-word g1-regression-output 10))
            (= 1 (g3t-test-rng-word g1-regression-native 2))))
(check "wrong-kind RNG clone source rejected"
       (and (null? (g3t-native-output-rng-clone g1-regression-input))
            (= 1 (g3t-test-last-error-category))
            (= 1 (g3t-test-last-error-code))
            (= 0 (g3t-test-live-rng-clones))))
(define g1-id (g3t-test-output-word g1-regression-output 6))
