;;; Actual constructor source with host handler/P1/native doubles only.
;;; This is NOT fe9 handler allocation, row promotion, native OOM or execution.
(load "source_test.scm")
(define guard-checks 0)
(define (guard-check label good)
  (if (not good) (error label))
  (set! guard-checks (+ guard-checks 1)))
(define (fresh-model!)
  (set! fixture-model (vector 'model))
  (set! fixture-owner (vector 'owner))
  (set! fixture-entry (vector fixture-model 'c4-model 'live fixture-owner 'seeded
    (vector 1 1729 0 0) (vector 1 1729 292 0) #f fixture-handles #f #f g3c4-model-profile))
  (vector-set! g3c4-model-registry 0 (list fixture-entry)))
(define (unrelated state)
  (let ((row (make-vector 12 #f)))
    (vector-set! row 0 (vector 'unrelated-token))
    (vector-set! row 1 state)
    (vector-set! row 2 (vector 'unrelated-model))
    (vector-set! row 4 (vector 'unrelated-owner)) row))
(define unrelated-live (unrelated 'live))
(define unrelated-pending (unrelated 'pending))
(define unrelated-dead (unrelated 'dead))
(define unaffected (list unrelated-live unrelated-pending unrelated-dead))
(define (reset-case!)
  (fresh-model!)
  (set! guard-install-hook (lambda () #t))
  (set! p1-capture-hook (lambda () #t))
  (set! fail-create? #f)
  (set! p1-train? #t)
  (vector-set! cpu4-model-bindings 0 unaffected))
(define (unrelated-preserved?)
  (and (eq? unrelated-live (list-ref unaffected 0))
       (eq? unrelated-pending (list-ref unaffected 1))
       (eq? unrelated-dead (list-ref unaffected 2))
       (eq? (vector-ref unrelated-live 1) 'live)
       (eq? (vector-ref unrelated-pending 1) 'pending)
       (eq? (vector-ref unrelated-dead 1) 'dead)))
(define exact-condition (vector 'host-exact-original-condition))
(define (caught-value thunk)
  (catch #t (lambda () (thunk) #f)
    (lambda (key . arguments)
      (if (eq? key 'source-reraise) (car arguments) (cons key arguments)))))
(define (retry!)
  (let ((before creates) (same-model fixture-model) (same-owner fixture-owner)
        (before-rows (vector-ref cpu4-model-bindings 0)))
    (let* ((token (cpu4-model-binding-create-internal fixture-model config))
           (row (cpu4-binding-record token 'guard-host)))
      (guard-check "exact same model/owner retry publishes live lease"
        (and (= creates (+ before 1)) (eq? (vector-ref row 1) 'live)
             (eq? (vector-ref row 2) same-model) (eq? (vector-ref row 4) same-owner)
             (eq? (vector-ref row 5) native-lease)))
      (guard-check "unrelated rows survive retry"
        (and (unrelated-preserved?) (eq? (cdr (vector-ref cpu4-model-bindings 0))
                                        before-rows)))
      (guard-check "retry lease drains" (cpu4-model-binding-release-internal! token)))))
(define selected (getenv "CPU4_BINDING_GUARD_CASE"))
(define (selected? name) (or (not selected) (string=? selected name)))
(if (selected? "install")
  (begin
    (reset-case!)
    (let ((before creates) (observed #f))
      (set! guard-install-hook
        (lambda ()
          (set! guard-install-hook (lambda () #t))
          (set! observed (eq? (vector-ref cpu4-model-bindings 0) unaffected))
          (raise exact-condition)))
      (guard-check "installation error preserves exact caught value"
        (eq? (caught-value (lambda () (cpu4-model-binding-create-internal fixture-model config))) exact-condition))
      (guard-check "handler install happens before any pending publication" observed)
      (guard-check "failed handler install changes no binding authority"
        (and (eq? (vector-ref cpu4-model-bindings 0) unaffected) (= creates before) (unrelated-preserved?)))
      (retry!))))
(if (selected? "promoted")
  (begin
    (reset-case!)
    (let ((stale #f) (promoted #f) (before creates))
      (set! p1-capture-hook
        (lambda ()
          (set! p1-capture-hook (lambda () #t))
          (set! stale (car (vector-ref cpu4-model-bindings 0)))
          (set! promoted (list->vector (vector->list stale)))
          ;; Host fault injection models canonical promotion/replacement.
          (vector-set! cpu4-model-bindings 0 (cons promoted unaffected))
          (raise exact-condition)))
      (guard-check "postpublication error preserves exact caught value"
        (eq? (caught-value (lambda () (cpu4-model-binding-create-internal fixture-model config))) exact-condition))
      (guard-check "cleanup rereads promoted canonical pending row"
        (and (eq? (car (vector-ref cpu4-model-bindings 0)) promoted)
             (eq? (vector-ref promoted 1) 'dead)))
      (guard-check "cleanup does not mutate stale prepromotion record" (eq? (vector-ref stale 1) 'pending))
      (guard-check "only same-owner pending authority dies"
        (and (eq? (cdr (vector-ref cpu4-model-bindings 0)) unaffected) (unrelated-preserved?) (= creates before)))
      (retry!))))
(if (selected? "p1")
  (begin
    (reset-case!)
    (set! p1-train? #f)
    (guard-check "strict TRAIN rejection remains" (reject (lambda () (cpu4-model-binding-create-internal fixture-model config))))
    (guard-check "TRAIN failure kills only new pending row"
      (and (eq? (vector-ref (car (vector-ref cpu4-model-bindings 0)) 1) 'dead)
           (eq? (cdr (vector-ref cpu4-model-bindings 0)) unaffected) (unrelated-preserved?)))
    (set! p1-train? #t)
    (retry!)))
(if (selected? "native")
  (begin
    (reset-case!)
    (set! fail-create? #t)
    (guard-check "native NULL rejection remains" (reject (lambda () (cpu4-model-binding-create-internal fixture-model config))))
    (guard-check "native NULL kills only new pending row"
      (and (eq? (vector-ref (car (vector-ref cpu4-model-bindings 0)) 1) 'dead)
           (eq? (cdr (vector-ref cpu4-model-bindings 0)) unaffected) (unrelated-preserved?)))
    (set! fail-create? #f)
    (retry!)))
(display "CPU4 binding guard fault/promotion host doubles PASS: checks=")
(display guard-checks) (newline)
