;;; Host-only fault harness for the actual Eshkol wrapper source. Native FFI
;;; calls are controlled stubs; the C bytevector-header contract has its own
;;; focused native test.
(use-modules (rnrs bytevectors) ((rnrs exceptions) #:select (guard)))
(define-syntax extern (syntax-rules () ((_ . ignored) #t)))
(define-syntax m3-call (syntax-rules () ((_ operation body ...)
                                         (begin body ...))))
(define g3c4-model-profile 'diagnostic-c4)
(define g3c4-registry (vector '()))
(define checks 0)
(define (check condition)
  (if condition (set! checks (+ checks 1)) (error "typed wrapper host check")))
(define (reject thunk)
  (catch #t (lambda () (thunk) #f) (lambda ignored #t)))
(define (g3c4-fail category operation message) (error message))
(define (g3c4-native-fail operation) (error "native failure"))
(define (g3c4-native-check status operation)
  (if (= status 0) #t (g3c4-native-fail operation)))
(define (g3c4-entry-dead! entry)
  (let loop ((index 3))
    (if (< index 12)
        (begin (vector-set! entry index #f) (loop (+ index 1)))))
  (vector-set! entry 2 'dead) #t)
(define (g3c4-dead-entry? entry kind)
  (and (vector? entry) (= (vector-length entry) 12)
       (eq? (vector-ref entry 1) kind)
       (eq? (vector-ref entry 2) 'dead)))
(define (g3c4-registry-find shell operation)
  (let loop ((nodes (vector-ref g3c4-registry 0)))
    (if (null? nodes) (g3c4-fail 'invalid-argument operation "missing owner")
        (if (eq? (vector-ref (car nodes) 0) shell)
            (car nodes) (loop (cdr nodes))))))
(define (g3c4-p2g2-terminal-ids-entry-live shell operation)
  (let ((entry (g3c4-registry-find shell operation)))
    (if (not (and (eq? (vector-ref entry 1) 'terminal-ids)
                  (eq? (vector-ref entry 2) 'live)
                  (= (vector-ref entry 7) 1)
                  (= (bytevector-length (vector-ref entry 8)) 8)))
        (g3c4-fail 'invalid-state operation "changed clone"))
    entry))
(define (g3c4-p2g2-terminal-snapshot-small-word bytes offset)
  (let loop ((index 1))
    (if (< index 8)
        (begin (if (not (= (bytevector-u8-ref bytes (+ offset index)) 0))
                   (error "non-small word"))
               (loop (+ index 1)))))
  (bytevector-u8-ref bytes offset))
(define (g3c4-p2g2-zero-bytes! bytes count)
  (let loop ((index 0))
    (if (< index count)
        (begin (bytevector-u8-set! bytes index 0) (loop (+ index 1)))))
  #t)

(define fault 'none)
(define created 0)
(define released 0)
(define (native-create kind value length)
  (if (eq? fault 'create) '()
      (begin (set! created (+ created 1))
             (vector kind value length 'live))))
(define (g3c4-p2g2-native-typed-ids-create source)
  (native-create 10 0 1))
(define (g3c4-p2g2-native-typed-scalar-create kind value)
  (native-create kind value 1))
(define (g3c4-p2g2-native-typed-length native)
  (if (eq? fault 'length) -1 (vector-ref native 2)))
(define (g3c4-p2g2-native-typed-copy native count bytes extent)
  (if (eq? fault 'copy) 2
      (begin
        (if (not (and (= extent (+ 8 (* count 8)))
                      (= (bytevector-length bytes) (* count 8))))
            (error "wrong extent"))
        (bytevector-u8-set! bytes 0 (vector-ref native 1))
        0)))
(define (g3c4-p2g2-native-typed-release native)
  (if (not (eq? (vector-ref native 3) 'live)) (error "double native release"))
  (vector-set! native 3 'dead)
  (set! released (+ released 1))
  0)

(load (or (getenv "G3C4_TEST_SOURCE")
          (string-append (getenv "G3C4_TEST_ROOT")
                         "/native/g3c4_p2g2_typed_result_extension.esk")))

(define clone-shell (vector 'clone))
(define source-bytes (make-bytevector 8 0))
;;; ID zero makes a bare unchecked copy return a plausible zero-filled
;;; destination; the injected copy failure must still reject publication.
(define source-entry
  (vector clone-shell 'terminal-ids 'live (vector 'source) #f #f #f
          1 source-bytes #f #f g3c4-model-profile))
(vector-set! g3c4-registry 0 (list source-entry))
(define original-root (vector-ref g3c4-registry 0))
(define original-anchors (vector-ref g3c4-p2g2-typed-anchors 0))
(define (registry-length)
  (length (vector-ref g3c4-registry 0)))

(for-each
  (lambda (mode)
    (set! fault mode)
    (let loop ((index 0))
      (if (< index 64)
          (begin
            (check (reject (lambda ()
                             (g3c4-p2g2-typed-create-private
                               clone-shell 'typed-ids))))
            (check (eq? (vector-ref g3c4-registry 0) original-root))
            (check (eq? (vector-ref g3c4-p2g2-typed-anchors 0)
                        original-anchors))
            (check (= (registry-length) 1))
            (check (eq? (g3c4-registry-find clone-shell 'test)
                        source-entry))
            (loop (+ index 1))))))
  '(create length copy))
(check (= created released))

(set! fault 'none)
(define owner
  (car (g3c4-p2g2-typed-create-private clone-shell 'typed-ids)))
(define live (g3c4-p2g2-typed-entry-live owner 'test))
(check (= (bytevector-length (vector-ref live 8)) 8))
(set! fault 'copy)
(check (reject (lambda () (g3c4-p2g2-typed-copy-private owner))))
(check (eq? (g3c4-p2g2-typed-entry-live owner 'test) live))
(set! fault 'none)
(check (= (bytevector-length (g3c4-p2g2-typed-copy-private owner)) 8))
(vector-set! live 2 'dead)
(check (reject (lambda () (g3c4-p2g2-typed-release-private! owner))))
(vector-set! live 2 'live)
(check (g3c4-p2g2-typed-release-private! owner))
(check (g3c4-p2g2-typed-release-private! owner))
(check (= created released))
(display "G3-C4 private typed wrapper rollback PASS: checks=")
(display checks)
(newline)
