;;; Source candidate only. One reader/TR3/G3 registry; the producer root is
;;; deliberately absent. The caller owns a freshly authenticated receipt and
;;; fresh idle trainer and has independently sealed the transcript producer.
(load "g3r_trained_pair_reader_root.esk")
(load "g3r_c2_receipt_tr3_restore_extension.esk")
(load "g3r_rng_import_extension.esk")
(load "g3r_replayed_p1_g1_extension.esk")

(extern i64 g3rf-host-little-endian
        :real et_g3r_private_fresh_host_le_v1)
(extern i64 g3rf-test-cache-length ptr
        :real et_g3t_test_cache_length_v1)
(extern i64 g3rf-test-cache-kv ptr i64 i64
        :real et_g3t_test_manual_cache_kv_word_v1)
(extern i64 g3rf-test-logit ptr i64
        :real et_g3t_test_logit_bits_v1)
(extern i64 g3rf-test-rng ptr i64
        :real et_g3t_test_rng_word_v1)
(extern i64 g3rf-test-output ptr i64
        :real et_g3t_test_output_word_v1)

(define g3rf-size 6292)
(define g3rf-c2-sha
  "9ec2a1d40ebd43e57d1e8b75fa8f6d96cd4d17abc1002f70da04d20144ee78df")
(define g3rf-companion-sha
  "75fec71697cf50556228481b0a2a30f634ce8991a7f6db4ad7fbdc700f1cfbf2")
(define g3rf-paths tr3-c-joint-fixed-paths)
(define g3rf-shapes tr3-c-joint-fixed-shapes)

(define (g3rf-fail detail)
  (c2-load-fail 'invalid-state 'g3r-trained-fresh-consume! detail '()))

(define (g3rf-hex-digit character)
  (let ((code (char->integer character)))
    (cond ((and (>= code 48) (<= code 57)) (- code 48))
          ((and (>= code 97) (<= code 102)) (- code 87))
          (else (g3rf-fail "invalid fixed digest literal")))))

(define (g3rf-sha=? bytes hex)
  (and (bytevector? bytes) (= (bytevector-length bytes) 32)
       (string? hex) (= (string-length hex) 64)
       (let loop ((index 0))
         (if (= index 32) #t
             (and (= (bytevector-u8-ref bytes index)
                     (+ (* 16 (g3rf-hex-digit (string-ref hex (* index 2))))
                        (g3rf-hex-digit (string-ref hex (+ (* index 2) 1)))))
                  (loop (+ index 1)))))))

(define (g3rf-words index)
  (cond ((<= index 3) 16) ((<= index 5) 32)
        ((<= index 9) 4) ((= index 10) 1024)
        ((<= index 12) 4) (else 8)))

(define (g3rf-rank index)
  (if (or (and (>= index 6) (<= index 9))
          (and (>= index 11) (<= index 12))) 1 2))

(define (g3rf-dim0 index)
  (cond ((= index 5) 8) ((= index 10) 256)
        ((= index 13) 2) (else 4)))

(define (g3rf-dim1 index)
  (cond ((= (g3rf-rank index) 1) 0)
        ((= index 4) 8) (else 4)))

;;; Decoder validates everything before publishing the single destination.
(define (g3rf-decode! bytes digest companion destination)
  (if (not (and (bytevector? bytes) (= (bytevector-length bytes) g3rf-size)
                (bytevector? digest) (= (bytevector-length digest) 32)
                (bytevector? companion) (= (bytevector-length companion) 288)
                (vector? destination) (= (vector-length destination) 1)
                (= (g3rf-host-little-endian) 1)
                (g3rf-sha=? digest g3rf-c2-sha)
                (g3rf-sha=? (c1-sha256 companion) g3rf-companion-sha)))
      (g3rf-fail "unsealed transcript or pair input"))
  (let ((decoded (make-vector 8 #f)))
    (g3r-record-decode! companion digest decoded)
    (if (not (and (= (vector-ref (vector-ref decoded 0) 4) 1)
                  (= (vector-ref decoded 3) 1)
                  (= (vector-ref decoded 4) 0)
                  (= (vector-ref decoded 5) 0)
                  (= (bytevector-length (vector-ref decoded 2)) 1)
                  (= (bytevector-u8-ref (vector-ref decoded 2) 0) 65)))
        (g3rf-fail "companion policy or prompt changed"))
    (if (not (and (g3r-bytes=? bytes 0 (string->utf8 "G3RTV1") 0 6)
                  (g3r-zero-range? bytes 6 8)
                  (= (g3r-u-read bytes 8 4) 1)
                  (= (g3r-u-read bytes 12 4) g3rf-size)
                  (g3r-bytes=? bytes 16 digest 0 32)
                  (g3r-bytes=? bytes 48 (c1-sha256 companion) 0 32)
                  (= (g3r-u-read bytes 80 4) 65)
                  (= (g3r-u-read bytes 84 4) 2)
                  (= (g3r-u-read bytes 88 4) 14)
                  (= (g3r-u-read bytes 92 4) 0)
                  (g3r-bytes=? bytes 6260
                                (c1-sha256 (bytevector-copy bytes 0 6260))
                                0 32)))
        (g3rf-fail "transcript header or checksum changed"))
    (let records ((index 0) (offset 96))
      (if (= index 14)
          (if (not (= offset 5056))
              (g3rf-fail "transcript roster extent changed"))
          (if (not (and (= (g3r-u-read bytes offset 4) index)
                        (= (g3r-u-read bytes (+ offset 4) 4)
                           (g3rf-rank index))
                        (= (g3r-u-read bytes (+ offset 8) 4)
                           (g3rf-dim0 index))
                        (= (g3r-u-read bytes (+ offset 12) 4)
                           (g3rf-dim1 index))))
              (g3rf-fail "transcript parameter roster changed")
              (records (+ index 1)
                       (+ offset 16 (* 4 (g3rf-words index)))))))
    (if (not (and (= (g3r-u-read bytes 6144 4) 1)
                  (= (g3r-u-read bytes 6148 4) 1)
                  (<= (g3r-u-read bytes 6152 4) 255)
                  (= (g3r-u-read bytes 6252 4) 1)
                  (= (g3r-u-read bytes 6256 4) 2)))
        (g3rf-fail "transcript trace bounds changed"))
    (let rng ((index 0))
      (if (< index 4)
          (if (not (= (g3r-i64-read bytes (+ 6112 (* index 8)))
                      (g3r-i64-read companion (+ 88 (* index 8)))))
              (g3rf-fail "P1 RNG differs from companion")
              (rng (+ index 1)))))
    (vector-set! destination 0 (vector (bytevector-copy bytes) decoded))
    #t))

;;; Native I2 copies physical f32 storage bytes; no numeric conversion occurs.
(define (g3rf-model-bits! model bytes)
  (let* ((tree (module-parameters model))
         (paths (cli3-b-unique-paths tree))
         (head (parameter-tree-handle tree '("head" "weight")))
         (embedding
           (parameter-tree-handle tree '("token_embedding" "weight"))))
    (if (not (and (eq? head embedding)
                  (eq? (parameter-handle-tensor-identity-internal head)
                       (parameter-handle-tensor-identity-internal embedding))))
        (g3rf-fail "fresh tied embedding identity changed"))
    (let loop ((remaining paths) (index 0) (offset 96))
      (if (= index 14)
          (if (not (and (null? remaining) (= offset 5056)))
              (g3rf-fail "fresh model roster count changed"))
          (if (null? remaining)
              (g3rf-fail "fresh model roster is short")
              (let* ((path (car remaining))
                     (handle (parameter-tree-handle tree path))
                     (shape (parameter-handle-shape handle))
                     (length (* 4 (g3rf-words index)))
                     (payload
                       (i2-checkpoint-encode
                         (vector (parameter-handle-tensor-internal handle)
                                 'parameter shape 'f32 'cpu
                                 'dense-row-major-contiguous
                                 'g3r-trained-fresh-consume!))))
                (if (not (and (equal? path (tr3-c-joint-list-ref
                                            g3rf-paths index))
                              (equal? shape (tr3-c-joint-list-ref
                                               g3rf-shapes index))
                              (equal? (parameter-handle-path handle) path)
                              (eq? (parameter-handle-dtype handle) 'f32)
                              (eq? (parameter-handle-device handle) 'cpu)
                              (= (bytevector-length payload) length)
                              (g3r-bytes=? bytes (+ offset 16)
                                            payload 0 length)))
                    (g3rf-fail "fresh live parameter bits differ"))
                (loop (cdr remaining) (+ index 1)
                      (+ offset 16 length))))))))

;;; Source carriers are compared only under the exact receipt/C2/P1 borrow.
(define (g3rf-receipt-model-bits! receipt model)
  (let ((operation 'g3r-trained-fresh-consume!)
        (receipt-cell (vector #f))
        (access-cell (vector #f)))
    (guard (caught
             (#t
               (if (vector-ref access-cell 0)
                   (guard (cleanup-defect (#t (exit 134)))
                     (let ((active (vector-ref access-cell 0)))
                       (state-dict-c2-owned-tensor-borrow-end-internal
                         (vector-ref active 0) (vector-ref active 1)
                         (vector-ref active 2) operation))))
               (if (vector-ref receipt-cell 0)
                   (guard (cleanup-defect (#t (exit 134)))
                     (g3r-c2-receipt-borrow-end-internal!
                       (vector-ref receipt-cell 0))))
               (raise caught)))
      (vector-set! receipt-cell 0
        (g3r-c2-receipt-borrow-begin-internal receipt operation))
      (let* ((c2-borrow
               (g3r-c2-receipt-borrow-c2-internal
                 (vector-ref receipt-cell 0) operation))
             (projection
               (c2-training-state-borrow-projection-internal c2-borrow))
             (token
               (c2-training-state-borrow-owner-token-internal
                 c2-borrow operation))
             (source-p1 (vector-ref projection 0))
             (topology (vector-ref projection 3))
             (p1-projection
               (state-dict-c2-owned-projection-internal
                 source-p1 token operation))
             (entries
               (tr3-c-joint-fixed-source!
                 source-p1 p1-projection topology))
             (tree (module-parameters model)))
        (let loop ((index 0) (remaining entries))
          (if (= index 14) #t
              (let* ((entry (car remaining))
                     (path (tr3-c-joint-list-ref g3rf-paths index))
                     (handle (parameter-tree-handle tree path))
                     (carrier
                       (state-dict-c2-owned-tensor-borrow-begin-internal
                         source-p1 token entry operation)))
                (vector-set! access-cell 0 (vector source-p1 token entry))
                (if (not (i2-value-equal?
                           (vector carrier
                                   (parameter-handle-tensor-internal handle)
                                   'parameter operation)))
                    (g3rf-fail "fresh model differs from exact C2 carrier"))
                (state-dict-c2-owned-tensor-borrow-end-internal
                  source-p1 token entry operation)
                (vector-set! access-cell 0 #f)
                (loop (+ index 1) (cdr remaining))))))
      (g3r-c2-receipt-borrow-end-internal!
        (vector-ref receipt-cell 0))
      (vector-set! receipt-cell 0 #f)
      #t)))

(define (g3rf-p1-trace! native bytes)
  (if (not (= (g3rf-test-cache-length native) 1))
      (g3rf-fail "fresh P1 cache length changed"))
  (let logits ((index 0))
    (if (< index 256)
        (if (not (= (g3rf-test-logit native index)
                    (g3r-u-read bytes (+ 5056 (* index 4)) 4)))
            (g3rf-fail "fresh P1 logit bit changed")
            (logits (+ index 1)))))
  (let kv ((which 0) (index 0))
    (if (< which 2)
        (if (= index 4) (kv (+ which 1) 0)
            (if (not (= (g3rf-test-cache-kv native which index)
                        (g3r-u-read bytes
                          (+ 6080 (* which 16) (* index 4)) 4)))
                (g3rf-fail "fresh P1 K/V bit changed")
                (kv which (+ index 1))))))
  (let rng ((index 0))
    (if (< index 4)
        (if (not (= (g3rf-test-rng native index)
                    (g3r-i64-read bytes (+ 6112 (* index 8)))))
            (g3rf-fail "fresh P1 RNG changed")
            (rng (+ index 1)))))
  #t)

(define (g3rf-g1-trace! native output bytes)
  (if (not (and (= (g3rf-test-cache-length native) 2)
                (= (g3rf-test-output output 1) 1)
                (= (g3rf-test-output output 2) 2)
                (= (g3rf-test-output output 6)
                   (g3r-u-read bytes 6152 4))))
      (g3rf-fail "fresh G1 ID or lengths changed"))
  (let kv ((which 0) (index 0))
    (if (< which 2)
        (if (= index 8) (kv (+ which 1) 0)
            (if (not (= (g3rf-test-cache-kv native which index)
                        (g3r-u-read bytes
                          (+ 6156 (* which 32) (* index 4)) 4)))
                (g3rf-fail "fresh G1 K/V bit changed")
                (kv which (+ index 1))))))
  (let rng ((index 0))
    (if (< index 4)
        (if (not (= (g3rf-test-rng native index)
                    (g3r-i64-read bytes (+ 6220 (* index 8)))))
            (g3rf-fail "fresh G1 RNG changed")
            (rng (+ index 1)))))
  #t)

;;; The caller constructs a fresh trainer in this root, authenticates the
;;; historical pair and producer transcript receipts, and owns cleanup of
;;; these inputs. This entry never opens another source registry.
(define (g3r-trained-fresh-consume-internal!
          receipt trainer tokenizer companion transcript)
  (let* ((operation 'g3r-trained-fresh-consume!)
         (record (tr3-lease-record-for-shell-internal trainer operation))
         (model (vector-ref record 8))
         (destination (vector 'untouched))
         (digest #f) (digest-borrow (vector #f))
         (imported #f) (generator #f)
         (input #f) (logits #f) (output #f))
    (define (cleanup)
      (if output (g3t-output-release! output))
      (if logits (g3t-generation-tensor-release! logits))
      (if input (g3t-generation-tensor-release! input))
      (if generator (g3t-generator-close! generator))
      (if imported (g3t-generation-rng-release! imported))
      #t)
    (guard (caught
             (#t (guard (cleanup-defect (#t (exit 134))) (cleanup))
                 (raise caught)))
      (if (or (not (eq? (vector-ref record 3) 'idle))
              (vector-ref record 4))
          (g3rf-fail "fresh trainer is not idle"))
      (guard (caught
               (#t (if (vector-ref digest-borrow 0)
                       (guard (cleanup-defect (#t (exit 134)))
                         (g3r-c2-receipt-borrow-end-internal!
                           (vector-ref digest-borrow 0))))
                   (raise caught)))
        (vector-set! digest-borrow 0
          (g3r-c2-receipt-borrow-begin-internal receipt operation))
        (set! digest
          (g3r-c2-receipt-borrow-sha-internal
            (vector-ref digest-borrow 0) operation))
        (g3r-c2-receipt-borrow-end-internal!
          (vector-ref digest-borrow 0))
        (vector-set! digest-borrow 0 #f))
      (g3rf-decode! transcript digest companion destination)
      (let* ((decoded (vector-ref (vector-ref destination 0) 1))
             (fingerprint
               (string->utf8 (t2-wave2-tokenizer-fingerprint tokenizer))))
        (if (not (and (= (bytevector-length fingerprint) 96)
                      (g3r-bytes=? fingerprint 0
                                    (vector-ref decoded 6) 0 96)))
            (g3rf-fail "fresh live tokenizer differs from C2 pair")))
      (g3r-c2-receipt-tr3-restore-internal! receipt trainer)
      (g3rf-receipt-model-bits! receipt model)
      (g3rf-model-bits! model (vector-ref (vector-ref destination 0) 0))
      (tr3-lease-unenroll-internal! trainer)
      (g3r-c2-receipt-release-internal! receipt)
      (module-eval! model)
      (let* ((bytes (vector-ref (vector-ref destination 0) 0))
             (decoded (vector-ref (vector-ref destination 0) 1))
             (policy (vector-ref decoded 0))
             (words (vector-ref decoded 1))
             (history (vector-ref decoded 2)))
        (set! imported
          (g3r-rng-owner-from-checked-words
            (vector-ref words 0) (vector-ref words 1)
            (vector-ref words 2) (vector-ref words 3)))
        (set! generator
          (g3t-generator-create model tokenizer
            (list ':profile 'diagnostic-c2 ':sampling 'categorical
                  ':temperature-bits (vector-ref policy 1)
                  ':top-k (vector-ref policy 2)
                  ':top-p-bits (vector-ref policy 3)
                  ':max-new-tokens (vector-ref policy 4)
                  ':eos #f ':rng imported)))
        (g3t-generation-rng-release! imported)
        (set! imported #f)
        (set! input
          (g3t-generation-token-input-create
            (bytevector-u8-ref history 0)))
        (set! logits (g3m-prefill-p1! generator input))
        (let ((native
                (vector-ref (g3t-generator-find generator operation) 3)))
          (g3rf-p1-trace! native bytes)
          (set! output (g3r-private-replayed-p1-g1! generator))
          (g3rf-g1-trace!
            native
            (vector-ref (g3t-prefill-entry output 'output operation) 3)
            bytes)
          (if (= (g3r-native-replay-preflight native) 0)
              (g3rf-fail "full-context no-draw guard admitted G2"))))
      (cleanup)
      #t)))

;;; Test-only file harness. A distinct executable owns one fresh registry and
;;; reads only the host-sealed C2, companion and transcript byte files.
(define (g3rf-private-test-run arguments)
  (if (not (and (vector? arguments) (= (vector-length arguments) 6)))
      (g3rf-fail "fresh caller requires six paths"))
  (vector-set! t2-wave2-policy-projector 0 c2-policy-t2-entry-internal)
  (let ((dataset #f) (trainer #f) (receipt #f))
    (guard (caught
             (#t
               (if receipt
                   (guard (defect (#t (exit 134)))
                     (g3r-c2-receipt-release-internal! receipt)))
               (if trainer
                   (guard (defect (#t (exit 134)))
                     (trainer-release! trainer)))
               (if dataset
                   (guard (defect (#t (exit 134)))
                     (d2-token-dataset-close! dataset)))
               (raise caught)))
      (let* ((resolved
               (cli3-b-resolved (vector-ref arguments 0) 'generate))
             (tokenizer
               (cli3-b-tokenizer (vector-ref arguments 1) resolved))
             (companion-path
               (cli3-path (vector-ref arguments 4) 'checkpoint-load))
             (transcript-path
               (cli3-path (vector-ref arguments 5) 'checkpoint-load))
             (companion (make-bytevector 288 0))
             (transcript (make-bytevector g3rf-size 0)))
        (if (not (and (= (file-size companion-path) 288)
                      (= (file-size transcript-path) g3rf-size)
                      (= (t1-native-read-exact companion-path companion
                                               288 288) 0)
                      (= (t1-native-read-exact transcript-path transcript
                                               g3rf-size g3rf-size) 0)))
            (g3rf-fail "fresh pair or transcript read failed"))
        (set! dataset
          (cli3-b-dataset (vector-ref arguments 2) tokenizer))
        (set! trainer (cli3-b-create-trainer resolved tokenizer dataset))
        (set! receipt
          (g3r-c2-load-with-sha-internal
            (cli3-path (vector-ref arguments 3) 'checkpoint-load)
            (cli3-b-policy) (k2-public-capability-discover)))
        (g3r-c2-pair-decode-internal!
          receipt companion (make-vector 8 #f))
        (if (not (g3r-trained-fresh-consume-internal!
                   receipt trainer tokenizer companion transcript))
            (g3rf-fail "fresh comparison did not complete"))
        ;; The consumer ended the idle trainer lease and receipt itself.
        (set! receipt #f)
        (set! trainer #f)
        (d2-token-dataset-close! dataset)
        (set! dataset #f)
        #t))))
