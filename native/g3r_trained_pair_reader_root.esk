;;; Fresh-process data-only reader in the same CLI3/T1/C2 package registry.
;;; The producer root is loaded once; no second tokenizer or C2 root exists.
(load "g3r_trained_pair_producer_root.esk")
(load "g3r_c2_sha_stage_extension.esk")
(load "g3r_c2_sha_receipt_extension.esk")
(load "g3r_c2_pair_decode_extension.esk")
(load "g3r_c2_pair_file_read_extension.esk")
(load "g3r_c2_pair_tokenizer_bind_extension.esk")
(load "g3r_trained_pair_reader_extension.esk")

(define (g3r-trained-pair-private-read arguments)
  (if (not (and (vector? arguments) (= (vector-length arguments) 4)))
      (c2-load-fail 'invalid-argument 'checkpoint-load
                    "trained-pair reader requires four paths" '()))
  (g3r-trained-pair-read-internal
    (vector-ref arguments 0) (vector-ref arguments 1)
    (vector-ref arguments 2) (vector-ref arguments 3)))
