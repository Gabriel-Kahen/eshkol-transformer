;;; Execute actual bounded classifiers with dependency doubles; no native claim.
(define (select-definitions path names)
 (call-with-input-file path
  (lambda (port)
   (let loop ()
    (let ((form (read port)))
     (if (not (eof-object? form))
      (begin
       (if (and (pair? form) (eq? (car form) 'define) (pair? (cadr form))
                (memq (car (cadr form)) names)) (eval form (current-module)))
       (loop))))))))
(define domain 0)
(define category 0)
(define (cpu4-train-native-domain) domain)
(define (cpu4-train-native-category) category)
(select-definitions "native/g3c4_model_extension.esk" '(g3c4-native-category))
(select-definitions "native/cpu4_training_schedule_extension.esk"
 '(cpu4-training-error-category cpu4-training-batch-profile!))
(define checks 0)
(define (check value) (if (not value) (error "schedule source check failed")) (set! checks (+ checks 1)))
