;;; The private bridge executes the real E3 evaluator on both D1 resources.
(extern void e3-n5-run ptr ptr ptr ptr :real et_e3_n5_run_v1)

(define (check condition)
  (if condition #t (begin (display "E3-N5-RUNTIME-FAIL") (newline) (exit 1))))
(define (count values)
  (let loop ((rest values) (n 0))
    (if (null? rest) n (loop (cdr rest) (+ n 1)))))
(define args (command-line))
(check (= (count args) 4))
(define output (vector #f))
(e3-n5-run (vector (car (cdr args)))
           (vector (car (cdr (cdr args))))
           (vector (car (cdr (cdr (cdr args))))) output)
(define result (vector-ref output 0))
(check (and (vector? result) (= (vector-length result) 4)
            (eq? (vector-ref result 0) 'e3-n5-cap-result-v1)
            (= (vector-ref result 1) 8192)
            (= (vector-ref result 2) 16384)
            (bytevector? (vector-ref result 3))))
(display "E3-N5-CAP-PASS control=8192 stage=2 rows=8193 cursor=unchanged outputs=6")
(newline)
