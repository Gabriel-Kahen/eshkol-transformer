;;; Source-private canonical C4/config/P1-to-native-lease producer.
;;; Load after X1, D2, G3-C4 model and cpu4_p1_fixed_set_extension.
;;; The constructor's slot7 stays #f. No M3T owner or copied parameter tree.
(extern ptr cpu4-native-lease-create ptr
        :real et_g3c4_private_training_lease_create_v1)
(extern ptr cpu4-native-lease-parameter ptr i64
        :real et_g3c4_private_training_lease_parameter_v1)
(extern ptr cpu4-native-lease-identity ptr i64
        :real et_g3c4_private_training_lease_identity_v1)
(extern i64 cpu4-native-lease-check ptr
        :real et_g3c4_private_training_lease_check_v1)
(extern i64 cpu4-native-lease-prepare-release ptr
        :real et_g3c4_private_training_lease_prepare_release_v1)
(extern i64 cpu4-native-lease-commit-release ptr
        :real et_g3c4_private_training_lease_commit_release_v1)
(extern void cpu4-binding-fail-stop i64 :real _Exit)
(extern i64 cpu4-native-dataset-idle ptr
        :real et_tr3_c_d2_dataset_idle_preflight_v1)

(define cpu4-model-bindings (vector '()))
;;; [token,state,model,C4-entry,native-owner,native-lease,resolved,canonical,
;;;  fingerprint,modules17,handles14,carriers14]. All entries remain rooted.
(define (cpu4-binding-fail category operation message)
  (g3c4-fail category operation message))
(define (cpu4-binding-profile! resolved operation)
  (x1-private-config-validate resolved)
  (let check ((rows '((model.context-length . 4) (model.hidden-size . 4)
                     (model.layer-count . 1) (model.query-head-count . 2)
                     (model.kv-head-count . 2) (model.head-size . 2)
                     (model.vocabulary-size . 256) (model.dtype . f32)
                     (model.device . cpu) (run.deterministic . #t))))
    (if (null? rows) #t
        (begin
          (if (not (equal? (x1-private-config-ref resolved (car (car rows)))
                           (cdr (car rows))))
              (cpu4-binding-fail 'unsupported operation
                                 "configuration differs from fixed CPU4 profile"))
          (check (cdr rows))))))
(define (cpu4-binding-p1-check status operation)
  (cond ((= status 0) #t)
        ((= status 1) (cpu4-binding-fail 'invalid-argument operation "CPU4 P1 identity differs"))
        ((= status 2) (cpu4-binding-fail 'invalid-state operation "CPU4 P1 tree must be idle in train mode"))
        ((= status 3) (cpu4-binding-fail 'unsupported operation "CPU4 P1 topology differs"))
        (else (cpu4-binding-fail 'invalid-state operation "CPU4 retained P1 identity changed"))))
(define (cpu4-binding-record token operation)
  (let find ((rows (vector-ref cpu4-model-bindings 0)))
    (cond ((null? rows) (cpu4-binding-fail 'invalid-argument operation "CPU4 binding is not registered"))
          ((eq? token (vector-ref (car rows) 0))
           (let ((record (car rows)))
             (if (not (and (vector? record) (= (vector-length record) 12)
                           (or (eq? (vector-ref record 1) 'live)
                               (eq? (vector-ref record 1) 'released))))
                 (cpu4-binding-fail 'invalid-state operation "CPU4 binding is not live"))
             record))
          (else (find (cdr rows))))))
(define (cpu4-binding-live-entry model operation)
  (let find ((rows (vector-ref g3c4-model-registry 0)))
    (cond ((null? rows) (cpu4-binding-fail 'invalid-argument operation "model is not in the canonical C4 registry"))
          ((eq? model (vector-ref (car rows) 0))
           (let ((entry (car rows)))
             (if (not (and (vector? entry) (= (vector-length entry) 12)
                           (eq? (vector-ref entry 1) 'c4-model)
                           (eq? (vector-ref entry 2) 'live)
                           (vector-ref entry 3)
                           (eq? (vector-ref entry 4) 'seeded)
                           (vector? (vector-ref entry 5)) (= (vector-length (vector-ref entry 5)) 4)
                           (vector? (vector-ref entry 6)) (= (vector-length (vector-ref entry 6)) 4)
                           (eq? (vector-ref entry 7) #f)
                           (vector? (vector-ref entry 8)) (= (vector-length (vector-ref entry 8)) 14)
                           (eq? (vector-ref entry 9) #f) (eq? (vector-ref entry 10) #f)
                           (eq? (vector-ref entry 11) g3c4-model-profile)))
                 (cpu4-binding-fail 'invalid-state operation "canonical C4 model is not live and idle"))
             (let ((seed (vector-ref (vector-ref entry 5) 1)))
               (if (not (and (m3t-exact-i64? seed) (>= seed 0)
                             (equal? (vector-ref entry 5) (vector 1 seed 0 0))
                             (equal? (vector-ref entry 6) (vector 1 seed 292 0))))
                   (cpu4-binding-fail 'invalid-state operation "C4 initializer identity differs")))
             entry))
          (else (find (cdr rows))))))
(define (cpu4-binding-config! record operation)
  (let* ((entry (cpu4-binding-live-entry (vector-ref record 2) operation))
         (resolved (vector-ref record 6))
         (owner (vector-ref record 4)))
    (cpu4-binding-profile! resolved operation)
    (if (not (and (eq? entry (vector-ref record 3))
                  (eq? owner (vector-ref entry 3))
                  (equal? (vector-ref record 7) (x1-private-config-canonical resolved))
                  (equal? (vector-ref record 8) (x1-private-config-fingerprint resolved))
                  (= (x1-private-config-ref resolved 'run.seed)
                     (vector-ref (vector-ref entry 5) 1))))
        (cpu4-binding-fail 'invalid-argument operation "CPU4 configuration or original seed differs"))
    (let words ((index 0))
      (if (= index 8) #t
          (let ((word (g3c4-native-owner-word owner index)))
            (g3c4-native-check (g3c4-native-last-error-category) operation)
            (if (not (= word (vector-ref (vector-ref entry (if (< index 4) 5 6))
                                               (if (< index 4) index (- index 4)))))
                (cpu4-binding-fail 'invalid-state operation "CPU4 native initializer words differ"))
            (words (+ index 1)))))
    entry))
(define (cpu4-binding-roster! record operation leased?)
  (let ((entry (cpu4-binding-config! record operation))
        (handles (vector-ref record 10))
        (carriers (vector-ref record 11))
        (owner (vector-ref record 4))
        (lease (vector-ref record 5)))
    (let check ((index 0))
      (if (= index 14) #t
          (let* ((handle (vector-ref handles index))
                 (carrier (i2-carrier-preflight (vector-ref carriers index) 'parameter operation))
                 (native (i2-native-g3c4-owner-parameter owner index)))
            (if (null? native) (g3c4-native-fail operation))
            (if (not (and (eq? handle (vector-ref (vector-ref entry 8) index))
                          (eq? (vector-ref carrier 3) handle)
                          (eq? (vector-ref carrier 2) native)))
                (cpu4-binding-fail 'invalid-state operation "CPU4 P1 carrier does not bind canonical parameter"))
            (if leased?
                (let ((parameter (cpu4-native-lease-parameter lease index))
                      (identity (cpu4-native-lease-identity lease index)))
                  (if (or (null? parameter) (null? identity)) (g3c4-native-fail operation))
                  (if (not (and (eq? parameter native) (eq? identity handle)))
                      (cpu4-binding-fail 'invalid-state operation "CPU4 native lease roster differs"))))
            (check (+ index 1)))))))
(define (cpu4-model-binding-create-internal model resolved)
  (let ((operation 'cpu4-model-binding-create))
    (cpu4-binding-profile! resolved operation)
    (let* ((entry (cpu4-binding-live-entry model operation))
           (owner (vector-ref entry 3)))
      (if (not (= (x1-private-config-ref resolved 'run.seed)
                  (vector-ref (vector-ref entry 5) 1)))
          (cpu4-binding-fail 'invalid-argument operation "CPU4 config seed differs from native model seed"))
      (let overlap ((rows (vector-ref cpu4-model-bindings 0)))
        (if (null? rows) #t
            (begin
              (if (and (not (eq? (vector-ref (car rows) 1) 'dead))
                       (or (eq? model (vector-ref (car rows) 2))
                           (eq? owner (vector-ref (car rows) 4))))
                  (cpu4-binding-fail 'invalid-state operation "CPU4 model already has a durable config binding"))
              (overlap (cdr rows)))))
      (let* ((record (vector (vector #f) 'pending model entry owner #f resolved
                             (x1-private-config-canonical resolved)
                             (x1-private-config-fingerprint resolved)
                             (make-vector 17 #f) (make-vector 14 #f) (make-vector 14 #f)))
             (next (cons record (vector-ref cpu4-model-bindings 0))))
        (vector-set! cpu4-model-bindings 0 next)
        (let ((canonical (car (vector-ref cpu4-model-bindings 0))))
          (guard (caught
                   (#t (vector-set! canonical 1 'dead) (raise caught)))
            (cpu4-binding-p1-check
              (cpu4-p1-fixed-capture-internal model (vector-ref entry 8)
                (vector-ref canonical 9) (vector-ref canonical 10) (vector-ref canonical 11))
              operation)
            (cpu4-binding-roster! canonical operation #f)
            ;; Every Eshkol allocation/provider/P1/config check precedes native
            ;; publication. Successful return has only the rooted store tail.
            (let ((lease (cpu4-native-lease-create owner)))
              (if (null? lease) (g3c4-native-fail operation))
              (vector-set! canonical 5 lease)
              (vector-set! canonical 1 'live)
              (vector-ref canonical 0))))))))
(define (cpu4-model-binding-check-internal token)
  (let* ((operation 'cpu4-model-binding-check)
         (record (cpu4-binding-record token operation)))
    (if (not (eq? (vector-ref record 1) 'live))
        (cpu4-binding-fail 'invalid-state operation "CPU4 training lease is released"))
    (g3c4-native-check (cpu4-native-lease-check (vector-ref record 5)) operation)
    (cpu4-binding-p1-check
      (cpu4-p1-fixed-recheck-internal (vector-ref record 2)
        (vector-ref record 9) (vector-ref record 10) (vector-ref record 11)) operation)
    (cpu4-binding-roster! record operation #t)
    record))
(define (cpu4-model-binding-native-lease-internal token)
  (vector-ref (cpu4-model-binding-check-internal token) 5))
(define (cpu4-model-binding-model-internal token)
  (let ((record (cpu4-binding-record token 'cpu4-model-binding-model)))
    (cpu4-binding-config! record 'cpu4-model-binding-model)
    (vector-ref record 2)))
(define (cpu4-model-binding-release-internal! token)
  (let* ((operation 'cpu4-model-binding-release!)
         (record (cpu4-binding-record token operation)))
    (if (eq? (vector-ref record 1) 'released) #t
        (begin
          (cpu4-model-binding-check-internal token)
          (g3c4-native-check (cpu4-native-lease-prepare-release (vector-ref record 5)) operation)
          ;; Native commit is allocation-free, exact prepared lease only.
          (if (not (= (cpu4-native-lease-commit-release (vector-ref record 5)) 0))
              (cpu4-binding-fail-stop 70))
          (vector-set! record 5 #f)
          (vector-set! record 1 'released)
          #t))))

(define (cpu4-d2-idle-core dataset operation)
  (let* ((state (d2-open-dataset-state dataset operation))
         (core (vector-ref state 6)))
    (if (not (and (d2-core-state-valid? core 'd2-dataset-state)
                  (= (vector-ref core 3) 256) (= (vector-ref core 4) 1)
                  (= (vector-ref core 5) 4) (>= (vector-ref core 9) 68)))
        (cpu4-binding-fail 'unsupported operation "dataset must be CPU4 N1/T4/V256 with 68-byte batch capacity"))
    (if (not (and (d2-core-nonnegative-i64? (vector-ref state 8))
                  (d2-core-nonnegative-i64? (vector-ref state 15))
                  (= (vector-ref state 15) 0)
                  (or (eq? (vector-ref state 10) 'none)
                      (eq? (vector-ref state 10) 'released))
                  (or (eq? (vector-ref state 10) 'none)
                      (> (vector-ref state 8) 0))))
        (cpu4-binding-fail 'invalid-state operation "CPU4 dataset has a live batch or borrow"))
    (let ((status (cpu4-native-dataset-idle (vector-ref state 1))))
      (if (not (= status (d2-native-last-status)))
          (cpu4-binding-fail 'internal operation "CPU4 dataset idle status diverged"))
      (if (not (= status 0))
        (cpu4-binding-fail 'invalid-state operation "CPU4 native dataset is not idle")))
    core))
(define (cpu4-d2-cursor-capture-internal dataset)
  (let* ((operation 'cpu4-d2-cursor-capture)
         (core (cpu4-d2-idle-core dataset operation))
         (cursor (d2-core-cursor-snapshot core))
         (decoded (d2-core-cursor-decode cursor)))
    (if (not (and (d2-core-state-identity=? core decoded)
                  (= (vector-ref core 14) (vector-ref decoded 14))
                  (= (vector-ref core 15) (vector-ref decoded 15))))
        (cpu4-binding-fail 'invalid-state operation "CPU4 captured cursor differs"))
    cursor))
(define (cpu4-d2-cursor-restore-internal! dataset cursor)
  ;; Decoder preflight precedes public seek, so it needs the existing core-error
  ;; boundary too. Preserve decoder category/operation/message; already
  ;; structured CPU4 profile errors and seek errors pass through unchanged.
  (d2-with-core-errors
    (lambda ()
      (let* ((operation 'cpu4-d2-cursor-restore!)
             (core (cpu4-d2-idle-core dataset operation))
             (decoded (d2-core-cursor-decode cursor)))
        (if (not (and (= (vector-ref decoded 3) 256)
                      (= (vector-ref decoded 4) 1) (= (vector-ref decoded 5) 4)
                      (d2-core-state-identity=? core decoded)))
            (cpu4-binding-fail 'invalid-argument operation "CPU4 restore cursor identity or sequence differs"))
        (d2-token-dataset-seek! dataset cursor)))))
