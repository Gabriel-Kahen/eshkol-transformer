;;; Isolated Scheme behavior probe: original rooted authority and release only.
(use-modules (rnrs exceptions) (rnrs bytevectors))
(define-syntax m3-call (syntax-rules () ((_ operation body) body)))
(define g3c4-model-profile (vector 'profile))
(define (m3t-exact-i64? value) (and (integer? value) (exact? value)))
(define (g3c4-fail . args) (throw 'invalid-state args))
(define (g3c4-p2g2-terminal-text-zero? bytes count)
  (let loop ((index 0))
    (or (= index count)
        (and (= (bytevector-u8-ref bytes index) 0)
             (loop (+ index 1))))))
(define (g3c4-p2g2-terminal-pending-check call pending operation)
  (vector-ref pending 0))
(define registered #f)
(define (g3c4-registry-find shell operation)
  (if (and (vector? registered) (eq? (vector-ref registered 0) shell))
      registered
      (g3c4-fail 'invalid-state operation "wrong shell")))
(define native-release-count 0)
(define held? #f)
(define (g3c4-native-output-release native)
  (set! native-release-count (+ native-release-count 1))
  (if held? 7 0))
(define (g3c4-native-check status operation)
  (g3c4-fail 'native-rejected operation status))
(define (g3c4-entry-dead! entry)
  (let loop ((index 3))
    (if (< index 12)
        (begin (vector-set! entry index #f) (loop (+ index 1)))))
  (vector-set! entry 2 'dead))
(define (g3c4-dead-entry? entry kind)
  (and (vector? entry) (= (vector-length entry) 12)
       (eq? (vector-ref entry 1) kind)
       (eq? (vector-ref entry 2) 'dead)))
(define (g3c4-p2g2-terminal-snapshot-live-for shell entry operation)
  (let ((live (car (vector-ref g3c4-p2g2-terminal-live-anchors 0))))
    (if (and (eq? (vector-ref live 1) entry)
             (eq? (vector-ref live 2) shell))
        live
        (g3c4-fail 'invalid-state operation "snapshot owner"))))
(load "../native/g3c4_p2g2_terminal_live_authority_extension.esk")
(load "../native/g3c4_p2g2_terminal_release_extension.esk")

(define (check predicate label)
  (if (not predicate) (error label)))
(define (rejected? thunk)
  (catch #t (lambda () (thunk) #f)
         (lambda args #t)))

(let* ((shell (vector 'terminal-shell))
       (native (vector 'native-output))
       (text-one (u8-list->bytevector '(17)))
       (text-two (u8-list->bytevector '(0 0)))
       (output (vector shell 'terminal-output 'pending native #f #f #f #f
                       #f #f #f g3c4-model-profile))
       (checked (make-vector 15 #f))
       (pending (vector checked))
       (frame (make-vector 31 #f)))
  (set! registered output)
  (vector-set! checked 4 output)
  (vector-set! checked 5 shell)
  (vector-set! checked 6 native)
  (vector-set! checked 13 text-one)
  (vector-set! checked 14 text-two)
  (vector-set! frame 3 output)
  (vector-set! frame 2 pending)
  (vector-set! frame 4 shell)
  (vector-set! frame 6 native)
  (vector-set! frame 11 1)
  (vector-set! frame 12 text-one)
  (vector-set! frame 27 text-one)
  (vector-set! frame 28 text-two)
  (let ((live (g3c4-p2g2-terminal-live-prepare #f pending)))
    (g3c4-p2g2-terminal-live-bind! #f pending live frame)
    (vector-set! output 8 text-one)
    (vector-set! output 2 'live)
    (vector-set! live 0 'live)
    (vector-set! g3c4-p2g2-terminal-live-anchors 0 (vector-ref live 13))
    (vector-set! g3c4-p2g2-terminal-live-originals 0 (vector-ref live 14))
    ;; A caller changes only the public mutable state marker. Native remains live.
    (vector-set! output 2 'dead)
    (check (rejected? (lambda () (g3c4-p2g2-terminal-release-private! shell)))
           "forged-dead release was accepted")
    (check (= native-release-count 0) "forged-dead reached native release")
    (check (eq? (vector-ref output 3) native) "forged-dead changed native")
    (vector-set! output 2 'live)
    (set! held? #t)
    (check (rejected? (lambda () (g3c4-p2g2-terminal-release-private! shell)))
           "held I1 release was accepted")
    (check (and (= native-release-count 1)
                (eq? (vector-ref output 2) 'live)
                (= (bytevector-u8-ref text-one 0) 17))
           "held I1 release mutated the owner")
    (set! held? #f)
    (check (g3c4-p2g2-terminal-release-private! shell) "release failed")
    (check (and (= native-release-count 2)
                (eq? (vector-ref output 2) 'dead)
                (eq? (vector-ref output 3) #f)
                (eq? (vector-ref live 0) 'dead)
                (= (bytevector-u8-ref text-one 0) 0)
                (= (bytevector-u8-ref text-two 0) 0)
                (= (bytevector-u8-ref text-two 1) 0))
           "native success did not clean the original")
    (check (g3c4-p2g2-terminal-release-private! shell) "repeat release failed")
    (check (= native-release-count 2) "repeat release called native")
    (display "G3-C4 terminal output dead authority behavior PASS\n")))
