;; Complete fixed-profile numerical composition; owners and phases are coordinated
;; by m3_model_extension.esk. Every numerical call uses accepted M3T role transport.
(define (m3-forward-schedule-internal workspace)
  (m3t-public-embedding! workspace 'token)
  (m3t-public-embedding! workspace 'position)
  (m3t-public-residual! workspace 'embeddings)
  (m3t-public-layer-norm! workspace 'block-input)
  (m3t-public-linear! workspace 'q)
  (m3t-public-linear! workspace 'k)
  (m3t-public-linear! workspace 'v)
  (m3t-public-heads-split! workspace 'q)
  (m3t-public-heads-split! workspace 'k)
  (m3t-public-heads-split! workspace 'v)
  (m3t-public-attention! workspace)
  (m3t-public-heads-merge! workspace)
  (m3t-public-linear! workspace 'attention-output)
  (m3t-public-residual! workspace 'attention)
  (m3t-public-layer-norm! workspace 'ffn-input)
  (m3t-public-linear! workspace 'ffn-up)
  (m3t-public-gelu! workspace)
  (m3t-public-linear! workspace 'ffn-down)
  (m3t-public-residual! workspace 'ffn)
  (m3t-public-layer-norm! workspace 'final)
  (m3t-public-linear! workspace 'tied-head)
  #t)

(define (m3-reverse-schedule-internal workspace)
  (m3t-public-linear-vjp! workspace 'tied-head)
  (m3t-public-layer-norm-vjp! workspace 'final)
  (m3t-public-residual-vjp! workspace 'ffn)
  (m3t-public-linear-vjp! workspace 'ffn-down)
  (m3t-public-gelu-vjp! workspace)
  (m3t-public-linear-vjp! workspace 'ffn-up)
  (m3t-public-layer-norm-vjp! workspace 'ffn-input)
  (m3t-public-sum! workspace 'ffn-residual-input)
  (m3t-public-residual-vjp! workspace 'attention)
  (m3t-public-linear-vjp! workspace 'attention-output)
  (m3t-public-heads-merge-vjp! workspace)
  (m3t-public-attention-vjp! workspace)
  (m3t-public-heads-split-vjp! workspace 'q)
  (m3t-public-heads-split-vjp! workspace 'k)
  (m3t-public-heads-split-vjp! workspace 'v)
  (m3t-public-linear-vjp! workspace 'q)
  (m3t-public-linear-vjp! workspace 'k)
  (m3t-public-linear-vjp! workspace 'v)
  (m3t-public-sum! workspace 'qkv-input)
  (m3t-public-layer-norm-vjp! workspace 'block-input)
  (m3t-public-sum! workspace 'attention-residual-input)
  (m3t-public-residual-vjp! workspace 'embeddings)
  (m3t-public-embedding-vjp! workspace 'token)
  (m3t-public-embedding-vjp! workspace 'position)
  (m3t-public-sum! workspace 'tied-weight)
  #t)
