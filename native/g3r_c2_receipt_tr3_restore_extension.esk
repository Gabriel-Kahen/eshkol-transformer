;;; Apply TR3 to the owner retained by this exact live C2/SHA receipt.
;;; The owner never leaves this aggregate. Candidate construction and teardown
;;; belong to the caller's same-registry ledger.
(define (g3r-c2-receipt-tr3-restore-internal! receipt trainer)
  (let* ((operation 'trainer-load-state!)
         (receipt-record (g3r-c2-receipt-find receipt)))
    (if (not receipt-record)
        (c2-load-fail 'invalid-argument operation
                      "expected exact C2/SHA receipt" '()))
    (if (or (not (eq? (vector-ref receipt-record 1) 'live))
            (vector-ref receipt-record 4))
        (c2-load-fail 'invalid-state operation
                      "C2/SHA receipt is busy or dead" '()))
    (let ((owner (vector-ref receipt-record 2)))
      (if (not (c2-load-exact-live-owner? owner))
          (c2-load-fail 'internal operation
                        "C2/SHA receipt lost its exact owner" '()))
      ;; Authenticate the receiver before making the receipt busy. The TR3
      ;; transaction repeats admission and owns its own rollback.
      (let ((trainer-record
              (tr3-lease-record-for-shell-internal trainer operation)))
        (if (or (not (eq? (vector-ref trainer-record 3) 'idle))
                (vector-ref trainer-record 4))
            (m3t-fail 'invalid-state operation
                      "candidate trainer is not idle and plan-free"))
        (tr3-lease-restore-enter-admission! trainer-record operation))
      ;; TR3 borrows the owner internally. Holding this private phase rejects
      ;; release and competing receipt borrows until TR3 closes its borrow.
      (vector-set! receipt-record 1 'restoring)
      (guard (caught
               (#t
                 (vector-set! receipt-record 1 'live)
                 (raise caught)))
        (let ((restored (tr3-c-joint-restore-internal! trainer owner)))
          (if (not (eq? restored #t)) (tr3-lease-fail-stop 134))
          (vector-set! receipt-record 1 'live)
          #t)))))
