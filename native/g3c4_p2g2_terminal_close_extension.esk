;;; Source-private fixed P2/G2 terminal close. Load after the protected scope,
;;; P2/G2 T1 prefix coordinator, and same-aggregate raw T1 decoder. This file
;;; adds no public generation route. Native terminal zero is irreversible.

(extern i64 g3c4-p2g2-native-eos-first-frame ptr ptr ptr i64
        :real et_g3c4_private_p2g2_eos_first_frame_carrier_v1)
(extern i64 g3c4-p2g2-native-second-frame ptr ptr ptr i64
        :real et_g3c4_private_p2g2_second_frame_carrier_v1)
(extern i64 g3c4-p2g2-native-terminal-commit ptr ptr ptr i64 ptr i64
        :real et_g3c4_private_p2g2_terminal_commit_v1)

;;; A terminal anchor is independent of call/prefix stacks. Its pending state
;;; grants no read or release authority. The original pending output entry is
;;; the only registry entry for its shell, including after publication.
;;; Slots: original shell, entry, native, text[1], text[2], count, state,
;;; original anchor identity, original raw[1] carriers, original input entry,
;;; original staging[8] carriers and pending raw[2]/staging[16], cache length,
;;; and a distinct publication witness set only in the native-zero tail.
(define g3c4-p2g2-terminal-anchors (vector '()))
(define g3c4-p2g2-terminal-originals (vector '()))

;;; This root is lexical, not a mutable exported vector/list. Registration
;;; returns a private token to the generating region for precommit removal.
;;; Neither lookup nor validation reveals the stored original checker or its
;;; token after the call returns. Paired rewrites of the visible output/anchor
;;; records therefore cannot redefine the allocation-time objects.
(define g3c4-p2g2-terminal-original-authority
  (let ((root '()))
    (lambda (action shell payload)
      (let find ((remaining root))
        (cond
          ((null? remaining)
           (if (eq? action 'register)
               (let ((token (vector 'g3c4-terminal-original-token)))
                 (set! root (cons (vector shell payload token) root))
                 token)
               #f))
          ((eq? (vector-ref (car remaining) 0) shell)
           (let ((original (car remaining)))
             (cond
               ((eq? action 'present)
                (eq? (vector-ref original 1) payload))
               ((eq? action 'check)
                (and (vector? payload) (= (vector-length payload) 12)
                     ((vector-ref original 1)
                       (vector-ref payload 0) (vector-ref payload 1)
                       (vector-ref payload 2) (vector-ref payload 3)
                       (vector-ref payload 4) (vector-ref payload 5)
                       (vector-ref payload 6) (vector-ref payload 7)
                       (vector-ref payload 8) (vector-ref payload 9)
                       (vector-ref payload 10) (vector-ref payload 11))))
               ((eq? action 'remove)
                (if (and (eq? remaining root)
                         (eq? (vector-ref original 2) payload))
                    (begin (set! root (cdr root)) #t)
                    #f))
               (else #f))))
          (else (find (cdr remaining))))))))

(define (g3c4-p2g2-terminal-original-for shell)
  (let loop ((remaining (vector-ref g3c4-p2g2-terminal-originals 0)))
    (cond ((null? remaining) #f)
          ((eq? (car (car remaining)) shell) (cdr (car remaining)))
          (else (loop (cdr remaining))))))

(define (g3c4-p2g2-terminal-anchor-for shell)
  (let loop ((remaining (vector-ref g3c4-p2g2-terminal-anchors 0)))
    (cond ((null? remaining) #f)
          ((eq? (vector-ref (car remaining) 0) shell) (car remaining))
          (else (loop (cdr remaining))))))

(define (g3c4-p2g2-terminal-selected staging operation)
  (if (not (and (bytevector? staging) (= (bytevector-length staging) 8)))
      (g3c4-fail 'invalid-state operation
                 "P2/G2 selected carrier allocation changed"))
  (let ((selected (bytevector-u8-ref staging 0)))
    (let upper ((index 1))
      (if (< index 8)
          (if (= (bytevector-u8-ref staging index) 0)
              (upper (+ index 1))
              (g3c4-fail 'invalid-state operation
                         "P2/G2 selected ID is outside V256"))))
    selected))

;;; The optional diagnostic repair runs only before native success. It is not
;;; chosen by a generic provider error code: K1 provider-rejected can describe
;;; more than an A2 view lease. A test that installed a genuine lease owns the
;;; matching release handle and can repair it while the original call is live.

(define (g3c4-p2g2-terminal-authenticate
          call input input-entry native-input output output-native
          first-raw first-staging second-raw second-staging
          pending-raw pending-staging text-one text-two
          terminal-anchor original-shell original-check operation)
  (let* ((record (g3c4-p2g2-protected-check call operation))
         (protected-anchor (g3c4-p2g2-anchor-for call))
         (ledger (vector-ref call 10))
         (auxiliary (vector-ref output 8)))
    (if (not (and (eq? (g3c4-input-entry-live input operation) input-entry)
                  (eq? (vector-ref input-entry 3) native-input)
                  (eq? (vector-ref record 6) output)
                  (eq? (vector-ref record 7) output-native)
                  (eq? (vector-ref record 11) first-raw)
                  (eq? (vector-ref record 12) first-staging)
                  (eq? (vector-ref record 9) pending-raw)
                  (eq? (vector-ref record 10) pending-staging)
                  (eq? (vector-ref ledger 4) output)
                  (eq? (vector-ref output 3) output-native)
                  (eq? (vector-ref output 8) auxiliary)
                  (eq? (vector-ref auxiliary 0) pending-raw)
                  (eq? (vector-ref auxiliary 1) pending-staging)
                  (eq? (g3c4-p2g2-terminal-anchor-for
                         original-shell) terminal-anchor)
                  (pair? (vector-ref g3c4-p2g2-terminal-anchors 0))
                  (eq? (car (vector-ref
                               g3c4-p2g2-terminal-anchors 0))
                       terminal-anchor)
                  (pair? (vector-ref g3c4-p2g2-terminal-originals 0))
                  (eq? (cdr (car (vector-ref
                                    g3c4-p2g2-terminal-originals 0)))
                       original-check)
                  (eq? (g3c4-p2g2-terminal-original-for
                         original-shell) original-check)
                  (g3c4-p2g2-terminal-original-authority
                    'present original-shell original-check)
                  (eq? (vector-ref output 0) original-shell)
                  (eq? (vector-ref terminal-anchor 0) original-shell)
                  (eq? (vector-ref terminal-anchor 1) output)
                  (eq? (vector-ref terminal-anchor 2) output-native)
                  (eq? (vector-ref terminal-anchor 3) text-one)
                  (eq? (vector-ref terminal-anchor 4) text-two)
                  (eq? (vector-ref terminal-anchor 6) 'pending)
                  (eq? (vector-ref terminal-anchor 7) terminal-anchor)
                  (eq? (vector-ref terminal-anchor 8) first-raw)
                  (eq? (vector-ref terminal-anchor 9) second-raw)
                  (eq? (vector-ref terminal-anchor 10) input-entry)
                  (eq? (vector-ref terminal-anchor 11) first-staging)
                  (eq? (vector-ref terminal-anchor 12) second-staging)
                  (eq? (vector-ref terminal-anchor 13) pending-raw)
                  (eq? (vector-ref terminal-anchor 14) pending-staging)
                  (= (vector-ref terminal-anchor 15) 0)
                  (eq? (vector-ref terminal-anchor 16) #f)
                  (eq? (vector-ref protected-anchor 0) call)
                  (bytevector? first-raw) (= (bytevector-length first-raw) 1)
                  (bytevector? first-staging)
                  (= (bytevector-length first-staging) 8)
                  (bytevector? second-raw) (= (bytevector-length second-raw) 1)
                  (bytevector? second-staging)
                  (= (bytevector-length second-staging) 8)
                  (bytevector? pending-raw)
                  (= (bytevector-length pending-raw) 2)
                  (bytevector? pending-staging)
                  (= (bytevector-length pending-staging) 16)
                  (bytevector? text-one) (= (bytevector-length text-one) 1)
                  (bytevector? text-two) (= (bytevector-length text-two) 2)
                  (not (eq? first-raw second-raw))
                  (not (eq? first-staging second-staging))
                  (not (eq? first-raw first-staging))
                  (not (eq? second-raw second-staging))
                  (not (eq? first-raw pending-raw))
                  (not (eq? second-raw pending-raw))
                  (not (eq? first-staging pending-staging))
                  (not (eq? second-staging pending-staging))
                  (not (eq? text-one text-two))))
        (g3c4-fail 'invalid-state operation
                   "P2/G2 terminal original allocation or owner changed"))
    (if (not (and
               (original-check original-shell output output-native
                               text-one text-two first-raw second-raw
                               first-staging second-staging pending-raw
                               pending-staging terminal-anchor)
               (g3c4-p2g2-terminal-original-authority
                 'check original-shell
                 (vector original-shell output output-native text-one
                         text-two first-raw second-raw first-staging
                         second-staging pending-raw pending-staging
                         terminal-anchor))))
        (g3c4-fail 'invalid-state operation
                   "P2/G2 original terminal closure changed"))
    record))

(define (g3c4-p2g2-terminal-output-live shell operation)
  (let* ((entry (g3c4-registry-find shell operation))
         (anchor (g3c4-p2g2-terminal-anchor-for shell))
         (original-check (g3c4-p2g2-terminal-original-for shell)))
    (if (not (and anchor (vector? anchor) (= (vector-length anchor) 17)
                  (eq? (vector-ref anchor 7) anchor)
                  (eq? (vector-ref anchor 0) shell)
                  (eq? (vector-ref anchor 1) entry)
                  (eq? (vector-ref anchor 2) (vector-ref entry 3))
                  (eq? (vector-ref anchor 6) 'live)
                  (eq? (vector-ref anchor 16) 'terminal-published)
                  (m3t-exact-i64? (vector-ref anchor 5))
                  (or (= (vector-ref anchor 5) 1)
                      (= (vector-ref anchor 5) 2))
                  (= (vector-ref anchor 15)
                     (if (= (vector-ref anchor 5) 1) 3 4))
                  (eq? (vector-ref anchor 10) #f)
                  (eq? (vector-ref anchor 11) #f)
                  (eq? (vector-ref anchor 12) #f)
                  (eq? (vector-ref anchor 13) #f)
                  (eq? (vector-ref anchor 14) #f)
                  (bytevector? (vector-ref anchor 3))
                  (= (bytevector-length (vector-ref anchor 3)) 1)
                  (bytevector? (vector-ref anchor 4))
                  (= (bytevector-length (vector-ref anchor 4)) 2)
                  (bytevector? (vector-ref anchor 8))
                  (= (bytevector-length (vector-ref anchor 8)) 1)
                  (bytevector? (vector-ref anchor 9))
                  (= (bytevector-length (vector-ref anchor 9)) 1)
                  (eq? (vector-ref entry 1) 'terminal-output)
                  (eq? (vector-ref entry 2) 'live)
                  (eq? (vector-ref entry 0) shell)
                  (eq? (vector-ref entry 4) #f)
                  (eq? (vector-ref entry 5) #f)
                  (eq? (vector-ref entry 6) #f)
                  (eq? (vector-ref entry 8)
                       (if (= (vector-ref anchor 5) 1)
                           (vector-ref anchor 3) (vector-ref anchor 4)))
                  (eq? (vector-ref entry 11) g3c4-model-profile)))
        (g3c4-fail 'invalid-state operation
                   "P2/G2 terminal shell is not independently live"))
    (if (not (and original-check
                  (original-check shell entry (vector-ref entry 3)
                                  (vector-ref anchor 3)
                                  (vector-ref anchor 4)
                                  (vector-ref anchor 8)
                                  (vector-ref anchor 9)
                                  #f #f #f #f anchor)
                  (g3c4-p2g2-terminal-original-authority
                    'check shell
                    (vector shell entry (vector-ref entry 3)
                            (vector-ref anchor 3) (vector-ref anchor 4)
                            (vector-ref anchor 8) (vector-ref anchor 9)
                            #f #f #f #f anchor))))
        (g3c4-fail 'invalid-state operation
                   "P2/G2 terminal original carriers changed"))
    entry))

;;; The only production entry owns the whole native call. No extensible body
;;; can execute after terminal commit. The success barrier and all list nodes
;;; are allocated before first sampling.
(define (g3c4-p2g2-terminal-generate-probed-internal
          generator input repair-precommit)
  (let* ((operation 'g3c4-p2g2-terminal-generate-internal)
         (input-entry (g3c4-p2g2-prefix-preflight generator input))
         (native-input (vector-ref input-entry 3)))
    (m3-call operation
      (let* ((generator-entry
               (g3c4-generator-entry-call-ready generator operation))
             (model-entry (vector-ref generator-entry 5))
             (tokenizer (vector-ref generator-entry 6))
             (core (car (cdr (g3c4-baseline-tokenizer-entry
                              tokenizer operation 'invalid-state
                              'invalid-state))))
             (native (vector-ref generator-entry 3))
             (policy (vector-ref generator-entry 7))
             (first-raw (make-bytevector 1 0))
             (first-staging (make-bytevector 8 0))
             (second-raw (make-bytevector 1 0))
             (second-staging (make-bytevector 8 0))
             (text-one (make-bytevector 1 0))
             (text-two (make-bytevector 2 0))
             (ledger (vector #f #f #f #f #f))
             (call (vector (vector 'g3c4-call-private) 'call 'pending #f
                           generator-entry model-entry tokenizer 2 #f #f
                           ledger g3c4-model-profile))
             (extents (vector 10 24 9 16))
             (record (vector call generator-entry model-entry tokenizer core
                             native #f #f #f #f #f first-raw first-staging
                             'before-prefix ledger policy extents
                             (vector-ref call 0) #f (vector-ref model-entry 3)))
             (protected-anchor
               (vector call generator-entry model-entry tokenizer core native
                       #f #f #f #f #f first-raw first-staging
                       'before-prefix ledger policy extents
                       (vector-ref call 0) #f (vector-ref model-entry 3)))
             (original-registry (vector-ref g3c4-registry 0))
             (original-records (vector-ref g3c4-p2g2-protected-records 0))
             (original-anchors (vector-ref g3c4-p2g2-protected-anchors 0))
             (registry-node (cons call original-registry))
             (record-node (cons record original-records))
             (anchor-node (cons protected-anchor original-anchors))
             (barrier (vector #f))
             (publication-witness (vector #f))
             (output #f) (output-native #f) (pending-raw #f)
             (pending-staging #f) (terminal-anchor #f)
             (original-terminals #f) (terminal-node #f)
             (pending-registry-node #f) (original-output-shell #f)
             (original-check #f)
             (original-originals
               (vector-ref g3c4-p2g2-terminal-originals 0))
             (originals-node #f) (original-rooted #f)
             (original-authority-token #f))
        (if (not (and (eq? (vector-ref generator-entry 9) #f)
                      (eq? (vector-ref model-entry 10) #f)
                      (eq? (vector-ref generator-entry 6) tokenizer)
                      (eq? (vector-ref input-entry 3) native-input)
                      (eq? (vector-ref generator-entry 7) policy)
                      (eq? (vector-ref policy 5) 2)
                      (g3c4-call-tuple? 2 2)))
            (g3c4-fail 'invalid-state operation
                       "P2/G2 terminal idle preflight changed"))
        (guard (caught
                 (#t
                   (if (vector-ref barrier 0) (exit 134))
                   (if (vector-ref ledger 0)
                       (begin
                         (guard (audit-failure (#t (exit 134)))
                           (if (and terminal-anchor original-rooted)
                               (g3c4-p2g2-terminal-authenticate
                                 call input input-entry native-input output
                                 output-native first-raw first-staging
                                 second-raw second-staging pending-raw
                                 pending-staging text-one text-two
                                 terminal-anchor original-output-shell
                                 original-check operation)
                               (g3c4-p2g2-protected-check call operation)))
                         (guard (abort-failure
                                (#t
                                  (if (repair-precommit call output)
                                      (guard (retry-failure (#t (exit 134)))
                                        (if original-rooted
                                            (g3c4-p2g2-terminal-authenticate
                                              call input input-entry
                                              native-input output output-native
                                              first-raw first-staging
                                              second-raw second-staging
                                              pending-raw pending-staging
                                              text-one text-two terminal-anchor
                                              original-output-shell
                                              original-check operation))
                                        (g3c4-p2g2-protected-abort! call))
                                      (exit 134))))
                           (g3c4-p2g2-protected-abort! call)))
                       (begin
                         (g3c4-call-dead! call)
                         (vector-set! record 0 #f)
                         (vector-set! protected-anchor 0 #f)
                         (vector-set! g3c4-p2g2-protected-records 0
                                      original-records)
                         (vector-set! g3c4-p2g2-protected-anchors 0
                                      original-anchors)))
                   (if terminal-anchor
                       (begin
                         (g3c4-p2g2-zero-bytes! text-one 1)
                         (g3c4-p2g2-zero-bytes! text-two 2)
                         (g3c4-p2g2-zero-bytes! second-raw 1)
                         (g3c4-p2g2-zero-bytes! second-staging 8)
                         (vector-set! terminal-anchor 6 'dead)
                         (vector-set! g3c4-p2g2-terminal-anchors 0
                                      original-terminals)
                         (vector-set! g3c4-p2g2-terminal-originals 0
                                      original-originals)))
                   (if original-authority-token
                       (if (not (g3c4-p2g2-terminal-original-authority
                                  'remove original-output-shell
                                  original-authority-token))
                           (exit 134)))
                   (raise caught)))
          (vector-set! g3c4-registry 0 registry-node)
          (vector-set! g3c4-p2g2-protected-records 0 record-node)
          (vector-set! g3c4-p2g2-protected-anchors 0 anchor-node)
          (g3c4-native-check (g3c4-native-call-acquire native 2 2)
                             operation)
          (vector-set! ledger 0 #t)
          (vector-set! model-entry 10 call)
          (vector-set! ledger 1 #t)
          (vector-set! generator-entry 9 call)
          (vector-set! ledger 2 #t)
          (vector-set! call 2 'live)
          (vector-set! ledger 3 'p2g2-protected)
          (if (not (eq? (vector-ref m3-call-state 0) #t)) (exit 134))
          (vector-set! m3-call-state 0 call)
          (set! output (g3c4-p2g2-protected-reserve call))
          (set! pending-registry-node (vector-ref g3c4-registry 0))
          (set! original-output-shell (vector-ref output 0))
          (set! output-native (vector-ref output 3))
          (set! pending-raw (vector-ref (vector-ref output 8) 0))
          (set! pending-staging (vector-ref (vector-ref output 8) 1))
          (set! original-terminals
                (vector-ref g3c4-p2g2-terminal-anchors 0))
          (set! terminal-anchor
                (vector (vector-ref output 0) output output-native
                        text-one text-two 0 'pending #f first-raw
                        second-raw input-entry first-staging second-staging
                        pending-raw pending-staging 0 #f))
          (vector-set! terminal-anchor 7 terminal-anchor)
          (set! terminal-node (cons terminal-anchor original-terminals))
          (vector-set! g3c4-p2g2-terminal-anchors 0 terminal-node)
          (set! original-check
                (let ((fixed-shell original-output-shell)
                      (fixed-entry output) (fixed-native output-native)
                      (fixed-one text-one) (fixed-two text-two)
                      (fixed-first first-raw) (fixed-second second-raw)
                      (fixed-first-stage first-staging)
                      (fixed-second-stage second-staging)
                      (fixed-pending-raw pending-raw)
                      (fixed-pending-stage pending-staging)
                      (fixed-anchor terminal-anchor)
                      (fixed-publication publication-witness))
                  (lambda (shell entry native one two raw-one raw-two
                           stage-one stage-two raw-pending stage-pending
                           anchor)
                    (and (eq? shell fixed-shell)
                         (eq? entry fixed-entry)
                         (eq? native fixed-native)
                         (eq? one fixed-one) (eq? two fixed-two)
                         (eq? raw-one fixed-first)
                         (eq? raw-two fixed-second)
                         (eq? anchor fixed-anchor)
                         (if (eq? (vector-ref fixed-anchor 6) 'pending)
                             (and (not (vector-ref fixed-publication 0))
                                  (eq? stage-one fixed-first-stage)
                                  (eq? stage-two fixed-second-stage)
                                  (eq? raw-pending fixed-pending-raw)
                                  (eq? stage-pending fixed-pending-stage))
                             (and (vector-ref fixed-publication 0)
                                  (eq? stage-one #f) (eq? stage-two #f)
                                  (eq? raw-pending #f)
                                  (eq? stage-pending #f)))))))
          (set! originals-node
                (cons (cons original-output-shell original-check)
                      original-originals))
          (vector-set! g3c4-p2g2-terminal-originals 0 originals-node)
          (set! original-authority-token
                (g3c4-p2g2-terminal-original-authority
                  'register original-output-shell original-check))
          (if (not original-authority-token)
              (g3c4-fail 'invalid-state operation
                         "P2/G2 original terminal shell already rooted"))
          (set! original-rooted #t)
          (g3c4-p2g2-terminal-authenticate
            call input input-entry native-input output output-native
            first-raw first-staging second-raw second-staging
            pending-raw pending-staging text-one text-two terminal-anchor
            original-output-shell original-check operation)
          (g3c4-native-check
            (g3c4-p2g2-native-eos-first-frame native native-input
                                                first-staging 16)
            operation)
          (let ((first (g3c4-p2g2-terminal-selected first-staging operation)))
            (g3c4-p2g2-terminal-authenticate
              call input input-entry native-input output output-native
              first-raw first-staging second-raw second-staging
              pending-raw pending-staging text-one text-two terminal-anchor
              original-output-shell original-check operation)
            (t1-private-g3-decode-raw-into! tokenizer first-staging first-raw)
            (g3c4-p2g2-terminal-authenticate
              call input input-entry native-input output output-native
              first-raw first-staging second-raw second-staging
              pending-raw pending-staging text-one text-two terminal-anchor
              original-output-shell original-check operation)
            (if (not (and (= (g3c4-p2g2-terminal-selected
                               first-staging operation) first)
                          (= (bytevector-u8-ref first-raw 0) first)))
                (g3c4-fail 'invalid-state operation
                           "P2/G2 first T1 byte changed"))
            (let ((count 1) (second 0))
              (if (not (and (m3t-exact-i64? (vector-ref policy 6))
                            (= first (vector-ref policy 6))))
                  (begin
                    (g3c4-native-check
                      (g3c4-p2g2-native-prefix-commit
                        native output-native first-raw)
                      operation)
                    (vector-set! protected-anchor 13 'prefix-committed)
                    (vector-set! record 13 'prefix-committed)
                    (vector-set! ledger 3 'p2g2-prefix-committed)
                    (g3c4-p2g2-terminal-authenticate
                      call input input-entry native-input output output-native
                      first-raw first-staging second-raw second-staging
                      pending-raw pending-staging text-one text-two
                      terminal-anchor original-output-shell original-check
                      operation)
                    (g3c4-native-check
                      (g3c4-p2g2-native-second-frame
                        native output-native second-staging 16)
                      operation)
                    (set! second
                          (g3c4-p2g2-terminal-selected second-staging
                                                          operation))
                    (g3c4-p2g2-terminal-authenticate
                      call input input-entry native-input output output-native
                      first-raw first-staging second-raw second-staging
                      pending-raw pending-staging text-one text-two
                      terminal-anchor original-output-shell original-check
                      operation)
                    (t1-private-g3-decode-raw-into!
                      tokenizer second-staging second-raw)
                    (g3c4-p2g2-terminal-authenticate
                      call input input-entry native-input output output-native
                      first-raw first-staging second-raw second-staging
                      pending-raw pending-staging text-one text-two
                      terminal-anchor original-output-shell original-check
                      operation)
                    (if (not (and (= (g3c4-p2g2-terminal-selected
                                       second-staging operation) second)
                                  (= (bytevector-u8-ref second-raw 0)
                                     second)))
                        (g3c4-fail 'invalid-state operation
                                   "P2/G2 second T1 byte changed"))
                    (set! count 2)))
              (g3c4-p2g2-terminal-authenticate
                call input input-entry native-input output output-native
                first-raw first-staging second-raw second-staging
                pending-raw pending-staging text-one text-two terminal-anchor
                original-output-shell original-check operation)
              (if (not (and (= (bytevector-u8-ref first-raw 0) first)
                            (or (= count 1)
                                (= (bytevector-u8-ref second-raw 0) second))))
                  (g3c4-fail 'invalid-state operation
                             "P2/G2 selected/T1 bytes changed"))
              (bytevector-u8-set! text-one 0 first)
              (bytevector-u8-set! text-two 0 first)
              (if (= count 2)
                  (bytevector-u8-set! text-two 1 second))
              (g3c4-p2g2-terminal-authenticate
                call input input-entry native-input output output-native
                first-raw first-staging second-raw second-staging
                pending-raw pending-staging text-one text-two terminal-anchor
                original-output-shell original-check operation)
              (if (not (and (= (g3c4-p2g2-terminal-selected
                                  first-staging operation) first)
                            (if (= count 1)
                                (and (m3t-exact-i64? (vector-ref policy 6))
                                     (= first (vector-ref policy 6))
                                     (eq? (vector-ref record 13)
                                          'before-prefix))
                                (and (= (g3c4-p2g2-terminal-selected
                                           second-staging operation) second)
                                     (eq? (vector-ref record 13)
                                          'prefix-committed)))
                            (= (bytevector-u8-ref text-one 0) first)
                            (= (bytevector-u8-ref text-two 0) first)
                            (= (bytevector-u8-ref text-two 1)
                               (if (= count 2) second 0))
                            (eq? (vector-ref g3c4-registry 0)
                                 pending-registry-node)
                            (eq? (car pending-registry-node) output)
                            (eq? (cdr pending-registry-node) registry-node)
                            (eq? (cdr registry-node) original-registry)
                            (eq? (vector-ref g3c4-p2g2-terminal-anchors 0)
                                 terminal-node)
                            (eq? (cdr terminal-node) original-terminals)
                            (eq? (vector-ref
                                   g3c4-p2g2-terminal-originals 0)
                                 originals-node)
                            (g3c4-p2g2-terminal-original-authority
                              'present original-output-shell original-check)
                            (eq? (cdr originals-node) original-originals)
                            (eq? (vector-ref g3c4-p2g2-protected-records 0)
                                 record-node)
                            (eq? (cdr record-node) original-records)
                            (eq? (vector-ref g3c4-p2g2-protected-anchors 0)
                                 anchor-node)
                            (eq? (cdr anchor-node) original-anchors)))
                  (g3c4-fail 'invalid-state operation
                             "P2/G2 terminal tail operands changed"))
              (let commit-retry ((attempt 0))
                ;; A diagnostic lease release is a fallible callback. Repeat
                ;; the full original-owner and payload proof before retry.
                (g3c4-p2g2-terminal-authenticate
                  call input input-entry native-input output output-native
                  first-raw first-staging second-raw second-staging
                  pending-raw pending-staging text-one text-two
                  terminal-anchor original-output-shell original-check
                  operation)
                (if (not (and
                           (= (g3c4-p2g2-terminal-selected
                                first-staging operation) first)
                           (= (bytevector-u8-ref first-raw 0) first)
                           (= (bytevector-u8-ref text-one 0) first)
                           (= (bytevector-u8-ref text-two 0) first)
                           (= (bytevector-u8-ref text-two 1)
                              (if (= count 1) 0 second))
                           (if (= count 1)
                               (and (m3t-exact-i64? (vector-ref policy 6))
                                    (= first (vector-ref policy 6))
                                    (eq? (vector-ref record 13)
                                         'before-prefix))
                               (and (= (g3c4-p2g2-terminal-selected
                                          second-staging operation) second)
                                    (= (bytevector-u8-ref second-raw 0)
                                       second)
                                    (eq? (vector-ref record 13)
                                         'prefix-committed)))
                           (eq? (vector-ref g3c4-registry 0)
                                pending-registry-node)
                           (eq? (car pending-registry-node) output)
                           (eq? (cdr pending-registry-node) registry-node)
                           (eq? (cdr registry-node) original-registry)
                           (eq? (vector-ref g3c4-p2g2-terminal-anchors 0)
                                terminal-node)
                           (eq? (cdr terminal-node) original-terminals)
                           (eq? (vector-ref
                                  g3c4-p2g2-terminal-originals 0)
                                originals-node)
                           (g3c4-p2g2-terminal-original-authority
                             'present original-output-shell original-check)
                           (eq? (cdr originals-node) original-originals)
                           (eq? (vector-ref
                                  g3c4-p2g2-protected-records 0)
                                record-node)
                           (eq? (cdr record-node) original-records)
                           (eq? (vector-ref
                                  g3c4-p2g2-protected-anchors 0)
                                anchor-node)
                           (eq? (cdr anchor-node) original-anchors)))
                    (g3c4-fail 'invalid-state operation
                               "P2/G2 terminal retry operands changed"))
                (let ((status
                        (g3c4-p2g2-native-terminal-commit
                          native output-native first-raw 9
                          (if (= count 1) '() second-raw)
                          (if (= count 1) 0 9))))
                  (if (= status 0)
                      (begin
                        ;; Native zero has drained the call. Only bounded,
                        ;; preflighted writes follow through m3-call.
                        (vector-set! barrier 0 #t)
                (vector-set! publication-witness 0 #t)
                (vector-set! terminal-anchor 5 count)
                (vector-set! terminal-anchor 15
                             (if (= count 1) 3 4))
                (vector-set! terminal-anchor 16 'terminal-published)
                (vector-set! terminal-anchor 6 'live)
                (vector-set! terminal-anchor 10 #f)
                (vector-set! terminal-anchor 11 #f)
                (vector-set! terminal-anchor 12 #f)
                (vector-set! terminal-anchor 13 #f)
                (vector-set! terminal-anchor 14 #f)
                (vector-set! output 1 'terminal-output)
                (vector-set! output 2 'live)
                (vector-set! output 4 #f)
                (vector-set! output 5 #f)
                (vector-set! output 6 #f)
                (vector-set! output 8
                             (if (= count 1) text-one text-two))
                (vector-set! ledger 4 #f)
                (vector-set! model-entry 10 #f)
                (vector-set! generator-entry 9 #f)
                (g3c4-call-dead! call)
                (vector-set! record 0 #f)
                (vector-set! protected-anchor 0 #f)
                (g3c4-p2g2-zero-bytes! pending-raw 2)
                (g3c4-p2g2-zero-bytes! pending-staging 16)
                (g3c4-p2g2-zero-bytes! first-staging 8)
                (g3c4-p2g2-zero-bytes! second-staging 8)
                (if (= count 1)
                    (begin (g3c4-p2g2-zero-bytes! second-raw 1)
                           (g3c4-p2g2-zero-bytes! text-two 2))
                    (g3c4-p2g2-zero-bytes! text-one 1))
                (vector-set! g3c4-p2g2-protected-records 0
                             original-records)
                (vector-set! g3c4-p2g2-protected-anchors 0
                             original-anchors)
                        original-output-shell)
                      (if (and (= attempt 0)
                               (repair-precommit call output))
                          (begin
                            (g3c4-p2g2-terminal-authenticate
                              call input input-entry native-input output
                              output-native first-raw first-staging
                              second-raw second-staging pending-raw
                              pending-staging text-one text-two
                              terminal-anchor original-output-shell
                              original-check operation)
                            (commit-retry 1))
                          (g3c4-native-check status operation))))))))))))

(define (g3c4-p2g2-terminal-generate-internal generator input)
  (g3c4-p2g2-terminal-generate-probed-internal
    generator input (lambda (call output) #f)))

;;; Native release rejects a genuine held I1 lease before mutation. The
;;; surviving original anchor remains authoritative until release succeeds.
(define (g3c4-p2g2-terminal-output-release-internal! shell)
  (let ((operation 'g3c4-p2g2-terminal-output-release-internal!))
    (m3-call operation
      (let* ((entry (g3c4-registry-find shell operation))
             (anchor (g3c4-p2g2-terminal-anchor-for shell)))
        (if (g3c4-dead-entry? entry 'terminal-output)
            (if (and anchor (eq? (vector-ref anchor 0) shell)
                     (eq? (vector-ref anchor 1) entry)
                     (eq? (vector-ref anchor 6) 'dead)
                     (eq? (vector-ref anchor 16) 'terminal-published)
                     (let ((check
                             (g3c4-p2g2-terminal-original-for shell)))
                       (and check
                            (check shell entry (vector-ref anchor 2)
                                   (vector-ref anchor 3)
                                   (vector-ref anchor 4)
                                   (vector-ref anchor 8)
                                   (vector-ref anchor 9)
                                   #f #f #f #f anchor)))
                     (g3c4-p2g2-terminal-original-authority
                       'check shell
                       (vector shell entry (vector-ref anchor 2)
                               (vector-ref anchor 3) (vector-ref anchor 4)
                               (vector-ref anchor 8) (vector-ref anchor 9)
                               #f #f #f #f anchor)))
                #t
                (g3c4-fail 'invalid-state operation
                           "P2/G2 dead terminal identity changed"))
            (let* ((live (g3c4-p2g2-terminal-output-live shell operation))
                   (text (vector-ref live 8))
                   (barrier (vector #f))
                   (native (vector-ref live 3)))
              (guard (caught (#t (if (vector-ref barrier 0) (exit 134))
                                 (raise caught)))
                (g3c4-native-check
                  (g3c4-native-output-release native) operation)
                (vector-set! barrier 0 #t)
                (g3c4-p2g2-zero-bytes! text (bytevector-length text))
                (g3c4-p2g2-zero-bytes! (vector-ref anchor 8) 1)
                (g3c4-p2g2-zero-bytes! (vector-ref anchor 9) 1)
                (g3c4-entry-dead! live)
                (vector-set! live 1 'terminal-output)
                (vector-set! anchor 6 'dead)
                #t)))))))
