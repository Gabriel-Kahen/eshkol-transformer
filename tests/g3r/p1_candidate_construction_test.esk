(require transformer.module)
(require p1_test.tensor_provider)
(load "g3r_p1_candidate_construction_extension.esk")
(load "g3c4_p1_construction_extension.esk")

(define checks 0)
(define (check condition)
  (if condition (set! checks (+ checks 1)) (exit 1)))
(define (reject category thunk)
  (check
    (guard (caught
             (#t (and (transformer-error? caught)
                      (eq? (transformer-error-category caught) category))))
      (thunk) #f)))

(reject 'invalid-argument
  (lambda () (module-candidate-construction-begin-internal
               'fixture-v1 (vector #f))))
(reject 'invalid-argument
  (lambda () (module-candidate-construction-begin-internal 'fixture-v1 #f)))
(define cell (vector #f #f #f #f))
(define construction
  (module-candidate-construction-begin-internal 'fixture-v1 cell))
(define root (module-construction-root-internal construction))
(check (and (eq? (vector-ref cell 0) 'open)
            (eq? (vector-ref cell 1) construction)
            (eq? (vector-ref cell 2) root)))
(reject 'invalid-state
  (lambda () (module-candidate-construction-begin-internal
               'fixture-v1 (vector #f #f #f #f))))
(define handle
  (module-register-parameter-internal!
    root "weight" (fixture-tensor-internal '(2) 'f32 'cpu
                     (vector 'candidate 'bits))))
(module-construction-parameters-internal construction)
(check (eq? root (module-construction-seal-internal! construction)))
(check (eq? (vector-ref cell 0) 'sealed))
(check (pair? (vector-ref cell 3)))
(check (module-candidate-construction-preflight-internal! cell))
(reject 'invalid-argument
  (lambda () (module-candidate-construction-begin-internal
               'fixture-v1 cell)))
(reject 'invalid-state
  (lambda () (module-candidate-construction-preflight-internal!
               (vector 'sealed construction root (vector-ref cell 3)))))
(define prior (vector-ref cell 3))
(vector-set! cell 3 (cdr prior))
(reject 'invalid-state
  (lambda () (module-candidate-construction-preflight-internal! cell)))
(vector-set! cell 3 prior)
(check (module-candidate-construction-preflight-internal! cell))
(define (test-preseal-tamper slot replacement)
  (let* ((subject (vector #f #f #f #f))
         (identity (module-candidate-construction-begin-internal
                     'fixture-v1 subject))
         (subject-root (module-construction-root-internal identity)))
    (module-register-parameter-internal!
      subject-root "weight" (fixture-tensor-internal '(2) 'f32 'cpu
                               (vector 'tamper slot)))
    (module-construction-parameters-internal identity)
    (let ((original (vector-ref subject slot)))
      (vector-set! subject slot replacement)
      (reject 'invalid-state
        (lambda () (module-construction-seal-internal! identity)))
      (vector-set! subject slot original))
    (check (eq? (vector-ref subject 0) 'open))
    (check (module-construction-abort-internal! identity))
    (check (eq? (vector-ref subject 0) 'dead))))
(test-preseal-tamper 0 'sealed)
(test-preseal-tamper 1 #f)
(test-preseal-tamper 2 #f)
(define prepared-cell (vector #f #f #f #f))
(define prepared
  (module-candidate-construction-begin-internal 'fixture-v1 prepared-cell))
(define prepared-root (module-construction-root-internal prepared))
(module-register-parameter-internal!
  prepared-root "weight" (fixture-tensor-internal '(2) 'f32 'cpu
                            (vector 'prepared 'bits)))
(module-construction-parameters-internal prepared)
(check (eq? prepared-root (module-construction-prepare-eval-internal! prepared)))
(check (not (vector-ref prepared-cell 3)))
(check (eq? prepared-root
            (module-construction-seal-prepared-internal! prepared)))
(check (eq? (vector-ref prepared-cell 0) 'sealed))
(check (pair? (vector-ref prepared-cell 3)))
(check (module-candidate-construction-preflight-internal! prepared-cell))
(define prepared-abort-cell (vector #f #f #f #f))
(define prepared-abort
  (module-candidate-construction-begin-internal
    'fixture-v1 prepared-abort-cell))
(define prepared-abort-root (module-construction-root-internal prepared-abort))
(module-register-parameter-internal!
  prepared-abort-root "weight" (fixture-tensor-internal '(2) 'f32 'cpu
                                  (vector 'prepared-abort 'bits)))
(module-construction-parameters-internal prepared-abort)
(module-construction-prepare-eval-internal! prepared-abort)
(check (module-construction-abort-internal! prepared-abort))
(check (and (eq? (vector-ref prepared-abort-cell 0) 'dead)
            (not (vector-ref prepared-abort-cell 3))))
(define prepared-tamper-cell (vector #f #f #f #f))
(define prepared-tamper
  (module-candidate-construction-begin-internal
    'fixture-v1 prepared-tamper-cell))
(define prepared-tamper-root (module-construction-root-internal prepared-tamper))
(module-register-parameter-internal!
  prepared-tamper-root "weight" (fixture-tensor-internal '(2) 'f32 'cpu
                                   (vector 'prepared-tamper 'bits)))
(module-construction-parameters-internal prepared-tamper)
(module-construction-prepare-eval-internal! prepared-tamper)
(vector-set! prepared-tamper-cell 3 '())
(reject 'invalid-state
  (lambda () (module-construction-seal-prepared-internal! prepared-tamper)))
(check (eq? (vector-ref prepared-tamper-cell 0) 'dead))
(check (module-construction-abort-internal! prepared-tamper))
(define ordinary (module-construction-begin-internal 'fixture-v1))
(check (module-construction-abort-internal! ordinary))
(define abandoned-cell (vector #f #f #f #f))
(define abandoned
  (module-candidate-construction-begin-internal 'fixture-v1 abandoned-cell))
(check (module-construction-abort-internal! abandoned))
(check (and (eq? (vector-ref abandoned-cell 0) 'dead)
            (not (vector-ref abandoned-cell 1))
            (not (vector-ref abandoned-cell 2))
            (not (vector-ref abandoned-cell 3))))
(reject 'invalid-argument
  (lambda () (module-candidate-construction-begin-internal
               'fixture-v1 abandoned-cell)))
(check (eq? (vector-ref cell 0) 'sealed))
(display "G3-R P1 candidate construction PASS: ")
(display checks)
(newline)
