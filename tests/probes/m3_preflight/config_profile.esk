;; Development-only probe of merged X1, not a model configuration extension.
(require transformer.config)
(require transformer.error_public)
(define base "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
(define config (config-resolve (config-parse base) '()))
(if (and (config-validate config)
         (= (config-ref config 'model.head-size) 2)
         (= (config-ref config 'model.kv-head-count) 2))
    (begin (display "m3-config-profile:accepted") (newline))
    (exit 1))
(define (reject text)
  (let ((caught (guard (raised (#t raised)) (config-parse text) #f)))
    (if (and (transformer-error? caught)
             (eq? (transformer-error-category caught) 'invalid-argument))
        (begin (display "m3-config-unknown:rejected") (newline))
        (exit 1))))
(reject "{\"model.ffn-size\":8}")
(reject "{\"model.profile\":\"tiny-byte-gpt\"}")
(display (config-fingerprint config))
(newline)
