(define (near a b tolerance) (< (abs (- a b)) tolerance))
(define (f x) (+ (* x x) (* x x)))
(define epsilon 1e-5)
(define actual (derivative f 3.0))
(define finite (/ (- (f (+ 3.0 epsilon)) (f (- 3.0 epsilon))) (* 2.0 epsilon)))
(display (if (near actual finite 1e-5) "PASS forward finite difference" "FAIL forward finite difference"))
(newline)
(display "R0_DONE autodiff_forward") (newline)
