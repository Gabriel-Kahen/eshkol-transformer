  (and (= 14 (count (lambda (x) (eq? x 'value-begin)) events))
       (= 14 (count (lambda (x) (eq? x 'value-end)) events))
       (= 14 (count (lambda (x) (eq? x 'clone)) events))))
(check "all28 authenticated moment byte copies decode before borrow end"
  (and (= 28 (count (lambda (x) (eq? x 'moment-bits)) events))
       (= 28 (count (lambda (x) (eq? x 'moment-decode)) events))
       (eq? (last events) 'borrow-end)))
(check "all staged values and moments have exact rooted custody"
  (and (every (lambda (cell) (vector-ref cell 0))
              (vector->list (vector-ref staged-parent 5)))
       (every vector? (vector->list (vector-ref (vector-ref staged-parent 6) 0)))
       (not (vector-ref staged-parent 4))
       (= 2 (vector-length (vector-ref (vector-ref staged-parent 8) 3)))))
