;;; Strict, data-only run configuration and canonical resolved manifests.
;;;
;;; The accepted source syntax is one flat JSON object.  It deliberately does
;;; not use core.json: that parser is permissive and hash-table construction
;;; would erase duplicate keys before this module could reject them.

(require transformer.error_internal)

(provide config-parse config-resolve config-validate config-canonical
         config-fingerprint config-ref)

;;; eshkol_sha256 is part of the pinned canonical hosted runtime even when the
;;; optional agent FFI is disabled.  This private declaration avoids importing
;;; agent.crypto and exposes no documented native surface from this module.
(extern i32 x1-sha256-raw ptr i64 ptr i64 :real eshkol_sha256)

;;; The pinned compiler treats `provide` as documentation rather than an
;;; enforcement boundary.  Bind only the six A0 functions at top level and
;;; keep all representation state and helpers in one lexical scope.
(define-values
  (config-parse config-resolve config-validate config-canonical
                config-fingerprint config-ref)
  (let ((x1-config-registry '()))
    (define x1-max-input-bytes 16384)
    (define x1-max-keys 14)
    (define x1-max-integer-digits 19)
    (define x1-i64-min -9223372036854775808)
    (define x1-i64-max 9223372036854775807)

    (define x1-schema-keys
      '(config-schema-major
        config-schema-minor
        model.context-length
        model.device
        model.dtype
        model.head-size
        model.hidden-size
        model.kv-head-count
        model.layer-count
        model.query-head-count
        model.vocabulary-size
        run.deterministic
        run.seed
        training.accumulation-steps))

;;; -------------------------------------------------------------------------
;;; Structured errors

(define (x1-known-detail-symbol? value)
  (define (loop values)
    (cond
      ((null? values) #f)
      ((eq? value (car values)) #t)
      (else (loop (cdr values)))))
  (loop x1-schema-keys))

(define (x1-safe-detail-value value)
  (cond
    ((boolean? value) value)
    ((char? value) value)
    ((and (integer? value) (exact? value))
     (if (and (>= value x1-i64-min) (<= value x1-i64-max))
         value
         'integer-out-of-range))
    ((string? value)
     (if (<= (string-byte-length value) 256) value 'oversize-string))
    ((symbol? value)
     (if (x1-known-detail-symbol? value) value 'symbol-value))
    (else 'opaque-value)))

(define (x1-error-details details)
  (if (null? details)
      '()
      (list (list 'context (x1-map x1-safe-detail-value details)))))

(define (x1-invalid operation message details)
  (transformer-error-raise
   'invalid-argument operation message (x1-error-details details) #f))

(define (x1-version-error operation message details)
  (transformer-error-raise
   'version-mismatch operation message (x1-error-details details) #f))

(define (x1-unsupported operation message details)
  (transformer-error-raise
   'unsupported operation message (x1-error-details details) #f))

;;; -------------------------------------------------------------------------
;;; Opaque immutable configuration identities.  Native conditions provide an
;;; unforgeable shell on the pinned runtime; metadata lives only in this
;;; lexical identity registry.  Every read returns fresh alist/string storage.

(define (x1-make-config-shell)
  (guard (raised (#t raised))
    (error "transformer.config:v1")))

(define (x1-copy-config-scalar value)
  (if (string? value) (string-copy value) value))

(define (x1-copy-config-alist entries)
  (if (null? entries)
      '()
      (cons (cons (car (car entries))
                  (x1-copy-config-scalar (cdr (car entries))))
            (x1-copy-config-alist (cdr entries)))))

(define (x1-config-entry value)
  (define (loop entries)
    (cond
      ((null? entries) #f)
      ((eq? value (car (car entries))) (car entries))
      (else (loop (cdr entries)))))
  (loop x1-config-registry))

(define (x1-register-config kind values provenance)
  (let ((shell (x1-make-config-shell)))
    (set! x1-config-registry
          (cons (list shell kind
                      (x1-copy-config-alist values)
                      (x1-copy-config-alist provenance))
                x1-config-registry))
    shell))

(define (x1-config-kind? value kind)
  (let ((entry (x1-config-entry value)))
    (and entry (eq? (car (cdr entry)) kind))))

(define (x1-unresolved? value)
  (x1-config-kind? value 'unresolved))

(define (x1-resolved? value)
  (x1-config-kind? value 'resolved))

(define (x1-make-unresolved entries)
  (x1-register-config 'unresolved entries '()))

(define (x1-make-resolved values provenance)
  (x1-register-config 'resolved values provenance))

(define (x1-config-stored-alist value position)
  (let ((entry (x1-config-entry value)))
    (if entry
        (x1-copy-config-alist
         (if (= position 2)
             (car (cdr (cdr entry)))
             (car (cdr (cdr (cdr entry))))))
        #f)))

(define (x1-unresolved-entries value)
  (x1-config-stored-alist value 2))

(define (x1-resolved-values value)
  (x1-config-stored-alist value 2))

(define (x1-resolved-provenance value)
  (x1-config-stored-alist value 3))

(define (x1-assoc key entries)
  (cond
    ((null? entries) #f)
    ((eq? key (car (car entries))) (car entries))
    (else (x1-assoc key (cdr entries)))))

(define (x1-symbol-member? value values)
  (cond
    ((null? values) #f)
    ((eq? value (car values)) #t)
    (else (x1-symbol-member? value (cdr values)))))

(define (x1-reverse values)
  (define (loop remaining result)
    (if (null? remaining)
        result
        (loop (cdr remaining) (cons (car remaining) result))))
  (loop values '()))

(define (x1-map function values)
  (if (null? values)
      '()
      (cons (function (car values)) (x1-map function (cdr values)))))

(define (x1-assoc-value entries key absent)
  (let ((entry (x1-assoc key entries)))
    (if entry (cdr entry) absent)))

(define (x1-present? entries key)
  (if (x1-assoc key entries) #t #f))

(define (x1-alist-set entries key value)
  (cond
    ((null? entries) (list (cons key value)))
    ((eq? (car (car entries)) key)
     (cons (cons key value) (cdr entries)))
    (else
     (cons (car entries) (x1-alist-set (cdr entries) key value)))))

(define (x1-key-from-string key)
  (cond
    ((string=? key "config-schema-major") 'config-schema-major)
    ((string=? key "config-schema-minor") 'config-schema-minor)
    ((string=? key "model.context-length") 'model.context-length)
    ((string=? key "model.device") 'model.device)
    ((string=? key "model.dtype") 'model.dtype)
    ((string=? key "model.head-size") 'model.head-size)
    ((string=? key "model.hidden-size") 'model.hidden-size)
    ((string=? key "model.kv-head-count") 'model.kv-head-count)
    ((string=? key "model.layer-count") 'model.layer-count)
    ((string=? key "model.query-head-count") 'model.query-head-count)
    ((string=? key "model.vocabulary-size") 'model.vocabulary-size)
    ((string=? key "run.deterministic") 'run.deterministic)
    ((string=? key "run.seed") 'run.seed)
    ((string=? key "training.accumulation-steps")
     'training.accumulation-steps)
    (else #f)))

(define (x1-override-key symbol)
  (if (not (symbol? symbol))
      #f
      (let ((name (symbol->string symbol)))
        (cond
          ((string=? name ":model.context-length") 'model.context-length)
          ((string=? name ":model.device") 'model.device)
          ((string=? name ":model.dtype") 'model.dtype)
          ((string=? name ":model.hidden-size") 'model.hidden-size)
          ((string=? name ":model.kv-head-count") 'model.kv-head-count)
          ((string=? name ":model.layer-count") 'model.layer-count)
          ((string=? name ":model.query-head-count") 'model.query-head-count)
          ((string=? name ":model.vocabulary-size") 'model.vocabulary-size)
          ((string=? name ":run.deterministic") 'run.deterministic)
          ((string=? name ":run.seed") 'run.seed)
          ((string=? name ":training.accumulation-steps")
           'training.accumulation-steps)
          (else #f)))))

(define (x1-reference-key symbol)
  (if (not (symbol? symbol))
      #f
      (let ((name (symbol->string symbol)))
        (cond
          ((string=? name "config-schema-major") 'config-schema-major)
          ((string=? name "config-schema-minor") 'config-schema-minor)
          ((string=? name "model.context-length") 'model.context-length)
          ((string=? name "model.device") 'model.device)
          ((string=? name "model.dtype") 'model.dtype)
          ((string=? name "model.head-size") 'model.head-size)
          ((string=? name "model.hidden-size") 'model.hidden-size)
          ((string=? name "model.kv-head-count") 'model.kv-head-count)
          ((string=? name "model.layer-count") 'model.layer-count)
          ((string=? name "model.query-head-count") 'model.query-head-count)
          ((string=? name "model.vocabulary-size") 'model.vocabulary-size)
          ((string=? name "run.deterministic") 'run.deterministic)
          ((string=? name "run.seed") 'run.seed)
          ((string=? name "training.accumulation-steps")
           'training.accumulation-steps)
          (else #f)))))

;;; -------------------------------------------------------------------------
;;; Strict flat-JSON scanner

(define (x1-whitespace? character)
  (let ((code (char->integer character)))
    (or (= code 32) (= code 9) (= code 10) (= code 13))))

(define (x1-digit? character)
  (let ((code (char->integer character)))
    (and (>= code 48) (<= code 57))))

(define (x1-skip-whitespace text position length)
  (if (and (< position length)
           (x1-whitespace? (string-ref text position)))
      (x1-skip-whitespace text (+ position 1) length)
      position))

(define (x1-json-delimiter? text position length)
  (or (>= position length)
      (x1-whitespace? (string-ref text position))
      (char=? (string-ref text position) #\,)
      (char=? (string-ref text position) #\})))

(define (x1-parse-string text position length operation role)
  (define (loop cursor accumulator)
    (if (>= cursor length)
        (x1-invalid operation "unterminated JSON string" (list role cursor))
        (let* ((character (string-ref text cursor))
               (code (char->integer character)))
          (cond
            ((char=? character #\")
             (cons accumulator (+ cursor 1)))
            ((char=? character #\\)
             (x1-invalid operation "JSON escapes are not supported"
                         (list role cursor)))
            ((or (< code 32) (> code 126))
             (x1-invalid operation
                         "JSON keys and string values must be printable ASCII"
                         (list role cursor)))
            (else
             (loop (+ cursor 1)
                   (string-append accumulator (string character))))))))
  (loop position ""))

(define (x1-match-literal? text position length literal)
  (define literal-length (string-length literal))
  (define (loop offset)
    (cond
      ((= offset literal-length)
       (x1-json-delimiter? text (+ position offset) length))
      ((>= (+ position offset) length) #f)
      ((char=? (string-ref text (+ position offset))
               (string-ref literal offset))
       (loop (+ offset 1)))
      (else #f)))
  (loop 0))

(define (x1-parse-integer text position length operation)
  (let* ((negative? (and (< position length)
                         (char=? (string-ref text position) #\-)))
         (digits-start (if negative? (+ position 1) position)))
    (if (or (>= digits-start length)
            (not (x1-digit? (string-ref text digits-start))))
        (x1-invalid operation "invalid JSON integer" (list position))
        (let find-end ((cursor digits-start))
          (if (and (< cursor length) (x1-digit? (string-ref text cursor)))
              (find-end (+ cursor 1))
              (let* ((digit-count (- cursor digits-start))
                     (token (substring text position cursor)))
                (cond
                  ((and (> digit-count 1)
                        (char=? (string-ref text digits-start) #\0))
                   (x1-invalid operation "JSON integers cannot have leading zeroes"
                               (list position)))
                  ((and negative?
                        (= digit-count 1)
                        (char=? (string-ref text digits-start) #\0))
                   (x1-invalid operation "negative zero is not canonical"
                               (list position)))
                  ((> digit-count x1-max-integer-digits)
                   (x1-invalid operation "JSON integer exceeds lexical limit"
                               (list position digit-count)))
                  ((not (x1-json-delimiter? text cursor length))
                   (x1-invalid operation "invalid character after JSON integer"
                               (list cursor)))
                  (else
                   (let ((value (string->number token)))
                     (if (or (not (integer? value))
                             (< value x1-i64-min)
                             (> value x1-i64-max))
                         (x1-invalid operation "JSON integer is outside signed i64"
                                     (list position))
                         (cons value cursor)))))))))))

(define (x1-parse-value text position length operation)
  (if (>= position length)
      (x1-invalid operation "missing JSON value" (list position))
      (let ((character (string-ref text position)))
        (cond
          ((char=? character #\")
           (x1-parse-string text (+ position 1) length operation 'value))
          ((x1-match-literal? text position length "true")
           (cons #t (+ position 4)))
          ((x1-match-literal? text position length "false")
           (cons #f (+ position 5)))
          ((or (char=? character #\-) (x1-digit? character))
           (x1-parse-integer text position length operation))
          ((or (char=? character #\{) (char=? character #\[))
           (x1-invalid operation "nested JSON values are not supported"
                       (list position)))
          (else
           (x1-invalid operation
                       "only integer, boolean, and unescaped string values are supported"
                       (list position)))))))

(define (x1-parse-object text position length entries count)
  (let ((cursor (x1-skip-whitespace text position length)))
    (cond
      ((>= cursor length)
       (x1-invalid 'config-parse "unterminated JSON object" (list cursor)))
      ((char=? (string-ref text cursor) #\})
       (cons (x1-reverse entries) (+ cursor 1)))
      ((not (char=? (string-ref text cursor) #\"))
       (x1-invalid 'config-parse "JSON object key must be a string"
                   (list cursor)))
      (else
       (let* ((key-result
               (x1-parse-string text (+ cursor 1) length 'config-parse 'key))
              (key-text (car key-result))
              (key (x1-key-from-string key-text))
              (after-key
               (x1-skip-whitespace text (cdr key-result) length)))
         (cond
           ((not key)
            (x1-invalid 'config-parse "unknown configuration key"
                        (list key-text)))
           ((x1-present? entries key)
            (x1-invalid 'config-parse "duplicate configuration key"
                        (list key)))
           ((>= count x1-max-keys)
            (x1-invalid 'config-parse "configuration exceeds key limit"
                        (list x1-max-keys)))
           ((or (>= after-key length)
                (not (char=? (string-ref text after-key) #\:)))
            (x1-invalid 'config-parse "JSON object key must be followed by ':'"
                        (list key after-key)))
           (else
            (let* ((value-position
                    (x1-skip-whitespace text (+ after-key 1) length))
                   (value-result
                    (x1-parse-value text value-position length 'config-parse))
                   (after-value
                    (x1-skip-whitespace text (cdr value-result) length))
                   (new-entries
                    (cons (cons key (car value-result)) entries)))
              (cond
                ((>= after-value length)
                 (x1-invalid 'config-parse "unterminated JSON object"
                             (list after-value)))
                ((char=? (string-ref text after-value) #\})
                 (cons (x1-reverse new-entries) (+ after-value 1)))
                ((char=? (string-ref text after-value) #\,)
                 (let ((next
                        (x1-skip-whitespace text (+ after-value 1) length)))
                   (if (and (< next length)
                            (char=? (string-ref text next) #\}))
                       (x1-invalid 'config-parse
                                   "trailing commas are not supported"
                                   (list next))
                       (x1-parse-object text next length new-entries
                                        (+ count 1)))))
                (else
                 (x1-invalid 'config-parse
                             "expected ',' or '}' after JSON value"
                             (list after-value))))))))))))

(define (config-parse text)
  (cond
    ((not (string? text))
     (x1-invalid 'config-parse "configuration text must be a string" '()))
    ((> (string-byte-length text) x1-max-input-bytes)
     (x1-invalid 'config-parse "configuration exceeds byte limit"
                 (list x1-max-input-bytes)))
    (else
     (let* ((length (string-length text))
            (start (x1-skip-whitespace text 0 length)))
       (if (or (>= start length)
               (not (char=? (string-ref text start) #\{)))
           (x1-invalid 'config-parse "configuration must be one JSON object"
                       (list start))
           (let* ((result (x1-parse-object text (+ start 1) length '() 0))
                  (end (x1-skip-whitespace text (cdr result) length))
                  (entries (car result))
                  (major (x1-assoc-value entries 'config-schema-major #f))
                  (minor (x1-assoc-value entries 'config-schema-minor #f)))
             (cond
               ((< end length)
                (x1-invalid 'config-parse "trailing data after JSON object"
                            (list end)))
               ((or (not (x1-present? entries 'config-schema-major))
                    (not (x1-present? entries 'config-schema-minor)))
                (x1-invalid 'config-parse
                            "configuration schema version is required" '()))
               ((or (not (integer? major)) (boolean? major)
                    (not (integer? minor)) (boolean? minor))
                (x1-invalid 'config-parse
                            "configuration schema version must be integer pair"
                            (list major minor)))
               ((or (not (= major 1)) (not (= minor 0)))
                (x1-version-error 'config-parse
                                  "unsupported configuration schema version"
                                  (list major minor)))
               (else
                (x1-make-unresolved entries)))))))))

;;; -------------------------------------------------------------------------
;;; Resolution and validation

(define (x1-required-source-key entries key)
  (if (x1-present? entries key)
      #t
      (x1-invalid 'config-resolve "missing required configuration key"
                  (list key))))

(define (x1-apply-overrides values provenance overrides seen)
  (cond
    ((null? overrides) (cons values provenance))
    ((not (pair? overrides))
     (x1-invalid 'config-resolve "overrides must be a proper flat option list"
                 '()))
    ((not (pair? (cdr overrides)))
     (x1-invalid 'config-resolve "override option is missing its value"
                 (list (car overrides))))
    (else
     (let* ((raw-key (car overrides))
            (key (x1-override-key raw-key))
            (value (car (cdr overrides))))
       (cond
         ((not key)
          (x1-invalid 'config-resolve
                      "unknown, non-colon, version, or derived override key"
                      (list raw-key)))
         ((x1-symbol-member? key seen)
          (x1-invalid 'config-resolve "duplicate override key" (list key)))
         ((and (or (eq? key 'model.dtype) (eq? key 'model.device))
               (not (symbol? value)))
          (x1-invalid 'config-resolve
                      "dtype and device override values must be symbols"
                      (list key value)))
         ((and (eq? key 'run.deterministic) (not (boolean? value)))
          (x1-invalid 'config-resolve
                      "run.deterministic override must be boolean"
                      (list value)))
         ((and (not (eq? key 'model.dtype))
               (not (eq? key 'model.device))
               (not (eq? key 'run.deterministic))
               (or (boolean? value) (not (integer? value))
                   (not (exact? value))))
          (x1-invalid 'config-resolve
                      "integer override has invalid type" (list key value)))
         (else
          (x1-apply-overrides
           (x1-alist-set values key value)
           (x1-alist-set provenance key 'override)
           (cdr (cdr overrides))
           (cons key seen))))))))

(define (x1-add-default values provenance key value origin)
  (if (x1-present? values key)
      (cons values provenance)
      (cons (x1-alist-set values key value)
            (x1-alist-set provenance key origin))))

(define (x1-normalize-enum values key allowed operation)
  (let ((value (x1-assoc-value values key #f)))
    (cond
      ((symbol? value) values)
      ((not (string? value)) values)
      ((and (eq? key 'model.dtype) (string=? value "f32"))
       (x1-alist-set values key 'f32))
      ((and (eq? key 'model.device) (string=? value "cpu"))
       (x1-alist-set values key 'cpu))
      (else values))))

(define (x1-return-validated resolved operation)
  (x1-validate resolved operation)
  resolved)

(define (config-resolve config overrides)
  (if (not (x1-unresolved? config))
      (x1-invalid 'config-resolve "expected an unresolved configuration" '())
      (let* ((source (x1-unresolved-entries config))
             (required-keys
              '(model.vocabulary-size model.context-length model.hidden-size
                model.layer-count model.query-head-count run.seed)))
        (define (require-all keys)
          (if (null? keys)
              #t
              (begin
                (x1-required-source-key source (car keys))
                (require-all (cdr keys)))))
        (require-all required-keys)
        (let* ((source-provenance
                (x1-map (lambda (entry) (cons (car entry) 'input)) source))
               (overridden
                (x1-apply-overrides source source-provenance overrides '()))
               (values0 (car overridden))
               (provenance0 (cdr overridden))
               (dtype-default
                (x1-add-default values0 provenance0
                                'model.dtype 'f32 'default))
               (device-default
                (x1-add-default (car dtype-default) (cdr dtype-default)
                                'model.device 'cpu 'default))
               (deterministic-default
                (x1-add-default (car device-default) (cdr device-default)
                                'run.deterministic #t 'default))
               (accumulation-default
                (x1-add-default
                 (car deterministic-default) (cdr deterministic-default)
                 'training.accumulation-steps 1 'default))
               (kv-default
                (x1-add-default
                 (car accumulation-default) (cdr accumulation-default)
                 'model.kv-head-count
                 (x1-assoc-value (car accumulation-default)
                                 'model.query-head-count #f)
                 'default))
               (values1
                (x1-normalize-enum
                 (x1-normalize-enum (car kv-default)
                                    'model.dtype '(f32) 'config-resolve)
                 'model.device '(cpu) 'config-resolve))
               (provenance1 (cdr kv-default)))
          (if (x1-present? values1 'model.head-size)
              (x1-return-validated
               (x1-make-resolved values1 provenance1) 'config-resolve)
              (let ((hidden (x1-assoc-value values1 'model.hidden-size #f))
                    (heads (x1-assoc-value values1 'model.query-head-count #f)))
                (if (or (not (integer? hidden))
                        (boolean? hidden)
                        (not (integer? heads))
                        (boolean? heads)
                        (<= heads 0)
                        (not (= (modulo hidden heads) 0)))
                    (x1-invalid 'config-resolve
                                "model.head-size cannot be derived exactly"
                                (list hidden heads))
                    (x1-return-validated
                     (x1-make-resolved
                      (x1-alist-set values1 'model.head-size
                                    (/ hidden heads))
                      (x1-alist-set provenance1 'model.head-size
                                    'derived))
                     'config-resolve))))))))

(define (x1-exact-integer? value)
  (and (not (boolean? value)) (integer? value) (exact? value)))

(define (x1-positive-i64? value)
  (and (x1-exact-integer? value) (> value 0) (<= value x1-i64-max)))

(define (x1-nonnegative-i64? value)
  (and (x1-exact-integer? value) (>= value 0) (<= value x1-i64-max)))

(define (x1-validate-required-positive values key operation)
  (let ((value (x1-assoc-value values key #f)))
    (if (x1-positive-i64? value)
        #t
        (x1-invalid operation
                    "configuration value must be a positive signed i64"
                    (list key value)))))

(define (x1-validate resolved operation)
  (if (not (x1-resolved? resolved))
      (x1-invalid operation "expected a resolved configuration" '())
      (let* ((values (x1-resolved-values resolved))
             (major (x1-assoc-value values 'config-schema-major #f))
             (minor (x1-assoc-value values 'config-schema-minor #f))
             (vocabulary (x1-assoc-value values 'model.vocabulary-size #f))
             (context (x1-assoc-value values 'model.context-length #f))
             (hidden (x1-assoc-value values 'model.hidden-size #f))
             (layers (x1-assoc-value values 'model.layer-count #f))
             (query-heads (x1-assoc-value values 'model.query-head-count #f))
             (kv-heads (x1-assoc-value values 'model.kv-head-count #f))
             (head-size (x1-assoc-value values 'model.head-size #f))
             (dtype (x1-assoc-value values 'model.dtype #f))
             (device (x1-assoc-value values 'model.device #f))
             (seed (x1-assoc-value values 'run.seed #f))
             (deterministic (x1-assoc-value values 'run.deterministic #f))
             (accumulation
              (x1-assoc-value values 'training.accumulation-steps #f)))
        (cond
          ((or (not (x1-exact-integer? major))
               (not (x1-exact-integer? minor))
               (not (= major 1)) (not (= minor 0)))
           (x1-version-error operation
                             "unsupported configuration schema version"
                             (list major minor)))
          (else
           (x1-validate-required-positive values 'model.vocabulary-size operation)
           (x1-validate-required-positive values 'model.context-length operation)
           (x1-validate-required-positive values 'model.hidden-size operation)
           (x1-validate-required-positive values 'model.layer-count operation)
           (x1-validate-required-positive values 'model.query-head-count operation)
           (x1-validate-required-positive values 'model.kv-head-count operation)
           (x1-validate-required-positive values 'model.head-size operation)
           (x1-validate-required-positive values
                                          'training.accumulation-steps operation)
           (cond
             ((not (x1-nonnegative-i64? seed))
              (x1-invalid operation
                          "run.seed must be a nonnegative signed i64"
                          (list seed)))
             ((or (not (= (modulo query-heads kv-heads) 0))
                  (> kv-heads query-heads))
              (x1-invalid operation
                          "query head count must be divisible by KV head count"
                          (list query-heads kv-heads)))
             ((or (> query-heads (quotient x1-i64-max head-size))
                  (not (= hidden (* query-heads head-size))))
              (x1-invalid operation
                          "hidden size must equal query heads times head size"
                          (list hidden query-heads head-size)))
             ((not (or (symbol? dtype) (string? dtype)))
              (x1-invalid operation
                          "model.dtype must be a configuration enum"
                          (list dtype)))
             ((not (eq? dtype 'f32))
              (x1-unsupported operation
                              "schema 1.0 admits only f32; capability is unverified"
                              (list dtype)))
             ((not (or (symbol? device) (string? device)))
              (x1-invalid operation
                          "model.device must be a configuration enum"
                          (list device)))
             ((not (eq? device 'cpu))
              (x1-unsupported operation
                              "schema 1.0 admits only cpu; capability is unverified"
                              (list device)))
             ((not (boolean? deterministic))
              (x1-invalid operation
                          "run.deterministic must be boolean"
                          (list deterministic)))
             ((not deterministic)
              (x1-unsupported operation
                              "nondeterministic runs are not supported"
                              '()))
             (else #t)))))))

(define (config-validate resolved)
  (x1-validate resolved 'config-validate))

;;; -------------------------------------------------------------------------
;;; Access, canonicalization, and fingerprinting

(define (config-ref resolved key)
  (if (not (x1-resolved? resolved))
      (x1-invalid 'config-ref "expected a resolved configuration" '())
      (let ((schema-key (x1-reference-key key)))
        (if (not schema-key)
          (x1-invalid 'config-ref "unknown configuration key" (list key))
          (let ((entry (x1-assoc schema-key (x1-resolved-values resolved))))
            (if entry
                (cdr entry)
                (x1-invalid 'config-ref "resolved configuration is incomplete"
                            (list schema-key))))))))

(define (x1-key-string key)
  (symbol->string key))

(define (x1-json-value value operation)
  (cond
    ((boolean? value) (if value "true" "false"))
    ((integer? value) (number->string value))
    ((symbol? value) (string-append "\"" (symbol->string value) "\""))
    (else
     (x1-invalid operation "unsupported canonical value" (list value)))))

(define (x1-json-object keys value-function)
  (define (loop remaining first? output)
    (if (null? remaining)
        (string-append output "}")
        (let ((key (car remaining)))
          (loop (cdr remaining) #f
                (string-append
                 output (if first? "" ",") "\"" (x1-key-string key)
                 "\":" (value-function key))))))
  (loop keys #t "{"))

(define (x1-canonical resolved operation)
  (x1-validate resolved operation)
  (let* ((values (x1-resolved-values resolved))
         (provenance (x1-resolved-provenance resolved))
         (config-json
          (x1-json-object
           x1-schema-keys
           (lambda (key)
             (x1-json-value (x1-assoc-value values key #f) operation))))
         (provenance-json
          (x1-json-object
           x1-schema-keys
           (lambda (key)
             (x1-json-value (x1-assoc-value provenance key #f) operation)))))
    (string-append
     "{\"canonicalization\":\"eshkol-config-json-v1\","
     "\"checksum-algorithm\":\"sha256\","
     "\"checksum-coverage\":\"whole-document-including-final-lf\","
     "\"config-schema-version\":[1,0],"
     "\"format\":\"eshkol-resolved-run\",\"format-version\":[1,0],"
     "\"limits\":{\"integer-digits\":19,\"max-input-bytes\":16384,"
     "\"max-input-keys\":14,\"max-input-nesting-depth\":1},"
     "\"provenance\":" provenance-json
     ",\"required-features\":[],\"resolved\":" config-json "}\n")))

(define (config-canonical resolved)
  (x1-canonical resolved 'config-canonical))

(define (x1-lower-hex? text)
  (define (hex-character? character)
    (let ((code (char->integer character)))
      (or (and (>= code 48) (<= code 57))
          (and (>= code 97) (<= code 102)))))
  (define (loop position)
    (if (= position (string-length text))
        #t
        (and (hex-character? (string-ref text position))
             (loop (+ position 1)))))
  (and (= (string-length text) 64) (loop 0)))

(define (config-fingerprint resolved)
  (let* ((canonical (x1-canonical resolved 'config-fingerprint))
         (buffer (make-string 65 #\space))
         (status
          (x1-sha256-raw canonical (string-byte-length canonical) buffer 65))
         (digest (if (= status 0) (substring buffer 0 64) "")))
    (if (and (= status 0) (x1-lower-hex? digest))
        (string-append "sha256:eshkol-config-json-v1:" digest)
        (x1-unsupported 'config-fingerprint
                        "canonical SHA-256 is unavailable" (list status)))))

  (values config-parse config-resolve config-validate config-canonical
          config-fingerprint config-ref)))
