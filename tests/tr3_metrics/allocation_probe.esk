(require transformer.error_internal)
(define (m3t-fail category operation message)
  (transformer-error-raise category operation message '() #f))
(load "tr3_metrics_extension.esk")
(extern i64 metrics-fault-arm :real et_tr3_metrics_fault_arm_v1)
(extern i64 metrics-fault-arm-promotion
        :real et_tr3_metrics_fault_arm_promotion_v1)
(extern i64 metrics-fault-hit :real et_tr3_metrics_fault_hit_v1)
(define (check name value)
  (if (not value)
      (begin (display "TR3-METRICS-ALLOCATION-FAIL ")
             (display name) (newline) (exit 1))))
(define old-head (vector-ref tr3-metrics 0))
(check 'arm (= (metrics-fault-arm) 1))
(define caught #f)
(guard (failure (#t (set! caught failure)))
  (tr3-metrics-step-begin-internal!))
(check 'real-vector-denial (= (metrics-fault-hit) 1))
(check 'caught (not (eq? caught #f)))
(check 'head (eq? (vector-ref tr3-metrics 0) old-head))
(check 'staging (eq? (vector-ref tr3-metrics 1) #f))
(check 'promotion-arm (= (metrics-fault-arm-promotion) 1))
(set! caught #f)
(guard (failure (#t (set! caught failure)))
  (with-region ('tr3-metrics-fault-region 65536)
    (tr3-metrics-step-begin-internal!)))
(check 'real-promotion-denial (= (metrics-fault-hit) 2))
(check 'promotion-caught (not (eq? caught #f)))
(check 'promotion-head (eq? (vector-ref tr3-metrics 0) old-head))
(check 'promotion-staging (eq? (vector-ref tr3-metrics 1) #f))
(check 'retry (tr3-metrics-step-begin-internal!))
(tr3-metrics-step-fill-internal! 0 1065353216 1 1 1)
(tr3-metrics-step-precommit-internal!)
(define token (tr3-metrics-step-publish-internal!))
(check 'retry-published
       (eq? (vector-ref (tr3-metrics-step-authenticate-internal token) 2)
            token))
(display "TR3-METRICS-ALLOCATION-PASS") (newline)
