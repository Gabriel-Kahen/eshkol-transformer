;;; Test-only localization of the sealed stage-5 read-failure arena delta.
(extern void e3-retention-test-run ptr ptr ptr :real et_e3_retention_run_v1)

(define (check label condition)
  (if condition #t
      (begin (display "E3-RETENTION-DIAGNOSTIC-FAIL: ")
             (display label) (newline) (exit 1))))

(define (argument-count values)
  (let loop ((remaining values) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))

(define args (command-line))
(check 'arguments (= (argument-count args) 3))
(define path (car (cdr args)))
(define mode (car (cdr (cdr args))))
(check 'mode (or (string=? mode "fault") (string=? mode "control")
                 (string=? mode "d2-fault") (string=? mode "d2-control")
                 (string=? mode "d2-map-fault")))
(define d2-only? (or (string=? mode "d2-fault")
                     (string=? mode "d2-control")))
(define fault? (or (string=? mode "fault")
                   (string=? mode "d2-fault")))
(define input (vector path))
(define output (vector #f))
(define prepare (vector (vector 'retention 'prepare 1024 #f)))
(define diagnose (vector (vector 'retention 'diagnose 1024 #f fault?)))
(define report (vector (vector 'retention 'report 1024 #f)))
(define teardown (vector (vector 'retention 'teardown 1024 #f)))

(e3-retention-test-run prepare input output)
(check 'prepared (eq? (vector-ref output 0) #t))
(if (string=? mode "d2-map-fault")
    (begin
      (e3-retention-test-run
        (vector (vector 'retention 'diagnose-d2-map 1024 #f))
        input output)
      (let ((mapped (vector-ref output 0)))
        (check 'd2-map-samples
          (and (vector? mapped) (= (vector-length mapped) 9)
               (eq? (vector-ref mapped 0)
                    'e3-retention-d2-map-diagnostic-v1)))
        (display "E3-RETENTION-D2-MAP before=")
        (display (vector-ref mapped 1))
        (display " after-arm=") (display (vector-ref mapped 2))
        (display " caught=") (display (vector-ref mapped 3))
        (display " before-map=") (display (vector-ref mapped 4))
        (display " after-map=") (display (vector-ref mapped 5))
        (display " after-call=") (display (vector-ref mapped 6))
        (display " after-checks=") (display (vector-ref mapped 7))
        (display " after-retry=") (display (vector-ref mapped 8))
        (newline)
        (flush-output-port (current-output-port)))
      (exit 0)))
(if d2-only?
    (begin
      (e3-retention-test-run
        (vector (vector 'retention 'diagnose-d2 1024 #f fault?))
        input output)
      (let ((d2-samples (vector-ref output 0)))
        (check 'd2-samples
          (and (vector? d2-samples) (= (vector-length d2-samples) 7)
               (eq? (vector-ref d2-samples 0)
                    'e3-retention-d2-arena-diagnostic-v1)
               (eq? (vector-ref d2-samples 1) fault?)))
        (display "E3-RETENTION-D2-ARENA mode=") (display mode)
        (display " before=") (display (vector-ref d2-samples 2))
        (display " after-arm=") (display (vector-ref d2-samples 3))
        (display " after-call=") (display (vector-ref d2-samples 4))
        (display " after-checks=") (display (vector-ref d2-samples 5))
        (display " after-retry=") (display (vector-ref d2-samples 6))
        (newline)
        (flush-output-port (current-output-port)))
      (exit 0)))
(e3-retention-test-run diagnose input output)
(define samples (vector-ref output 0))
(check 'samples
  (and (vector? samples) (= (vector-length samples) 8)
       (eq? (vector-ref samples 0) 'e3-retention-arena-diagnostic-v1)
       (eq? (vector-ref samples 1) fault?)
       (let check-values ((index 2))
         (if (= index 8) #t
             (and (>= (vector-ref samples index) 0)
                  (check-values (+ index 1)))))))
(display "E3-RETENTION-ARENA-DIAGNOSTIC mode=")
(display mode)
(display " prepared=") (display (vector-ref samples 2))
(display " before=") (display (vector-ref samples 3))
(display " after-arm=") (display (vector-ref samples 4))
(display " after-call=") (display (vector-ref samples 5))
(display " after-checks=") (display (vector-ref samples 6))
(display " after-retry=") (display (vector-ref samples 7))
(newline)
(flush-output-port (current-output-port))
;; Report and teardown retain their original checks. Emit the measured phases
;; first so an abort in either check cannot erase a completed diagnose result.
(e3-retention-test-run report input output)
(define result (vector-ref output 0))
(check 'report (and (vector? result) (= (vector-length result) 11)
                    (eq? (vector-ref result 0) 'e3-retention-result-v1)
                    (= (vector-ref result 1) 1024)
                    (eq? (vector-ref result 2) #f)))
(e3-retention-test-run teardown input output)
(define released (vector-ref output 0))
(check 'teardown (and (vector? released) (= (vector-length released) 3)
                      (eq? (vector-ref released 0) 'e3-retention-teardown-v1)))

(display "E3-RETENTION-ARENA-POSTCHECK-PASS mode=")
(display mode)
(newline)
