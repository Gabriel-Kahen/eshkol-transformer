;;; Closed owned ledgers remain retryable after a wrapper raises after consuming
;;; authority. No finalizer is dispatched twice and no busy parent is abandoned.
(define retry-parent (cpu4-checkpoint-parent 'retry-trainer))
(define retry-i2 (vector #f #f #f #f #f 'prepared))
(define retry-d2 (vector #f #f #f #f #f 'prepared))
(define retry-o2 (vector #f #f #f #f #f #f #f 'prepared))
(define retry-stage (vector #f #f #f #f 'staged))
(define retry-control (vector #f #f #f #f #f 'active))
(vector-set! retry-parent 3 'cleanup-blocked)
(vector-set! retry-parent 4 (vector #f #f #f #f #f #f)) ; exact consumed borrow
(vector-set! retry-parent 9 retry-d2)
(vector-set! retry-parent 10 retry-i2)
(vector-set! (vector-ref retry-parent 11) 0 retry-o2)
(vector-set! (vector-ref retry-parent 12) 0 fault)
(vector-set! retry-parent 13 retry-control)
(vector-set! retry-parent 14 retry-stage)
(vector-set! retry-parent 15 retry-stage)
(vector-set! retry-parent 16 retry-control)
(define original-i2-abort tr3-c-restore-i2-abort-internal!)
(define original-control-abort cpu4-trainer-controls-restore-abort-internal!)
(define original-control-end cpu4-trainer-control-end-internal!)
(set! tr3-c-restore-i2-abort-internal!
  (lambda (value) (original-i2-abort value) (raise 'after-i2-abort)))
(set! cpu4-trainer-controls-restore-abort-internal!
  (lambda (value) (original-control-abort value) (raise 'after-stage-abort)))
(set! cpu4-trainer-control-end-internal!
  (lambda (value) (original-control-end value) (raise 'after-parent-end)))
(set! events '())
(do ((attempt 0 (+ attempt 1))) ((= attempt 3))
  (check "blocked cleanup retains original failure across closed-ledger retry"
    (guard (caught (#t (eq? caught fault)))
      (cpu4-checkpoint-drain-pending! 'retry-trainer) #f)))
(cpu4-checkpoint-drain-pending! 'retry-trainer)
(check "closed I2/stage/parent ledgers consumed exactly once across retries"
  (equal? events '(i2-abort d2-abort o2-abort control-abort end)))
(check "successful retry closes exact retained envelope"
  (and (eq? (vector-ref retry-parent 3) 'dead)
       (not (vector-ref retry-parent 4))
       (not (vector-ref retry-parent 10))
       (not (vector-ref retry-parent 14))
       (not (vector-ref retry-parent 13))))
(set! tr3-c-restore-i2-abort-internal! original-i2-abort)
(set! cpu4-trainer-controls-restore-abort-internal! original-control-abort)
(set! cpu4-trainer-control-end-internal! original-control-end)
(display "CPU4 checkpoint blocked closed-custody retry host PASS: checks=")
(display checks) (newline)
