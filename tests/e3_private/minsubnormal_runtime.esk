;;; Exact noninstalled finite min-subnormal E3 witness. The package performs genuine
;;; C1 admission before frame bind, then runs the normal E3 path.
(extern void e3-private-test-run ptr ptr ptr :real et_e3_test_run_v1)

(define (minsubnormal-check label value)
  (if value #t
      (begin (display "E3-MINSUBNORMAL-RUNTIME-FAIL: ") (display label)
             (newline) (exit 1))))

(define (minsubnormal-argument args index)
  (if (= index 0) (car args)
      (minsubnormal-argument (cdr args) (- index 1))))

(define (minsubnormal-count args)
  (let loop ((rest args) (count 0))
    (if (null? rest) count (loop (cdr rest) (+ count 1)))))

(define (minsubnormal-bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define (minsubnormal-print-cursor bytes)
  (let ((digits "0123456789abcdef"))
    (let loop ((index 0))
      (if (= index (bytevector-length bytes)) #t
          (let ((byte (bytevector-u8-ref bytes index)))
            (display (string-ref digits (quotient byte 16)))
            (display (string-ref digits (remainder byte 16)))
            (loop (+ index 1)))))))

(define arguments (command-line))
(minsubnormal-check 'arguments (= (minsubnormal-count arguments) 4))
(define clear?
  (string=? (minsubnormal-argument arguments 1) "bias-clear"))
(minsubnormal-check 'case
  (or clear? (string=? (minsubnormal-argument arguments 1) "finite-minsubnormal")))
(e3-minsubnormal-set-files!
  (vector (minsubnormal-argument arguments 3)) clear?)
(define output (vector #f))
(e3-private-test-run (vector (vector #t 0))
                     (vector (minsubnormal-argument arguments 2)) output)
(define result (vector-ref output 0))
(minsubnormal-check 'result
  (and (vector? result) (= (vector-length result) 9)
       (eq? (vector-ref result 0) 'e3-private-result-v1)
       (= (vector-ref result 1) 1085370904)
       (= (vector-ref result 2) 1084227584)
       (= (vector-ref result 3) 1132462080)
       (= (vector-ref result 4) 1065353216)
       (= (vector-ref result 5) 5)
       (= (vector-ref result 6) 3)
       (minsubnormal-bytes=? (vector-ref result 7) (vector-ref result 8))))
(display "E3CURSOR\t")
(minsubnormal-print-cursor (vector-ref result 7))
(display "\t")
(minsubnormal-print-cursor (vector-ref result 8))
(newline)
(display "E3-NUMERICAL-RUNTIME-PASS") (newline)
