;;; Complete-call retention: one private model, D2 dataset, frame and destinations.
(extern void e3-retention-test-run ptr ptr ptr :real et_e3_retention_run_v1)
(extern i64 e3-arena-used :real et_e3_retention_arena_used_v1)
(extern i64 e3-arena-total :real et_e3_retention_arena_total_v1)
(extern i64 e3-arena-blocks :real et_e3_retention_arena_blocks_v1)
(extern i64 e3-rss-kib :real et_e3_retention_rss_kib_v1)

(define (check label condition)
  (if condition #t
      (begin (display "FAIL: ") (display label) (newline) (exit 1))))

(define args (command-line))
(check 'arguments (= (length args) 4))
(define path (list-ref args 1))
(define horizon (string->number (list-ref args 2)))
(define present? (string=? (list-ref args 3) "present"))
(check 'horizon (or (= horizon 1024) (= horizon 8192)))
(check 'gradient-option
       (or present? (string=? (list-ref args 3) "absent")))

(define input (vector path))
(define output (vector #f))
(define prepare (vector (vector 'retention 'prepare horizon present?)))
(define execute (vector (vector 'retention 'execute horizon present?)))
(define report (vector (vector 'retention 'report horizon present?)))

(e3-retention-test-run prepare input output)
(check 'prepared (eq? (vector-ref output 0) #t))
(define used-before (e3-arena-used))
(define total-before (e3-arena-total))
(define blocks-before (e3-arena-blocks))
(define rss-before (e3-rss-kib))
(e3-retention-test-run execute input output)
(define used-after (e3-arena-used))
(define total-after (e3-arena-total))
(define blocks-after (e3-arena-blocks))
(define rss-after (e3-rss-kib))
(check 'executed (eq? (vector-ref output 0) #t))
(check 'retained-used-bytes (= used-before used-after))
(check 'retained-total-bytes (= total-before total-after))
(check 'retained-block-count (= blocks-before blocks-after))

(e3-retention-test-run report input output)
(define result (vector-ref output 0))
(check 'result-shape
       (and (vector? result) (= (vector-length result) 11)
            (eq? (vector-ref result 0) 'e3-retention-result-v1)
            (= (vector-ref result 1) horizon)
            (eq? (vector-ref result 2) present?)
            (= (vector-ref result 3) (vector-ref result 4))
            (= (vector-ref result 3) used-before)
            (vector? (vector-ref result 5))
            (vector? (vector-ref result 6))
            (vector? (vector-ref result 7))
            (= (vector-ref result 8) (vector-ref result 10))
            (>= (vector-ref result 8) 0)
            (<= (vector-ref result 8) 262144)
            (>= (vector-ref result 9) 0)
            (<= (vector-ref result 9) 262144)))
(define growth (vector-ref result 7))
(check 'cumulative-growth-shape
       (and (= (vector-length growth) 5)
            (> (vector-ref growth 0) 0)
            (= (vector-ref growth 0) (vector-ref growth 2))
            (= (vector-ref growth 2) (vector-ref growth 3))
            (> (vector-ref growth 4) 0)))
(display "E3-COMPLETE-CALL-RETENTION-PASS horizon=") (display horizon)
(display " gradient=") (display (if present? "present" "absent"))
(display " arena_used=") (display used-after)
(display " arena_total=") (display total-after)
(display " arena_blocks=") (display blocks-after)
(display " caller_region_used=") (display (vector-ref result 8))
(display " failure_region_used=") (display (vector-ref result 9))
(display " retry_region_used=") (display (vector-ref result 10))
(display " borrow_begins=") (display (vector-ref growth 0))
(display " borrow_views=") (display (vector-ref growth 1))
(display " retired_borrows=") (display (vector-ref growth 3))
(display " retired_control_bytes=") (display (vector-ref growth 4))
(newline)
(display "E3-RETENTION-RSS rss_before_kib=") (display rss-before)
(display " rss_after_kib=") (display rss-after) (newline)
