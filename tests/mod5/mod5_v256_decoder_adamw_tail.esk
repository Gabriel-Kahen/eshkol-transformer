;;; Test-only training loop over the pinned V256 decoder and trusted D2/O2 roots.
(extern ptr adamw-parameter i64 ptr i64 :real et_mod5_v256_test_parameter_v1)
(extern i64 adamw-parameter-bits i64 ptr ptr i64
        :real et_mod5_v256_test_parameter_bits_v1)
(extern i64 adamw-transfer ptr i64 ptr i64 i64
        :real et_mod5_v256_test_gradient_transfer_v1)
(extern i64 adamw-set-slot ptr i64 ptr :real et_mod5_v256_adamw_set_slot_v1)
(extern i64 adamw-row ptr i64 ptr :real et_mod5_v256_adamw_row_v1)
(extern i64 adamw-gradient ptr ptr i64 :real et_mod5_v256_adamw_gradient_v1)
(extern i64 adamw-moment ptr i64 i64 ptr i64 :real et_mod5_v256_adamw_moment_v1)

(define expected-tied-sha @@TIED_SHA@@)
(define adamw-options '(@@OPTIONS@@))
(define adamw-hex "0123456789abcdef")

(define (adamw-emit-bytes bytes)
  (do ((i 0 (+ i 1))) ((= i (bytevector-length bytes)))
    (let ((word (bytevector-u8-ref bytes i)))
      (display (string-ref adamw-hex (quotient word 16)))
      (display (string-ref adamw-hex (modulo word 16))))))

(define (adamw-parent root branches path)
  (let descend ((module root) (remaining path) (prefix '()))
    (if (null? (cdr remaining)) module
        (let* ((name (car remaining))
               (key (cons name prefix))
               (found (assoc key (vector-ref branches 0)))
               (child (if found (cdr found)
                          (let ((fresh (i2-module-create-internal)))
                            (module-register-child-internal! module name fresh)
                            (vector-set! branches 0
                              (cons (cons key fresh) (vector-ref branches 0)))
                            fresh))))
          (descend child (cdr remaining) key)))))

(define (adamw-count dimensions)
  (* (car dimensions) (cadr dimensions)))

(define (adamw-register weights tied? slots)
  (let ((root (i2-module-create-internal))
        (branches (vector '()))
        (native (make-vector parameters #f))
        (head-handle #f))
    (do ((rows roster (cdr rows)) (slot 0 (+ slot 1))) ((null? rows))
      (let* ((path (caar rows))
             (parent (adamw-parent root branches path))
             (count (adamw-count (tensor-dimensions (cadar rows)))))
        (if (and tied? (= slot wembedding))
            (i2-module-register-tied-parameter-internal! parent "weight" head-handle)
            (begin
              (pack (vector-ref weights slot) input-a)
              (let ((parameter (adamw-parameter slot (ffi-pointer input-a) count)))
                (check-data (not (null? parameter)) "native parameter allocation failed")
                (let* ((handle (i2-module-register-parameter-internal!
                                 parent "weight" (i2-carrier 'parameter parameter 'parameter)))
                       (carrier (parameter-handle-tensor-identity-internal handle))
                       (validated (i2-carrier-preflight carrier 'parameter 'mod5-adamw))
                       (value (vector-ref validated 2)))
                  (when (= slot whead) (set! head-handle handle))
                  (vector-set! native slot value)
                  (check-data (= 0 (adamw-set-slot (ffi-pointer slots) slot
                                                   (ffi-pointer value)))
                              "native optimizer slot registration failed")))))))
    (let* ((tree (module-parameters root))
           (paths (map car roster))
           (head (parameter-tree-handle tree (list-ref paths whead)))
           (embedding (parameter-tree-handle tree (list-ref paths wembedding)))
           (selected (if tied? (i2-reverse (cdr (i2-reverse paths))) paths))
           (config (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
                         '(none) '(constant)
                         (list (cons 'group (cons selected adamw-options))))))
      (check-data (and (equal? (parameter-tree-paths tree) paths)
                       (equal? (parameter-tree-tie-groups tree) (if tied? tied-aliases '()))
                       (eq? (eq? head embedding) tied?)
                       (equal? (parameter-handle-path head) (list-ref paths whead)))
                  "wrong canonical P1 topology")
      (vector native (o2-public-optimizer-create config tree)))))

(define (adamw-read-row tensor mask? scratch)
  (check-data
    (= 0 (d2-token-tensor-with-view-internal tensor
           (lambda (view)
             (adamw-row (ffi-pointer view) (if mask? 1 0) (ffi-pointer scratch)))))
    "invalid D2 borrowed plane")
  (if mask? #t (buffer->bytes scratch tokens)))

(define (adamw-row-tensor ids)
  (let ((tensor (zeros (list tokens vocab))))
    (do ((row 0 (+ row 1))) ((= row tokens) tensor)
      (tensor-set! tensor row (bytevector-u8-ref ids row) 1.0))))

(define (adamw-assert-cleared native count)
  (do ((slot 0 (+ slot 1))) ((= slot count))
    (check-data (= 0 (adamw-gradient (ffi-pointer (vector-ref native slot))
                                     (ffi-pointer input-a) 0))
                "optimizer left a gradient contribution")))

(define (adamw-stage-gradients gradients slots native count tied? packed port)
  (let ((offset 0))
    (do ((rows roster (cdr rows)) (slot 0 (+ slot 1))) ((= slot count))
      (let* ((dims (tensor-dimensions (cadar rows)))
             (gradient (vector-ref gradients slot)))
        (check-data (equal? (tensor-shape gradient) dims) "wrong decoder gradient shape")
        (pack gradient (ptr-add packed (* 4 offset)))
        (set! offset (+ offset (adamw-count dims)))))
    (check-data (= offset (if tied? 6448 10544)) "wrong physical gradient extent")
    (check-data (= 0 (adamw-transfer (ffi-pointer slots) count (ffi-pointer packed)
                                     offset (if tied? 1 0)))
                "atomic I2 gradient transfer failed")
    (set! offset 0)
    (do ((rows roster (cdr rows)) (slot 0 (+ slot 1))) ((= slot count))
      (let ((words (adamw-count (tensor-dimensions (cadar rows)))))
        (check-data (= 0 (adamw-gradient (ffi-pointer (vector-ref native slot))
                           (ptr-add packed (* 4 offset)) words))
                    "native gradient differs from decoder bits or metadata")
        (set! offset (+ offset words))))
    (write-bytevector (buffer->bytes packed (* 4 offset)) port)))

(define (adamw-refresh weights native count tied? initial? port)
  (do ((rows roster (cdr rows)) (slot 0 (+ slot 1))) ((= slot count))
    (let* ((dims (tensor-dimensions (cadar rows)))
           (old (tensor->f32-bytes (vector-ref weights slot)))
           (words (adamw-count dims)))
      (check-data (= 0 (adamw-parameter-bits slot (ffi-pointer (vector-ref native slot))
                                           (ffi-pointer input-a) words))
                  "native parameter copy failed")
      (let ((bits (buffer->bytes input-a (* 4 words)))
            (fresh (unpack input-a (car dims) (cadr dims))))
        (check-data (if initial? (c1-bytes=? old bits) (not (c1-bytes=? old bits)))
                    "unexpected native pre/post parameter words")
        (check-data (c1-bytes=? bits (tensor->f32-bytes fresh))
                    "live decoder refresh changed native parameter bits")
        (write-bytevector bits port)
        (vector-set! weights slot fresh))))
  (when tied? (vector-set! weights wembedding (vector-ref weights whead)))
  (check-data (eq? (eq? (vector-ref weights whead) (vector-ref weights wembedding)) tied?)
              "decoder refresh broke head/embedding ownership"))

(define (adamw-write-moments optimizer count port)
  (let* ((snapshot (o2-public-optimizer-state optimizer))
         (state (o2-require-live-state 'mod5-adamw snapshot))
         (native (vector-ref state 1)))
    (guard (caught (#t (o2-public-optimizer-state-release! snapshot) (raise caught)))
      (do ((kind 0 (+ kind 1))) ((= kind 2))
        (do ((rows roster (cdr rows)) (slot 0 (+ slot 1))) ((= slot count))
          (let ((words (adamw-count (tensor-dimensions (cadar rows)))))
            (check-data (= 0 (adamw-moment (ffi-pointer native) slot kind
                                           (ffi-pointer input-a) words))
                        "native AdamW moment copy failed")
            (write-bytevector (buffer->bytes input-a (* 4 words)) port)))))
    (check-data (o2-public-optimizer-state-release! snapshot) "release native optimizer state")))

(define (adamw-cursor dataset update)
  (display "CURSOR ") (display update) (display " ")
  (adamw-emit-bytes (c1-sha256 (d2-token-dataset-cursor dataset))) (newline))

(define (adamw-update weights native optimizer slots count tied? packed dataset ordinal port)
  (let ((batch (d2-token-dataset-next-batch dataset)))
    (check-data (and (not (d2-token-dataset-end? batch)) (d2-token-batch-validate batch))
                "missing valid D2 training row")
    (adamw-read-row (d2-token-batch-loss-mask batch) #t packed)
    (let* ((ids (adamw-read-row (d2-token-batch-inputs batch) #f packed))
           (labels (adamw-read-row (d2-token-batch-targets batch) #f packed))
           (released (d2-token-batch-release! batch))
           (input (adamw-row-tensor ids))
           (target (adamw-row-tensor labels))
           (gradients (make-vector parameters #f))
           (loss (vector-ref (decoder weights input target gradients tied?) 0)))
      (check-data released "release live D2 batch failed")
      (when tied?
        (let* ((separate (make-vector parameters #f))
               (other-loss (vector-ref (decoder weights input target separate #f) 0)))
          (check-data (= loss other-loss) "tied backward changed the live loss")
          (canonicalize-tied! gradients separate)))
      (adamw-assert-cleared native count)
      (adamw-stage-gradients gradients slots native count tied? packed port)
      (check-data (o2-public-optimizer-step! optimizer) "native AdamW step failed")
      (check-data (= (+ ordinal 1) (o2-optimizer-completed-updates-internal optimizer))
                  "wrong native AdamW update count")
      (check-data (o2-public-optimizer-zero-grad! optimizer) "native gradient clear failed")
      (adamw-assert-cleared native count)
      (adamw-refresh weights native count tied? #f port)
      (adamw-write-moments optimizer count port)
      (let ((after (vector-ref (decoder weights input target #f #f) 0)))
        (display "ROW ") (display ordinal) (display " ")
        (adamw-emit-bytes ids) (display " ") (adamw-emit-bytes labels) (display " 8 ")
        (print-real "%.17g" loss) (display " ") (print-real "%.17g" after) (newline)))))

(define (adamw-witness fixture model variant destination)
  (let* ((tied? (string=? variant "tied"))
         (weights (vector-ref (load-checked-weights
                               model (if tied? expected-tied-sha expected-model-sha)) 0))
         (tokenizer-path (string-append fixture "/tokenizer.etok"))
         (fingerprint (check-tokenizer tokenizer-path))
         (tokenizer (t2-wave2-tokenizer-load tokenizer-path
                      (c1-wave2-persistence-policy 1024 1024 1024 1 'cpu)))
         (count (if tied? 11 12))
         (slots (checked-allocate (* 8 count)))
         (packed (checked-allocate (* 4 (if tied? 6448 10544))))
         (enrolled (adamw-register weights tied? slots))
         (native (vector-ref enrolled 0))
         (optimizer (vector-ref enrolled 1))
         (dataset (d2-token-dataset-open
                    (list ':directory (string-append fixture "/train")
                          ':batch-size 1 ':sequence-length 8
                          ':maximum-manifest-bytes 1024 ':maximum-shard-bytes 1024
                          ':maximum-total-tokens 54 ':maximum-batch-bytes 136
                          ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f)
                    tokenizer))
         (port (open-binary-output-file destination)))
    (check-data (and (= tokens 8) (= vocab 256)
                     (string=? (vector-ref (d2-tokenizer-identity tokenizer) 0) fingerprint)
                     (eq? (eq? (vector-ref weights whead) (vector-ref weights wembedding)) tied?)
                     (= 0 (o2-optimizer-completed-updates-internal optimizer)))
                "wrong tokenizer, decoder or optimizer initialization")
    (display "PROFILE ") (display variant) (display " ") (display count) (newline)
    (adamw-refresh weights native count tied? #t port)
    (do ((update 0 (+ update 1))) ((= update 6))
      (adamw-cursor dataset update)
      (adamw-update weights native optimizer slots count tied? packed dataset update port))
    (adamw-cursor dataset 6)
    (check-data (d2-token-dataset-end? (d2-token-dataset-next-batch dataset))
                "unexpected D2 row after six updates")
    (check-data (d2-token-dataset-close! dataset) "close live D2 dataset failed")
    (close-port port)
    (release packed)
    (release slots)
    (display "MOD5 V256 decoder AdamW PASS rows=6 updates=6") (newline)))

(define args (cdr (command-line)))
(check-data (equal? (c1-list-length-bounded args 5) 4)
            "expected FIXTURE MODEL tied|untied BITS")
(check-data (or (string=? (caddr args) "untied") (string=? (caddr args) "tied"))
            "unexpected MOD5 V256 optimizer profile")
(guard (caught (#t (close-workspace) (write caught) (newline) (exit 2)))
  (adamw-witness (car args) (cadr args) (caddr args) (cadddr args)))
(close-workspace)
