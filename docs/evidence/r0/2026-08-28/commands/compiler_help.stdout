Usage: eshkol-run [options] <input.esk|input.o> [input.esk|input.o]
       eshkol-run -e '<expression>'   (JIT evaluate expression)
       eshkol-run -r <file.esk>       (JIT run file)

	--help:[-h] = Print this help message.
	--debug:[-d] = Debugging information added inside the program.
	--dump-ast:[-a] = Dumps the AST into a .ast file.
	--dump-ir:[-i] = Dumps the IR into a .ll file.
	--output:[-o] = Outputs into a binary file.
	--compile-only:[-c] = Compiles into an intermediate object file.
	--shared-lib:[-s] = Compiles it into a shared library.
	--wasm:[-w] = Compiles to WebAssembly (.wasm) format.
	--lib:[-l] = Links a shared library to the resulting executable.
	--lib-path:[-L] = Adds a directory to the library search path.
	--no-stdlib:[-n] = Do not auto-load the standard library.
	--eval:[-e] = JIT evaluate an expression and print the result.
	--run:[-r] = JIT run a file (interpret without compiling).
	--debug-info:[-g] = Emit DWARF debug info (enables lldb/gdb source-level debugging).
	--optimize:[-O] N = Set LLVM optimization level (0=none, 1=basic, 2=full, 3=aggressive).
	--strict-types = Type errors are fatal (default: gradual/warnings).
	--unsafe = Skip all type checks.

Eshkol Compiler v1.1.13-accelerate
