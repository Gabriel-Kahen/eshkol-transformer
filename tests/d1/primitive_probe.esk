(load "eshkol_transformer/sha256.esk")

(define (probe-bytes=? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left))
             #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define arguments (command-line))
(if (< (let loop ((rest arguments) (n 0))
         (if (null? rest) n (loop (cdr rest) (+ n 1))))
       2)
    (begin (display "D1_PRIMITIVES_FAIL missing directory") (newline) (exit 64)))

(define root (car (cdr arguments)))
(define lock (string-append root "/lock"))
(define temporary (string-append root "/primitive.tmp"))
(define final (string-append root "/primitive.bin"))
(define raw (bytevector 0 1 127 128 254 255))
(define utf8-text "opaque-identity-λ")

(define lock-created (make-directory lock))
(define concurrent-rejected (not (make-directory lock)))
(define lock-removed (delete-directory lock))

(define out (open-binary-output-file temporary))
(write-bytevector raw out)
(close-port out)
(define exact-size (= (file-size temporary) 6))
(define renamed (file-rename temporary final))
(define rename-state (and (not (file-exists? temporary)) (file-exists? final)))
(define in (open-binary-input-file final))
(define read-back (read-bytevector 6 in))
(define eof-after (eof-object? (read-u8 in)))
(close-port in)
(define removed (delete-file final))

(define abc-expected
  (bytevector 186 120 22 191 143 1 207 234 65 65 64 222 93 174 34 35
              176 3 97 163 150 23 122 156 180 16 255 97 242 0 21 173))
(define hash-ok (probe-bytes=? (d1-sha256 (bytevector 97 98 99)) abc-expected))
(define utf8-ok
  (probe-bytes=? (string->utf8 utf8-text)
                 (string->utf8 (utf8->string (string->utf8 utf8-text)))))

(if (and lock-created concurrent-rejected lock-removed exact-size renamed
         rename-state (probe-bytes=? raw read-back) eof-after removed hash-ok utf8-ok)
    (begin (display "D1_PRIMITIVES_PASS") (newline))
    (begin (display "D1_PRIMITIVES_FAIL") (newline) (exit 1)))
