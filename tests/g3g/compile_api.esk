(require transformer.generation)
(define (all-operations model tokenizer config input t1 token output tensor rng)
  (generator-create model tokenizer config)
  (generation-input-create t1)
  (generation-token-input-create token)
  (generator-generate! model input)
  (generation-output-ids output)
  (generation-output-lengths output)
  (generation-output-text output)
  (generation-output-rng output)
  (generation-output-cache-lengths output)
  (generation-tensor-release! tensor)
  (generation-output-release! output)
  (generation-rng-release! rng)
  (generator-close! model))
