;;; Private fixed P2/G2 terminal coordinator. Load only with the accepted
;;; native terminal feature and all preceding source-private P2/G2 leaves.
;;; Its sole success is the original terminal output shell, never a body value.

(extern i64 g3c4-p2g2-native-terminal-commit ptr ptr ptr i64 ptr i64
        :real et_g3c4_private_p2g2_terminal_commit_v1)

;;; The enrollment installer is consumed exactly once by the owning public
;;; dispatcher during package initialization. No current-ticket cell exists.
(define g3c4-p2g2-terminal-enrollment-route-private
  (lambda (stage roots) (exit 134)))

(define g3c4-p2g2-terminal-commit-private!
  (let ((installed? #f))
    (let ((generator-node
            (lambda (root shell)
              (let find ((nodes (vector-ref root 0)))
                (if (not (pair? nodes))
                    (g3c4-fail 'invalid-state 'g3c4-p2g2-terminal-commit-private!
                               "terminal generator provenance node missing"))
                (let ((row (car nodes)))
                  (if (and (vector? row) (> (vector-length row) 0)
                           (eq? (vector-ref row 0) shell))
                      nodes (find (cdr nodes))))))))
    (let ((core (lambda (generator input enrollment)
  (let* ((operation 'g3c4-p2g2-terminal-commit-private!)
         (input-entry (g3c4-p2g2-prefix-preflight generator input))
         (native-input (vector-ref input-entry 3))
         (generator-entry (g3c4-generator-entry-call-ready generator operation))
         (issuer (if enrollment (vector-ref enrollment 1) #f))
         (enrollment-roots (if enrollment (vector-ref enrollment 2) #f))
         (enrollment-heads (if enrollment (vector-ref enrollment 3) #f))
         (generator-proof (if enrollment (vector-ref enrollment 4) #f))
         (creation-profile (if enrollment (vector-ref (vector-ref enrollment 0) 3) #f))
         (enrollment-binding (if enrollment (car (vector-ref enrollment-heads 3)) #f))
         (enrollment-authority (if enrollment (vector-ref (vector-ref enrollment 0) 16) #f))
         (creation-policy (vector-ref generator-entry 7))
         (creation-words
           (vector (vector-ref creation-policy 1) (vector-ref creation-policy 2)
                   (vector-ref creation-policy 3) (vector-ref creation-policy 4)
                   (vector-ref creation-policy 5) (vector-ref creation-policy 6)))
         (enrollment-row (if enrollment (vector-ref (vector-ref enrollment 0) 10)
                             (make-vector 12 #f)))
         (enrollment-anchor
           (if enrollment (vector-ref (vector-ref enrollment 0) 11)
               (make-vector 12 #f)))
         (enrollment-ticket
           (if enrollment (vector-ref enrollment 0) (make-vector 21 #f))))
    (if enrollment
        (issuer 'admit generator input enrollment-ticket #f #f #f
                0 -1 -1 operation)
        (begin
          (vector-set! enrollment-ticket 10 enrollment-row)
          (vector-set! enrollment-ticket 11 enrollment-anchor)
          (vector-set! enrollment-ticket 12 'pending)
          (vector-set! enrollment-row 8 'pending)
          (vector-set! enrollment-anchor 8 'pending)))
    (m3-call operation
      (let* ((model-entry (vector-ref generator-entry 5))
             (tokenizer (vector-ref generator-entry 6))
             (tokenizer-core
               (car (cdr (g3c4-baseline-tokenizer-entry
                          tokenizer operation 'invalid-state 'invalid-state))))
             (native (vector-ref generator-entry 3))
             (policy (vector-ref generator-entry 7))
             (first-raw (make-bytevector 1 0))
             (first-staging (make-bytevector 8 0))
             (ledger (vector #f #f #f #f #f))
             (barrier (vector #f))
             (call (vector (vector 'g3c4-call-private) 'call 'pending #f
                           generator-entry model-entry tokenizer 2 #f #f
                           ledger g3c4-model-profile))
             (record (vector call generator-entry model-entry tokenizer
                             tokenizer-core native #f #f #f #f #f
                             first-raw first-staging 'before-prefix ledger
                             policy (vector 10 24 9 16) (vector-ref call 0)
                             #f (vector-ref model-entry 3)))
             (protected-anchor
               (vector call generator-entry model-entry tokenizer
                       tokenizer-core native #f #f #f #f #f
                       first-raw first-staging 'before-prefix ledger policy
                       (vector-ref record 16) (vector-ref call 0)
                       #f (vector-ref model-entry 3)))
             (prefix (vector call input input-entry native-input
                             generator-entry))
             (registry-node (cons call (vector-ref g3c4-registry 0)))
             (record-node
               (cons record (vector-ref g3c4-p2g2-protected-records 0)))
             (protected-node
               (cons protected-anchor
                     (vector-ref g3c4-p2g2-protected-anchors 0)))
             (prefix-node
               (cons prefix (vector-ref g3c4-p2g2-prefix-input-anchors 0)))
             (prefix-installed? #f)
             (pending #f)
             (live #f)
             (live-authority #f)
             (live-anchor-node #f)
             (live-original-node #f))
        (if (not (and (eq? input-entry
                           (g3c4-input-entry-live input operation))
                      (eq? (vector-ref input-entry 3) native-input)
                      (eq? generator-entry
                           (g3c4-generator-entry-call-ready
                             generator operation))
                      (vector-ref g3c4-p2g2-ownership-gate 0)
                      (= (vector-ref policy 5) 2)
                      (g3c4-call-tuple? 2 2)))
            (g3c4-fail 'invalid-state operation
                       "P2/G2 terminal input or generator changed"))
        (guard (caught
                 (#t
                   ;; Native zero is irreversible. No abort, validator or
                   ;; recoverable exception may cross the closed success tail.
                   (if (vector-ref barrier 0) (exit 134))
                   (if (not (eq? (vector-ref call 2) 'dead))
                       (if (vector-ref ledger 0)
                           (guard (abort-failure (#t (exit 134)))
                             (if pending
                                 (g3c4-p2g2-terminal-pending-abort!
                                   call pending)
                                 (g3c4-p2g2-protected-abort! call)))
                           (begin
                             (g3c4-p2g2-zero-bytes! first-raw 1)
                             (g3c4-p2g2-zero-bytes! first-staging 8)
                             (g3c4-call-dead! call)
                             (vector-set! record 0 #f)
                             (vector-set! protected-anchor 0 #f)
                             (vector-set! g3c4-p2g2-protected-records 0
                                          (cdr record-node))
                             (vector-set! g3c4-p2g2-protected-anchors 0
                                          (cdr protected-node)))))
                   (if prefix-installed?
                       (if (eq? (vector-ref
                                   g3c4-p2g2-prefix-input-anchors 0)
                                prefix-node)
                           (vector-set! g3c4-p2g2-prefix-input-anchors 0
                                        (cdr prefix-node))
                           (exit 134)))
                   (raise caught)))
          (vector-set! g3c4-registry 0 registry-node)
          (vector-set! g3c4-p2g2-protected-records 0 record-node)
          (vector-set! g3c4-p2g2-protected-anchors 0 protected-node)
          (g3c4-native-check (g3c4-native-call-acquire native 2 2)
                             operation)
          (vector-set! ledger 0 #t)
          (vector-set! model-entry 10 call)
          (vector-set! ledger 1 #t)
          (vector-set! generator-entry 9 call)
          (vector-set! ledger 2 #t)
          (vector-set! call 2 'live)
          (vector-set! ledger 3 'p2g2-protected)
          (if (not (eq? (vector-ref m3-call-state 0) #t)) (exit 134))
          (vector-set! m3-call-state 0 call)
          (vector-set! g3c4-p2g2-prefix-input-anchors 0 prefix-node)
          (set! prefix-installed? #t)
          (set! pending (g3c4-p2g2-terminal-pending-reserve! call))
          (set! live (g3c4-p2g2-terminal-live-prepare call pending))
          (set! live-authority (vector-ref live 10))
          (set! live-anchor-node (vector-ref live 13))
          (set! live-original-node (vector-ref live 14))
          (if enrollment
              (issuer 'bind generator input enrollment-ticket
                      (vector-ref live 1) live (vector-ref live 10)
                      0 -1 -1 operation))
          (let* ((first-selected
                   (g3c4-p2g2-terminal-first-sample-decode! call pending))
                 (checked
                   (g3c4-p2g2-terminal-pending-check
                     call pending operation))
                 (eos (vector-ref (vector-ref (vector-ref checked 2) 15) 6))
                 (first-eos? (and (m3t-exact-i64? eos)
                                  (= first-selected eos)))
                 (second-selected
                   (if first-eos? #f
                       (begin
                         (g3c4-p2g2-terminal-non-eos-prefix-commit!
                           call pending first-selected)
                         (g3c4-p2g2-terminal-second-sample-decode!
                           call pending))))
                 (logical-count
                   (g3c4-p2g2-terminal-text-preflight!
                     call pending first-selected second-selected))
                 (frame
                   (g3c4-p2g2-terminal-precommit-frame
                     call pending first-selected second-selected
                     logical-count))
                 (output (vector-ref frame 3))
                 (shell (vector-ref frame 4))
                 (output-native (vector-ref frame 6))
                 (selected-text (vector-ref frame 12))
                 (second-raw (vector-ref frame 26))
                 (first-staging (vector-ref frame 24))
                 (second-staging (vector-ref frame 25))
                 (text-one (vector-ref frame 27))
                 (text-two (vector-ref frame 28))
                 (pending-raw (vector-ref frame 29))
                 (pending-staging (vector-ref frame 30))
                 (pending-anchors-next (vector-ref frame 19))
                 (pending-originals-next (vector-ref frame 20))
                 (protected-records-next (vector-ref frame 21))
                 (protected-anchors-next (vector-ref frame 22))
                 (prefix-next (vector-ref frame 23))
                 ;; The accepted compiler pin converts #f payload zero to
                 ;; C NULL for a declared extern ptr. The first-EOS frame
                 ;; supplies that #f with byte extent zero.
                 (bound-live
                   (g3c4-p2g2-terminal-live-bind! call pending live frame))
                 ;; Every callable public stage precedes the final independent
                 ;; private frame/carrier authentication below.
                 (enrollment-verified
                   (if enrollment
                       (issuer 'verify generator input enrollment-ticket
                               output live (vector-ref live 10) logical-count
                               first-selected
                               (if (= logical-count 1) 0 second-selected)
                               operation)
                       #t))
                 (final-frame
                   (g3c4-p2g2-terminal-precommit-frame
                     call pending first-selected second-selected
                     logical-count))
                 (final-checked
                   (begin
                     (let exact-frame ((index 0))
                       (if (< index 31)
                           (if (eq? (vector-ref frame index)
                                    (vector-ref final-frame index))
                               (exact-frame (+ index 1))
                               (g3c4-fail 'invalid-state operation
                                          "terminal frame changed after enrollment"))))
                     (if enrollment
                         (let roots-unchanged ((index 0))
                           (if (< index 7)
                               (if (eq? (vector-ref (vector-ref enrollment-roots index) 0)
                                        (vector-ref enrollment-heads index))
                                   (roots-unchanged (+ index 1))
                                   (g3c4-fail 'invalid-state operation
                                              "terminal enrollment root changed")))))
                     (if enrollment
                         (let provenance ((index 0))
                           (if (< index 3)
                               (let* ((node (vector-ref generator-proof index))
                                      (original-row (vector-ref generator-proof (+ index 3)))
                                      (fields (vector-ref generator-proof (+ index 6))))
                                 (if (not (and
                                       (eq? (generator-node
                                               (vector-ref enrollment-roots (+ index 4)) generator) node)
                                       (eq? (car node) original-row)
                                       (eq? (cdr node) (vector-ref generator-proof (+ index 9)))
                                       (vector? original-row)
                                       (= (vector-length original-row) (if (= index 2) 2 8))))
                                     (g3c4-fail 'invalid-state operation
                                                "terminal generator provenance node changed"))
                                 (let exact-fields ((slot 0))
                                   (if (< slot (vector-length fields))
                                       (if (eq? (vector-ref original-row slot) (vector-ref fields slot))
                                           (exact-fields (+ slot 1))
                                           (g3c4-fail 'invalid-state operation
                                                      "terminal generator provenance fields changed"))))
                                 (provenance (+ index 1))))))
                     (if (not (and
                         (eq? bound-live live)
                         (eq? (vector-ref generator-entry 7) creation-policy)
                         (vector? enrollment-ticket)
                         (= (vector-length enrollment-ticket) 21)
                         (vector? enrollment-row)
                         (= (vector-length enrollment-row) 12)
                         (vector? enrollment-anchor)
                         (= (vector-length enrollment-anchor) 12)
                         (not (eq? enrollment-ticket enrollment-row))
                         (not (eq? enrollment-ticket enrollment-anchor))
                         (not (eq? enrollment-row enrollment-anchor))
                         (eq? (vector-ref enrollment-ticket 10) enrollment-row)
                         (eq? (vector-ref enrollment-ticket 11) enrollment-anchor)
                         (eq? (vector-ref enrollment-ticket 12) 'pending)
                         (eq? (vector-ref enrollment-row 8) 'pending)
                         (eq? (vector-ref enrollment-anchor 8) 'pending)
                         (not (eq? enrollment-row output))
                         (not (eq? enrollment-anchor output))
                         (not (eq? enrollment-ticket live))
                         (not (eq? enrollment-ticket record))
                         (not (eq? enrollment-row record))
                         (not (eq? enrollment-anchor record))
                         (eq? (vector-ref live 0) 'unpublished)
                         (eq? (vector-ref live 1) output)
                         (eq? (vector-ref live 2) shell)
                         (eq? (vector-ref live 3) output-native)
                         (eq? (vector-ref live 4) text-one)
                         (eq? (vector-ref live 5) text-two)
                         (eq? (vector-ref live 10) live-authority)
                         (eq? (vector-ref live 13) live-anchor-node)
                         (eq? (vector-ref live 14) live-original-node)
                         (eq? (car live-anchor-node) live)
                         (eq? (car live-original-node) live-authority)
                         (eq? (cdr live-anchor-node) (vector-ref live 11))
                         (eq? (cdr live-original-node) (vector-ref live 12))
                         (eq? (vector-ref g3c4-p2g2-terminal-live-anchors 0)
                              (vector-ref live 11))
                         (eq? (vector-ref g3c4-p2g2-terminal-live-originals 0)
                              (vector-ref live 12))
                         (= (vector-ref live 6) logical-count)
                         (eq? (vector-ref live 7) selected-text)
                         (= (vector-ref live 8) first-selected)
                         (if (= logical-count 1)
                             (eq? (vector-ref live 9) #f)
                             (= (vector-ref live 9) second-selected))
                         (= (vector-ref live 15) (+ logical-count 2))
                         (if enrollment
                             (and
                               (pair? (vector-ref enrollment-heads 0))
                               (eq? (car (vector-ref enrollment-heads 0)) enrollment-ticket)
                               (eq? (car (vector-ref enrollment-heads 1)) enrollment-row)
                               (eq? (car (vector-ref enrollment-heads 2)) enrollment-anchor)
                               (eq? (car (vector-ref enrollment-heads 3)) enrollment-binding)
                               (eq? (vector-ref enrollment-ticket 16) enrollment-authority)
                               (eq? (vector-ref enrollment-binding 1) enrollment-authority)
                               (eq? (vector-ref enrollment-binding 0) shell)
                               (eq? (vector-ref (car (vector-ref enrollment-heads 3)) 1)
                                    (vector-ref enrollment-ticket 16))
                               (eq? (vector-ref enrollment-ticket 3) creation-profile)
                               (eq? (vector-ref creation-profile 0) generator)
                               (eq? (vector-ref creation-profile 1) generator-entry)
                               (eq? (vector-ref creation-profile 2) native)
                               (eq? (vector-ref creation-profile 3) model-entry)
                               (eq? (vector-ref creation-profile 4) tokenizer)
                               (eq? (vector-ref creation-profile 5) creation-policy)
                               (eq? (vector-ref creation-profile 6) 'diagnostic-c4-p2g2)
                               (eq? (vector-ref creation-profile 7) 'live)
                               (let policy-unchanged ((index 1))
                                 (if (= index 7) #t
                                     (and (= (vector-ref creation-policy index)
                                             (vector-ref creation-words (- index 1)))
                                          (policy-unchanged (+ index 1)))))
                               (= (vector-ref creation-policy 5) 2)
                               (<= 0 (vector-ref creation-policy 6))
                               (<= (vector-ref creation-policy 6) 255)
                               (eq? (vector-ref enrollment-ticket 1) generator)
                               (eq? (vector-ref enrollment-ticket 2) input)
                               (eq? (vector-ref enrollment-ticket 4) input-entry)
                               (eq? (vector-ref enrollment-ticket 5) shell)
                               (eq? (vector-ref enrollment-ticket 6) output)
                               (eq? (vector-ref enrollment-ticket 7) output-native)
                               (eq? (vector-ref enrollment-ticket 8) live)
                               (eq? (vector-ref enrollment-ticket 9)
                                    (vector-ref live 10))
                               (= (vector-ref enrollment-ticket 13) logical-count)
                               (= (vector-ref enrollment-ticket 14) first-selected)
                               (= (vector-ref enrollment-ticket 15)
                                  (if (= logical-count 1) 0 second-selected))
                               (let ((expected
                                       (vector shell output output-native generator input
                                               creation-profile live live-authority 'pending
                                               logical-count first-selected
                                               (if (= logical-count 1) 0 second-selected))))
                                 (let fields ((index 0))
                                   (if (= index 12) #t
                                       (and (eq? (vector-ref enrollment-row index)
                                                 (vector-ref expected index))
                                            (eq? (vector-ref enrollment-anchor index)
                                                 (vector-ref expected index))
                                            (fields (+ index 1)))))))
                             #t)))
                         (g3c4-fail 'invalid-state operation
                                    "terminal enrollment carriers changed"))
                     #t))
                 (status
                   (g3c4-p2g2-native-terminal-commit
                     (vector-ref frame 5) output-native
                     (vector-ref frame 7) (vector-ref frame 8)
                     (vector-ref frame 9) (vector-ref frame 10))))
            (if (= status 0)
                (begin
                  (vector-set! barrier 0 #t)
                  (vector-set! enrollment-ticket 12 'live)
                  (vector-set! enrollment-row 8 'live)
                  (vector-set! enrollment-anchor 8 'live)
                  ;; Closed tail: exact original carriers, fixed byte writes.
                  ;; Pending raw/staging and unused text were proved zero by
                  ;; the precommit frame and are detached below.
                  (bytevector-u8-set! first-raw 0 0)
                  (bytevector-u8-set! first-staging 0 0)
                  (bytevector-u8-set! first-staging 1 0)
                  (bytevector-u8-set! first-staging 2 0)
                  (bytevector-u8-set! first-staging 3 0)
                  (bytevector-u8-set! first-staging 4 0)
                  (bytevector-u8-set! first-staging 5 0)
                  (bytevector-u8-set! first-staging 6 0)
                  (bytevector-u8-set! first-staging 7 0)
                  (bytevector-u8-set! second-raw 0 0)
                  (bytevector-u8-set! second-staging 0 0)
                  (bytevector-u8-set! second-staging 1 0)
                  (bytevector-u8-set! second-staging 2 0)
                  (bytevector-u8-set! second-staging 3 0)
                  (bytevector-u8-set! second-staging 4 0)
                  (bytevector-u8-set! second-staging 5 0)
                  (bytevector-u8-set! second-staging 6 0)
                  (bytevector-u8-set! second-staging 7 0)
                  (vector-set! output 4 #f)
                  (vector-set! output 5 #f)
                  (vector-set! output 6 #f)
                  (vector-set! output 8 selected-text)
                  (vector-set! output 1 'terminal-output)
                  (vector-set! output 2 'live)
                  (vector-set! live 0 'live)
                  (vector-set! g3c4-p2g2-terminal-live-anchors 0
                               (vector-ref live 13))
                  (vector-set! g3c4-p2g2-terminal-live-originals 0
                               (vector-ref live 14))
                  (vector-set! pending 1 #f)
                  (vector-set! pending 2 #f)
                  (vector-set! pending 3 #f)
                  (vector-set! pending 4 #f)
                  (vector-set! pending 5 #f)
                  (vector-set! pending 6 #f)
                  (vector-set! pending 7 #f)
                  (vector-set! pending 8 #f)
                  (vector-set! pending 9 #f)
                  (vector-set! pending 10 #f)
                  (vector-set! pending 11 #f)
                  (vector-set! pending 12 #f)
                  (vector-set! pending 13 #f)
                  (vector-set! pending 14 #f)
                  (vector-set! pending 15 #f)
                  (vector-set! pending 16 #f)
                  (vector-set! g3c4-p2g2-terminal-pending-anchors 0
                               pending-anchors-next)
                  (vector-set! g3c4-p2g2-terminal-pending-originals 0
                               pending-originals-next)
                  (vector-set! pending 17 #f)
                  (vector-set! pending 18 #f)
                  (vector-set! pending 0 'dead)
                  (vector-set! ledger 3 'p2g2-terminal-committed)
                  (vector-set! ledger 4 #f)
                  (vector-set! model-entry 10 #f)
                  (vector-set! generator-entry 9 #f)
                  (g3c4-call-dead! call)
                  (vector-set! record 0 #f)
                  (vector-set! protected-anchor 0 #f)
                  (vector-set! g3c4-p2g2-protected-records 0
                               protected-records-next)
                  (vector-set! g3c4-p2g2-protected-anchors 0
                               protected-anchors-next)
                  (vector-set! g3c4-p2g2-prefix-input-anchors 0 prefix-next)
                  shell)
                (g3c4-native-check status operation))))))))

      ))
      (set! g3c4-p2g2-terminal-enrollment-route-private
        (lambda (stage roots)
          (if (or installed? (not (procedure? stage))
                  (not (vector? roots)) (not (= (vector-length roots) 7)))
              (exit 134))
          ;; Consume before returning the route, including on malformed roots.
          (set! installed? #t)
          (let ((original-stage stage)
                (original-roots
                  (vector (vector-ref roots 0) (vector-ref roots 1)
                          (vector-ref roots 2) (vector-ref roots 3)
                          (vector-ref roots 4) (vector-ref roots 5)
                          (vector-ref roots 6))))
            (let check ((index 0))
              (if (< index 7)
                  (let ((root (vector-ref original-roots index)))
                    (if (not (and (vector? root) (= (vector-length root) 1)))
                        (exit 134))
                    (let distinct ((other 0))
                      (if (< other index)
                          (if (eq? root (vector-ref original-roots other))
                              (exit 134)
                              (distinct (+ other 1)))))
                    (check (+ index 1)))))
            (lambda (generator input ticket)
              (let* ((heads
                      (vector (vector-ref (vector-ref original-roots 0) 0)
                              (vector-ref (vector-ref original-roots 1) 0)
                              (vector-ref (vector-ref original-roots 2) 0)
                              (vector-ref (vector-ref original-roots 3) 0)
                              (vector-ref (vector-ref original-roots 4) 0)
                              (vector-ref (vector-ref original-roots 5) 0)
                              (vector-ref (vector-ref original-roots 6) 0)))
                     (row-node (generator-node (vector-ref original-roots 4) generator))
                     (anchor-node (generator-node (vector-ref original-roots 5) generator))
                     (binding-node (generator-node (vector-ref original-roots 6) generator))
                     (row (car row-node)) (anchor (car anchor-node)) (binding (car binding-node)))
                (if (not (and (vector? ticket) (= (vector-length ticket) 21)
                              (eq? row (vector-ref ticket 3))
                              (= (vector-length row) 8) (= (vector-length anchor) 8)
                              (= (vector-length binding) 2) (procedure? (vector-ref binding 1))
                              (not (eq? row anchor)) (not (eq? row binding))
                              (not (eq? anchor binding))))
                    (g3c4-fail 'invalid-state 'g3c4-p2g2-terminal-commit-private!
                               "terminal generator provenance carriers changed"))
                (let ((proof
                        (vector row-node anchor-node binding-node row anchor binding
                          (vector (vector-ref row 0) (vector-ref row 1) (vector-ref row 2)
                                  (vector-ref row 3) (vector-ref row 4) (vector-ref row 5)
                                  (vector-ref row 6) (vector-ref row 7))
                          (vector (vector-ref anchor 0) (vector-ref anchor 1) (vector-ref anchor 2)
                                  (vector-ref anchor 3) (vector-ref anchor 4) (vector-ref anchor 5)
                                  (vector-ref anchor 6) (vector-ref anchor 7))
                          (vector (vector-ref binding 0) (vector-ref binding 1))
                          (cdr row-node) (cdr anchor-node) (cdr binding-node))))
                  (core generator input
                        (vector ticket original-stage original-roots heads proof))))))))
      (lambda (generator input) (core generator input #f))))))
