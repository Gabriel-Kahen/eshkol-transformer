(define (loop n total)
  (if (= n 0)
      total
      (let ((v (reshape #(1.0 2.0 3.0 4.0) 2 2)))
        (loop (- n 1) (+ total (tensor-get v 0 0))))))
(display (if (= (loop 100000 0.0) 100000.0) "PASS bounded long loop" "FAIL bounded long loop"))
(newline)
(display "R0_DONE memory_loop") (newline)
