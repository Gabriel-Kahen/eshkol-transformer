;;; Actual fixture definitions and byte/typed comparators, explicit host doubles.
;;; No model arithmetic, genuine native count, compiler or runtime claim.
(use-modules (rnrs bytevectors) (rnrs exceptions))
(define (select-definitions path names)
  (call-with-input-file path
    (lambda (port)
      (let read-forms ()
        (let ((form (read port)))
          (if (not (eof-object? form))
              (begin
                (if (and (pair? form) (eq? (car form) 'define)
                         (or (not names) (memq (if (pair? (cadr form)) (caadr form) (cadr form)) names)))
                    (eval form (current-module)))
                (read-forms))))))))
(select-definitions "internal/d2/lib/d2_semantic_core.esk" '(d2-core-bytes=?))
(select-definitions "tests/cpu4_resume/body.esk" '(cpu4-resume-values=? cpu4-resume-plane-size))
(select-definitions "native/g3c4_public_g2_result_extension.esk" '(g3c4-public-g2-word))
(select-definitions "tests/cpu4_trained_g2/generation.esk" #f)
(define (bytevector . items) (u8-list->bytevector items))
(define checks 0)
(define (check good) (if (not good) (error "trained G2 host check failed" checks)) (set! checks (+ checks 1)))
(define (reject thunk) (catch #t (lambda () (thunk) #f) (lambda args #t)))
(define events '())
(define failure #f)
(define (event name)
  (set! events (append events (list name)))
  (if (eq? name failure) (error "explicit host injected failure" name)))
(define (cpu4-binding-fail category operation message) (error message category operation))
(define (cpu4-checkpoint-native-current-region) '())
(define model (vector 'same-trained-B))
(define model-entry (vector #f #f #f #f #f #f #f #f))
(define generation-t1 (vector 'genuine-T1-double))
(define tokenizer (vector 'retained-T2))
(define g3c4-model-shapes (make-vector 14 '(1)))
(define handles (make-vector 14 #f))
(define values (make-vector 14 #f))
(let init ((i 0))
  (if (< i 14) (begin (vector-set! handles i (vector i))
                      (vector-set! values i (u8-list->bytevector (list i 0 0 0))) (init (+ i 1)))))
(define counts #f)
(define variant #f)
(define expected-values #f)
(define child #f)
(define factory #f)
(define record #f)
(define handoff-row #f)
(define current-mode #f)
(define (reset mode)
  (set! variant #f)
  (set! expected-values (make-vector 14 #f))
  (let copy-expected ((i 0))
    (if (< i 14) (begin (vector-set! expected-values i (bytevector-copy (vector-ref values i))) (copy-expected (+ i 1)))))
  (set! current-mode mode) (set! failure #f) (set! events '())
  (set! cpu4-trained-g2-checks 0)
  (set! counts (vector 0 2 0 56 112 28))
  (set! child (make-vector 14 #f)) (vector-set! child 13 handles)
  (set! factory (make-vector 19 #f)) (vector-set! factory 2 'exact-factory-ticket) (vector-set! factory 14 'exact-child)
  (set! record (make-vector 22 #f)) (vector-set! record 8 model) (vector-set! record 15 'train-b)
  (set! handoff-row (make-vector 24 #f)) (vector-set! handoff-row 7 model-entry))
(define (cpu4-trained-g2-count index) (vector-ref counts index))
(define (cpu4-owned-row token operation) (check (eq? token 'exact-child)) child)
(define (cpu4-owned-model-internal token) model)
(define (heldout-modes record) (make-vector 17 'train))
(define (t2-wave2-tokenizer-vocab-size value) (check (eq? value tokenizer)) 256)
(define (t1-wave1-tokenizer-byte resolved) (event 'T1-create) generation-t1)
(define (t1-wave1-tokenizer-encode t1 bytes)
  (check (eq? t1 generation-t1)) (check (equal? (bytevector->u8-list bytes) '(3 197)))
  (event 'T1-encode) 'sealed-encoding)
(define (g3c4-public-generation-input-create encoded) (check (eq? encoded 'sealed-encoding)) (event 'input-create) 'input)
(define (parameter-handle-tensor-identity-internal handle) handle)
(define (i2-checkpoint-encode descriptor) (vector-ref values (vector-ref (vector-ref descriptor 0) 0)))
(define (cpu4-checkpoint-factory-generator-handoff-internal! ticket t1 config recovery)
  (check (eq? ticket 'exact-factory-ticket)) (check (eq? t1 generation-t1))
  (check (equal? config (cpu4-trained-g2-config current-mode)))
  (event 'handoff-before)
  (vector-set! recovery 0 'exact-recovery)
  (event 'handoff-after)
  (set! counts (vector 0 1 0 28 84 28))
  (vector-set! handoff-row 3 'adopted)
  (if (eq? variant 'handles) (vector-set! handles 0 (vector 0)))
  (if (eq? variant 'values) (bytevector-u8-set! (vector-ref values 0) 0 99))
  (if (eq? variant 'counts) (vector-set! counts 3 29))
  (vector (if (eq? variant 'model) (vector 'substitute) model) 'generator))
(define (cpu4-handoff-row ticket operation) (check (eq? ticket 'exact-recovery)) handoff-row)
(define (g3c4-generator-entry-call-ready generator operation)
  (check (eq? generator 'generator)) (vector #f #f #f #f #f model-entry (if (eq? variant 'T1) (vector 'other-T1) generation-t1)))
(define (g3c4-public-g2-profile-live generator operation) #t)
(define (g3g-public-generator-generate generator input)
  (check (eq? generator 'generator)) (check (eq? input 'input)) (event 'generate) 'output)
(define (g3g-public-generation-output-ids output) (event 'ids) '(ids))
(define (g3g-public-generation-output-lengths output) (event 'lengths) 'lengths)
(define (g3g-public-generation-output-cache-lengths output) (event 'cache) 'cache)
(define (g3g-public-generation-output-text output)
  (event 'text) (list (u8-list->bytevector (if (eq? variant 'text) '(4 41) (if (eq? current-mode 'first-eos) '(3) '(3 41))))))
(define (g3g-public-generation-output-rng output) (event 'rng) 'rng)
(define (native-words words)
  (let ((bytes (make-bytevector (* 8 (length words)) 0)))
    (let put ((tail words) (index 0))
      (if (null? tail) bytes
          (begin (bytevector-u64-set! bytes index (car tail) (endianness little)) (put (cdr tail) (+ index 8)))))))
(define (g3c4-p2g2-typed-copy-private shell)
  (native-words (cond ((eq? shell 'ids) (if (eq? variant 'IDs) '(3 40) (if (eq? current-mode 'first-eos) '(3) '(3 41))))
                     ((eq? shell 'lengths) (list (if (eq? variant 'length) 0 (if (eq? current-mode 'first-eos) 1 2))))
                     (else (list (if (eq? variant 'cache) 0 (if (eq? current-mode 'first-eos) 3 4)))))))
(define (g3c4-public-g2-source-snapshot output operation)
  (vector 3 41 (if (eq? current-mode 'first-eos) 1 2) #f 1 41 0 0))
(define (g3c4-registry-find shell operation)
  (let ((entry (make-vector 8 #f))) (vector-set! entry 7 (vector 'algorithm 1 (if (eq? variant 'RNG) 42 41) 0 0)) entry))
(define (g3g-public-generation-output-release output) (event 'output-release) #t)
(define (g3g-public-generation-tensor-release shell) (event (case shell ((ids) 'ids-release) ((lengths) 'lengths-release) ((cache) 'cache-release) (else 'input-release))) #t)
(define (g3g-public-generation-rng-release rng) (event 'rng-release) #t)
(define (g3g-public-generator-close generator) (event 'generator-close) #t)
(define (g3c4-model-entry-live model operation ignored) model-entry)
(define (cpu4-d2-cursor-capture-internal dataset) (vector dataset))
(define (cpu4-resume-cleanup! ledger) (event 'old-cleanup) (set! counts (vector 0 0 0 0 28 14)))
(define (run-generation generation)
  (cpu4-trained-g2-generate! 'resolved tokenizer 'train-a 'train-b 'heldout factory record (vector expected-values) generation))
(for-each
 (lambda (mode)
   (reset mode)
   (let ((generation (cpu4-trained-g2-ledger mode)))
     (check (eq? (vector-ref generation 0) 'training))
     (check (not (vector-ref (vector-ref generation 1) 0)))
     (run-generation generation)
     (check (eq? (vector-ref generation 13) model))
     (check (eq? (vector-ref generation 3) 'sealed-encoding))
     (check (equal? (list-tail events 11)
       '(output-release ids-release lengths-release cache-release rng-release input-release generator-close)))
     (cpu4-resume-cleanup! #f)
     (cpu4-trained-g2-finish! generation tokenizer 'train-a 'train-b 'heldout (vector expected-values))
     (check (= cpu4-trained-g2-checks 19))
     (check (= (length (filter (lambda (e) (eq? e 'handoff-before)) events)) 1))
     (check (= (length (filter (lambda (e) (eq? e 'generate)) events)) 1))))
 '(two-token first-eos second-eos))
;;; Every enrollment/release boundary can fail without forced old cleanup or
;;; losing the already-rooted exact recovery/model/input/created output shell.
(for-each
 (lambda (point)
   (reset 'two-token) (set! failure point)
   (let ((generation (cpu4-trained-g2-ledger 'two-token)))
     (check (reject (lambda () (run-generation generation))))
     (let ((ticket (vector-ref (vector-ref generation 1) 0))
           (input (vector-ref generation 4)) (pair (vector-ref generation 5)))
       (cpu4-trained-g2-failure-cleanup! #f generation)
       (check (not (memq 'old-cleanup events)))
       (check (eq? ticket (vector-ref (vector-ref generation 1) 0)))
       (check (eq? input (vector-ref generation 4)))
       (check (eq? pair (vector-ref generation 5)))
       (check (eq? (vector-ref generation 13) model))
       (if (not (eq? point 'handoff-before)) (check (eq? ticket 'exact-recovery))))))
 '(handoff-before handoff-after generate ids lengths cache text rng output-release ids-release lengths-release cache-release rng-release input-release generator-close))
(for-each
 (lambda (bad)
   (reset 'two-token) (set! variant bad)
   (let ((generation (cpu4-trained-g2-ledger 'two-token))
         (old-handle (vector-ref handles 0)) (old-byte (bytevector-u8-ref (vector-ref values 0) 0)))
     (check (reject (lambda () (run-generation generation))))
     (check (eq? (vector-ref (vector-ref generation 1) 0) 'exact-recovery))
     (cpu4-trained-g2-failure-cleanup! #f generation)
     (check (not (memq 'old-cleanup events)))
     (vector-set! handles 0 old-handle)
     (bytevector-u8-set! (vector-ref values 0) 0 old-byte)))
 '(model T1 handles values counts IDs length cache text RNG))
(reset 'two-token)
(cpu4-trained-g2-failure-cleanup! #f (cpu4-trained-g2-ledger 'two-token))
(check (equal? events '(old-cleanup)))
(check (reject (lambda () (cpu4-trained-g2-mode 'unknown))))
(check (equal? (cpu4-trained-g2-config 'second-eos)
  (list ':profile 'diagnostic-c4-p2g2 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256 ':top-p-bits 1065353216
        ':max-new-tokens 2 ':eos 41 ':seed 41)))
;;; B250 helper host checks use the real 14-plane byte comparator and explicit
;;; C2 doubles. They test ordering and cleanup, not native FILE execution.
(define b250-planes (make-vector 14 #f))
(let fill ((i 0))
  (if (< i 14)
      (begin (vector-set! b250-planes i (make-bytevector (if (= i 0) 4716 4) i))
             (fill (+ i 1)))))
(define decoded-b250-planes #f)
(define (b250-copy)
  (let ((copy (make-vector 14 #f)))
    (let loop ((i 0))
      (if (< i 14)
          (begin (vector-set! copy i (bytevector-copy (vector-ref b250-planes i)))
                 (loop (+ i 1)))))
    copy))
(define (cpu4-trainer-snapshot-internal trainer image-cell)
  (check (eq? trainer 'final-B-trainer)) (check (not (vector-ref image-cell 0)))
  (event 'B250-snapshot) (vector-set! image-cell 0 'B250-snapshot-image))
(define (cpu4-resume-capture image)
  (event (if (eq? image 'B250-snapshot-image) 'B250-capture 'B250-decode))
  (vector (if (eq? image 'B250-snapshot-image) (b250-copy) decoded-b250-planes)))
(define (c2-public-checkpoint-save! image path policy options)
  (check (and (eq? image 'B250-snapshot-image) (string=? path "/B250.c2")
              (equal? options '(:overwrite? #f))))
  (event 'B250-save))
(define (c2-training-state-release-internal! image operation)
  (event (if (eq? image 'B250-snapshot-image) 'B250-snapshot-release
             'B250-decoded-release)) #t)
(define (c2-checkpoint-load-stage-internal path policy)
  (check (string=? path "/B250.c2")) (event 'B250-stage) 'B250-stage-owner)
(define (c2-checkpoint-load-capability-descriptors-internal stage operation)
  (check (eq? stage 'B250-stage-owner)) (event 'B250-descriptors) 'B250-descriptors)
(define (c2-public-capability-admit-all report descriptors)
  (check (and (eq? report 'B250-report) (eq? descriptors 'B250-descriptors)))
  (event 'B250-capability))
(define (c2-checkpoint-load-reconstruct-internal stage operation)
  (check (eq? stage 'B250-stage-owner)) (event 'B250-reconstruct) 'B250-loaded-image)
(define (c2-checkpoint-load-staging-release-internal! stage)
  (check (eq? stage 'B250-stage-owner)) (event 'B250-stage-release) #t)
(define (cpu4-binding-fail-stop status) (error "fail-stop" status))
(set! decoded-b250-planes (b250-copy)) (set! events '()) (set! failure #f)
(let ((image-cell (vector #f)))
  (check (cpu4-trained-g2-save-b250! 'final-B-trainer (vector b250-planes)
           "/B250.c2" 'B250-policy 'B250-report image-cell))
  (check (not (vector-ref image-cell 0)))
  (check (equal? events '(B250-snapshot B250-capture B250-save
      B250-snapshot-release B250-stage B250-descriptors B250-capability
      B250-reconstruct B250-decode B250-decoded-release B250-stage-release))))
(set! decoded-b250-planes (b250-copy))
(bytevector-u8-set! (vector-ref decoded-b250-planes 13) 0 99)
(set! events '())
(check (reject (lambda () (cpu4-trained-g2-save-b250! 'final-B-trainer
  (vector b250-planes) "/B250.c2" 'B250-policy 'B250-report (vector #f)))))
(check (equal? (list-tail events (- (length events) 2))
               '(B250-decoded-release B250-stage-release)))
(display "CPU4 trained G2 actual fixture helpers with explicit doubles PASS: checks=") (display checks) (newline)
