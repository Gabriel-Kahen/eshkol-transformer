(fixture-reset-shared-clone-internal!)
(let* ((owned-before (fixture-owned-live-count-internal))
       (release-before (fixture-release-call-count-internal))
       (native-before (p1-module-test-live-count))
       (base
         (fixture-tensor-internal
           '(2) 'i64 'cpu (vector 'storage-a 'storage-b)))
       (alias (fixture-storage-alias-wrapper-internal base))
       (disjoint
         (fixture-tensor-internal
           '(2) 'i64 'cpu (vector 'storage-a 'storage-b)))
       (zero-left
         (fixture-tensor-internal '(0) 'i64 'cpu (vector)))
       (zero-right
         (fixture-tensor-internal '(0) 'i64 'cpu (vector)))
       (zero-alias (fixture-storage-alias-wrapper-internal zero-left))
       (same-request
         (vector base base 'buffer 'buffer 'storage-identity-evidence))
       (alias-request
         (vector base alias 'buffer 'buffer 'storage-identity-evidence))
       (reverse-alias-request
         (vector alias base 'buffer 'buffer 'storage-identity-evidence))
       (disjoint-request
         (vector base disjoint 'buffer 'buffer 'storage-identity-evidence))
       (reverse-disjoint-request
         (vector disjoint base 'buffer 'buffer 'storage-identity-evidence))
       (zero-disjoint-request
         (vector zero-left zero-right 'buffer 'buffer
                 'storage-identity-evidence))
       (zero-alias-request
         (vector zero-left zero-alias 'buffer 'buffer
                 'storage-identity-evidence))
       (describe-before (fixture-describe-call-count-internal)))
  (check "storage identity is reflexive for the same carrier wrapper"
         (eq? #t
              (fixture-storage-identical-request-internal same-request)))
  (check "storage identity recognizes distinct wrappers of one allocation"
         (and (not (eq? base alias))
              (eq? #t
                   (fixture-storage-identical-request-internal
                     alias-request))))
  (check "storage identity is symmetric for shared storage"
         (eq? #t
              (fixture-storage-identical-request-internal
                reverse-alias-request)))
  (check "storage identity rejects equal-valued disjoint allocations"
         (and (not (eq? (vector-ref base 5) (vector-ref disjoint 5)))
              (eq? #f
                   (fixture-storage-identical-request-internal
                     disjoint-request))))
  (check "storage disjointness is symmetric"
         (eq? #f
              (fixture-storage-identical-request-internal
                reverse-disjoint-request)))
  (check "distinct zero-element tensor resources remain disjoint"
         (and (not (eq? (vector-ref zero-left 5)
                        (vector-ref zero-right 5)))
              (eq? #f
                   (fixture-storage-identical-request-internal
                     zero-disjoint-request))))
  (check "zero-element alias wrappers retain owning-resource identity"
         (and (not (eq? zero-left zero-alias))
              (eq? #t
                   (fixture-storage-identical-request-internal
                     zero-alias-request))))
  (check "storage identity returns exact booleans"
         (and (boolean?
                (fixture-storage-identical-request-internal alias-request))
              (boolean?
                (fixture-storage-identical-request-internal
                  disjoint-request))))
  (check "storage identity is stable across repeated preallocated requests"
         (let loop ((remaining 64))
           (if (= remaining 0)
               #t
               (and
                 (fixture-storage-identical-request-internal alias-request)
                 (not (fixture-storage-identical-request-internal
                        disjoint-request))
                 (loop (- remaining 1))))))
  (check "storage comparison leaves every request field unchanged"
         (and (eq? (vector-ref alias-request 0) base)
              (eq? (vector-ref alias-request 1) alias)
              (eq? (vector-ref alias-request 2) 'buffer)
              (eq? (vector-ref alias-request 3) 'buffer)
              (eq? (vector-ref alias-request 4)
                   'storage-identity-evidence)))
  (check "valid storage comparison invokes no allocating describe callback"
         (= describe-before (fixture-describe-call-count-internal)))
  (check "storage comparison allocates no provider/native owner"
         (and (= owned-before (fixture-owned-live-count-internal))
              (= release-before (fixture-release-call-count-internal))
              (= native-before (p1-module-test-live-count))))
  (check "storage comparison preserves shared and disjoint payloads"
         (and (equal? (fixture-tensor-payload-internal base)
                      (vector 'storage-a 'storage-b))
              (equal? (fixture-tensor-payload-internal alias)
                      (vector 'storage-a 'storage-b))
              (equal? (fixture-tensor-payload-internal disjoint)
                      (vector 'storage-a 'storage-b))))
  (let ((invalid-request (vector 'forged base 'buffer 'buffer
                                 'storage-identity-evidence))
        (invalid-kind (vector base disjoint 'wrong-kind 'buffer
                              'storage-identity-evidence)))
    (expect-error "storage comparison rejects malformed request shape"
                  'invalid-argument
                  (lambda ()
                    (fixture-storage-identical-request-internal (vector))))
    (expect-error "storage comparison rejects forged carrier before dereference"
                  'invalid-argument
                  (lambda ()
                    (fixture-storage-identical-request-internal
                      invalid-request)))
    (expect-error "storage comparison rejects kind confusion before dereference"
                  'invalid-argument
                  (lambda ()
                    (fixture-storage-identical-request-internal invalid-kind)))
    (check "invalid storage inputs invoke no nested callback/native allocation"
           (and (= owned-before (fixture-owned-live-count-internal))
                (= release-before (fixture-release-call-count-internal))
                (= native-before (p1-module-test-live-count))))))

