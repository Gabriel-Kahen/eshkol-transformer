;;; E3-owned D2 cursor restoration and fixed staging consumers.  This source
;;; is loaded after the generated D2 dataset implementation in the one private
;;; aggregate; it adds no D2 registry or public carrier.

(extern i64 e3-d2-native-idle ptr
        :real et_e3_d2_dataset_idle_preflight_v1)
(extern i64 e3-native-stage-inputs ptr ptr
        :real et_e3_private_stage_inputs_v1)
(extern i64 e3-native-stage-targets ptr ptr
        :real et_e3_private_stage_targets_v1)
(extern i64 e3-native-stage-mask ptr ptr
        :real et_e3_private_stage_mask_v1)

(define (e3-d2-record frame)
  (let ((record (e3-frame-d2-record-internal frame)))
    (if (not (and (vector? record) (= (vector-length record) 14)
                  (eq? (vector-ref record 0) e3-d2-restore-tag)
                  (eq? (vector-ref record 1) record)
                  (eq? (vector-ref record 2) frame)
                  (vector? (vector-ref record 12))
                  (= (vector-length (vector-ref record 12)) 15)))
        (let ((unreachable
               (et-e1b-private-raise 'internal 'e3-evaluate-into!
                                     "E3 D2 restore authority is malformed" '() #f)))
          unreachable))
    record))

(define (e3-d2-idle-status! owner)
  (let ((status (e3-d2-native-idle owner)))
    (if (not (= status (d2-native-last-status)))
        (let ((unreachable
               (et-e1b-private-raise 'internal 'e3-evaluate-into!
                                     "D2 idle diagnostics diverged" '() #f)))
          unreachable))
    (if (not (= status 0))
        (let ((unreachable
               (et-e1b-private-raise
                (e3-error-category-from-d2-idle status) 'e3-evaluate-into!
                "D2 dataset is not idle" '() #f)))
          unreachable))
    #t))

(define (e3-d2-source-idle? state)
  (and (or (eq? (vector-ref state 10) 'none)
           (eq? (vector-ref state 10) 'released))
       (= (vector-ref state 15) 0)))

(define (e3-d2-clear-record! record)
  (let ((snapshot (vector-ref record 12)))
    (vector-set! snapshot 0 #f)
    (vector-set! snapshot 1 #f)
    (vector-set! snapshot 2 #f)
    (vector-set! snapshot 3 #f)
    (vector-set! snapshot 4 #f)
    (vector-set! snapshot 5 #f)
    (vector-set! snapshot 6 #f)
    (vector-set! snapshot 7 #f)
    (vector-set! snapshot 8 #f)
    (vector-set! snapshot 9 #f)
    (vector-set! snapshot 10 #f)
    (vector-set! snapshot 11 #f)
    (vector-set! snapshot 12 #f)
    (vector-set! snapshot 13 #f)
    (vector-set! snapshot 14 #f))
  (vector-set! record 4 #f)
  (vector-set! record 5 #f)
  (vector-set! record 6 #f)
  (vector-set! record 7 0)
  (vector-set! record 8 0)
  (vector-set! record 9 #f)
  (vector-set! record 10 #f)
  (vector-set! record 11 #f)
  (vector-set! record 13 0)
  (vector-set! record 3 'idle)
  #t)

(define (e3-d2-snapshot-fill! snapshot core)
  (vector-set! snapshot 0 (vector-ref core 0))
  (vector-set! snapshot 1 (vector-ref core 1))
  (vector-set! snapshot 2 (vector-ref core 2))
  (vector-set! snapshot 3 (vector-ref core 3))
  (vector-set! snapshot 4 (vector-ref core 4))
  (vector-set! snapshot 5 (vector-ref core 5))
  (vector-set! snapshot 6 (vector-ref core 6))
  (vector-set! snapshot 7 (vector-ref core 7))
  (vector-set! snapshot 8 (vector-ref core 8))
  (vector-set! snapshot 9 (vector-ref core 9))
  (vector-set! snapshot 10 (vector-ref core 10))
  (vector-set! snapshot 11 (vector-ref core 11))
  (vector-set! snapshot 12 (vector-ref core 12))
  (vector-set! snapshot 13 (vector-ref core 13))
  (vector-set! snapshot 14 (vector-ref core 14))
  #t)

(define (e3-d2-snapshot-matches? snapshot core)
  (and (eq? (vector-ref snapshot 0) (vector-ref core 0))
       (eq? (vector-ref snapshot 1) (vector-ref core 1))
       (eq? (vector-ref snapshot 2) (vector-ref core 2))
       (eq? (vector-ref snapshot 3) (vector-ref core 3))
       (eq? (vector-ref snapshot 4) (vector-ref core 4))
       (eq? (vector-ref snapshot 5) (vector-ref core 5))
       (eq? (vector-ref snapshot 6) (vector-ref core 6))
       (eq? (vector-ref snapshot 7) (vector-ref core 7))
       (eq? (vector-ref snapshot 8) (vector-ref core 8))
       (eq? (vector-ref snapshot 9) (vector-ref core 9))
       (eq? (vector-ref snapshot 10) (vector-ref core 10))
       (eq? (vector-ref snapshot 11) (vector-ref core 11))
       (eq? (vector-ref snapshot 12) (vector-ref core 12))
       (eq? (vector-ref snapshot 13) (vector-ref core 13))
       (eq? (vector-ref snapshot 14) (vector-ref core 14))))

(define (e3-d2-prepare! frame dataset)
  (let* ((record (e3-d2-record frame))
         (state (d2-open-dataset-state dataset 'e3-evaluate-into!))
         (config (vector-ref state 3))
         (metadata (vector-ref state 4))
         (manifest (vector-ref state 5))
         (core (vector-ref state 6)))
    (if (not (eq? (vector-ref record 3) 'idle))
        (let ((unreachable
               (et-e1b-private-raise 'invalid-state 'e3-evaluate-into!
                                     "E3 D2 restore record is busy" '() #f)))
          unreachable))
    (if (not (e3-d2-source-idle? state))
        (let ((unreachable
               (et-e1b-private-raise 'invalid-state 'e3-evaluate-into!
                                     "D2 dataset owns a live batch or borrow" '() #f)))
          unreachable))
    (e3-d2-idle-status! (vector-ref state 1))
    (if (not (and (vector? core) (= (vector-length core) 17)
                  (eq? (vector-ref core 0) 'd2-dataset-state)
                  (= (vector-ref config 2) 1)
                  (= (vector-ref config 3) 2)
                  (eq? (vector-ref config 8) #f)
                  (= (vector-ref config 9) 1)
                  (boolean? (vector-ref config 10))
                  (= (vector-ref core 3) 256)
                  (= (vector-ref core 4) 1)
                  (= (vector-ref core 5) 2)
                  (eq? (vector-ref core 10) #f)
                  (= (vector-ref core 11) 1)
                  (eq? (vector-ref core 12) (vector-ref config 10))
                  (= (vector-ref core 14) (vector-ref state 17))
                  (>= (vector-ref core 15) 0)
                  (<= (vector-ref core 15) (vector-ref core 14))
                  (string=? (vector-ref core 2) (vector-ref metadata 4))
                  (= (vector-ref core 3) (vector-ref metadata 2))))
        (let ((unreachable
               (et-e1b-private-raise 'unsupported 'e3-evaluate-into!
                                     "D2 dataset does not match the E3 profile" '() #f)))
          unreachable))
    (let ((remaining (- (vector-ref core 14) (vector-ref core 15))))
      (if (or (> remaining 8192) (> (* remaining 2) 16384))
          (let ((unreachable
                 (et-e1b-private-raise 'unsupported 'e3-evaluate-into!
                                       "D2 dataset exceeds E3 traversal bounds" '() #f)))
            unreachable)))
    ;; All validation and possible allocation precede the prepared publication.
    (vector-set! record 4 dataset)
    (vector-set! record 5 state)
    (vector-set! record 6 core)
    (vector-set! record 7 (vector-ref core 15))
    (vector-set! record 8 (vector-ref core 14))
    (vector-set! record 9 config)
    (vector-set! record 10 metadata)
    (vector-set! record 11 manifest)
    (e3-d2-snapshot-fill! (vector-ref record 12) core)
    (vector-set! record 13 (vector-ref state 8))
    (vector-set! record 3 'prepared)
    #t))

(define (e3-d2-restore-preflight! frame)
  (let* ((record (e3-d2-record frame))
         (dataset (vector-ref record 4))
         (state (vector-ref record 5))
         (core (vector-ref record 6)))
    (if (not (and (eq? (vector-ref record 3) 'prepared)
                  (procedure? dataset)
                  (vector? state) (= (vector-length state) 19)
                  (eq? (dataset d2-dataset-query) state)
                  (eq? (vector-ref state 1) dataset)
                  (vector-ref state 2)
                  (eq? (vector-ref state 3) (vector-ref record 9))
                  (eq? (vector-ref state 4) (vector-ref record 10))
                  (eq? (vector-ref state 5) (vector-ref record 11))
                  (eq? (vector-ref state 6) core)
                  (e3-d2-snapshot-matches? (vector-ref record 12) core)
                  (= (vector-ref core 14) (vector-ref record 8))
                  (>= (vector-ref record 7) 0)
                  (<= (vector-ref record 7) (vector-ref record 8))
                  (>= (vector-ref core 15) 0)
                  (<= (vector-ref core 15) (vector-ref record 8))
                  (>= (vector-ref state 8) (vector-ref record 13))
                  (e3-d2-source-idle? state)
                  (= (e3-d2-native-idle dataset) 0)))
        (e3-native-invariant-fail))
    (vector-set! record 3 'restore-ready)
    #t))

(define (e3-d2-restore-commit! frame)
  (let* ((record (e3-d2-record frame))
         (state (vector-ref record 5))
         (core (vector-ref record 6)))
    (if (not (eq? (vector-ref record 3) 'restore-ready))
        (e3-native-invariant-fail))
    (vector-set! core 15 (vector-ref record 7))
    (vector-set! state 10 'none)
    (vector-set! state 16 #f)
    (let ((result (e3-d2-clear-record! record))) result)))

(define (e3-d2-cancel-prepare! frame)
  (let* ((record (e3-d2-record frame))
         (dataset (vector-ref record 4))
         (state (vector-ref record 5))
         (core (vector-ref record 6)))
    (if (not (and (eq? (vector-ref record 3) 'prepared)
                  (eq? (dataset d2-dataset-query) state)
                  (eq? (vector-ref state 6) core)
                  (= (vector-ref core 15) (vector-ref record 7))
                  (e3-d2-source-idle? state)
                  (= (e3-d2-native-idle dataset) 0)))
        (e3-native-invariant-fail))
    (let ((result (e3-d2-clear-record! record))) result)))

(define (e3-d2-inputs-consumer frame view)
  (let* ((entry (e3-frame-entry-internal frame))
         (status (e3-native-stage-inputs (vector-ref entry 4) view)))
    (if (= status 0) #t
        (let ((result (e3-note-native-error! entry 6))) result))))
(define (e3-d2-targets-consumer frame view)
  (let* ((entry (e3-frame-entry-internal frame))
         (status (e3-native-stage-targets (vector-ref entry 4) view)))
    (if (= status 0) #t
        (let ((result (e3-note-native-error! entry 6))) result))))
(define (e3-d2-mask-consumer frame view)
  (let* ((entry (e3-frame-entry-internal frame))
         (status (e3-native-stage-mask (vector-ref entry 4) view)))
    (if (= status 0) #t
        (let ((result (e3-note-native-error! entry 6))) result))))

(define (e3-stage-batch! frame batch)
  (let* ((record (e3-d2-record frame))
         (capability
          (d2-current-capability batch 'batch 'e3-evaluate-into!))
         (state (vector-ref record 5)))
    (if (not (and (eq? (vector-ref record 3) 'prepared)
                  (eq? (vector-ref capability 1) (vector-ref record 4))
                  (= (vector-ref capability 2) (vector-ref state 8))))
        (let ((unreachable
               (et-e1b-private-raise 'invalid-state 'e3-evaluate-into!
                                     "D2 batch does not belong to this E3 frame" '() #f)))
          unreachable))
    (and
     (d2-token-tensor-with-view-internal
      (vector-ref capability 5)
      (lambda (view) (e3-d2-inputs-consumer frame view)))
     (d2-token-tensor-with-view-internal
      (vector-ref capability 6)
      (lambda (view) (e3-d2-targets-consumer frame view)))
     (let ((result
            (d2-token-tensor-with-view-internal
             (vector-ref capability 7)
             (lambda (view) (e3-d2-mask-consumer frame view)))))
       result))))

(define (e3-d2-release-owned! frame owned-cell)
  (if (not (vector-ref owned-cell 2)) #t
      (let* ((entry (e3-frame-entry-internal frame))
             (record (e3-d2-record frame))
             (dataset (vector-ref record 4))
             (state (vector-ref record 5))
             (generation (vector-ref owned-cell 1)))
        (if (not (and (vector? owned-cell) (= (vector-length owned-cell) 4)
                      (pair? (vector-ref owned-cell 3))
                      (null? (cdr (vector-ref owned-cell 3)))
                      (eq? (vector-ref record 3) 'prepared)
                      (eq? (dataset d2-dataset-query) state)
                      (= (vector-ref state 8) generation)
                      (eq? (vector-ref state 10) 'live)
                      (= (vector-ref state 15) 0)
                      (e3-entry-bit? entry 32)))
            (e3-native-invariant-fail))
        (if (not (= (d2-native-batch-release-preflight dataset generation) 0))
            (e3-native-invariant-fail))
        (vector-set! state 10 'released)
        (if (not (= (d2-native-batch-release dataset generation) 0))
            (e3-native-invariant-fail))
        (vector-set! owned-cell 0 #f)
        (vector-set! owned-cell 1 0)
        (vector-set! owned-cell 2 #f)
        (e3-entry-bit-clear! entry 32)
        #t)))
