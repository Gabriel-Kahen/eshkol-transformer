(require transformer.checkpoint_internal)
(require transformer.error_internal)
(require p1_test.tensor_provider)
(require c1_test.checkpoint_codec)

(extern i64 c1-p1-test-live-count
        :real et_p1_test_live_entry_count_v1)
(extern i64 c1-p1-test-tombstone-count
        :real et_p1_test_tombstone_count_v1)
(extern i64 c1-test-native-atomic-write ptr ptr i64 i64
        :real et_checkpoint_io_atomic_write_v1)

(define checks 0)

(define (check label condition)
  (if condition
      (set! checks (+ checks 1))
      (begin
        (display "C1 FAIL: ") (display label) (newline) (exit 1))))

(define (expect-error label category thunk)
  (let ((caught (guard (error (#t error)) (thunk) #f)))
    (check (string-append label " structured") (transformer-error? caught))
    (check (string-append label " category")
           (and (transformer-error? caught)
                (eq? category (transformer-error-category caught))))
    caught))

(define (expect-raised-false label thunk)
  (let ((caught? #f))
    (guard (caught
             (#t
               (set! caught? (eq? caught #f))
               #f))
      (thunk))
    (check label caught?)))

(define (details-ref details key)
  (cond
    ((null? details) #f)
    ((eq? (car (car details)) key) (car (cdr (car details))))
    (else (details-ref (cdr details) key))))

(define (bytes=? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define (copy-bytes bytes)
  (bytevector-copy bytes 0 (bytevector-length bytes)))

(define (mutate bytes index value)
  (let ((result (copy-bytes bytes)))
    (bytevector-u8-set! result index value)
    result))

(define (append-byte bytes value)
  (let* ((size (bytevector-length bytes))
         (result (make-bytevector (+ size 1) 0)))
    (bytevector-copy! result 0 bytes 0 size)
    (bytevector-u8-set! result size value)
    result))

(define (list-count items)
  (let loop ((remaining items) (count 0))
    (if (null? remaining) count
        (loop (cdr remaining) (+ count 1)))))

(define c1-test-container-domain
  (bytevector 101 115 104 107 111 108 45 99 104 101 99 107 112 111 105 110
              116 45 99 111 110 116 97 105 110 101 114 45 118 49 0))
(define c1-test-tensor-domain
  (bytevector 101 115 104 107 111 108 45 99 104 101 99 107 112 111 105 110
              116 45 116 101 110 115 111 114 45 118 49 0))

(define (test-read-le bytes offset width)
  (let loop ((index (- width 1)) (result 0))
    (if (< index 0) result
        (loop (- index 1)
              (+ (* result 256) (bytevector-u8-ref bytes (+ offset index)))))))

(define (test-read-u32 bytes offset) (test-read-le bytes offset 4))
(define (test-read-u64 bytes offset) (test-read-le bytes offset 8))

(define (test-write-u32! bytes offset value)
  (let loop ((index 0) (remaining value))
    (if (< index 4)
        (begin
          (bytevector-u8-set! bytes (+ offset index) (modulo remaining 256))
          (loop (+ index 1) (quotient remaining 256))))))

(define (test-copy-into! destination offset source)
  (bytevector-copy! destination offset source 0 (bytevector-length source)))

(define (test-concat parts)
  (let size ((remaining parts) (total 0))
    (if (null? remaining)
        (let ((result (make-bytevector total 0)))
          (let fill ((items parts) (offset 0))
            (if (null? items) result
                (begin
                  (test-copy-into! result offset (car items))
                  (fill (cdr items)
                        (+ offset (bytevector-length (car items))))))))
        (size (cdr remaining)
              (+ total (bytevector-length (car remaining)))))))

(define (test-records-start bytes)
  (+ (test-read-u64 bytes 48) (test-read-u32 bytes 88)))

(define (test-record-offset-with-dtype bytes wanted-dtype)
  (let loop ((remaining (test-read-u32 bytes 80))
             (offset (test-records-start bytes)))
    (cond
      ((= remaining 0) #f)
      ((= wanted-dtype (bytevector-u8-ref bytes (+ offset 33))) offset)
      (else (loop (- remaining 1)
                  (+ offset (test-read-u64 bytes offset)))))))

(define (test-alias-offset bytes)
  (let loop ((remaining (test-read-u32 bytes 80))
             (offset (test-records-start bytes)))
    (if (= remaining 0) offset
        (loop (- remaining 1) (+ offset (test-read-u64 bytes offset))))))

(define (test-repair-tensor-checksum! bytes record-offset)
  (let* ((record-size (test-read-u64 bytes record-offset))
         (record (bytevector-copy bytes record-offset
                                  (+ record-offset record-size)))
         (relative (test-read-u64 bytes (+ record-offset 8)))
         (payload-size (test-read-u64 bytes (+ record-offset 16)))
         (payload-start (+ (test-read-u64 bytes 64) relative))
         (payload (bytevector-copy bytes payload-start
                                   (+ payload-start payload-size))))
    (let zero ((index 48))
      (if (< index 80)
          (begin
            (bytevector-u8-set! record index 0)
            (zero (+ index 1)))))
    (test-copy-into!
     bytes (+ record-offset 48)
     (c1-sha256 (test-concat (list c1-test-tensor-domain record payload))))))

(define (test-repair-whole-checksum! bytes)
  (let* ((unsigned-size (- (bytevector-length bytes) 32))
         (digest
          (c1-sha256
           (test-concat
            (list c1-test-container-domain
                  (bytevector-copy bytes 0 unsigned-size))))))
    (test-copy-into! bytes unsigned-size digest)))

(define (test-bool-semantic-corruption bytes)
  (let* ((result (copy-bytes bytes))
         (record-offset (test-record-offset-with-dtype result 1))
         (relative (test-read-u64 result (+ record-offset 8)))
         (payload-start (+ (test-read-u64 result 64) relative)))
    (bytevector-u8-set! result payload-start 2)
    (test-repair-tensor-checksum! result record-offset)
    (test-repair-whole-checksum! result)
    result))

(define (test-alias-duplicate-corruption bytes)
  (let* ((result (copy-bytes bytes))
         (alias-offset (test-alias-offset result))
         (first-member (test-read-u32 result (+ alias-offset 8))))
    (test-write-u32! result (+ alias-offset 12) first-member)
    (test-repair-whole-checksum! result)
    result))

(define (c1-test-tensor shape dtype values)
  (fixture-tensor-internal shape dtype 'cpu values))

(define (build-module seed)
  (let ((module (module-create-fixture-internal)))
    (module-register-buffer-internal!
     module "counter" (c1-test-tensor '(1) 'i64
                               (vector seed 0 0 0 0 0 0 0)))
    (let ((weight
           (module-register-parameter-internal!
            module "weight"
            (c1-test-tensor '(2) 'f32
                    (vector seed (+ seed 1) (+ seed 2) (+ seed 3)
                            (+ seed 4) (+ seed 5) (+ seed 6) (+ seed 7))))))
      (module-register-tied-parameter-internal! module "alias" weight))
    (module-register-buffer-internal!
     module "flags" (c1-test-tensor '(3) 'bool (vector 0 1 0)))
    module))

(define (build-schema-variant seed weight-shape counter-dtype counter-device
                              include-flags? tie-alias?)
  (let ((module (module-create-fixture-internal)))
    (module-register-buffer-internal!
     module "counter"
     (fixture-tensor-internal '(1) counter-dtype counter-device
                              (vector seed 0 0 0 0 0 0 0)))
    (let ((weight
           (module-register-parameter-internal!
            module "weight"
            (fixture-tensor-internal
             weight-shape 'f32 counter-device
             (if (equal? weight-shape '(2))
                 (vector seed (+ seed 1) (+ seed 2) (+ seed 3)
                         (+ seed 4) (+ seed 5) (+ seed 6) (+ seed 7))
                 (vector seed (+ seed 1) (+ seed 2) (+ seed 3)))))))
      (if tie-alias?
          (module-register-tied-parameter-internal! module "alias" weight)
          (module-register-parameter-internal!
           module "alias"
           (fixture-tensor-internal
            weight-shape 'f32 counter-device
            (if (equal? weight-shape '(2))
                (vector seed (+ seed 1) (+ seed 2) (+ seed 3)
                        (+ seed 4) (+ seed 5) (+ seed 6) (+ seed 7))
                (vector seed (+ seed 1) (+ seed 2) (+ seed 3)))))))
    (if include-flags?
        (module-register-buffer-internal!
         module "flags" (fixture-tensor-internal '(3) 'bool counter-device
                                                   (vector 0 1 0))))
    module))

(define (payload state path)
  (let* ((handle (state-dict-tensor state path))
         (active? #f))
    (guard (caught
             (#t
               (if active?
                   (begin
                     (set! active? #f)
                     (state-dict-tensor-borrow-end-internal state handle))
                   #t)
               (raise caught)))
      (let ((tensor
              (state-dict-tensor-borrow-begin-internal state handle)))
        (set! active? #t)
        (let ((result (fixture-tensor-payload-internal tensor)))
          (set! active? #f)
          (state-dict-tensor-borrow-end-internal state handle)
          result)))))

(define (module-payload module path)
  (let ((state (module-state-dict module)))
    (guard (caught
             (#t
               (state-dict-release! state)
               (raise caught)))
      (let ((result (payload state path)))
        (state-dict-release! state)
        result))))

(define (decode-request-to-fixture request)
  (let* ((bytes (vector-ref request 0))
         (shape (vector-ref request 2))
         (dtype (vector-ref request 3))
         (payload (make-vector (bytevector-length bytes) 0)))
    (let loop ((index 0))
      (if (= index (bytevector-length bytes))
          (fixture-owned-tensor-internal shape dtype 'cpu payload)
          (begin
            (vector-set! payload index (bytevector-u8-ref bytes index))
            (loop (+ index 1)))))))

(define (publish-decoded! request tensor)
  (vector-set! request 7 tensor)
  request)

(define policy
  (c1-persistence-policy-internal 1048576 524288 262144 64 'cpu))
(define source
  (guard (error
          (#t
           (display "C1 source error: ")
           (if (transformer-error? error)
               (begin (display (transformer-error-category error))
                      (display " ")
                      (display (transformer-error-operation error))
                      (display " ")
                      (display (transformer-error-message error)))
               (display error))
           (newline)
           (exit 2)))
    (build-module 11)))
(define persistent-state-owned-before (fixture-owned-live-count-internal))
(define source-state (module-state-dict source))
(define encoded-a
  (guard (error
          (#t
           (display "C1 setup error: ")
           (if (transformer-error? error)
               (begin (display (transformer-error-category error))
                      (display " ")
                      (display (transformer-error-message error)))
               (display error))
           (newline)
           (exit 2)))
    (c1-checkpoint-encode-state-internal source-state policy
                                         c1-fixture-codec-internal)))
(define encoded-b
  (c1-checkpoint-encode-state-internal source-state policy
                                       c1-fixture-codec-internal))

(check "sha256 abc known answer"
       (bytes=?
        (c1-sha256 (string->utf8 "abc"))
        (bytevector 186 120 22 191 143 1 207 234 65 65 64 222 93 174 34 35
                    176 3 97 163 150 23 122 156 180 16 255 97 242 0 21 173)))
(check "deterministic checkpoint bytes" (bytes=? encoded-a encoded-b))

(define metadata
  (guard (error
          (#t
           (display "C1 inspect error: ")
           (if (transformer-error? error)
               (begin (display (transformer-error-category error))
                      (display " ")
                      (display (transformer-error-operation error))
                      (display " ")
                      (display (transformer-error-message error)))
               (display error))
           (newline)
           (exit 2)))
    (c1-checkpoint-inspect-bytes-internal encoded-a policy)))
(check "inspect format"
       (eq? 'eshkol-checkpoint
            (c1-checkpoint-metadata-ref-internal metadata 'format-id)))
(check "inspect version"
       (equal? '(1 0)
               (c1-checkpoint-metadata-ref-internal metadata 'format-version)))
(check "inspect provider"
       (string=? "fixture-v1"
            (c1-checkpoint-metadata-ref-internal metadata 'provider-id)))
(define provider-read-a
  (c1-checkpoint-metadata-ref-internal metadata 'provider-id))
(define provider-read-b
  (c1-checkpoint-metadata-ref-internal metadata 'provider-id))
(check "metadata provider reads preserve value"
       (string=? provider-read-a provider-read-b))
(check "metadata provider reads are independently owned"
       (not (eq? provider-read-a provider-read-b)))
(check "inspect tensor count"
       (= 4 (c1-checkpoint-metadata-ref-internal metadata 'tensor-count)))

(define decoded
  (c1-checkpoint-decode-state-internal encoded-a policy
                                       c1-fixture-codec-internal 'fixture-v1))
(check "decoded lexical paths"
       (equal? '( ("alias") ("counter") ("flags") ("weight"))
               (state-dict-paths decoded)))
(check "decoded aliases"
       (equal? '(( ("alias") ("weight")))
               (state-dict-alias-groups decoded)))
(check "decoded tied payload equality"
       (equal? (payload decoded '("alias")) (payload decoded '("weight"))))
(let ((first (state-dict-tensor decoded '("weight")))
      (second (state-dict-tensor decoded '("weight"))))
  (check "repeated state tensor reads return one stable borrowed handle"
         (eq? first second)))
(check "decoded parameter payload"
       (equal? (vector 11 12 13 14 15 16 17 18)
               (payload decoded '("weight"))))
(check "decoded i64 payload"
       (equal? (vector 11 0 0 0 0 0 0 0)
               (payload decoded '("counter"))))
(check "decoded bool payload"
       (equal? (vector 0 1 0) (payload decoded '("flags"))))

(check "decoded state handle is independent of source state"
       (not (eq? (state-dict-tensor source-state '("weight"))
                 (state-dict-tensor decoded '("weight")))))

(define repeated-lifecycle-owned-before
  (fixture-owned-live-count-internal))
(define repeated-lifecycle-native-before (c1-p1-test-live-count))
(define repeated-lifecycle-cycles 0)
(define repeated-lifecycle-entry-total 0)
(define repeated-lifecycle-bytes-stable? #t)
(let repeat-lifecycle ((remaining 8))
  (if (= remaining 0)
      #t
      (let* ((cycle-bytes
               (c1-checkpoint-encode-state-internal
                 source-state policy c1-fixture-codec-internal))
             (cycle-state
               (c1-checkpoint-decode-state-internal
                 cycle-bytes policy c1-fixture-codec-internal 'fixture-v1))
             (cycle-entries (state-dict-entries-internal cycle-state))
             (cycle-round-trip
               (c1-checkpoint-encode-state-internal
                 cycle-state policy c1-fixture-codec-internal)))
        (set! repeated-lifecycle-cycles (+ repeated-lifecycle-cycles 1))
        (set! repeated-lifecycle-entry-total
              (+ repeated-lifecycle-entry-total (list-count cycle-entries)))
        (set! repeated-lifecycle-bytes-stable?
              (and repeated-lifecycle-bytes-stable?
                   (bytes=? cycle-bytes cycle-round-trip)))
        (state-dict-release! cycle-state)
        (state-dict-release! cycle-state)
        (repeat-lifecycle (- remaining 1)))))
(check "repeated encode/decode lifecycle completes eight cycles"
       (= repeated-lifecycle-cycles 8))
(check "repeated lifecycle enumerates every decoded entry shell"
       (= repeated-lifecycle-entry-total 32))
(check "repeated decoded state re-encoding is byte stable"
       repeated-lifecycle-bytes-stable?)
(check "repeated lifecycle restores provider-owned baseline"
       (= repeated-lifecycle-owned-before
          (fixture-owned-live-count-internal)))
(check "repeated lifecycle restores native live-count baseline"
       (= repeated-lifecycle-native-before (c1-p1-test-live-count)))

(define destination (build-module 90))
(define destination-tree (module-parameters destination))
(define destination-handle
  (parameter-tree-handle destination-tree '("weight")))
(define destination-identity
  (parameter-handle-tensor-identity-internal destination-handle))
(module-load-state-dict! destination decoded)
(check "module load preserves handle identity"
       (eq? destination-handle
            (parameter-tree-handle (module-parameters destination) '("weight"))))
(check "module load preserves tensor identity"
       (eq? destination-identity
            (parameter-handle-tensor-identity-internal destination-handle)))
(check "module load preserves tie identity"
       (eq? (parameter-tree-handle (module-parameters destination) '("alias"))
            (parameter-tree-handle (module-parameters destination) '("weight"))))
(check "module load restores exact value"
       (equal? (vector 11 12 13 14 15 16 17 18)
               (module-payload destination '("weight"))))

(define checkpoint-path "checkpoint.etcp")
(check "atomic save returns success"
       (c1-checkpoint-save-state-internal!
        source-state checkpoint-path policy c1-fixture-codec-internal #f))
(check "file inspect matches tensor count"
       (= 4 (c1-checkpoint-metadata-ref-internal
             (c1-checkpoint-inspect-internal checkpoint-path policy)
             'tensor-count)))
(define file-state
  (c1-checkpoint-load-state-internal
   checkpoint-path policy c1-fixture-codec-internal 'fixture-v1))
(check "file logical round trip"
       (equal? (payload source-state '("weight"))
               (payload file-state '("weight"))))
(define no-overwrite-error
  (expect-error "no-overwrite preserves destination" 'io
                (lambda ()
                  (c1-checkpoint-save-state-internal!
                   source-state checkpoint-path policy
                   c1-fixture-codec-internal #f))))
(check "no-overwrite reports not published"
       (eq? #f (details-ref (transformer-error-details no-overwrite-error)
                            'published?)))
(check "no-overwrite reports native stage"
       (integer? (details-ref (transformer-error-details no-overwrite-error)
                              'native-stage)))
(check "atomic overwrite returns success"
       (c1-checkpoint-save-state-internal!
        source-state checkpoint-path policy c1-fixture-codec-internal #t))
(define missing-file-error
  (expect-error "missing checkpoint file" 'io
                (lambda ()
                  (c1-checkpoint-load-state-internal
                   "missing-checkpoint.etcp" policy
                   c1-fixture-codec-internal 'fixture-v1))))
(check "non-native size failure has no fabricated native status"
       (null? (transformer-error-details missing-file-error)))

(define wrapper-destination (build-module 60))
(define wrapper-handle
  (parameter-tree-handle (module-parameters wrapper-destination) '("weight")))
(define wrapper-identity
  (parameter-handle-tensor-identity-internal wrapper-handle))
(define wrapper-owned-before (fixture-owned-live-count-internal))
(c1-checkpoint-load-module-internal!
 wrapper-destination checkpoint-path policy c1-fixture-codec-internal 'fixture-v1)
(check "successful file-to-module releases its temporary decoded state"
       (= wrapper-owned-before (fixture-owned-live-count-internal)))
(check "file-to-module wrapper restores exact value"
       (equal? (vector 11 12 13 14 15 16 17 18)
               (module-payload wrapper-destination '("weight"))))
(check "file-to-module wrapper preserves handle identity"
       (eq? wrapper-identity
            (parameter-handle-tensor-identity-internal wrapper-handle)))

(define missing-destination
  (build-schema-variant 70 '(2) 'i64 'cpu #f #t))
(define missing-handle
  (parameter-tree-handle (module-parameters missing-destination) '("weight")))
(define missing-identity
  (parameter-handle-tensor-identity-internal missing-handle))
(define missing-before
  (module-payload missing-destination '("weight")))
(define missing-wrapper-owned-before (fixture-owned-live-count-internal))
(expect-error "load wrapper missing destination path" 'shape-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 missing-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "rejected file-to-module releases its temporary decoded state"
       (= missing-wrapper-owned-before (fixture-owned-live-count-internal)))
(check "missing-path rejection preserves value"
       (equal? missing-before
               (module-payload missing-destination '("weight"))))
(check "missing-path rejection preserves identity"
       (eq? missing-identity
            (parameter-handle-tensor-identity-internal missing-handle)))

(define shape-destination
  (build-schema-variant 80 '(1) 'i64 'cpu #t #t))
(define shape-before
  (module-payload shape-destination '("weight")))
(expect-error "load wrapper shape mismatch" 'shape-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 shape-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "shape rejection preserves value"
       (equal? shape-before
               (module-payload shape-destination '("weight"))))

(define alias-destination
  (build-schema-variant 85 '(2) 'i64 'cpu #t #f))
(define alias-before
  (module-payload alias-destination '("weight")))
(expect-error "load wrapper alias topology mismatch" 'shape-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 alias-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "alias rejection preserves value"
       (equal? alias-before
               (module-payload alias-destination '("weight"))))

(define dtype-destination
  (build-schema-variant 86 '(2) 'f32 'cpu #t #t))
(define dtype-before
  (module-payload dtype-destination '("weight")))
(expect-error "load wrapper dtype mismatch" 'dtype-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 dtype-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "dtype rejection preserves value"
       (equal? dtype-before
               (module-payload dtype-destination '("weight"))))

(define device-destination
  (build-schema-variant 87 '(2) 'i64 'gpu #t #t))
(define device-before
  (module-payload device-destination '("weight")))
(expect-error "load wrapper device mismatch" 'device-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 device-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "device rejection preserves value"
       (equal? device-before
               (module-payload device-destination '("weight"))))

(define extra-destination (build-module 88))
(module-register-buffer-internal!
 extra-destination "extra" (c1-test-tensor '(1) 'i64 (vector 0 0 0 0 0 0 0 0)))
(define extra-before
  (module-payload extra-destination '("weight")))
(expect-error "load wrapper unexpected destination path" 'shape-mismatch
              (lambda ()
                (c1-checkpoint-load-module-internal!
                 extra-destination checkpoint-path policy
                 c1-fixture-codec-internal 'fixture-v1)))
(check "unexpected-path rejection preserves value"
       (equal? extra-before
               (module-payload extra-destination '("weight"))))

(define encode-calls 0)
(define sentinel-codec
  (c1-checkpoint-codec-internal
   'fixture-v1
   (lambda (request)
     (set! encode-calls (+ encode-calls 1))
     (bytevector))
   (lambda (request) (vector))))
(define unsafe-unbound-state
  (state-dict-create-unsafe-internal
   'transformer-state-dict 1 0 '()
   '(transformer-tensor-provider 2 0 fixture-v1) '() '()))
(expect-error "unbound unsafe state rejected before codec" 'unsupported
              (lambda ()
                (c1-checkpoint-encode-state-internal
                 unsafe-unbound-state policy sentinel-codec)))
(check "unbound unsafe state makes zero codec calls" (= encode-calls 0))

(expect-error "tensor policy rejects before codec" 'invalid-state
              (lambda ()
                (c1-checkpoint-encode-state-internal
                 source-state
                 (c1-persistence-policy-internal 1048576 524288 1 64 'cpu)
                 sentinel-codec)))
(check "tensor policy rejection makes zero codec calls" (= encode-calls 0))

(expect-error "alias metadata policy rejects before codec" 'invalid-state
              (lambda ()
                (c1-checkpoint-encode-state-internal
                 source-state
                 (c1-persistence-policy-internal 1048576 25 262144 64 'cpu)
                 sentinel-codec)))
(check "alias metadata rejection makes zero codec calls" (= encode-calls 0))

(define mutated-policy-type
  (c1-persistence-policy-internal 1048576 524288 262144 64 'cpu))
(vector-set! mutated-policy-type 1 'not-a-size)
(expect-error "mutated policy type" 'invalid-argument
              (lambda ()
                (c1-checkpoint-inspect-bytes-internal
                 encoded-a mutated-policy-type)))
(define mutated-policy-ceiling
  (c1-persistence-policy-internal 1048576 524288 262144 64 'cpu))
(vector-set! mutated-policy-ceiling 1 1099511627777)
(expect-error "mutated policy ceiling" 'invalid-argument
              (lambda ()
                (c1-checkpoint-inspect-bytes-internal
                 encoded-a mutated-policy-ceiling)))

(define encoded-parameter-calls 0)
(define inconsistent-tie-codec
  (c1-checkpoint-codec-internal
   'fixture-v1
   (lambda (request)
     (let ((bytes ((vector-ref c1-fixture-codec-internal 2) request)))
       (if (eq? (vector-ref request 1) 'parameter)
           (begin
             (set! encoded-parameter-calls (+ encoded-parameter-calls 1))
             (if (= encoded-parameter-calls 2)
                 (bytevector-u8-set!
                  bytes 0 (+ 1 (bytevector-u8-ref bytes 0))))))
       bytes))
   (vector-ref c1-fixture-codec-internal 3)))
(expect-error "inconsistent tied codec bytes" 'internal
              (lambda ()
                (c1-checkpoint-encode-state-internal
                 source-state policy inconsistent-tie-codec)))

(define decode-calls 0)
(define late-failure-owned-before (fixture-owned-live-count-internal))
(define late-failure-codec
  (c1-checkpoint-codec-internal
   'fixture-v1
