                (c1-checkpoint-metadata-ref-internal metadata 'unknown)))

(state-dict-release! file-state)
(state-dict-release! decoded)
(state-dict-release! source-state)
(check "all retained C1 states return owned carriers to baseline"
       (= persistent-state-owned-before (fixture-owned-live-count-internal)))

(display "C1 PASS: ") (display checks) (display " checks") (newline)
