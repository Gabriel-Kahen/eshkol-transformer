(for-each load-function '(cpu4-checkpoint-stage-source! cpu4-checkpoint-install-clone!
                         cpu4-checkpoint-install-moment! cpu4-checkpoint-product
                         cpu4-checkpoint-controls-copy))
(define serialized-config (vector '#vu8(1 2) "fingerprint"))
(define expanded-config (vector '#vu8(1 2) "fingerprint" 'inspected))
(define cursor-projection (make-vector 10 #f))
(vector-set! cursor-projection 3 '#vu8(3))
(vector-set! cursor-projection 4 '#vu8(4))
(define expanded-controls (vector 'rng 'tokenizer cursor-projection expanded-config (vector 0 0 0)))
