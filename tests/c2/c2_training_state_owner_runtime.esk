(load "d2_wave2_root.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "o2_wave2_extension.esk")
(load "c2_o2_reconstruct_extension.esk")
(load "c2_o2_encode_extension.esk")
(load "c2_model_encode_extension.esk")
(load "c2_x1_canonical_extension.esk")
(load "c2_training_state_extension.esk")

(extern void o2-test-fail-release-after i64
        :real et_o2_test_fail_release_after_v1)
(extern void o2-test-reset-failpoints
        :real et_o2_test_reset_failpoints_v1)
(extern i64 c2-test-i2-live-count i64
        :real et_c2_test_i2_live_count_v1)
(extern i64 c2-test-o2-count i64
        :real et_c2_test_o2_count_v1)
(extern i64 c2-test-o2-borrow-begin ptr
        :real et_c2_test_o2_borrow_begin_v1)
(extern i64 c2-test-o2-borrow-end
        :real et_c2_test_o2_borrow_end_v1)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin
        (display "C2 OWNER FAIL: ") (display label) (newline) (exit 1))))
(define (expect-error label category operation thunk)
  (let ((matched
          (guard (raised
                   (#t
                     (if (and (transformer-error? raised)
                              (eq? category
                                   (transformer-error-category raised))
                              (eq? operation
                                   (transformer-error-operation raised)))
                         #t
                         (begin
                           (display "C2 OWNER UNEXPECTED ERROR: ")
                           (display label) (display " ")
                           (if (transformer-error? raised)
                               (begin
                                 (display (transformer-error-category raised))
                                 (display "/")
                                 (display (transformer-error-operation raised)))
                               (display raised))
                           (newline)
                           #f))))
            (thunk) #f)))
    (check label matched)))
(define (expect-raised-false label thunk)
  (let ((caught? #f))
    (guard (caught
             (#t
               (set! caught? (eq? caught #f))
               #f))
      (thunk))
    (check label caught?)))
(define (diagnose-unexpected label thunk)
  (guard (raised
           (#t
             (display "C2 OWNER UNEXPECTED THROW: ")
             (display label)
             (if (transformer-error? raised)
                 (begin
                   (display " ")
                   (display (transformer-error-category raised))
                   (display "/")
                   (display (transformer-error-operation raised))
                   (display " ")
                   (display (transformer-error-message raised)))
                 #t)
             (newline)
             (raise raised)))
    (thunk)))
(define (c2-test-owner-counts)
  (let loop ((remaining c2-training-state-states)
             (live 0) (busy 0) (releasing 0) (dead 0) (live-controls 0))
    (if (null? remaining)
        (vector live busy releasing dead live-controls)
        (let* ((state (car remaining)) (status (vector-ref state 7)))
          (loop (cdr remaining)
                (+ live (if (eq? status 'live) 1 0))
                (+ busy (if (vector? status) 1 0))
                (+ releasing (if (eq? status 'releasing) 1 0))
                (+ dead (if (eq? status 'dead) 1 0))
                (+ live-controls (if (vector? (vector-ref state 3)) 1 0)))))))
(define (snapshot-i2-counts)
  (let ((result (make-vector 7 0)))
    (let loop ((index 0))
      (if (= index 7) result
          (begin (vector-set! result index (c2-test-i2-live-count index))
                 (loop (+ index 1)))))))
(define (snapshot-o2-counts)
  (let ((result (make-vector 9 0)))
    (let loop ((index 0))
      (if (= index 9) result
          (begin (vector-set! result index (c2-test-o2-count index))
                 (loop (+ index 1)))))))

(define fingerprint
  "sha256:eshkol-bpe-tokenizer-v1:1866ebedd76bf7d0e8e111ab25603a99aee927ea341e1305e4bb2c145648eb72")
(define config-fingerprint
  "sha256:eshkol-config-json-v1:337a2ea0be86b3fccf13a90c895e8a5fe42f94a270395940ac90c41f7cc67ceb")
(define canonical
  (string->utf8
    (string-append
      "{\"canonicalization\":\"eshkol-config-json-v1\",\"checksum-algorithm\":\"sha256\",\"checksum-coverage\":\"whole-document-including-final-lf\",\"config-schema-version\":[1,0],\"format\":\"eshkol-resolved-run\",\"format-version\":[1,0],\"limits\":{\"integer-digits\":19,\"max-input-bytes\":16384,\"max-input-keys\":14,\"max-input-nesting-depth\":1},\"provenance\":{"
      "\"config-schema-major\":\"input\",\"config-schema-minor\":\"input\",\"model.context-length\":\"input\",\"model.device\":\"default\",\"model.dtype\":\"default\",\"model.head-size\":\"derived\",\"model.hidden-size\":\"input\",\"model.kv-head-count\":\"default\",\"model.layer-count\":\"input\",\"model.query-head-count\":\"input\",\"model.vocabulary-size\":\"input\",\"run.deterministic\":\"default\",\"run.seed\":\"input\",\"training.accumulation-steps\":\"default\"},"
      "\"required-features\":[],\"resolved\":{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":128,\"model.device\":\"cpu\",\"model.dtype\":\"f32\",\"model.head-size\":16,\"model.hidden-size\":64,\"model.kv-head-count\":4,\"model.layer-count\":2,\"model.query-head-count\":4,\"model.vocabulary-size\":263,\"run.deterministic\":true,\"run.seed\":1729,\"training.accumulation-steps\":1}}\n")))

(define (config-for path)
  (list 'transformer-optimizer-config 1 0 '() 'adamw 'f32 'cpu
        '(none) '(constant)
        (list (list 'group (list path)
                    "3dcccccd" "3f000000" "3f000000"
                    "3a83126f" "00000000"))))
(define (make-o2-state path shape aliases completed)
  (let* ((elements
           (let loop ((remaining shape) (product 1))
             (if (null? remaining) product
                 (loop (cdr remaining) (* product (car remaining))))))
         (avg (make-bytevector (* elements 4) 0))
         (sq (make-bytevector (* elements 4) 0))
         (request
           (vector o2-c2-reconstruct-tag (config-for path) (list path)
                   aliases completed
                   (vector (vector path shape avg sq))
                   'checkpoint-load #f)))
    (o2-state-reconstruct-internal request)
    (vector-ref request 7)))
(define (make-p1-state name shape tied-name)
  (let* ((module (i2-module-create-internal))
         (parameter
           (i2-parameter-create-uniform-internal
             (let loop ((remaining shape) (product 1))
               (if (null? remaining) product
                   (loop (cdr remaining) (* product (car remaining))))) 0))
         (handle (i2-module-register-parameter-internal! module name parameter)))
    (if tied-name
        (i2-module-register-tied-parameter-internal! module tied-name handle)
        #t)
    (module-state-dict module)))

(define args (command-line))
(define tokenizer-path (car (cdr args)))
(define resource-root (car (cdr (cdr args))))
(define policy (c1-wave2-persistence-policy 1048576 1048576 1048576 8 'cpu))
(define tokenizer (t2-wave2-tokenizer-load tokenizer-path policy))
(check "fixture fingerprint" (string=? fingerprint
                                        (t2-private-tokenizer-fingerprint tokenizer)))
(check "fixture vocabulary" (= 263 (t2-private-tokenizer-vocab-size tokenizer)))
(define dataset
  (d2-token-dataset-open
    (list ':directory (string-append resource-root "/small")
          ':batch-size 1 ':sequence-length 1
          ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
          ':maximum-total-tokens 65536 ':maximum-batch-bytes 17
          ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #f)
    tokenizer))
(define start (d2-token-dataset-cursor dataset))
(d2-token-dataset-close! dataset)

(define (make-controls completed)
  (vector
    (vector 'philox4x32-10 1 1729 -1 -9223372036854775808)
    (vector (utf8->string (string->utf8 fingerprint)) 263)
    (vector (bytevector-copy start 0 (bytevector-length start))
            (bytevector-copy start 0 (bytevector-length start)))
    (vector (bytevector-copy canonical 0 (bytevector-length canonical))
            (utf8->string (string->utf8 config-fingerprint)))
    (vector 99 completed 3)))
(define (compose p1 o2 controls)
  (let ((request
          (vector c2-training-state-compose-tag p1 o2 controls
                  'checkpoint-load #f)))
    (c2-training-state-compose-internal request)
    request))

;;; Component borrows reject composition with the caller operation, publish
;;; nothing, and preserve both authorities for use after the borrow ends.
(define busy-p1 (make-p1-state "weight" '(4) #f))
(define busy-p1-o2 (make-o2-state '("weight") '(4) '() 17))
(define busy-p1-tensor (state-dict-tensor busy-p1 '("weight")))
(define busy-p1-carrier
  (state-dict-tensor-borrow-begin-internal busy-p1 busy-p1-tensor))
(define busy-p1-request
  (vector c2-training-state-compose-tag busy-p1 busy-p1-o2
          (make-controls 17) 'checkpoint-load #f))
(expect-error "active P1 tensor borrow rejects compose" 'invalid-state
              'checkpoint-load
  (lambda () (c2-training-state-compose-internal busy-p1-request)))
(check "active P1 borrow publishes nothing"
       (and busy-p1-carrier
            (eq? (vector-ref busy-p1-request 1) busy-p1)
            (eq? (vector-ref busy-p1-request 2) busy-p1-o2)
            (eq? (vector-ref busy-p1-request 5) #f)))
(check "active P1 borrow ends"
       (state-dict-tensor-borrow-end-internal busy-p1 busy-p1-tensor))
(check "P1-busy compose leaves both owners usable and releasable"
       (and (pair? (state-dict-paths busy-p1))
            (vector? (o2-require-live-state 'checkpoint-load busy-p1-o2))
            (state-dict-release! busy-p1)
            (o2-public-optimizer-state-release! busy-p1-o2)))

(define busy-o2-p1 (make-p1-state "weight" '(4) #f))
(define busy-o2 (make-o2-state '("weight") '(4) '() 17))
(define busy-o2-native (vector-ref (o2-require-live-state 'checkpoint-load
                                                           busy-o2) 1))
(define busy-o2-borrows-before (c2-test-o2-count 6))
(check "O2 moment borrow begins"
       (= (c2-test-o2-borrow-begin busy-o2-native) 0))
(check "O2 moment borrow is exactly accounted"
       (= (+ busy-o2-borrows-before 1) (c2-test-o2-count 6)))
(define busy-o2-request
  (vector c2-training-state-compose-tag busy-o2-p1 busy-o2
          (make-controls 17) 'checkpoint-load #f))
(expect-error "active O2 moment borrow rejects compose" 'invalid-state
              'checkpoint-load
  (lambda () (c2-training-state-compose-internal busy-o2-request)))
(check "active O2 borrow publishes nothing"
       (and (eq? (vector-ref busy-o2-request 1) busy-o2-p1)
            (eq? (vector-ref busy-o2-request 2) busy-o2)
            (eq? (vector-ref busy-o2-request 5) #f)))
(check "O2 moment borrow ends and returns its live count"
       (and (= (c2-test-o2-borrow-end) 0)
            (= busy-o2-borrows-before (c2-test-o2-count 6))))
(check "O2-busy compose leaves both owners usable and releasable"
       (and (pair? (state-dict-paths busy-o2-p1))
            (vector? (o2-require-live-state 'checkpoint-load busy-o2))
            (state-dict-release! busy-o2-p1)
            (o2-public-optimizer-state-release! busy-o2)))

;;; Exact completed-update and topology failures leave both authorities live.
(define mismatch-p1 (make-p1-state "weight" '(4) #f))
(define mismatch-o2 (make-o2-state '("weight") '(4) '() 17))
(define mismatch-request
  (vector c2-training-state-compose-tag mismatch-p1 mismatch-o2
          (make-controls 18) 'checkpoint-load #f))
(expect-error "completed updates checked" 'shape-mismatch 'checkpoint-load
  (lambda () (c2-training-state-compose-internal mismatch-request)))
(check "counter mismatch publishes nothing"
       (and (eq? (vector-ref mismatch-request 1) mismatch-p1)
            (eq? (vector-ref mismatch-request 2) mismatch-o2)
            (eq? (vector-ref mismatch-request 5) #f)))
(check "counter mismatch leaves P1 live" (pair? (state-dict-paths mismatch-p1)))
(check "counter mismatch P1 releases" (state-dict-release! mismatch-p1))
(check "counter mismatch O2 releases"
       (o2-public-optimizer-state-release! mismatch-o2))

(define shape-p1 (make-p1-state "weight" '(4) #f))
(define shape-o2 (make-o2-state '("weight") '(2 2) '() 17))
(expect-error "moment/model rank checked" 'shape-mismatch 'checkpoint-load
  (lambda () (compose shape-p1 shape-o2 (make-controls 17))))
(check "shape mismatch leaves owners releasable"
       (and (state-dict-release! shape-p1)
            (o2-public-optimizer-state-release! shape-o2)))

(define path-p1 (make-p1-state "weight" '(4) #f))
(define path-o2 (make-o2-state '("wrong") '(4) '() 17))
(expect-error "moment/model path checked" 'shape-mismatch 'checkpoint-load
  (lambda () (compose path-p1 path-o2 (make-controls 17))))
(check "path mismatch leaves owners releasable"
       (and (state-dict-release! path-p1)
            (o2-public-optimizer-state-release! path-o2)))

(define alias-p1 (make-p1-state "weight" '(4) "weight_tied"))
(define alias-o2 (make-o2-state '("weight") '(4) '() 17))
(expect-error "moment/model alias topology checked" 'shape-mismatch 'checkpoint-load
  (lambda () (compose alias-p1 alias-o2 (make-controls 17))))
(check "alias mismatch leaves owners releasable"
       (and (state-dict-release! alias-p1)
            (o2-public-optimizer-state-release! alias-o2)))

;;; The second claim is the only fallible operation after the first claim.
(define rollback-p1 (make-p1-state "weight" '(4) #f))
(define rollback-o2 (make-o2-state '("weight") '(4) '() 17))
(define saved-o2-claim c2-training-state-claim-o2!)
(set! c2-training-state-claim-o2!
  (lambda (state token)
    (c2-training-state-fail 'internal 'checkpoint-load
                            "injected second-claim failure")))
(expect-error "second claim rolls P1 back" 'internal 'checkpoint-load
  (lambda () (compose rollback-p1 rollback-o2 (make-controls 17))))
(set! c2-training-state-claim-o2! saved-o2-claim)
(check "rolled-back P1 alias is usable" (pair? (state-dict-paths rollback-p1)))
(check "rolled-back owners release normally"
       (and (state-dict-release! rollback-p1)
            (o2-public-optimizer-state-release! rollback-o2)))

;;; Successful transfer deep-owns controls and consumes both request slots.
(define owned-p1 (make-p1-state "weight" '(4) #f))
(define owned-o2 (make-o2-state '("weight") '(4) '() 17))
(define borrowed-controls (make-controls 17))
(define original-cursor-first
  (bytevector-u8-ref (vector-ref (vector-ref borrowed-controls 2) 0) 0))
(define original-config-first
  (bytevector-u8-ref (vector-ref (vector-ref borrowed-controls 3) 0) 0))
(define owned-request (compose owned-p1 owned-o2 borrowed-controls))
(define owned (vector-ref owned-request 5))
(check "compose consumes component authority slots"
       (and (eq? (vector-ref owned-request 1) #f)
            (eq? (vector-ref owned-request 2) #f)
            owned))
(bytevector-u8-set! (vector-ref (vector-ref borrowed-controls 2) 0) 0 0)
(bytevector-u8-set! (vector-ref (vector-ref borrowed-controls 3) 0) 0 0)
(vector-set! (vector-ref borrowed-controls 4) 0 0)

;;; The aggregate publishes its busy identity before P1 activation can enter a
;;; trusted provider callback. Reentrant release therefore rejects without
;;; consuming either claimed subowner.
(define saved-p1-borrow-activate
  c2-training-state-activate-p1-borrow!)
(define activation-observed-busy #f)
(define activation-release-rejected #f)
(define activation-observed-borrow #f)
(define activation-observed-access #f)
(set! c2-training-state-activate-p1-borrow!
  (lambda (state owner-token access-token candidate-borrow operation)
    (set! activation-observed-borrow candidate-borrow)
    (set! activation-observed-access access-token)
    (set! activation-observed-busy
      (eq? (vector-ref (c2-training-state-find owned) 7) candidate-borrow))
    (set! activation-release-rejected
      (guard (raised
               (#t
                 (and (transformer-error? raised)
                      (eq? (transformer-error-category raised)
                           'invalid-state)
                      (eq? (transformer-error-operation raised)
                           'trainer-state-release!))))
        (c2-training-state-release-internal!
          owned 'trainer-state-release!)
        #f))
    (saved-p1-borrow-activate
      state owner-token access-token candidate-borrow operation)))
(define activation-probe-borrow
  (c2-training-state-borrow-begin-internal owned 'checkpoint-save!))
(set! c2-training-state-activate-p1-borrow!
  saved-p1-borrow-activate)
(check "borrow is busy before fallible P1 activation"
       activation-observed-busy)
(check "P1 activation callback cannot reentrantly release owner"
       activation-release-rejected)
(check "borrow return preserves the exact activated canonical identities"
       (and (eq? activation-probe-borrow activation-observed-borrow)
            (eq? (vector-ref activation-probe-borrow 4)
                 activation-observed-access)
            (eq? activation-probe-borrow
                 (vector-ref (c2-training-state-find owned) 7))))
(check "activation probe borrow ends"
       (c2-training-state-borrow-end-internal activation-probe-borrow))

;;; Both activation failure boundaries restore the exact idle owner, including
;;; when the thrown exception object itself is #f.
(set! c2-training-state-activate-p1-borrow!
  (lambda (state owner-token access-token candidate-borrow operation)
    (raise #f)))
(expect-raised-false "P1 activation preserves raised #f"
  (lambda ()
    (c2-training-state-borrow-begin-internal owned 'checkpoint-save!)))
(set! c2-training-state-activate-p1-borrow!
  saved-p1-borrow-activate)
(check "P1 activation failure restores idle C2 owner"
       (eq? (vector-ref (c2-training-state-find owned) 7) 'live))
(set! c2-training-state-activate-p1-borrow!
  (lambda (state owner-token access-token candidate-borrow operation)
    (c2-training-state-fail
      'unsupported 'injected-p1-activation "injected P1 activation failure")))
(expect-error "P1 activation preserves a structured error"
              'unsupported 'injected-p1-activation
  (lambda ()
    (c2-training-state-borrow-begin-internal owned 'checkpoint-save!)))
(set! c2-training-state-activate-p1-borrow!
  saved-p1-borrow-activate)
(check "structured P1 activation failure restores idle C2 owner"
       (eq? (vector-ref (c2-training-state-find owned) 7) 'live))
(define saved-o2-borrow-activate
  c2-training-state-activate-o2-borrow!)
(set! c2-training-state-activate-o2-borrow!
  (lambda (state owner-token access-token candidate-borrow operation)
    (raise #f)))
(expect-raised-false "O2 activation preserves raised #f after P1 rollback"
  (lambda ()
    (c2-training-state-borrow-begin-internal owned 'checkpoint-save!)))
(set! c2-training-state-activate-o2-borrow!
  saved-o2-borrow-activate)
(check "O2 activation failure restores idle C2 owner"
       (eq? (vector-ref (c2-training-state-find owned) 7) 'live))
(set! c2-training-state-activate-o2-borrow!
  (lambda (state owner-token access-token candidate-borrow operation)
    (c2-training-state-fail
      'unsupported 'injected-o2-activation "injected O2 activation failure")))
(expect-error "O2 activation preserves a structured error after P1 rollback"
              'unsupported 'injected-o2-activation
  (lambda ()
    (c2-training-state-borrow-begin-internal owned 'checkpoint-save!)))
(set! c2-training-state-activate-o2-borrow!
  saved-o2-borrow-activate)
(check "structured O2 activation failure restores idle C2 owner"
       (eq? (vector-ref (c2-training-state-find owned) 7) 'live))
(define borrow
  (diagnose-unexpected
    "borrow begin"
    (lambda ()
      (c2-training-state-borrow-begin-internal owned 'checkpoint-save!))))
(define projection (c2-training-state-borrow-projection-internal borrow))
(define owner-token
  (c2-training-state-borrow-owner-token-internal
    borrow 'checkpoint-save!))
(check "borrow access authority is a fresh private exact identity"
       (and (vector? owner-token) (= (vector-length owner-token) 1)
            (eq? (vector-ref owner-token 0)
                 c2-training-state-borrow-access-token-tag)))
(check "fresh C2 borrow has canonical inactive tensor access"
       (equal? (vector-ref borrow 5) (vector #f #f #f #f #f)))
(define copied-borrow
  (vector c2-training-state-borrow-tag (vector-ref borrow 1)
          (vector-ref borrow 2) (vector-ref borrow 3)
          (vector-ref borrow 4) (vector-ref borrow 5)))
(expect-error "copied C2 borrow cannot consume inactive tensor cache"
              'invalid-state 'c2-training-state-borrow-end-internal
  (lambda () (c2-training-state-borrow-end-internal copied-borrow)))
(expect-error "copied C2 borrow cannot activate aliased tensor cache"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-borrow-activate-internal!
      owned-p1 (vector-ref borrow 3) (vector-ref borrow 4)
      copied-borrow 'checkpoint-save!)))
(check "copied C2 borrow leaves exact cache canonical and inactive"
       (equal? (vector-ref borrow 5) (vector #f #f #f #f #f)))
(define p1-owned-entry-shells-a
  (state-dict-c2-owned-entry-shells-internal
    owned-p1 owner-token 'checkpoint-save!))
(define p1-owned-entry-shells-b
  (state-dict-c2-owned-entry-shells-internal
    owned-p1 owner-token 'checkpoint-save!))
(check "claimed entry helper returns the exact ordered bounded shell list"
       (and (pair? p1-owned-entry-shells-a)
            (null? (cdr p1-owned-entry-shells-a))))
(check "repeated claimed entry preparation reuses exact shell identity"
       (and (not (eq? p1-owned-entry-shells-a p1-owned-entry-shells-b))
            (eq? (car p1-owned-entry-shells-a)
                 (car p1-owned-entry-shells-b))))
(check "claimed entry preparation leaves tensor cache inactive"
       (equal? (vector-ref borrow 5) (vector #f #f #f #f #f)))
(define wrong-access-token
  (vector (vector-ref owner-token 0)))
(check "same-tag access-token lookalike has distinct identity"
       (not (eq? wrong-access-token owner-token)))
(expect-error "same-tag access-token lookalike cannot prepare claimed entries"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-entry-shells-internal
      owned-p1 wrong-access-token 'checkpoint-save!)))
(expect-error "forged state cannot prepare claimed entries"
              'invalid-argument 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-entry-shells-internal
      (vector owned-p1) owner-token 'checkpoint-save!)))
(define p1-owned-projection
  (state-dict-c2-owned-projection-internal
    owned-p1 owner-token 'checkpoint-save!))
(define p1-owned-entry (car (vector-ref p1-owned-projection 4)))
(define direct-claimed-carrier
  (state-dict-c2-owned-tensor-borrow-begin-internal
    owned-p1 owner-token p1-owned-entry 'checkpoint-save!))
(check "direct claimed tensor begin returns a carrier"
       direct-claimed-carrier)
(expect-error "nested claimed tensor begin rejects while cache is active"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-tensor-borrow-begin-internal
      owned-p1 owner-token p1-owned-entry 'checkpoint-save!)))
(expect-error "wrong token cannot end active claimed tensor access"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-tensor-borrow-end-internal
      owned-p1 wrong-access-token p1-owned-entry 'checkpoint-save!)))
(expect-error "wrong entry cannot end active claimed tensor access"
              'invalid-argument 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-tensor-borrow-end-internal
      owned-p1 owner-token (vector p1-owned-entry) 'checkpoint-save!)))
(expect-error "wrong-token end leaves claimed tensor access active"
              'invalid-state 'checkpoint-save!
  (lambda ()
    (state-dict-c2-owned-tensor-borrow-begin-internal
      owned-p1 owner-token p1-owned-entry 'checkpoint-save!)))
