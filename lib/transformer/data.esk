(define e1b-safe-d2-token-batch-inputs-call
  (let ((output (vector #f)))
    (extern void e1b-d2-token-batch-inputs ptr ptr
            :real et_e1b_public_d2_token_batch_inputs_v1)
    (extern void e1b-d2-token-batch-invalid ptr i64 ptr
            :real et_e1b_public_d2_token_batch_validate_v1)
    (lambda (batch)
      (if (procedure? batch)
          (begin (e1b-d2-token-batch-inputs batch output) #t)
          (begin (e1b-d2-token-batch-invalid (vector batch) 1 output) #t))
      (let ((result (vector-ref output 0)))
        (vector-set! output 0 #f)
        result))))

(define e1b-safe-d2-token-batch-targets-call
  (let ((output (vector #f)))
    (extern void e1b-d2-token-batch-targets ptr ptr
            :real et_e1b_public_d2_token_batch_targets_v1)
    (extern void e1b-d2-token-batch-invalid ptr i64 ptr
            :real et_e1b_public_d2_token_batch_validate_v1)
    (lambda (batch)
      (if (procedure? batch)
          (begin (e1b-d2-token-batch-targets batch output) #t)
          (begin (e1b-d2-token-batch-invalid (vector batch) 2 output) #t))
      (let ((result (vector-ref output 0)))
        (vector-set! output 0 #f)
        result))))

(define e1b-safe-d2-token-batch-loss-mask-call
  (let ((output (vector #f)))
    (extern void e1b-d2-token-batch-loss-mask ptr ptr
            :real et_e1b_public_d2_token_batch_loss_mask_v1)
    (extern void e1b-d2-token-batch-invalid ptr i64 ptr
            :real et_e1b_public_d2_token_batch_validate_v1)
    (lambda (batch)
      (if (procedure? batch)
          (begin (e1b-d2-token-batch-loss-mask batch output) #t)
          (begin (e1b-d2-token-batch-invalid (vector batch) 3 output) #t))
      (let ((result (vector-ref output 0)))
        (vector-set! output 0 #f)
        result))))

(define e1b-safe-d2-token-batch-validate-call
  (let ()
    (extern void e1b-d2-token-batch-validate ptr i64 ptr
            :real et_e1b_public_d2_token_batch_validate_v1)
    (lambda (batch)
      (let ((output (vector #f)))
        (e1b-d2-token-batch-validate (vector batch) 0 output)
        (vector-ref output 0)))))

(define e1b-safe-d2-token-batch-release-call
  (let ((output (vector #f)))
    (extern void e1b-d2-token-batch-release ptr ptr
            :real et_e1b_public_d2_token_batch_release_v1)
    (extern void e1b-d2-token-batch-invalid ptr i64 ptr
            :real et_e1b_public_d2_token_batch_validate_v1)
    (lambda (batch)
      (if (procedure? batch)
          (begin (e1b-d2-token-batch-release batch output) #t)
          (begin (e1b-d2-token-batch-invalid (vector batch) 4 output) #t))
      (let ((result (vector-ref output 0)))
        (vector-set! output 0 #f)
        result))))

(define (token-dataset-open config tokenizer)
  (e1b-safe-d2-token-dataset-open-call config tokenizer))

(define (token-dataset-next-batch dataset)
  (e1b-safe-d2-token-dataset-next-batch-call dataset))

(define (token-dataset-cursor dataset)
  (e1b-safe-d2-token-dataset-cursor-call dataset))

(define (token-dataset-end? value)
  (e1b-safe-d2-token-dataset-end-call value))

(define (token-dataset-seek! dataset cursor)
  (e1b-safe-d2-token-dataset-seek-call dataset cursor))

(define (token-dataset-close! dataset)
  (e1b-safe-d2-token-dataset-close-call dataset))

(define (token-batch-inputs batch)
  (e1b-safe-d2-token-batch-inputs-call batch))

(define (token-batch-targets batch)
  (e1b-safe-d2-token-batch-targets-call batch))

(define (token-batch-loss-mask batch)
  (e1b-safe-d2-token-batch-loss-mask-call batch))

(define (token-batch-validate batch)
  (e1b-safe-d2-token-batch-validate-call batch))

(define (token-batch-release! batch)
  (e1b-safe-d2-token-batch-release-call batch))
