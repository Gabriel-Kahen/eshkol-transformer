;;; Genuine same-root model witness. No production consumer entry is added.
(extern i64 m3cg-native-acquire ptr :real et_m3cg_test_acquire_v1)
(extern i64 m3cg-native-check :real et_m3cg_test_check_v1)
(extern i64 m3cg-native-end :real et_m3cg_test_end_v1)
(define (m3cg-check label result)
  (if result #t (begin (display "M3CG-FAIL: ") (display label) (newline) (exit 1))))
(define-syntax m3cg-reject
  (syntax-rules ()
    ((_ operation expression)
     (m3cg-check operation
       (guard (caught (#t
         (and (transformer-error? caught)
              (eq? (transformer-error-category caught) 'invalid-state)
              (eq? (transformer-error-operation caught) operation)
              (vector-ref m3-call-state 0))))
         expression #f)))))
(define (m3cg-cycle entry)
  (m3-call 'm3cg-pins
    (m3cg-check 'pin-acquire (= 1 (m3cg-native-acquire (vector-ref entry 3))))
    (vector-set! entry 10 entry)
    (m3cg-check 'pin-check (= 1 (m3cg-native-check)))
    (m3cg-check 'outer-held (vector-ref m3-call-state 0))
    (m3cg-check 'pin-end (= 1 (m3cg-native-end)))
    (vector-set! entry 10 #f))
  #t)
(define (m3cg-repeat entry index)
  (if (= index 8192) #t
      (begin (m3cg-cycle entry) (m3cg-repeat entry (+ index 1)))))
(define (m3cg-run)
  (let* ((config (x1-private-config-resolve
           (x1-private-config-parse "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":2,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}") '()))
         (initial (g3t-checked-m3t-initializer-state 1729))
         (model (g3t-checked-m3t-model-create config initial))
         (entry (m3t-entry model 'model 'm3cg #t))
         (input (g3t-checked-m3t-input-create)))
    (m3cg-check 'copy (g3t-checked-m3t-input-copy! input '(3 197)))
    (m3-call 'm3cg-outer
      (m3cg-reject 'diagnostic-model-logits-bits (m3-public-diagnostic-model-logits-bits #f))
      (m3cg-reject 'diagnostic-model-logits-release! (m3-public-diagnostic-model-logits-release! #f))
      (m3cg-reject 'diagnostic-output-vjp! (m3-public-diagnostic-output-vjp! #f #f #f #f))
      (m3cg-reject 'model-forward (m3-public-model-forward #f #f #f))
      (m3cg-reject 'model-output-logits (m3-public-model-output-logits #f))
      (m3cg-reject 'model-output-loss (m3-public-model-output-loss #f))
      (m3cg-reject 'model-output-release! (m3-public-model-output-release! #f))
      (m3cg-reject 'model-output-rng (m3-public-model-output-rng #f))
      (m3cg-reject 'diagnostic-attention! (g3t-checked-m3t-attention! #f))
      (m3cg-reject 'diagnostic-attention-vjp! (g3t-checked-m3t-attention-vjp! #f))
      (m3cg-reject 'diagnostic-embedding! (g3t-checked-m3t-embedding! #f #f))
      (m3cg-reject 'diagnostic-embedding-vjp! (g3t-checked-m3t-embedding-vjp! #f #f))
      (m3cg-reject 'diagnostic-gelu! (g3t-checked-m3t-gelu! #f))
      (m3cg-reject 'diagnostic-gelu-vjp! (g3t-checked-m3t-gelu-vjp! #f))
      (m3cg-reject 'diagnostic-heads-merge! (g3t-checked-m3t-heads-merge! #f))
      (m3cg-reject 'diagnostic-heads-merge-vjp! (g3t-checked-m3t-heads-merge-vjp! #f))
      (m3cg-reject 'diagnostic-heads-split! (g3t-checked-m3t-heads-split! #f #f))
      (m3cg-reject 'diagnostic-heads-split-vjp! (g3t-checked-m3t-heads-split-vjp! #f #f))
      (m3cg-reject 'diagnostic-initializer-algorithm (g3t-checked-m3t-initializer-algorithm #f))
      (m3cg-reject 'diagnostic-initializer-state (g3t-checked-m3t-initializer-state #f))
      (m3cg-reject 'diagnostic-initializer-words (g3t-checked-m3t-initializer-words #f))
      (m3cg-reject 'diagnostic-input-copy! (g3t-checked-m3t-input-copy! #f #f))
      (m3cg-reject 'diagnostic-input-copy-tokenizer! (g3t-checked-m3t-input-copy-tokenizer! #f #f))
      (m3cg-reject 'diagnostic-input-create (g3t-checked-m3t-input-create))
      (m3cg-reject 'diagnostic-input-release! (g3t-checked-m3t-input-release! #f))
      (m3cg-reject 'diagnostic-layer-norm! (g3t-checked-m3t-layer-norm! #f #f))
      (m3cg-reject 'diagnostic-layer-norm-vjp! (g3t-checked-m3t-layer-norm-vjp! #f #f))
      (m3cg-reject 'diagnostic-linear! (g3t-checked-m3t-linear! #f #f))
      (m3cg-reject 'diagnostic-linear-vjp! (g3t-checked-m3t-linear-vjp! #f #f))
      (m3cg-reject 'diagnostic-logits-bits (g3t-checked-m3t-logits-bits #f))
      (m3cg-reject 'diagnostic-logits-copy-bits! (g3t-checked-m3t-logits-copy-bits! #f #f))
      (m3cg-reject 'diagnostic-logits-create (g3t-checked-m3t-logits-create))
      (m3cg-reject 'diagnostic-logits-release! (g3t-checked-m3t-logits-release! #f))
      (m3cg-reject 'diagnostic-model-create (g3t-checked-m3t-model-create #f #f))
      (m3cg-reject 'diagnostic-model-initializer (g3t-checked-m3t-model-initializer #f))
      (m3cg-reject 'diagnostic-model-profile (g3t-checked-m3t-model-profile #f))
      (m3cg-reject 'diagnostic-residual! (g3t-checked-m3t-residual! #f #f))
      (m3cg-reject 'diagnostic-residual-vjp! (g3t-checked-m3t-residual-vjp! #f #f))
      (m3cg-reject 'diagnostic-sum! (g3t-checked-m3t-sum! #f #f))
      (m3cg-reject 'diagnostic-workspace-begin! (g3t-checked-m3t-workspace-begin! #f #f))
      (m3cg-reject 'diagnostic-workspace-check-primals (g3t-checked-m3t-workspace-check-primals #f))
      (m3cg-reject 'diagnostic-workspace-copy-logits! (g3t-checked-m3t-workspace-copy-logits! #f #f))
      (m3cg-reject 'diagnostic-workspace-create (g3t-checked-m3t-workspace-create #f))
      (m3cg-reject 'diagnostic-workspace-release! (g3t-checked-m3t-workspace-release! #f))
      (m3cg-reject 'diagnostic-workspace-reset! (g3t-checked-m3t-workspace-reset! #f))
      (m3cg-reject 'diagnostic-workspace-vjp-begin! (g3t-checked-m3t-workspace-vjp-begin! #f #f))
      ;; Trusted originals remain usable while the outer guard is held.
      (let ((nested (m3t-public-input-create)))
        (m3cg-check 'nested-copy (m3t-public-input-copy! nested '(0 255)))
        (m3cg-check 'nested-release (m3t-public-input-release! nested))))
    (m3cg-check 'idle (not (vector-ref m3-call-state 0)))
    ;; A manual frame excludes its own model between aggregate invocations.
    (let* ((second (g3t-checked-m3t-model-create config
                     (g3t-checked-m3t-initializer-state 1729)))
           (second-entry (m3t-entry second 'model 'm3cg #t))
           (workspace (g3t-checked-m3t-workspace-create model)))
      (m3cg-check 'manual-begin (g3t-checked-m3t-workspace-begin! workspace input))
      (m3-call 'm3cg-busy
        (m3cg-check 'same-model-busy (= 0 (m3cg-native-acquire (vector-ref entry 3))))
        (m3cg-check 'wrong-kind (= 0 (m3cg-native-acquire
          (vector-ref (m3t-entry input 'input 'm3cg #t) 3)))))
      (m3cg-cycle second-entry)
      (m3cg-check 'manual-reset (g3t-checked-m3t-workspace-reset! workspace))
      (m3cg-check 'manual-release (g3t-checked-m3t-workspace-release! workspace)))
    ;; A real M3 schedule traverses the trusted originals under its own guard.
    (let* ((output (m3-public-model-forward model input '()))
           (logits (m3-public-model-output-logits output)))
      (m3cg-check 'logits (= 2048 (bytevector-length
        (m3-public-diagnostic-model-logits-bits logits))))
      (m3cg-check 'release-output (m3-public-model-output-release! output))
      (m3cg-check 'release-logits (m3-public-diagnostic-model-logits-release! logits)))
    ;; Reuse exact model and stable native context; no per-cycle owner enrollment.
    (m3cg-repeat entry 0)
    (m3cg-check 'final-idle (not (vector-ref m3-call-state 0)))
    (m3cg-check 'model-idle (not (vector-ref entry 10)))
    (m3cg-check 'input-release (g3t-checked-m3t-input-release! input))
    #t))
