(define from "/tmp/eshkol-r0-rename-from")
(define to "/tmp/eshkol-r0-rename-to")
(if (file-exists? from) (file-delete from) #f)
(if (file-exists? to) (file-delete to) #f)
(define out (open-output-file from))
(write-line "rename-data" out)
(close-port out)
(file-rename from to)
(display (if (and (not (file-exists? from)) (file-exists? to))
             "PASS file rename" "FAIL file rename"))
(newline)
(file-delete to)
(display "R0_DONE file_rename") (newline)
