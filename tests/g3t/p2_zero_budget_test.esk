(vector-set! wrapped-output-entry 2 'live)
(check "IDs pending rejection leaves no owner"
       (and (= 0 (live-ids-shells)) (= 0 (g3t-test-live-clones))
            (= 1 (g3t-test-output-state wrapped-native-output))))
(define wrapped-ids-i1-before (g3t-test-i1-count 0))
(check "IDs wrapper header cut armed" (= 0 (g3t-test-fail-alloc-after 0)))
(reject-category "IDs wrapper header cut raises" 'internal
  (lambda () (g3t-generation-output-ids wrapped-output)))
(check "IDs wrapper header cut atomic"
       (let ((entry (car (vector-ref g3t-registry 0))))
         (and (eq? (vector-ref entry 1) 'ids)
              (eq? (vector-ref entry 2) 'dead)
              (not (vector-ref entry 3))
              (not (vector-ref entry 10))
              (= 0 (live-ids-shells))
              (= 0 (g3t-test-live-clones))
              (= wrapped-ids-i1-before (g3t-test-i1-count 0))
              (= 1 (g3t-test-output-state wrapped-native-output))
              (= 2 (g3t-test-output-word wrapped-native-output 2))
              (= 1729 (g3t-test-output-word wrapped-native-output 8)))))
(check "IDs wrapper header cut disarmed"
       (= 0 (g3t-test-fail-alloc-after 9223372036854775807)))
(let cuts ((index 0))
  (if (= index 3) #t
      (begin
        (check "IDs wrapper I1 cut armed" (= 0 (g3t-test-fail-i1-after index)))
        (reject-category "IDs wrapper I1 cut raises" 'internal
          (lambda () (g3t-generation-output-ids wrapped-output)))
        (check "IDs wrapper I1 cut atomic"
