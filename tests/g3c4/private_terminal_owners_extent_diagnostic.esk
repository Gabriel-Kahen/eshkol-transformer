;;; Source fixture for a fresh one-use compiled private diagnostic.
;;; A consumed sealed package must never be edited or reused.
(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "g3c4_call_entry_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3c4_output_envelope_extension.esk")
(load "g3c4_p2g2_ownership_extension.esk")
(load "g3c4_p2g2_protected_scope_extension.esk")
(load "g3c4_p2g2_t1_prefix_coordinator_extension.esk")
(load "g3c4_p2g2_terminal_extension.esk")
(load "g3c4_p2g2_terminal_first_extension.esk")
(load "g3c4_p2g2_terminal_prefix_extension.esk")
(load "g3c4_p2g2_terminal_second_extension.esk")
(load "g3c4_p2g2_terminal_text_preflight_extension.esk")
(load "g3c4_p2g2_terminal_precommit_frame_extension.esk")
(load "g3c4_p2g2_terminal_live_authority_extension.esk")
(load "g3c4_p2g2_terminal_commit_extension.esk")
(load "g3c4_p2g2_terminal_snapshot_extension.esk")
(load "g3c4_p2g2_terminal_release_extension.esk")
(load "g3c4_p2g2_terminal_ids_owner_extension.esk")

(extern i64 probe-clone-hold ptr :real et_g3c4_private_probe_clone_hold_v1)
(extern i64 probe-clone-end :real et_g3c4_private_probe_clone_end_v1)
(extern i64 probe-clone-live ptr :real et_g3c4_private_probe_clone_live_v1)
(extern i64 probe-output-hold ptr :real et_g3c4_private_probe_output_hold_v1)
(extern i64 probe-output-end :real et_g3c4_private_probe_output_end_v1)
(extern i64 probe-output-live ptr :real et_g3c4_private_probe_output_live_v1)

(define checks 0)
(define (stage label count)
  (display "G3-C4 private owners STAGE: ")
  (display label)
  (display " count=")
  (display count)
  (newline)
  (flush-output-port (current-output-port)))
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "G3-C4 private owners FAIL: ")
             (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label (guard (caught (#t (transformer-error? caught)))
                 (thunk) #f)))
(define (config eos)
  (list ':profile 'diagnostic-c4 ':sampling 'greedy
        ':temperature-bits 1065353216 ':top-k 256
        ':top-p-bits 1065353216 ':max-new-tokens 2
        ':eos eos ':seed 17))

(stage "setup begin" 0)
(define tokenizer
  (t1-private-register-core
    (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-model-create-seeded-internal 1729))
(define input
  (g3c4-p2g2-owned-input-create
    (t1-wave1-tokenizer-encode tokenizer (bytevector 0 255))))
(stage "setup complete" 0)

;;; Discover the authentic first selected ID, abort it, then replay the same
;;; seeded request with that exact ID as the configured EOS. No ID is injected
;;; into a terminal carrier.
(define first-id #f)
(stage "probe begin" 0)
(define probe-generator
  (g3c4-generator-create-internal model tokenizer (config #f)))
(check "first-ID probe abort"
  (g3c4-with-p2g2-prefix-call 'private-owners-probe
    probe-generator input (call)
    (let ((pending (g3c4-p2g2-terminal-pending-reserve! call)))
      (set! first-id
        (g3c4-p2g2-terminal-first-sample-decode! call pending))
      (g3c4-p2g2-terminal-pending-abort! call pending))))
(check "authentic first ID" (and (m3t-exact-i64? first-id)
                                  (>= first-id 0) (<= first-id 255)))
(check "probe generator closes"
  (g3c4-generator-close-internal! probe-generator))
(stage "probe complete" 0)

(define (case-run eos expected-count)
  (stage "case begin" expected-count)
  (let* ((generator
           (g3c4-generator-create-internal model tokenizer (config eos)))
         (shell (begin (stage "terminal commit" expected-count)
                       (g3c4-p2g2-terminal-commit-private! generator input)))
         (snapshot (begin (stage "terminal snapshot" expected-count)
                          (g3c4-p2g2-terminal-snapshot-private shell)))
         (source-entry
           (g3c4-p2g2-terminal-output-entry-live shell 'private-owners))
         (source-native (vector-ref source-entry 3))
         (count (g3c4-p2g2-terminal-snapshot-small-word snapshot 24))
         (first (g3c4-p2g2-terminal-snapshot-small-word snapshot 8))
         (second (g3c4-p2g2-terminal-snapshot-small-word snapshot 16))
         (ids (car (begin (stage "clone and readback" expected-count)
                          (g3c4-p2g2-terminal-ids-clone-private shell))))
         (entry (g3c4-p2g2-terminal-ids-entry-live ids 'private-owners))
         (native (vector-ref entry 3))
         (extent (+ 8 (* count 8)))
         (short-copy (make-bytevector extent 0)))
    (stage "clone readback complete" expected-count)
    (check "logical count" (= count expected-count))
    (check "clone allocation covers header and payload"
      (= (bytevector-length (vector-ref entry 8)) extent))
    (check "clone readback declares payload"
      (= (g3c4-p2g2-terminal-snapshot-small-word (vector-ref entry 8) 0)
         (* count 8)))
    (bytevector-u8-set! short-copy 0 (* count 8))
    (stage "negative short extent" expected-count)
    (check "native rejects payload-only passed extent"
      (not (= (g3c4-p2g2-native-terminal-ids-clone-copy
                native count short-copy (* count 8)) 0)))
    (check "short extent preserves declared header"
      (= (bytevector-u8-ref short-copy 0) (* count 8)))
    (check "short extent preserves payload"
      (and (= (bytevector-u8-ref short-copy 8) 0)
           (= (bytevector-u8-ref short-copy (- extent 1)) 0)))
    (check "first EOS truth value"
      (eq? (and (= first first-id) (= count 1))
           (if (= expected-count 1) #t #f)))
    (if (= count 1)
        (check "G1 zero physical second slot" (= second 0))
        (check "G2 cache length"
          (= (g3c4-p2g2-terminal-snapshot-small-word snapshot 32) 4)))
    (stage "terminal lease and release" expected-count)
    (check "hold genuine terminal output I1"
      (= (probe-output-hold source-native) 0))
    (reject "held terminal release leaves owner live"
      (lambda () (g3c4-p2g2-terminal-release-private! shell)))
    (check "held native terminal output still live"
      (= (probe-output-live source-native) 0))
    (check "end genuine terminal output I1 lease"
      (= (probe-output-end) 0))
    (vector-set! source-entry 2 'dead)
    (reject "forged terminal dead does not skip native release"
      (lambda () (g3c4-p2g2-terminal-release-private! shell)))
    (check "forged terminal dead left native output live"
      (= (probe-output-live source-native) 0))
    (vector-set! source-entry 2 'live)
    (check "source release zero"
      (g3c4-p2g2-terminal-release-private! shell))
    (check "native terminal output is dead"
      (= (probe-output-live source-native) 1))
    (check "source repeat release"
      (g3c4-p2g2-terminal-release-private! shell))
    (stage "clone copy after source release" expected-count)
    (check "clone copy after source release"
      (= (bytevector-length (g3c4-p2g2-terminal-ids-copy-private ids))
         extent))
    (stage "clone lease and release" expected-count)
    (check "hold genuine clone I1" (= (probe-clone-hold native) 0))
    (reject "held clone release leaves owner live"
      (lambda () (g3c4-p2g2-terminal-ids-release-private! ids)))
    (check "held native clone still live" (= (probe-clone-live native) 0))
    (check "end genuine clone I1 lease" (= (probe-clone-end) 0))
    (vector-set! entry 2 'dead)
    (reject "forged dead does not skip native release"
      (lambda () (g3c4-p2g2-terminal-ids-release-private! ids)))
    (check "forged dead left native clone live"
      (= (probe-clone-live native) 0))
    (vector-set! entry 2 'live)
    (check "restored owner releases native clone"
      (g3c4-p2g2-terminal-ids-release-private! ids))
    (check "native clone is dead" (= (probe-clone-live native) 1))
    (check "exact same-shell dead repeat"
      (g3c4-p2g2-terminal-ids-release-private! ids))
    (check "generator closes" (g3c4-generator-close-internal! generator))
    (stage "case complete" expected-count)))

(case-run first-id 1)
(case-run #f 2)
(check "input release" (generation-tensor-release-internal! input))
(display "G3-C4 private owners PASS: checks=")
(display checks)
(newline)
