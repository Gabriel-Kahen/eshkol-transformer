(define (config rng?)
  (list ':profile 'diagnostic-c4-p2g2 ':sampling 'greedy ':temperature-bits 1065353216
        ':top-k 256 ':top-p-bits 1065353216 ':max-new-tokens 2 ':eos 255
        (if rng? ':rng ':seed) (if rng? rng-shell 1729)))
(define (setup)
  (set! fault 'none) (set! region '()) (set! events '())
  (set! detach-count 0) (set! commit-count 0) (set! generator-count 0) (set! adopt-count 0)
  (let* ((shell (vector #f)) (owner (vector 'owner)) (capability (vector owner))
         (model (vector 'canonical-C4 'train (vector 11 22 33)))
         (handles (list->vector (map (lambda (i) (vector 'handle i)) (iota 14))))
         (entry (vector model 'c4-model 'live owner 'seeded (vector 1 1729 0 0)
                        (vector 1 1729 292 0) #f handles #f #f g3c4-model-profile))
         (base (vector shell 'unpublished capability owner entry 'i2 'p1 'sidecar #f #f #f #f))
         (native-o2 (vector 'live)) (optimizer (vector 'O2-shell))
         (optimizer-record (vector optimizer native-o2 'config 'paths 'aliases (vector->list handles)))
         (binding (vector 'live)) (trainer (vector 'trainer))
         (child (vector cpu4-owned-tag #f (vector 'child-token) 'open #f shell optimizer optimizer-record
                        native-o2 binding trainer #f #f handles #f)))
    (vector-set! shell 0 shell) (vector-set! child 1 child)
    (set! trainer-record (make-vector 22 #f))
    (vector-set! trainer-record 2 trainer) (vector-set! trainer-record 3 'idle)
    (vector-set! trainer-record 8 model) (vector-set! trainer-record 9 binding)
    (vector-set! trainer-record 15 dataset)
    (set! training-row (vector trainer-record tokenizer-t2 'T2-entry))
    (vector-set! registry 0 (list base)) (vector-set! g3c4-model-registry 0 (list entry))
    (vector-set! cpu4-owned-candidates 0 (list child))
    (set! o2-optimizers (list optimizer-record))
    (set! factory-row (make-vector 19 #f))
    (vector-set! factory-row 0 cpu4-checkpoint-factory-tag)
    (vector-set! factory-row 1 factory-row) (vector-set! factory-row 2 factory-ticket)
    (vector-set! cpu4-checkpoint-factories 0 (list factory-row))
    (vector-set! factory-row 3 'ready) (vector-set! factory-row 14 (vector-ref child 2))
    (vector-set! factory-row 15 trainer)
    (vector-set! g3c4-registry 0 '())
    (vector-set! g3c4-public-g2-generator-rows 0 '())
    (vector-set! g3c4-public-g2-generator-anchors 0 '())
    (vector-set! g3c4-public-g2-generator-bindings 0 '())
    (set! cpu4-handoffs (vector '()))
    child))
(define (caught thunk) (guard (error (#t error)) (thunk) #f))
(define (start child cfg cell)
  (cpu4-owned-generator-handoff-internal! (vector-ref child 2) tokenizer-t1 cfg cell))
(define (payload child) (vector-ref (vector-ref (vector-ref (car (vector-ref registry 0)) 4) 0) 2))

;; Original nonfalse candidate path stays unsupported and unchanged.
(let* ((child (setup)) (cell (vector #f)))
  (check "ordinary nonfalse adopt remains unsupported"
    (caught (lambda () (cpu4-candidate-adopt-internal! (vector-ref child 5) #t))))
  (set! region (vector 'real-region-double))
  (check "regional create rejects" (caught (lambda () (start child (config #f) cell))))
  (check "regional create preserves all authority before publication"
    (and (not (vector-ref cell 0)) (null? (vector-ref cpu4-handoffs 0))
         (not (vector-ref child 12)) (= detach-count 0) (= commit-count 0)))
  (set! region '())
  (check "training T2 is not silently accepted as generation T1"
    (caught (lambda () (cpu4-owned-generator-handoff-internal! (vector-ref child 2) tokenizer-t2 (config #f) cell))))
  (check "bad policy rejects before detach"
    (caught (lambda () (start child '(bad) cell))))
  (check "early rejection leaves TRAIN and child unclaimed" (and (not (vector-ref child 12)) (= detach-count 0))))
;; Every failure phase preserves exact model payload/handles; retry skips
;; already-completed destruction/detach and retains the exact new generator.
(for-each
 (lambda (point)
  (let* ((child (setup)) (cfg (config #f)) (cell (vector #f))
         (values (payload child)) (handles (vector-ref child 13)))
    (set! fault point)
    (let ((error (caught (lambda () (start child cfg cell)))))
      (if (not (vector-ref cell 0)) (begin (display "EARLY-HOST-FAIL ") (display point) (display " ") (display error) (newline)))
      (check "phase failure raises" error))
    (check "failure retains registered recovery and claimed child"
      (and (vector-ref cell 0) (vector-ref child 12) (eq? values (payload child))))
    (let* ((row (cpu4-handoff-row (vector-ref cell 0) 'test))
           (before-generator (vector-ref row 14)) (before-detach detach-count)
           (before-commit commit-count))
      (check "failure reached exact requested ownership phase"
        (eq? (vector-ref row 3)
          (cond ((memq point '(preflight detach)) 'training)
                ((eq? point 'commit) 'detached)
                ((eq? point 'eval) 'optimizer-retired)
                ((eq? point 'generator) 'eval)
                (else 'generator-owned))))
      (check "error envelope preallocated and recorded" (vector-ref (vector-ref row 16) 0))
      (set! region (vector 'regional-retry))
      (let ((before events))
        (check "regional retry rejects before native work" (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
        (check "regional retry preserves exact state" (eq? before events)))
      (set! region '()) (set! fault 'none)
      ;; A new independent optimizer changes the old head splice. Retry MUST
      ;; recompute its actual predecessor, preserving exact unrelated cells.
      (let* ((other (vector (vector 'other-shell) (vector 'other-native) #f #f #f '()))
             (other-cell (cons other o2-optimizers)))
        (set! o2-optimizers other-cell)
        (let ((result (cpu4-generator-handoff-retry-internal! (vector-ref cell 0))))
          (check "same canonical model returned" (eq? (vector-ref result 0) (vector-ref row 6)))
          (check "model values and handles preserved" (and (eq? values (payload child)) (eq? handles (vector-ref child 13))))
          (check "unrelated optimizer exact membership preserved"
            (and (eq? other-cell o2-optimizers) (eq? (car o2-optimizers) other) (null? (cdr o2-optimizers))))
          (check "ownership tombstone prevents later destruction" (and (eq? (vector-ref child 3) 'dead) (not (vector-ref child 12))))
          (check "caller T2/D2 preserved" (and (eq? (vector-ref row 19) tokenizer-t2) (eq? (vector-ref row 20) dataset) (eq? (vector-ref dataset 1) 'live)))
          (if before-generator (check "adopt retry retains EXACT new generator" (eq? before-generator (vector-ref result 1))))
          (if (> before-detach 0) (check "detached11 skips repeated detach" (= before-detach detach-count)))
          (if (memq point '(eval generator adopt)) (check "retired O2 never destroyed again" (= before-commit commit-count)))
          (check "successful retry returns same preallocated pair" (eq? result (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))))))
 '(preflight detach commit eval generator adopt))
;; Detached accepted config survives caller list mutation. Internal forgery and
;; source RNG word mutation reject before any further native adoption.
(let* ((child (setup)) (cfg (config #f)) (cell (vector #f)))
  (set! fault 'generator) (caught (lambda () (start child cfg cell)))
  (set-car! (list-tail cfg 15) 9999)
  (set! fault 'none)
  (cpu4-generator-handoff-retry-internal! (vector-ref cell 0))
  (check "retry uses detached original seed, not caller mutation" (= (list-ref generated-config 15) 1729)))
(let* ((child (setup)) (cell (vector #f)))
  (set! fault 'preflight) (caught (lambda () (start child (config #f) cell)))
  (let* ((row (cpu4-handoff-row (vector-ref cell 0) 'test))
         (record (vector-ref child 7)) (original o2-optimizers)
         (alias (vector (vector-ref record 0) (vector 'other-native) #f #f #f '())))
    (set! fault 'none) (set! o2-optimizers (cons alias original))
    (check "optimizer shell alias rejects before detach"
      (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
    (check "alias rejection retains TRAIN and exact child" (and (= detach-count 0) (not (vector-ref child 11))))
    (set! o2-optimizers original)
    (set-car! (list-tail (vector-ref row 9) 15) 9999)
    (check "internal config substitution rejects before detach"
      (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
    (check "substitution leaves native state unchanged" (and (= detach-count 0) (= commit-count 0)))
    (set-car! (list-tail (vector-ref row 9) 15) 1729)
    (vector-set! row 18 #t)
    (check "same-ticket concurrent retry rejects" (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
    (vector-set! row 18 #f)
    (cpu4-generator-handoff-retry-internal! (vector-ref cell 0))))
(let* ((child (setup)) (cell (vector #f)))
  (set! fault 'adopt) (caught (lambda () (start child (config #t) cell)))
  (let ((row (cpu4-handoff-row (vector-ref cell 0) 'test)) (before adopt-count))
    (vector-set! rng-native 2 44) (set! fault 'none)
    (check "changed RNG words reject without seed substitution" (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
    (check "RNG mismatch never reaches native adopt" (= before adopt-count))
    (vector-set! rng-native 2 2)
    (let* ((entry (g3c4-registry-find (vector-ref row 14) 'test))
           (profile (g3c4-public-g2-profile-live (vector-ref row 14) 'test))
           (original (vector-ref profile 1)) (fake (vector-copy entry)))
      (vector-set! profile 1 fake)
      (check "caller-shaped full12 entry fails actual public registry authentication"
        (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
      (check "forgery never reaches typed native adoption" (= before adopt-count))
      (vector-set! profile 1 original)
      (vector-set! entry 6 tokenizer-t2)
      (check "wrong generation tokenizer crosslink rejects"
        (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
      (check "wrong tokenizer never reaches native adopt" (= before adopt-count))
      (vector-set! entry 6 tokenizer-t1)
      (cpu4-generator-handoff-retry-internal! (vector-ref cell 0)))))
(let* ((child (setup)) (cell (vector #f)) (raised? #f))
  (set! fault 'eval-false)
  (guard (caught (#t (set! raised? #t))) (start child (config #f) cell))
  (let ((row (cpu4-handoff-row (vector-ref cell 0) 'test)))
    (check "raisedfalse retained without allocating an exception envelope"
      (and raised? (vector-ref (vector-ref row 16) 0) (eq? (vector-ref (vector-ref row 16) 1) #f)))
    (set! fault 'none) (cpu4-generator-handoff-retry-internal! (vector-ref cell 0))))
(let* ((child (setup)) (cell (vector #f)))
  (set! fault 'adopt)
  (caught (lambda () (cpu4-checkpoint-factory-generator-handoff-internal! factory-ticket tokenizer-t1 (config #f) cell)))
  (check "pending factory retire cannot destroy handoff-owned model"
    (caught (lambda () (cpu4-checkpoint-factory-retire-internal! factory-ticket))))
  (check "pending failed factory retire retains handoff claim" (vector-ref child 12))
  (set! fault 'none)
  (let ((result (cpu4-generator-handoff-retry-internal! (vector-ref cell 0))))
  (check "factory convenience preserves same model" (eq? (vector-ref result 0) (vector-ref (cpu4-handoff-row (vector-ref cell 0) 'test) 6)))
  (check "later factory retire is idempotent ownership cleanup" (cpu4-checkpoint-factory-retire-internal! factory-ticket))
  (check "adopted public generator still authentic after factory retire" (g3c4-public-g2-profile-live (vector-ref result 1) 'test))
  (check "foreign retry ticket rejects" (caught (lambda () (cpu4-generator-handoff-retry-internal! (vector 'fake)))))))
(display "CPU4 actual closed handoff/base/plan host PASS: checks=") (display checks) (newline)
