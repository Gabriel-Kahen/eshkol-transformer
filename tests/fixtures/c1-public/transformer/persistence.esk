;;; Frozen C1 public persistence facade for predecessor aggregate tests.
;;; Later public checkpoint operations require the C2 aggregate and must not
;;; leak into Wave 1 or pre-C2 Wave 2 link tests.

(require transformer.error_consumer)

(provide persistence-policy)

(define t1-safe-persistence-policy
  (let ()
    (extern void t1-public-persistence-policy ptr ptr ptr ptr ptr ptr
            :real et_e1b_public_c1_persistence_policy_v1)
    (lambda (max-file max-metadata max-tensor max-tensors device)
      (let ((output (vector #f)))
        (t1-public-persistence-policy
          (vector max-file) (vector max-metadata) (vector max-tensor)
          (vector max-tensors) (vector device) output)
        (vector-ref output 0)))))

(define (persistence-policy max-file max-metadata max-tensor max-tensors device)
  (t1-safe-persistence-policy
    max-file max-metadata max-tensor max-tensors device))
