;;; Loaded after the private test root's genuine T1 and generated D2 sources.
(extern i64 e3-d2-test-dataset-live :real et_d2_dataset_test_live_count_v1)
(extern i64 e3-d2-native-idle ptr :real et_e3_d2_dataset_idle_preflight_v1)
(define passed 0)
(define failed 0)
(define (check name condition)
  (if condition (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1))
             (display "FAIL: ") (display name) (newline))))
(define (rejected? category thunk)
  (guard (caught
          (#t (and (transformer-error? caught)
                   (eq? category (transformer-error-category caught))
                   (eq? 'token-dataset-open
                        (transformer-error-operation caught)))))
    (thunk) #f))
(define root (car (cdr (command-line))))
(define (path leaf) (string-append root "/" leaf))
(define config
  (x1-private-config-resolve
   (x1-private-config-parse
    "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":8,\"model.hidden-size\":8,\"model.layer-count\":1,\"model.query-head-count\":1,\"model.vocabulary-size\":256,\"run.seed\":0}")
   '()))
(define tokenizer (t1-wave1-tokenizer-byte config))
(define policy (c1-wave1-persistence-policy 1048576 1048576 1048576 1 'cpu))
(define (load-profile name)
  (t1-wave1-tokenizer-load (path (string-append name ".tsv")) policy))
(define raw (load-profile "raw"))
(define strict (load-profile "strict"))
(define special (load-profile "special"))
(define prefix (load-profile "prefix"))
(define suffix (load-profile "suffix"))
(define identity (e3-d2-byte-identity tokenizer))
(define another (e3-d2-byte-identity tokenizer))
(define expected (t1-wave1-tokenizer-fingerprint tokenizer))
(check "canonical constructor admitted" (= (vector-ref identity 1) 256))
(check "canonical fingerprint preserved" (string=? (vector-ref identity 0) expected))
(check "identity vector detached" (not (eq? identity another)))
(check "fingerprint detached" (not (eq? (vector-ref identity 0) (vector-ref another 0))))
(vector-set! identity 1 1)
(check "returned vector mutation cannot alter identity"
       (= (vector-ref (e3-d2-byte-identity tokenizer) 1) 256))
(check "persistence-loaded raw admitted"
       (string=? (vector-ref (e3-d2-byte-identity raw) 0) expected))
(check "canonical T1 save succeeds"
       (t1-wave1-tokenizer-save tokenizer (path "saved.tsv") policy))
(define saved (t1-wave1-tokenizer-load (path "saved.tsv") policy))
(check "saved and reloaded identity authenticates"
       (string=? (vector-ref (e3-d2-byte-identity saved) 0) expected))
(check "strict has same V256" (= (t1-wave1-tokenizer-vocab-size strict) 256))
(check "strict actual fingerprint differs"
       (not (string=? expected (t1-wave1-tokenizer-fingerprint strict))))
(define (reject-profile name value)
  (check name (rejected? 'unsupported (lambda () (e3-d2-byte-identity value)))))
(reject-profile "authentic strict rejects" strict)
(reject-profile "authentic specials reject" special)
(reject-profile "authentic prefix rejects" prefix)
(reject-profile "authentic suffix rejects" suffix)
(define core (t1-private-require-core tokenizer 'token-dataset-open 'invalid-argument))
(define copied-core (make-vector 8 #f))
(let copy ((index 0))
  (if (< index 8)
      (begin (vector-set! copied-core index (vector-ref core index))
             (copy (+ index 1)))))
(define (reject-foreign name value)
  (check name (rejected? 'invalid-argument (lambda () (e3-d2-byte-identity value)))))
(reject-foreign "foreign same-spelling shell rejects" (t1-private-make-shell))
(reject-foreign "wrong-kind policy rejects" policy)
(reject-foreign "wrong-kind config rejects" config)
(reject-foreign "bare canonical core rejects" core)
(reject-foreign "copied core and authentic tag reject" copied-core)
(reject-foreign "copied registry entry rejects"
  (let ((entry (t1-private-entry tokenizer)))
    (list (car entry) (car (cdr entry)))))
(reject-foreign "V-only identity rejects" (vector expected 256))
(reject-foreign "false rejects" #f)
(define (dataset-config leaf)
  (list ':directory (path leaf) ':batch-size 1 ':sequence-length 2
        ':maximum-manifest-bytes 1048576 ':maximum-shard-bytes 1048576
        ':maximum-total-tokens 65536 ':maximum-batch-bytes 34
        ':shuffle-seed #f ':shuffle-window-rows 1 ':packing? #t))
(check "native registry starts empty" (= (e3-d2-test-dataset-live) 0))
(define (check-open name token)
  (let ((dataset (d2-token-dataset-open (dataset-config "matching") token)))
    (check name (= (e3-d2-test-dataset-live) 1))
    (check "authentic Eshkol owner is idle" (= (e3-d2-native-idle dataset) 0))
    (with-region
      (let ((batch (d2-token-dataset-next-batch dataset)))
        (check "authentic live batch rejects idle" (= (e3-d2-native-idle dataset) 2))
        (check "authentic active lease rejects idle"
               (d2-token-tensor-with-view-internal
                (d2-token-batch-inputs batch)
                (lambda (view) (= (e3-d2-native-idle dataset) 2))))
        (d2-token-batch-release! batch)
        (check "released batch restores idle admission" (= (e3-d2-native-idle dataset) 0))))
    (check "close authentic dataset" (d2-token-dataset-close! dataset))
    (check "close retires enrollment" (= (e3-d2-test-dataset-live) 0))
    (check "closed Eshkol owner rejects idle" (= (e3-d2-native-idle dataset) 1))))
(check-open "constructor opens matching D1" tokenizer)
(check-open "loaded raw opens matching D1" raw)
(check-open "saved reloaded raw opens matching D1" saved)
(define (reject-open name leaf token category)
  (check name (rejected? category
               (lambda () (d2-token-dataset-open (dataset-config leaf) token))))
  (check "rejection publishes no dataset" (= (e3-d2-test-dataset-live) 0)))
(reject-open "D1 fingerprint mismatch preserved" "wrong-fingerprint" tokenizer 'invalid-argument)
(reject-open "D1 vocab mismatch preserved" "wrong-vocab" tokenizer 'invalid-argument)
(reject-open "D2 strict admission fails before missing path" "missing" strict 'unsupported)
(reject-open "D2 foreign admission fails before missing path" "missing" #f 'invalid-argument)
(check-open "mismatch permits later valid open" tokenizer)
(if (= failed 0)
    (begin (display "E3 D2 IDENTITY PASS: ") (display passed)
           (display " genuine T1/generated-D2 checks") (newline))
    (exit 1))
