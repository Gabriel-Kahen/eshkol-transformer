(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "cpu4_candidate_extension.esk")

(define checks 0)
(define (check label good)
  (if good (set! checks (+ checks 1))
      (begin (display "CPU4 candidate FAIL: ") (display label) (newline) (exit 1))))
(define (reject label thunk)
  (check label (guard (caught (#t (transformer-error? caught))) (thunk) #f)))
(define resolved
  (x1-private-config-resolve
    (x1-private-config-parse
      "{\"config-schema-major\":1,\"config-schema-minor\":0,\"model.context-length\":4,\"model.hidden-size\":4,\"model.layer-count\":1,\"model.query-head-count\":2,\"model.vocabulary-size\":256,\"run.seed\":1729}")
    '()))
(define (payloads entry)
  (let ((handles (vector-ref entry 8)) (result (make-vector 14 #f)))
    (let loop ((index 0))
      (if (= index 14) result
          (let* ((handle (vector-ref handles index))
                 (carrier (parameter-handle-tensor-identity-internal handle))
                 (sum (i2-native-borrow-checksum (vector-ref carrier 2) 1 handle)))
            (check "genuine parameter checksum" (>= sum 0))
            (vector-set! result index sum)
            (loop (+ index 1)))))))
(define (model-entry model)
  (let find ((rows (vector-ref g3c4-model-registry 0)))
    (cond ((null? rows) (exit 1))
          ((eq? model (vector-ref (car rows) 0)) (car rows))
          (else (find (cdr rows))))))
(define (capture-cells count chain)
  (if (= count 0) '()
      (cons (vector chain (car chain) (vector-ref (car chain) 0))
            (capture-cells (- count 1) (cdr chain)))))
(define (cell-present? cell chain)
  (and (pair? chain) (or (eq? cell chain) (cell-present? cell (cdr chain)))))
(define (independent-cells-live? rows)
  (if (null? rows) #t
      (let ((row (car rows)))
        (and (cell-present? (vector-ref row 0) (i2-modules-current))
             (eq? (car (vector-ref row 0)) (vector-ref row 1))
             (eq? (vector-ref (vector-ref row 1) 0) (vector-ref row 2))
             (independent-cells-live? (cdr rows))))))
(define (order-test retire-head?)
  (let* ((baseline i2-module-count)
         (a (cpu4-candidate-model-create-internal! resolved))
         (model-a (cpu4-candidate-model-internal a))
         (cells-a (capture-cells 17 (i2-modules-current)))
         (b (cpu4-candidate-model-create-internal! resolved))
         (model-b (cpu4-candidate-model-internal b))
         (cells-b (capture-cells 17 (i2-modules-current)))
         (first (if retire-head? b a)) (second (if retire-head? a b))
         (second-model (if retire-head? model-a model-b))
         (second-cells (if retire-head? cells-a cells-b))
         (entry (model-entry second-model))
         (handles (vector-ref entry 8))
         (before (payloads entry)))
    (check "same ordinary authority slot7 false" (eq? (vector-ref entry 7) #f))
    (reject "foreign candidate" (lambda () (cpu4-candidate-retire-internal! (vector #f))))
    (reject "generator adoption unsupported" (lambda () (cpu4-candidate-adopt-internal! first #t)))
    (vector-set! first 0 second)
    (reject "candidate self forgery" (lambda () (cpu4-candidate-retire-internal! first)))
    (vector-set! first 0 first)
    (check "retire one graph" (cpu4-candidate-retire-internal! first))
    (check "independent exact I2 cells and roots survive" (independent-cells-live? second-cells))
    (check "independent exact handle vector survives" (eq? handles (vector-ref entry 8)))
    (check "independent payload words survive" (equal? before (payloads entry)))
    (check "independent graph remains usable" (= (length (parameter-tree-paths (module-parameters second-model))) 15))
    (check "independent graph is retirable after prior splice" (cpu4-candidate-retire-internal! second))
    (check "exact dead repeat" (cpu4-candidate-retire-internal! first))
    (check "membership count restored exactly" (= baseline i2-module-count))))
(order-test #f)
(order-test #t)
(define ordinary (g3c4-model-create-seeded-internal 1729))
(reject "ordinary shell cannot retire" (lambda () (cpu4-candidate-retire-internal! ordinary)))
(define adopted (cpu4-candidate-model-create-internal! resolved))
(define same-model (cpu4-candidate-model-internal adopted))
(check "adoption returns original shell" (eq? same-model (cpu4-candidate-adopt-internal! adopted #f)))
(reject "adopted candidate cannot retire" (lambda () (cpu4-candidate-retire-internal! adopted)))
(check "adopted graph remains usable" (= (length (parameter-tree-paths (module-parameters same-model))) 15))
(display "CPU4 genuine candidate producer PASS: checks=") (display checks) (newline)
