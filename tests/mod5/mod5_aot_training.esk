;;; One pre-norm decoder block. Eshkol tensors own projections, residuals,
;;; loss, gradient composition and SGD. The transport borrows f32 work buffers.
(extern ptr allocate i64 :real malloc)
(extern void release ptr :real free)
(extern i32 open-mod5 ptr :real et_mod5_aot_open)
(extern void close-mod5 ptr :real et_mod5_aot_close)
(extern void store-f32 ptr i64 f64 :real et_mod5_aot_store_f32)
(extern f64 load-f32 ptr i64 :real et_mod5_aot_load_f32)
(extern i32 rms-forward ptr ptr ptr ptr ptr :real et_mod5_aot_rms_forward)
(extern i32 rms-backward ptr ptr ptr ptr ptr ptr ptr :real et_mod5_aot_rms_backward)
(extern i32 glu-forward ptr ptr ptr ptr :real et_mod5_aot_swiglu_forward)
(extern i32 glu-backward ptr ptr ptr ptr ptr ptr :real et_mod5_aot_swiglu_backward)
(extern i32 attention-forward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr
        :real et_mod5_aot_attention_forward)
(extern i32 attention-backward ptr i64 ptr ptr ptr ptr ptr ptr ptr i64 ptr ptr ptr ptr
        :real et_mod5_aot_attention_backward)

;; Reify raw addresses at extern call sites on the pinned LLVM backend.
(define-syntax ffi-pointer
  (syntax-rules ()
    ((_ p) (ptr-add p 0))))

(define tokens 8)
(define width 16)
(define hidden 32)
(define query-heads 4)
(define head-width 4)
(define window 4)
(define steps 16)
(define epsilon 0.125)
(define learning-rate 2.0)
(define inverse-elements (/ 1.0 (* tokens width)))

(define (expect-status operation expected actual)
  (unless (= actual expected)
    (display operation) (display " expected status ") (display expected)
    (display ", received ") (display actual) (newline) (exit 1)))

(define (require-check label ok)
  (unless ok (display label) (newline) (exit 1)))

(define (checked-allocate size)
  (let ((p (allocate size)))
    (require-check "MOD5 workspace allocation failed" (not (= (ptr->usize p) 0)))
    p))

;; One aligned block of seven disjoint f32 spans sized for the widest tensor.
(define span-bytes (* 4 tokens hidden))
(define workspace (checked-allocate (* 7 span-bytes)))
(define input-a workspace)
(define input-b (ptr-add workspace span-bytes))
(define input-c (ptr-add workspace (* 2 span-bytes)))
(define upstream (ptr-add workspace (* 3 span-bytes)))
(define output-a (ptr-add workspace (* 4 span-bytes)))
(define output-b (ptr-add workspace (* 5 span-bytes)))
(define output-c (ptr-add workspace (* 6 span-bytes)))
(define query-positions (checked-allocate (* tokens 8)))
(define key-positions (checked-allocate (* tokens 8)))
(define keep-mask (checked-allocate (* tokens tokens)))
(define slopes (checked-allocate (* query-heads 4)))
(define epsilon-buffer (checked-allocate 4))
(define runtime-cell (checked-allocate 8))
(expect-status "K1 discovery" 0 (open-mod5 runtime-cell))
(define runtime (volatile-load ptr runtime-cell))
(release runtime-cell)

(do ((t 0 (+ t 1)))
    ((= t tokens))
  (volatile-store! i64 (ptr-add query-positions (* 8 t)) t)
  (volatile-store! i64 (ptr-add key-positions (* 8 t)) t))
(do ((i 0 (+ i 1)))
    ((= i (* tokens tokens)))
  (volatile-store! u8 (ptr-add keep-mask i) (if (= (modulo (+ i 3) 11) 0) 0 1)))
(do ((h 0 (+ h 1)))
    ((= h query-heads))
  (store-f32 slopes h (* 0.125 (+ h 1))))

(define (pack tensor buffer)
  (let* ((count (tensor-length tensor))
         (flat (reshape tensor (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count))
      (store-f32 (ffi-pointer buffer) i (tensor-ref flat i)))))

(define (unpack buffer rows cols)
  (let* ((count (* rows cols))
         (flat (zeros (list count))))
    (do ((i 0 (+ i 1)))
        ((= i count) (reshape flat (list rows cols)))
      (tensor-set! flat i (load-f32 (ffi-pointer buffer) i)))))

;; Attention uses [head,token,feature] while the residual stream is token-major.
(define (pack-heads tensor heads buffer)
  (do ((h 0 (+ h 1)))
      ((= h heads))
    (do ((t 0 (+ t 1)))
        ((= t tokens))
      (do ((d 0 (+ d 1)))
          ((= d head-width))
        (store-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d)
                   (tensor-get tensor t (+ (* h head-width) d)))))))

(define (unpack-heads buffer heads)
  (let ((tensor (zeros (list tokens (* heads head-width)))))
    (do ((h 0 (+ h 1)))
        ((= h heads) tensor)
      (do ((t 0 (+ t 1)))
          ((= t tokens))
        (do ((d 0 (+ d 1)))
            ((= d head-width))
          (tensor-set! tensor t (+ (* h head-width) d)
                       (load-f32 (ffi-pointer buffer) (+ (* (+ (* h tokens) t) head-width) d))))))))

(define (rms x gamma)
  (pack x input-a)
  (pack gamma input-b)
  (expect-status "RMSNorm forward" 0
                 (rms-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (unpack output-a tokens width))

(define (rms-grad x gamma dy)
  (pack x input-a)
  (pack gamma input-b)
  (pack dy upstream)
  (expect-status "RMSNorm backward" 0
                 (rms-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens width) (unpack output-b 1 width)))

(define (glu gate up)
  (pack gate input-a)
  (pack up input-b)
  (expect-status "SwiGLU forward" 0
                 (glu-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer output-a)))
  (unpack output-a tokens hidden))

(define (glu-grad gate up dy)
  (pack gate input-a)
  (pack up input-b)
  (pack dy upstream)
  (expect-status "SwiGLU backward" 0
                 (glu-backward (ffi-pointer runtime) (ffi-pointer input-a)
                               (ffi-pointer input-b) (ffi-pointer upstream)
                               (ffi-pointer output-a) (ffi-pointer output-b)))
  (vector (unpack output-a tokens hidden) (unpack output-b tokens hidden)))

(define (pack-attention heads q k v)
  (pack-heads q query-heads input-a)
  (pack-heads k heads input-b)
  (pack-heads v heads input-c))

(define (attend heads q k v)
  (pack-attention heads q k v)
  (expect-status "attention forward" 0
                 (attention-forward (ffi-pointer runtime) heads
                                    (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                    (ffi-pointer query-positions) (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    window (ffi-pointer output-a)))
  (unpack-heads output-a query-heads))

(define (attend-grad heads q k v dy)
  (pack-attention heads q k v)
  (pack-heads dy query-heads upstream)
  (expect-status "attention backward" 0
                 (attention-backward (ffi-pointer runtime) heads
                                     (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                     (ffi-pointer query-positions) (ffi-pointer key-positions)
                                     (ffi-pointer keep-mask) (ffi-pointer slopes) window
                                     (ffi-pointer upstream) (ffi-pointer output-a)
                                     (ffi-pointer output-b) (ffi-pointer output-c)))
  (vector (unpack-heads output-a query-heads)
          (unpack-heads output-b heads)
          (unpack-heads output-c heads)))

;; Weight matrices use [input,output]. dx = dy * W^T and dW = x^T * dy.
(define (project x w) (matmul x w))
(define (project-dx w dy) (matmul dy (transpose w)))
(define (project-dw x dy) (matmul (transpose x) dy))

(define wq 0)
(define wk 1)
(define wv 2)
(define wo 3)
(define wgate 4)
(define wup 5)
(define wdown 6)
(define gamma1 7)
(define gamma2 8)
(define parameters 9)
(define input-gradient parameters)

(define (block-loss heads weights x target gradients)
  (let* ((q-weight (vector-ref weights wq))
         (k-weight (vector-ref weights wk))
         (v-weight (vector-ref weights wv))
         (o-weight (vector-ref weights wo))
         (gate-weight (vector-ref weights wgate))
         (up-weight (vector-ref weights wup))
         (down-weight (vector-ref weights wdown))
         (gamma-a (vector-ref weights gamma1))
         (gamma-b (vector-ref weights gamma2))
         (norm-a (rms x gamma-a))
         (q (project norm-a q-weight))
         (k (project norm-a k-weight))
         (v (project norm-a v-weight))
         (attn (attend heads q k v))
         (residual (tensor-add x (project attn o-weight)))
         (norm-b (rms residual gamma-b))
         (gate (project norm-b gate-weight))
         (up (project norm-b up-weight))
         (gated (glu gate up))
         (result (tensor-add residual (project gated down-weight)))
         (delta (tensor-sub result target))
         (loss (* 0.5 inverse-elements (tensor-sum (tensor-mul delta delta)))))
    (when gradients
      (let* ((dy (tensor-scale delta inverse-elements))
             (dgated (project-dx down-weight dy))
             (dglu (glu-grad gate up dgated))
             (dgate (vector-ref dglu 0))
             (dup (vector-ref dglu 1))
             (dnorm-b (tensor-add (project-dx gate-weight dgate) (project-dx up-weight dup)))
             (drms-b (rms-grad residual gamma-b dnorm-b))
             (dresidual (tensor-add dy (vector-ref drms-b 0)))
             (dattn (project-dx o-weight dresidual))
             (dqkv (attend-grad heads q k v dattn))
             (dq (vector-ref dqkv 0))
             (dk (vector-ref dqkv 1))
             (dv (vector-ref dqkv 2))
             (dnorm-a (tensor-add (tensor-add (project-dx q-weight dq) (project-dx k-weight dk))
                                  (project-dx v-weight dv)))
             (drms-a (rms-grad x gamma-a dnorm-a)))
        (vector-set! gradients wq (project-dw norm-a dq))
        (vector-set! gradients wk (project-dw norm-a dk))
        (vector-set! gradients wv (project-dw norm-a dv))
        (vector-set! gradients wo (project-dw attn dresidual))
        (vector-set! gradients wgate (project-dw norm-b dgate))
        (vector-set! gradients wup (project-dw norm-b dup))
        (vector-set! gradients wdown (project-dw gated dy))
        (vector-set! gradients gamma1 (vector-ref drms-a 1))
        (vector-set! gradients gamma2 (vector-ref drms-b 1))
        (vector-set! gradients input-gradient (tensor-add dresidual (vector-ref drms-a 0)))))
    loss))

(define (seed-tensor rows cols salt base scale)
  (let ((tensor (zeros (list rows cols))))
    (do ((r 0 (+ r 1)))
        ((= r rows) tensor)
      (do ((c 0 (+ c 1)))
          ((= c cols))
        (let* ((i (+ (* r cols) c))
               (seed (- (modulo (+ (* 29 salt) (* 11 i) (quotient i 5)) 37) 18)))
          (tensor-set! tensor r c (+ base (* scale seed))))))))

(define (initial-weights heads)
  (let ((kv-width (* heads head-width)))
    (vector (seed-tensor width width wq 0.0 0.0078125)
            (seed-tensor width kv-width wk 0.0 0.0078125)
            (seed-tensor width kv-width wv 0.0 0.0078125)
            (seed-tensor width width wo 0.0 0.0078125)
            (seed-tensor width hidden wgate 0.0 0.0078125)
            (seed-tensor width hidden wup 0.0 0.0078125)
            (seed-tensor hidden width wdown 0.0 0.0078125)
            (seed-tensor 1 width gamma1 1.0 0.0078125)
            (seed-tensor 1 width gamma2 1.0 0.0078125))))

(define (check-gradient heads weights x target operand derivative row col)
  (let* ((original (tensor-get operand row col))
         (step 0.001953125))
    (tensor-set! operand row col (+ original step))
    (let ((plus (block-loss heads weights x target #f)))
      (tensor-set! operand row col (- original step))
      (let* ((minus (block-loss heads weights x target #f))
             (numerical (/ (- plus minus) (* 2.0 step)))
             (analytic (tensor-get derivative row col)))
        (tensor-set! operand row col original)
        (require-check "MOD5 AOT central difference failed"
                       (<= (abs (- analytic numerical)) (+ 0.000001 (* 0.005 (abs numerical)))))))))

(define (check-gradients heads weights x target gradients)
  (do ((p 0 (+ p 1)))
      ((> p parameters))
    (let* ((operand (if (= p input-gradient) x (vector-ref weights p)))
           (gradient (vector-ref gradients p))
           (shape (tensor-shape operand))
           (rows (car shape))
           (cols (car (cdr shape))))
      (require-check "MOD5 AOT inactive gradient" (> (tensor-sum (tensor-abs gradient)) 0.00001))
      (check-gradient heads weights x target operand gradient 0 0)
      (check-gradient heads weights x target operand gradient (quotient rows 2) (quotient cols 2))
      (check-gradient heads weights x target operand gradient (- rows 1) (- cols 1)))))

(define (check-malformed-calls)
  ;; First lay out all inputs in the same shape used by successful calls.
  (pack (seed-tensor tokens width 0 0.0 0.0078125) input-a)
  (pack (seed-tensor 1 width 0 1.0 0.0) input-b)
  (store-f32 (ffi-pointer output-a) 0 7.0)
  (store-f32 (ffi-pointer epsilon-buffer) 0 -1.0)
  (expect-status "negative epsilon" 1
                 (rms-forward (ffi-pointer runtime) (ffi-pointer input-a)
                              (ffi-pointer input-b) (ffi-pointer epsilon-buffer)
                              (ffi-pointer output-a)))
  (store-f32 (ffi-pointer epsilon-buffer) 0 epsilon)
  (expect-status "unsupported KV heads" 6
                 (attention-forward (ffi-pointer runtime) 3
                                    (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                    (ffi-pointer query-positions) (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    window (ffi-pointer output-a)))
  (pack (zeros (list tokens 4)) input-b)
  (pack (zeros (list tokens 4)) input-c)
  (expect-status "negative window" 1
                 (attention-forward (ffi-pointer runtime) 1
                                    (ffi-pointer input-a) (ffi-pointer input-b) (ffi-pointer input-c)
                                    (ffi-pointer query-positions) (ffi-pointer key-positions)
                                    (ffi-pointer keep-mask) (ffi-pointer slopes)
                                    -1 (ffi-pointer output-a)))
  (require-check "MOD5 AOT negative call changed output" (= (load-f32 (ffi-pointer output-a) 0) 7.0))
  (display "MOD5 AOT malformed statuses PASS") (newline))

(define (print-loss variant step loss)
  (display "MOD5 AOT LOSS ") (display variant) (display " ")
  (display step) (display " ") (display (number->string loss)) (newline))

(define (parameter-checksum weights)
  (do ((p 0 (+ p 1))
       (total 0.0 (+ total (* (+ p 1) (tensor-sum (vector-ref weights p))))))
      ((= p parameters) total)))

(define (train variant heads)
  (let* ((weights (initial-weights heads))
         (x (seed-tensor tokens width 11 0.0 0.03125))
         (target (tensor-add (tensor-scale x 0.65) (seed-tensor tokens width 12 0.0 0.00390625)))
         (gradients (make-vector (+ parameters 1) #f))
         (initial (block-loss heads weights x target gradients))
         (initial-checksum (parameter-checksum weights)))
    (check-gradients heads weights x target gradients)
    (print-loss variant 0 initial)
    (do ((step 1 (+ step 1))
         (previous initial))
        ((> step steps)
         (let ((checksum (parameter-checksum weights)))
           (require-check "MOD5 AOT parameters did not change" (not (= checksum initial-checksum)))
           (display "MOD5 AOT RESULT ") (display variant)
           (display " initial=") (display (number->string initial))
           (display " final=") (display (number->string previous))
           (display " checksum=") (display (number->string checksum))
           (display " gradients=30") (newline)))
      (do ((p 0 (+ p 1)))
          ((= p parameters))
        (let ((derivative (vector-ref gradients p)))
          (require-check "MOD5 AOT nonfinite gradient" (< (tensor-sum (tensor-abs derivative)) 1.0e300))
          (vector-set! weights p (tensor-sub (vector-ref weights p)
                                             (tensor-scale derivative learning-rate)))))
      (let ((current (block-loss heads weights x target gradients)))
        (require-check "MOD5 AOT loss failed to decrease"
                       (and (>= current 0.0) (< current previous)))
        (print-loss variant step current)
        (set! previous current)))))

(check-malformed-calls)
(train "MQA" 1)
(train "GQA" 2)
(close-mod5 (ffi-pointer runtime))
(release workspace)
(release query-positions)
(release key-positions)
(release keep-mask)
(release slopes)
(release epsilon-buffer)
