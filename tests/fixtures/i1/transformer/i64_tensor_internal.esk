;;; Test-only canonical-AOT evidence facade for the native exact-i64 container.
;;; This module is intentionally outside lib/: it demonstrates only the fixed
;;; shapes and operations exercised by I1 tests and is not a production API.
;;; The C boundary is fixed-arity and uses only ptr/i64 carriers. Tensor element
;;; storage remains native; proper lists here carry shape metadata only.

(require transformer.error_internal)

(provide i64-tensor-create i64-tensor-destroy! i64-tensor-release!
         i64-tensor-rank i64-tensor-shape-at
         i64-tensor-stride-bytes-at i64-tensor-element-count
         i64-tensor-byte-length i64-tensor-copy-from4!
         i64-tensor-copy-to-count! i64-tensor-output-at
         i64-tensor-seed-output4! i64-tensor-borrow-begin!
         i64-tensor-borrow-begin-again! i64-tensor-borrow-write-first!
         i64-tensor-borrow-end! i64-tensor-borrow-dtype
         i64-tensor-borrow-device i64-tensor-borrow-layout
         i64-tensor-borrow-offset i64-tensor-borrow-rank
         i64-tensor-borrow-byte-length i64-tensor-ffi-call-count
         i64-tensor-abi-major i64-tensor-abi-minor
         i64-tensor-capability-name i64-tensor-capability-status
         i64-tensor-capability-operation i64-tensor-capability-dtype
         i64-tensor-capability-device
         i64-tensor-capability-deterministic
         i64-tensor-capability-version i64-tensor-capability-evidence
         i64-tensor-capability-shape-count
         i64-tensor-capability-shape0-rank
         i64-tensor-capability-shape1-rank
         i64-tensor-capability-shape1-min
         i64-tensor-capability-shape1-max)

;; The test bridge owns aligned native output/error slots and never passes
;; addr-of tagged Eshkol storage as a C output buffer.
(extern ptr i1-context-create :real et_i64_tensor_eshkol_context_create_v1)
(extern i64 i1-context-release ptr
        :real et_i64_tensor_eshkol_context_release_v1)
(extern i64 i1-context-prepare ptr i64
        :real et_i64_tensor_eshkol_context_prepare_v1)
(extern i64 i1-context-shape-set ptr i64 i64
        :real et_i64_tensor_eshkol_context_shape_set_v1)
(extern i64 i1-context-commit ptr
        :real et_i64_tensor_eshkol_context_commit_v1)
(extern i64 i1-context-destroy ptr
        :real et_i64_tensor_eshkol_context_destroy_tensor_v1)
(extern i64 i1-context-rank ptr
        :real et_i64_tensor_eshkol_context_rank_v1)
(extern i64 i1-context-shape-at ptr i64
        :real et_i64_tensor_eshkol_context_shape_at_v1)
