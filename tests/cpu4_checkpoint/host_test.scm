                            (eq? (cadr f) 'g3c4-model-paths))) g3c4-source)
      (current-module))
(define paths (vector->list g3c4-model-paths))
(define shapes '((4 4) (4 4) (4 4) (4 4) (4 8) (8 4) (4) (4) (4) (4)
                 (256 4) (4) (4) (4 4)))
(define cpu4-checkpoint-fixed-paths paths)
(define cpu4-checkpoint-fixed-shapes shapes)
(define cpu4-checkpoint-tied-secondary-path '("token_embedding" "weight"))
(define cpu4-checkpoint-tied-secondary-shape '(256 4))
(define (state-entry-path-internal x) (vector-ref x 0))
(define (state-entry-shape-internal x) (vector-ref x 1))
(define (state-entry-kind-internal x) 'parameter)
(define (state-entry-dtype-internal x) 'f32)
(define (state-entry-device-internal x) 'cpu)
(define (state-entry-layout-internal x) 'dense-row-major-contiguous)
(define aliases '((("head" "weight") ("token_embedding" "weight"))))
(define entries (append (map vector paths shapes)
                        (list (vector cpu4-checkpoint-tied-secondary-path '(256 4)))))
(define projection (vector 'transformer-state-dict '(1 0) '()
                           '(transformer-tensor-provider 2 0 i2-dense-cpu-f32-v1)
                           entries aliases))
(check "full15 source accepts actual C4 shape"
       (= 14 (length (cpu4-checkpoint-fixed-source! #f projection (vector paths shapes aliases)))))
(vector-set! (list-ref entries 13) 1 '(2 4))
(check "old context2 position rejected"
       (catch 'shape-mismatch
         (lambda () (cpu4-checkpoint-fixed-source! #f projection (vector paths shapes aliases)) #f)
         (lambda args #t)))
(vector-set! (list-ref entries 13) 1 '(4 4))
(define controls (vector #f #f (vector 'current 'epoch) #f (vector 0 0 0)))
(define control-row (vector #f #f #f #f #f 'active))
(define stage-row (vector #f #f #f #f 'staged))
(define (cpu4-control-parent-internal token operation) token)
(define (cpu4-control-stage-internal token operation) token)
(define (cpu4-trainer-control-begin-internal trainer kind)
  (set! control-row (vector #f #f #f #f #f 'active))
  (event 'begin) control-row)
(define (cpu4-trainer-controls-restore-stage-internal control copy)
  (set! stage-row (vector #f #f #f #f 'staged))
  (event 'stage) stage-row)
(define (cpu4-trainer-controls-restore-copy-internal stage) (event 'copy) controls)
(define (tr3-d2-restore-prepare-internal dataset current epoch)
  (event 'd2-prepare) (vector #f #f #f #f #f 'prepared))
(define (tr3-c-restore-o2-prepare-internal request)
  (event 'o2-prepare)
  (vector-set! request 6 (vector #f #f 'native-plan #f #f #f #f 'prepared)) request)
(define (tr3-c-restore-i2-create-internal o2)
  (event 'i2-create) (vector #f #f #f #f #f 'prefix))
(define (tr3-c-restore-i2-append-parameter-internal! i2 carrier handle source) (event 'parameter))
(define (tr3-c-restore-o2-append-internal! o2 i2) (event 'moments))
(define (cpu4-p1-fixed-recheck-internal . args) (event 'p1) 0)
