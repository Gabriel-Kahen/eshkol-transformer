;;; Private P1/G1 schedule over the accepted G3-T generated transaction.
(extern i64 g3m-native-full-request-preflight ptr ptr
        :real et_g3t_private_full_request_preflight_v1)

(define (g3m-generate-p1-g1! generator input)
  (let ((operation 'g3m-generate-p1-g1!))
    (m3-call operation
      (let* ((generator-entry (g3t-generator-find generator operation))
             (input-entry (g3t-prefill-entry input 'input operation)))
        (if (not (eq? (vector-ref generator-entry 1) 'generator))
            (g3t-fail-raw 'invalid-argument operation 1
                          "G3-M receiver must be a generator"))
        (if (not (and (eq? (vector-ref generator-entry 2) 'live)
                      (eq? (vector-ref input-entry 2) 'live)))
            (g3t-fail-raw 'invalid-state operation 2
                          "G3-M generator and input must be live"))
        (if (not (= 1 (vector-ref (vector-ref generator-entry 7) 5)))
            (g3t-fail-raw 'invalid-argument operation 3
                          "G3-M private route requires budget one"))
        (if (not (= 0 (g3m-native-full-request-preflight
                       (vector-ref generator-entry 3)
                       (vector-ref input-entry 3))))
            (g3t-native-fail-raw operation))
        (let ((call #f))
          (guard (caught
                   (#t (if call
                           (let ((entry (g3t-prefill-entry call 'call operation)))
                             (if (eq? (vector-ref entry 2) 'live)
                                 (g3t-call-abort call))))
                       (raise caught)))
            (set! call (g3t-call-acquire generator-entry 2))
            (let ((output (g3t-output-reserve call 1)))
              (g3t-frame-begin call input 1)
              (g3t-role-step call 0)
              (g3t-role-step call 1)
              (g3t-role-step call 2)
              (g3t-role-step call 3)
              (g3t-role-step call 4)
              (g3t-role-step call 5)
              (g3t-role-step call 6)
              (g3t-role-step call 7)
              (g3t-role-step call 8)
              (g3t-role-step call 9)
              (g3t-role-step call 10)
              (g3t-role-step call 11)
              (g3t-role-step call 12)
              (g3t-role-step call 13)
              (g3t-role-step call 14)
              (g3t-role-step call 15)
              (g3t-role-step call 16)
              (g3t-role-step call 17)
              (g3t-role-step call 18)
              (g3t-role-step call 19)
              (g3t-role-step call 20)
              (g3t-frame-prepare call #f)
              (g3t-frame-commit call)
              (g3t-sample call)
              (g3t-frame-begin call #f 2)
              (g3t-role-step call 0)
              (g3t-role-step call 1)
              (g3t-role-step call 2)
              (g3t-role-step call 3)
              (g3t-role-step call 4)
              (g3t-role-step call 5)
              (g3t-role-step call 6)
              (g3t-role-step call 7)
              (g3t-role-step call 8)
              (g3t-role-step call 9)
              (g3t-role-step call 10)
              (g3t-role-step call 11)
              (g3t-role-step call 12)
              (g3t-role-step call 13)
              (g3t-role-step call 14)
              (g3t-role-step call 15)
              (g3t-role-step call 16)
              (g3t-role-step call 17)
              (g3t-role-step call 18)
              (g3t-role-step call 19)
              (g3t-role-step call 20)
              (g3t-output-prepare call output)
              (g3t-t1-decode-output! call output)
              (g3t-final-commit! call output))))))))
