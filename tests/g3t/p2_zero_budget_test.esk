(check "reference NF" (g3t-checked-m3t-layer-norm! reference-workspace 'final))
(check "reference Z" (g3t-checked-m3t-linear! reference-workspace 'tied-head))
(check "reference copy" (g3t-checked-m3t-workspace-copy-logits!
                          reference-workspace reference-logits))
(define reference-bytes (g3t-checked-m3t-logits-bits reference-logits))
(check "all 256 P2 logits equal independent M3T"
       (let compare ((index 0))
         (if (= index 256) #t
             (let* ((at (+ 1024 (* index 4)))
                    (bits (+ (bytevector-u8-ref reference-bytes at)
                             (* 256 (bytevector-u8-ref reference-bytes (+ at 1)))
                             (* 65536 (bytevector-u8-ref reference-bytes (+ at 2)))
                             (* 16777216 (bytevector-u8-ref reference-bytes (+ at 3))))))
               (and (= bits (vector-ref prefill-bits index))
                    (compare (+ index 1)))))))
(check "reference reset" (g3t-checked-m3t-workspace-reset! reference-workspace))
(check "reference logits release" (g3t-checked-m3t-logits-release! reference-logits))
(check "reference workspace release"
       (g3t-checked-m3t-workspace-release! reference-workspace))
(check "reference input release" (g3t-checked-m3t-input-release! reference-input))

(define wrapped-generator (g3t-generator-create model tokenizer policy))
(define wrapped-input (g3t-generation-t1-input-create t1-p2))
(check "T1 P2 frame source owns I1"
       (let ((native-input
              (vector-ref (g3t-prefill-entry wrapped-input 'input 't1-p2) 3)))
         (and (= 2 (g3t-test-input-length native-input))
              (= 65 (g3t-test-input-word native-input 0))
              (= 66 (g3t-test-input-word native-input 1)))))
(define wrapped-output (g3t-p2-zero-generate! wrapped-generator wrapped-input))
(check "rooted P2/G0 empty result"
       (let ((entry (g3t-prefill-entry wrapped-output 'output 'g3t-p2-rooted)))
         (and (eq? (vector-ref entry 2) 'live)
              (= 0 (bytevector-length (vector-ref entry 6))))))
(define wrapped-native-output
  (vector-ref (g3t-prefill-entry wrapped-output 'output 'g3t-rng-test) 3))
(define wrapped-output-entry
  (g3t-prefill-entry wrapped-output 'output 'g3t-ids-test))
(reject-category "text result rejects forged output" 'invalid-argument
  (lambda () (g3t-generation-output-text (vector 'g3t-output-private))))
(reject-category "text result rejects wrong-kind input" 'invalid-argument
  (lambda () (g3t-generation-output-text wrapped-input)))
(vector-set! wrapped-output-entry 2 'pending)
(reject-category "text result rejects pending output" 'invalid-state
  (lambda () (g3t-generation-output-text wrapped-output)))
(vector-set! wrapped-output-entry 2 'live)
(define wrapped-text-registry-head (vector-ref g3t-registry 0))
(define wrapped-text-first (g3t-generation-output-text wrapped-output))
(define wrapped-text-second (g3t-generation-output-text wrapped-output))
(define wrapped-text-first-bytes (car wrapped-text-first))
(define wrapped-text-second-bytes (car wrapped-text-second))
(check "P2/G0 text results are fresh empty bytevectors in fresh lists"
       (and (pair? wrapped-text-first) (null? (cdr wrapped-text-first))
            (pair? wrapped-text-second) (null? (cdr wrapped-text-second))
            (not (eq? wrapped-text-first wrapped-text-second))
            (not (eq? wrapped-text-first-bytes wrapped-text-second-bytes))
            (not (eq? wrapped-text-first-bytes (vector-ref wrapped-output-entry 6)))
            (= 0 (bytevector-length wrapped-text-first-bytes))
            (= 0 (bytevector-length wrapped-text-second-bytes))
            (eq? wrapped-text-registry-head (vector-ref g3t-registry 0))
            (= 1 (g3t-test-output-state wrapped-native-output))))
(set-car! wrapped-text-first #f)
(check "P2/G0 text list mutation leaves another result and source intact"
       (and (bytevector? (car wrapped-text-second))
            (= 0 (bytevector-length (car wrapped-text-second)))
            (= 0 (bytevector-length (vector-ref wrapped-output-entry 6)))
            (eq? wrapped-text-registry-head (vector-ref g3t-registry 0))))
