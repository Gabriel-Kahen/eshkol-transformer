;; Destination-contract mismatches use complete live one-parameter states, so
;; tied-entry validation cannot preempt the intended shape/dtype/device error.
(define (single-parameter-module tensor)
  (let ((module (module-create-fixture-internal)))
    (module-register-parameter-internal! module "z" tensor)
    module))

(define (single-parameter-owner tensor)
  (module-state-dict (single-parameter-module tensor)))

(define (single-buffer-module tensor)
  (let ((module (module-create-fixture-internal)))
    (module-register-buffer-internal! module "z" tensor)
    module))

(define (single-buffer-owner tensor)
  (module-state-dict (single-buffer-module tensor)))

(let* ((shape-owner
         (single-parameter-owner
           (fixture-tensor-internal '(4) 'f32 'cpu
                                    (vector 'source-parameter 'bits-v1))))
       (shape-destination
         (single-parameter-module
           (fixture-tensor-internal '(2 2) 'f32 'cpu
                                    (vector 'destination 'bits-v1))))
       (dtype-owner
         (single-buffer-owner
           (fixture-tensor-internal '(2 2) 'i64 'cpu
                                    (vector 'source-parameter 'bits-v1))))
       (dtype-destination
         (single-buffer-module
           (fixture-tensor-internal '(2 2) 'f32 'cpu
                                    (vector 'destination 'bits-v1))))
       (device-owner
         (single-parameter-owner
           (fixture-tensor-internal '(2 2) 'f32 'accelerator
                                    (vector 'source-parameter 'bits-v1))))
       (device-destination
         (single-parameter-module
           (fixture-tensor-internal '(2 2) 'f32 'cpu
                                    (vector 'destination 'bits-v1))))
       (conflict-owner
         (single-parameter-owner
           (fixture-tensor-internal '(2 2) 'f32 'cpu
                                    (vector 'conflict 'bits-v1))))
       (conflict-entry (car (state-dict-entries-internal conflict-owner)))
       (conflict-state
         (restate source-state
           (replace-entry valid-entries '("z") conflict-entry)
           (state-dict-alias-groups source-state))))
  (expect-error "entry tensor shape mismatch" 'shape-mismatch
                (lambda ()
                  (module-load-state-dict! shape-destination shape-owner)))
  (expect-error "entry tensor dtype mismatch" 'dtype-mismatch
                (lambda ()
                  (module-load-state-dict! dtype-destination dtype-owner)))
  (expect-error "entry tensor device mismatch" 'device-mismatch
                (lambda ()
                  (module-load-state-dict! device-destination device-owner)))
  (expect-error "conflicting tied payload" 'corrupt-data
                (lambda ()
                  (load-state! destination conflict-state)))
  (state-dict-release! conflict-state)
  (state-dict-release! shape-owner)
  (state-dict-release! dtype-owner)
  (state-dict-release! device-owner)
  (state-dict-release! conflict-owner))

(let ((alias-mismatch-state
        (restate source-state valid-entries '())))
  (expect-error "alias topology mismatch" 'shape-mismatch
                (lambda ()
                  (load-state! destination alias-mismatch-state)))
  (state-dict-release! alias-mismatch-state))

(expect-load-error-and-release
  "unsupported tensor provider" 'unsupported destination
  (state-dict-create-unsafe-internal
    'transformer-state-dict 1 0 '()
    '(transformer-tensor-provider 2 0 unknown-provider)
    valid-entries (state-dict-alias-groups source-state)))
(expect-load-error-and-release
  "incoming identity cannot select registered callbacks" 'unsupported destination
  (state-dict-create-unsafe-internal
    'transformer-state-dict 1 0 '()
    '(transformer-tensor-provider 2 0 poison-access-v1)
    valid-entries (state-dict-alias-groups source-state)))
(check "malformed and unsupported state failures restore owned baseline"
       (= malformed-state-owned-before (fixture-owned-live-count-internal)))

;;; A provider failure while preparing the second lexical assignment occurs
;;; after one owned scratch clone has been published. No destination value may
;;; change, and every scratch owner must be released.
(define atomic-target (build-module 'atomic-before 'atomic-buffer-before))
(define atomic-before (module-state-values atomic-target))
(define atomic-handle
  (parameter-tree-handle (module-parameters atomic-target) '("z")))
(define late-failure-owned-before (fixture-owned-live-count-internal))
(fixture-arm-clone-defect-internal! 1 'publish-then-raise)
(expect-error "late staging copy failure" 'internal
              (lambda ()
                (module-load-state-dict! atomic-target source-state)))
(check "late staging failure releases every prepared scratch owner"
       (= late-failure-owned-before (fixture-owned-live-count-internal)))
(check "late failure preserves every value"
       (equal? atomic-before (module-state-values atomic-target)))
(check "late failure preserves handle identity"
       (eq? atomic-handle
            (parameter-tree-handle (module-parameters atomic-target) '("z"))))
(check "late failure preserves tie identity"
       (eq? atomic-handle
            (parameter-tree-handle (module-parameters atomic-target)
                                   '("block" "alpha"))))

;; Opaque shells cannot be forged from raw visible vectors.
(expect-error "forged module shell" 'invalid-argument
              (lambda () (module-state-dict (vector 'transformer-module))))
(expect-error "forged tree shell" 'invalid-argument
              (lambda () (parameter-tree-paths
                           (vector 'transformer-parameter-tree))))
(expect-error "forged handle shell" 'invalid-argument
              (lambda () (parameter-handle-path
                           (vector 'transformer-parameter-handle))))
(expect-error "forged state shell" 'invalid-argument
              (lambda () (state-dict-paths
                           (vector 'transformer-state-dict))))

;; Every caller-controlled list and composite metadata boundary is bounded and
;; identity-aware. Cycles must raise E1 errors rather than recurse forever.
(let ((path (list "z")))
  (set-cdr! path path)
  (expect-error "cyclic accessor path" 'invalid-argument
                (lambda () (state-dict-tensor source-state path)))
  (expect-error "cyclic entry path" 'invalid-argument
                (lambda ()
                  (state-entry-internal
                    path 'parameter (state-entry-shape-internal z-entry)
                    (state-entry-dtype-internal z-entry)
                    (state-entry-device-internal z-entry)
                    (state-entry-layout-internal z-entry) z-tensor))))
(let ((shape (list 2)))
  (set-cdr! shape shape)
  (expect-error "cyclic entry shape" 'invalid-argument
                (lambda ()
                  (state-entry-internal
                    '("z") 'parameter shape
                    (state-entry-dtype-internal z-entry)
                    (state-entry-device-internal z-entry)
                    (state-entry-layout-internal z-entry) z-tensor))))
(let ((features (list 'future-feature)))
  (set-cdr! features features)
  (expect-error "cyclic feature list" 'invalid-argument
                (lambda ()
                  (state-dict-create-unsafe-internal
                    'transformer-state-dict 1 0 features
                    valid-provider-identity valid-entries
                    (state-dict-alias-groups source-state)))))
(let ((entries (list first-entry)))
  (set-cdr! entries entries)
  (expect-error "cyclic entry list" 'invalid-argument
                (lambda ()
                  (state-dict-create-unsafe-internal
                    'transformer-state-dict 1 0 '()
                    valid-provider-identity entries
                    (state-dict-alias-groups source-state)))))
(let* ((group (list '("block" "alpha") '("z")))
       (aliases (list group)))
  (set-cdr! (cdr group) group)
  (expect-error "cyclic alias group" 'invalid-argument
                (lambda ()
                  (state-dict-create-unsafe-internal
                    'transformer-state-dict 1 0 '()
                    valid-provider-identity valid-entries aliases))))
(let ((aliases (list '(("block" "alpha") ("z")))))
  (set-cdr! aliases aliases)
  (expect-error "cyclic alias list" 'invalid-argument
                (lambda ()
                  (state-dict-create-unsafe-internal
                    'transformer-state-dict 1 0 '()
                    valid-provider-identity valid-entries aliases))))
(let ((adapter (list 'transformer-tensor-provider 2 0 'fixture-v1)))
  (set-cdr! (cdr (cdr (cdr adapter))) adapter)
  (expect-error "cyclic provider identity" 'invalid-argument
                (lambda ()
                  (state-dict-create-unsafe-internal
                    'transformer-state-dict 1 0 '() adapter valid-entries
                    (state-dict-alias-groups source-state)))))
(let ((device (make-vector 1 #f)))
  (vector-set! device 0 device)
  (let ((state #f))
    (expect-transformer-error
      "cyclic device descriptor"
      (lambda ()
        (let ((entry
                (state-entry-internal '("z") 'parameter
                  (state-entry-shape-internal z-entry)
                  (state-entry-dtype-internal z-entry) device
                  (state-entry-layout-internal z-entry) z-tensor)))
          (set! state
                (restate source-state
                  (replace-entry valid-entries '("z") entry)
                  (state-dict-alias-groups source-state)))
          (load-state! destination state))))
    (if state (state-dict-release! state) #t)))
(expect-error "cyclic provider admission evidence" 'invalid-argument
              (lambda ()
                (fixture-register-cyclic-evidence-provider-internal!)))

;; One-over probes cover every bounded proper-list family. They are built
;; iteratively so the test itself does not depend on recursive list traversal.
(expect-error "overlimit accessor path" 'invalid-argument
              (lambda ()
                (state-dict-tensor source-state (repeat-value 65 "z"))))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 (repeat-value 65 'feature)
          valid-provider-identity valid-entries
          (state-dict-alias-groups source-state))))
  (expect-error "overlimit feature list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(expect-error "overlimit entry list ingress" 'invalid-argument
              (lambda ()
                (state-dict-create-unsafe-internal
                  'transformer-state-dict 1 0 '() valid-provider-identity
                  (repeat-value 4097 first-entry)
                  (state-dict-alias-groups source-state))))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '() valid-provider-identity valid-entries
          (repeat-value 4097 '()))))
  (expect-error "overlimit alias group list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '() valid-provider-identity valid-entries
          (list (repeat-value 4097 '("z"))))))
  (expect-error "overlimit alias member list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '()
          '(transformer-tensor-provider 2 0 fixture-v1 extra)
          valid-entries (state-dict-alias-groups source-state))))
  (expect-error "overlimit provider identity" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(expect-error "overlimit provider admission evidence" 'invalid-argument
              (lambda ()
                (fixture-register-overlimit-evidence-provider-internal!)))
(expect-error "improper provider admission evidence" 'invalid-argument
              (lambda ()
                (fixture-register-improper-evidence-provider-internal!)))

;; Deep-copy budgets are enforced before unbounded allocation or recursion.
(expect-error "overlimit metadata string" 'invalid-argument
              (lambda ()
                (state-entry-internal '("z") 'parameter '(2) 'f32
                                      (make-string 65537 #\x)
                                      'dense-row-major-contiguous z-tensor)))
(expect-error "overlimit metadata vector" 'invalid-argument
              (lambda ()
                (state-entry-internal '("z") 'parameter '(2) 'f32
                                      (make-vector 65537 #f)
                                      'dense-row-major-contiguous z-tensor)))
(expect-error "overlimit metadata node budget" 'invalid-argument
              (lambda ()
                (state-entry-internal '("z") 'parameter '(2) 'f32
                                      (make-vector 65536 #f)
                                      'dense-row-major-contiguous z-tensor)))
(expect-error "overlimit metadata depth" 'invalid-argument
              (lambda ()
                (state-entry-internal '("z") 'parameter '(2) 'f32
                                      (nest-vector 17 'cpu)
                                      'dense-row-major-contiguous z-tensor)))
(expect-error "improper accessor path" 'invalid-argument
              (lambda ()
                (state-dict-tensor source-state (cons "z" 'tail))))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 (cons 'feature 'tail)
          valid-provider-identity valid-entries
          (state-dict-alias-groups source-state))))
  (expect-error "improper feature list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '() (cons 'transformer-tensor-provider
                                               'tail)
          valid-entries (state-dict-alias-groups source-state))))
  (expect-error "improper provider identity" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '() valid-provider-identity valid-entries
          (cons '(("block" "alpha") ("z")) 'tail))))
  (expect-error "improper alias list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(let ((state
        (state-dict-create-unsafe-internal
          'transformer-state-dict 1 0 '() valid-provider-identity valid-entries
          (list (cons '("block" "alpha") 'improper-tail)))))
  (expect-error "improper alias member list" 'corrupt-data
                (lambda () (load-state! destination state)))
  (state-dict-release! state))
(expect-error "improper entry list ingress" 'invalid-argument
              (lambda ()
                (state-dict-create-unsafe-internal
                  'transformer-state-dict 1 0 '() valid-provider-identity
                  (cons first-entry 'tail)
                  (state-dict-alias-groups source-state))))

;; A rejected strict load must leave an unenumerated module open to topology
;; registration; validation cannot finalize it as a side effect.
(let ((mutable-after-failure (module-create-fixture-internal)))
  (module-register-parameter-internal!
    mutable-after-failure "only" (payload 'mutable-before-failure))
  (expect-error "failed load leaves topology mutable" 'shape-mismatch
                (lambda ()
                  (module-load-state-dict! mutable-after-failure source-state)))
  (check "registration succeeds after failed load"
         (module-register-buffer-internal!
           mutable-after-failure "after"
           (buffer-payload 'mutable-after-failure))))

;; Successful long-lived fixture snapshots are explicit owners too.
(state-dict-release! destination-state)
(state-dict-release! source-state)
(state-dict-release! buffers)

(display "P1 PASS: ")
(display checks)
(display " checks")
(newline)
