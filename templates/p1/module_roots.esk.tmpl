         (= code 16) (= code 17) (= code 18)))
    ((= status 2)
     (or (= code 9) (= code 11) (= code 13) (= code 14) (= code 15)))
    ((= status 3)
     (or (= code 4) (= code 8) (= code 9) (= code 10) (= code 12)))
    ((= status 4) (= code 7))
    (else #f)))

