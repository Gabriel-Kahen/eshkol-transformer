(require transformer.public)

(define caught
  (guard (raised (#t raised))
    (transformer-error-details 'not-an-error)))

(if (and (transformer-error? caught)
         (eq? (transformer-error-category caught) 'invalid-argument)
         (eq? (transformer-error-operation caught) 'transformer-error-details)
         (string? (transformer-error-message caught))
         (list? (transformer-error-details caught))
         (eq? (transformer-error-cause caught) #f))
    (begin (display "e1-public-errors:v1") (newline))
    (exit 1))
