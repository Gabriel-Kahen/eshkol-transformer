;;; Public D1 corpus and D2 dataset/batch surface.

(require transformer.error_consumer)

(provide token-corpus-write!
         token-corpus-validate
         token-corpus-summary-shard-count
         token-corpus-summary-total-tokens
         token-corpus-summary-vocab-size
         token-corpus-summary-shard-token-limit
         token-corpus-summary-tokenizer-fingerprint
         token-corpus-summary-total-shard-bytes
         token-dataset-open
         token-dataset-next-batch
         token-dataset-cursor
         token-dataset-end?
         token-dataset-seek!
         token-dataset-close!
         token-batch-inputs
         token-batch-targets
         token-batch-loss-mask
         token-batch-validate
         token-batch-release!)

;;; The D1 isolation gate extracts this exact production wrapper component when
;;; linking the standalone D1 archives.
;;; D1 facade component begin.
(define e1b-safe-d1-token-corpus-write-call
  (let ()
    (extern void e1b-d1-token-corpus-write ptr ptr ptr ptr ptr ptr
            :real et_e1b_public_d1_token_corpus_write_v1)
    (lambda (directory fingerprint vocab-size shard-token-limit tokens)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-write
         (vector directory) (vector fingerprint) (vector vocab-size)
         (vector shard-token-limit) (vector tokens) output)
        (vector-ref output 0)))))

(define e1b-safe-d1-token-corpus-validate-call
  (let ()
    (extern void e1b-d1-token-corpus-validate ptr ptr ptr ptr ptr
            :real et_e1b_public_d1_token_corpus_validate_v1)
    (lambda (directory maximum-manifest-bytes maximum-shard-bytes
                       maximum-total-tokens)
      (let ((output (vector #f)))
        (e1b-d1-token-corpus-validate
         (vector directory) (vector maximum-manifest-bytes)
         (vector maximum-shard-bytes) (vector maximum-total-tokens) output)
        (vector-ref output 0)))))

