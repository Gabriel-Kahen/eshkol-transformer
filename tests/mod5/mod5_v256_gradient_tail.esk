;;; Uses the fixed EVAL5 T1, D1 and C1 inputs and real MOD5-C backward.
(define expected-tied-sha @@TIED_SHA@@)
(define head-probes '@@HEAD_PROBES@@)
(define embedding-probes '@@EMBEDDING_PROBES@@)
(define tied-probes '@@TIED_PROBES@@)
(define gradient-step 0.001953125)

(define (gradient-loss weights input target)
  (vector-ref (decoder weights input target #f #f) 0))

(define (check-full-mask data)
  (let ((row-sums (reshape (tensor-sum data 1) (list tokens))))
    (do ((row 0 (+ row 1))) ((= row tokens))
      (check-data (= (tensor-ref row-sums row) 1.0) "expected one active token per row"))))

(define (central-difference weights slot row col input target)
  (let* ((weight (vector-ref weights slot))
         (old (tensor-get weight row col)))
    (tensor-set! weight row col (+ old gradient-step))
    (let ((plus (gradient-loss weights input target)))
      (tensor-set! weight row col (- old gradient-step))
      (let ((minus (gradient-loss weights input target)))
        (tensor-set! weight row col old)
        (/ (- plus minus) (* 2.0 gradient-step))))))

(define (emit-probes kind probes slot weights gradients separate input target)
  (let ((gradient (vector-ref gradients slot))
        (head (vector-ref separate whead))
        (embedding (vector-ref separate wembedding)))
    (check-data (equal? (tensor-shape gradient) '(256 16)) "wrong V256 gradient shape")
    (do ((remaining probes (cdr remaining)))
        ((null? remaining))
      (let* ((row (car (car remaining)))
             (col (cadr (car remaining)))
             (analytic (tensor-get gradient row col))
             (numerical (central-difference weights slot row col input target)))
        (display "GRAD ") (display kind) (display " ")
        (display row) (display " ") (display col) (display " ")
        (print-real "%.17g" analytic) (display " ")
        (print-real "%.17g" numerical) (display " ")
        (print-real "%.17g" (tensor-get head row col)) (display " ")
        (print-real "%.17g" (tensor-get embedding row col)) (newline)))))

(define (canonicalize-tied! tied separate)
  ;; The accepted MOD5-C decoder stores the combined gradient in the
  ;; embedding slot. The canonical persisted parameter path is head.weight.
  (let* ((dh (vector-ref separate whead))
         (de (vector-ref separate wembedding))
         (combined (vector-ref tied wembedding)))
    (check-data (and (equal? (tensor-shape combined) '(256 16))
                     (= (tensor-sum (tensor-abs (tensor-sub (tensor-add de dh) combined))) 0.0)
                     (= (tensor-sum (tensor-abs (tensor-sub dh (vector-ref tied whead)))) 0.0))
                "tied backward differs from the sum of both real paths")
    (vector-set! tied whead combined)
    (vector-set! tied wembedding #f)))

(define (gradient-witness tokenizer-path split-path untied-path tied-path)
  (check-tokenizer tokenizer-path)
  (let* ((split (read-split split-path expected-eval-sha))
         (batch (one-hot-doc (vector-ref split 0) 0))
         (input (vector-ref batch 0))
         (target (vector-ref batch 1))
         (untied (vector-ref (load-checked-weights untied-path expected-model-sha) 0))
         (tied (vector-ref (load-checked-weights tied-path expected-tied-sha) 0))
         (untied-gradients (make-vector parameters #f))
         (tied-separate (make-vector parameters #f))
         (tied-gradients (make-vector parameters #f)))
    (check-data (and (= tokens 8) (= vocab 256)) "expected fixed V256, T=8 geometry")
    (check-full-mask input)
    (check-full-mask target)
    (check-data (and (not (eq? (vector-ref untied whead) (vector-ref untied wembedding)))
                     (eq? (vector-ref tied whead) (vector-ref tied wembedding)))
                "wrong head/embedding ownership after C1 decode")
    (let* ((untied-loss (vector-ref (decoder untied input target untied-gradients #f) 0))
           (separate-loss (vector-ref (decoder tied input target tied-separate #f) 0))
           (tied-loss (vector-ref (decoder tied input target tied-gradients #t) 0)))
      (check-data (= tied-loss separate-loss) "tie accumulation changed the forward CE")
      (canonicalize-tied! tied-gradients tied-separate)
      (display "MASK 11111111") (newline)
      (display "LOSS untied ") (print-real "%.17g" untied-loss) (newline)
      (display "LOSS tied ") (print-real "%.17g" tied-loss) (newline)
      (emit-probes "head" head-probes whead untied untied-gradients untied-gradients input target)
      (emit-probes "embedding" embedding-probes wembedding untied untied-gradients
                   untied-gradients input target)
      (emit-probes "tied" tied-probes whead tied tied-gradients tied-separate input target)
      (check-data (and (not (vector-ref tied-gradients wembedding))
                       (= (gradient-loss untied input target) untied-loss)
                       (= (gradient-loss tied input target) tied-loss))
                  "finite difference failed to restore the model")
      (display "TIED_CANONICAL_HEAD 4096") (newline)
      (display "MOD5_V256_GRADIENT_PASS") (newline))))

(define args (cdr (command-line)))
(unless (equal? (c1-list-length-bounded args 5) 4)
  (close-workspace)
  (display "expected TOKENIZER D1_SPLIT UNTIED_C1 TIED_C1") (newline)
  (exit 2))
(guard (caught (#t (close-workspace) (write caught) (newline) (exit 2)))
  (gradient-witness (car args) (cadr args) (caddr args) (cadddr args)))
(close-workspace)
