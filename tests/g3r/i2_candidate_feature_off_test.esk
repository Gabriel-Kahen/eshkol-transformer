(load "i2_wave2_root.esk")
(extern i64 ordinary-test-live-count
        :real et_p1_test_live_entry_count_v1)
(define baseline (ordinary-test-live-count))
(define modules i2-module-count)
(define construction (i2-construction-begin-internal))
(define root (vector-ref construction 2))
(if (not (i2-module? root)) (exit 1))
(module-construction-parameters-internal (vector-ref construction 1))
(if (not (i2-construction-abort-internal! construction)) (exit 1))
(if (or (not (= baseline (ordinary-test-live-count)))
        (not (= modules i2-module-count)))
    (exit 1))
(display "G3-R I2 ordinary feature-off PASS")
(newline)
