        (check "claimed model/O2 native controls stay flat"
               (and (equal? claimed-i2-before (snapshot-i2-counts))
                    (equal? claimed-o2-before (snapshot-o2-counts))))
        (repeat-claimed (- remaining 1)))))
(define cross-p1 (make-p1-state "weight" '(4) #f))
