;;; Focused actual-runtime witness, using the ordinary C2 LOAD fixture lineage.
(load "d2_wave2_root.esk")
(load "c2_d2_cursor_pair_extension.esk")
(load "o2_wave2_extension.esk")
(load "c2_o2_reconstruct_extension.esk")
(load "c2_x1_canonical_extension.esk")
(load "c2_training_state_extension.esk")
(load "c2_persistence_policy_extension.esk")
(load "c2_checkpoint_load_extension.esk")
(extern i64 h-calibrate :real et_c2h_calibrate)
(extern i64 h-calibrated :real et_c2h_calibrated)
(extern i64 h-prepare i64 i64 :real et_c2h_prepare)
(extern i64 h-fresh :real et_c2h_fresh)
(extern i64 h-arm :real et_c2h_arm)
(extern i64 h-finish i64 :real et_c2h_finish)
(extern i64 h-event i64 :real et_c2h_event)
(extern i64 h-done :real et_c2h_done)
(extern i64 h-counter i64 :real et_c2_checkpoint_save_test_counter_v1)
(define (check value) (if value #t (exit 81)))
(define args (command-line))
(define fixture (car (cdr args)))
(define policy (c2-persistence-policy-internal 1048576 1048576 1048576 16 'cpu))
(define subject #f)
(define loaded #f)
(define selected 0)
(define behavior 0)
(define decode c2-load-decode-model-internal)
(define reconstruct-o2 c2-load-reconstruct-o2-internal)
(define compose-owner c2-load-compose-owner-internal)
(set! c2-load-decode-model-internal
  (lambda (model subpolicy) (h-event 0) (decode model subpolicy)))
(set! c2-load-reconstruct-o2-internal
  (lambda (request) (h-event 1) (reconstruct-o2 request)))
(set! c2-load-compose-owner-internal
  (lambda (request)
    (h-event 2)
    (let ((result (compose-owner request)))
      ;; Trigger actual claimed-child rollback after successful consumption.
      (if (= behavior 2) (raise #f) result))))
(define (counts)
  (let ((result (make-vector 35 0)))
    (let loop ((index 0))
      (if (= index 35) result
          (begin (vector-set! result index (h-counter index))
                 (loop (+ index 1)))))))
(define (same-live? before after)
  (let loop ((indices '(0 1 2 3 4 5 6 17 18 19 24 25 26 28 30 31 32 33)))
    (if (null? indices) #t
        (and (= (vector-ref before (car indices)) (vector-ref after (car indices)))
             (loop (cdr indices))))))
(define (new-subject site)
  (let ((stage (c2-checkpoint-load-stage-internal fixture policy)))
    (cond ((= site 3) stage)
          ((= site 2) (c2-checkpoint-load-reconstruct-internal stage 'checkpoint-load))
          (else
            (let* ((entry (c2-load-find-stage stage))
                   (state (decode (vector-ref entry 3) (vector-ref entry 6))))
              (c2-checkpoint-load-staging-release-internal! stage)
              state)))))
(define (perform)
  (cond ((= selected 1) (state-dict-release! subject))
        ((= selected 2) (c2-training-state-release-internal! subject 'trainer-state-release!))
        (else (set! loaded (c2-checkpoint-load-reconstruct-internal subject 'checkpoint-load)))))
(define (load-dual-fault-error? caught)
  (and (transformer-error? caught)
       (eq? (transformer-error-category caught) 'internal)
       (eq? (transformer-error-operation caught) 'checkpoint-load)
       (equal? (transformer-error-message caught)
               "validated checkpoint staging or reconstruction failed internally")
       (equal?
         (transformer-error-details caught)
         '((caught-transformer-error? #t)
           (source-code reconstruction)
           (source-domain c2-checkpoint-load)
           (source-message
             "validated checkpoint staging or reconstruction failed internally")))))
;; Each recursive guard remains live. Stop only when real push malloc proves the
;; recycled pool empty; no test-only runtime pool API or fabricated handler.
(define (scope depth)
  (guard (caught
           (#t
             (begin
               ;; Finish first: this disarms persistent malloc blocking before
               ;; the accessor checks inspect the final normalized first error.
               (h-finish 1)
               (if (= behavior 3) (check (load-dual-fault-error? caught)) #t))))
    (if (= (h-fresh) 0)
        (if (< depth 512)
            (begin (scope (+ depth 1)) (h-fresh))
            (exit 82))
        (begin (h-arm) (perform) (h-finish 0)))))
(define (experiment mode)
  (set! behavior mode)
  (h-prepare selected mode)
  (scope 0))
(define (verify-live original)
  (cond ((= selected 1)
         (check (equal? original (state-dict-paths subject))))
        ((= selected 2)
         (let ((state (c2-training-state-find subject)))
           (check (eq? (vector-ref state 7) 'live))
           (check (eq? (vector-ref state 1) (vector-ref original 0)))
           (check (eq? (vector-ref state 2) (vector-ref original 1)))
           (check (eq? (vector-ref state 6) (vector-ref original 2)))
           ;; Authenticating a fresh borrow verifies both exact subowner claims.
           (let ((borrow (c2-training-state-borrow-begin-internal subject 'checkpoint-save!)))
             (check (c2-training-state-borrow-end-internal borrow)))))
        (else
          (let ((entry (c2-load-find-stage subject)))
            (check (eq? (vector-ref entry 2) 'live))
            (check (eq? (vector-ref entry 3) (vector-ref original 0)))
            (check (eq? (vector-ref entry 4) (vector-ref original 1)))
            (check (eq? (vector-ref entry 5) (vector-ref original 2)))
            (check (eq? (vector-ref entry 6) (vector-ref original 3)))
            (check (eq? loaded #f))))))
(define (snapshot-subject)
  (cond ((= selected 1) (state-dict-paths subject))
        ((= selected 2)
         (let ((state (c2-training-state-find subject)))
           (vector (vector-ref state 1) (vector-ref state 2) (vector-ref state 6))))
        (else
          (let ((entry (c2-load-find-stage subject)))
            (vector (vector-ref entry 3) (vector-ref entry 4)
                    (vector-ref entry 5) (vector-ref entry 6))))))
(guard (caught (#t (h-calibrated))) (h-calibrate))
(let loop ((site 1))
  (if (> site 3) #t
      (begin
        (set! selected site)
        (set! behavior 0)
        (set! loaded #f)
        (let ((baseline (counts)))
          (set! subject (new-subject site))
          (let ((before (counts)) (original (snapshot-subject)))
            (experiment 0)
            (check (equal? before (counts)))
            (verify-live original))
          ;; Retry the SAME object with handler malloc blocked after reserve.
          (experiment 1)
          (if (= site 3)
              (check (c2-training-state-release-internal! loaded 'trainer-state-release!)))
          (check (same-live? baseline (counts)))
          ;; Separate real provider defect, with the entire cleanup still armed.
          (set! behavior 0)
          (set! loaded #f)
          (set! subject (new-subject site))
          (experiment 2)
          (check (same-live? baseline (counts)))
          (if (= site 1) (check (state-dict-release! subject))
              (if (= site 2)
                  (check (c2-training-state-release-internal! subject 'trainer-state-release!))
                  (check (c2-checkpoint-load-staging-dead-internal? subject)))))
        (loop (+ site 1)))))
(set! selected 3)
(set! behavior 0)
(set! loaded #f)
(let ((baseline (counts)))
  (set! subject (new-subject 3))
  ;; Native P1 bind consumes decoded ownership, then reports an injected
  ;; adoption defect. Real I2 cleanup consumes that ownership and independently
  ;; reports a provider defect while handler malloc remains blocked.
  (experiment 3)
  (check (eq? loaded #f))
  (check (same-live? baseline (counts)))
  (check (c2-checkpoint-load-staging-dead-internal? subject))
  ;; Consuming began before either fault, so the same stage remains one-shot.
  (check
    (guard (caught (#t #t))
      (begin
        (c2-checkpoint-load-reconstruct-internal subject 'checkpoint-load)
        #f))))
(check (h-done))
(display "C2-REPAIRED-HANDLER-ALLOCATION-PASS") (newline)
