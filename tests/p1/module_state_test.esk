(expect-error "singleton alias group" 'corrupt-data
              (lambda ()
                (load-state!
                  destination (restate source-state valid-entries '((("z")))))))
(expect-error "non-path alias member" 'corrupt-data
              (lambda ()
                (load-state!
                  destination (restate source-state valid-entries '((bad worse))))))
(expect-error "empty alias path" 'corrupt-data
              (lambda ()
                (load-state!
                  destination (restate source-state valid-entries '((() ("z")))))))
(expect-error "empty alias segment" 'corrupt-data
              (lambda ()
                (load-state!
                  destination
                  (restate source-state valid-entries '((("") ("z")))))))
(expect-error "non-string alias segment" 'corrupt-data
              (lambda ()
                (load-state!
                  destination
                  (restate source-state valid-entries '(((1) ("z")))))))
(expect-error "buffer alias member" 'corrupt-data
              (lambda ()
                (load-state!
                  destination
                  (restate source-state valid-entries '((("aa") ("zz")))))))

