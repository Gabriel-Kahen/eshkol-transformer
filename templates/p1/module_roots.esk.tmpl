    ((= code 3) "native identity token is foreign")
    ((= code 4) "native identity token is stale")
    ((= code 5) "native identity token has the wrong kind")
    ((= code 6) "native identity token belongs to another context")
    ((= code 7) "native identity allocation failed")
    ((= code 8) "native provider identity is already sealed")
    ((= code 9) "native provider snapshot does not match")
    ((= code 10) "native state binding conflicts")
    ((= code 11) "native state is not bound")
    ((= code 12) "native context still owns live identities")
    ((= code 13) "native identity entropy is unavailable")
    ((= code 14) "native identity capacity is exhausted")
    ((= code 15) "native identity belongs to another process")
    ((= code 16) "native identity integrity check failed")
    ((= code 17) "native provider identifier is invalid")
    ((= code 18) "native state tensor belongs to another state")
    (else "native identity operation returned a malformed status")))

