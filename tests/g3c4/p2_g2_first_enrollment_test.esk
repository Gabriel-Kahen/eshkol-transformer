(load "m3_package_root.esk")
(load "g3c4_i2_construction_extension.esk")
(load "g3c4_model_extension.esk")
(load "g3c4_call_entry_extension.esk")
(load "g3c4_t1_output_decode_extension.esk")
(load "g3c4_output_envelope_extension.esk")
(load "g3c4_p2g2_ownership_extension.esk")
(load "g3c4_p2g2_protected_scope_extension.esk")
(load "g3c4_p2g2_terminal_carriers_extension.esk")
(load "g3c4_p2g2_first_enrollment_extension.esk")

(extern i64 snapshot ptr :real et_g3c4_first_enrollment_test_snapshot_v1)
(extern i64 preserved ptr i64 :real et_g3c4_first_enrollment_test_preserved_v1)
(extern i64 pending-count ptr :real et_g3c4_first_enrollment_test_pending_v1)
(extern i64 lease ptr ptr i64 :real et_g3c4_first_enrollment_test_lease_v1)
(extern i64 foreign-release ptr :real et_g3c4_first_enrollment_test_foreign_release_v1)
(extern i64 native-fault i64 i64 :real et_g3c4_first_enrollment_test_fault_v1)
(extern i64 i1-census i64 :real et_m3_test_i64_counts_v1)
(extern i64 allocation-arm i64 i64 :real et_g3c4_first_enrollment_allocation_arm_v1)
(extern i64 allocation-consumed :real et_g3c4_call_entry_alloc_consumed_v1)
(extern i64 allocation-finish :real et_g3c4_first_enrollment_allocation_finish_v1)
(extern i64 extent-arm :real et_g3c4_terminal_extent_arm_v1)
(extern i64 extent-seal :real et_g3c4_terminal_extent_seal_v1)
(extern i64 extent-match i64 ptr i64 i64 :real et_g3c4_terminal_extent_match_v1)

(define checks 0)
(define (check label condition)
  (if condition (set! checks (+ checks 1))
      (begin (display "P2/G2 first enrollment FAIL: ")
             (display label) (newline) (exit 1))))
(define (rejects? thunk category)
  (guard (caught (#t (and (transformer-error? caught)
                          (eq? (transformer-error-category caught) category))))
    (thunk) #f))
(define (native-detail caught key expected)
  (let find ((tail (transformer-error-details caught)))
    (and (pair? tail)
         (let ((row (car tail)))
           (if (eq? (car row) key) (equal? (car (cdr row)) expected)
               (find (cdr tail)))))))
(define (config seed)
  (list ':profile 'diagnostic-c4 ':sampling 'greedy ':temperature-bits 1065353216
        ':top-k 256 ':top-p-bits 1065353216 ':max-new-tokens 2 ':eos #f ':seed seed))

(define tokenizer (t1-private-register-core (t1-tokenizer-core-create 'raw '() '() '())))
(define model (g3c4-model-create-seeded-internal 1729))
(define other-model (g3c4-model-create-seeded-internal 1730))
(define generator (g3c4-generator-create-internal model tokenizer (config 7)))
(define other-generator (g3c4-generator-create-internal other-model tokenizer (config 11)))
(define original-entry (g3c4-generator-entry-live generator 'fixture))
(define other-entry (g3c4-generator-entry-live other-generator 'fixture))
(define earlier-bundle (g3c4-p2g2-terminal-carriers-create))
(bytevector-u8-set! (vector-ref earlier-bundle 0) 0 93)
(define original-registry (vector-ref g3c4-registry 0))
(define original-records (vector-ref g3c4-p2g2-protected-records 0))
(define original-anchors (vector-ref g3c4-p2g2-protected-anchors 0))
(define original-roots (vector-ref g3c4-p2g2-first-enrollment-roots 0))
(define started-i1 (i1-census 0))
(define started-borrows (i1-census 1))
(define saved-bundle #f)
(define expected-extents (vector 9 16 10 24 9 16 9 10))
(check "entry native cache, binding, and RNG captured" (= (snapshot (vector-ref original-entry 3)) 0))

(define (check-idle)
  (check "exact pre-attempt Eshkol heads and prior owners restored"
    (and (eq? (vector-ref g3c4-registry 0) original-registry)
         (eq? (vector-ref g3c4-p2g2-protected-records 0) original-records)
         (eq? (vector-ref g3c4-p2g2-protected-anchors 0) original-anchors)
         (eq? (vector-ref g3c4-p2g2-first-enrollment-roots 0) original-roots)
         (not (vector-ref m3-call-state 0))
         (eq? (g3c4-generator-entry-live generator 'fixture) original-entry)
         (eq? (g3c4-generator-entry-live other-generator 'fixture) other-entry)
         (g3c4-p2g2-terminal-carriers-check earlier-bundle 'fixture)
         (= (bytevector-u8-ref (vector-ref earlier-bundle 0) 0) 93)))
  (check "no pending native owner or I1 allocation leak"
    (and (= (pending-count (vector-ref original-entry 3)) 0)
         (= (pending-count (vector-ref other-entry 3)) 0)
         (= (i1-census 0) started-i1) (= (i1-census 1) started-borrows)))
  (check "no guarded numerical entry and exact native entry state"
    (= (preserved (vector-ref original-entry 3) 0) 1)))

(define (mark-carriers bundle scrubbed?)
  (let slots ((i 0))
    (if (= i 8) #t
        (let ((bytes (vector-ref bundle i)))
          (let payload ((j 0))
            (if (< j (bytevector-length bytes))
                (begin
                  (if scrubbed?
                      (check "original payload scrubbed" (= (bytevector-u8-ref bytes j) 0))
                      (bytevector-u8-set! bytes j (+ i j 1)))
                  (payload (+ j 1)))))
          (slots (+ i 1))))))

(define (preserved-carriers bundle)
  (let slots ((i 0))
    (if (= i 8) #t
        (let ((bytes (vector-ref bundle i)))
          (let payload ((j 0))
            (if (= j (bytevector-length bytes)) (slots (+ i 1))
                (and (= (bytevector-u8-ref bytes j) (+ i j 1)) (payload (+ j 1)))))))))

(define (probe mode)
  (g3c4-with-p2g2-first-enrollment-probe 'first-enrollment generator
    (call bundle entry authenticate abort!)
    (if (eq? mode 'exception)
        (g3c4-fail 'unsupported 'first-enrollment "injected after authentic enrollment"))
    (if (eq? mode 'observe)
        (let* ((shell (vector-ref entry 0))
               (owner (vector-ref entry 3))
               (native (vector-ref original-entry 3))
               (auxiliary (vector-ref entry 8))
               (raw (vector-ref auxiliary 0))
               (staging (vector-ref auxiliary 1))
               (roots (vector-ref g3c4-p2g2-first-enrollment-roots 0))
               (root (car roots)))
          (check "constructor backing provenance" (= (extent-seal) 1))
          (let each ((i 0))
            (if (< i 8)
                (begin (check "original extent and backing allocation"
                         (= (extent-match i (vector-ref bundle i) (vector-ref expected-extents i)
                                          (if (= i 3) 32 24)) 1))
                       (each (+ i 1)))))
          (check "one original shell, auxiliary pair, and native pending owner"
            (and (authenticate call shell) (= (g3c4-p2g2-shell-count shell) 1)
                 (eq? raw (vector-ref bundle 2)) (eq? staging (vector-ref bundle 3))
                 (= (pending-count native) 1) (= (i1-census 0) (+ started-i1 1))))
          (check "foreign call rejected"
            (rejects? (lambda () (authenticate other-entry shell)) 'invalid-state))
          (check "equal-content foreign shell rejected"
            (rejects? (lambda () (authenticate call (vector 'g3c4-output-private))) 'invalid-state))
          (vector-set! g3c4-p2g2-first-enrollment-roots 0 (cons root (cdr roots)))
          (check "equal-content replacement root node rejected"
            (rejects? (lambda () (authenticate call shell)) 'invalid-state))
          (vector-set! g3c4-p2g2-first-enrollment-roots 0 roots)
          (let ((registry (vector-ref g3c4-registry 0)))
            ;; Lookup still returns the original. Full counting sees the duplicate.
            (vector-set! g3c4-registry 0 (cons entry (cons (vector-copy entry) (cdr registry))))
            (check "first-match lookup cannot hide second same-shell entry"
              (and (eq? (g3c4-registry-find shell 'fixture) entry)
                   (= (g3c4-p2g2-shell-count shell) 2)
                   (rejects? (lambda () (authenticate call shell)) 'invalid-state)))
            (vector-set! g3c4-registry 0 registry))
          (let ((replacement (vector (make-bytevector 2 0) (make-bytevector 16 0))))
            (vector-set! entry 8 replacement)
            (vector-set! root 4 replacement)
            (check "coordinated auxiliary and anchor replacement rejected"
              (rejects? (lambda () (authenticate call shell)) 'invalid-state))
            (vector-set! root 4 auxiliary)
            (vector-set! entry 8 auxiliary))
          (vector-set! auxiliary 0 (vector-ref bundle 7))
          (check "another same-extent original carrier cannot replace pending raw"
            (rejects? (lambda () (authenticate call shell)) 'invalid-state))
          (vector-set! auxiliary 0 raw)
          (check "repaired edges authenticate" (authenticate call shell))
          (mark-carriers bundle #f)
          (check "open genuine same-call I1 lease" (= (lease native owner 1) 0))
          (check "foreign live owner cannot release captured lease"
            (= (foreign-release (vector-ref other-entry 3)) 1))
          (check "exact I1 borrow rejection"
            (guard (caught
                     (#t (and (transformer-error? caught)
                              (eq? (transformer-error-category caught) 'invalid-state)
                              (native-detail caught 'source-domain 'i64-tensor)
                              (native-detail caught 'native-category 4)
                              (native-detail caught 'source-code 9))))
              (abort!) #f))
          (check "busy rejection preserves full ownership and bytes"
            (and (authenticate call shell) (eq? (vector-ref entry 3) owner)
                 (eq? (vector-ref g3c4-p2g2-first-enrollment-roots 0) roots)
                 (preserved-carriers bundle) (= (pending-count native) 1)
                 (= (i1-census 1) (+ started-borrows 1)) (= (preserved native 1) 1)))
          (check "original holder releases and retries in the same call"
            (and (= (lease native owner 0) 0) (abort!)))
          (set! saved-bundle bundle)))))

(define (check-native-fault kind cut domain code)
  (let ((caught #f))
    (guard (condition (#t (set! caught condition)))
      (native-fault kind cut)
      (probe 'dry))
    (native-fault kind -1)
    (check "preserve original native operation and condition after unwind"
      (and (transformer-error? caught)
           (eq? (transformer-error-operation caught) 'first-enrollment)
           (eq? (transformer-error-category caught) 'internal)
           (native-detail caught 'source-domain domain)
           (native-detail caught 'source-code code)))
    (check-idle)))

(define (sweep-allocations kind)
  ;; The link witness disarms at native acquire, before native reservation or
  ;; abort cleanup. A failing pre-acquire cut never reaches that boundary.
  (allocation-arm kind 1024)
  (probe 'dry)
  (let ((count (allocation-finish)))
    (check "measured a bounded pre-acquire allocation path"
           (and (> count 0) (< count 1024)))
    (check-idle)
    (let next ((cut 0))
      (if (< cut count)
          (let ((caught #f))
            (guard (condition (#t (set! caught condition)))
              (allocation-arm kind cut)
              (probe 'dry))
            (let* ((consumed (= (allocation-consumed) 1))
                   (boundary (allocation-finish)))
              (if (not (and consumed caught (= boundary -1)))
                  (begin
                    (display "pre-acquire allocation observation ")
                    (write (list kind cut consumed (not (not caught)) boundary))
                    (newline)))
              (check "each pre-acquire cut is recoverable before native acquire"
                     (and consumed caught (= boundary -1)))
              (check-idle)
              (next (+ cut 1))))
          count))))

(define (run)
  (check "allocator instrumentation armed" (= (extent-arm) 0))
  (check "probe aborts and returns only acknowledgement" (eq? (probe 'observe) #t))
  (mark-carriers saved-bundle #t)
  (check-idle)
  (check "observer exception survives abort unwind"
         (rejects? (lambda () (probe 'exception)) 'unsupported))
  (check-idle)
  (let cuts ((cut 1))
    (if (<= cut 4)
        (begin (check-native-fault 0 cut 'g3c4-model-owner 10) (cuts (+ cut 1)))))
  (check-native-fault 1 0 'g3c4-model-owner 7)
  (let cuts ((cut 0))
    (if (< cut 4)
        (begin (check-native-fault 2 cut 'i64-tensor 7) (cuts (+ cut 1)))))
  (let ((vector-cuts (sweep-allocations 1)) (cons-cuts (sweep-allocations 2))
        (bytevector-cuts (sweep-allocations 3)))
    (check "vectors, nodes, and all eight constructor allocations challenged"
           (and (> vector-cuts 0) (> cons-cuts 0) (= bytevector-cuts 8)))
    (display "P2/G2 measured allocation paths ")
    (write (list vector-cuts cons-cuts bytevector-cuts)) (newline))
  (vector-set! g3c4-p2g2-ownership-gate 0 #f)
  (check "off rejects before any enrollment"
    (rejects? (lambda () (probe 'dry)) 'invalid-argument))
  (check-idle)
  (vector-set! g3c4-p2g2-ownership-gate 0 #t)
  (check "generator reusable" (probe 'dry))
  (check-idle)
  (g3c4-p2g2-terminal-carriers-retire! earlier-bundle)
  (g3c4-generator-close-internal! generator)
  (g3c4-generator-close-internal! other-generator)
  (display "P2/G2 first enrollment PASS checks=") (display checks) (newline))

(run)
