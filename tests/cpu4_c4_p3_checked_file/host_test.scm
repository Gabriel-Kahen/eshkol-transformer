(use-modules (rnrs bytevectors))
(define host-bytevector-copy bytevector-copy)
(define host-bytevector-copy! bytevector-copy!)
(define (bytevector . bytes) (u8-list->bytevector bytes))
(define (bytevector-copy! target target-start source source-start count)
  (host-bytevector-copy! source source-start target target-start count))
(define (bytevector-copy source . range)
  (if (null? range)
      (host-bytevector-copy source)
      (let* ((start (car range)) (end (car (cdr range)))
             (result (make-bytevector (- end start) 0)))
        (bytevector-copy! result 0 source start (- end start))
        result)))

(define (reject? thunk)
  (catch #t (lambda () (thunk) #f) (lambda args #t)))
(define checks 0)
(define (check label predicate)
  (set! checks (+ checks 1))
  (if (not predicate) (error "checked FILE host test failed" label)))
(define (cpu4-binding-fail category operation message)
  (error "checked FILE rejected" category operation message))
(define (cpu4-binding-fail-stop code) (error "checked FILE fail-stop" code))

(define c2 (make-bytevector 25504 1))
(define wire (make-bytevector 400 2))
(define values (make-bytevector 4768 0))
(define sha (make-bytevector 32 7))
(define record (make-bytevector 224 0))
(bytevector-u8-set! record 48 3)
(bytevector-u8-set! record 56 197)
(bytevector-u8-set! record 64 3)
(bytevector-u8-set! record 144 1)
(bytevector-u8-set! record 152 41)
(define files (list (cons "b250" c2) (cons "wire" wire)
                    (cons "values" values)))
(define (t2-wave2-valid-file-path? path) (and (string? path) (assoc path files)))
(define (t1-native-read-exact path destination size maximum)
  (let ((entry (assoc path files)))
    (if (and entry (= size maximum)
             (= (bytevector-length (cdr entry)) size))
        (begin (bytevector-copy! destination 0 (cdr entry) 0 size) 0)
        1)))
(define (c1-sha256 bytes) (bytevector-copy sha))
(define (cpu4-c4-p3-native-wire-decode source source-size payload payload-size
                                        digest fingerprint output)
  (if (not (and (= source-size 400) (= payload-size 4768)
                (bytevector=? digest sha)))
      1
      (begin (bytevector-copy! output 0 record 0 224) 0)))
(define (bytevector=? a b)
  (and (= (bytevector-length a) (bytevector-length b))
       (let loop ((i 0))
         (or (= i (bytevector-length a))
             (and (= (bytevector-u8-ref a i) (bytevector-u8-ref b i))
                  (loop (+ i 1)))))))
(define (i2-checkpoint-encode request)
  (if (vector-ref m3-call-state 0)
      (error "I2 cannot borrow model tensors during active native call")
      (vector-ref request 0)))
(define (parameter-handle-tensor-identity-internal handle) handle)
(define g3c4-model-shapes (make-vector 14 '(1)))
(define handles (make-vector 14 (make-bytevector 0)))
(vector-set! handles 0 values)
(define model (vector 'model))
(define t1 (vector 't1))
(define generator (vector 'generator))
(define factory-ticket (vector 'factory-ticket))
(define child-ticket (vector 'child-ticket))
(define trainer (vector 'trainer))
(define trainer-record (make-vector 22 #f))
(vector-set! trainer-record 8 model)
(define child (make-vector 15 #f))
(vector-set! child 3 'open)
(vector-set! child 10 trainer)
(vector-set! child 13 handles)
(define factory (make-vector 19 #f))
(vector-set! factory 2 factory-ticket)
(vector-set! factory 3 'ready)
(vector-set! factory 4 "b250")
(vector-set! factory 14 child-ticket)
(vector-set! factory 15 trainer)
(define model-entry (make-vector 12 #f))
(vector-set! model-entry 0 model)
(vector-set! model-entry 8 handles)
(define generator-entry (make-vector 12 #f))
(vector-set! generator-entry 0 generator)
(vector-set! generator-entry 5 model-entry)
(vector-set! generator-entry 6 t1)
(define input #f)
(define input-entry #f)
(define m3-call-state (vector #f))
(define g3c4-baseline-tokenizer-fingerprint
  "sha256:eshkol-byte-tokenizer-v1:aabb31f49216963582383a00fd2e85d7c20b658d5bef0e7945344ed6bfe50704")
(define (cpu4-checkpoint-factory-row ticket operation)
  (if (eq? ticket factory-ticket) factory (error "wrong factory")))
(define (cpu4-owned-row ticket operation)
  (if (eq? ticket child-ticket) child (error "wrong child")))
(define (cpu4-owned-model-internal ticket)
  (if (eq? ticket child-ticket) model (error "wrong model")))
(define (cpu4-trainer-record-internal shell operation)
  (if (eq? shell trainer) trainer-record (error "wrong trainer")))
(define (g3c4-baseline-tokenizer-entry tokenizer operation missing mismatch)
  (if (eq? tokenizer t1) (list t1 'core) (error "wrong T1")))
(define (g3c4-model-entry-live candidate operation active)
  (if (and (eq? candidate model)
           (eq? (vector-ref model-entry 10) active))
      model-entry (error "wrong model call")))
(define (cpu4-checkpoint-factory-generator-handoff-internal!
          ticket tokenizer config recovery)
  (vector model generator))
(define (g3c4-generator-entry-call-ready candidate operation)
  (if (and (eq? candidate generator)
           (not (vector-ref generator-entry 9)))
      generator-entry (error "wrong or busy generator")))
(define (t1-wave1-tokenizer-encode tokenizer bytes) bytes)
(define (g3c4-p2g2-owned-input-create encoded)
  (set! input (vector 'input encoded))
  (set! input-entry (vector input))
  input)
(define (g3c4-input-entry-live candidate operation)
  (if (eq? candidate input) input-entry (error "wrong input")))
(define (g3c4-p2g2-prefix-preflight candidate owned-input)
  (if (and (eq? candidate generator) (eq? owned-input input))
      input-entry (error "wrong prefix")))
(define (g3c4-registry-find candidate operation)
  (if (eq? candidate generator) generator-entry (error "wrong registry")))

(call-with-input-file "native/cpu4_c4_p3_checked_file_extension.esk"
  (lambda (port)
    (let load-next ()
      (let ((form (read port)))
        (if (not (eof-object? form))
            (begin
              (if (not (eq? (car form) 'extern))
                  (eval form (current-module)))
              (load-next)))))))

(define (issue)
  (cpu4-c4-p3-checked-file-issue-internal!
    factory-ticket t1 sha "wire" "values"))
(define pristine (issue))
(check 'authentic-ticket (cpu4-c4-p3-checked-file-row-live pristine 'test))
(for-each
  (lambda (slot)
    (let ((ticket (issue)))
      (vector-set! ticket slot
                   (if (= slot 14) (lambda (x) #t)
                       (if (= slot 17) (vector #f #f 3)
                           (make-bytevector
                             (bytevector-length (vector-ref ticket slot)) 99))))
      (check (list 'mutated-slot slot)
             (reject? (lambda ()
                        (cpu4-c4-p3-checked-file-row-live ticket 'test))))))
  '(8 9 10 11 12 13 14 17))
(for-each
  (lambda (slot)
    (let ((ticket (issue)))
      (bytevector-u8-set! (vector-ref ticket slot) 0 99)
      (check (list 'in-place-byte-mutation slot)
             (reject? (lambda ()
                        (cpu4-c4-p3-checked-file-row-live ticket 'test))))))
  '(9 10 11 13))
(let ((ticket (issue)))
  (bytevector-u8-set! (vector-ref ticket 12) 0 99)
  (check 'in-place-id-mutation
         (reject? (lambda ()
                    (cpu4-c4-p3-checked-file-row-live ticket 'test)))))
(let ((ticket (issue)))
  (vector-set! (vector-ref ticket 17) 2 99)
  (check 'in-place-descriptor-mutation
         (reject? (lambda ()
                    (cpu4-c4-p3-checked-file-row-live ticket 'test)))))

(define ticket (issue))
(check 'factory-handoff
       (eq? (cpu4-c4-p3-checked-file-handoff-internal!
              ticket 'config (vector #f)) generator))
(check 'owned-input
       (eq? (cpu4-c4-p3-checked-file-input-internal! ticket) input))
(define descriptor
  (cpu4-c4-p3-resume-issuer-internal 'admit generator input ticket 'test))
(check 'admit-descriptor
       (and (eq? descriptor (vector-ref ticket 17))
            (= (bytevector-u8-ref (vector-ref descriptor 0) 8) 197)))
(define call (vector 'active-call))
(vector-set! m3-call-state 0 call)
(vector-set! generator-entry 9 call)
(vector-set! model-entry 10 call)
(check 'verify-same-descriptor
       (eq? descriptor
            (cpu4-c4-p3-resume-issuer-internal
              'verify generator input ticket 'test)))
(vector-set! ticket 15 (vector 'substitute-generator))
(check 'substituted-generator
       (reject? (lambda ()
                  (cpu4-c4-p3-resume-issuer-internal
                    'verify generator input ticket 'test))))
(vector-set! ticket 15 generator)
(vector-set! ticket 16 (vector 'substitute-input))
(check 'substituted-input
       (reject? (lambda ()
                  (cpu4-c4-p3-resume-issuer-internal
                    'verify generator input ticket 'test))))
(vector-set! ticket 16 input)
(vector-set! ticket 14 (lambda (x) #t))
(check 'substituted-verifier
       (reject? (lambda ()
                  (cpu4-c4-p3-resume-issuer-internal
                    'verify generator input ticket 'test))))
(display "CPU4 C4 P3 checked FILE host PASS: checks=")
(display checks)
(newline)
