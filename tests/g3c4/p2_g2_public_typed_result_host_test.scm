;;; Host-only control flow with the actual reviewed typed wrapper. Native calls
;;; are the fault stubs from the wrapper harness, not CPU execution evidence.
(load (string-append (getenv "G3C4_TEST_ROOT") "/tests/g3c4/p2_g2_typed_wrapper_rollback_test.scm"))
(define protected? #f)
(define-syntax m3-call
  (syntax-rules () ((_ operation body ...)
    (if protected? (error "nested protected call")
        (dynamic-wind (lambda () (set! protected? #t))
                      (lambda () body ...)
                      (lambda () (set! protected? #f)))))))
(load (string-append (getenv "G3C4_TEST_ROOT") "/native/g3c4_p2g2_typed_result_extension.esk"))
(load (string-append (getenv "G3C4_TEST_ROOT") "/native/g3c4_public_g2_result_extension.esk"))
(define clone-created 0) (define clone-released 0)
