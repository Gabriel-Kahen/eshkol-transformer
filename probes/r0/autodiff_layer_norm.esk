(define (near a b tolerance) (< (abs (- a b)) tolerance))
(define epsilon 1e-5)
(define (f x)
  (tensor-get (layer-norm (vector x 2.0 3.0) 1.0 0.0 1e-5) 0))
(define actual (derivative f 1.0))
(define finite (/ (- (f (+ 1.0 epsilon)) (f (- 1.0 epsilon))) (* 2.0 epsilon)))
(display (if (near actual finite 1e-4) "PASS layer norm gradient" "FAIL layer norm gradient"))
(newline)
(display "R0_DONE autodiff_layer_norm") (newline)
