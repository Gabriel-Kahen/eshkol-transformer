;;; Test-only V=256 EVAL5 score witness. The prefix is the pinned MOD5-C source.
(extern i32 score-v256 ptr ptr ptr ptr ptr ptr ptr ptr :real et_eval5_v256_score)
(extern i32 audit-v256 ptr ptr ptr ptr ptr :real et_eval5_v256_audit)
(extern i32 manifest-v256 ptr ptr ptr ptr ptr ptr ptr ptr
  :real et_eval5_v256_manifest_roundtrip_live)
(extern f64 score-metric ptr i64 :real et_eval5_v256_metric)

(define expected-model-sha @@MODEL_SHA@@)
(define expected-train-sha @@TRAIN_SHA@@)
(define expected-eval-sha @@EVAL_SHA@@)

(define (check-tokenizer path)
  (let* ((bytes (corpus-read-exact path corpus-limit 'eval5-v256))
         (tokenizer (t1-private-tokenizer-parse bytes corpus-limit))
         (fingerprint (t1-private-tokenizer-fingerprint tokenizer)))
    (check-data (and (= (t1-private-tokenizer-vocab-size tokenizer) vocab)
                     (string=? fingerprint corpus-identity))
                "T1 tokenizer owner identity mismatch")
    fingerprint))

(define (shard-leaf index)
  (cond ((= index 0) "shard-0000000000000000.ets")
        ((= index 1) "shard-0000000000000001.ets")
        (else "shard-0000000000000002.ets")))

(define (document-leaf index)
  (if (= index 0) "doc-0.bin" "doc-1.bin"))

(define (read-split directory expected-sha)
  (let* ((metadata ((vector-ref d1-compiled-public-operations 8)
                    corpus-read-exact directory corpus-limit corpus-limit 18))
         (manifest (vector-ref metadata 6))
         (manifest-sha (c1-sha256 manifest))
         (records (c1-read-u32 manifest 12))
         (all (make-vector 18 0))
         (original (make-bytevector 18 0)))
    (check-data (c1-bytes=? manifest-sha expected-sha)
                "D1 manifest SHA-256 mismatch")
    (check-data (and (= (vector-ref metadata 0) 3)
                     (= (vector-ref metadata 1) 18)
                     (= (vector-ref metadata 2) vocab)
                     (string=? (vector-ref metadata 4) corpus-identity))
                "D1 summary identity or shape mismatch")
    (do ((index 0 (+ index 1)))
        ((= index 3))
      (let* ((record (+ records (* index 56)))
             (shard ((vector-ref d1-compiled-public-operations 9)
                     corpus-read-exact
                     (string-append directory "/" (shard-leaf index))
                     index 6 (c1-read-u64 manifest (+ record 16))
                     (bytevector-copy manifest (+ record 24) (+ record 56))
                     corpus-identity vocab corpus-limit))
             (offset (c1-read-u32 shard 12)))
        (do ((slot 0 (+ slot 1)))
            ((= slot 6))
          (vector-set! all (+ (* index 6) slot)
                       (c1-read-u64 shard (+ offset (* slot 8)))))))
    ;; D1 stores no document boundaries. Bind the two original byte files to
    ;; the validated raw-byte T1 IDs before scoring.
    (do ((doc 0 (+ doc 1)))
        ((= doc 2))
      (let ((bytes (corpus-read-exact
                    (string-append directory "/" (document-leaf doc))
                    9 'eval5-v256)))
        (check-data (= (bytevector-length bytes) 9) "original document length mismatch")
        (do ((slot 0 (+ slot 1)))
            ((= slot 9))
          (check-data (= (bytevector-u8-ref bytes slot)
                         (vector-ref all (+ (* doc 9) slot)))
                      "original bytes differ from D1 token IDs")
          (bytevector-u8-set! original (+ (* doc 9) slot)
                              (bytevector-u8-ref bytes slot)))))
    (vector all original manifest-sha (vector-ref metadata 4))))

(define (audit-splits train evaluation expected-status)
  (let* ((train-bytes (checked-allocate 18))
         (train-ids (checked-allocate (* 18 4)))
         (eval-bytes (checked-allocate 18))
         (eval-ids (checked-allocate (* 18 4)))
         (output (checked-allocate (* 8 8))))
    (do ((i 0 (+ i 1))) ((= i 18))
      (volatile-store! u8 (ptr-add train-bytes i)
                       (bytevector-u8-ref (vector-ref train 1) i))
      (volatile-store! u32 (ptr-add train-ids (* 4 i))
                       (vector-ref (vector-ref train 0) i))
      (volatile-store! u8 (ptr-add eval-bytes i)
                       (bytevector-u8-ref (vector-ref evaluation 1) i))
      (volatile-store! u32 (ptr-add eval-ids (* 4 i))
                       (vector-ref (vector-ref evaluation 0) i)))
    (let* ((status (audit-v256 (ffi-pointer train-bytes) (ffi-pointer train-ids)
                              (ffi-pointer eval-bytes) (ffi-pointer eval-ids)
                              (ffi-pointer output)))
           (counts (make-vector 8 0)))
      (if (= status expected-status)
          (do ((i 0 (+ i 1))) ((= i 8))
            (vector-set! counts i (volatile-load i64 (ptr-add output (* 8 i)))))
          #f)
      (release train-bytes) (release train-ids)
      (release eval-bytes) (release eval-ids) (release output)
      (check-data (= status expected-status) "EVAL5 contamination policy status mismatch")
      (display "AUDIT") (display " ") (display status)
      (do ((i 0 (+ i 1))) ((= i 8))
        (display " ") (display (vector-ref counts i)))
      (newline)
      (vector status counts))))

(define (one-hot-doc all offset)
  (let ((input (zeros (list tokens vocab)))
        (target (zeros (list tokens vocab))))
    (do ((t 0 (+ t 1)))
        ((= t tokens) (vector input target))
      (tensor-set! input t (vector-ref all (+ offset t)) 1.0)
      (tensor-set! target t (vector-ref all (+ offset t 1)) 1.0))))

(define (model-logits weights all offset)
  (let ((batch (one-hot-doc all offset)))
    (vector-ref (decoder weights (vector-ref batch 0)
                         (vector-ref batch 1) #f #f) 1)))

(define (load-checked-weights path)
  (let* ((bytes (corpus-read-exact path 65536 'eval5-v256))
         (digest (c1-sha256 bytes)))
    (check-data (c1-bytes=? digest expected-model-sha)
                "C1 checkpoint SHA-256 mismatch")
    (let* ((state (c1-checkpoint-decode-state-internal
                    bytes policy i2-checkpoint-codec-internal i2-provider-name))
           (weights (guard (caught (#t (state-dict-release! state) (raise caught)))
                      (decode-weights state))))
      (state-dict-release! state)
      (vector weights digest))))

(define (copy-digest bytes destination offset)
  (check-data (= (bytevector-length bytes) 32) "manifest digest width mismatch")
  (do ((i 0 (+ i 1))) ((= i 32))
    (volatile-store! u8 (ptr-add destination (+ offset i))
                     (bytevector-u8-ref bytes i))))

(define (emit-manifest tokenizer-fingerprint train evaluation model-sha
                       audit-result metrics counts)
  (let* ((tokenizer-bytes (string->utf8 tokenizer-fingerprint))
         (corpus-bytes (string->utf8 (vector-ref evaluation 3))))
    (check-data (and (= (bytevector-length tokenizer-bytes) 96)
                     (= (bytevector-length corpus-bytes) 96)
                     (string=? tokenizer-fingerprint (vector-ref train 3))
                     (string=? tokenizer-fingerprint (vector-ref evaluation 3)))
                "manifest T1/D1 owner fingerprint mismatch")
    (let* ((tokenizer-buffer (checked-allocate 96))
           (corpus-buffer (checked-allocate 96))
           (digests (checked-allocate 96))
           (audit-record (checked-allocate (* 9 8)))
           (manifest (checked-allocate 4097))
           (manifest-size (checked-allocate 8)))
      (do ((i 0 (+ i 1))) ((= i 96))
        (volatile-store! u8 (ptr-add tokenizer-buffer i)
                         (bytevector-u8-ref tokenizer-bytes i))
        (volatile-store! u8 (ptr-add corpus-buffer i)
                         (bytevector-u8-ref corpus-bytes i)))
      (copy-digest (vector-ref train 2) digests 0)
      (copy-digest (vector-ref evaluation 2) digests 32)
      (copy-digest model-sha digests 64)
      (volatile-store! i64 audit-record (vector-ref audit-result 0))
      (do ((i 0 (+ i 1))) ((= i 8))
        (volatile-store! i64 (ptr-add audit-record (* 8 (+ i 1)))
                         (vector-ref (vector-ref audit-result 1) i)))
      (let* ((status (manifest-v256 (ffi-pointer tokenizer-buffer)
                                    (ffi-pointer corpus-buffer)
                                    (ffi-pointer digests)
                                    (ffi-pointer audit-record)
                                    (ffi-pointer metrics) (ffi-pointer counts)
                                    (ffi-pointer manifest)
                                    (ffi-pointer manifest-size)))
             (length (if (= status 0) (volatile-load i64 manifest-size) 0)))
        (if (and (= status 0) (> length 0) (<= length 4096))
            (begin
              (display "MANIFEST_BEGIN") (newline)
              (do ((i 0 (+ i 1))) ((= i length))
                (display (integer->char (volatile-load u8 (ptr-add manifest i)))))
              (display "MANIFEST_END") (newline))
            #f)
        (release tokenizer-buffer) (release corpus-buffer) (release digests)
        (release audit-record) (release manifest) (release manifest-size)
        (check-data (and (= status 0) (> length 0) (<= length 4096))
                    "in-memory EVAL5 manifest round-trip rejected")))))

(define (score-fixture tokenizer-path train-dir eval-dir model-path)
  (let* ((tokenizer-fingerprint (check-tokenizer tokenizer-path))
         (train (read-split train-dir expected-train-sha))
         (evaluation (read-split eval-dir expected-eval-sha))
         (eval-tokens (vector-ref evaluation 0))
         (audit-result (audit-splits train evaluation 0)))
    (let* ((loaded (load-checked-weights model-path))
           (weights (vector-ref loaded 0))
           (model-sha (vector-ref loaded 1))
           (context-a (vector 10 11 12 13 14 15 0 3 0))
           (context-b (vector 3 0 15 14 13 12 11 10 0))
           (buffers (vector (checked-allocate (* 4 tokens vocab))
                            (checked-allocate (* 4 tokens vocab))
                            (checked-allocate (* 4 tokens vocab))
                            (checked-allocate (* 4 tokens vocab))))
           (targets (checked-allocate (* 18 4)))
           (metrics (checked-allocate (* 5 8)))
           (counts (checked-allocate (* 2 8)))
           (probes (checked-allocate (* 8 4))))
      (pack (model-logits weights eval-tokens 0) (vector-ref buffers 0))
      (pack (model-logits weights eval-tokens 9) (vector-ref buffers 1))
      (pack (model-logits weights context-a 0) (vector-ref buffers 2))
      (pack (model-logits weights context-b 0) (vector-ref buffers 3))
      (do ((i 0 (+ i 1)))
          ((= i 18))
        (volatile-store! u32 (ptr-add targets (* 4 i)) (vector-ref eval-tokens i)))
      (expect-status "EVAL5 LM/MC score" 0
                     (score-v256 (ffi-pointer (vector-ref buffers 0))
                                 (ffi-pointer (vector-ref buffers 1))
                                 (ffi-pointer (vector-ref buffers 2))
                                 (ffi-pointer (vector-ref buffers 3))
                                 (ffi-pointer targets) (ffi-pointer metrics)
                                 (ffi-pointer counts) (ffi-pointer probes)))
      (display "SCORE")
      (do ((i 0 (+ i 1))) ((= i 5))
        (display " ") (print-real "%.17g" (score-metric (ffi-pointer metrics) i)))
      (do ((i 0 (+ i 1))) ((= i 2))
        (display " ") (display (volatile-load i64 (ptr-add counts (* 8 i)))))
      (do ((i 0 (+ i 1))) ((= i 8))
        (display " ") (print-real "%.9g" (load-f32 (ffi-pointer probes) i)))
      (newline)
      (emit-manifest tokenizer-fingerprint train evaluation model-sha
                     audit-result metrics counts)
      (do ((i 0 (+ i 1))) ((= i 4)) (release (vector-ref buffers i)))
      (release targets) (release metrics) (release counts) (release probes))))

(define (audit-control tokenizer-path train-dir eval-dir)
  (check-tokenizer tokenizer-path)
  (let ((train (read-split train-dir expected-train-sha)))
    (read-split eval-dir expected-eval-sha)
    ;; The control uses only authenticated train documents as evaluation input.
    (audit-splits train train -7)))

(define (witness-main args)
  (guard (caught
           (#t
             (close-mod5 (ffi-pointer runtime))
             (display "EVAL5 V256 ERROR ")
             (if (transformer-error? caught)
                 (begin (display (transformer-error-category caught))
                        (display " ") (display (transformer-error-message caught)))
                 (write caught))
             (newline)
             2))
    (let ((argc (c1-list-length-bounded args 5)))
      (cond ((and (equal? argc 3) (string=? (cadr args) "--check-c1"))
             (load-weights (caddr args))
             (display "C1_CHECKED") (newline))
            ((and (equal? argc 5) (string=? (cadr args) "--audit-control"))
             (audit-control (caddr args) (cadddr args) (cadr (cdddr args))))
            ((equal? argc 5)
             (score-fixture (cadr args) (caddr args) (cadddr args)
                            (cadr (cdddr args))))
            (else (check-data #f "expected tokenizer, train, eval, and C1 paths"))))
    (close-mod5 (ffi-pointer runtime))
    0))

(if (= (witness-main (command-line)) 0) (exit 0) (exit 2))
