(define (o2-state-copy-moment-bits-c2-owned-internal request) (event 'moment-bits))
(define (i2-checkpoint-decode request)
  (event 'moment-decode)
  (vector-set! request 7 (vector 'buffer 'owned-clone 'raw)))
(define (c2-training-state-borrow-end-internal borrow) (event 'borrow-end))
(define (load-dependency path name)
  (eval (find (lambda (f) (and (pair? f) (eq? (car f) 'define)
                              (eq? (if (pair? (cadr f)) (caadr f) (cadr f)) name)))
              (read-forms path)) (current-module)))
(define (o2-fail category operation message) (throw category message))
(load-dependency "native/i2_wave2_extension.esk" 'i2-bounded-list-length)
(for-each (lambda (name) (load-dependency "native/o2_wave2_extension.esk" name))
          '(o2-max-data-depth o2-max-data-nodes o2-max-config-bytes o2-reverse
            o2-member-identity? o2-copy-path o2-copy-paths o2-copy-aliases
            o2-copy-data-walk o2-copy-config-data))
(define borrow-topology (vector paths shapes aliases))
(define borrow-o2 (vector 'config paths aliases 0))
(set! c2-training-state-borrow-projection-internal
  (lambda (borrow)
    (vector 'source-p1 'source-o2 expanded-controls borrow-topology borrow-o2)))
(set! c2-training-state-borrow-end-internal
  (lambda (borrow)
    (event 'borrow-end)
    ;; Simulate borrowed projection lifetime ending. No receiver metadata may
    ;; depend on these vectors after this point.
    (vector-set! borrow-topology 0 'expired)
    (vector-set! borrow-topology 1 'expired)
    (vector-set! borrow-o2 0 'expired)))
(set! events '())
(define staged-parent (cpu4-checkpoint-parent 'trainer))
(define detached-staged (cpu4-checkpoint-stage-source! staged-parent 'source))
(check "all later metadata detached before borrow lifetime ends"
  (and (equal? (vector-ref (vector-ref detached-staged 0) 0) paths)
