;;; The exact noninstalled E3 numerical entry. Native test hooks emit each
;;; completed frame role and final published result on this tuple.
(extern void e3-private-test-run ptr ptr ptr :real et_e3_test_run_v1)

(define (check label value)
  (if value #t
      (begin (display "E3-NUMERICAL-FAIL: ") (display label)
             (newline) (exit 1))))

(define (bytes=? left right)
  (and (bytevector? left) (bytevector? right)
       (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (if (= index (bytevector-length left)) #t
             (and (= (bytevector-u8-ref left index)
                     (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))

(define (case-spec name)
  (if (string=? name "sum-order") (vector #t 0 5 3)
      (if (string=? name "sum-order-capacity") (vector #t 0 6 3)
          (if (string=? name "sum-order-missing") (vector #t 0 4 2)
              (if (string=? name "sum-order-padded") (vector #t 0 6 3)
                  (if (string=? name "packed-single") (vector #t 0 5 3)
                      (if (string=? name "packed-sharded") (vector #t 0 5 3)
                          (if (string=? name "packed-suffix") (vector #t 1 3 2)
                              (if (string=? name "unpacked-three") (vector #f 0 4 2)
                                  (if (string=? name "unpacked-pairs") (vector #f 0 3 3)
                                      #f))))))))))

(define args (command-line))
(check 'arguments
  (and (pair? args) (pair? (cdr args)) (pair? (cdr (cdr args)))
       (null? (cdr (cdr (cdr args))))))
(define spec (case-spec (car (cdr args))))
(check 'case spec)
(define output (vector #f))
(e3-private-test-run
 (vector (vector (vector-ref spec 0) (vector-ref spec 1)))
 (vector (car (cdr (cdr args)))) output)
(define result (vector-ref output 0))
(check 'result
  (and (vector? result) (= (vector-length result) 9)
       (eq? (vector-ref result 0) 'e3-private-result-v1)
       (= (vector-ref result 5) (vector-ref spec 2))
       (= (vector-ref result 6) (vector-ref spec 3))
       (bytes=? (vector-ref result 7) (vector-ref result 8))))
(display "E3-NUMERICAL-RUNTIME-PASS") (newline)
