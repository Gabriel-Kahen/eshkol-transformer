;;; Private fixed diagnostic-C2 capture. The returned detached C2 owner and
;;; G3 words are not a SAVE image, digest, pair, or public continuation.

(define (g3r-save-fixed-fail message)
  (g3r-save-o2-fail 'invalid-state 2 message))

(define (g3r-save-fixed-topology! p1)
  (let* ((topology
           (state-dict-c2-parameter-topology-internal
             p1 'g3r-save-fixed-capture))
         (paths (vector-ref topology 0))
         (shapes (vector-ref topology 1)))
    (let check ((index 0) (remaining-paths paths)
                (remaining-shapes shapes))
      (if (= index 14)
          (if (not (and (null? remaining-paths)
                        (null? remaining-shapes)
                        (equal? (vector-ref topology 2)
                                '(( ("head" "weight")
                                    ("token_embedding" "weight") )))))
              (g3r-save-fixed-fail "P1 tied roster changed"))
          (if (not (and (pair? remaining-paths)
                        (pair? remaining-shapes)
                        (equal? (car remaining-paths)
                                (vector-ref m3t-paths index))
                        (equal? (car remaining-shapes)
                                (vector-ref m3t-shapes index))))
              (g3r-save-fixed-fail "P1 primary roster changed")
              (check (+ index 1) (cdr remaining-paths)
                     (cdr remaining-shapes)))))
    #t))

(define (g3r-save-fixed-words! words generator)
  (let* ((entry (g3t-generator-find generator 'g3r-save-fixed-capture))
         (policy (vector-ref entry 7)))
    (if (not (and (vector? words) (= (vector-length words) 18)
                  (vector? policy) (= (vector-length policy) 7)
                  (eq? (vector-ref policy 0) 'diagnostic-c2)
                  (m3t-exact-i64? (vector-ref words 0))
                  (= (vector-ref words 0) 1)))
        (g3r-save-fixed-fail "G3 word image or policy changed"))
    (let check ((index 1))
      (if (< index 18)
          (begin
            (if (not (m3t-exact-i64? (vector-ref words index)))
                (g3r-save-fixed-fail "G3 word is not exact i64"))
            (if (and (< index 7)
                     (not (= (vector-ref words index)
                             (if (and (= index 6)
                                      (eq? (vector-ref policy index) #f))
                                 -1 (vector-ref policy index)))))
                (g3r-save-fixed-fail "G3 sampling policy changed"))
            (check (+ index 1)))))
    ;; Fixed history slots are rechecked before any detached-owner claim.
    ;; Native G3 remains the source of this image; this rejects a changed
    ;; Eshkol copy even if its word count and policy still look plausible.
    (let ((length (vector-ref words 17))
          (prompt (vector-ref words 13))
          (generated (vector-ref words 14))
          (manual (vector-ref words 15))
          (terminal (vector-ref words 16)))
      (if (not (and (>= length 1) (<= length 2)
                    (>= prompt 0) (<= prompt 2)
                    (>= generated 0) (<= generated 1)
                    (>= manual 0) (<= manual 1)
                    (= (+ prompt generated manual) length)
                    (not (and (= generated 1) (= manual 1)))
                    (or (not (= generated 1)) (= (vector-ref words 5) 1))
                    (or (not (= length 1)) (= prompt 1))
                    (or (not (= length 2)) (>= prompt 1))
                    (>= terminal 0) (<= terminal 1)
                    (>= (vector-ref words 11) 0)
                    (<= (vector-ref words 11) 255)
                    (if (= length 1)
                        (= (vector-ref words 12) 0)
                        (and (>= (vector-ref words 12) 0)
                             (<= (vector-ref words 12) 255)))
                    (= terminal
                       (if (and (= generated 1)
                                (>= (vector-ref words 6) 0)
                                (= (vector-ref words (+ 10 length))
                                   (vector-ref words 6)))
                           1 0))))
          (g3r-save-fixed-fail "G3 committed history changed")))
    #t))

(define (g3r-save-fixed-controls! envelope)
  (if (not (and (vector? envelope) (= (vector-length envelope) 2)
                (vector? (vector-ref envelope 0))
                (= (vector-length (vector-ref envelope 0)) 5)
                (m3t-exact-i64? (vector-ref envelope 1))
                (>= (vector-ref envelope 1) 0)))
      (g3r-save-fixed-fail "captured C2 controls or epoch changed"))
  #t)

(define (g3r-save-c2-capture-internal generator model resolved tokenizer
                                       dataset optimizer capsule)
  ;; The adoption leaf owns its hold, 14 native F32 witnesses, P1 clone and
  ;; O2 clone until take. After take this caller owns both detached children.
  (let ((shell-cell (vector #f)) (bundle #f)
        (request #f) (result (vector #f #f #f)))
    (guard (caught
             (#t
               (let ((owned-shell (vector-ref shell-cell 0)))
                 (if owned-shell
                     (guard (cleanup (#t (exit 134)))
                       (g3r-save-o2-abandon-internal! owned-shell))))
               (raise caught)))
      ;; The adoption leaf cleans up its own failures. Publish its successful
      ;; return in a preallocated cell before any fallible post-adoption work;
      ;; the handler must not read a mutable local across Eshkol longjmp.
      (vector-set! shell-cell 0
        (g3r-save-o2-adopt-held-internal
          generator model resolved tokenizer dataset optimizer capsule))
      (let ((shell (vector-ref shell-cell 0)))
        (set! bundle (g3r-save-o2-take-for-c2-internal shell))
        (g3r-save-o2-authenticate-bundle-internal shell bundle)
        (g3r-save-fixed-topology! (vector-ref bundle 0))
        (g3r-save-fixed-controls! (vector-ref bundle 2))
        (g3r-save-fixed-words! (vector-ref bundle 3) generator)
        ;; Prepare every result allocation before C2 claims either child.
        (vector-set! result 1 (vector-copy (vector-ref bundle 3)))
        (vector-set! result 2 (vector-ref (vector-ref bundle 2) 1))
        (set! request
          (vector c2-training-state-compose-tag
                  (vector-ref bundle 0) shell
                  (vector-ref (vector-ref bundle 2) 0)
                  'g3r-save-fixed-capture #f))
        (g3r-save-o2-authenticate-bundle-internal shell bundle)
        (if (not (equal? (vector-ref result 1) (vector-ref bundle 3)))
            (g3r-save-fixed-fail "G3 words changed before C2 compose"))
        (c2-training-state-compose-internal request)
        ;; C2's successful transfer is assignment-only. No fallible work
        ;; follows this point, and the C2 owner is the sole child authority.
        (vector-set! result 0 (vector-ref request 5))
        result))))
