;;; Actual source helpers with identity/error doubles only; no Eshkol/native E3.
(use-modules (rnrs bytevectors))
(define (select-definitions path names)
  (call-with-input-file path
    (lambda (port)
      (let read-forms ()
        (let ((form (read port)))
          (if (not (eof-object? form))
              (begin
                (if (and (pair? form) (eq? (car form) 'define)
                         (memq (if (pair? (cadr form)) (caadr form) (cadr form)) names))
                    (eval form (current-module)))
                (read-forms))))))))
(define (cpu4-binding-fail category operation message) (throw 'fixture-rejected))
(select-definitions "internal/d2/lib/d2_semantic_core.esk" '(d2-core-bytes=?))
(select-definitions "tests/cpu4_heldout/body.esk"
  '(heldout-fixture-session heldout-fail heldout-require heldout-phase-identity!
    heldout-counts! heldout-controls=?))
(define checks 0)
(define (check condition)
  (if (not condition) (error "held-out host helper check failed" checks))
  (set! checks (+ checks 1)))
(define (reject thunk)
  (check (catch 'fixture-rejected (lambda () (thunk) #f) (lambda args #t))))
(define identities (vector (vector 'trainer) (vector 'model) (vector 'binding) (vector 'heldout)))
(define (phase p row)
  (heldout-phase-identity! (vector-ref row 0) (vector-ref row 1)
                         (vector-ref row 2) (vector-ref row 3) p))
(reject (lambda () (phase 'post identities)))
(check (phase 'baseline identities))
(vector-set! heldout-fixture-session 0 identities)
(vector-set! heldout-fixture-session 2 'baseline)
(reject (lambda () (phase 'baseline identities)))
(check (phase 'post identities))
(let foreign-identities ((index 0))
  (if (< index 4)
      (let ((foreign (vector (vector-ref identities 0) (vector-ref identities 1)
                             (vector-ref identities 2) (vector-ref identities 3))))
        (vector-set! foreign index (vector 'foreign))
        (reject (lambda () (phase 'post foreign)))
        (foreign-identities (+ index 1)))))
(vector-set! heldout-fixture-session 0 #f)
(vector-set! heldout-fixture-session 2 'done)
(reject (lambda () (phase 'baseline identities)))
(reject (lambda () (phase 'post identities)))
(define record (make-vector 22 0))
(check (heldout-counts! record 'baseline))
(vector-set! record 19 1000) (vector-set! record 20 250) (vector-set! record 21 249)
(check (heldout-counts! record 'post))
(reject (lambda () (heldout-counts! record 'baseline)))
(vector-set! record 20 251)
(reject (lambda () (heldout-counts! record 'post)))
(define (controls)
  (vector (vector 'philox4x32-10 1 1729 0 0) (vector "raw" 256)
          (vector (u8-list->bytevector '(1 2)) (u8-list->bytevector '(3 4)))
          (vector (u8-list->bytevector '(5 6)) "config-fingerprint") (vector 0 0 0)))
(define before (controls))
(check (heldout-controls=? before (controls)))
(for-each
  (lambda (slot)
    (let* ((bad (controls)) (bytes (vector-ref (vector-ref bad (car slot)) (cadr slot))))
      (bytevector-u8-set! bytes 0 99)
      (check (not (heldout-controls=? before bad)))))
  '((2 0) (2 1) (3 0)))
(display "CPU4 held-out actual body helpers with doubles PASS: checks=")
(display checks) (newline)
