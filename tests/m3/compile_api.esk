;;; Declaration/arity witness; runtime behavior belongs to public_runtime.esk.
(require transformer.config)
(require transformer.module)
(require transformer.tokenizer)
(require transformer.diagnostic_transport)
(require transformer.error_public)
(require transformer.model)
(define (compile-m3-api model input result seed)
  (model-forward model input)
  (model-forward model input ':deterministic? #t)
  (model-output-logits result)
  (model-output-loss result)
  (model-output-rng result)
  (model-output-release! result)
  (diagnostic-output-vjp! result seed 1065353216 0)
  (diagnostic-model-logits-bits result)
  (diagnostic-model-logits-release! result))
